+static sint32 nsysnet_setTcpNoDelay(const virtualSocket_t* vs, MPTR optval, sint32 optlen)
+{
+	if (!sockLibReady)
+		return WU_SO_ELIBNOTREADY;
+	if (!vs)
+		return WU_SO_ENOTSOCK;
+	if (optlen != sizeof(sint32))
+		return WU_SO_EINVAL;
+	if (!optval || !memory_isAddressRangeAccessible(optval, sizeof(sint32)))
+		return WU_SO_EFAULT;
+
+	const int mode = memory_readU32(optval) != 0;
+	const sint32 type = vs->type;
+	const sint32 protocol = vs->protocol;
+	if (setsockopt(vs->s, IPPROTO_TCP, TCP_NODELAY, reinterpret_cast<const char*>(&mode), sizeof(mode)) == 0)
+		return WU_SO_SUCCESS;
+
+	const sint32 error = GETLASTERR;
+	cemuLog_log(LogType::Force, "nsysnet TCP_NODELAY failed: host error {} (type {}, protocol {})", error, type, protocol);
+	switch (error)
+	{
+	case WSAENOBUFS: return WU_SO_ENOBUFS;
+	case WSAEOPNOTSUPP: return WU_SO_EOPNOTSUPP;
+	case WSAEINVAL: return WU_SO_EINVAL;
+	case WSAENOPROTOOPT: return WU_SO_ENOPROTOOPT;
+	case WSAENOTSOCK: return WU_SO_ENOTSOCK;
+	case WSAEFAULT: return WU_SO_EFAULT;
+#if BOOST_OS_UNIX
+	case EBADF: return WU_SO_ENOTSOCK;
+#endif
+	default: return WU_SO_ELOWER;
+	}
+}
