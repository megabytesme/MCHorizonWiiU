@@ -0,0 +1,464 @@
+//! A host-only stock HUD seed experiment. The real Cafe decoder writes into
+//! a caller-owned surface. Session state is rebuilt from the base art.
+use super::{HudAtlas, Rect, TextureFlags, pictures};
+use crate::{cafe_pixels::PackedPixels, font::Font, resource_source::ResourceSource, sprites};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::HashMap,
+    fs,
+    mem::size_of,
+    path::{Path, PathBuf},
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::Instant,
+};
+
+const SLOT_BYTES: usize = 16 * 1024 * 1024;
+
+#[derive(Clone, PartialEq, Eq)]
+struct StockIdentity {
+    root: PathBuf,
+    content: [u8; 32],
+}
+
+/// This host fixture hashes the verified loose directory materialized from
+/// the stock archive. An active prepared archive or pack overlay needs its
+/// own generation identity because effective files may differ from disk.
+fn stock_identity(root: &Path, cancel: &AtomicBool) -> crate::Result<Option<StockIdentity>> {
+    let root = fs::canonicalize(root)?;
+    if root.join("horizon-data.bin").exists() || cancel.load(Ordering::Acquire) {
+        return Ok(None);
+    }
+    let source = ResourceSource::directory(root.clone());
+    let mut files = source.list("assets/");
+    if files.is_empty() || files.len() > 16_384 {
+        return Ok(None);
+    }
+    files.push("horizon-resources.json".into());
+    let mut digest = Sha256::new();
+    digest.update(b"horizon stock packed HUD fixture inputs v1");
+    let mut total = 0;
+    for name in files {
+        if cancel.load(Ordering::Acquire) {
+            return Ok(None);
+        }
+        let bytes = source.read_limited(&name, 16 * 1024 * 1024)?;
+        total += bytes.len();
+        if total > 160 * 1024 * 1024 {
+            return Ok(None);
+        }
+        digest.update((name.len() as u32).to_le_bytes());
+        digest.update(name.as_bytes());
+        digest.update((bytes.len() as u32).to_le_bytes());
+        digest.update(bytes);
+    }
+    Ok((!cancel.load(Ordering::Acquire)).then(|| StockIdentity {
+        root,
+        content: digest.finalize().into(),
+    }))
+}
+
+type Layout = Vec<(String, Rect)>;
+
+struct StockSeed {
+    packed: PackedPixels,
+    dimensions: (u32, u32),
+    glyph_region: (u32, u32),
+    white: Rect,
+    galactic_widths: [u16; 128],
+    sprites: Layout,
+    translucent: Vec<String>,
+    flags: Vec<(String, TextureFlags)>,
+    animation_names: Vec<String>,
+    bytes: usize,
+}
+
+fn rect_key(rect: Rect) -> [u32; 6] {
+    [
+        rect.u0.to_bits(),
+        rect.v0.to_bits(),
+        rect.u1.to_bits(),
+        rect.v1.to_bits(),
+        rect.w,
+        rect.h,
+    ]
+}
+
+fn layout(mut entries: Layout) -> Layout {
+    entries.sort_unstable_by(|a, b| a.0.cmp(&b.0));
+    entries
+}
+
+fn named_bytes<T>(entries: &Vec<(String, T)>) -> usize {
+    entries.capacity() * size_of::<(String, T)>()
+        + entries
+            .iter()
+            .map(|(name, _)| name.capacity())
+            .sum::<usize>()
+}
+
+fn strings_bytes(entries: &Vec<String>) -> usize {
+    entries.capacity() * size_of::<String>() + entries.iter().map(String::capacity).sum::<usize>()
+}
+
+impl StockSeed {
+    fn capture(atlas: HudAtlas, limit: usize, cancel: &AtomicBool) -> Option<Self> {
+        if cancel.load(Ordering::Acquire) || atlas.material_maps.iter().any(Option::is_some) {
+            return None;
+        }
+        let mut regions = HashMap::new();
+        for (name, &rect) in &atlas.sprites {
+            regions
+                .entry(rect_key(rect))
+                .and_modify(|value| *value = None)
+                .or_insert(Some(name));
+        }
+        let animation_names = atlas
+            .sprite_animations
+            .iter()
+            .map(|(rect, _)| regions.get(&rect_key(*rect))?.map(String::clone))
+            .collect::<Option<Vec<_>>>()?;
+        drop(regions);
+
+        let sprites = layout(atlas.sprites.into_iter().collect());
+        let mut translucent: Vec<_> = atlas.translucent.into_iter().collect();
+        let mut flags: Vec<_> = atlas.flags.into_iter().collect();
+        translucent.sort_unstable();
+        flags.sort_unstable_by(|a, b| a.0.cmp(&b.0));
+        let metadata_bytes = size_of::<Self>()
+            + named_bytes(&sprites)
+            + named_bytes(&flags)
+            + strings_bytes(&translucent)
+            + strings_bytes(&animation_names);
+        let packed =
+            PackedPixels::compress_with_budget(&atlas.pixels, limit.checked_sub(metadata_bytes)?)?;
+        let bytes = metadata_bytes + packed.retained_bytes();
+        if bytes > limit || cancel.load(Ordering::Acquire) {
+            return None;
+        }
+        Some(Self {
+            packed,
+            dimensions: (atlas.width, atlas.height),
+            glyph_region: atlas.font.atlas_glyph_region(),
+            white: atlas.white,
+            galactic_widths: atlas.galactic_widths,
+            sprites,
+            translucent,
+            flags,
+            animation_names,
+            bytes,
+        })
+    }
+
+    fn write_mapped(&self, target: &mut [u8], pitch: usize) -> Option<()> {
+        self.packed.write_pitched(
+            target,
+            self.dimensions.0 as usize * 4,
+            pitch,
+            self.dimensions.1 as usize,
+        )
+    }
+
+    /// The harness uses its tightly pitched mapped image to reconstruct font
+    /// providers. The actual Cafe integration will need to preserve the font
+    /// template or supply row reads from its mapped image during setup.
+    fn restore(
+        &self,
+        source: &ResourceSource,
+        target: &mut [u8],
+        cancel: &AtomicBool,
+    ) -> Option<Session> {
+        if cancel.load(Ordering::Acquire) {
+            return None;
+        }
+        self.write_mapped(target, self.dimensions.0 as usize * 4)?;
+        if cancel.load(Ordering::Acquire) {
+            return None;
+        }
+        let layout: HashMap<_, _> = self.sprites.iter().cloned().collect();
+        let font = Font::load(
+            source,
+            &layout,
+            target,
+            self.dimensions,
+            self.glyph_region,
+            self.white,
+        );
+        let mut sprites = sprites::Sprites::new(source.clone());
+        let mut animations = Vec::new();
+        for name in &self.animation_names {
+            if cancel.load(Ordering::Acquire) {
+                return None;
+            }
+            let id = if name.contains(':') {
+                name.clone()
+            } else {
+                format!("minecraft:{name}")
+            };
+            let layer = sprites.insert(&id).ok()?;
+            let animation = sprites
+                .animations
+                .iter()
+                .find(|animation| animation.layer == layer)?;
+            animations.push((*layout.get(name)?, animation.clone()));
+        }
+        if cancel.load(Ordering::Acquire) {
+            return None;
+        }
+        Some(Session {
+            atlas_revision: HudAtlas::next_revision(),
+            object_skins_revision: HudAtlas::next_revision(),
+            object_skins: HashMap::new(),
+            _pictures: Mutex::new(pictures::Cache::new(source, source)),
+            sprites: layout,
+            animations,
+            font,
+        })
+    }
+}
+
+struct Session {
+    atlas_revision: u64,
+    object_skins_revision: u64,
+    object_skins: HashMap<String, String>,
+    _pictures: Mutex<pictures::Cache>,
+    sprites: HashMap<String, Rect>,
+    animations: Vec<(Rect, sprites::SpriteAnimation)>,
+    font: Font,
+}
+
+struct Slot {
+    cap: usize,
+    seed: Option<(StockIdentity, Arc<StockSeed>)>,
+}
+impl Slot {
+    fn new(cap: usize) -> Self {
+        Self { cap, seed: None }
+    }
+
+    /// Drop a previous generation before constructing a replacement at the
+    /// loader, via a failed checkout or explicit invalidation.
+    fn forget(&mut self) {
+        self.seed = None;
+    }
+
+    fn offer(
+        &mut self,
+        identity: StockIdentity,
+        seed: Arc<StockSeed>,
+        cancel: &AtomicBool,
+    ) -> bool {
+        self.forget();
+        let overhead = size_of::<Slot>() + 2 * size_of::<usize>() + identity.root.capacity();
+        if cancel.load(Ordering::Acquire) || seed.bytes.saturating_add(overhead) > self.cap {
+            return false;
+        }
+        self.seed = Some((identity, seed));
+        true
+    }
+
+    fn checkout(
+        &mut self,
+        identity: &StockIdentity,
+        cancel: &AtomicBool,
+    ) -> Option<Arc<StockSeed>> {
+        if !cancel.load(Ordering::Acquire)
+            && let Some((key, seed)) = self.seed.as_ref()
+            && key == identity
+        {
+            return Some(seed.clone());
+        }
+        self.forget();
+        None
+    }
+}
+
+fn fonts(font: &Font) -> [u32; 4] {
+    ["Horizon Wii U", "AV Ty", "漢字", "Te\u{0301}st"].map(|value| font.width(value).to_bits())
+}
+
+fn animation_digest(items: &[(Rect, sprites::SpriteAnimation)]) -> [u8; 32] {
+    let mut digest = Sha256::new();
+    for (rect, animation) in items {
+        for bits in rect_key(*rect) {
+            digest.update(bits.to_le_bytes());
+        }
+        digest.update(animation.layer.to_le_bytes());
+        for tick in [0, 1, 7, 20, 256, 4097] {
+            let blend = animation.blend(tick);
+            digest.update((blend.frame as u32).to_le_bytes());
+            digest.update((blend.next as u32).to_le_bytes());
+            digest.update(blend.millis.to_le_bytes());
+            let rgba = animation.pixels(blend.frame);
+            digest.update((rgba.len() as u32).to_le_bytes());
+            digest.update(rgba);
+        }
+    }
+    digest.finalize().into()
+}
+
+#[test]
+#[ignore = "reads the private exact stock fixture named by HORIZON_STOCK_HUD_FIXTURE"]
+fn stock_packed_seed_restores_rgba_layout_and_fresh_session() -> crate::Result<()> {
+    let root = PathBuf::from(
+        std::env::var_os("HORIZON_STOCK_HUD_FIXTURE").ok_or("stock fixture path required")?,
+    );
+    let cancel = AtomicBool::new(false);
+    let started = Instant::now();
+    let identity = stock_identity(&root, &cancel)?.ok_or("unusable stock fixture identity")?;
+    let identify_ms = started.elapsed().as_secs_f64() * 1000.0;
+    let source = ResourceSource::directory(root.clone());
+    let started = Instant::now();
+    let mut fresh = HudAtlas::build_over_with_image_cancel(&source, &source, false, Some(&cancel))?;
+    let build_ms = started.elapsed().as_secs_f64() * 1000.0;
+    let original_rgba = Sha256::digest(&fresh.pixels);
+    let original_layout: Vec<_> = layout(
+        fresh
+            .sprites
+            .iter()
+            .map(|(name, &rect)| (name.clone(), rect))
+            .collect(),
+    )
+    .into_iter()
+    .map(|(name, rect)| (name, rect_key(rect)))
+    .collect();
+    let original_fonts = fonts(&fresh.font);
+    let original_animations = animation_digest(&fresh.sprite_animations);
+    let atlas_revision = fresh.revision;
+    let skin_revision = fresh.object_skins_revision;
+    let font_epoch = fresh.font.epoch();
+    fresh
+        .object_skins
+        .insert("previous-session".into(), "fixture:skin".into());
+    let (width, height) = (fresh.width as usize, fresh.height as usize);
+    let raw = fresh.pixels.len();
+    let original_widths = fresh.galactic_widths;
+    let mut original_flags: Vec<_> = fresh
+        .flags
+        .iter()
+        .map(|(name, flags)| (name.clone(), *flags))
+        .collect();
+    let mut original_translucent: Vec<_> = fresh.translucent.iter().cloned().collect();
+    original_flags.sort_unstable_by(|a, b| a.0.cmp(&b.0));
+    original_translucent.sort_unstable();
+    let started = Instant::now();
+    let seed = Arc::new(
+        StockSeed::capture(fresh, SLOT_BYTES, &cancel)
+            .ok_or("stock HUD seed exceeded the fixture cap")?,
+    );
+    let encode_ms = started.elapsed().as_secs_f64() * 1000.0;
+    assert_eq!(seed.galactic_widths, original_widths);
+    assert_eq!(seed.flags, original_flags);
+    assert_eq!(seed.translucent, original_translucent);
+    assert!(stock_identity(&root, &cancel)?.as_ref() == Some(&identity));
+
+    let mut over = Slot::new(seed.bytes - 1);
+    assert!(!over.offer(identity.clone(), seed.clone(), &cancel));
+    assert!(over.checkout(&identity, &cancel).is_none());
+    let mut slot = Slot::new(SLOT_BYTES);
+    assert!(slot.offer(identity.clone(), seed.clone(), &cancel));
+    let weak = Arc::downgrade(&seed);
+    drop(seed);
+    assert_eq!(weak.strong_count(), 1);
+
+    let live = slot.checkout(&identity, &cancel).expect("exact stock seed");
+    let mut mapped = vec![0; raw];
+    let started = Instant::now();
+    let mut session = live
+        .restore(&source, &mut mapped, &cancel)
+        .expect("fresh seed session");
+    let restore_ms = started.elapsed().as_secs_f64() * 1000.0;
+    assert_eq!(Sha256::digest(&mapped), original_rgba);
+    let actual_layout: Vec<_> = layout(
+        session
+            .sprites
+            .iter()
+            .map(|(name, &rect)| (name.clone(), rect))
+            .collect(),
+    )
+    .into_iter()
+    .map(|(name, rect)| (name, rect_key(rect)))
+    .collect();
+    assert_eq!(actual_layout, original_layout);
+    assert_eq!(fonts(&session.font), original_fonts);
+    assert_eq!(animation_digest(&session.animations), original_animations);
+    assert_ne!(session.atlas_revision, atlas_revision);
+    assert_ne!(session.object_skins_revision, skin_revision);
+    assert_ne!(session.font.epoch(), font_epoch);
+    assert!(session.object_skins.is_empty());
+    session
+        .object_skins
+        .insert("first-restored-session".into(), "fixture:skin".into());
+    let first_revision = session.atlas_revision;
+    drop(session);
+    drop(live);
+    assert_eq!(weak.strong_count(), 1);
+    let live = slot
+        .checkout(&identity, &cancel)
+        .expect("same retained seed");
+    let session = live
+        .restore(&source, &mut mapped, &cancel)
+        .expect("second seed session");
+    assert!(session.object_skins.is_empty());
+    assert!(session.font.take_patches().is_empty());
+    assert_ne!(first_revision, session.atlas_revision);
+    drop(session);
+    drop(mapped);
+
+    let row_bytes = width * 4;
+    let pitch = row_bytes + 48;
+    let mut padded = vec![0xab; pitch * height];
+    live.write_mapped(&mut padded, pitch)
+        .expect("padded stock mapping");
+    let mut padded_checksum = Sha256::new();
+    for row in padded.chunks_exact(pitch) {
+        padded_checksum.update(&row[..row_bytes]);
+        assert!(row[row_bytes..].iter().all(|&byte| byte == 0xab));
+    }
+    assert_eq!(padded_checksum.finalize(), original_rgba);
+    drop(padded);
+    cancel.store(true, Ordering::Release);
+    assert!(live.restore(&source, &mut [], &cancel).is_none());
+    assert!(slot.checkout(&identity, &cancel).is_none());
+    cancel.store(false, Ordering::Release);
+    assert!(slot.offer(identity.clone(), live.clone(), &cancel));
+    let mut other = identity.clone();
+    other.content[0] ^= 1;
+    assert!(slot.checkout(&other, &cancel).is_none());
+    assert!(slot.checkout(&identity, &cancel).is_none());
+    println!(
+        "stock HUD seed {}x{} raw={} packed={} retained={} sprites={} animations={} rgba_sha256={original_rgba:x} input_ms={identify_ms:.3} build_ms={build_ms:.3} encode_ms={encode_ms:.3} restore_ms={restore_ms:.3}",
+        width,
+        height,
+        raw,
+        live.packed.encoded_len(),
+        live.bytes,
+        live.sprites.len(),
+        live.animation_names.len(),
+    );
+    drop(live);
+    assert_eq!(weak.strong_count(), 0);
+    Ok(())
+}
+
+#[test]
+fn stock_identity_checks_asset_bytes_and_stops_on_cancel() -> crate::Result<()> {
+    let root = tempfile::tempdir()?;
+    fs::create_dir(root.path().join("assets"))?;
+    fs::write(root.path().join("horizon-resources.json"), b"{}")?;
+    let asset = root.path().join("assets/font.json");
+    fs::write(&asset, b"a")?;
+    let cancel = AtomicBool::new(false);
+    let first = stock_identity(root.path(), &cancel)?.unwrap();
+    fs::write(&asset, b"b")?;
+    let changed = stock_identity(root.path(), &cancel)?.unwrap();
+    assert!(first != changed);
+    cancel.store(true, Ordering::Release);
+    assert!(stock_identity(root.path(), &cancel)?.is_none());
+    cancel.store(false, Ordering::Release);
+    fs::write(root.path().join("horizon-data.bin"), b"fixture")?;
+    assert!(stock_identity(root.path(), &cancel)?.is_none());
+    Ok(())
+}
