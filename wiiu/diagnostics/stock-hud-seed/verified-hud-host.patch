+#[cfg(all(feature = "host-prepared-fixture", not(target_os = "cafe")))]
+impl PreparedFiles {
+    /// Host qualification only. The trusted publisher must replace the file
+    /// atomically and keep the opened inode immutable. Verify before parsing.
+    pub fn reopen_verified_host(
+        root: &Path,
+        expected: [u8; 32],
+        cancel: &std::sync::atomic::AtomicBool,
+    ) -> io::Result<Option<Self>> {
+        use sha2::{Digest, Sha256};
+        use std::io::{Seek, SeekFrom};
+        use std::sync::atomic::Ordering;
+
+        const BUFFER_BYTES: usize = 128 * 1024;
+        const ARCHIVE_LIMIT: u64 = 192 * 1024 * 1024;
+        const INDEX_LIMIT: u64 = 4 * 1024 * 1024;
+        if cancel.load(Ordering::Acquire) {
+            return Ok(None);
+        }
+        let mut file = match Self::open_file(root) {
+            Ok(Some(file)) => file,
+            Ok(None) => return Ok(None),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+            Err(error) => return Err(error),
+        };
+        let mut remaining = file.metadata()?.len();
+        if !(HEADER as u64..=ARCHIVE_LIMIT).contains(&remaining) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "archive size out of bounds",
+            ));
+        }
+        let mut digest = Sha256::new();
+        let mut buffer = vec![0; BUFFER_BYTES];
+        while remaining != 0 {
+            if cancel.load(Ordering::Acquire) {
+                return Ok(None);
+            }
+            let count = remaining.min(BUFFER_BYTES as u64) as usize;
+            let chunk = &mut buffer[..count];
+            file.read_exact(chunk)?;
+            digest.update(chunk);
+            remaining -= count as u64;
+        }
+        let actual: [u8; 32] = digest.finalize().into();
+        if actual != expected || file.read(&mut [0])? != 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "archive digest mismatch",
+            ));
+        }
+        if cancel.load(Ordering::Acquire) {
+            return Ok(None);
+        }
+        file.seek(SeekFrom::Start(0))?;
+        Self::parse(root, file, INDEX_LIMIT)
+    }
+}
