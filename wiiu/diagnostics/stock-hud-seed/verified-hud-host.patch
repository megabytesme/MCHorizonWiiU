+#[test]
+fn reads_pitched_alpha_without_changing_logical_glyph_uvs() {
+    let definition = br#"{"providers":[{"type":"bitmap","file":"minecraft:font/fixture.png","height":2,"ascent":2,"chars":["AB"]}]}"#;
+    let source = ResourceSource::indexed(
+        [(
+            "assets/minecraft/font/default.json".to_owned(),
+            Resource::bytes(definition.to_vec()),
+        )]
+        .into(),
+    );
+    let atlas = (8, 4);
+    let region = (3, 1);
+    let white = Rect {
+        u0: 0.0,
+        v0: 0.0,
+        u1: 0.125,
+        v1: 0.25,
+        w: 1,
+        h: 1,
+    };
+    let sheet = Rect {
+        u0: 0.25,
+        v0: 0.25,
+        u1: 1.0,
+        v1: 0.75,
+        w: 6,
+        h: 2,
+    };
+    let sprites = [("font/fixture".to_owned(), sheet)].into();
+    let mut rgba = [0; 192];
+    for row in rgba.chunks_exact_mut(48) {
+        row[32..].fill(255);
+    }
+    rgba[2 * 48 + 3 * 4 + 3] = 128;
+    let mut tight = [0; 128];
+    for (target, source) in tight.chunks_exact_mut(32).zip(rgba.chunks_exact(48)) {
+        target.copy_from_slice(&source[..32]);
+    }
+    let reference = Font::load(&source, &sprites, &tight, atlas, region, white);
+    let font = Font::load_stock_mapped(&source, &sprites, &rgba, 48, atlas, region, white).unwrap();
+    let first = font.glyph('A');
+    let second = font.glyph('B');
+    assert_eq!(first.advance, 3.0);
+    assert_eq!(second.advance, 1.0);
+    assert_eq!(first.rect.unwrap().u0, (2.0 + 0.01) / 8.0);
+    assert_eq!(second.rect.unwrap().u0, (5.0 + 0.01) / 8.0);
+    assert_eq!(glyph_key(first), glyph_key(reference.glyph('A')));
+    assert_eq!(glyph_key(second), glyph_key(reference.glyph('B')));
+    assert_ne!(font.epoch(), reference.epoch());
+    assert!(font.take_patches().is_empty());
+    assert_eq!(
+        BitmapPixels {
+            rgba: &rgba,
+            width: 8,
+            row_bytes: 48
+        }
+        .used_width((7, 1, 4, 2)),
+        0
+    );
+
+    for (bytes, pitch, dimensions) in [
+        (&rgba[..191], 48, atlas),
+        (&rgba[..], 31, atlas),
+        (&rgba[..], 49, atlas),
+        (&rgba[..], 44, atlas),
+        (&rgba[..], 48, (0, 4)),
+        (&rgba[..], 48, (8, 0)),
+        (&rgba[..], usize::MAX & !3, (8, 2)),
+    ] {
+        assert!(
+            Font::load_stock_mapped(&source, &sprites, bytes, pitch, dimensions, region, white)
+                .is_none()
+        );
+    }
+}
+
+#[test]
+#[ignore = "requires the locally prepared stock assets in HORIZON_STOCK_HUD_FIXTURE"]
+fn prepared_stock_font_matches_after_unmapping_padded_atlas() {
+    let root = std::env::var_os("HORIZON_STOCK_HUD_FIXTURE").unwrap();
+    let source = ResourceSource::directory(PathBuf::from(root));
+    let mut atlas = HudAtlas::build(&source).unwrap();
+    let dimensions = (atlas.width, atlas.height);
+    assert_eq!(dimensions, (4096, 7168));
+    let row_bytes = atlas.width as usize * 4;
+    let height = atlas.height as usize;
+    let pitch = row_bytes + 128;
+    assert_eq!(atlas.pixels.len(), 117_440_512);
+    let packed = PackedPixels::compress(&atlas.pixels).unwrap();
+    drop(std::mem::take(&mut atlas.pixels));
+    let start = Instant::now();
+    let font = {
+        let mut mapped = vec![0xa5; pitch * height];
+        packed
+            .write_pitched(&mut mapped, row_bytes, pitch, height)
+            .unwrap();
+        let filled = start.elapsed();
+        let mut hash = Sha256::new();
+        for row in mapped.chunks_exact(pitch) {
+            hash.update(&row[..row_bytes]);
+            assert!(row[row_bytes..].iter().all(|&byte| byte == 0xa5));
+        }
+        assert_eq!(
+            format!("{:x}", hash.finalize()),
+            "a4f3e9e48e982b03a68ac752ab4f52d81665feba7259b1ff628d8ced1e96155b"
+        );
+        let start_font = Instant::now();
+        let font = Font::load_stock_mapped(
+            &source,
+            &atlas.sprites,
+            &mapped,
+            pitch,
+            dimensions,
+            atlas.font.region,
+            atlas.white,
+        )
+        .unwrap();
+        eprintln!(
+            "stock mapped atlas {}x{} logical_bytes={} pitch_bytes={} surface_bytes={} fill_ms={:.3} font_ms={:.3}",
+            dimensions.0,
+            dimensions.1,
+            row_bytes * height,
+            pitch,
+            mapped.len(),
+            filled.as_secs_f64() * 1000.0,
+            start_font.elapsed().as_secs_f64() * 1000.0
+        );
+        font
+    };
+    assert_ne!(font.epoch(), atlas.font.epoch());
+    assert!(font.take_patches().is_empty());
+    let ids: Vec<_> = atlas
+        .font
+        .cache
+        .borrow()
+        .sets
+        .iter()
+        .map(|(id, _)| id.clone())
+        .collect();
+    assert!(ids.len() >= 3);
+    let actual_ids: Vec<_> = font
+        .cache
+        .borrow()
+        .sets
+        .iter()
+        .map(|(id, _)| id.clone())
+        .collect();
+    assert_eq!(ids, actual_ids);
+    let mut compared = 0;
+    for id in ids {
+        for ch in (' '..='~').chain(['§', 'Ω', '漢', '\u{301}', '界', '⛏']) {
+            assert_eq!(
+                glyph_key(font.glyph_in(&id, ch)),
+                glyph_key(atlas.font.glyph_in(&id, ch)),
+                "{id} {ch}"
+            );
+            compared += 1;
+        }
+    }
+    eprintln!("stock mapped font matches {compared} glyph metrics and UVs");
+}
