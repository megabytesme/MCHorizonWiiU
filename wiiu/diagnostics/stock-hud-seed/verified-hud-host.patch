new file mode 100644
index 0000000000000000000000000000000000000000..4b91fb0a42fc00f37d246199297d27add4689b5f
--- /dev/null
+++ b/crates/horizon-client-render/src/hud/stock_seed_tests.rs
@@ -0,0 +1,551 @@
+//! Host stock HUD seed qualification using a verified archive descriptor.
+use super::{HudAtlas, Rect, TextureFlags, pictures};
+use crate::{cafe_pixels::PackedPixels, font::Font, resource_source::ResourceSource, sprites};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::HashMap,
+    fs,
+    io::Write,
+    mem::size_of,
+    path::{Path, PathBuf},
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::Instant,
+};
+
+const SLOT_BYTES: usize = 16 * 1024 * 1024;
+
+type Layout = Vec<(String, Rect)>;
+
+struct StockSeed {
+    packed: PackedPixels,
+    dimensions: (u32, u32),
+    glyph_region: (u32, u32),
+    white: Rect,
+    galactic_widths: [u16; 128],
+    sprites: Layout,
+    translucent: Vec<String>,
+    flags: Vec<(String, TextureFlags)>,
+    animation_names: Vec<String>,
+    bytes: usize,
+}
+
+fn rect_key(rect: Rect) -> [u32; 6] {
+    [
+        rect.u0.to_bits(),
+        rect.v0.to_bits(),
+        rect.u1.to_bits(),
+        rect.v1.to_bits(),
+        rect.w,
+        rect.h,
+    ]
+}
+
+fn layout(mut entries: Layout) -> Layout {
+    entries.sort_unstable_by(|a, b| a.0.cmp(&b.0));
+    entries
+}
+
+fn named_bytes<T>(entries: &Vec<(String, T)>) -> usize {
+    entries.capacity() * size_of::<(String, T)>()
+        + entries
+            .iter()
+            .map(|(name, _)| name.capacity())
+            .sum::<usize>()
+}
+
+fn strings_bytes(entries: &Vec<String>) -> usize {
+    entries.capacity() * size_of::<String>() + entries.iter().map(String::capacity).sum::<usize>()
+}
+
+impl StockSeed {
+    fn capture(atlas: HudAtlas, limit: usize, cancel: &AtomicBool) -> Option<Self> {
+        if cancel.load(Ordering::Acquire) || atlas.material_maps.iter().any(Option::is_some) {
+            return None;
+        }
+        let mut regions = HashMap::new();
+        for (name, &rect) in &atlas.sprites {
+            regions
+                .entry(rect_key(rect))
+                .and_modify(|value| *value = None)
+                .or_insert(Some(name));
+        }
+        let animation_names = atlas
+            .sprite_animations
+            .iter()
+            .map(|(rect, _)| regions.get(&rect_key(*rect))?.map(String::clone))
+            .collect::<Option<Vec<_>>>()?;
+        drop(regions);
+
+        let sprites = layout(atlas.sprites.into_iter().collect());
+        let mut translucent: Vec<_> = atlas.translucent.into_iter().collect();
+        let mut flags: Vec<_> = atlas.flags.into_iter().collect();
+        translucent.sort_unstable();
+        flags.sort_unstable_by(|a, b| a.0.cmp(&b.0));
+        let metadata_bytes = size_of::<Self>()
+            + named_bytes(&sprites)
+            + named_bytes(&flags)
+            + strings_bytes(&translucent)
+            + strings_bytes(&animation_names);
+        let packed =
+            PackedPixels::compress_with_budget(&atlas.pixels, limit.checked_sub(metadata_bytes)?)?;
+        let bytes = metadata_bytes + packed.retained_bytes();
+        if bytes > limit || cancel.load(Ordering::Acquire) {
+            return None;
+        }
+        Some(Self {
+            packed,
+            dimensions: (atlas.width, atlas.height),
+            glyph_region: atlas.font.atlas_glyph_region(),
+            white: atlas.white,
+            galactic_widths: atlas.galactic_widths,
+            sprites,
+            translucent,
+            flags,
+            animation_names,
+            bytes,
+        })
+    }
+
+    fn write_mapped(&self, target: &mut [u8], pitch: usize) -> Option<()> {
+        self.packed.write_pitched(
+            target,
+            self.dimensions.0 as usize * 4,
+            pitch,
+            self.dimensions.1 as usize,
+        )
+    }
+
+    /// Recreate session-owned resources from the borrowed atlas mapping.
+    fn restore(
+        &self,
+        source: &ResourceSource,
+        target: &mut [u8],
+        pitch: usize,
+        cancel: &AtomicBool,
+    ) -> Option<Session> {
+        if cancel.load(Ordering::Acquire) {
+            return None;
+        }
+        self.write_mapped(target, pitch)?;
+        if cancel.load(Ordering::Acquire) {
+            return None;
+        }
+        let layout: HashMap<_, _> = self.sprites.iter().cloned().collect();
+        let font = Font::load_stock_mapped(
+            source,
+            &layout,
+            target,
+            pitch,
+            self.dimensions,
+            self.glyph_region,
+            self.white,
+        )?;
+        let mut sprites = sprites::Sprites::new(source.clone());
+        let mut animations = Vec::new();
+        for name in &self.animation_names {
+            if cancel.load(Ordering::Acquire) {
+                return None;
+            }
+            let id = if name.contains(':') {
+                name.clone()
+            } else {
+                format!("minecraft:{name}")
+            };
+            let layer = sprites.insert(&id).ok()?;
+            let animation = sprites
+                .animations
+                .iter()
+                .find(|animation| animation.layer == layer)?;
+            animations.push((*layout.get(name)?, animation.clone()));
+        }
+        if cancel.load(Ordering::Acquire) {
+            return None;
+        }
+        Some(Session {
+            atlas_revision: HudAtlas::next_revision(),
+            object_skins_revision: HudAtlas::next_revision(),
+            object_skins: HashMap::new(),
+            _pictures: Mutex::new(pictures::Cache::new(source, source)),
+            sprites: layout,
+            galactic_widths: self.galactic_widths,
+            translucent: self.translucent.clone(),
+            flags: self.flags.clone(),
+            animations,
+            font,
+        })
+    }
+}
+
+struct Session {
+    atlas_revision: u64,
+    object_skins_revision: u64,
+    object_skins: HashMap<String, String>,
+    _pictures: Mutex<pictures::Cache>,
+    sprites: HashMap<String, Rect>,
+    galactic_widths: [u16; 128],
+    translucent: Vec<String>,
+    flags: Vec<(String, TextureFlags)>,
+    animations: Vec<(Rect, sprites::SpriteAnimation)>,
+    font: Font,
+}
+
+struct Slot {
+    cap: usize,
+    seed: Option<([u8; 32], Arc<StockSeed>)>,
+}
+
+impl Slot {
+    fn new(cap: usize) -> Self {
+        Self { cap, seed: None }
+    }
+
+    fn offer(
+        &mut self,
+        source: &ResourceSource,
+        seed: Arc<StockSeed>,
+        cancel: &AtomicBool,
+    ) -> bool {
+        self.seed = None;
+        let Some(generation) = source.verified_assets_generation_host() else {
+            return false;
+        };
+        let overhead = size_of::<Self>() + 2 * size_of::<usize>();
+        if cancel.load(Ordering::Acquire) || seed.bytes.saturating_add(overhead) > self.cap {
+            return false;
+        }
+        self.seed = Some((generation, seed));
+        true
+    }
+
+    fn checkout(
+        &mut self,
+        source: Option<&ResourceSource>,
+        cancel: &AtomicBool,
+    ) -> Option<Arc<StockSeed>> {
+        if !cancel.load(Ordering::Acquire)
+            && let Some((generation, seed)) = self.seed.as_ref()
+            && source
+                .and_then(ResourceSource::verified_assets_generation_host)
+                .as_ref()
+                == Some(generation)
+        {
+            return Some(seed.clone());
+        }
+        self.seed = None;
+        None
+    }
+}
+
+fn font_digest(font: &Font) -> [u8; 32] {
+    let mut digest = Sha256::new();
+    for id in ["minecraft:default", "minecraft:alt", "minecraft:uniform"] {
+        for ch in (' '..='~').chain(['§', 'Ω', '漢', '\u{301}', '界', '⛏']) {
+            let glyph = font.glyph_in(id, ch);
+            for value in [
+                glyph.left,
+                glyph.top,
+                glyph.right,
+                glyph.bottom,
+                glyph.advance,
+                glyph.offset,
+            ] {
+                digest.update(value.to_bits().to_le_bytes());
+            }
+            digest.update([u8::from(glyph.rect.is_some())]);
+            if let Some(rect) = glyph.rect {
+                for bits in rect_key(rect) {
+                    digest.update(bits.to_le_bytes());
+                }
+            }
+        }
+    }
+    digest.finalize().into()
+}
+
+fn animation_digest(items: &[(Rect, sprites::SpriteAnimation)]) -> [u8; 32] {
+    let mut digest = Sha256::new();
+    for (rect, animation) in items {
+        for bits in rect_key(*rect) {
+            digest.update(bits.to_le_bytes());
+        }
+        digest.update(animation.layer.to_le_bytes());
+        for tick in [0, 1, 7, 20, 256, 4097] {
+            let blend = animation.blend(tick);
+            digest.update((blend.frame as u32).to_le_bytes());
+            digest.update((blend.next as u32).to_le_bytes());
+            digest.update(blend.millis.to_le_bytes());
+            let rgba = animation.pixels(blend.frame);
+            digest.update((rgba.len() as u32).to_le_bytes());
+            digest.update(rgba);
+        }
+    }
+    digest.finalize().into()
+}
+
+fn read_receipt(path: &Path) -> crate::Result<[u8; 32]> {
+    let text = fs::read_to_string(path)?;
+    let text = text.trim();
+    if text.len() != 64 || !text.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err("invalid expected SHA-256".into());
+    }
+    let mut expected = [0; 32];
+    for (i, byte) in expected.iter_mut().enumerate() {
+        *byte = u8::from_str_radix(&text[i * 2..i * 2 + 2], 16)?;
+    }
+    Ok(expected)
+}
+
+#[test]
+#[ignore = "requires a host-bound stock archive and independent stock receipt"]
+fn stock_reopens_from_one_verified_descriptor_with_tight_and_padded_pixels() -> crate::Result<()> {
+    let root = PathBuf::from(
+        std::env::var_os("HORIZON_VERIFIED_HUD_ROOT").ok_or("verified archive root required")?,
+    );
+    let receipt = PathBuf::from(
+        std::env::var_os("HORIZON_VERIFIED_HUD_RECEIPT").ok_or("archive receipt required")?,
+    );
+    let expected = read_receipt(&receipt)?;
+    let cancel = AtomicBool::new(false);
+    let open = || -> crate::Result<ResourceSource> {
+        ResourceSource::reopen_verified_assets_host(&root, expected, &cancel)?
+            .ok_or("stock archive unavailable".into())
+    };
+    let start = Instant::now();
+    let source = open()?;
+    assert_eq!(source.list("assets/").len(), 11_753);
+    assert_eq!(
+        source
+            .list_under("assets", &["font"])
+            .iter()
+            .filter(|name| name.ends_with(".json"))
+            .count(),
+        8
+    );
+    assert!(!root.join("assets").exists());
+    let cold_verify_ms = start.elapsed().as_secs_f64() * 1000.0;
+    let source_live = source.liveness();
+    let start = Instant::now();
+    let original = HudAtlas::build_over_with_image_cancel(&source, &source, false, Some(&cancel))?;
+    let cold_build_ms = start.elapsed().as_secs_f64() * 1000.0;
+    let rgba_hash = Sha256::digest(&original.pixels);
+    assert_eq!(
+        format!("{rgba_hash:x}"),
+        "a4f3e9e48e982b03a68ac752ab4f52d81665feba7259b1ff628d8ced1e96155b"
+    );
+    let dimensions = (original.width, original.height);
+    assert_eq!(dimensions, (4096, 7168));
+    assert_eq!(original.pixels.len(), 117_440_512);
+    let expected_sprites = layout(
+        original
+            .sprites
+            .iter()
+            .map(|(name, &rect)| (name.clone(), rect))
+            .collect(),
+    )
+    .into_iter()
+    .map(|(name, rect)| (name, rect_key(rect)))
+    .collect::<Vec<_>>();
+    let expected_font = font_digest(&original.font);
+    let expected_widths = original.galactic_widths;
+    let mut expected_translucent: Vec<_> = original.translucent.iter().cloned().collect();
+    let mut expected_flags: Vec<_> = original
+        .flags
+        .iter()
+        .map(|(name, &flag)| (name.clone(), flag))
+        .collect();
+    expected_translucent.sort_unstable();
+    expected_flags.sort_unstable_by(|a, b| a.0.cmp(&b.0));
+    let expected_animations = animation_digest(&original.sprite_animations);
+    let cold_revision = original.revision;
+    let cold_font_epoch = original.font.epoch();
+    let cold_skin_revision = original.object_skins_revision;
+    let width = dimensions.0 as usize;
+    let height = dimensions.1 as usize;
+    let row_bytes = width * 4;
+    let start = Instant::now();
+    let seed = Arc::new(
+        StockSeed::capture(original, SLOT_BYTES, &cancel).ok_or("stock seed exceeds cap")?,
+    );
+    let encode_ms = start.elapsed().as_secs_f64() * 1000.0;
+    assert_eq!(seed.sprites.len(), 4545);
+    assert_eq!(seed.animation_names.len(), 63);
+    assert_eq!(seed.galactic_widths, expected_widths);
+    assert_eq!(seed.translucent, expected_translucent);
+    assert_eq!(seed.flags, expected_flags);
+    let mut over = Slot::new(seed.bytes - 1);
+    assert!(!over.offer(&source, Arc::clone(&seed), &cancel));
+    assert!(over.checkout(Some(&source), &cancel).is_none());
+    let mut slot = Slot::new(SLOT_BYTES);
+    assert!(slot.offer(&source, Arc::clone(&seed), &cancel));
+    drop(source);
+    assert!(!source_live());
+
+    let mut last_revision = cold_revision;
+    for (label, pitch) in [("tight", row_bytes), ("padded", row_bytes + 128)] {
+        let start = Instant::now();
+        let source = open()?;
+        let verify_ms = start.elapsed().as_secs_f64() * 1000.0;
+        let start = Instant::now();
+        let live = slot
+            .checkout(Some(&source), &cancel)
+            .ok_or("seed missing")?;
+        let mut surface = vec![0xa5; pitch * height];
+        let session = live
+            .restore(&source, &mut surface, pitch, &cancel)
+            .ok_or("stock seed restore failed")?;
+        let restore_ms = start.elapsed().as_secs_f64() * 1000.0;
+        let mut logical = Sha256::new();
+        for row in surface.chunks_exact(pitch) {
+            logical.update(&row[..row_bytes]);
+            assert!(row[row_bytes..].iter().all(|&byte| byte == 0xa5));
+        }
+        assert_eq!(logical.finalize(), rgba_hash);
+        drop(surface);
+        assert!(session.font.take_patches().is_empty());
+        assert_eq!(font_digest(&session.font), expected_font);
+        assert_eq!(session.galactic_widths, expected_widths);
+        assert_eq!(session.translucent, expected_translucent);
+        assert_eq!(session.flags, expected_flags);
+        assert_eq!(animation_digest(&session.animations), expected_animations);
+        assert_eq!(
+            layout(session.sprites.into_iter().collect())
+                .into_iter()
+                .map(|(name, rect)| (name, rect_key(rect)))
+                .collect::<Vec<_>>(),
+            expected_sprites
+        );
+        assert_ne!(session.atlas_revision, last_revision);
+        assert_ne!(session.font.epoch(), cold_font_epoch);
+        assert_ne!(session.object_skins_revision, cold_skin_revision);
+        assert!(session.object_skins.is_empty());
+        last_revision = session.atlas_revision;
+        println!(
+            "stock reopen pitch={label} verify_ms={verify_ms:.3} restore_ms={restore_ms:.3} total_ms={:.3}",
+            verify_ms + restore_ms
+        );
+    }
+    println!(
+        "stock seed {width}x{height} cold_verify_ms={cold_verify_ms:.3} cold_build_ms={cold_build_ms:.3} encode_ms={encode_ms:.3} packed={} retained={} rgba_sha256={rgba_hash:x}",
+        seed.packed.encoded_len(),
+        seed.bytes + size_of::<Slot>() + 2 * size_of::<usize>()
+    );
+    Ok(())
+}
