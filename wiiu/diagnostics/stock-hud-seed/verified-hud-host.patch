+fn glyph_key(glyph: Glyph) -> ([u32; 6], Option<[u32; 6]>) {
+    let metrics = [
+        glyph.left,
+        glyph.top,
+        glyph.right,
+        glyph.bottom,
+        glyph.advance,
+        glyph.offset,
+    ];
+    let rect = glyph.rect.map(|r| {
+        [
+            r.u0.to_bits(),
+            r.v0.to_bits(),
+            r.u1.to_bits(),
+            r.v1.to_bits(),
+            r.w,
+            r.h,
+        ]
+    });
+    (metrics.map(f32::to_bits), rect)
+}
