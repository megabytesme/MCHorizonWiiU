+#[cfg(unix)]
+#[test]
+fn replaced_archive_evicts_seed_and_old_font_reads_its_original_lazy_provider() -> crate::Result<()>
+{
+    const FONT: &str = "assets/minecraft/font/default.json";
+    const HEX: &str = "assets/minecraft/font/fixture.zip";
+    const PNG: &str = "assets/minecraft/textures/gui/fixture.png";
+    fn publish(root: &Path, bits: &str) -> crate::Result<[u8; 32]> {
+        let mut zip = zip::ZipWriter::new(fs::File::create(root.join(HEX))?);
+        zip.start_file("glyphs.hex", zip::write::SimpleFileOptions::default())?;
+        zip.write_all(format!("0041:{}\n", bits.repeat(16)).as_bytes())?;
+        zip.finish()?;
+        horizon_core::prepared_files::write(root)?;
+        Ok(Sha256::digest(fs::read(
+            root.join(horizon_core::prepared_files::FILE_NAME),
+        )?)
+        .into())
+    }
+    let temp = tempfile::tempdir()?;
+    let root = temp.path();
+    let cancel = AtomicBool::new(false);
+    let open = |receipt| ResourceSource::reopen_verified_assets_host(root, receipt, &cancel);
+    assert!(open([0; 32])?.is_none());
+    for name in [FONT, PNG] {
+        fs::create_dir_all(root.join(name).parent().unwrap())?;
+    }
+    fs::write(root.join("horizon-resources.json"), b"{}")?;
+    fs::write(
+        root.join(FONT),
+        br#"{"providers":[{"type":"unihex","hex_file":"minecraft:font/fixture.zip"}]}"#,
+    )?;
+    let mut encoder = png::Encoder::new(fs::File::create(root.join(PNG))?, 4, 4);
+    encoder.set_color(png::ColorType::Rgba);
+    encoder.set_depth(png::BitDepth::Eight);
+    encoder.write_header()?.write_image_data(&[255; 64])?;
+
+    let first = publish(root, "18")?;
+    let file_size = fs::metadata(root.join(horizon_core::prepared_files::FILE_NAME))?.len();
+    let old = open(first)?.ok_or("old verified snapshot missing")?;
+    let old_live = old.liveness();
+    assert_eq!(old.namespaces("assets"), ["minecraft"]);
+    assert_eq!(
+        old.list_prepared_assets("assets/minecraft/textures/gui")
+            .unwrap(),
+        [PNG]
+    );
+    assert_eq!(old.list_under("assets", &["font"]), [FONT, HEX]);
+    assert!(old.contains(PNG));
+    assert_eq!(old.read_head(PNG, 8)?, b"\x89PNG\r\n\x1a\n");
+    assert!(old.read_limited(HEX, 12).is_err());
+    assert!(old.read("horizon-resources.json").is_err());
+    // This loose path never entered the verified archive.
+    let loose = "assets/minecraft/font/only-loose.json";
+    fs::write(root.join(loose), b"loose fallback")?;
+    assert!(!old.contains(loose));
+    assert!(
+        !old.list("assets/minecraft/font/")
+            .iter()
+            .any(|name| name == loose)
+    );
+    fs::remove_file(root.join(loose))?;
+
+    let atlas = HudAtlas::build(&old)?;
+    let row_bytes = atlas.width as usize * 4;
+    let pitch = row_bytes + 64;
+    let height = atlas.height as usize;
+    let seed =
+        Arc::new(StockSeed::capture(atlas, SLOT_BYTES, &cancel).ok_or("fixture seed too large")?);
+    let seed_live = Arc::downgrade(&seed);
+    let mut slot = Slot::new(SLOT_BYTES);
+    assert!(slot.offer(&old, Arc::clone(&seed), &cancel));
+    let mut surface = vec![0; pitch * height];
+    let old_session = seed
+        .restore(&old, &mut surface, pitch, &cancel)
+        .ok_or("old session failed")?;
+    drop(surface);
+    drop(seed);
+    drop(old);
+    assert!(old_live());
+
+    let second = publish(root, "7E")?;
+    assert_eq!(
+        fs::metadata(root.join(horizon_core::prepared_files::FILE_NAME))?.len(),
+        file_size
+    );
+    assert_ne!(first, second);
+    assert!(matches!(open(first), Err(error) if error.kind() == std::io::ErrorKind::InvalidData));
+    let new = open(second)?.ok_or("replacement snapshot missing")?;
+    assert!(slot.checkout(Some(&new), &cancel).is_none());
+    assert_eq!(seed_live.strong_count(), 0);
+    assert_eq!(old_session.font.glyph('A').advance, 2.0);
+    drop(old_session);
+    assert!(!old_live());
+
+    // A mismatching receipt follows the normal resource path without offering a seed.
+    let fallback = ResourceSource::directory(root.to_path_buf());
+    assert!(slot.checkout(Some(&fallback), &cancel).is_none());
+    let fallback_atlas = HudAtlas::build(&fallback)?;
+    assert_eq!(fallback_atlas.font.glyph('A').advance, 4.0);
+    drop(fallback_atlas);
+    let new_atlas = HudAtlas::build(&new)?;
+    assert_eq!(new_atlas.font.glyph('A').advance, 4.0);
+    let new_seed =
+        Arc::new(StockSeed::capture(new_atlas, SLOT_BYTES, &cancel).ok_or("new seed failed")?);
+    assert!(slot.offer(&new, Arc::clone(&new_seed), &cancel));
+    cancel.store(true, Ordering::Release);
+    assert!(open(second)?.is_none());
+    assert!(new_seed.restore(&new, &mut [], pitch, &cancel).is_none());
+    assert!(slot.checkout(Some(&new), &cancel).is_none());
+    cancel.store(false, Ordering::Release);
+    assert!(slot.checkout(Some(&new), &cancel).is_none());
+    assert!(open(second)?.is_some());
+    Ok(())
+}
