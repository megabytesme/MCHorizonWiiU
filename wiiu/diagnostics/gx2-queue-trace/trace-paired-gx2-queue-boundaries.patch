+#ifdef HORIZON_GX2_QUEUE_TRACE
+bool horizon_gx2_profile_queue_begin(bool deferred)
+{
+   uint32_t sequence;
+   if (!horizon_gx2_profile_playing_sequence(&sequence) || sequence % QUEUE_STRIDE)
+      return false;
+   pending_queue_row.sequence = sequence;
+   pending_queue_row.deferred = deferred;
+   return true;
+}
+
+void horizon_gx2_profile_queue_point(HorizonGx2QueuePoint point)
+{
+   QueuePoint *sample = &pending_queue_row.points[point];
+   sample->cpu_begin = OSGetSystemTime();
+   sample->submitted = GX2GetLastSubmittedTimeStamp();
+   sample->retired = GX2GetRetiredTimeStamp();
+   GX2GetSwapStatus(&sample->swaps, &sample->flips, &sample->last_flip, &sample->last_vsync);
+   sample->cpu_end = OSGetSystemTime();
+}
+
+void horizon_gx2_profile_queue_finish(uint32_t outputs)
+{
+   if (outputs != 3 || current.stages[SCREENSHOT_STAGE]) return;
+   history->queue[history->queue_rows++ % QUEUE_ROWS] = pending_queue_row;
+}
+
+static void flush_queue_trace(void)
+{
+   static const char *const labels[] = {
+      "entry", "wait_begin", "wait_end", "tv_rendered", "tv_copy",
+      "drc_rendered", "pair_queued", "pair_finished"
+   };
+   _Static_assert(sizeof(labels) / sizeof(labels[0]) == GX2_QUEUE_POINTS, "queue point labels");
+   const uint32_t used = history->queue_rows;
+   const uint32_t first = used > QUEUE_ROWS ? used - QUEUE_ROWS : 0;
+   for (uint32_t index = first; index < used; ++index) {
+      const QueueRow *row = &history->queue[index % QUEUE_ROWS];
+      for (unsigned i = 0; i < GX2_QUEUE_POINTS; ++i) {
+         const QueuePoint *p = &row->points[i];
+         OSReport("Horizon GX2 queue point seq=%u deferred=%u point=%s cpu_begin=%lld cpu_end=%lld "
+                  "submitted=%lld retired=%lld swaps=%u flips=%u last_flip=%lld last_vsync=%lld\n",
+                  row->sequence, (unsigned)row->deferred, labels[i],
+                  (long long)p->cpu_begin, (long long)p->cpu_end, (long long)p->submitted,
+                  (long long)p->retired, p->swaps, p->flips,
+                  (long long)p->last_flip, (long long)p->last_vsync);
+      }
+   }
+   history->queue_rows = 0;
+}
+#endif
