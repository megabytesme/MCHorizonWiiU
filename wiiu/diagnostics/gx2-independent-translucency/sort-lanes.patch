+struct ViewSortLane {
+    cursor: SortCursor,
+    generation: u64,
+    queued_pair: Option<u64>,
+}
+
+struct ViewSorts {
+    centers: Vec<[f32; 3]>,
+    primary: ViewSortLane,
+    additional: Box<[ViewSortLane]>,
+}
+
+impl ViewSorts {
+    fn new(centers: Vec<[f32; 3]>, count: u32) -> Self {
+        // The native allocation has already admitted this exact count.
+        Self {
+            centers,
+            primary: ViewSortLane::default(),
+            additional: (1..count).map(|_| ViewSortLane::default()).collect(),
+        }
+    }
+
+    fn additional_bytes(count: u32) -> usize {
+        count.saturating_sub(1) as usize * std::mem::size_of::<ViewSortLane>()
+    }
+
+    fn lane<'lane>(
+        primary: &'lane mut ViewSortLane,
+        additional: &'lane mut [ViewSortLane],
+        view: u32,
+    ) -> Result<&'lane mut ViewSortLane, &'static str> {
+        if view == 0 {
+            Ok(primary)
+        } else {
+            additional
+                .get_mut(view as usize - 1)
+                .ok_or("GX2 sort view is unavailable")
+        }
+    }
+
+    fn prepare(
+        &mut self,
+        view: TerrainSortView,
+        pair: u64,
+        camera: [f64; 3],
+        origin: [i32; 3],
+        sorter: &mut Sorter,
+        upload: impl FnOnce(&[u32]) -> bool,
+    ) -> Result<usize, &'static str> {
+        let lane = Self::lane(&mut self.primary, &mut self.additional, view.slot)?;
+        let mut cursor = if lane.generation == view.generation {
+            lane.cursor
+        } else {
+            SortCursor::default()
+        };
+        let Some(indices) = cursor.update(&self.centers, camera, origin, sorter) else {
+            return Ok(0);
+        };
+        // Rendering both outputs for one camera may read the same lane.
+        // Another order in that pair would update memory already queued.
+        if lane.queued_pair == Some(pair) {
+            return Err("GX2 sort view would overwrite a queued order");
+        }
+        if !upload(indices) {
+            return Err("GX2 translucent terrain index upload failed");
+        }
+        lane.cursor = cursor;
+        lane.generation = view.generation;
+        Ok(indices.len())
+    }
+
+    fn queued(&mut self, view: TerrainSortView, pair: u64) -> Result<(), &'static str> {
+        let lane = Self::lane(&mut self.primary, &mut self.additional, view.slot)?;
+        if lane.generation != view.generation {
+            return Err("GX2 sort view assignment changed before publication");
+        }
+        lane.queued_pair = Some(pair);
+        Ok(())
+    }
+}
