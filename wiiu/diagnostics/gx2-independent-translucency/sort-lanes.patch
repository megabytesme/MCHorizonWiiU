       horizon_gx2_terrain_section_destroy_after_wait(section);
       assert(!sections && !buffers && !mapped);
    }
 }
 
+static void check_view_lanes(void)
+{
+   const uint32_t view_count = HORIZON_TERRAIN_MAX_SORT_VIEWS;
+   const uint32_t vertices = 20;
+   const uint32_t count = vertices / 4 * 6;
+   uint32_t estimated, bytes, verts;
+   HorizonGx2TerrainSection *section;
+   assert(horizon_gx2_terrain_section_estimate(vertices, &verts) == 0);
+   assert(horizon_gx2_terrain_section_estimate_sorted_views(vertices, view_count, &estimated) == 0);
+   assert(estimated == verts + view_count*64);
+   assert(horizon_gx2_terrain_section_create_sorted_views(
+      &section, vertices, view_count+1, fill_large, NULL, &bytes) == -1);
+   assert(!section && !bytes && !sections && !buffers);
+
+   fail_index_countdown = 3;
+   assert(horizon_gx2_terrain_section_create_sorted_views(
+      &section, vertices, view_count, fill_large, NULL, &bytes) == -2);
+   assert(!section && !bytes && !sections && !buffers);
+
+   assert(horizon_gx2_terrain_section_create_sorted_views(
+      &section, vertices, view_count, fill_large, NULL, &bytes) == 0);
+   assert(bytes == estimated && buffers == view_count+1 && sections == 2);
+   assert(!terrain_ready_sort_lane(section, view_count));
+   draw_count = 0;
+   for (uint32_t view = 0; view < view_count; ++view) {
+      uint32_t ordered[30];
+      for (uint32_t i = 0; i < count; ++i) ordered[i] = (i + 4*view) % vertices;
+      assert(!terrain_ready_sort_lane(section, view));
+      assert(horizon_gx2_terrain_section_update_indices_view(section, view, ordered, count) == 0);
+      terrain_draw_sorted(terrain_ready_sort_lane(section, view));
+   }
+   assert(draw_count == view_count);
+   for (uint32_t view = 0; view < view_count; ++view) {
+      const uint16_t *queued = draws[view].payload;
+      assert(draws[view].index_type == GX2_INDEX_TYPE_U16 && draws[view].index_count == count);
+      for (uint32_t n = 0; n < view; ++n) assert(draws[n].payload != queued);
+      for (uint32_t i = 0; i < count; ++i) assert(queued[i] == (i + 4*view) % vertices);
+   }
+   horizon_gx2_terrain_section_destroy(section);
+   assert(!sections && !buffers && !mapped);
+}
