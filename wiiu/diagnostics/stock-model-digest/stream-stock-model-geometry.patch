+fn sha_file(path: &Path) -> io::Result<sha2::digest::Output<Sha256>> {
+    let mut file = File::open(path)?;
+    let mut digest = Sha256::new();
+    let mut buffer = [0; WIRE_BUFFER_BYTES];
+    let mut bytes = 0;
+    loop {
+        let count = file.read(&mut buffer)?;
