+/* Only after a same-pair seed, during the GamePad callback. Keep the seeded
+ * color. The native hand pass resets this target's depth before drawing. */
+void horizon_gx2_world_scale_resume_seeded_gamepad(HorizonGx2WorldScale *scale);
+#endif
