 bool horizon_gx2_world_scale_composite_shared(HorizonGx2WorldScale *scale,
                                               const uint32_t viewport[4]);
+
+#ifdef HORIZON_GX2_PREHAND_DIAGNOSTIC
+/* Only from the TV scaled-world callback after finishing world color. A true
