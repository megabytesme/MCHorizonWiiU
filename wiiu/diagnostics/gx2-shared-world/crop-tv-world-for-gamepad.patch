@@ -18,3 +18,16 @@ void horizon_gx2_world_scale_begin(HorizonGx2WorldScale *scale, uint32_t target,
 /* Restore the WHB output. Upscale the world to the viewport on success. */
 void horizon_gx2_world_scale_end(HorizonGx2WorldScale *scale, uint32_t target,
                                   const uint32_t viewport[4], bool composite);
+
+/* Prepare crop geometry between frames after the previous pair's final
+ * retirement. Requires the same vertical camera projection for both outputs,
+ * a TV frustum covering the GamePad, and enough source texels to avoid
+ * undersampling the configured GamePad world size. */
+bool horizon_gx2_world_scale_prepare_shared(HorizonGx2WorldScale *scale,
+                                            const uint32_t tv[4], const uint32_t drc[4]);
+
+/* The caller has completed submission of this pair's TV world pass to the
+ * scaled color target and begun the GamePad WHB output. This copies only
+ * the cropped world color. The GamePad HUD is still drawn by its caller. */
+bool horizon_gx2_world_scale_composite_shared(HorizonGx2WorldScale *scale,
+                                              const uint32_t viewport[4]);
