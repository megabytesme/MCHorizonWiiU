foreach(required IN ITEMS WUT_LINKER_SCRIPT WUT_SPECS OUTPUT_LINKER_SCRIPT OUTPUT_SPECS)
   if(NOT DEFINED ${required})
      message(FATAL_ERROR "${required} is required")
   endif()
endforeach()
if(NOT EXISTS "${WUT_LINKER_SCRIPT}")
   message(FATAL_ERROR "Installed WUT linker script is missing: ${WUT_LINKER_SCRIPT}")
endif()
if(NOT EXISTS "${WUT_SPECS}")
   message(FATAL_ERROR "Installed WUT specs file is missing: ${WUT_SPECS}")
endif()

file(READ "${WUT_LINKER_SCRIPT}" linker_text)
file(READ "${WUT_SPECS}" specs_text)
string(REPLACE "\r\n" "\n" linker_text "${linker_text}")
string(REPLACE "\r\n" "\n" specs_text "${specs_text}")

# Validate the exact upstream layout before editing: the constructor-range fix
# depends on this one insertion point and must never silently produce a partial
# or duplicate linker script after a WUT update.
set(init_line "KEEP (*(SORT_NONE(.init)))")
string(FIND "${linker_text}" "${init_line}" init_position)
if(init_position LESS 0)
   message(FATAL_ERROR "Unexpected WUT linker script: missing ${init_line}")
endif()
string(LENGTH "${init_line}" init_length)
math(EXPR init_after "${init_position} + ${init_length}")
string(SUBSTRING "${linker_text}" ${init_after} -1 linker_remainder)
string(FIND "${linker_remainder}" "${init_line}" duplicate_init_position)
if(NOT duplicate_init_position LESS 0)
   message(FATAL_ERROR "Unexpected WUT linker script: multiple .init insertion points")
endif()
set(crtend_line "*crtend.o(.text .text.*)")
string(FIND "${linker_text}" "${crtend_line}" existing_crtend_position)
if(NOT existing_crtend_position LESS 0)
   message(FATAL_ERROR "Installed WUT linker script already contains the crtend placement")
endif()
string(REPLACE "${init_line}" "${init_line}\n      ${crtend_line}" local_linker_text "${linker_text}")

# The installed WUT specs must name the expected linker script exactly once;
# replace only that path while preserving its entry and all other link options.
set(wut_linker_token "-T %:getenv(DEVKITPRO /wut/share/wut.ld)")
string(FIND "${specs_text}" "${wut_linker_token}" specs_position)
if(specs_position LESS 0)
   message(FATAL_ERROR "Unexpected WUT specs file: missing ${wut_linker_token}")
endif()
string(LENGTH "${wut_linker_token}" specs_token_length)
math(EXPR specs_after "${specs_position} + ${specs_token_length}")
string(SUBSTRING "${specs_text}" ${specs_after} -1 specs_remainder)
string(FIND "${specs_remainder}" "${wut_linker_token}" duplicate_specs_position)
if(NOT duplicate_specs_position LESS 0)
   message(FATAL_ERROR "Unexpected WUT specs file: multiple linker-script references")
endif()
set(local_linker_token "-T ${OUTPUT_LINKER_SCRIPT}")
string(REPLACE "${wut_linker_token}" "${local_linker_token}" local_specs_text "${specs_text}")

get_filename_component(output_dir "${OUTPUT_LINKER_SCRIPT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
file(WRITE "${OUTPUT_LINKER_SCRIPT}" "${local_linker_text}")
file(WRITE "${OUTPUT_SPECS}" "${local_specs_text}")
