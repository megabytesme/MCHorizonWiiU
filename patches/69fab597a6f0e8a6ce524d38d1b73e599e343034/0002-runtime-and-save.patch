new file mode 100644
index 0000000000000000000000000000000000000000..39e5f151d0fe412897b8eb6bf8276b98fb762844
--- /dev/null
+++ b/crates/horizon-client/src/control/lan.rs
@@ -0,0 +1,372 @@
+//! Opt-in LAN carrier for the original text/JSON Agent Control protocol.
+use super::{MAX_LINE, Request};
+use horizon_friends::crypto::{self, Frame, Key, Role, SecureReader, SecureWriter};
+use std::{
+    io::{self, BufRead, BufReader, Cursor, Read, Write},
+    net::{Ipv4Addr, SocketAddr, SocketAddrV4, TcpListener, TcpStream},
+    path::Path,
+    sync::{
+        Arc,
+        atomic::{AtomicBool, AtomicUsize, Ordering},
+        mpsc,
+    },
+    thread::{self, JoinHandle},
+    time::{Duration, Instant},
+};
+
+const GREETING: &[u8; 16] = b"HorizonCtl LAN\0\x01";
+const KEY_PURPOSE: &[u8] = b"Horizon Agent Control LAN v1 pairing";
+const HANDSHAKE: Duration = Duration::from_secs(4);
+const POLL: Duration = Duration::from_millis(10);
+pub const PAIRING_ENV: &str = "HORIZON_CONTROL_PAIRING";
+pub const CONFIG: &str = "control-lan.json";
+
+#[derive(Clone)]
+pub struct Pairing([u8; 16]);
+
+impl Pairing {
+    fn random() -> io::Result<Self> {
+        let mut secret = [0; 16];
+        getrandom::fill(&mut secret)
+            .map_err(|_| io::Error::other("Agent Control needs system entropy"))?;
+        Ok(Self(secret))
+    }
+
+    pub fn parse(code: &str) -> io::Result<Self> {
+        let bad = || {
+            io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "invalid Agent Control pairing code",
+            )
+        };
+        if code.len() != 32 || !code.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err(bad());
+        }
+        let mut secret = [0; 16];
+        for (i, b) in secret.iter_mut().enumerate() {
+            *b = u8::from_str_radix(&code[i * 2..i * 2 + 2], 16).map_err(|_| bad())?;
+        }
+        Ok(Self(secret))
+    }
+
+    pub(super) fn display(&self) -> String {
+        const HEX: &[u8; 16] = b"0123456789abcdef";
+        self.0
+            .iter()
+            .flat_map(|b| [HEX[(b >> 4) as usize], HEX[(b & 15) as usize]])
+            .map(char::from)
+            .collect()
+    }
+
+    fn key(&self) -> Key {
+        Key::from_psk(&self.0, KEY_PURPOSE)
+    }
+}
+
+pub fn private_address(ip: Ipv4Addr) -> bool {
+    ip.is_private() || ip.is_link_local()
+}
+
+/// An optional address override is strict and carries no credential.
+pub fn configured_address(path: &Path) -> io::Result<Option<SocketAddrV4>> {
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Config {
+        listen: SocketAddrV4,
+    }
+    let mut data = Vec::new();
+    match std::fs::File::open(path) {
+        Ok(file) => {
+            file.take(257).read_to_end(&mut data)?;
+        }
+        Err(err) if err.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(err) => return Err(err),
+    }
+    let bad = || {
+        io::Error::new(
+            io::ErrorKind::InvalidData,
+            "invalid Agent Control LAN configuration",
+        )
+    };
+    let config: Config = serde_json::from_slice(&data).map_err(|_| bad())?;
+    if data.len() > 256 || !private_address(*config.listen.ip()) {
+        return Err(bad());
+    }
+    Ok(Some(config.listen))
+}
+
+pub(super) struct Listener {
+    pub address: SocketAddrV4,
+    pub pairing: Pairing,
+    closed: Arc<AtomicBool>,
+    worker: Option<JoinHandle<()>>,
+}
+
+impl Listener {
+    pub(super) fn start(
+        address: SocketAddrV4,
+        sender: mpsc::Sender<Request>,
+        clients: Arc<AtomicUsize>,
+    ) -> io::Result<Self> {
+        if !private_address(*address.ip()) && !address.ip().is_loopback() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "Agent Control requires a private LAN address",
+            ));
+        }
+        let pairing = Pairing::random()?;
+        let key = pairing.key();
+        let listener = TcpListener::bind(address)?;
+        listener.set_nonblocking(true)?;
+        let SocketAddr::V4(address) = listener.local_addr()? else {
+            return Err(io::Error::other("Agent Control did not bind IPv4"));
+        };
+        let closed = Arc::new(AtomicBool::new(false));
+        let stop = closed.clone();
+        let worker = thread::Builder::new()
+            .name("horizon-control-lan".into())
+            .spawn(move || {
+                while !stop.load(Ordering::Acquire) {
+                    match listener.accept() {
+                        Ok((socket, SocketAddr::V4(peer)))
+                            if private_address(*peer.ip())
+                                || (address.ip().is_loopback() && peer.ip().is_loopback()) =>
+                        {
+                            if let Ok(link) =
+                                Link::open(socket, &key, Role::Host, stop.clone(), None)
+                            {
+                                clients.store(1, Ordering::Release);
+                                serve(link, &sender, &stop);
+                                clients.store(0, Ordering::Release);
+                            }
+                        }
+                        Ok(_) => {}
+                        Err(e)
+                            if matches!(
+                                e.kind(),
+                                io::ErrorKind::WouldBlock | io::ErrorKind::Interrupted
+                            ) =>
+                        {
+                            thread::sleep(POLL)
+                        }
+                        Err(e) => {
+                            log::warn!("Horizon: Agent Control LAN listener stopped: {e}");
+                            break;
+                        }
+                    }
+                }
+            })?;
+        Ok(Self {
+            address,
+            pairing,
+            closed,
+            worker: Some(worker),
+        })
+    }
+}
+
+impl Drop for Listener {
+    fn drop(&mut self) {
+        self.closed.store(true, Ordering::Release);
+        if let Some(worker) = self.worker.take() {
+            let _ = worker.join();
+        }
+    }
+}
+
+/// Cafe does not provide a send timeout. Poll explicitly for shutdown, a
+/// deadline, or a ready socket, including during a large screenshot reply.
+#[derive(Clone)]
+struct Socket(Arc<SocketState>);
+
+struct SocketState {
+    stream: TcpStream,
+    closed: Arc<AtomicBool>,
+    authenticated: AtomicBool,
+    handshake_end: Instant,
+    read_timeout: Option<Duration>,
+}
+
+impl Socket {
+    fn run<T>(
+        &self,
+        writing: bool,
+        mut operation: impl FnMut(&mut &TcpStream) -> io::Result<T>,
+    ) -> io::Result<T> {
+        let end = if !self.0.authenticated.load(Ordering::Acquire) {
+            Some(self.0.handshake_end)
+        } else {
+            let timeout = self.0.read_timeout.or(writing.then_some(HANDSHAKE));
+            timeout.and_then(|t| Instant::now().checked_add(t))
+        };
+        loop {
+            if self.0.closed.load(Ordering::Acquire) {
+                return Err(io::ErrorKind::ConnectionAborted.into());
+            }
+            if end.is_some_and(|end| Instant::now() >= end) {
+                return Err(io::ErrorKind::TimedOut.into());
+            }
+            match operation(&mut &self.0.stream) {
+                Err(e) if e.kind() == io::ErrorKind::WouldBlock => thread::sleep(POLL),
+                Err(e) if e.kind() == io::ErrorKind::Interrupted => continue,
+                result => return result,
+            }
+        }
+    }
+}
+impl Read for Socket {
+    fn read(&mut self, bytes: &mut [u8]) -> io::Result<usize> {
+        self.run(false, |s| s.read(bytes))
+    }
+}
+impl Write for Socket {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.run(true, |s| s.write(bytes))
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+pub struct Link {
+    reader: SecureReader<Socket>,
+    writer: SecureWriter<Socket>,
+    frame: Cursor<Vec<u8>>,
+}
+
+impl Link {
+    pub fn connect(
+        address: SocketAddrV4,
+        pairing: &Pairing,
+        timeout: Option<Duration>,
+    ) -> io::Result<Self> {
+        let stream = TcpStream::connect_timeout(&address.into(), HANDSHAKE)?;
+        Self::open(stream, &pairing.key(), Role::Guest, Arc::default(), timeout)
+    }
+
+    fn open(
+        stream: TcpStream,
+        key: &Key,
+        role: Role,
+        closed: Arc<AtomicBool>,
+        read_timeout: Option<Duration>,
+    ) -> io::Result<Self> {
+        stream.set_nonblocking(true)?;
+        let _ = stream.set_nodelay(true);
+        let mut socket = Socket(Arc::new(SocketState {
+            stream,
+            closed,
+            authenticated: AtomicBool::new(false),
+            handshake_end: Instant::now() + HANDSHAKE,
+            read_timeout,
+        }));
+        if role == Role::Guest {
+            socket.write_all(GREETING)?;
+        }
+        let mut greeting = [0; GREETING.len()];
+        socket.read_exact(&mut greeting)?;
+        if &greeting != GREETING {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "incompatible Agent Control LAN handshake",
+            ));
+        }
+        if role == Role::Host {
+            socket.write_all(GREETING)?;
+        }
+        let (reader, writer) =
+            crypto::secure(socket.clone(), socket.clone(), key, role).map_err(|error| {
+                if crypto::is_wrong_code(&error) {
+                    io::Error::new(
+                        io::ErrorKind::PermissionDenied,
+                        "Agent Control pairing failed",
+                    )
+                } else {
+                    error
+                }
+            })?;
+        socket.0.authenticated.store(true, Ordering::Release);
+        Ok(Self {
+            reader,
+            writer,
+            frame: Cursor::new(Vec::new()),
+        })
+    }
+
+    fn peer_ended(&self) -> bool {
+        match self.reader.get_ref().0.stream.peek(&mut [0]) {
+            Ok(0) => true,
+            Err(e) => matches!(
+                e.kind(),
+                io::ErrorKind::ConnectionAborted
+                    | io::ErrorKind::ConnectionReset
+                    | io::ErrorKind::NotConnected
+                    | io::ErrorKind::BrokenPipe
+            ),
+            Ok(_) => false,
+        }
+    }
+}
+impl Read for Link {
+    fn read(&mut self, bytes: &mut [u8]) -> io::Result<usize> {
+        if bytes.is_empty() {
+            return Ok(0);
+        }
+        loop {
+            let n = self.frame.read(bytes)?;
+            if n != 0 {
+                return Ok(n);
+            }
+            self.frame = match self.reader.read_frame()? {
+                Some(Frame::Data(data)) => Cursor::new(data),
+                Some(Frame::Control(_)) => return Err(io::ErrorKind::InvalidData.into()),
+                None => return Ok(0),
+            };
+        }
+    }
+}
+impl Write for Link {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.writer.write_data(bytes)?;
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+fn serve(link: Link, sender: &mpsc::Sender<Request>, closed: &AtomicBool) {
+    let mut reader = BufReader::new(link);
+    while !closed.load(Ordering::Acquire) {
+        let mut line = String::new();
+        if !matches!((&mut reader).take(MAX_LINE + 1).read_line(&mut line), Ok(n) if n > 0 && n as u64 <= MAX_LINE)
+            || !line.ends_with('\n')
+        {
+            return;
+        }
+        line.truncate(line.trim_end_matches(['\r', '\n']).len());
+        if line.trim().is_empty() {
+            continue;
+        }
+        let (reply, response) = mpsc::channel();
+        if sender.send(Request { line, reply }).is_err() {
+            return;
+        }
+        loop {
+            if closed.load(Ordering::Acquire) {
+                return;
+            }
+            match response.recv_timeout(POLL) {
+                Ok(reply) => {
+                    if writeln!(reader.get_mut(), "{reply}").is_err() {
+                        return;
+                    }
+                    break;
+                }
+                Err(mpsc::RecvTimeoutError::Timeout) if !reader.get_ref().peer_ended() => {}
+                Err(mpsc::RecvTimeoutError::Timeout) => return,
+                Err(mpsc::RecvTimeoutError::Disconnected) => return,
+            }
+        }
+    }
+}
