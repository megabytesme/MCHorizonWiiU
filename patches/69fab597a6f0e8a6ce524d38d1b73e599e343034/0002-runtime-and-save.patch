+++ b/crates/horizon-client/tests/control_lan.rs
@@ -0,0 +1,229 @@
+//! Host integration for the same wire listener used on Cafe, including the
+//! desktop horizon-ctl executable and MCP JSON-RPC over its real stdio.
+use horizon_client_lib::control::{
+    Request, Server,
+    lan::{self, Link, Pairing},
+};
+use serde_json::{Value, json};
+use std::{
+    io::{BufRead, BufReader, Read, Write},
+    net::{Ipv4Addr, SocketAddr, SocketAddrV4, TcpStream, UdpSocket},
+    path::PathBuf,
+    process::{Child, Command, Stdio},
+    sync::mpsc,
+    thread,
+    time::{Duration, Instant},
+};
+
+const WAIT: Duration = Duration::from_secs(8);
+
+fn request(server: &Server) -> Request {
+    let end = Instant::now() + WAIT;
+    loop {
+        if let Some(request) = server.try_recv() {
+            return request;
+        }
+        assert!(Instant::now() < end, "command did not reach the game queue");
+        thread::sleep(Duration::from_millis(5));
+    }
+}
+
+fn await_idle(server: &Server) {
+    let end = Instant::now() + WAIT;
+    while server.clients() != 0 {
+        assert!(Instant::now() < end, "connection remained open");
+        thread::sleep(Duration::from_millis(5));
+    }
+}
+
+#[test]
+fn rejects_unpaired_peers_recovers_and_revokes_active_requests() {
+    let server = Server::start_lan(SocketAddrV4::new(Ipv4Addr::LOCALHOST, 0)).unwrap();
+    let address = server.lan_address().unwrap();
+    let code = server.lan_pairing_offer().unwrap();
+    let mut unpaired = TcpStream::connect(address).unwrap();
+    unpaired.set_read_timeout(Some(WAIT)).unwrap();
+    // No LAN handshake. Plaintext control commands never reach Game.
+    unpaired.write_all(b"state\nstate\nstate\n").unwrap();
+    let mut bytes = Vec::new();
+    let _ = unpaired.read_to_end(&mut bytes);
+    assert!(bytes.is_empty() && server.try_recv().is_none());
+
+    let mut wrong = code.clone();
+    wrong.replace_range(..1, if code.starts_with('0') { "1" } else { "0" });
+    let wrong = Pairing::parse(&wrong).unwrap();
+    assert!(Link::connect(address, &wrong, Some(WAIT)).is_err());
+    assert_eq!(server.clients(), 0);
+    assert!(server.try_recv().is_none());
+
+    let pairing = Pairing::parse(&code).unwrap();
+    let mut first = Link::connect(address, &pairing, Some(WAIT)).unwrap();
+    writeln!(first, "wait 100").unwrap();
+    let pending = request(&server);
+    assert_eq!(pending.line, "wait 100");
+    assert!(server.lan_pairing_offer().is_none());
+    // A dropped peer must not leave the listener waiting for a deferred reply.
+    drop(first);
+    await_idle(&server);
+    let mut second = Link::connect(address, &pairing, Some(WAIT)).unwrap();
+    writeln!(second, "state").unwrap();
+    let active = request(&server);
+    assert_eq!(active.line, "state");
+    drop(server);
+    assert!(active.reply.send("{}".to_owned()).is_err());
+    assert!(pending.reply.send("{}".to_owned()).is_err());
+    assert!(matches!(second.read(&mut [0; 1]), Ok(0) | Err(_)));
+    assert!(TcpStream::connect_timeout(&address.into(), Duration::from_millis(300)).is_err());
+}
+
+struct TempHome(PathBuf);
+impl TempHome {
+    fn new() -> Self {
+        let stamp = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let path = std::env::temp_dir().join(format!(
+            "horizon-control-lan-test-{}-{stamp}",
+            std::process::id()
+        ));
+        std::fs::create_dir(&path).unwrap();
+        Self(path)
+    }
+}
+impl Drop for TempHome {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+struct Mcp {
+    child: Child,
+    output: mpsc::Receiver<Value>,
+}
+impl Mcp {
+    fn send(&mut self, request: Value) {
+        writeln!(self.child.stdin.as_mut().unwrap(), "{request}").unwrap();
+    }
+    fn reply(&self, id: i32) -> Value {
+        let reply = self.output.recv_timeout(WAIT).expect("MCP did not reply");
+        assert_eq!(reply["id"], id);
+        assert!(reply.get("error").is_none(), "MCP protocol error");
+        reply["result"].clone()
+    }
+    fn call(&mut self, id: i32, tool: &str, arguments: Value) {
+        self.send(json!({"jsonrpc":"2.0","id":id,"method":"tools/call","params":{"name":tool,"arguments":arguments}}));
+    }
+}
+impl Drop for Mcp {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+#[test]
+fn real_mcp_session_on_the_host_lan_interface() {
+    // UDP connect selects the interface without sending packets. An opt-in
+    // environment value can select a particular interface on multihomed hosts.
+    let address = std::env::var("HORIZON_TEST_LAN_IP")
+        .ok()
+        .map(|ip| ip.parse().expect("HORIZON_TEST_LAN_IP must be IPv4"))
+        .or_else(|| {
+            let udp = UdpSocket::bind((Ipv4Addr::UNSPECIFIED, 0)).ok()?;
+            udp.connect((Ipv4Addr::new(192, 0, 2, 1), 9)).ok()?;
+            if let SocketAddr::V4(addr) = udp.local_addr().ok()? {
+                Some(*addr.ip())
+            } else {
+                None
+            }
+        });
+    let Some(address) = address.filter(|ip| lan::private_address(*ip)) else {
+        eprintln!("No private IPv4 interface available for the LAN MCP integration");
+        return;
+    };
+    let server = Server::start_lan(SocketAddrV4::new(address, 0)).unwrap();
+    let address = server.lan_address().unwrap();
+    assert!(!address.ip().is_loopback() && !address.ip().is_unspecified());
+    let home = TempHome::new();
+    let mut child = Command::new(env!("CARGO_BIN_EXE_horizon-ctl"))
+        .args(["--remote", &address.to_string(), "--timeout", "6", "mcp"])
+        .env("HORIZON_HOME", &home.0)
+        .env(lan::PAIRING_ENV, server.lan_pairing_offer().unwrap())
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    let stdout = child.stdout.take().unwrap();
+    let (tx, output) = mpsc::channel();
+    thread::spawn(move || {
+        for line in BufReader::new(stdout).lines().map_while(Result::ok) {
+            let Ok(value) = serde_json::from_str(&line) else {
+                return;
+            };
+            if tx.send(value).is_err() {
+                return;
+            }
+        }
+    });
+    let mut mcp = Mcp { child, output };
+    mcp.send(json!({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"test","version":"1"}}}));
+    let initialized = mcp.reply(1);
+    assert_eq!(initialized["serverInfo"]["name"], "horizon-ctl");
+    assert!(
+        initialized["instructions"]
+            .as_str()
+            .unwrap()
+            .starts_with("Start with state")
+    );
+    mcp.send(json!({"jsonrpc":"2.0","method":"notifications/initialized"}));
+    mcp.send(json!({"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}));
+    assert!(
+        mcp.reply(2)["tools"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .any(|tool| tool["name"] == "state")
+    );
+
+    mcp.call(3, "state", json!({}));
+    let state = request(&server);
+    assert_eq!(state.line, "state");
+    state
+        .reply
+        .send(r#"{"ok":true,"screen":"playing"}"#.to_owned())
+        .unwrap();
+    assert_eq!(mcp.reply(3)["isError"], false);
+    mcp.call(4, "key", json!({"key":"space","action":"tap"}));
+    let key = request(&server);
+    assert_eq!(key.line, "key space tap");
+    key.reply.send(r#"{"ok":true}"#.to_owned()).unwrap();
+    assert_eq!(mcp.reply(4)["isError"], false);
+
+    mcp.call(5, "screenshot_gamepad", json!({}));
+    let capture = request(&server);
+    assert_eq!(capture.line, "screenshot-gamepad capture.png");
+    let mut bytes = Vec::new();
+    let mut encoder = png::Encoder::new(&mut bytes, 1, 1);
+    encoder.set_color(png::ColorType::Rgba);
+    encoder
+        .write_header()
+        .unwrap()
+        .write_image_data(&[15, 27, 48, 255])
+        .unwrap();
+    let png = horizon_client_lib::lan::base64(&bytes);
+    capture
+        .reply
+        .send(json!({"ok":true,"width":1,"height":1,"png_base64":png}).to_string())
+        .unwrap();
+    let capture = mcp.reply(5);
+    assert_eq!(capture["isError"], false);
+    assert_eq!(capture["content"][0]["mimeType"], "image/png");
+    assert_eq!(capture["content"][0]["data"], png);
+
+    horizon_core::no_ai::set(&home.0, true).unwrap();
+    mcp.call(6, "state", json!({}));
+    assert_eq!(mcp.reply(6)["isError"], true);
+    assert!(server.try_recv().is_none());
+}
