+        for x in -6..=6 {
+            for z in -6..=6 {
+                stream.insert_remote(&mut world, roofed(x, z, stone, glowstone));
+            }
+        }
+        let expected: HashSet<_> = world
+            .chunks
+            .keys()
+            .copied()
+            .filter(|&(x, z)| in_view_distance(stream.center, stream.radius, x, z))
+            .flat_map(|(x, z)| (0..HEIGHT / 16).map(move |sy| (x, sy, z)))
+            .collect();
+        let mut pending = Vec::new();
+        let deadline = Instant::now() + Duration::from_secs(60);
+        while pending.is_empty() || stream.busy() {
+            assert!(Instant::now() < deadline, "mesh queue did not settle");
+            let (meshes, _) = if backpressured {
+                stream.update_with_upload_backpressure(&mut world, pending.len())
+            } else {
+                stream.update(&mut world)
+            };
+            pending.extend(meshes);
+            thread::sleep(Duration::from_millis(1));
+        }
+        let stalled = (
+            pending.len(),
+            pending
+                .iter()
+                .map(|(_, mesh)| mesh.capacity_bytes())
+                .sum::<usize>(),
+        );
+        if backpressured {
+            assert_eq!(stalled.0, stream.mesh_census().window);
+            assert!(!world.dirty_sections.is_empty());
+        } else {
+            assert_eq!(stalled.0, expected.len());
+        }
+
+        let mut uploaded = HashMap::new();
+        while !pending.is_empty() || stream.busy() || !world.dirty_sections.is_empty() {
+            assert!(
+                Instant::now() < deadline,
+                "dirty mesh requests did not drain"
+            );
+            let (meshes, _) = if backpressured {
+                stream.update_with_upload_backpressure(&mut world, pending.len())
+            } else {
+                stream.update(&mut world)
+            };
+            pending.extend(meshes);
+            let spent: Vec<_> = pending.drain(..pending.len().min(4)).collect();
+            uploaded.extend(spent.iter().map(|(key, mesh)| (*key, checksum(mesh))));
+            if backpressured {
+                stream.recycle_backpressured_meshes(spent);
+                let census = stream.mesh_census();
+                assert!(pending.len() + census.reserved <= census.window);
+            } else {
+                stream.free(spent);
+            }
+            thread::sleep(Duration::from_millis(1));
+        }
+        assert_eq!(uploaded.keys().copied().collect::<HashSet<_>>(), expected);
+        let gone = world.chunks.keys().copied().collect();
+        let saved = Arc::downgrade(world.chunks.get(&(0, 0)).unwrap());
+        drop(stream.forget_columns(&mut world, &gone));
+        assert!(world.chunks.is_empty());
+        assert!(saved.upgrade().is_none());
+        (stalled, uploaded)
+    };
+
+    let (baseline, before) = run(false);
+    let (bounded, after) = run(true);
+    assert_eq!(before, after, "bounded uploads changed section contents");
+    assert!(bounded.1 > 0 && bounded.1 < baseline.1);
+    println!("stalled uploads (sections, retained capacity bytes): {baseline:?} -> {bounded:?}");
+}
