new file mode 100644
index 0000000000000000000000000000000000000000..228212edecf2ae8ae765ab99fbd7f717a0581db3
--- /dev/null
+++ b/crates/horizon-client/src/save/entity_uuid.rs
@@ -0,0 +1,83 @@
+use crate::AtomicU64;
+use std::sync::{OnceLock, atomic::Ordering};
+
+#[cfg(target_os = "cafe")]
+fn seed() -> u64 {
+    // The native getrandom backend uses Cafe std's system RNG. Cafe std
+    // panics on process::id(), so only desktop mixes the PID into the seed.
+    getrandom::u64().expect("Cafe system RNG failed to seed entity UUIDs")
+}
+
+#[cfg(not(target_os = "cafe"))]
+fn seed() -> u64 {
+    let t = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_nanos() as u64);
+    t ^ (std::process::id() as u64).rotate_left(32)
+}
+
+/// A random (version 4, IETF variant) UUID as vanilla's four-int form.
+///
+/// Seed one shared counter per launch and advance it atomically on every
+/// call, so simultaneous spawns don't reuse a seed within one clock tick.
+pub fn random_uuid() -> [i32; 4] {
+    static NEXT: OnceLock<AtomicU64> = OnceLock::new();
+    let next = NEXT.get_or_init(|| AtomicU64::new(seed()));
+    // SplitMix64: distinct steps give distinct outputs before UUID masking.
+    let split = || {
+        let mut z = next
+            .fetch_add(0x9E37_79B9_7F4A_7C15, Ordering::Relaxed)
+            .wrapping_add(0x9E37_79B9_7F4A_7C15);
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    };
+    let (a, b) = (split(), split());
+    let a = (a & !0xF000) | 0x4000;
+    let b = (b & !(0xC000_0000_0000_0000)) | 0x8000_0000_0000_0000;
+    [(a >> 32) as i32, a as i32, (b >> 32) as i32, b as i32]
+}
+
+#[cfg(test)]
+mod tests {
+    use super::random_uuid;
+    use std::collections::HashSet;
+    use std::sync::Barrier;
+
+    #[test]
+    fn sets_version_and_variant_bits() {
+        for _ in 0..256 {
+            let uuid = random_uuid();
+            assert_eq!((uuid[1] >> 12) & 0xf, 4);
+            assert_eq!((uuid[2] as u32) >> 30, 0b10);
+        }
+    }
+
+    #[test]
+    fn rapid_calls_produce_unique_uuids() {
+        let uuids: HashSet<_> = (0..10_000).map(|_| random_uuid()).collect();
+        assert_eq!(uuids.len(), 10_000);
+    }
+
+    #[test]
+    fn concurrent_calls_produce_unique_uuids() {
+        const THREADS: usize = 8;
+        const PER_THREAD: usize = 2_000;
+        let start = Barrier::new(THREADS);
+        let uuids: HashSet<_> = std::thread::scope(|scope| {
+            let workers: Vec<_> = (0..THREADS)
+                .map(|_| {
+                    scope.spawn(|| {
+                        start.wait();
+                        (0..PER_THREAD).map(|_| random_uuid()).collect::<Vec<_>>()
+                    })
+                })
+                .collect();
+            workers
+                .into_iter()
+                .flat_map(|worker| worker.join().unwrap())
+                .collect()
+        });
+        assert_eq!(uuids.len(), THREADS * PER_THREAD);
+    }
+}
