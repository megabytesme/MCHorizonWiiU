new file mode 100644
index 0000000000000000000000000000000000000000..b3deb008ab75272e3164132f0c78f2f6cbc8ff3b
--- /dev/null
+++ b/crates/horizon-client-render/src/audio/decode.rs
@@ -0,0 +1,157 @@
+use super::{CAFE, Samples};
+use std::{
+    fs::File,
+    path::Path,
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+};
+use symphonia::core::{
+    audio::{AudioBufferRef, Signal},
+    codecs::DecoderOptions,
+    formats::FormatOptions,
+    io::MediaSourceStream,
+    meta::MetadataOptions,
+    probe::Hint,
+};
+
+pub(super) const SAMPLE_BYTES: usize = size_of::<f32>();
+pub(super) const CAFE_BUFFER_BYTES: usize = 4 << 20;
+pub(super) const BUFFER_BYTES: usize = if CAFE {
+    CAFE_BUFFER_BYTES
+} else {
+    isize::MAX as usize
+};
+
+/// Decode one Vorbis packet at a time, downmixing directly from its planar PCM.
+/// The consumer may stop the decode before the next packet is read.
+pub(super) fn packets(
+    path: &Path,
+    begin: impl FnOnce(u32, Option<u64>) -> Option<()>,
+    mut consume: impl FnMut(u32, usize, &mut dyn Iterator<Item = f32>) -> Option<()>,
+) -> Option<(u64, u32)> {
+    let source = MediaSourceStream::new(Box::new(File::open(path).ok()?), Default::default());
+    let mut hint = Hint::new();
+    hint.with_extension("ogg");
+    let mut format = symphonia::default::get_probe()
+        .format(
+            &hint,
+            source,
+            &FormatOptions::default(),
+            &MetadataOptions::default(),
+        )
+        .ok()?
+        .format;
+    let track = format.default_track()?;
+    let id = track.id;
+    let rate = track.codec_params.sample_rate.filter(|&rate| rate != 0)?;
+    begin(rate, track.codec_params.n_frames)?;
+    let mut decoder = symphonia::default::get_codecs()
+        .make(&track.codec_params, &DecoderOptions::default())
+        .ok()?;
+    let mut decoded = 0u64;
+    while let Ok(packet) = format.next_packet() {
+        if packet.track_id() != id {
+            continue;
+        }
+        let Ok(buffer) = decoder.decode(&packet) else {
+            continue;
+        };
+        // Vorbis is the only enabled codec and emits planar f32.
+        let AudioBufferRef::F32(buffer) = buffer else {
+            return None;
+        };
+        let frames = buffer.frames();
+        if frames == 0 {
+            continue;
+        }
+        let planes = buffer.planes();
+        let channels = planes.planes();
+        let mut mono = (0..frames).map(|i| {
+            channels.iter().map(|channel| channel[i]).sum::<f32>() / channels.len() as f32
+        });
+        consume(rate, frames, &mut mono)?;
+        decoded += frames as u64;
+    }
+    Some((decoded, rate))
+}
+
+pub(super) fn decode_buffered(path: &Path, streaming: bool, limit_bytes: usize) -> Samples {
+    static SHORT_REPORTS: AtomicUsize = AtomicUsize::new(0);
+    let report = CAFE && SHORT_REPORTS.fetch_add(1, Ordering::Relaxed) < 12;
+    let mode = if streaming {
+        "stream-buffered"
+    } else {
+        "buffered"
+    };
+    let asset = path.display();
+    let mut mono = Vec::new();
+    let result = packets(
+        path,
+        |rate, estimate| {
+            let estimated_pcm_bytes = estimate.and_then(|n| n.checked_mul(SAMPLE_BYTES as u64));
+            if report {
+                log::info!(
+                    "Horizon audio decode begin asset={asset} mode={mode} rate={rate} estimated_pcm_bytes={estimated_pcm_bytes:?}"
+                );
+            }
+            if estimated_pcm_bytes.is_some_and(|bytes| bytes > limit_bytes as u64) {
+                log::warn!(
+                    "Horizon audio decode skipped oversized asset={asset} mode={mode} rate={rate} decoded_samples=0 estimated_pcm_bytes={estimated_pcm_bytes:?} limit_bytes={limit_bytes}"
+                );
+                return None;
+            }
+            Some(())
+        },
+        |rate, frames, pcm| {
+            let needed = mono.len().checked_add(frames)?;
+            let limit = limit_bytes / SAMPLE_BYTES;
+            if needed > limit {
+                log::warn!(
+                    "Horizon audio decode stopped before oversized growth asset={asset} mode={mode} rate={rate} decoded_samples={} next_pcm_bytes={} limit_bytes={limit_bytes}",
+                    mono.len(),
+                    needed.saturating_mul(SAMPLE_BYTES),
+                );
+                return None;
+            }
+            if needed > mono.capacity() {
+                let capacity = needed.next_power_of_two().max(4).min(limit);
+                if CAFE && capacity >= (1 << 16) {
+                    // Cafe's System allocator reallocates by copying. Both
+                    // blocks must fit until the copy completes.
+                    let resize_peak_bytes = (mono.capacity() + capacity) * SAMPLE_BYTES;
+                    log::info!(
+                        "Horizon audio decode reserving asset={asset} mode={mode} rate={rate} decoded_samples={} capacity_bytes={} requested_bytes={} resize_peak_bytes={resize_peak_bytes} limit_bytes={limit_bytes}",
+                        mono.len(),
+                        mono.capacity() * SAMPLE_BYTES,
+                        capacity * SAMPLE_BYTES,
+                    );
+                }
+                if let Err(error) = mono.try_reserve_exact(capacity - mono.len()) {
+                    log::warn!(
+                        "Horizon audio decode allocation failed asset={asset} mode={mode} rate={rate} decoded_samples={} requested_bytes={} error={error}",
+                        mono.len(),
+                        capacity * SAMPLE_BYTES,
+                    );
+                    return None;
+                }
+            }
+            mono.extend(pcm);
+            Some(())
+        },
+    );
+    match result {
+        Some((decoded, rate)) if decoded > 1 => {
+            if report || (CAFE && mono.capacity() >= (1 << 16)) {
+                log::info!(
+                    "Horizon audio decode complete asset={asset} mode={mode} rate={rate} decoded_samples={decoded} pcm_bytes={} capacity_bytes={}",
+                    mono.len() * SAMPLE_BYTES,
+                    mono.capacity() * SAMPLE_BYTES,
+                );
+            }
+            Some((Arc::new(mono), rate))
+        }
+        _ => None,
+    }
+}
