+use horizon_world::level::{Behaviours, GameplayProjection, GameplayStateSource, data};
+use serde_json::Value;
+use std::{
+    alloc::{GlobalAlloc, Layout, System},
+    cell::Cell,
+    fs,
+    io::{BufReader, Cursor, Write},
+    path::PathBuf,
+};
+
+#[derive(Clone, Copy, Default, Debug)]
+struct Usage {
+    live: usize,
+    peak: usize,
+}
+
+thread_local! {
+    static MEASUREMENT: Cell<Option<Usage>> = const { Cell::new(None) };
+}
+
+struct CountingSystem;
+
+#[global_allocator]
+static ALLOCATOR: CountingSystem = CountingSystem;
+
+fn account(change: impl FnOnce(&mut Usage)) {
+    let _ = MEASUREMENT.try_with(|slot| {
+        if let Some(mut usage) = slot.get() {
+            change(&mut usage);
+            slot.set(Some(usage));
+        }
+    });
+}
+
+// SAFETY: every allocation and deallocation forwards the unchanged layout to
+// System. The default realloc counts the old and new blocks during the copy,
+// matching Cafe.
+unsafe impl GlobalAlloc for CountingSystem {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let ptr = unsafe { System.alloc(layout) };
+        if !ptr.is_null() {
+            account(|usage| {
+                usage.live += layout.size();
+                usage.peak = usage.peak.max(usage.live);
+            });
+        }
+        ptr
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        account(|usage| usage.live -= layout.size());
+        unsafe { System.dealloc(ptr, layout) };
+    }
+}
+
+fn measure<T>(run: impl FnOnce() -> T) -> (T, Usage) {
+    MEASUREMENT.set(Some(Usage::default()));
+    let result = run();
+    (result, MEASUREMENT.take().unwrap())
+}
+
+#[test]
+fn large_unused_state_payloads_do_not_accumulate_during_projection() {
+    let mut source = br#"{"states":["#.to_vec();
+    let payload = "5,".repeat(4096);
+    for i in 0..1024 {
+        if i > 0 {
+            source.push(b',');
+        }
+        write!(
+            source,
+            r#"{{"emission":{i},"replaceable":true,"sound":{{"place":{{"id":"test:place"}}}},"unused":[{payload}0]}}"#,
+        )
+        .unwrap();
+    }
+    source.extend_from_slice(b"]}");
+    let (legacy, baseline) = measure(|| serde_json::from_slice::<Value>(&source).unwrap());
+    let (projected, bounded) = measure(|| GameplayProjection::read(Cursor::new(&source)).unwrap());
+    println!("synthetic legacy={baseline:?} projected={bounded:?}");
+    assert_eq!(projected.len(), 1024);
+    for (i, (raw, state)) in legacy["states"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .zip(&projected)
+        .enumerate()
+    {
+        assert_eq!(state.unsigned("emission"), i as u64);
+        assert_eq!(state.flag("replaceable"), raw.flag("replaceable"));
+        assert_eq!(state.sound_id("place"), "test:place");
+        assert_eq!(state.sound_number("pitch"), 1.0);
+    }
+    assert!(bounded.peak < 1 << 20, "{bounded:?}");
+    assert!(
+        bounded.peak * 100 < baseline.peak,
+        "{baseline:?} {bounded:?}"
+    );
