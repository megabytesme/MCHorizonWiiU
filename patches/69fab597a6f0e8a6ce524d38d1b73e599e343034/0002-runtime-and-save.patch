--- /dev/null
+++ b/crates/horizon-client-platform/src/cafe_net.rs
@@ -0,0 +1,24 @@
+//! Cafe's assigned IPv4 address without an external traffic probe.
+use std::{
+    io,
+    net::{Ipv4Addr, UdpSocket},
+};
+
+unsafe extern "C" {
+    fn horizon_wiiu_assigned_ipv4(out: *mut u32) -> i32;
+}
+
+pub fn assigned_ipv4() -> io::Result<Ipv4Addr> {
+    // Opening a standard socket initializes nsysnet and the configured
+    // connection. This ephemeral UDP socket sends no packets.
+    drop(UdpSocket::bind((Ipv4Addr::UNSPECIFIED, 0))?);
+    let mut address = 0;
+    // SAFETY: the native query writes one numerical 32-bit IPv4 address.
+    if unsafe { horizon_wiiu_assigned_ipv4(&mut address) } != 0 || address == 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::AddrNotAvailable,
+            "the Wii U has no assigned IPv4 address",
+        ));
+    }
+    Ok(Ipv4Addr::from(address))
+}
