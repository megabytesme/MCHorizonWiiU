+#[test]
+fn in_place_writes_extend_empty_and_unpadded_regions() {
+    let dir = Directory::new();
+    let path = dir.region();
+    let a = ChunkPos::new(-32, 0);
+    let b = ChunkPos::new(-31, 0);
+    let first = record(100);
+    let second = record(200);
+    fs::write(&path, []).unwrap();
+
+    // An existing empty file can be cached before the first save requests creation.
+    let mut region = RegionFile::open_writable(&path, false).unwrap();
+    region.write(a, &first).unwrap();
+    region.sync().unwrap();
+    drop(region);
+    let bytes = fs::read(&path).unwrap();
+    assert_eq!(bytes.len(), 3 * 4096);
+    assert_eq!(&bytes[..8], &[0, 0, 2, 1, 0, 0, 0, 0]);
+
+    // A valid record may still be readable when only sector padding was lost.
+    let unpadded_len = 8192 + 5 + first.compressed.len();
+    fs::File::options()
+        .write(true)
+        .open(&path)
+        .unwrap()
+        .set_len(unpadded_len as u64)
+        .unwrap();
+    let mut region = RegionFile::open_writable(&path, false).unwrap();
+    region.write(b, &second).unwrap();
+    region.sync().unwrap();
+    drop(region);
+    let bytes = fs::read(&path).unwrap();
+    assert_eq!(bytes.len(), 4 * 4096);
+    assert_eq!(&bytes[..8], &[0, 0, 2, 1, 0, 0, 3, 1]);
+    assert!(bytes[unpadded_len..3 * 4096].iter().all(|&b| b == 0));
+    let mut reader = RegionFile::open(&path).unwrap();
+    for (pos, expected) in [(a, first), (b, second)] {
+        let saved = reader.read(pos).unwrap().unwrap();
+        assert_eq!(saved.compressed, expected.compressed);
+        assert_eq!(saved.timestamp, expected.timestamp);
+    }
+}
