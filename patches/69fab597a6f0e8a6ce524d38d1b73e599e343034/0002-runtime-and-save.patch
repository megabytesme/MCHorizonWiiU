diff --git a/crates/horizon-client/tests/control_lan.rs b/crates/horizon-client/tests/control_lan.rs
new file mode 100644
index 0000000000000000000000000000000000000000..eab0384285ac4d1ec7bef573d2c762b359cf50eb
