+    let timestamp = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs() as u32);
+    let mut by_region: BTreeMap<_, Vec<_>> = BTreeMap::new();
+    for &((x, z), record) in records {
+        by_region
+            .entry((x >> 5, z >> 5))
+            .or_default()
+            .push((ChunkPos::new(x, z), record));
+    }
+    for ((rx, rz), list) in by_region {
+        let path = region_path(root, folder, rx, rz);
+        let mut region = None;
+        let mut changed = false;
+        for (pos, record) in list {
+            // Resolve one POI merge at a time too: its previous saved NBT is
+            // read from this cache before taking the region's write lock.
