+        };
+        let mut position = 0.0;
+        assert_eq!(stream.next(&mut position, 0.5), Some(0.0));
+        assert_eq!(stream.next(&mut position, 0.5), Some(0.25));
+        assert_eq!(stream.next(&mut position, 0.5), None);
+        stream.queue.extend([1.0, 0.0]);
