+impl Frame<'_> {
+    /// The fog color and environment/render-distance ranges used by world passes.
+    pub fn fog_uniforms(&self) -> ([f32; 4], [f32; 4]) {
+        if let Some(fog) = self.fog {
+            return (
+                fog.color,
+                [
+                    fog.environmental_start,
+                    fog.environmental_end,
+                    fog.render_distance_start,
+                    fog.render_distance_end,
+                ],
+            );
+        }
+        if self.underwater {
+            let [r, g, b] = self.water_fog;
+            return ([r, g, b, 1.0], [-8.0, 96.0, -8.0, 96.0]);
+        }
+        let [r, g, b] = self.sky.fog_color;
+        let (start, end) = self.environment_fog.unwrap_or((f32::MAX, f32::MAX));
+        let distance = self.distance;
+        (
+            [r, g, b, 1.0],
+            [
+                start,
+                end,
+                (distance - distance.min(64.0) * 0.25).max(0.0),
+                distance,
+            ],
+        )
+    }
+
+    /// World clear before the stock sky pass, with the same color on both backends.
+    pub fn base_clear_color(&self) -> [f32; 4] {
+        if self.title || (self.end_sky && !self.underwater && !self.sky_blocked) {
+            return [0.0, 0.0, 0.0, 1.0];
+        }
+        let ([r, g, b, _], _) = self.fog_uniforms();
+        [r, g, b, 1.0]
+    }
+}
