index 0000000000000000000000000000000000000000..450b6eb9b916d0f7bcc0ec203a471a5bf25ebafb
--- /dev/null
+++ b/crates/horizon-client-platform/src/cafe_memory.rs
@@ -0,0 +1,90 @@
+//! Startup checkpoints for the native app's System allocator. The counters
+//! add no allocation headers and report requested bytes, excluding GX2 and
+//! other allocations made on the C side.
+use std::{
+    alloc::{GlobalAlloc, Layout, System},
+    sync::atomic::{AtomicUsize, Ordering::Relaxed},
+};
+
+static LIVE: AtomicUsize = AtomicUsize::new(0);
+static BLOCKS: AtomicUsize = AtomicUsize::new(0);
+static PEAK: AtomicUsize = AtomicUsize::new(0);
+static FAILURES: AtomicUsize = AtomicUsize::new(0);
+
+unsafe extern "C" {
+    fn horizon_wiiu_memory_report(
+        label: *const u8,
+        len: usize,
+        live: usize,
+        peak: usize,
+        blocks: usize,
+    );
+    fn horizon_wiiu_memory_alloc_failure(
+        bytes: usize,
+        align: usize,
+        live: usize,
+        peak: usize,
+        blocks: usize,
+    );
+}
+
+/// Report both Rust allocation counters and the native backing heap snapshot.
+pub fn report(label: &str) {
+    // SAFETY: the native logger reads exactly the provided label bytes.
+    unsafe {
+        horizon_wiiu_memory_report(
+            label.as_ptr(),
+            label.len(),
+            LIVE.load(Relaxed),
+            PEAK.load(Relaxed),
+            BLOCKS.load(Relaxed),
+        );
+    }
+}
+
+pub struct MeasuredSystem;
+
+impl MeasuredSystem {
+    fn record(block: *mut u8, layout: Layout) -> *mut u8 {
+        if block.is_null() {
+            if FAILURES.fetch_add(1, Relaxed) < 4 {
+                // SAFETY: System has returned and released its heap lock.
+                // The native logger takes scalars and makes no Rust allocations.
+                unsafe {
+                    horizon_wiiu_memory_alloc_failure(
+                        layout.size(),
+                        layout.align(),
+                        LIVE.load(Relaxed),
+                        PEAK.load(Relaxed),
+                        BLOCKS.load(Relaxed),
+                    );
+                }
+            }
+        } else {
+            BLOCKS.fetch_add(1, Relaxed);
+            let live = LIVE.fetch_add(layout.size(), Relaxed) + layout.size();
+            PEAK.fetch_max(live, Relaxed);
+        }
+        block
+    }
+}
+
+// SAFETY: blocks and their layouts pass through unchanged to System. The
+// default realloc allocates, copies, then frees, as Cafe System does. Count
+// both blocks during the copy so this transient contributes to the peak.
+unsafe impl GlobalAlloc for MeasuredSystem {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        Self::record(unsafe { System.alloc(layout) }, layout)
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        Self::record(unsafe { System.alloc_zeroed(layout) }, layout)
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        LIVE.fetch_sub(layout.size(), Relaxed);
+        BLOCKS.fetch_sub(1, Relaxed);
+        // SAFETY: ptr and layout are unchanged from allocation by System.
+        unsafe { System.dealloc(ptr, layout) };
+    }
+}
