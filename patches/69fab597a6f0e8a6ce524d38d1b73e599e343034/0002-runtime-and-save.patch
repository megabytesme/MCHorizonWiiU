+//! Native Cafe's FS API provides no advisory file lock. Reserve the world in
+//! this process, then open its vanilla marker. The marker can outlive the
+//! process and does not carry lock state.
+use std::{
+    fs, io,
+    path::{Path, PathBuf},
+    sync::{Arc, Mutex},
+};
+
+static ACTIVE_WORLDS: Mutex<Vec<Arc<str>>> = Mutex::new(Vec::new());
+
+pub(super) struct WorldGuard(Arc<str>);
+
+impl WorldGuard {
+    pub(super) fn acquire(world: &Path) -> io::Result<(fs::File, Self)> {
+        let path = absolute(world)?;
+        let key = world_key(&path)?;
+        let mut active = ACTIVE_WORLDS.lock().unwrap_or_else(|e| e.into_inner());
+        if active.iter().any(|other| **other == key) {
+            return Err(io::Error::new(
+                io::ErrorKind::WouldBlock,
+                format!("{} is already open in this Horizon process", path.display()),
+            ));
+        }
+        let guard = Self(Arc::from(key));
+        active.push(guard.0.clone());
+        drop(active);
+
+        // On error the local guard drops, leaving the world available to retry.
+        let mut file = super::open_session_marker(&path)
+            .map_err(|error| marker_error(&path, "open", error))?;
+        super::write_session_marker(&mut file)
+            .map_err(|error| marker_error(&path, "write", error))?;
+        Ok((file, guard))
+    }
+
+    pub(super) fn is_locked(world: &Path) -> io::Result<bool> {
+        let path = absolute(world)?;
+        let key = world_key(&path)?;
+        let active = ACTIVE_WORLDS.lock().unwrap_or_else(|e| e.into_inner());
+        if active.iter().any(|other| **other == key) {
+            return Ok(true);
+        }
+        drop(active);
+        match fs::OpenOptions::new()
+            .write(true)
+            .open(path.join("session.lock"))
+        {
+            Ok(_) => Ok(false),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+            Err(error) => Err(marker_error(&path, "check", error)),
+        }
+    }
+}
+
+impl Drop for WorldGuard {
+    fn drop(&mut self) {
+        let mut active = ACTIVE_WORLDS.lock().unwrap_or_else(|e| e.into_inner());
+        active.retain(|other| !Arc::ptr_eq(other, &self.0));
+    }
+}
+
+fn absolute(world: &Path) -> io::Result<PathBuf> {
+    if world.is_absolute() {
+        Ok(world.to_owned())
+    } else {
+        Ok(std::env::current_dir()?.join(world))
+    }
+}
+
+fn world_key(path: &Path) -> io::Result<String> {
+    let path = path
+        .to_str()
+        .filter(|s| !s.contains('\0'))
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "invalid Cafe world path"))?;
+    #[cfg(windows)]
+    let path = path.replace('\\', "/");
+    let mut parts = Vec::new();
+    // Cafe world paths are slash-separated. Avoid canonicalize, which Cafe
+    // std does not implement, and fold case for the console SD card's FAT.
+    for part in path.split('/') {
+        match part {
+            "" | "." => {}
+            ".." => {
+                parts.pop();
+            }
+            part => parts.push(part),
+        }
+    }
+    Ok(parts.join("/").to_lowercase())
+}
+
+fn marker_error(world: &Path, operation: &str, error: io::Error) -> io::Error {
+    io::Error::new(
+        error.kind(),
+        format!(
+            "cannot {operation} {}: {error}",
+            world.join("session.lock").display()
+        ),
+    )
+}
