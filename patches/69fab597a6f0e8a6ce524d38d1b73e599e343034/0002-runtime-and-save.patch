index 0000000000000000000000000000000000000000..c46f1cc560be3f19826c413f0684ef103be72301
--- /dev/null
+++ b/crates/horizon-client-render/src/audio/stream.rs
@@ -0,0 +1,316 @@
+//! Cafe streams feed the existing mixer from a fixed PCM queue. File I/O and
+//! Vorbis decoding stay on the producer thread, outside the mixer lock.
+use super::{
+    ChannelId, Mixer, State,
+    decode::{SAMPLE_BYTES, packets},
+};
+use std::{
+    collections::VecDeque,
+    path::PathBuf,
+    sync::{Arc, Mutex, Weak},
+    thread,
+    time::Duration,
+};
+
+const QUEUE_SAMPLES: usize = 32_768;
+const PREFILL_SAMPLES: usize = 8_192;
+const REFILL_WAIT: Duration = Duration::from_millis(5);
+
+pub(super) struct StreamSamples {
+    queue: VecDeque<f32>,
+    pub(super) rate: u32,
+    pub(super) finished: bool,
+}
+
+impl StreamSamples {
+    pub(super) fn next(&mut self, position: &mut f64, step: f64) -> Option<f32> {
+        let used = (*position as usize).min(self.queue.len());
+        if used != 0 {
+            self.queue.drain(..used);
+            *position -= used as f64;
+        }
+        let first = *self.queue.front()?;
+        let second = self.queue.get(1).copied()?;
+        let fraction = *position as f32;
+        *position += step;
+        Some(first * (1.0 - fraction) + second * fraction)
+    }
+}
+
+pub(super) fn start(mixer: &Arc<Mutex<Mixer>>, id: ChannelId, path: PathBuf, looping: bool) {
+    let weak = Arc::downgrade(mixer);
+    log::info!("Horizon audio opening asset={} mode=stream", path.display());
+    let worker = thread::Builder::new()
+        .name("sound stream".into())
+        .spawn(move || produce(weak, id, path, looping));
+    if let Err(error) = worker {
+        log::warn!("Horizon audio could not start streaming decoder channel={id}: {error}");
+        if let Ok(mut mixer) = mixer.lock()
+            && let Some(channel) = mixer.channels.get_mut(&id)
+        {
+            channel.state = State::Stopped;
+        }
+    }
+}
+
+fn produce(mixer: Weak<Mutex<Mixer>>, id: ChannelId, path: PathBuf, looping: bool) {
+    let asset = path.display();
+    let queue_bytes = QUEUE_SAMPLES * SAMPLE_BYTES;
+    let mut first_pass = true;
+    let mut announced = false;
+    let mut cancelled = false;
+    loop {
+        let result = packets(
+            &path,
+            |rate, estimate| {
+                let pending = if first_pass {
+                    let estimated_pcm_bytes =
+                        estimate.and_then(|n| n.checked_mul(SAMPLE_BYTES as u64));
+                    log::info!(
+                        "Horizon audio decode begin asset={asset} mode=stream rate={rate} estimated_pcm_bytes={estimated_pcm_bytes:?} queue_bytes={queue_bytes}"
+                    );
+                    let mut queue = VecDeque::new();
+                    if let Err(error) = queue.try_reserve_exact(QUEUE_SAMPLES) {
+                        log::warn!(
+                            "Horizon audio decode allocation failed asset={asset} mode=stream rate={rate} decoded_samples=0 requested_bytes={queue_bytes} error={error}"
+                        );
+                        return None;
+                    }
+                    Some(StreamSamples {
+                        queue,
+                        rate,
+                        finished: false,
+                    })
+                } else {
+                    None
+                };
+                let mixer = mixer.upgrade()?;
+                let mut mixer = mixer.lock().ok()?;
+                let channel = mixer.channels.get_mut(&id)?;
+                if channel.state == State::Stopped {
+                    return None;
+                }
+                if let Some(pending) = pending {
+                    channel.stream = Some(pending);
+                }
+                (channel.stream.as_ref()?.rate == rate).then_some(())
+            },
+            |rate, frames, pcm| {
+                if frames > QUEUE_SAMPLES {
+                    return None;
+                }
+                // Wait only when the queue is full. Release the mixer lock
+                // before sleeping so playback, pause and stop can all advance.
+                let enqueue = || loop {
+                    {
+                        let mixer = mixer.upgrade()?;
+                        let mut mixer = mixer.lock().ok()?;
+                        let channel = mixer.channels.get_mut(&id)?;
+                        if channel.state == State::Stopped {
+                            return None;
+                        }
+                        let stream = channel.stream.as_mut()?;
+                        if frames <= QUEUE_SAMPLES - stream.queue.len() {
+                            stream.queue.extend(pcm);
+                            let queued = stream.queue.len();
+                            if channel.state == State::Initial && queued >= PREFILL_SAMPLES {
+                                channel.state = State::Playing;
+                            }
+                            return Some(queued);
+                        }
+                    }
+                    thread::sleep(REFILL_WAIT);
+                };
+                let Some(queued) = enqueue() else {
+                    cancelled = true;
+                    return None;
+                };
+                if !announced && queued >= PREFILL_SAMPLES {
+                    announced = true;
+                    log::info!(
+                        "Horizon audio playback ready asset={asset} mode=stream rate={rate} queued_samples={queued} queue_bytes={queue_bytes}"
+                    );
+                }
+                Some(())
+            },
+        );
+        match result {
+            Some((decoded, rate)) if decoded > 1 => {
+                if first_pass {
+                    log::info!(
+                        "Horizon audio decode complete asset={asset} mode=stream rate={rate} decoded_samples={decoded} pcm_bytes={} queue_bytes={queue_bytes}",
+                        decoded.saturating_mul(SAMPLE_BYTES as u64),
+                    );
+                }
+                if looping {
+                    first_pass = false;
+                    continue;
+                }
+            }
+            _ if !cancelled && first_pass => {
+                log::warn!("Horizon audio decode stopped asset={asset} mode=stream");
+            }
+            _ => {}
+        }
+        break;
+    }
+    if let Some(mixer) = mixer.upgrade()
+        && let Ok(mut mixer) = mixer.lock()
+        && let Some(channel) = mixer.channels.get_mut(&id)
+        && channel.state != State::Stopped
+    {
+        if let Some(stream) = &mut channel.stream
+            && stream.queue.len() > 1
+        {
+            stream.finished = true;
+            if channel.state == State::Initial {
+                channel.state = State::Playing;
+            }
+        } else {
+            channel.state = State::Stopped;
+        }
+    }
+}
+
