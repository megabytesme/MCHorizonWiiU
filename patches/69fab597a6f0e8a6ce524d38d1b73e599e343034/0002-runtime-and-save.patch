+            matches!(WorldGuard::acquire(&alias), Err(e) if e.kind() == io::ErrorKind::WouldBlock)
+        );
+        let independent = WorldGuard::acquire(&other).unwrap();
+        drop(held);
+        assert!(!WorldGuard::is_locked(&world).unwrap());
+        assert_eq!(fs::read(&marker).unwrap(), [0x26, 0x03]);
+        assert!(WorldGuard::is_locked(&other).unwrap());
+        assert!(WorldGuard::acquire(&world).is_ok());
+        drop(independent);
+    }
+
+    #[test]
+    fn separate_threads_cannot_both_hold_the_same_world() {
+        let scratch = Scratch::new();
+        let world = scratch.0.join("Contended World");
+        let start = Barrier::new(2);
+        let attempted = Barrier::new(2);
+        let try_open = || {
+            start.wait();
+            let held = WorldGuard::acquire(&world);
+            // Keep any success alive until both threads have attempted their
+            // open, so success on a later, uncontended open cannot mask a race.
+            attempted.wait();
+            held.map(drop).map_err(|error| error.kind())
+        };
+        let outcomes = std::thread::scope(|scope| {
+            let first = scope.spawn(try_open);
+            let second = scope.spawn(try_open);
+            [first.join().unwrap(), second.join().unwrap()]
+        });
+        assert!(outcomes.contains(&Ok(())));
+        assert!(outcomes.contains(&Err(io::ErrorKind::WouldBlock)));
+        assert!(WorldGuard::acquire(&world).is_ok());
+    }
+
+    #[test]
+    fn real_io_errors_are_reported_and_release_the_reservation() {
+        let scratch = Scratch::new();
+        let world = scratch.0.join("Blocked marker");
+        let marker = world.join("session.lock");
+        fs::create_dir_all(&marker).unwrap();
+        let Err(error) = WorldGuard::acquire(&world) else {
+            panic!("opened a directory as a file")
+        };
+        assert_ne!(error.kind(), io::ErrorKind::WouldBlock);
+        assert!(error.to_string().contains("session.lock"));
+        assert!(WorldGuard::is_locked(&world).is_err());
+        fs::remove_dir(&marker).unwrap();
+        assert!(!WorldGuard::is_locked(&world).unwrap());
+        assert!(WorldGuard::acquire(&world).is_ok());
+        let invalid = scratch.0.join("invalid\0name");
+        assert!(
+            matches!(WorldGuard::acquire(&invalid), Err(e) if e.kind() == io::ErrorKind::InvalidInput)
+        );
+    }
+
+    #[test]
+    #[ignore = "requires HORIZON_TEST_RESOURCES pointing to prepared resources"]
+    fn cafe_lock_round_trips_world_metadata_and_a_modified_chunk() {
+        use super::super::{Level, LevelShape, SaveDir};
+        use crate::{assets::Assets, biome::Biomes, chunk::Chunk};
+
+        let scratch = Scratch::new();
+        let world = scratch.0.join("Survival");
+        let resources = PathBuf::from(std::env::var_os("HORIZON_TEST_RESOURCES").unwrap());
+        let assets = Assets::load(&resources).unwrap();
+        let biomes = Arc::new(Biomes::load(&resources).unwrap());
+        let stone = assets.registry.default_state("minecraft:stone").unwrap().0;
+
+        let held = WorldGuard::acquire(&world).unwrap();
+        let mut level = Level {
+            name: "Survival".into(),
+            seed: 25,
+            ..Level::default()
+        };
+        level.write(&world).unwrap();
+        let save = SaveDir::new(world.clone(), LevelShape::OVERWORLD);
+        let mut chunk = Chunk::empty(0, 0);
+        chunk.set(5, 70, 6, stone);
+        save.save_later(&[Arc::new(chunk)], assets.registry, &biomes)
+            .unwrap();
+        save.flush().unwrap();
+        drop(save);
+        drop(held);
+
+        let _reopened = WorldGuard::acquire(&world).unwrap();
+        let level = Level::read(&world).unwrap();
+        assert_eq!(
+            (level.name.as_str(), level.seed, level.creative),
+            ("Survival", 25, false)
+        );
+        let save = SaveDir::new(world, LevelShape::OVERWORLD);
+        let chunk = save.load(0, 0, assets.registry, &biomes).unwrap();
+        assert_eq!(chunk.get(5, 70, 6), stone);
+    }
+}
