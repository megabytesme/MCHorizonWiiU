+    fn prepared_assets_reproduce_legacy_growth_and_play_through_bounded_audio() {
+        let root = PathBuf::from(std::env::var_os("HORIZON_AUDIO_TEST_RESOURCES").unwrap());
+        let sounds = root.join("assets/minecraft/sounds");
+        let long = sounds.join("music/game/haggstrom.ogg");
+        let mut legacy = Vec::new();
+        let mut at_growth = None;
+        let (decoded, rate) = packets(
+            &long,
+            |_, _| Some(()),
+            |_, _, pcm| {
+                for sample in pcm {
+                    let previous = legacy.capacity();
+                    legacy.push(sample);
+                    if previous * SAMPLE_BYTES == 32 << 20 && legacy.capacity() != previous {
+                        at_growth = Some((legacy.len(), legacy.capacity() * SAMPLE_BYTES));
+                    }
+                }
+                Some(())
+            },
+        )
+        .unwrap();
+        assert_eq!(rate, 44_100);
+        assert_eq!(at_growth, Some((8_388_609, 67_108_864)));
+        assert!(decode::decode_buffered(&long, false, decode::CAFE_BUFFER_BYTES).is_none());
+        println!("legacy samples={decoded} rate={rate} growth={at_growth:?}");
+
+        let mut audio = Audio::silent(Path::new("/nonexistent/horizon-audio-test-resources"));
+        let id = audio.backend.create(true).unwrap();
+        let mixer = audio.backend.mixer.clone();
+        start(&mixer, id, long, false);
+        let mut consumed = 0;
+        until(|| {
+            let mut mixer = mixer.lock().unwrap();
+            let channel = mixer.channels.get_mut(&id).unwrap();
+            if channel.state != State::Playing {
+                return channel.state == State::Stopped;
+            }
+            let stream = channel.stream.as_ref().unwrap();
+            assert!(stream.queue.len() <= QUEUE_SAMPLES);
+            assert_eq!(stream.queue.capacity(), QUEUE_SAMPLES);
+            while let Some(sample) = channel.next_sample(1.0) {
+                assert_eq!(sample, legacy[consumed], "sample {consumed}");
+                consumed += 1;
+            }
+            channel.state == State::Stopped
+        });
+        assert_eq!(consumed, legacy.len() - 1);
+        audio.backend.destroy(id);
+        println!("streamed {consumed} matching samples with a 131072-byte queue");
+
+        let click = sounds.join("random/click.ogg");
+        let (expected, rate) =
+            decode::decode_buffered(&click, false, decode::CAFE_BUFFER_BYTES).unwrap();
+        let id = audio.backend.create(true).unwrap();
+        start(&mixer, id, click, true);
+        until(|| {
+            let mixer = mixer.lock().unwrap();
+            let channel = &mixer.channels[&id];
+            channel.state == State::Playing
+                && channel.stream.as_ref().unwrap().queue.len() > expected.len() * 2
+        });
+        audio.backend.pause(id);
+        let mut out = vec![0.0; expected.len() * 2];
+        mix(&mut mixer.lock().unwrap(), &mut out, 1, rate);
+        assert!(out.iter().all(|&sample| sample == 0.0));
+        audio.backend.unpause(id);
+        let mut out = vec![0.0; expected.len() * 2];
+        mix(&mut mixer.lock().unwrap(), &mut out, 1, rate);
+        assert_eq!(&out[..expected.len()], expected.as_slice());
+        assert_eq!(&out[expected.len()..], expected.as_slice());
+        audio.backend.destroy(id);
+
+        let mut registry = SoundRegistry::default();
+        registry.add_file(
+            "minecraft",
+            br#"{"ui.button.click":{"sounds":["random/click"]},"foot":{"sounds":["step/grass1"]}}"#,
+            &|_, _| true,
+        );
+        audio.backend.live = true;
+        audio.engine.loaded = true;
+        audio.reload_with(&root, registry.clone());
+        for event in ["minecraft:ui.button.click", "minecraft:foot"] {
+            audio.play(event, None, 0.5, 1.0);
+        }
+        until(|| {
+            let mut mixer = mixer.lock().unwrap();
+            if !mixer.channels.values().all(|c| c.state == State::Playing) {
+                return false;
+            }
+            assert_eq!(mixer.channels.len(), 2);
+            let mut out = [0.0; 1024];
+            mix(&mut mixer, &mut out, 1, 44_100);
+            assert!(out.iter().any(|&sample| sample.abs() > 0.001));
+            true
+        });
+        audio.reload_with(&root, registry);
+        assert!(mixer.lock().unwrap().channels.is_empty());
+        assert!(audio.backend.cache.lock().unwrap().entries.is_empty());
+        audio.play_button_click();
+        until(|| {
+            mixer
+                .lock()
+                .unwrap()
+                .channels
+                .values()
+                .any(|c| c.state == State::Playing)
+        });
+    }
