+/// Project an affine, camera-relative view using Cafe's existing forward-Z
+/// depth convention. Rows include the upstream bob/damage/spin translation.
+pub fn terrain_view_rows(
+    view: [[f32; 4]; 4],
+    focal: f32,
+    aspect: f32,
+    depth_scale: f32,
+    depth_offset: f32,
+) -> TerrainClipRows {
+    let [x, y, z, w] = view;
+    TerrainClipRows {
+        rows: [
+            x.map(|value| value * (focal / aspect)),
+            y.map(|value| value * focal),
+            core::array::from_fn(|i| z[i] * depth_scale + w[i] * depth_offset),
+            z.map(|value| -value),
+        ],
+    }
+}
+
+impl TerrainClipRows {
+    /// Apply a section origin after subtracting the camera in world precision.
+    pub fn with_origin(self, [x, y, z]: [f64; 3]) -> Self {
+        Self {
+            rows: self.rows.map(|[a, b, c, d]| {
+                let offset = f64::from(a) * x
+                    + f64::from(b) * y
+                    + f64::from(c) * z
+                    + f64::from(d);
+                [a, b, c, offset as f32]
+            }),
+        }
+    }
+}
