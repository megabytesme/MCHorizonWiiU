+#[cfg(target_os = "cafe")]
+type HostedMcpPoll = fn(no_ai: bool, ready: bool) -> (Option<Request>, bool);
+#[cfg(target_os = "cafe")]
+static HOSTED_MCP: std::sync::OnceLock<(HostedMcpPoll, fn() -> bool)> = std::sync::OnceLock::new();
+
+/// Only the embedded launcher installs this hook. It contains no game pointer.
+#[cfg(target_os = "cafe")]
+pub fn install_hosted_mcp(poll: HostedMcpPoll, no_ai: fn() -> bool) {
+    let _ = HOSTED_MCP.set((poll, no_ai));
+}
+
+#[cfg(target_os = "cafe")]
+pub fn poll_hosted_mcp(no_ai: bool, ready: bool) -> (Option<Request>, bool) {
+    HOSTED_MCP.get().map_or((None, false), |(poll, _)| poll(no_ai, ready))
+}
+
+#[cfg(target_os = "cafe")]
+pub fn hosted_mcp_no_ai() -> bool {
+    HOSTED_MCP.get().is_some_and(|(_, no_ai)| no_ai())
+}
