+#[derive(Clone, Copy, Default)]
+struct Gx2ProfileDelta {
+    // Counts callbacks that reached the successful return; failed callbacks are omitted.
+    target_frames: [u32; 2],
+    target_ns: [u64; 2],
+    // Draw operations completed successfully, summed across TV and DRC callbacks.
+    section_draws: u32,
+    vertex_draws: u32,
