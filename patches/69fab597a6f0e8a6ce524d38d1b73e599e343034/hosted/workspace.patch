+        window.add_present(
+            Gx2ProfileDelta {
+                target_frames: [1, 0],
+                target_ns: [30, 0],
+                section_draws: 1,
+                vertex_draws: 36,
+                terrain_wait_ns: 8,
+                projection_ns: 9,
+                buffer_update_ns: 10,
+                draw_submit_ns: 11,
+                hud_draw_ns: 12,
+                ..Default::default()
+            },
+            60,
