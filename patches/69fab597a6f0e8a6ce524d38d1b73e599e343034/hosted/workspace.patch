+/// Cafe balances texture decoding across its existing workers, then restores
+/// source order before atlas packing so equal-size sprites keep their layout.
+#[cfg(any(target_os = "cafe", test))]
+fn cafe_ordered_atlas_decode<T: Send>(
+    count: usize,
+    workers: usize,
+    decode: impl Fn(usize) -> Option<T> + Sync,
+) -> Vec<T> {
+    if count == 0 {
+        return Vec::new();
+    }
+    let workers = workers.max(1).min(count);
+    std::thread::scope(|scope| {
+        let handles: Vec<_> = (0..workers)
+            .map(|worker| {
+                let decode = &decode;
+                scope.spawn(move || {
+                    (worker..count)
+                        .step_by(workers)
+                        .map(decode)
+                        .collect::<Vec<_>>()
+                })
+            })
+            .collect();
+        let mut streams: Vec<_> = handles
+            .into_iter()
+            .map(|handle| handle.join().unwrap_or_default().into_iter())
+            .collect();
+        (0..count)
+            .filter_map(|index| streams[index % workers].next().flatten())
+            .collect()
+    })
+}
