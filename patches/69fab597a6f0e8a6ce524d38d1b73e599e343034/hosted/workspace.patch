+    #[test]
+    fn condvar_poller_scans_tcp_and_keeps_pipe_wakeups() {
+        let worker = memory_worker();
+        let (pipe_client, pipe_server) = Pipe::pair();
+        let pipe_connection = Connection::local(pipe_server);
+        let pipe_served = serve_memory_on(pipe_connection, quiet, Duration::from_secs(30), &worker);
+
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let client = std::net::TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        client
+            .set_read_timeout(Some(Duration::from_secs(5)))
+            .unwrap();
+        let server = Connection::from_stream(listener.accept().unwrap().0).unwrap();
+        let tcp_served = serve_memory_on(server, quiet, Duration::from_secs(30), &worker);
+        std::thread::spawn(move || run(Poller::Memory, &worker));
+
+        // A silent TCP connection must not keep the worker from servicing a
+        // pipe, whose callback remains an immediate Condvar wake.
+        let mut pipe_client = Connection::local(pipe_client);
+        pipe_client.send(&body(4, 7)).unwrap();
+        assert_eq!(
+            pipe_served.next(),
+            Seen::Packet(4, body(4, 7)[1..].to_vec())
+        );
+
+        // Write a small packet frame in pieces; the scanner must retain the
+        // partial frame across its WouldBlock returns.
+        let mut client = client;
+        let payload = body(7, 11);
+        client.write_all(&[payload.len() as u8]).unwrap();
+        std::thread::sleep(tcp_poll_interval() * 2);
+        client.write_all(&payload[..3]).unwrap();
+        std::thread::sleep(tcp_poll_interval() * 2);
+        client.write_all(&payload[3..]).unwrap();
+        assert_eq!(tcp_served.next(), Seen::Packet(7, payload[1..].to_vec()));
+
+        let response = body(8, 13);
+        tcp_served.send(vec![response.clone()], None);
+        let mut received = vec![0; response.len() + 1];
+        client.read_exact(&mut received).unwrap();
+        assert_eq!(received, [&[response.len() as u8][..], &response].concat());
