+    projection_ns: u64,
+    buffer_update_ns: u64,
+    draw_submit_ns: u64,
+    hud_draw_ns: u64,
+}
+
+#[derive(Default)]
+struct Gx2ProfileWindow {
+    start: Option<Instant>,
+    present_calls: u32,
+    delta: Gx2ProfileDelta,
+    present_ns: u64,
+    // HUD presenter creation/recreation time, not the per-frame prepare callback.
+    hud_create_ns: u64,
+}
+
+impl Gx2ProfileWindow {
+    fn add_present(&mut self, delta: Gx2ProfileDelta, elapsed_ns: u64) {
+        for i in 0..2 {
+            self.delta.target_frames[i] =
+                self.delta.target_frames[i].saturating_add(delta.target_frames[i]);
+            self.delta.target_ns[i] = self.delta.target_ns[i].saturating_add(delta.target_ns[i]);
+        }
+        self.delta.section_draws = self.delta.section_draws.saturating_add(delta.section_draws);
+        self.delta.vertex_draws = self.delta.vertex_draws.saturating_add(delta.vertex_draws);
+        self.delta.terrain_wait_ns = self
+            .delta
+            .terrain_wait_ns
+            .saturating_add(delta.terrain_wait_ns);
+        self.delta.projection_ns = self.delta.projection_ns.saturating_add(delta.projection_ns);
+        self.delta.buffer_update_ns = self
+            .delta
+            .buffer_update_ns
+            .saturating_add(delta.buffer_update_ns);
+        self.delta.draw_submit_ns = self
+            .delta
+            .draw_submit_ns
+            .saturating_add(delta.draw_submit_ns);
+        self.delta.hud_draw_ns = self.delta.hud_draw_ns.saturating_add(delta.hud_draw_ns);
+        self.present_calls = self.present_calls.saturating_add(1);
+        self.present_ns = self.present_ns.saturating_add(elapsed_ns);
+    }
+
+    fn report_if_due(&mut self) {
+        let now = Instant::now();
+        let Some(start) = self.start else {
+            self.start = Some(now);
+            return;
+        };
+        let elapsed = now.duration_since(start);
+        if elapsed.as_secs() < 5 || self.present_calls == 0 {
+            return;
+        }
+        let d = self.delta;
+        let ms = |ns: u64| (ns / 1_000_000).min(u64::from(u32::MAX)) as u32;
+        unsafe {
+            OSReport(
+                "Horizon GX2 profile: window_ms=%u present_calls=%u tv_ok_callbacks=%u tv_ok_ms=%u drc_ok_callbacks=%u drc_ok_ms=%u section_draws=%u vertex_draws=%u wait_ms=%u project_ms=%u update_ms=%u submit_ms=%u hud_create_ms=%u hud_draw_ms=%u successful_target_ms=%u present_call_ms=%u\n\0"
+                    .as_ptr().cast(),
+                elapsed.as_millis().min(u128::from(u32::MAX)) as u32,
+                self.present_calls,
+                d.target_frames[0],
+                ms(d.target_ns[0]),
+                d.target_frames[1],
+                ms(d.target_ns[1]),
+                d.section_draws,
+                d.vertex_draws,
+                ms(d.terrain_wait_ns),
+                ms(d.projection_ns),
+                ms(d.buffer_update_ns),
+                ms(d.draw_submit_ns),
+                ms(self.hud_create_ns),
+                ms(d.hud_draw_ns),
+                ms(d.target_ns[0].saturating_add(d.target_ns[1])),
+                ms(self.present_ns),
+            );
+        }
+        self.start = Some(now);
+        self.present_calls = 0;
+        self.delta = Gx2ProfileDelta::default();
+        self.present_ns = 0;
+        self.hud_create_ns = 0;
+    }
+}
+
+fn elapsed_ns(start: Instant) -> u64 {
+    start.elapsed().as_nanos().min(u128::from(u64::MAX)) as u64
+}
