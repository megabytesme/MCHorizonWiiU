+unsafe extern "C" fn fill_terrain_atlas(context: *mut c_void, pixels: *mut u8, pitch: u32) -> i32 {
+    // The C adapter calls this synchronously with its validated mapped surface.
+    let upload = unsafe { &*context.cast::<TerrainAtlasUpload<'_>>() };
+    let Some(pitch) = (pitch as usize).checked_mul(4) else {
+        return -1;
+    };
+    let Some(bytes) = pitch.checked_mul(upload.layout.height as usize) else {
+        return -1;
+    };
+    let pixels = unsafe { std::slice::from_raw_parts_mut(pixels, bytes) };
+    if upload
+        .layout
+        .write_layers(upload.source, pixels, pitch)
+        .is_ok()
+    {
+        0
+    } else {
+        -1
+    }
+}
