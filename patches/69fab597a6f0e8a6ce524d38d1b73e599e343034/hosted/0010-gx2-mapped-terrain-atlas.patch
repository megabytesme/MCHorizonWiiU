+typedef struct AtlasRows {
+   const uint8_t *rgba;
+   uint32_t width, height;
+} AtlasRows;
+
+static int fill_atlas_rows(void *context, uint8_t *pixels, uint32_t pitch)
+{
+   const AtlasRows *rows = context;
+   const size_t row_bytes = (size_t)rows->width * 4;
+   for (uint32_t y = 0; y < rows->height; ++y)
+      memcpy(pixels + (size_t)y * pitch * 4, rows->rgba + (size_t)y * row_bytes, row_bytes);
+   return 0;
+}
+
+int horizon_gx2_terrain_create(HorizonGx2Terrain **out, const void *gfd,
+                               uint32_t width, uint32_t height,
+                               const uint8_t *rgba, size_t length)
+{
+   if (!rgba || !height || (size_t)width > SIZE_MAX / height / 4 ||
+       length < (size_t)width * height * 4) {
+      if (out) *out = NULL;
+      return -1;
+   }
+   AtlasRows rows = {rgba, width, height};
+   return horizon_gx2_terrain_create_mapped(out, gfd, width, height, fill_atlas_rows, &rows);
+}
