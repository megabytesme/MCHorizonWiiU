+static int create_texture(GX2Texture *texture, uint32_t width, uint32_t height)
+{
+   GX2Surface *s = &texture->surface;
+   s->use = GX2_SURFACE_USE_TEXTURE;
+   s->dim = GX2_SURFACE_DIM_TEXTURE_2D;
+   s->width = width;
+   s->height = height;
+   s->depth = s->mipLevels = 1;
+   s->format = GX2_SURFACE_FORMAT_UNORM_R8_G8_B8_A8;
+   s->aa = GX2_AA_MODE1X;
+   s->tileMode = GX2_TILE_MODE_LINEAR_ALIGNED;
+   texture->viewNumMips = texture->viewNumSlices = 1;
+   texture->compMap = GX2_COMP_MAP(GX2_SQ_SEL_R, GX2_SQ_SEL_G, GX2_SQ_SEL_B, GX2_SQ_SEL_A);
+   if (!GX2RCreateSurface(s, texture_flags)) return -2;
+   if (s->pitch < width || (size_t)s->imageSize < (size_t)s->pitch * height * 4) return -3;
+   GX2InitTextureRegs(texture);
+   return 0;
+}
