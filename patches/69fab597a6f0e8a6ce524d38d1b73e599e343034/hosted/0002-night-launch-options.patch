+impl PadSettings {
+    pub fn map_face_buttons(&self, input: PadState, style: GlyphStyle) -> PadState {
+        #[cfg(target_os = "cafe")]
+        if let Some(swap) = self.cafe_face_swap {
+            let mut mapped = input;
+            for (enabled, pair) in swap
+                .into_iter()
+                .zip([[Button::South, Button::East], [Button::West, Button::North]])
+            {
+                if enabled {
+                    mapped.set(pair[0], input.held(pair[1]));
+                    mapped.set(pair[1], input.held(pair[0]));
+                }
+            }
+            return mapped;
+        }
+        if style == GlyphStyle::Nintendo && self.nintendo_letters {
+            input.by_letter()
+        } else {
+            input
+        }
+    }
+}
+
 fn bool_text(v: bool) -> &'static str {
     if v { "true" } else { "false" }
 }
