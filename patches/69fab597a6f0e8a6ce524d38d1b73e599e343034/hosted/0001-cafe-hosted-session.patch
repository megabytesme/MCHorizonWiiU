 impl CafeLoadingSession {
+    /// The initial splash can be cancelled before the game title is usable.
+    #[cfg(target_os = "cafe")]
+    pub fn hosted_can_cancel(&self) -> bool {
+        self.loading.loaded.is_none() && self.loading.options.is_some()
+            && self.loading.menu.pending.is_none()
+    }
+
+    /// Join the top-level resource worker before draining its final message.
+    /// The optional world-resource tail can still be in that queued message.
+    #[cfg(target_os = "cafe")]
+    pub fn drain_hosted(&mut self) -> Result<()> {
+        let resources = self.loading.handle.take().map(std::thread::JoinHandle::join);
+        let world = join_cafe_creation(self.loading.menu.creation_job.take());
+        let mut tail = self.loading.loaded.as_mut()
+            .and_then(|loaded| loaded.as_mut().ok())
+            .and_then(|loaded| loaded.rest_loader.take())
+            .map(WorldRestLoader::finish)
+            .unwrap_or(Ok(()));
+        for message in self.loading.receiver.try_iter() {
+            if let LoaderMsg::Done(Ok(mut loaded)) = message {
+                if let Some(loader) = loaded.rest_loader.take() {
+                    tail = tail.and(loader.finish());
+                }
+            }
+        }
+        if matches!(resources, Some(Err(_))) {
+            return Err("Cafe resource worker panicked".into());
+        }
+        tail.and(world)
+    }
