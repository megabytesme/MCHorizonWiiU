diff --git a/crates/horizon-client-platform/src/cafe_profile.rs b/crates/horizon-client-platform/src/cafe_profile.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5c810e5a94d5589949e015d41e42a56858b03e9c
--- /dev/null
+++ b/crates/horizon-client-platform/src/cafe_profile.rs
@@ -0,0 +1,142 @@
+//! Cafe capture spans. Frame spans are owned by the main host thread.
+//! Thread-independent workload totals are recorded by Worker scopes.
+use std::marker::PhantomData;
+
+#[repr(u32)]
+#[derive(Clone, Copy)]
+pub enum Stage {
+    Input,
+    Idle,
+    WorldUpdate,
+    Streaming,
+    Tick,
+    Entities,
+    Particles,
+    Hud,
+    StageArtwork,
+    TerrainUpload,
+    TextureUpload,
+    SubmitTv,
+    SubmitDrc,
+    WaitFlip,
+    Finish,
+    TerrainWait,
+    Screenshot,
+    SavePoll,
+    Sleep,
+}
+
+#[repr(u32)]
+#[derive(Clone, Copy)]
+pub enum Worker {
+    Streaming,
+    Mesh,
+    Integrated,
+    Save,
+}
+
+#[repr(u32)]
+pub enum Phase {
+    Loading = 2,
+    Title,
+    WorldEntry,
+    Playing,
+    Menu,
+    Closing,
+}
+
+#[repr(u32)]
+pub enum Counter {
+    Presented,
+    Partial,
+    SectionDraws,
+    Indices,
+    UploadBytes,
+    HudVertices,
+    RustLive,
+    RustPeak,
+    RustBlocks,
+}
+
+unsafe extern "C" {
+    fn horizon_gx2_profile_begin(phase: u32) -> bool;
+    fn horizon_gx2_profile_finish();
+    fn horizon_gx2_profile_phase(phase: u32);
+    fn horizon_gx2_profile_stamp() -> u64;
+    fn horizon_gx2_profile_end(stage: u32, begin: u64);
+    fn horizon_gx2_profile_worker_end(worker: u32, begin: u64);
+    fn horizon_gx2_profile_count(counter: u32, value: u32);
+}
+
+pub struct Frame(bool, PhantomData<*mut ()>);
+impl Frame {
+    pub fn begin() -> Self {
+        Self(unsafe { horizon_gx2_profile_begin(Phase::Loading as u32) }, PhantomData)
+    }
+}
+impl Drop for Frame {
+    fn drop(&mut self) {
+        if !self.0 {
+            return;
+        }
+        super::cafe_memory::profile_snapshot();
+        unsafe { horizon_gx2_profile_finish() };
+    }
+}
+
+pub fn phase(phase: Phase) {
+    unsafe { horizon_gx2_profile_phase(phase as u32) }
+}
+
+pub fn count(counter: Counter, value: usize) {
+    unsafe { horizon_gx2_profile_count(counter as u32, value as u32) }
+}
+
+pub struct Span {
+    stage: Stage,
+    started: u64,
+    host_thread: PhantomData<*mut ()>,
+}
+impl Span {
+    pub fn new(stage: Stage) -> Self {
+        Self {
+            stage,
+            started: unsafe { horizon_gx2_profile_stamp() },
+            host_thread: PhantomData,
+        }
+    }
+}
+impl Drop for Span {
+    fn drop(&mut self) {
+        if self.started != 0 {
+            unsafe { horizon_gx2_profile_end(self.stage as u32, self.started) };
+        }
+    }
+}
+
+pub struct Work(Worker, u64);
+impl Work {
+    pub fn new(worker: Worker) -> Self {
+        Self(worker, unsafe { horizon_gx2_profile_stamp() })
+    }
+}
+impl Drop for Work {
+    fn drop(&mut self) {
+        if self.1 != 0 {
+            unsafe { horizon_gx2_profile_worker_end(self.0 as u32, self.1) };
+        }
+    }
+}
+
+/// The portable game sources use this macro to keep the Cafe hooks target-only.
+#[macro_export]
+macro_rules! cafe_span {
+    ($stage:ident) => {
+        #[cfg(target_os = "cafe")]
+        let _cafe_span = $crate::cafe_profile::Span::new($crate::cafe_profile::Stage::$stage);
+    };
+    ($binding:ident, $stage:ident) => {
+        #[cfg(target_os = "cafe")]
+        let $binding = $crate::cafe_profile::Span::new($crate::cafe_profile::Stage::$stage);
+    };
+}
