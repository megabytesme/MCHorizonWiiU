diff --git a/wiiu/loading_host/gx2_profile.c b/wiiu/loading_host/gx2_profile.c
new file mode 100644
index 0000000000000000000000000000000000000000..0f68927b173f463a88349b27138647e1ea4f57b0
--- /dev/null
+++ b/wiiu/loading_host/gx2_profile.c
@@ -0,0 +1,160 @@
+#include "gx2_profile.h"
+#include <coreinit/debug.h>
+#include <coreinit/time.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define CAPACITY 4096
+#define STAGES 19
+#define COUNTERS 9
+#define WORKERS 4
+#define ROOT "/vol/external01/wiiu/apps/HorizonWiiU/"
+#define CAPTURE ROOT "gx2-profile.hzp"
+
+typedef struct {
+   uint32_t sequence, phase, start_hi, start_lo, loop_ticks, pacing_ticks;
+   uint32_t stages[STAGES], counters[COUNTERS];
+   uint32_t workers[WORKERS][2];
+} ProfileFrame;
+
+typedef struct {
+   uint32_t magic, version, ticks_per_second, frame_size, capacity, count, total;
+} ProfileHeader;
+
+static _Atomic bool enabled;
+static _Atomic uint32_t workers[WORKERS][2];
+static ProfileFrame ring[CAPACITY], current;
+static uint32_t total;
+static uint64_t epoch, started, previous;
+static uint32_t previous_phase;
+static bool recording;
+
+static uint32_t ticks(uint64_t begin, uint64_t end)
+{
+   uint64_t elapsed = end - begin;
+   return elapsed > UINT32_MAX ? UINT32_MAX : (uint32_t)elapsed;
+}
+
+void horizon_gx2_profile_init(void)
+{
+   FILE *marker = fopen(ROOT "gx2-profile.enable", "rb");
+   if (!marker) return;
+   fclose(marker);
+   epoch = (uint64_t)OSGetSystemTime();
+   atomic_store_explicit(&enabled, true, memory_order_release);
+   OSReport("Horizon GX2 capture enabled, clock_hz=%u\n", OSTimerClockSpeed);
+}
+
+bool horizon_gx2_profile_begin(uint32_t phase)
+{
+   if (!atomic_load_explicit(&enabled, memory_order_acquire)) return false;
+   started = (uint64_t)OSGetSystemTime();
+   current = (ProfileFrame){.phase = phase};
+   recording = true;
+   return true;
+}
+
+void horizon_gx2_profile_phase(uint32_t phase)
+{
+   if (recording) current.phase = phase;
+}
+
+uint64_t horizon_gx2_profile_stamp(void)
+{
+   return atomic_load_explicit(&enabled, memory_order_relaxed)
+      ? (uint64_t)OSGetSystemTime() : 0;
+}
+
+/* A render span is host-thread-only. Worker spans use the separate atomics. */
+void horizon_gx2_profile_end(uint32_t stage, uint64_t begin)
+{
+   if (!begin || !recording || stage >= STAGES) return;
+   uint32_t cost = ticks(begin, (uint64_t)OSGetSystemTime());
+   uint32_t sum = current.stages[stage] + cost;
+   current.stages[stage] = sum < cost ? UINT32_MAX : sum;
+}
+
+void horizon_gx2_profile_worker_end(uint32_t worker, uint64_t begin)
+{
+   if (!begin || worker >= WORKERS) return;
+   uint32_t cost = ticks(begin, (uint64_t)OSGetSystemTime());
+   atomic_fetch_add_explicit(&workers[worker][0], 1, memory_order_relaxed);
+   atomic_fetch_add_explicit(&workers[worker][1], cost, memory_order_relaxed);
+}
+
+void horizon_gx2_profile_count(uint32_t counter, uint32_t value)
+{
+   if (!recording || counter >= COUNTERS) return;
+   uint32_t sum = current.counters[counter] + value;
+   current.counters[counter] = sum < value ? UINT32_MAX : sum;
+}
+
+void horizon_gx2_profile_finish(void)
+{
+   if (!recording) return;
+   const uint64_t now = (uint64_t)OSGetSystemTime(), offset = started - epoch;
+   current.sequence = total;
+   current.start_hi = (uint32_t)(offset >> 32);
+   current.start_lo = (uint32_t)offset;
+   current.loop_ticks = ticks(started, now);
+   if (total && current.phase == previous_phase)
+      current.pacing_ticks = ticks(previous, started);
+   previous = started;
+   previous_phase = current.phase;
+   for (uint32_t i = 0; i < WORKERS; ++i)
+      for (uint32_t j = 0; j < 2; ++j)
+         current.workers[i][j] = atomic_load_explicit(&workers[i][j], memory_order_relaxed);
+   ring[total++ % CAPACITY] = current;
+   recording = false;
+}
+
+static ProfileHeader header(void)
+{
+   return (ProfileHeader){0x485A5031, 1, OSTimerClockSpeed, sizeof(ProfileFrame),
+                          CAPACITY, total < CAPACITY ? total : CAPACITY, total};
+}
+
+/* Calling thread must own the renderer. Copy the newest records in order.
+ * Every slot consists of big-endian u32 values on Cafe. */
+uint32_t horizon_gx2_profile_snapshot(void *out, uint32_t bytes)
+{
+   if (!out || bytes < sizeof(ProfileHeader) ||
+       !atomic_load_explicit(&enabled, memory_order_acquire)) return 0;
+   ProfileHeader info = header();
+   uint32_t space = (bytes - sizeof(info)) / sizeof(ProfileFrame);
+   if (info.count > space) info.count = space;
+   uint8_t *dst = out;
+   memcpy(dst, &info, sizeof(info));
+   dst += sizeof(info);
+   for (uint32_t i = total - info.count; i < total; ++i) {
+      memcpy(dst, &ring[i % CAPACITY], sizeof(ProfileFrame));
+      dst += sizeof(ProfileFrame);
+   }
+   return (uint32_t)(dst - (uint8_t *)out);
+}
+
+void horizon_gx2_profile_flush(void)
+{
+   if (!atomic_load_explicit(&enabled, memory_order_acquire) || !total) return;
+   recording = false;
+   const ProfileHeader info = header();
+   const uint32_t first = (total - info.count) % CAPACITY;
+   const uint32_t tail = info.count < CAPACITY - first ? info.count : CAPACITY - first;
+   FILE *file = fopen(CAPTURE ".tmp", "wb");
+   if (!file) {
+      OSReport("Horizon GX2 capture open failed\n");
+      return;
+   }
+   const bool written = fwrite(&info, sizeof(info), 1, file) == 1 &&
+      fwrite(&ring[first], sizeof(ProfileFrame), tail, file) == tail &&
+      fwrite(ring, sizeof(ProfileFrame), info.count - tail, file) == info.count - tail;
+   const bool closed = fclose(file) == 0;
+   if (!written || !closed || rename(CAPTURE ".tmp", CAPTURE) != 0) {
+      OSReport("Horizon GX2 capture write failed\n");
+      return;
+   }
+   OSReport("Horizon GX2 capture complete: frames=%u total=%u\n", info.count, total);
+}
