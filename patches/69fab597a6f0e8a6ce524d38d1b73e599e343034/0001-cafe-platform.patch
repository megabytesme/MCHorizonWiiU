diff --git a/crates/horizon-client-font/src/bidi.rs b/crates/horizon-client-font/src/bidi.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c9c6caac7a468dff3de2bf8365990048d43f96be
--- /dev/null
