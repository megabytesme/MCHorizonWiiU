+                Narratable::text("Movement", [180.0, 40.0, 60.0, 17.0]),
+                0,
+                180.0,
+            ),
+            child(
+                Narratable::named(
+                    "Jump is bound to gui.narrate.button(Space)",
+                    [200.0, 60.0, 75.0, 20.0],
+                    true,
+                ),
+                1,
+                200.0,
+            ),
+            child(
+                Narratable::named("Reset Jump button", [280.0, 60.0, 50.0, 20.0], false),
+                1,
+                280.0,
+            ),
+            button("Done", 210.0),
+        ];
+        h.draw(0, &screen, &items);
+        h.cursor = (210.0, 65.0);
+        h.at(3000).mouse_moved();
+        assert_eq!(
+            h.draw(3751, &screen, &items),
+            [
+                "Jump is bound to gui.narrate.button(Space). narrator.position.screen(1, 2). \
+                 narrator.position.list(2, 3). narrator.position.object_list(1, 2). \
+                 narration.button.usage.hovered"
+            ]
+        );
+        // The category header row narrates its text, nothing more.
+        let mut items = items;
+        items[0] = Narratable::container_list(3, Some(0), [0.0, 38.0, 427.0, 160.0]).key(list);
+        h.cursor = (200.0, 45.0);
+        h.at(4000).mouse_moved();
+        assert_eq!(
+            h.draw(4751, &screen, &items),
+            ["Movement. narrator.position.list(1, 3)"]
+        );
+    }
+
+    #[test]
+    fn a_switch_narrates_its_own_message_and_next_value() {
+        let mut h = Harness::new();
+        let screen = ScreenInfo::new("create_world", "Create New World");
+        let items = [Narratable::new(
+            What::NamedCycle {
+                title: "Generate Structures. gui.narrate.button(: ON). Villages".into(),
+                next: "OFF".into(),
+                active: true,
+            },
+            [100.0, 100.0, 44.0, 20.0],
+        )
+        .hint("Villages")];
+        h.draw(0, &screen, &items);
+        h.cursor = (110.0, 110.0);
+        h.at(3000).mouse_moved();
+        assert_eq!(
+            h.draw(3751, &screen, &items),
+            [
+                "Generate Structures. gui.narrate.button(: ON). Villages. Villages. \
+                 narration.cycle_button.usage.hovered(OFF)"
+            ]
+        );
+    }
+
+    #[test]
+    fn the_recipe_book_narrates_its_hovered_widget_one_level_in() {
+        let mut h = Harness::new();
+        let screen = ScreenInfo::new("container", "Crafting");
+        let book = widgets::key_of(&"recipe_book");
+        let in_book = |n: Narratable, i: usize| n.key(widgets::key_of(&(book, i))).in_group(book);
+        let items = |visible: bool, search_focused: bool| {
+            vec![
+                Narratable::button("", [10.0, 100.0, 20.0, 18.0], true),
+                Narratable::group(visible, [40.0, 40.0, 147.0, 166.0]).key(book),
+                in_book(
+                    Narratable::recipe("Oak Planks", false, [51.0, 71.0, 25.0, 25.0]),
+                    0,
+                ),
+                in_book(
+                    Narratable::recipe("Torch", true, [76.0, 71.0, 25.0, 25.0]),
+                    1,
+                ),
+                in_book(
+                    Narratable::edit_box("Search Items", "to", [65.0, 53.0, 81.0, 14.0])
+                        .focused(search_focused),
+                    2,
+                ),
+                in_book(
+                    Narratable::cycle(
+                        ": Showing All",
+                        ": Showing Craftable",
+                        [150.0, 52.0, 26.0, 16.0],
+                        true,
+                    )
+                    .hint("Showing All"),
+                    3,
+                ),
+                in_book(Narratable::button("", [10.0, 43.0, 35.0, 27.0], true), 4),
+            ]
+        };
+        // Visible, it is narrated at once, though nothing in it is hovered.
+        h.cursor = (80.0, 80.0);
+        assert_eq!(
+            h.draw(0, &screen, &items(true, false)),
+            ["Crafting. narrator.position.screen(2, 2)"]
+        );
+        // A hovered recipe: its result and usage, no tooltip, no position.
+        h.at(3000).mouse_moved();
+        assert_eq!(
+            h.draw_with(3751, &screen, &items(true, false), Some("Torch")),
+            [
+                "narration.recipe(Torch). narration.button.usage.hovered. narration.recipe.usage.more"
+            ]
+        );
+        // The filter reads its tooltip.
+        h.cursor = (160.0, 60.0);
+        h.at(4000).mouse_moved();
+        assert_eq!(
+            h.draw(4751, &screen, &items(true, false)),
+            [
+                "gui.narrate.button(: Showing All). Showing All. narration.cycle_button.usage.hovered(: Showing Craftable)"
+            ]
+        );
+        // The focused search box wins over what the mouse is on.
+        h.at(5000).mouse_moved();
+        assert_eq!(
+            h.draw(5751, &screen, &items(true, true)),
+            ["gui.narrate.editBox(Search Items, to)"]
+        );
+        // The toggle button before it wins among the hovered.
+        h.cursor = (15.0, 105.0);
+        h.at(6000).mouse_moved();
+        assert_eq!(
+            h.draw(6751, &screen, &items(true, false)),
+            [
+                "gui.narrate.button(). narrator.position.screen(1, 2). narration.button.usage.hovered"
+            ]
+        );
+        // Hidden: never narrated, though still counted.
+        h.cursor = (80.0, 80.0);
+        h.at(7000).mouse_moved();
+        let hidden = &items(false, false)[..2];
+        assert_eq!(h.draw(7751, &screen, hidden), ["narrator.screen.usage"]);
+        assert_eq!(
+            h.draw(8000, &ScreenInfo::new("container/2", "Crafting"), hidden),
+            ["Crafting. narrator.screen.usage"]
+        );
+    }
+
+    #[test]
+    fn the_drawers_hear_which_widget_has_the_focus() {
+        let mut n = ScreenNarrator {
+            clock: Some(0),
+            ..Default::default()
+        };
+        let rect = [100.0, 40.0, 150.0, 20.0];
+        let tick = |n: &mut ScreenNarrator, frame: u64, at: i64| {
+            widgets::begin_screen(|| ScreenInfo::new("options/Video", "Video"));
+            widgets::narratable(|| Narratable::button("VSync: ON", rect, true));
+            widgets::end_frame(frame);
+            n.clock = Some(at);
+            n.frame_with(true, GUI, (0.0, 0.0), None, &keys)
+        };
+        tick(&mut n, 50_000, 0);
+        tick(&mut n, 50_001, 16);
+        assert!(!widgets::narration_focused(rect));
+        n.clock = Some(100);
+        n.mouse_pressed((110.0, 50.0), true);
+        tick(&mut n, 50_002, 116);
+        assert!(widgets::narration_focused(rect));
+    }
+
+    #[test]
+    fn turning_the_narrator_on_with_its_button_says_what_the_click_changed() {
+        // The narrator can speak but is off: the screens' narration runs
+        // all the same (`shouldRunNarration` is `isActive`).
+        let mut n = ScreenNarrator {
+            clock: Some(0),
+            ..Default::default()
+        };
+        let mut frames = 40_000;
+        let mut tick = |n: &mut ScreenNarrator, at: i64, label: &str, next: &str, cursor| {
+            widgets::begin_screen(|| ScreenInfo::new("options/Accessibility", "Accessibility"));
+            let (label, next) = (label.to_owned(), next.to_owned());
+            widgets::narratable(|| {
+                Narratable::cycle(label, next, [100.0, 40.0, 150.0, 20.0], true)
+            });
+            widgets::narratable(|| button("Done", 200.0));
+            frames += 1;
+            widgets::end_frame(frames);
+            n.clock = Some(at);
+            n.frame_with(true, GUI, cursor, None, &keys)
+        };
+        let over = (150.0, 50.0);
+        // The first turn switches the frames' recording on.
+        assert!(tick(&mut n, 0, "Narrator: OFF", "Narrates All", over).is_empty());
+        assert!(widgets::narrating());
+        // Built and said (saySystemNow drops it while the status is off).
+        assert_eq!(
+            tick(&mut n, 16, "Narrator: OFF", "Narrates All", over),
+            ["Accessibility. narrator.screen.usage"]
+        );
+        n.clock = Some(100);
+        n.mouse_moved();
+        assert_eq!(
+            tick(&mut n, 2017, "Narrator: OFF", "Narrates All", over),
+            [
+                "gui.narrate.button(Narrator: OFF). narrator.position.screen(1, 2). \
+                 narration.cycle_button.usage.hovered(Narrates All)"
+            ]
+        );
+        // The click turns it on (announced at once by the status update);
+        // 200 ms later the screen says only what the click changed.
+        n.clock = Some(3000);
+        n.mouse_pressed(over, true);
+        assert!(
+            tick(
+                &mut n,
+                3016,
+                "Narrator: Narrates All",
+                "Narrates Chat",
+                over
+            )
+            .is_empty()
+        );
+        assert_eq!(
+            tick(
+                &mut n,
+                3201,
+                "Narrator: Narrates All",
+                "Narrates Chat",
+                over
+            ),
+            [
+                "gui.narrate.button(Narrator: Narrates All). narration.component_list.usage. \
+                 narration.cycle_button.usage.focused(Narrates Chat)"
+            ]
+        );
+        // Without speech nothing is recorded or built.
+        assert!(n.frame_with(false, GUI, over, None, &keys).is_empty());
+        assert!(!widgets::narrating());
+    }
+
+    #[test]
+    fn the_game_translates_with_the_current_language() {
+        let mut h = Harness::new();
+        h.n.clock = Some(0);
+        h.n.generation += 1;
+        h.n.frame = Narration {
+            screen: Some(ScreenInfo::new("pause", "Game Menu")),
+            items: Vec::new(),
+            tooltip: None,
+        };
+        assert_eq!(
+            h.n.step(0, GUI, (0.0, 0.0), None, false, &translate),
+            [format!(
+                "Game Menu. {}",
+                translate("narrator.screen.usage", &[])
+            )]
+        );
+        assert_eq!(
+            translate("gui.narrate.button", &["Done"]),
+            crate::lang::tr("gui.narrate.button", &[&"Done"])
+        );
+    }
+}
diff --git a/crates/horizon-client-ui/src/title_confirm_experiments.rs b/crates/horizon-client-ui/src/title_confirm_experiments.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2d47c62fe1286de85495bb6ccfb4ea785f7e0a5b
--- /dev/null
+++ b/crates/horizon-client-ui/src/title_confirm_experiments.rs
@@ -0,0 +1,239 @@
+//! CreateWorldScreen's `ConfirmExperimentalFeaturesScreen`: the warning that
+//! the picked data packs ask for experimental features, with the packs' own
+//! flags on a second screen (`DetailsScreen`).
+//!
+//! Vanilla centres a grid (columns 10 apart, rows 20 apart): the title, the
+//! message wrapped to 310, a 100-wide Details button, then Proceed and Back.
+
+use crate::{
+    font::Font,
+    hud::{HudAtlas, HudBatch},
+    text::{Style, Text, named_color},
+    ui,
+};
+
+/// `ConfirmExperimentalFeaturesScreen.COLUMN_SPACING`.
+const COLUMN_SPACING: f32 = 10.0;
+/// The footer buttons' width (`Button.defaults`).
+const BUTTON: f32 = 150.0;
+/// `DETAILS_BUTTON_WIDTH`.
+const DETAILS: f32 = 100.0;
+/// `MultiLineTextWidget.setMaxWidth(310)`.
+const WARNING: f32 = 310.0;
+/// One button row plus the grid's 20-pixel row spacing, twice.
+const ROW: f32 = 40.0;
+
+/// A press on the screen.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Click {
+    /// The Details button: the packs' flags.
+    Details,
+    /// `gui.proceed`: apply the pending selection.
+    Proceed,
+    /// `gui.back` or Escape: leave the selection as it was.
+    Back,
+}
+
+/// One enabled feature pack, as `DetailsScreen`'s list shows it.
+pub struct Entry {
+    /// The pack's name, bold.
+    pub title: Text,
+    /// `selectWorld.experimental.details.entry`'s argument: the flags.
+    pub flags: String,
+}
+
+/// The screen; `details` shows `DetailsScreen` instead.
+pub struct ConfirmExperimentsScreen {
+    pub entries: Vec<Entry>,
+    /// The selection to apply on Proceed.
+    pub pending: Vec<String>,
+    pub details: bool,
+    in_world: bool,
+}
+impl ConfirmExperimentsScreen {
+    /// `ConfirmExperimentalFeaturesScreen::new`: the picked selection's
+    /// feature packs, each with the flags it asks for.
+    pub fn new(resources: &std::path::Path, selected: &[String]) -> Self {
+        let entries = crate::datapack::feature_packs(resources)
+            .into_iter()
+            .filter(|p| selected.contains(&p.id))
+            .filter(|p| !p.features().is_empty())
+            .map(|p| {
+                let name = format!("dataPack.{}.name", p.id);
+                let title = (if crate::lang::has(&name) {
+                    Text::translate(&name, &[])
+                } else {
+                    Text::literal(p.id.clone())
+                })
+                .with_style(&Style {
+                    bold: Some(true),
+                    ..Style::default()
+                });
+                let flags = p
+                    .features()
+                    .iter()
+                    .map(|f| f.trim_start_matches("minecraft:").to_owned())
+                    .collect::<Vec<_>>()
+                    .join(", ");
+                Entry { title, flags }
+            })
+            .collect();
+        Self {
+            entries,
+            pending: selected.to_vec(),
+            details: false,
+            in_world: false,
+        }
+    }
+    /// The message's lines (`MultiLineTextWidget` at 310; the text's own
+    /// line breaks kept).
+    fn message_lines(font: &Font) -> Vec<Text> {
+        crate::lang::get_or(
+            "selectWorld.experimental.message",
+            "Be careful!\nThis configuration requires features that are still under development. \
+             Your world might crash, break, or not work with future updates.",
+        )
+        .split('\n')
+        .flat_map(|line| {
+            font.split_lines(&Text::literal(line.to_owned()), WARNING)
+                .into_iter()
+                .map(|(l, _)| l)
+        })
+        .collect()
+    }
+    /// The grid's top: the whole block centred vertically
+    /// (`FrameLayout.alignInRectangle`).
+    fn block_top(message: usize, h: f32) -> f32 {
+        let rows = 9.0 + message as f32 * 9.0 + ROW + ROW;
+        ((h - rows) / 2.0).max(0.0)
+    }
+    /// The Details button's rect (centred, under the message).
+    fn details_rect(message: usize, w: f32, h: f32) -> (f32, f32) {
+        (
+            ((w - DETAILS) / 2.0).trunc(),
+            Self::block_top(message, h) + 9.0 + ROW,
+        )
+    }
+    /// A press: Details, Proceed (`gui.proceed`) or Back (`gui.back`).
+    pub fn click(&self, atlas: &HudAtlas, (x, y): (f32, f32), size: (f32, f32)) -> Option<Click> {
+        let (w, h) = size;
+        if self.details {
+            let [(bx, by)] = footer_single(w, h);
+            return ui::hovered((x, y), bx, by, BUTTON, 20.0).then_some(Click::Back);
+        }
+        let message = Self::message_lines(&atlas.font).len();
+        let (dx, dy) = Self::details_rect(message, w, h);
+        if ui::hovered((x, y), dx, dy, DETAILS, 20.0) {
+            return Some(Click::Details);
+        }
+        let [(px, py), (bx, by)] = footer_pair(w, h);
+        if ui::hovered((x, y), px, py, BUTTON, 20.0) {
+            return Some(Click::Proceed);
+        }
+        ui::hovered((x, y), bx, by, BUTTON, 20.0).then_some(Click::Back)
+    }
+    pub fn draw(&self, batch: &mut HudBatch, atlas: &HudAtlas, cursor: (f32, f32)) {
+        let (w, h) = (batch.width, batch.height);
+        ui::menu_background(batch, atlas, 0.0, 0.0, w, h, self.in_world);
+        let font = &atlas.font;
+        if self.details {
+            // `DetailsScreen`: the header's title, the packs, Back in the
+            // footer.
+            let title = Text::translate("selectWorld.experimental.details.title", &[]);
+            let tw = font.width_text(&title);
+            batch.text_styled(
+                atlas,
+                &title,
+                ((w - tw) / 2.0).trunc(),
+                15.0,
+                u32::MAX,
+                true,
+            );
+            let gray = named_color("gray").unwrap_or(0xAAAAAA);
+            let mut y = 63.0 + 30.0;
+            for entry in &self.entries {
+                let x = (w / 2.0 - 155.0).trunc();
+                batch.text_styled(atlas, &entry.title, x, y, u32::MAX, true);
+                y += 12.0;
+                let line = Text::translate("selectWorld.experimental.details.entry", &[])
+                    .append(Text::literal(entry.flags.clone()).with_color(gray));
+                for (l, _) in font.split_lines(&line, WARNING) {
+                    batch.text_styled(atlas, &l, x, y, u32::MAX, true);
+                    y += 9.0;
+                }
+                y += 10.0;
+            }
+            let [(bx, by)] = footer_single(w, h);
+            ui::action_button(
+                batch,
+                atlas,
+                crate::widgets::Action::Back,
+                bx,
+                by,
+                BUTTON,
+                20.0,
+                &Text::translate("gui.back", &[]),
+                true,
+                ui::hovered(cursor, bx, by, BUTTON, 20.0),
+            );
+            return;
+        }
+        let message = Self::message_lines(font);
+        let top = Self::block_top(message.len(), h);
+        // The title, the message, Details, then the two buttons: the grid's
+        // rows 20 apart, the whole block centred.
+        let title = Text::translate("selectWorld.experimental.title", &[]);
+        let tw = font.width_text(&title);
+        batch.text_styled(atlas, &title, ((w - tw) / 2.0).trunc(), top, u32::MAX, true);
+        let (dx, dy) = Self::details_rect(message.len(), w, h);
+        let mut y = top + 9.0;
+        for line in &message {
+            batch.text_styled(
+                atlas,
+                line,
+                ((w - WARNING) / 2.0).trunc(),
+                y,
+                u32::MAX,
+                true,
+            );
+            y += 9.0;
+        }
+        ui::button(
+            batch,
+            atlas,
+            dx,
+            dy,
+            DETAILS,
+            20.0,
+            &Text::translate("selectWorld.experimental.details", &[]),
+            true,
+            ui::hovered(cursor, dx, dy, DETAILS, 20.0),
+        );
+        let [(px, py), (bx, by)] = footer_pair(w, h);
+        crate::widgets::declare_action(crate::widgets::Action::Back, [bx, by, BUTTON, 20.0], true);
+        for (fx, fy, key) in [(px, py, "gui.proceed"), (bx, by, "gui.back")] {
+            ui::button(
+                batch,
+                atlas,
+                fx,
+                fy,
+                BUTTON,
+                20.0,
+                &Text::translate(key, &[]),
+                true,
+                ui::hovered(cursor, fx, fy, BUTTON, 20.0),
+            );
+        }
+    }
+}
+
+/// Two 150-wide buttons `COLUMN_SPACING` apart, centred.
+fn footer_pair(w: f32, h: f32) -> [(f32, f32); 2] {
+    let x = ((w - (BUTTON * 2.0 + COLUMN_SPACING)) / 2.0).trunc();
+    let y = h - 45.0;
+    [(x, y), (x + BUTTON + COLUMN_SPACING, y)]
+}
+/// One centred footer button (`DetailsScreen`'s Back).
+fn footer_single(w: f32, h: f32) -> [(f32, f32); 1] {
+    [(((w - BUTTON) / 2.0).trunc(), h - 45.0)]
+}
