-/// above (+Y, the commonest case), each pair of horizontal sides with a
-/// common corner is then one run, or two.
-const BUCKETS: [Bucket; 7] = [
-    Bucket::Side(0, true),
-    Bucket::Side(2, true),
-    Bucket::Other,
-    Bucket::Side(1, true),
-    Bucket::Side(2, false),
-    Bucket::Side(0, false),
-    Bucket::Side(1, false),
