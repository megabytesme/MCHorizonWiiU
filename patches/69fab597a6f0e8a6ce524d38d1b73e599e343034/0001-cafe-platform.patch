+/// `StringWidget` (CLAMPED) at its position: its single line, clipped when wider than `max_width`.
+pub fn string_widget(
+    out: &mut Vec<Draw>,
+    m: &Measure,
+    message: &Text,
+    x: i32,
+    y: i32,
+    max_width: i32,
+) {
+    let w = m.width(message);
+    let max = if max_width > 0 { max_width } else { w };
+    let line = if w > max {
+        clip(m, message, max)
+    } else {
+        message.clone()
+    };
+    text(out, line, x, y, WHITE, true);
+}
