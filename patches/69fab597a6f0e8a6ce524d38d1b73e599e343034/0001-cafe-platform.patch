@@ -0,0 +1,368 @@
+//! `ConfirmScreen`: a title, a message wrapped to `width - 50` (15 lines at
+//! most) and two 150-wide buttons 4 apart and 16 below it, the whole column
+//! centred; Escape answers no.
+use crate::{
+    font::Font,
+    hud::{HudAtlas, HudBatch},
+    text::Text,
+    ui,
+};
+
+pub struct Confirm {
+    /// Each line and where it is drawn.
+    pub lines: Vec<(Text, f32, f32)>,
+    /// The yes and no buttons' corners.
+    pub buttons: [(f32, f32); 2],
+    pub focus: Option<usize>,
+    /// `declare_no` was called.
+    declares_no: bool,
+}
+impl Confirm {
+    pub fn new(font: &Font, size: (f32, f32), title: &Text, message: &Text) -> Self {
+        let Choice { lines, buttons, .. } = Choice::new(font, size, title, message, 2, 150.0);
+        Self {
+            lines,
+            buttons: [buttons[0], buttons[1]],
+            focus: None,
+            declares_no: false,
+        }
+    }
+    /// Tab cycles focus between yes (0) and no (1).
+    pub fn tab(&mut self, reverse: bool) {
+        self.focus = match self.focus {
+            Some(0) => Some(1),
+            Some(1) => Some(0),
+            None => Some(if reverse { 1 } else { 0 }),
+            _ => Some(0),
+        };
+    }
+    /// Left or right arrow key focuses yes or no.
+    pub fn arrow(&mut self, left: bool) {
+        self.focus = Some(if left { 0 } else { 1 });
+    }
+    /// The answer of the currently focused button.
+    pub fn answer(&self) -> Option<bool> {
+        match self.focus {
+            Some(0) => Some(true),
+            Some(1) => Some(false),
+            _ => None,
+        }
+    }
+    /// The answer a click at `cursor` gives: true for yes, false for no.
+    pub fn answer_at(&self, cursor: (f32, f32)) -> Option<bool> {
+        let [yes, no] = self.buttons;
+        let on = |(x, y): (f32, f32)| ui::hovered(cursor, x, y, 150.0, 20.0);
+        if on(yes) {
+            Some(true)
+        } else if on(no) {
+            Some(false)
+        } else {
+            None
+        }
+    }
+    /// The lines and the buttons (yes first), over whatever is behind.
+    pub fn draw(
+        &self,
+        batch: &mut HudBatch,
+        atlas: &HudAtlas,
+        cursor: (f32, f32),
+        labels: [&Text; 2],
+    ) {
+        self.draw_active(batch, atlas, cursor, labels, true);
+    }
+    /// The second button answers no, as Escape does (`widgets::Action`), once drawn.
+    pub fn declare_no(&mut self) {
+        self.declares_no = true;
+    }
+    /// `draw` with the buttons greyed out while `setDelay` runs (`active` false).
+    pub fn draw_active(
+        &self,
+        batch: &mut HudBatch,
+        atlas: &HudAtlas,
+        cursor: (f32, f32),
+        labels: [&Text; 2],
+        active: bool,
+    ) {
+        for (line, x, y) in &self.lines {
+            batch.text_styled(atlas, line, *x, *y, u32::MAX, true);
+        }
+        for (i, ((bx, by), label)) in self.buttons.into_iter().zip(labels).enumerate() {
+            let is_focused = self.focus == Some(i);
+            let hover = active && (ui::hovered(cursor, bx, by, 150.0, 20.0) || is_focused);
+            if self.declares_no && i == 1 {
+                let action = crate::widgets::Action::Cancel;
+                ui::action_button(
+                    batch, atlas, action, bx, by, 150.0, 20.0, label, active, hover,
+                );
+            } else {
+                ui::button(batch, atlas, bx, by, 150.0, 20.0, label, active, hover);
+            }
+        }
+    }
+}
+
+/// `ConfirmScreen` with a row of `count` buttons `width` wide, 4 apart: `ConfirmLinkScreen`'s
+/// yes, copy and no are three of 100. `Confirm` is its two of 150.
+pub struct Choice {
+    /// Each line and where it is drawn.
+    pub lines: Vec<(Text, f32, f32)>,
+    /// The buttons' corners, left to right.
+    pub buttons: Vec<(f32, f32)>,
+    pub width: f32,
+    pub focus: Option<usize>,
+    /// The button `declare_no` named.
+    no_button: Option<usize>,
+}
+impl Choice {
+    pub fn new(
+        font: &Font,
+        (w, h): (f32, f32),
+        title: &Text,
+        message: &Text,
+        count: usize,
+        width: f32,
+    ) -> Self {
+        let message: Vec<Text> = font
+            .split_lines(message, w - 50.0)
+            .into_iter()
+            .map(|(line, _)| line)
+            .take(15)
+            .collect();
+        let tw = font.width_text(title);
+        let mw = message
+            .iter()
+            .map(|l| font.width_text(l))
+            .fold(0.0, f32::max);
+        let mh = 9.0 * message.len() as f32;
+        let row = width * count as f32 + 4.0 * count.saturating_sub(1) as f32;
+        let col = tw.max(mw).max(row);
+        let total = 9.0 + 8.0 + mh + 8.0 + 36.0;
+        let (lx, ly) = (((w - col) / 2.0).trunc(), ((h - total) / 2.0).trunc());
+        let cell = |cw: f32| lx + ((col - cw) / 2.0).trunc();
+        let mid = cell(mw) + (mw / 2.0).trunc();
+        let mut lines = vec![(title.clone(), cell(tw), ly)];
+        for (i, line) in message.into_iter().enumerate() {
+            let x = mid - (font.width_text(&line) / 2.0).trunc();
+            lines.push((line, x, ly + 17.0 + 9.0 * i as f32));
+        }
+        let (bx, by) = (cell(row), ly + 9.0 + 8.0 + mh + 8.0 + 16.0);
+        Self {
+            lines,
+            buttons: (0..count)
+                .map(|i| (bx + (width + 4.0) * i as f32, by))
+                .collect(),
+            width,
+            focus: None,
+            no_button: None,
+        }
+    }
+    /// Tab cycles focus across the buttons.
+    pub fn tab(&mut self, reverse: bool) {
+        let count = self.buttons.len();
+        if count == 0 {
+            return;
+        }
+        self.focus = match self.focus {
+            Some(cur) => {
+                if reverse {
+                    Some(if cur == 0 { count - 1 } else { cur - 1 })
+                } else {
+                    Some((cur + 1) % count)
+                }
+            }
+            None => Some(if reverse { count - 1 } else { 0 }),
+        };
+    }
+    /// Left or right arrow key moves focus.
+    pub fn arrow(&mut self, left: bool) {
+        let count = self.buttons.len();
+        if count == 0 {
+            return;
+        }
+        self.focus = match self.focus {
+            Some(cur) => {
+                if left {
+                    Some(cur.saturating_sub(1))
+                } else {
+                    Some((cur + 1).min(count - 1))
+                }
+            }
+            None => Some(if left { 0 } else { count - 1 }),
+        };
+    }
+    /// The index of the currently focused button.
+    pub fn pressed(&self) -> Option<usize> {
+        self.focus
+    }
+    /// The button a click at `cursor` hits, counted from the left.
+    pub fn pressed_at(&self, cursor: (f32, f32)) -> Option<usize> {
+        self.buttons
+            .iter()
+            .position(|&(x, y)| ui::hovered(cursor, x, y, self.width, 20.0))
+    }
+    /// Button `i` answers no, as Escape does (`widgets::Action`), once drawn.
+    pub fn declare_no(&mut self, i: usize) {
+        self.no_button = Some(i);
+    }
+    /// The lines and the buttons, over whatever is behind.
+    pub fn draw(
+        &self,
+        batch: &mut HudBatch,
+        atlas: &HudAtlas,
+        cursor: (f32, f32),
+        labels: &[Text],
+    ) {
+        for (line, x, y) in &self.lines {
+            batch.text_styled(atlas, line, *x, *y, u32::MAX, true);
+        }
+        for (i, (&(bx, by), label)) in self.buttons.iter().zip(labels).enumerate() {
+            let is_focused = self.focus == Some(i);
+            let hover = ui::hovered(cursor, bx, by, self.width, 20.0) || is_focused;
+            if self.no_button == Some(i) {
+                let action = crate::widgets::Action::Cancel;
+                ui::action_button(
+                    batch, atlas, action, bx, by, self.width, 20.0, label, true, hover,
+                );
+            } else {
+                ui::button(batch, atlas, bx, by, self.width, 20.0, label, true, hover);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::hud::Rect;
+    use std::{collections::HashMap, path::Path};
+
+    fn font() -> Font {
+        // The missing-glyph metrics let these tests run without game assets.
+        let rect = Rect {
+            u0: 0.0,
+            v0: 0.0,
+            u1: 1.0,
+            v1: 1.0,
+            w: 1,
+            h: 1,
+        };
+        Font::load(
+            Path::new("/nonexistent-horizon-confirm-test-resources"),
+            &HashMap::new(),
+            &[],
+            (1, 1),
+            (0, 0),
+            rect,
+        )
+    }
+
+    #[test]
+    fn three_buttons_sit_four_apart_in_the_middle() {
+        let (title, message) = (Text::literal("Open?"), Text::literal("https://x"));
+        let c = Choice::new(&font(), (480.0, 270.0), &title, &message, 3, 100.0);
+        let xs: Vec<f32> = c.buttons.iter().map(|b| b.0).collect();
+        // 3 x 100 + 2 x 4 = 308 wide, centred on 480.
+        assert_eq!(xs, vec![86.0, 190.0, 294.0]);
+        assert_eq!(c.pressed_at((191.0, c.buttons[1].1 + 1.0)), Some(1));
+        assert_eq!(c.pressed_at((188.0, c.buttons[1].1 + 1.0)), None);
+        // Confirm keeps its two 150-wide buttons where they were.
+        let two = Confirm::new(&font(), (480.0, 270.0), &title, &message);
+        assert_eq!(two.buttons[0].0, 88.0);
+        assert_eq!(two.buttons[1].0, 242.0);
+    }
+
+    #[test]
+    fn only_the_button_declared_no_gets_its_job() {
+        use crate::widgets::{self, Action, DeclaredAction};
+        let atlas = HudAtlas::build(Path::new("/nonexistent/horizon-test-assets")).unwrap();
+        let (title, message) = (Text::literal("Title"), Text::literal("Message"));
+        let labels = [
+            Text::literal("Yes"),
+            Text::literal("Copy"),
+            Text::literal("No"),
+        ];
+        let drawn = |frame: u64, draw: &dyn Fn(&mut HudBatch)| {
+            widgets::set_action_screen(7);
+            draw(&mut HudBatch::new([480, 270]));
+            widgets::end_frame(frame);
+            widgets::last_actions(7)
+        };
+        let no = |rect| {
+            vec![DeclaredAction {
+                action: Action::Cancel,
+                rect,
+                enabled: true,
+            }]
+        };
+
+        let mut confirm = Confirm::new(&font(), (480.0, 270.0), &title, &message);
+        let draw_confirm = |confirm: &Confirm, batch: &mut HudBatch| {
+            confirm.draw(batch, &atlas, (0.0, 0.0), [&labels[0], &labels[2]]);
+        };
+        assert!(drawn(1, &|b| draw_confirm(&confirm, b)).is_empty());
+        confirm.declare_no();
+        let (x, y) = confirm.buttons[1];
+        assert_eq!(
+            drawn(2, &|b| draw_confirm(&confirm, b)),
+            no([x, y, 150.0, 20.0])
+        );
+
+        let mut choice = Choice::new(&font(), (480.0, 270.0), &title, &message, 3, 100.0);
+        let draw_choice = |choice: &Choice, batch: &mut HudBatch| {
+            choice.draw(batch, &atlas, (0.0, 0.0), &labels);
+        };
+        assert!(drawn(3, &|b| draw_choice(&choice, b)).is_empty());
+        choice.declare_no(2);
+        let (x, y) = choice.buttons[2];
+        assert_eq!(
+            drawn(4, &|b| draw_choice(&choice, b)),
+            no([x, y, 100.0, 20.0])
+        );
+    }
+
+    #[test]
+    fn confirm_and_choice_keyboard_navigation() {
+        let (title, message) = (Text::literal("Title"), Text::literal("Message"));
+        let mut confirm = Confirm::new(&font(), (480.0, 270.0), &title, &message);
+        assert_eq!(confirm.focus, None);
+        assert_eq!(confirm.answer(), None);
+
+        confirm.tab(false);
+        assert_eq!(confirm.focus, Some(0));
+        assert_eq!(confirm.answer(), Some(true));
+
+        confirm.tab(false);
+        assert_eq!(confirm.focus, Some(1));
+        assert_eq!(confirm.answer(), Some(false));
+
+        confirm.tab(true);
+        assert_eq!(confirm.focus, Some(0));
+
+        confirm.arrow(false);
+        assert_eq!(confirm.focus, Some(1));
+        confirm.arrow(true);
+        assert_eq!(confirm.focus, Some(0));
+
+        let mut choice = Choice::new(&font(), (480.0, 270.0), &title, &message, 3, 100.0);
+        assert_eq!(choice.focus, None);
+        assert_eq!(choice.pressed(), None);
+
+        choice.tab(false);
+        assert_eq!(choice.focus, Some(0));
+        assert_eq!(choice.pressed(), Some(0));
+
+        choice.tab(false);
+        assert_eq!(choice.focus, Some(1));
+
+        choice.tab(false);
+        assert_eq!(choice.focus, Some(2));
+
+        choice.tab(false);
+        assert_eq!(choice.focus, Some(0));
+
+        choice.arrow(false);
+        assert_eq!(choice.focus, Some(1));
+        choice.arrow(true);
+        assert_eq!(choice.focus, Some(0));
+    }
+}
diff --git a/crates/horizon-client-ui/src/datapack.rs b/crates/horizon-client-ui/src/datapack.rs
new file mode 100644
index 0000000000000000000000000000000000000000..486558b4a64d0b6e325e2406628efc5efa76ff00
--- /dev/null
+++ b/crates/horizon-client-ui/src/datapack.rs
@@ -0,0 +1,193 @@
+//! Horizon data-pack discovery shared by its screens and renderer.
+
+use horizon_resource_zip::Zip;
+use std::path::{Path, PathBuf};
+
+/// A pack on disk.
+pub struct DataPack {
+    /// `file/<name>` in `/datapack` and level.dat.
+    pub id: String,
+    source: Source,
+}
+enum Source {
+    Dir(PathBuf),
+    Zip(Box<Zip>),
+}
+impl DataPack {
+    /// Every file path under `prefix` (relative to the pack root).
+    pub fn list(&self, prefix: &str) -> Vec<String> {
+        match &self.source {
+            Source::Zip(z) => z
+                .names()
+                .filter(|n| n.starts_with(prefix) && !n.ends_with('/'))
+                .map(str::to_owned)
+                .collect(),
+            Source::Dir(root) => {
+                let mut out = Vec::new();
+                walk(root, &root.join(prefix), &mut out);
+                out
+            }
+        }
+    }
+    /// The files of `data/<namespace>/<kind>/` for each kind, in the order
+    /// `list("data/")` gives them. A folder pack walks only those folders:
+    /// the built-in pack holds about 10,000 other data files.
+    #[doc(hidden)]
+    pub fn list_kinds(&self, kinds: &[&str]) -> Vec<String> {
+        debug_assert!(kinds.is_sorted(), "kinds in walk order");
+        let Source::Dir(root) = &self.source else {
+            return self.list("data/");
+        };
+        let Ok(entries) = std::fs::read_dir(root.join("data")) else {
+            return Vec::new();
+        };
+        let mut namespaces: Vec<_> = entries.flatten().map(|e| e.path()).collect();
+        namespaces.sort();
+        let mut out = Vec::new();
+        for ns in namespaces {
+            for kind in kinds {
+                walk(root, &ns.join(kind), &mut out);
+            }
+        }
+        out
+    }
+    /// The files of `data/<namespace>/<folder>/` in every namespace, as
+    /// `list` names them; a folder pack walks only those folders.
+    pub fn list_folder(&self, folder: &str) -> Vec<String> {
+        let files = self.list_kinds(&[folder]);
+        let Source::Zip(_) = &self.source else {
+            return files;
+        };
+        files
+            .into_iter()
+            .filter(|f| {
+                f.strip_prefix("data/")
+                    .and_then(|r| r.split_once('/'))
+                    .is_some_and(|(_, r)| {
+                        r.strip_prefix(folder).is_some_and(|r| r.starts_with('/'))
+                    })
+            })
+            .collect()
+    }
+    pub fn read(&self, path: &str) -> Option<Vec<u8>> {
+        match &self.source {
+            Source::Zip(z) => z.read(path).ok(),
+            Source::Dir(root) => std::fs::read(root.join(path)).ok(),
+        }
+    }
+
+    /// The `description` of `pack.mcmeta`, as text.
+    pub fn description(&self) -> String {
+        let Some(bytes) = self.read("pack.mcmeta") else {
+            return String::new();
+        };
+        let v: serde_json::Value = serde_json::from_slice(&bytes).unwrap_or_default();
+        match &v["pack"]["description"] {
+            serde_json::Value::String(s) => s.clone(),
+            other => other["text"].as_str().unwrap_or_default().to_owned(),
+        }
+    }
+    /// The `features.enabled` flag ids of `pack.mcmeta`
+    /// (`FeatureFlagsMetadataSection`): the flags the pack asks to turn on.
+    pub fn features(&self) -> Vec<String> {
+        self.mcmeta()["features"]["enabled"]
+            .as_array()
+            .map(|a| {
+                a.iter()
+                    .filter_map(|f| f.as_str().map(str::to_owned))
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+    /// The `pack.mcmeta` as JSON, empty when it is missing or unreadable.
+    #[doc(hidden)]
+    pub fn mcmeta(&self) -> serde_json::Value {
+        self.read("pack.mcmeta")
+            .and_then(|b| serde_json::from_slice(&b).ok())
+            .unwrap_or_default()
+    }
+}
+fn walk(root: &Path, dir: &Path, out: &mut Vec<String>) {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return;
+    };
+    let mut entries: Vec<_> = entries.flatten().collect();
+    entries.sort_by_key(std::fs::DirEntry::file_name);
+    for e in entries {
+        let p = e.path();
+        if p.is_dir() {
+            walk(root, &p, out);
+        } else if let Ok(rel) = p.strip_prefix(root) {
+            out.push(rel.to_string_lossy().replace('\\', "/"));
+        }
+    }
+}
+impl DataPack {
+    /// The built-in `vanilla` pack: the game's own data directory.
+    pub fn builtin(root: &Path) -> Self {
+        DataPack {
+            id: "vanilla".into(),
+            source: Source::Dir(root.to_path_buf()),
+        }
+    }
+}
+/// The packs in `<world>/datapacks`, sorted by name.
+pub fn discover(world: &Path) -> Vec<DataPack> {
+    discover_folder(&world.join("datapacks"))
+}
+/// Packs in Create World's temporary pack folder, before a world exists.
+pub fn discover_folder(dir: &Path) -> Vec<DataPack> {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return Vec::new();
+    };
+    let mut packs = Vec::new();
+    for e in entries.flatten() {
+        let name = e.file_name().to_string_lossy().into_owned();
+        let path = e.path();
+        if path.is_dir() && path.join("pack.mcmeta").exists() {
+            packs.push(DataPack {
+                id: format!("file/{name}"),
+                source: Source::Dir(path),
+            });
+        } else if name.ends_with(".zip")
+            && let Ok(z) = Zip::open(&path)
+            && z.contains("pack.mcmeta")
+        {
+            packs.push(DataPack {
+                id: format!("file/{name}"),
+                source: Source::Zip(Box::new(z)),
+            });
+        }
+    }
+    packs.sort_by(|a, b| a.id.cmp(&b.id));
+    packs
+}
+/// The resources root's built-in feature packs (`ServerPacksSource`
+/// scanning the game's `data/minecraft/datapacks`): every folder with a
+/// `pack.mcmeta`, a feature pack (`PackSource.FEATURE`). Off until a world
+/// selects them.
+pub fn feature_packs(resources: &Path) -> Vec<DataPack> {
+    let Ok(entries) = std::fs::read_dir(resources.join("data").join("minecraft").join("datapacks"))
+    else {
+        return Vec::new();
+    };
+    let mut packs = Vec::new();
+    for e in entries.flatten() {
+        let path = e.path();
+        if path.join("pack.mcmeta").exists() {
+            packs.push(DataPack {
+                id: e.file_name().to_string_lossy().into_owned(),
+                source: Source::Dir(path),
+            });
+        }
+    }
+    packs.sort_by(|a, b| a.id.cmp(&b.id));
+    packs
+}
+/// The packs of `<world>/datapacks` plus the resources root's feature packs:
+/// the world's whole repository, as `PackRepository.reload` sees it.
+pub fn discover_with_features(world_root: &Path, resources: &Path) -> Vec<DataPack> {
+    let mut packs = discover(world_root);
+    packs.extend(feature_packs(resources));
+    packs
+}
