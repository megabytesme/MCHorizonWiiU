index 0000000000000000000000000000000000000000..9cd1c475f8586c352632a875baab360163aee5f5
--- /dev/null
+++ b/crates/horizon-terrain-mesh/src/packed.rs
@@ -0,0 +1,343 @@
+//! The compact layout of a section's solid quads in the arena: most of them are whole faces
+//! of a block's cube on the block grid, and those take one 24-byte record each instead of
+//! four 24-byte vertices. terrain.wgsl's `section_corner` expands a record into the very
+//! vertex words `TerrainVertex` would hold (`packed_vertex` here is the same on the CPU, and
+//! a record is kept only when it gives back the quad's four vertices bit for bit), so every
+//! pass draws the same picture from either layout.
+//!
+//! A mesh's solid range is then one record per quad in mesh order (so `Sides` and the draws
+//! count quads as before), padding to a multiple of 4 slots, and the quads no record fits as
+//! their four vertices: their record holds the distance to those (`FULL`). A record:
+//!
+//! - word 0: the tint (0xRRGGBB as the mesher multiplies it) and the colour's alpha byte;
+//! - word 1: each corner's grey level before the tint;
+//! - word 2: the UV rectangle in 1/32 of the sprite (u0, u1, v0, v1, 6 bits each) and, per
+//!   corner, which edge of it its u and v take;
+//! - word 3: the layer, and corner 0's light (sky and block light over 4, 6 bits each);
+//! - word 4: corners 1 and 2's light;
+//! - word 5: corner 3's light, the face (block x, y, z, the axis it faces along, which side
+//!   of the block, and where and which way its corners go round), and `FULL` clear.
+use crate::TerrainVertex;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+/// A solid quad's tint the mesher does not know (fluids): only untinted colours pack.
+pub const UNKNOWN_TINT: u32 = u32::MAX;
+/// The tint of an untinted quad, whose colour is its grey level.
+pub const WHITE: u32 = 0xFF_FFFF;
+/// Word 5's bit of a quad kept as four vertices; word 0 is then the slots from the record
+/// to its first vertex.
+pub const FULL: u32 = 1 << 31;
+/// The draws' base vertex of a compact mesh: `PACKED_BASE + 4 * slot + corner` is a corner of
+/// the quad whose record is at `slot`; below it, vertex indices name vertices.
+pub const PACKED_BASE: u32 = 1 << 28;
+
+/// Whether meshes sorted from now on get the compact layout: set by the renderer while its
+/// passes read it (no shader pack).
+static PACK: AtomicBool = AtomicBool::new(false);
+
+pub fn pack_quads(on: bool) {
+    PACK.store(on, Ordering::Relaxed);
+}
+
+pub fn packing() -> bool {
+    PACK.load(Ordering::Relaxed)
+}
+
+/// The order corners go round a face: (du, dw) of each step.
+const ROUND: [[u32; 2]; 4] = [[0, 0], [1, 0], [1, 1], [0, 1]];
+
+/// `quad`'s record, if one gives back its four vertices exactly. `tint`: what the mesher
+/// multiplied its grey levels by (`UNKNOWN_TINT` when it does not say).
+pub fn pack_quad(quad: &[TerrainVertex; 4], tint: u32) -> Option<[u32; 6]> {
+    // Corners on the block grid of the section.
+    let mut p = [[0u32; 3]; 4];
+    for (to, v) in p.iter_mut().zip(quad) {
+        for (c, &x) in to.iter_mut().zip(&v.pos) {
+            if !(0.0..=16.0).contains(&x) || x.fract() != 0.0 {
+                return None;
+            }
+            *c = x as u32;
+        }
+    }
+    let axis = (0..3).find(|&a| p.iter().all(|c| c[a] == p[0][a]))?;
+    let (u, w) = ((axis + 1) % 3, (axis + 2) % 3);
+    let lo = [u, w].map(|k| p.iter().map(|c| c[k]).min().unwrap_or(0));
+    if lo.iter().any(|&l| l > 15) {
+        return None;
+    }
+    let mut steps = [0u32; 4];
+    for (step, c) in steps.iter_mut().zip(&p) {
+        let d = [c[u] - lo[0], c[w] - lo[1]];
+        *step = ROUND.iter().position(|r| *r == d)? as u32;
+    }
+    let (start, dir) = (0..8u32).map(|n| (n & 3, n >> 2)).find(|&(start, dir)| {
+        (0..4u32).all(|i| {
+            let step = if dir == 1 { 4 - i } else { i };
+            steps[i as usize] == (start + step) & 3
+        })
+    })?;
+    let plane = p[0][axis];
+    let mut block = [0u32; 3];
+    block[axis] = plane.min(15);
+    block[u] = lo[0];
+    block[w] = lo[1];
+    let side = plane - block[axis];
+    let orient = block[0]
+        | block[1] << 4
+        | block[2] << 8
+        | (axis as u32) << 12
+        | side << 14
+        | start << 15
+        | dir << 17;
+    // UVs in 1/32 of the sprite, at most two values each way.
+    let mut ranges = [[u32::MAX, 0u32]; 2];
+    let mut uvs = [[0u32; 2]; 4];
+    for (uv, v) in uvs.iter_mut().zip(quad) {
+        for k in 0..2 {
+            let raw = u32::from(v.uv[k]);
+            if raw & 1023 != 0 {
+                return None;
+            }
+            uv[k] = raw >> 10;
+            ranges[k] = [ranges[k][0].min(uv[k]), ranges[k][1].max(uv[k])];
+        }
+    }
+    let mut select = 0u32;
+    for (i, uv) in uvs.iter().enumerate() {
+        for k in 0..2 {
+            if uv[k] == ranges[k][1] && uv[k] != ranges[k][0] {
+                select |= 1 << (2 * i + k);
+            } else if uv[k] != ranges[k][0] {
+                return None;
+            }
+        }
+    }
+    let rect = ranges[0][0] | ranges[0][1] << 6 | ranges[1][0] << 12 | ranges[1][1] << 18;
+    // Light in steps of 4 (smooth light averages four levels of 16).
+    let mut light = [0u32; 4];
+    for (l, v) in light.iter_mut().zip(quad) {
+        let (sky, block) = (u32::from(v.light & 0xFF), u32::from(v.light >> 8));
+        if sky & 3 != 0 || block & 3 != 0 {
+            return None;
+        }
+        *l = sky >> 2 | (block >> 2) << 6;
+    }
+    // The colour: each channel the grey level times the tint's, over 255.
+    let tint = if tint == UNKNOWN_TINT {
+        WHITE
+    } else {
+        tint & WHITE
+    };
+    let alpha = quad[0].color & 0xFF00_0000;
+    let mut grays = 0u32;
+    for (i, v) in quad.iter().enumerate() {
+        grays |= gray_of(v.color, tint)? << (8 * i);
+    }
+    let words = [
+        tint | alpha,
+        grays,
+        rect | select << 24,
+        u32::from(quad[0].layer) | light[0] << 16,
+        light[1] | light[2] << 12,
+        light[3] | orient << 12,
+    ];
+    let exact = (0..4).all(|c| {
+        let (a, b) = (packed_vertex(&words, c), quad[c]);
+        bytemuck::bytes_of(&a) == bytemuck::bytes_of(&b)
+    });
+    exact.then_some(words)
+}
+
+/// The tint's channels, as the mesher takes them for red, green and blue.
+fn channels(tint: u32) -> [u32; 3] {
+    [tint >> 16 & 255, tint >> 8 & 255, tint & 255]
+}
+
+/// A grey level that `tint` turns into `color`'s red, green and blue.
+fn gray_of(color: u32, tint: u32) -> Option<u32> {
+    let want = [color & 255, color >> 8 & 255, color >> 16 & 255];
+    let t = channels(tint);
+    let gives = |g: u32| (0..3).all(|k| g * t[k] / 255 == want[k]);
+    let k = (0..3).max_by_key(|&k| t[k]).unwrap_or(0);
+    if t[k] == 0 {
+        return gives(0).then_some(0);
+    }
+    let lo = (want[k] * 255).div_ceil(t[k]);
+    let hi = ((want[k] * 255 + 254) / t[k]).min(255);
+    (lo..=hi).find(|&g| gives(g))
+}
+
+/// Corner `corner` of the quad `words` holds, as terrain.wgsl's `packed_corner` expands it.
+pub fn packed_vertex(words: &[u32; 6], corner: usize) -> TerrainVertex {
+    let [w0, w1, w2, w3, w4, w5] = *words;
+    let orient = w5 >> 12 & 0x3_FFFF;
+    let block = [orient & 15, orient >> 4 & 15, orient >> 8 & 15];
+    let axis = (orient >> 12 & 3) as usize;
+    let side = orient >> 14 & 1;
+    let (start, dir) = (orient >> 15 & 3, orient >> 17 & 1);
+    let i = corner as u32;
+    let step = (start + if dir == 1 { 4 - i } else { i }) & 3;
+    let [du, dw] = ROUND[step as usize];
+    let mut pos = block;
+    pos[axis] += side;
+    pos[(axis + 1) % 3] += du;
+    pos[(axis + 2) % 3] += dw;
+    let select = w2 >> 24;
+    let us = select >> (2 * i) & 1;
+    let vs = select >> (2 * i + 1) & 1;
+    let uv = [w2 >> (6 * us) & 63, w2 >> (12 + 6 * vs) & 63].map(|k| (k << 10) as u16);
+    let light = [w3 >> 16, w4, w4 >> 12, w5][corner] & 0xFFF;
+    let light = ((light & 63) << 2 | (light >> 6 & 63) << 10) as u16;
+    let g = w1 >> (8 * i) & 255;
+    let [r, gr, b] = channels(w0).map(|t| g * t / 255);
+    TerrainVertex {
+        pos: pos.map(|c| c as f32),
+        uv,
+        layer: (w3 & 0xFFFF) as u16,
+        light,
+        color: r | gr << 8 | b << 16 | (w0 & 0xFF00_0000),
+    }
+}
+
+/// The compact layout of sorted solid quads with their tints (`SectionMesh::packed`), or
+/// nothing when it would be no smaller than their vertices.
+pub fn layout(solid: &[TerrainVertex], tints: &[u32]) -> Vec<[u32; 6]> {
+    let quads = solid.as_chunks::<4>().0;
+    let records: Vec<Option<[u32; 6]>> = quads
+        .iter()
+        .zip(tints)
+        .map(|(q, &t)| pack_quad(q, t))
+        .collect();
+    let n = quads.len();
+    let packed = records.iter().filter(|r| r.is_some()).count();
+    let full = n - packed;
+    let pad = if full > 0 {
+        n.next_multiple_of(4) - n
+    } else {
+        0
+    };
+    if n + pad + 4 * full >= 4 * n {
+        return Vec::new();
+    }
+    let mut out = Vec::with_capacity(n + pad + 4 * full);
+    let mut next = n + pad;
+    for (i, record) in records.iter().enumerate() {
+        out.push(record.unwrap_or_else(|| {
+            let at = next;
+            next += 4;
+            [(at - i) as u32, 0, 0, 0, 0, FULL]
+        }));
+    }
+    out.resize(n + pad, [0; 6]);
+    for (q, record) in quads.iter().zip(&records) {
+        if record.is_none() {
+            out.extend(
+                q.iter()
+                    .map(|v| bytemuck::cast::<TerrainVertex, [u32; 6]>(*v)),
+            );
+        }
+    }
+    out
+}
+
+/// Quads `layout` gave a record of their own.
+pub fn packed_quads(layout: &[[u32; 6]], quads: usize) -> usize {
+    layout
+        .iter()
+        .take(quads)
+        .filter(|w| w[5] & FULL == 0)
+        .count()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const TINT: u32 = 0x7F_B238;
+
+    /// An opaque colour the mesher makes of grey level `g` times `tint`.
+    fn tinted(g: u32, tint: u32) -> u32 {
+        let [r, gr, b] = channels(tint).map(|t| g * t / 255);
+        r | gr << 8 | b << 16 | 0xFF00_0000
+    }
+
+    /// The top face of block (3, 15, 5), corners in `order`: tinted, smooth lit, with
+    /// ambient occlusion darkening its corners differently.
+    fn top(order: [usize; 4]) -> [TerrainVertex; 4] {
+        let pos = [
+            [3.0, 16.0, 5.0],
+            [3.0, 16.0, 6.0],
+            [4.0, 16.0, 6.0],
+            [4.0, 16.0, 5.0],
+        ];
+        let uv = [[0, 0], [16 << 10, 0], [16 << 10, 16 << 10], [0, 16 << 10]];
+        let grays = [200, 180, 160, 200];
+        order.map(|i| TerrainVertex {
+            pos: pos[i],
+            uv: uv[i],
+            layer: 7,
+            light: 0xF0 | 0x40 << 8,
+            color: tinted(grays[i], TINT),
+        })
+    }
+
+    fn same(a: &TerrainVertex, b: &TerrainVertex) -> bool {
+        bytemuck::bytes_of(a) == bytemuck::bytes_of(b)
+    }
+
+    #[test]
+    fn a_whole_cube_face_takes_one_record_either_way_round() {
+        for order in [[0, 1, 2, 3], [2, 3, 0, 1], [0, 3, 2, 1]] {
+            let quad = top(order);
+            let words = pack_quad(&quad, TINT).expect("a whole face on the block grid packs");
+            for (corner, v) in quad.iter().enumerate() {
+                assert!(
+                    same(&packed_vertex(&words, corner), v),
+                    "{order:?} corner {corner}"
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn quads_off_the_grid_or_the_steps_keep_their_vertices() {
+        // Half a block up: a slab's top.
+        let mut slab = top([0, 1, 2, 3]);
+        for v in &mut slab {
+            v.pos[1] = 8.5;
+        }
+        assert!(pack_quad(&slab, TINT).is_none());
+        // A UV between the 1/32 steps.
+        let mut uv = top([0, 1, 2, 3]);
+        uv[2].uv[0] += 1;
+        assert!(pack_quad(&uv, TINT).is_none());
+        // Light between the steps of 4.
+        let mut light = top([0, 1, 2, 3]);
+        light[1].light += 1;
+        assert!(pack_quad(&light, TINT).is_none());
+    }
+
+    #[test]
+    fn a_quad_without_a_record_points_at_its_own_vertices() {
+        let mut odd = top([0, 1, 2, 3]);
+        for v in &mut odd {
+            v.pos[1] = 8.5;
+        }
+        let mut solid: Vec<TerrainVertex> = Vec::new();
+        for _ in 0..4 {
+            solid.extend(top([0, 1, 2, 3]));
+        }
+        solid.extend(odd);
+        let out = layout(&solid, &[TINT; 5]);
+        // Five records, padded to eight slots, then the odd quad's four vertices.
+        assert_eq!(out.len(), 12);
+        assert_eq!(packed_quads(&out, 5), 4);
+        assert_eq!(out[4][5], FULL);
+        let at = 4 + out[4][0] as usize;
+        for (slot, v) in out[at..at + 4].iter().zip(&odd) {
+            assert!(same(&bytemuck::cast::<[u32; 6], TerrainVertex>(*slot), v));
+        }
+        // Nothing smaller to gain: no layout at all.
+        assert!(layout(&odd, &[TINT]).is_empty());
+    }
+}
diff --git a/crates/horizon-terrain-mesh/src/par.rs b/crates/horizon-terrain-mesh/src/par.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5c7d280c5faf5d5c487d1cff200205e5f9458f6a
--- /dev/null
+++ b/crates/horizon-terrain-mesh/src/par.rs
@@ -0,0 +1,52 @@
+//! Loading many small files at once: startup reads tens of thousands of
+//! textures and models with a content pack, and one at a time it waits on
+//! each open and read in turn.
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+/// `f` over `items` on the machine's threads, results in `items`' order.
+/// Threads take the next item as they finish one, so a run of slow items
+/// doesn't hold back the others.
+pub fn par_map<T: Sync, R: Send>(items: &[T], f: impl Fn(&T) -> R + Sync) -> Vec<R> {
+    let threads = horizon_threads::worker_count().min(items.len());
+    if threads <= 1 {
+        return items.iter().map(f).collect();
+    }
+    let next = AtomicUsize::new(0);
+    let mut out: Vec<(usize, R)> = std::thread::scope(|scope| {
+        let workers: Vec<_> = (0..threads)
+            .map(|_| {
+                scope.spawn(|| {
+                    let mut done = Vec::new();
+                    loop {
+                        let i = next.fetch_add(1, Ordering::Relaxed);
+                        let Some(item) = items.get(i) else {
+                            return done;
+                        };
+                        done.push((i, f(item)));
+                    }
+                })
+            })
+            .collect();
+        workers
+            .into_iter()
+            .flat_map(|w| w.join().unwrap_or_else(|e| std::panic::resume_unwind(e)))
+            .collect()
+    });
+    out.sort_unstable_by_key(|(i, _)| *i);
+    out.into_iter().map(|(_, r)| r).collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::par_map;
+
+    #[test]
+    fn results_keep_the_items_order() {
+        let items: Vec<u32> = (0..1000).collect();
+        assert_eq!(
+            par_map(&items, |x| x * 2),
+            items.iter().map(|x| x * 2).collect::<Vec<_>>()
+        );
+        assert!(par_map(&[] as &[u32], |x| *x).is_empty());
+    }
+}
diff --git a/crates/horizon-terrain-mesh/src/sides.rs b/crates/horizon-terrain-mesh/src/sides.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f53ec8525132571cf01f428216ee2323a87a4928
--- /dev/null
+++ b/crates/horizon-terrain-mesh/src/sides.rs
@@ -0,0 +1,761 @@
+//! A mesh's solid quads sorted by the side they face, so that the renderer
+//! can leave out the quads turned away from the eye before the GPU shades
+//! their vertices.
+//!
+//! A quad in the plane `x = p` whose corners go counter-clockwise seen from
+//! +X faces +X. From an eye at `x < p` it is seen from behind, and at
+//! `x = p` edge on; the solid pipeline culls back faces, so it draws nothing
+//! from there. A bucket of such quads draws nothing at all while the eye is
+//! at or below the lowest of their planes, and likewise for the other five
+//! axis directions. The seventh bucket holds every other quad (sloped,
+//! rotated, degenerate, or whose two triangles wind opposite ways): it is
+//! drawn from everywhere.
+//!
+//! The buckets lie one after another in the mesh, in an order chosen so that
+//! the buckets an eye can see are usually one or two runs of quads: one draw
+//! each. Coplanar quads facing one way keep their model order, so an overlay
+//! on its base still draws in that order. Solid cutout quads are otherwise
+//! ordered from the outside toward the section interior to reduce overdraw.
+//!
+//! The opaque quads (`OPAQUE_LAYER`) and the cutout ones of each bucket are
+//! apart, so that each of Metal's two solid passes draws only its own quads
+//! (`Part`). Where the renderer draws them in two passes (`group_parts`), all
+//! the opaque buckets come first, then all the cutout ones, so each part is
+//! one or two runs; elsewhere each bucket holds its opaque quads, then its
+//! cutout ones, so one pass over all of them draws the runs it drew before.
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use crate::{OPAQUE_LAYER, TerrainVertex};
+
+/// The buckets in mesh order: +X, +Z, other, +Y, -Z, -X, -Y. Seen from
+/// above (+Y, the commonest case), each pair of horizontal sides with a
+/// common corner is then one run, or two.
+const BUCKETS: [Bucket; 7] = [
+    Bucket::Side(0, true),
+    Bucket::Side(2, true),
+    Bucket::Other,
+    Bucket::Side(1, true),
+    Bucket::Side(2, false),
+    Bucket::Side(0, false),
+    Bucket::Side(1, false),
+];
+const OTHER: usize = 2;
+/// How far, in blocks, the eye must be behind a bucket's planes before the
+/// bucket is left out. The renderer computes both the eye and the section
+/// origins in `f32`, with errors far below this.
+const MARGIN: f32 = 1.0 / 16.0;
+
+#[derive(Clone, Copy)]
+enum Bucket {
+    /// Quads in a plane across `axis` facing its positive (`true`) or
+    /// negative direction.
+    Side(usize, bool),
+    Other,
+}
+
+/// Whether meshes sorted from now on put every bucket's opaque quads before
+/// any cutout ones: set by the renderer when it draws them in two passes.
+static GROUPED: AtomicBool = AtomicBool::new(false);
+
+/// Sorts later meshes for two solid passes (`true`) or one.
+pub fn group_parts(on: bool) {
+    GROUPED.store(on, Ordering::Relaxed);
+}
+
+/// The bucket and whether it holds cutout quads of the `n`th part of a
+/// mesh, in mesh order.
+fn slot(grouped: bool, n: usize) -> (usize, bool) {
+    if grouped {
+        (n % 7, n >= 7)
+    } else {
+        (n / 2, n % 2 == 1)
+    }
+}
+
+/// Where each part of each bucket of a mesh's solid quads ends, and the
+/// planes that tell whether a bucket can face the eye.
+#[derive(Clone, Copy, Debug, Default, PartialEq, serde::Serialize, serde::Deserialize)]
+pub struct Sides {
+    /// The solid quads up to the end of each part of each bucket, in mesh
+    /// order (`slot`).
+    ends: [u32; 14],
+    /// Whether all the opaque parts come first (`group_parts`).
+    grouped: bool,
+    /// Whether opaque and cutout quads are apart; else either part is every
+    /// quad.
+    split: bool,
+    /// Per bucket facing a positive direction, its lowest plane; facing a
+    /// negative one, its highest (unused for the other bucket).
+    planes: [f32; 7],
+}
+
+impl Sides {
+    /// `quads` solid quads in one bucket drawn from everywhere: for meshes
+    /// that were not sorted.
+    pub fn unsorted(quads: u32) -> Self {
+        let mut ends = [0; 14];
+        ends[OTHER * 2..].fill(quads);
+        Self {
+            ends,
+            grouped: false,
+            split: false,
+            planes: [0.0; 7],
+        }
+    }
+
+    /// A sort with these parts' `ends` and `planes`, for tests.
+    #[doc(hidden)]
+    pub fn from_parts(ends: [u32; 14], grouped: bool, split: bool, planes: [f32; 7]) -> Self {
+        Self {
+            ends,
+            grouped,
+            split,
+            planes,
+        }
+    }
+
+    /// The number of solid quads the buckets hold.
+    pub fn quads(&self) -> u32 {
+        self.ends[13]
+    }
+
+    /// Calls `draw(first, count)` for each run of quads an eye at `eye`
+    /// (relative to the mesh's origin) can see the front of, nearest the
+    /// start first. Empty buckets do not break a run.
+    pub fn visible(&self, eye: [f32; 3], draw: impl FnMut(u32, u32)) {
+        self.visible_from(eye, eye[1], Part::All, draw);
+    }
+
+    /// `visible` for every eye from `eye` straight down to the height `low`: the camera and
+    /// its water mirror's eye below the plane, which differ only in y. Only the quads of
+    /// `part`, but every quad of a mesh whose parts are not split.
+    pub fn visible_from(&self, eye: [f32; 3], low: f32, part: Part, draw: impl FnMut(u32, u32)) {
+        let seen = |i: usize| match BUCKETS[i] {
+            Bucket::Side(axis, true) => eye[axis] > self.planes[i] - MARGIN,
+            Bucket::Side(1, false) => low < self.planes[i] + MARGIN,
+            Bucket::Side(axis, false) => eye[axis] < self.planes[i] + MARGIN,
+            Bucket::Other => true,
+        };
+        self.runs(seen, part, draw);
+    }
+
+    /// For GPU culling's copy of `visible_from` with every part (`gfx::gpu_culling`),
+    /// which then only compares: where each bucket of a mesh sorted for one pass ends,
+    /// in `BUCKETS` order, and what `visible_from` compares the eye with for each. That
+    /// is the lowest plane less `MARGIN` for a bucket facing a positive direction, the
+    /// highest plus `MARGIN` for one facing a negative direction, and 0 for the other
+    /// bucket, which it never compares. `None` for a mesh sorted for two passes
+    /// (`group_parts`), whose buckets lie in two stretches each.
+    pub fn thresholds(&self) -> Option<([u32; 7], [f32; 7])> {
+        if self.grouped {
+            return None;
+        }
+        let t: [f32; 7] = std::array::from_fn(|i| match BUCKETS[i] {
+            Bucket::Side(_, true) => self.planes[i] - MARGIN,
+            Bucket::Side(_, false) => self.planes[i] + MARGIN,
+            Bucket::Other => 0.0,
+        });
+        // A bucket's cutout quads end it (`slot`).
+        Some((std::array::from_fn(|b| self.ends[b * 2 + 1]), t))
+    }
+
+    /// The runs of `part`'s quads facing every way.
+    pub fn every(&self, part: Part, draw: impl FnMut(u32, u32)) {
+        self.runs(|_| true, part, draw);
+    }
+
+    /// Calls `draw` for each run of `part`'s quads in the buckets `seen` keeps.
+    fn runs(&self, seen: impl Fn(usize) -> bool, part: Part, mut draw: impl FnMut(u32, u32)) {
+        let mut start = 0;
+        let mut run: Option<u32> = None;
+        for (n, &end) in self.ends.iter().enumerate() {
+            if end == start {
+                continue;
+            }
+            let (bucket, cutout) = slot(self.grouped, n);
+            let wanted = match part {
+                Part::All => true,
+                _ if !self.split => true,
+                Part::Opaque => !cutout,
+                Part::Cutout => cutout,
+            };
+            match (wanted && seen(bucket), run) {
+                (true, None) => run = Some(start),
+                (false, Some(first)) => {
+                    draw(first, start - first);
+                    run = None;
+                }
+                _ => {}
+            }
+            start = end;
+        }
+        if let Some(first) = run {
+            draw(first, start - first);
+        }
+    }
+}
+
+/// The quads `Sides::visible_from` draws: all of them, or those of one of
+/// Metal's two solid passes (terrain.wgsl's `opaque_quad`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Part {
+    All,
+    Opaque,
+    Cutout,
+}
+
+/// The bucket of a quad: the axis plane it lies in and the side its
+/// triangles (corners 0, 1, 2 and 0, 2, 3, as the renderer draws them) face.
+fn bucket(quad: &[TerrainVertex; 4]) -> usize {
+    let p = quad.map(|v| v.pos);
+    for axis in 0..3 {
+        if p.iter().any(|v| v[axis] != p[0][axis]) {
+            continue;
+        }
+        // The normal's component along `axis`, twice each triangle's area.
+        let (u, w) = ((axis + 1) % 3, (axis + 2) % 3);
+        let area = |a: usize, b: usize, c: usize| {
+            (p[b][u] - p[a][u]) * (p[c][w] - p[a][w]) - (p[b][w] - p[a][w]) * (p[c][u] - p[a][u])
+        };
+        let (first, second) = (area(0, 1, 2), area(0, 2, 3));
+        let positive = first >= 0.0 && second >= 0.0;
+        let negative = first <= 0.0 && second <= 0.0;
+        if positive == negative {
+            // Opposite windings, or no area at all.
+            return OTHER;
+        }
+        return BUCKETS
+            .iter()
+            .position(|b| matches!(*b, Bucket::Side(a, s) if a == axis && s == positive))
+            .expect("every side has a bucket");
+    }
+    OTHER
+}
+
+/// Reorders `solid`'s quads by bucket, opaque ones first in each. Solid
+/// cutout quads are also ordered front to back within each axis-facing
+/// bucket; quads that tie keep the mesher's order (the quad's index ends its
+/// sort key), so coplanar overlays still draw over their base.
+#[cfg(test)]
+fn sort(solid: &mut Vec<TerrainVertex>) -> Sides {
+    sort_tinted(solid, &mut Vec::new())
+}
+
+/// `sort`, moving each quad's tint in `tints` (one per quad, or none) with it.
+pub fn sort_tinted(solid: &mut Vec<TerrainVertex>, tints: &mut Vec<u32>) -> Sides {
+    let grouped = GROUPED.load(Ordering::Relaxed);
+    SORT_SCRATCH.with_borrow_mut(|scratch| sort_with(solid, tints, grouped, scratch))
+}
+
+/// `sort`, with all the opaque parts first when `grouped`.
+#[cfg(test)]
+fn sort_parts(solid: &mut Vec<TerrainVertex>, grouped: bool) -> Sides {
+    SORT_SCRATCH.with_borrow_mut(|scratch| sort_with(solid, &mut Vec::new(), grouped, scratch))
+}
+
+/// `sort`'s buffers, kept by each meshing thread so sorting a mesh allocates
+/// nothing: each quad's part, its sort key, and the sorted quads, which are
+/// copied back into the mesh's own (recycled) buffer.
+#[derive(Default)]
+struct SortScratch {
+    slots: Vec<u8>,
+    keys: Vec<u64>,
+    sorted: Vec<[TerrainVertex; 4]>,
+    tints: Vec<u32>,
+}
+thread_local! {
+    static SORT_SCRATCH: std::cell::RefCell<SortScratch> = Default::default();
+}
+
+/// `f32::total_cmp`'s order as an unsigned integer's.
+fn total_order_key(v: f32) -> u32 {
+    let bits = v.to_bits() as i32;
+    (bits ^ (((bits >> 31) as u32) >> 1) as i32) as u32 ^ 0x8000_0000
+}
+
+fn sort_with(
+    solid: &mut Vec<TerrainVertex>,
+    tints: &mut Vec<u32>,
+    grouped: bool,
+    scratch: &mut SortScratch,
+) -> Sides {
+    let (quads, rest) = solid.as_chunks::<4>();
+    debug_assert!(rest.is_empty(), "solid vertices come in quads");
+    let quads_len = quads.len();
+    let cutout = |q: &[TerrainVertex; 4]| q[0].layer & OPAQUE_LAYER == 0;
+    // Each quad's part, by its place in mesh order (`slot`).
+    let position = |b: usize, cutout: bool| match grouped {
+        true => b + 7 * usize::from(cutout),
+        false => b * 2 + usize::from(cutout),
+    };
+    let slots = &mut scratch.slots;
+    slots.clear();
+    slots.extend(quads.iter().map(|q| position(bucket(q), cutout(q)) as u8));
+    let has_cutout = quads.iter().any(cutout);
+    let mut counts = [0u32; 7];
+    let mut slot_counts = [0u32; 14];
+    let mut planes = [0f32; 7];
+    for (quad, &part) in quads.iter().zip(slots.iter()) {
+        slot_counts[usize::from(part)] += 1;
+        let b = slot(grouped, usize::from(part)).0;
+        if let Bucket::Side(axis, positive) = BUCKETS[b] {
+            let p = quad[0].pos[axis];
+            planes[b] = match (counts[b], positive) {
+                (0, _) => p,
+                (_, true) => planes[b].min(p),
+                (_, false) => planes[b].max(p),
+            };
+        }
+        counts[b] += 1;
+    }
+    let mut slot_ends = [0u32; 14];
+    let mut total = 0;
+    for (end, count) in slot_ends.iter_mut().zip(slot_counts) {
+        total += count;
+        *end = total;
+    }
+    if has_cutout || counts.iter().filter(|&&c| c > 0).count() > 1 {
+        // One integer key per quad: its part, then (cutout meshes, side
+        // buckets) its plane from the outside in, then its index, which keeps
+        // the order of equal quads as a stable sort does.
+        let keys = &mut scratch.keys;
+        keys.clear();
+        keys.extend(
+            quads
+                .iter()
+                .zip(slots.iter())
+                .enumerate()
+                .map(|(i, (quad, &part))| {
+                    let plane = match BUCKETS[slot(grouped, usize::from(part)).0] {
+                        Bucket::Side(axis, positive) if has_cutout => {
+                            let key = total_order_key(quad[0].pos[axis]);
+                            if positive { !key } else { key }
+                        }
+                        _ => 0,
+                    };
+                    u64::from(part) << 56 | u64::from(plane) << 24 | i as u64
+                }),
+        );
+        debug_assert!(quads.len() < 1 << 24);
+        keys.sort_unstable();
+        let sorted = &mut scratch.sorted;
+        sorted.clear();
+        sorted.extend(keys.iter().map(|&k| quads[(k & 0xFF_FFFF) as usize]));
+        solid.clear();
+        solid.extend_from_slice(sorted.as_flattened());
+        if tints.len() == quads_len {
+            let sorted_tints = &mut scratch.tints;
+            sorted_tints.clear();
+            sorted_tints.extend(keys.iter().map(|&k| tints[(k & 0xFF_FFFF) as usize]));
+            std::mem::swap(tints, sorted_tints);
+        }
+    }
+    Sides {
+        ends: slot_ends,
+        grouped,
+        split: true,
+        planes,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The sort as it was before the integer keys: quads moved to their
+    /// parts in order, then a stable sort by plane in each side bucket.
+    fn reference(solid: &[TerrainVertex], grouped: bool) -> Vec<TerrainVertex> {
+        let quads = solid.as_chunks::<4>().0;
+        let has_cutout = quads.iter().any(|q| q[0].layer & OPAQUE_LAYER == 0);
+        let mut sorted = Vec::new();
+        for n in 0..14 {
+            let (b, cutout) = slot(grouped, n);
+            let mut part: Vec<[TerrainVertex; 4]> = quads
+                .iter()
+                .filter(|q| bucket(q) == b && (q[0].layer & OPAQUE_LAYER == 0) == cutout)
+                .copied()
+                .collect();
+            if let (Bucket::Side(axis, positive), true) = (BUCKETS[b], has_cutout) {
+                part.sort_by(|a, b| {
+                    let (a, b) = (a[0].pos[axis], b[0].pos[axis]);
+                    if positive {
+                        b.total_cmp(&a)
+                    } else {
+                        a.total_cmp(&b)
+                    }
+                });
+            }
+            sorted.extend(part);
+        }
+        sorted.into_flattened()
+    }
+
+    #[test]
+    fn integer_keys_sort_as_the_stable_sort_did() {
+        let mut state = 0x2545_F491_4F6C_DD1Du64;
+        let mut next = move || {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            state
+        };
+        for round in 0..100 {
+            let grouped = round % 2 == 1;
+            let mut solid = Vec::new();
+            for _ in 0..(next() % 300) {
+                let origin = [0, 1, 2].map(|_| (next() % 34) as f32 / 2.0 - 0.5);
+                // Some negative and signed-zero planes too.
+                let origin = if next() % 9 == 0 {
+                    origin.map(|v| -v)
+                } else {
+                    origin
+                };
+                let layer = if round % 3 == 0 {
+                    OPAQUE_LAYER
+                } else {
+                    (next() % 2) as u16 * OPAQUE_LAYER
+                };
+                let faces = cube(origin, layer);
+                let face = (next() % 6) as usize;
+                solid.extend_from_slice(&faces[face * 4..face * 4 + 4]);
+            }
+            let expected = reference(&solid, grouped);
+            let sides = sort_parts(&mut solid, grouped);
+            assert_eq!(
+                bytemuck::cast_slice::<_, u8>(&solid),
+                bytemuck::cast_slice::<_, u8>(&expected),
+                "round {round}"
+            );
+            assert_eq!(sides.quads() as usize * 4, solid.len());
+        }
+    }
+
+    fn quad(corners: [[f32; 3]; 4], layer: u16) -> [TerrainVertex; 4] {
+        corners.map(|p| TerrainVertex::new(p, [0.0; 2], layer, 0, 0))
+    }
+
+    /// A unit block's six faces at `origin`, wound counter-clockwise seen
+    /// from outside, as block models are.
+    fn cube(origin: [f32; 3], layer: u16) -> Vec<TerrainVertex> {
+        let [x, y, z] = origin;
+        let (a, b, c) = (x + 1.0, y + 1.0, z + 1.0);
+        [
+            [[a, y, z], [a, b, z], [a, b, c], [a, y, c]], // +X
+            [[x, y, z], [x, y, c], [x, b, c], [x, b, z]], // -X
+            [[x, b, z], [x, b, c], [a, b, c], [a, b, z]], // +Y
+            [[x, y, z], [a, y, z], [a, y, c], [x, y, c]], // -Y
+            [[x, y, c], [a, y, c], [a, b, c], [x, b, c]], // +Z
+            [[x, y, z], [x, b, z], [a, b, z], [a, y, z]], // -Z
+        ]
+        .into_iter()
+        .flat_map(|q| quad(q, layer))
+        .collect()
+    }
+
+    /// Where each bucket ends, in a mesh sorted for one pass.
+    fn bucket_ends(sides: &Sides) -> [u32; 7] {
+        assert!(!sides.grouped);
+        std::array::from_fn(|b| sides.ends[b * 2 + 1])
+    }
+
+    fn runs(sides: &Sides, eye: [f32; 3]) -> Vec<(u32, u32)> {
+        let mut out = Vec::new();
+        sides.visible(eye, |first, count| out.push((first, count)));
+        out
+    }
+
+    /// The quads of `solid` whose triangles face `eye`, by their layer.
+    fn front_facing(solid: &[TerrainVertex], eye: [f32; 3]) -> Vec<u16> {
+        let sub = |a: [f32; 3], b: [f32; 3]| [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
+        solid
+            .as_chunks::<4>()
+            .0
+            .iter()
+            .filter(|q| {
+                [[0, 1, 2], [0, 2, 3]].iter().any(|t| {
+                    let (e1, e2) = (sub(q[t[1]].pos, q[t[0]].pos), sub(q[t[2]].pos, q[t[0]].pos));
+                    let n = [
+                        e1[1] * e2[2] - e1[2] * e2[1],
+                        e1[2] * e2[0] - e1[0] * e2[2],
+                        e1[0] * e2[1] - e1[1] * e2[0],
+                    ];
+                    let to_eye = sub(eye, q[t[0]].pos);
+                    n[0] * to_eye[0] + n[1] * to_eye[1] + n[2] * to_eye[2] > 0.0
+                })
+            })
+            .map(|q| q[0].layer)
+            .collect()
+    }
+
+    #[test]
+    fn cube_faces_go_to_their_buckets_in_order() {
+        let mut solid = cube([3.0, 4.0, 5.0], 0);
+        for (i, v) in solid.iter_mut().enumerate() {
+            v.layer = (i / 4) as u16;
+        }
+        let sides = sort(&mut solid);
+        assert_eq!(bucket_ends(&sides), [1, 2, 2, 3, 4, 5, 6]);
+        let layers: Vec<u16> = solid.iter().step_by(4).map(|v| v.layer).collect();
+        // +X, +Z, +Y, -Z, -X, -Y.
+        assert_eq!(layers, [0, 4, 2, 5, 1, 3]);
+        assert_eq!(sides.planes[0], 4.0); // +X at x = 4
+        assert_eq!(sides.planes[5], 3.0); // -X at x = 3
+        assert_eq!(sides.planes[3], 5.0); // +Y at y = 5
+    }
+
+    #[test]
+    fn the_drawn_runs_hold_every_quad_that_faces_the_eye() {
+        // Blocks across a section, with a sloped quad and a bowtie.
+        let mut solid = Vec::new();
+        let mut layer = 0;
+        for origin in [
+            [0.0, 0.0, 0.0],
+            [7.0, 3.0, 12.0],
+            [15.0, 15.0, 15.0],
+            [2.0, 9.0, 4.0],
+        ] {
+            for q in cube(origin, 0).chunks(4) {
+                solid.extend(q.iter().map(|v| TerrainVertex { layer, ..*v }));
+                layer += 1;
+            }
+        }
+        let slope = [
+            [1.0, 1.0, 1.0],
+            [2.0, 1.0, 1.0],
+            [2.0, 2.0, 2.0],
+            [1.0, 2.0, 2.0],
+        ];
+        let bowtie = [
+            [5.0, 1.0, 1.0],
+            [5.0, 2.0, 2.0],
+            [5.0, 1.0, 2.0],
+            [5.0, 2.0, 1.0],
+        ];
+        for corners in [slope, bowtie] {
+            solid.extend(quad(corners, layer));
+            layer += 1;
+        }
+        let sides = sort(&mut solid);
+        assert_eq!(sides.quads(), u32::from(layer));
+        let eyes = [-20.0f32, -0.5, 0.0, 3.5, 8.0, 15.99, 16.0, 30.0];
+        for &x in &eyes {
+            for &y in &eyes {
+                for &z in &eyes {
+                    let eye = [x, y, z];
+                    let mut drawn = Vec::new();
+                    for (first, count) in runs(&sides, eye) {
+                        drawn.extend(
+                            solid[first as usize * 4..(first + count) as usize * 4]
+                                .iter()
+                                .step_by(4)
+                                .map(|v| v.layer),
+                        );
+                    }
+                    for layer in front_facing(&solid, eye) {
+                        assert!(drawn.contains(&layer), "{eye:?} misses quad {layer}");
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn runs_merge_across_hidden_and_empty_buckets() {
+        let mut solid = cube([0.0; 3], 0);
+        let sides = sort(&mut solid);
+        // From above, +X and +Z: +X, +Z, (no other), +Y is one run.
+        assert_eq!(runs(&sides, [8.0, 8.0, 8.0]), [(0, 3)]);
+        // From below, -X and -Z: -Z, -X, -Y.
+        assert_eq!(runs(&sides, [-8.0, -8.0, -8.0]), [(3, 3)]);
+        // From above, -X and +Z: +Z, +Y, then -X.
+        assert_eq!(runs(&sides, [-8.0, 8.0, 8.0]), [(1, 2), (4, 1)]);
+        // Inside the block every face is seen from behind.
+        assert!(runs(&sides, [0.5; 3]).is_empty());
+        // Level with its top, the eye may see it: the margin keeps it.
+        assert_eq!(runs(&sides, [0.5, 1.0, 0.5]), [(2, 1)]);
+    }
+
+    #[test]
+    fn an_eye_and_its_mirror_below_see_the_faces_of_both() {
+        let mut solid = cube([0.0; 3], 0);
+        let sides = sort(&mut solid);
+        let both = |eye: [f32; 3], low: f32| {
+            let mut out = Vec::new();
+            sides.visible_from(eye, low, Part::All, |first, count| out.push((first, count)));
+            out
+        };
+        // Above the block: +X, +Z and +Y; with the mirror's eye below it, -Y too.
+        assert_eq!(runs(&sides, [8.0, 8.0, 8.0]), [(0, 3)]);
+        assert_eq!(both([8.0, 8.0, 8.0], -8.0), [(0, 3), (5, 1)]);
+        // A mirror above the block's bottom adds nothing.
+        assert_eq!(both([8.0, 8.0, 8.0], 0.5), [(0, 3)]);
+        // The sides depend on x and z alone.
+        assert_eq!(both([-8.0, 8.0, -8.0], -8.0), [(2, 4)]);
+    }
+
+    /// Opaque and cutout quads of each bucket split: each pass's runs hold
+    /// exactly its own quads facing the eye, and all of them together the
+    /// same runs as one pass.
+    #[test]
+    fn each_part_draws_its_own_quads_facing_the_eye() {
+        // Two blocks: one opaque, one cutout, then an opaque one again, so
+        // every bucket holds both kinds out of order.
+        let mut solid = Vec::new();
+        let mut id = 0u16;
+        for (origin, opaque) in [
+            ([0.0, 0.0, 0.0], true),
+            ([4.0, 2.0, 6.0], false),
+            ([9.0, 5.0, 3.0], true),
+        ] {
+            for q in cube(origin, 0).chunks(4) {
+                let layer = id | if opaque { OPAQUE_LAYER } else { 0 };
+                solid.extend(q.iter().map(|v| TerrainVertex { layer, ..*v }));
+                id += 1;
+            }
+        }
+        let unsorted = solid;
+        for grouped in [false, true] {
+            let mut solid = unsorted.clone();
+            let sides = sort_parts(&mut solid, grouped);
+            let layers: Vec<u16> = solid
+                .as_chunks::<4>()
+                .0
+                .iter()
+                .map(|q| q[0].layer)
+                .collect();
+            for eye in [[20.0, 30.0, -10.0], [-5.0, 1.0, 4.0], [5.0, 3.0, 7.0]] {
+                let quads = |part| {
+                    let mut out = Vec::new();
+                    sides.visible_from(eye, eye[1], part, |first, count| {
+                        out.extend(
+                            layers[first as usize..(first + count) as usize]
+                                .iter()
+                                .copied(),
+                        )
+                    });
+                    out.sort_unstable();
+                    out
+                };
+                let mut facing = front_facing(&solid, eye);
+                facing.sort_unstable();
+                let opaque = quads(Part::Opaque);
+                let cutout = quads(Part::Cutout);
+                assert!(opaque.iter().all(|l| l & OPAQUE_LAYER != 0), "{eye:?}");
+                assert!(cutout.iter().all(|l| l & OPAQUE_LAYER == 0), "{eye:?}");
+                for l in &facing {
+                    let mine = if l & OPAQUE_LAYER != 0 {
+                        &opaque
+                    } else {
+                        &cutout
+                    };
+                    assert!(
+                        mine.contains(l),
+                        "{eye:?}: quad {l} facing the eye left out"
+                    );
+                }
+                let mut both = [opaque, cutout].concat();
+                both.sort_unstable();
+                assert_eq!(both, quads(Part::All), "{eye:?}");
+            }
+            // Every way: each part once, whole.
+            let mut every = Vec::new();
+            sides.every(Part::Opaque, |first, count| every.push((first, count)));
+            sides.every(Part::Cutout, |first, count| every.push((first, count)));
+            let total: u32 = every.iter().map(|r| r.1).sum();
+            assert_eq!(total, sides.quads());
+
+            // Two passes: from above a corner, each part is one or two runs.
+            if grouped {
+                let mut count = 0;
+                sides.visible_from([20.0, 30.0, -10.0], 30.0, Part::Opaque, |_, _| count += 1);
+                assert_eq!(count, 2);
+            }
+        }
+    }
+
