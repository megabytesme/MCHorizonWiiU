+#[derive(Clone, Debug, PartialEq)]
+pub enum ClientWindowEvent {
+    KeyboardInput {
+        event: KeyboardEvent,
+        is_synthetic: bool,
+    },
+    ModifiersChanged(Modifiers),
+    MouseInput {
+        state: KeyState,
+        button: MouseButton,
+    },
+    CursorMoved {
+        position: PhysicalPosition<f64>,
+    },
+    MouseWheel {
+        delta: MouseScrollDelta,
+        phase: TouchPhase,
