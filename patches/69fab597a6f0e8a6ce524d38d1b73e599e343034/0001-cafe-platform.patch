+/// `AbstractWidget.extractScrollingStringOverContents`: `message` over the
+/// widget's box less `margin` on each side (centred, or scrolling when too
+/// wide).
+pub fn scrolling_string_over_contents(
+    out: &mut Vec<Draw>,
+    m: &Measure,
+    message: &Text,
+    x: i32,
+    y: i32,
+    w: i32,
+    h: i32,
