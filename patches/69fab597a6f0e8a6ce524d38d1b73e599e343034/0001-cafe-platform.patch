+            self.width
+        }
+    }
+    pub fn text_x(&self) -> f32 {
+        if self.bordered { self.x + 4.0 } else { self.x }
+    }
+    pub fn text_y(&self) -> f32 {
+        if self.bordered {
+            self.y + ((self.height - 8.0) / 2.0).floor()
