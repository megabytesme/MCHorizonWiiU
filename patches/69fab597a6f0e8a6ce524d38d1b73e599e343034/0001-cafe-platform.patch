+
+    #[test]
+    fn resolve_once_per_model_keeps_each_transformed_variant_bake() -> Result<()> {
+        let fixture = Fixture(
+            std::env::temp_dir().join(format!("horizon-unique-resolution-{}", std::process::id())),
+        );
+        fixture.write(
+            "lanef:block/shaft",
+            r##"{"textures":{"side":"lanef:block/shaft"},"elements":[{"from":[6,6,0],"to":[10,10,8],"faces":{"north":{"texture":"#side"},"up":{"texture":"#side"}}}]}"##,
+        );
+        fixture.write(
+            "lanef:block/cog",
+            r#"{"parent":"lanef:block/shaft","textures":{"side":"lanef:block/cog"}}"#,
+        );
+        let library = ParsedModels::default().block_library(
+            &fixture.0,
+            vec!["lanef:block/shaft".into(), "lanef:block/cog".into()],
+        )?;
+        let variants: BTreeSet<VariantKey> = BTreeSet::from([
+            ("lanef:block/shaft".into(), [0, 0, 0], false),
+            ("lanef:block/shaft".into(), [0, 90, 0], false),
+            ("lanef:block/shaft".into(), [0, 180, 0], false),
+            ("lanef:block/shaft".into(), [0, 90, 0], true),
+            ("lanef:block/cog".into(), [0, 0, 0], false),
+        ]);
+        let mut resolved_names = BTreeMap::new();
+        let resolved =
+            resolve_unique_models(variants.iter().map(|(name, ..)| name.clone()), |name| {
+                *resolved_names.entry(name.to_owned()).or_insert(0usize) += 1;
+                Ok(library.resolve(name)?)
+            })?;
+        assert_eq!(
+            resolved_names,
+            BTreeMap::from([
+                ("lanef:block/cog".to_owned(), 1),
+                ("lanef:block/shaft".to_owned(), 1),
+            ])
+        );
+        assert_eq!(resolved.len(), 2);
+
+        let mut sprites = Sprites::default();
+        let mut shared_bakes = Vec::new();
+        let mut baseline_bakes = Vec::new();
+        for (name, turns, lock) in &variants {
+            shared_bakes.push(bake_resolved(
+                &fixture.0,
+                &mut sprites,
+                &resolved[name],
+                *turns,
+                *lock,
+            )?);
+            baseline_bakes.push(bake_variant(
+                &fixture.0,
+                &mut sprites,
+                &library,
+                name,
+                *turns,
+                *lock,
+            )?);
+        }
+        assert_eq!(shared_bakes.len(), variants.len());
+        assert_eq!(baseline_bakes.len(), variants.len());
+        for (shared, baseline) in shared_bakes.iter().zip(&baseline_bakes) {
+            assert_eq!(shared.ambient_occlusion, baseline.ambient_occlusion);
+            assert_eq!(shared.particle, baseline.particle);
+            assert_eq!(shared.faces.len(), baseline.faces.len());
+            for (shared, baseline) in shared.faces.iter().zip(&baseline.faces) {
+                assert_eq!(shared.quad, baseline.quad);
+                assert_eq!(shared.layer, baseline.layer);
+                assert_eq!(shared.opaque, baseline.opaque);
+                assert_eq!(shared.translucent, baseline.translucent);
+                assert_eq!(shared.fusion, baseline.fusion);
+            }
+        }
+        assert_ne!(shared_bakes[0].faces[0].quad, shared_bakes[1].faces[0].quad);
+        Ok(())
+    }
+
+    #[test]
+    fn standalone_models_bake_once_and_skip_what_does_not_read() -> Result<()> {
+        let fixture = Fixture(
+            std::env::temp_dir().join(format!("horizon-standalone-{}", std::process::id())),
+        );
+        // A half shaft: one element, two faces; a child with its parent's elements.
+        fixture.write(
+            "lanef:block/shaft_half",
+            r##"{"textures":{"side":"lanef:block/shaft"},"elements":[{"from":[6,6,0],"to":[10,10,8],"faces":{"north":{"texture":"#side"},"up":{"texture":"#side"}}}]}"##,
+        );
+        fixture.write(
+            "lanef:block/cog",
+            r#"{"parent":"lanef:block/shaft_half","textures":{"side":"lanef:block/cog"}}"#,
+        );
+        fixture.write("lanef:block/orphan", r#"{"parent":"lanef:block/absent"}"#);
+        let mut models = StateModels::default();
+        let mut sprites = Sprites::default();
+        let names: Vec<String> = [
+            "lanef:block/shaft_half",
+            "lanef:block/cog",
+            "lanef:block/orphan",
+            "lanef:block/absent",
+            "lanef:block/shaft_half",
+        ]
+        .map(str::to_owned)
+        .into();
+        let parsed = ParsedModels::load(&fixture.0);
+        models.bake_standalone(&fixture.0, &mut sprites, &parsed, &names)?;
+        let shaft = models.standalone("lanef:block/shaft_half").expect("baked");
+        assert_eq!(shaft.faces.len(), 2);
+        let cog = models.standalone("lanef:block/cog").expect("baked");
+        assert_eq!(cog.faces.len(), 2);
+        assert_ne!(cog.faces[0].layer, shaft.faces[0].layer, "its own texture");
+        assert!(models.standalone("lanef:block/orphan").is_none());
+        assert!(models.standalone("lanef:block/absent").is_none());
+        assert!(models.standalone("lanef:block/unnamed").is_none());
+        // Named twice, baked once.
+        assert_eq!(models.baked.len(), 2);
+        // Without a parsed library, the files are read directly.
+        let mut direct = StateModels::default();
+        direct.bake_standalone(&fixture.0, &mut sprites, &ParsedModels::default(), &names)?;
+        assert_eq!(
+            direct.standalone("lanef:block/cog").map(|m| m.faces.len()),
+            Some(2)
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn a_standalone_model_a_state_bakes_unturned_is_shared() -> Result<()> {
+        let mut models = StateModels::default();
+        let variant = |rotations| Variant {
+            model: "lanef:block/shared".into(),
+            rotations,
+            uv_lock: false,
