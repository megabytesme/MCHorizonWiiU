-            .iter()
-            .map(|(k, v)| format!(r#""{k}":{v}"#))
-            .collect();
-        write(format_args!(
-            r#""ph":"C","name":"{name}","ts":{},"args":{{{}}}"#,
-            micros(Instant::now()),
-            args.join(",")
-        ));
-    }
