-    let text_top = (top + bottom - 9) / 2 + 1;
-    let available = right - left;
-    if line_width > available {
-        let pos = scroll_offset(line_width - available, now_ms);
-        out.push(Draw::Scissor {
-            x0: left,
-            y0: top,
-            x1: right,
-            y1: bottom,
