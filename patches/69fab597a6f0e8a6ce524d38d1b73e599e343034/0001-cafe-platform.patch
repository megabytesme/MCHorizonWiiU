-    pub fn parse(t: &Tag) -> Option<Self> {
-        let button = |key: &str| t.get(key).and_then(Button::parse);
-        let kind = match path(&string(t.get("type"))?) {
-            "notice" => Kind::Notice(match t.get("action") {
-                Some(b) => Button::parse(b)?,
