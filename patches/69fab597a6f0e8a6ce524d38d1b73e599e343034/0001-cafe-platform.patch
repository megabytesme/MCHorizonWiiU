+            #[cfg(target_os = "cafe")]
+            if trace_detail {
+                log::info!("Horizon Cafe mesh tables: state 0 block classification complete");
+            }
+            let mut face = [0u8; 6];
+            let mut cover = [0f32; 6];
+            // A server's visibility knows no state (`FaceVisibility::empty`):
