-            && pending == 0
-            && resident as f64 >= 0.8 * std::f64::consts::PI * f64::from(radius * radius)
-            && FILLING.swap(false, Ordering::Relaxed)
-        {
-            mark("world.view_full");
-        }
-    }
-}
