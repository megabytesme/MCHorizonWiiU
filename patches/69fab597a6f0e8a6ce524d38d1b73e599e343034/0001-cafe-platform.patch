+    Focused(bool),
+    Resized(PhysicalSize<u32>),
+    CloseRequested,
+    RedrawRequested,
+    Ime(ImeEvent),
+    DroppedFile(PathBuf),
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum ClientDeviceEvent {
+    MouseMotion { delta: (f64, f64) },
+}
