-                    rect: None,
-                    left: 0.0,
-                    top: 0.0,
-                    right: 0.0,
-                    bottom: 8.0,
-                    advance: 8.0,
-                    offset: 1.0,
-                }
-            } else {
-                font.glyph_styled(ch, style)
