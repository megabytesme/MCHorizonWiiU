+        let lo = batch
+            .vertices
+            .iter()
+            .map(|v| v.pos[0])
+            .fold(f32::INFINITY, f32::min);
+        let hi = batch
+            .vertices
+            .iter()
+            .map(|v| v.pos[0])
+            .fold(f32::NEG_INFINITY, f32::max);
+        assert!(
+            (lo - left).abs() < 0.001,
+            "centred at {left}, drawn from {lo}"
+        );
+        assert!(
+            hi - lo >= width - 0.001,
+            "the whole label is drawn: {lo}..{hi}, {width} wide"
+        );
+    }
