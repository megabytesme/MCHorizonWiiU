-    let mut pad = Padded {
-        blocks: vec![1; P * P * P],
-        light: Vec::new(),
-    };
-    for y in 0..16 {
-        for z in 0..16 {
-            for x in 0..16 {
-                pad.blocks[pi(x, y, z)] = u32::from(opaque(x, y, z)) + 2 * ((x + y + z) as u32 & 1);
-            }
-        }
-    }
-    pad
-}
