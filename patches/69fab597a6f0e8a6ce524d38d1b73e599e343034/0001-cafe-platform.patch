@@ -0,0 +1,222 @@
+//! CreateWorldScreen's Experiments screen (`ExperimentsScreen`): the feature
+//! packs the jar ships, each with an on/off switch, under the red warning that
+//! they cannot be turned off after the world is created.
+//!
+//! The layout follows vanilla's: `HeaderAndFooterLayout` (a 33-pixel title
+//! header and footer, the contents starting 30 pixels under the header), a
+//! `MultiLineTextWidget` warning 310 wide, then a `SwitchGrid` 299 wide with
+//! its information underneath each switch.
+use crate::{
+    font::Font,
+    hud::{HudAtlas, HudBatch},
+    text::{Text, named_color},
+    ui,
+};
+
+/// `HeaderAndFooterLayout`'s header and footer.
+const HEADER: f32 = 33.0;
+const FOOTER: f32 = 33.0;
+/// `SwitchGrid.builder(299)`, its `DEFAULT_SWITCH_BUTTON_WIDTH` and the
+/// information's maximum width (`width - paddingLeft - buttonWidth`).
+const GRID: f32 = 299.0;
+const BUTTON: f32 = 44.0;
+const INFO: f32 = 266.0 - 11.0;
+/// `ExperimentsScreen.MAIN_CONTENT_WIDTH`: the warning's maximum width.
+const WARNING: f32 = 310.0;
+/// `withInfoUnderneath(2, true)`: two rows of information, always that tall.
+const MAX_INFO_ROWS: usize = 2;
+/// `withRowSpacing(4)`.
+const ROW_SPACING: f32 = 4.0;
+/// One switch and its two information rows, `rowSpacing` included.
+const FLAG_HEIGHT: f32 = 20.0 + ROW_SPACING + (9.0 * MAX_INFO_ROWS as f32);
+
+/// One feature pack: `SwitchGrid.addSwitch(...).withInfo(description)`.
+pub struct Flag {
+    pub id: String,
+    pub title: Text,
+    pub description: Text,
+    pub enabled: bool,
+}
+
+/// What a press asked for.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Outcome {
+    /// `gui.done`: the switches go to the selection.
+    Done,
+    /// `gui.cancel` or Escape.
+    Cancel,
+}
+
+/// A press on the screen.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Click {
+    /// The i-th switch.
+    Switch(usize),
+    Outcome(Outcome),
+}
+
+/// The screen.
+pub struct ExperimentsScreen {
+    pub flags: Vec<Flag>,
+    pub in_world: bool,
+}
+impl ExperimentsScreen {
+    pub fn new(flags: Vec<Flag>) -> Self {
+        Self {
+            flags,
+            in_world: false,
+        }
+    }
+    /// `HeaderAndFooterLayout.arrangeElements`: the contents start at the
+    /// header's height plus 30.
+    fn content_top() -> f32 {
+        HEADER + 30.0
+    }
+    /// The warning, red (`ExperimentsScreen.INFO`).
+    fn warning(&self) -> Text {
+        Text::translate("selectWorld.experiments.info", &[])
+            .with_color(named_color("red").unwrap_or(0xFF5555))
+    }
+    /// The warning's lines (`MultiLineTextWidget.setMaxWidth(310)`).
+    fn warning_lines(&self, font: &Font) -> Vec<Text> {
+        font.split_lines(&self.warning(), WARNING)
+            .into_iter()
+            .map(|(line, _)| line)
+            .collect()
+    }
+    /// Where the `SwitchGrid` starts: under the warning and its 15-pixel
+    /// bottom padding.
+    fn grid_top(&self, font: &Font) -> f32 {
+        Self::content_top() + 9.0 * self.warning_lines(font).len() as f32 + 15.0
+    }
+    fn grid_left(w: f32) -> f32 {
+        ((w - GRID) / 2.0).trunc()
+    }
+    /// The i-th switch's button (`alignHorizontallyRight` in the 44-wide
+    /// column).
+    fn switch_rect(&self, font: &Font, w: f32, i: usize) -> (f32, f32) {
+        let top = self.grid_top(font) + i as f32 * FLAG_HEIGHT;
+        (Self::grid_left(w) + GRID - BUTTON, top)
+    }
+    /// A press: a switch, Done (`gui.done`) or Cancel (`gui.cancel`).
+    pub fn click(&self, atlas: &HudAtlas, (x, y): (f32, f32), size: (f32, f32)) -> Option<Click> {
+        for i in 0..self.flags.len() {
+            let (bx, by) = self.switch_rect(&atlas.font, size.0, i);
+            if ui::hovered((x, y), bx, by, BUTTON, 20.0) {
+                return Some(Click::Switch(i));
+            }
+        }
+        let [(dx, dy), (cx, cy)] = footer(size.0, size.1);
+        if ui::hovered((x, y), dx, dy, 150.0, 20.0) {
+            return Some(Click::Outcome(Outcome::Done));
+        }
+        if ui::hovered((x, y), cx, cy, 150.0, 20.0) {
+            return Some(Click::Outcome(Outcome::Cancel));
+        }
+        None
+    }
+    pub fn draw(&self, batch: &mut HudBatch, atlas: &HudAtlas, cursor: (f32, f32)) {
+        let (w, h) = (batch.width, batch.height);
+        ui::menu_background(batch, atlas, 0.0, 0.0, w, h, self.in_world);
+        let font = &atlas.font;
+        // `addTitleHeader`: the title centred in the header's 33 pixels.
+        let title = Text::translate("selectWorld.experiments", &[]);
+        let tw = font.width_text(&title);
+        batch.text_styled(
+            atlas,
+            &title,
+            ((w - tw) / 2.0).trunc(),
+            15.0,
+            u32::MAX,
+            true,
+        );
+        // The warning, centred as a 310-wide block.
+        let mut y = Self::content_top();
+        for line in self.warning_lines(font) {
+            batch.text_styled(
+                atlas,
+                &line,
+                ((w - WARNING) / 2.0).trunc(),
+                y,
+                u32::MAX,
+                true,
+            );
+            y += 9.0;
+        }
+        // `SwitchGrid`: the label left, the switch right, the information
+        // grey underneath.
+        let left = Self::grid_left(w);
+        let gray = named_color("gray").unwrap_or(0xAAAAAA);
+        for (i, flag) in self.flags.iter().enumerate() {
+            let (bx, by) = self.switch_rect(font, w, i);
+            let label_y = by + 5.0;
+            batch.text_styled(atlas, &flag.title, left, label_y, u32::MAX, true);
+            let hover = ui::hovered(cursor, bx, by, BUTTON, 20.0);
+            let value = Text::translate(
+                if flag.enabled {
+                    "options.on"
+                } else {
+                    "options.off"
+                },
+                &[],
+            );
+            ui::button(batch, atlas, bx, by, BUTTON, 20.0, &value, true, hover);
+            let mut info_y = by + 20.0;
+            for line in font.split_lines(&flag.description.clone().with_color(gray), INFO) {
+                batch.text_styled(atlas, &line.0, left, info_y, u32::MAX, true);
+                info_y += 9.0;
+            }
+        }
+        let [(dx, dy), (cx, cy)] = footer(w, h);
+        for (action, fx, fy, key) in [
+            (crate::widgets::Action::Done, dx, dy, "gui.done"),
+            (crate::widgets::Action::Cancel, cx, cy, "gui.cancel"),
+        ] {
+            let hover = ui::hovered(cursor, fx, fy, 150.0, 20.0);
+            ui::action_button(
+                batch,
+                atlas,
+                action,
+                fx,
+                fy,
+                150.0,
+                20.0,
+                &Text::translate(key, &[]),
+                true,
+                hover,
+            );
+        }
+    }
+}
+
+/// `HeaderAndFooterLayout`: two 150-wide buttons 8 apart in the 33-pixel
+/// footer.
+fn footer(w: f32, h: f32) -> [(f32, f32); 2] {
+    let x = ((w - 308.0) / 2.0).trunc();
+    let y = h - FOOTER + 6.0;
+    [(x, y), (x + 158.0, y)]
+}
+
+/// `ExperimentsScreen.init`: every feature pack the jar ships under
+/// `data/minecraft/datapacks`, switched on when `enabled` holds its id.
+pub fn repository_flags(resources: &std::path::Path, enabled: &[String]) -> Vec<Flag> {
+    crate::datapack::feature_packs(resources)
+        .into_iter()
+        .map(|pack| {
+            let id = pack.id.clone();
+            // `ExperimentsScreen.getHumanReadableTitle`.
+            let name = format!("dataPack.{id}.name");
+            let title = if crate::lang::has(&name) {
+                Text::translate(&name, &[])
+            } else {
+                Text::literal(id.clone())
+            };
+            Flag {
+                enabled: enabled.contains(&id),
+                description: Text::translate(&format!("dataPack.{id}.description"), &[]),
+                id,
+                title,
+            }
+        })
+        .collect()
+}
diff --git a/crates/horizon-client-ui/src/toast_slide.rs b/crates/horizon-client-ui/src/toast_slide.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f8559111e1e4a412dbefa85dc349808cb085a3a0
--- /dev/null
+++ b/crates/horizon-client-ui/src/toast_slide.rs
@@ -0,0 +1,188 @@
+//! Horizon toast visibility and slide timing.
+use crate::hud::{HudAtlas, HudBatch};
+use std::time::Instant;
+
+/// `ToastManager.ToastInstance`: slides a toast in and out over 600 ms,
+/// eased by the square, and counts how long it has been fully shown.
+#[derive(Default)]
+pub struct Slide {
+    /// When it first updated; the times below are milliseconds since.
+    pub origin: Option<Instant>,
+    begun: bool,
+    /// `animationStartTime`.
+    start: i64,
+    /// `becameFullyVisibleAt`.
+    fully_at: i64,
+    show: bool,
+    /// `visiblePortion`: 0 off screen, 1 fully in.
+    pub portion: f32,
+    /// `fullyVisibleFor`.
+    pub fully_for: i64,
+}
+impl Slide {
+    pub const MS: i64 = 600;
+    /// `ToastInstance.update` at `now`; `wants_show` is the toast's own
+    /// update. The visibility it switched to (the sound to play), and whether
+    /// it has finished sliding out.
+    pub fn update(
+        &mut self,
+        now: i64,
+        wants_show: impl FnOnce(i64) -> bool,
+    ) -> (Option<bool>, bool) {
+        let was = self.show;
+        if !self.begun {
+            self.begun = true;
+            self.start = now;
+            self.show = true;
+        }
+        if self.show && now - self.start <= Self::MS {
+            self.fully_at = now;
+        }
+        self.fully_for = now - self.fully_at;
+        let progress = ((now - self.start) as f32 / Self::MS as f32).clamp(0.0, 1.0);
+        let progress = progress * progress;
+        self.portion = if self.show { progress } else { 1.0 - progress };
+        let wanted = wants_show(self.fully_for);
+        if wanted != self.show {
+            self.start = now - ((1.0 - self.portion) * Self::MS as f32) as i64;
+            self.show = wanted;
+        }
+        let finished = !self.show && now - self.start > Self::MS;
+        ((self.show != was).then_some(self.show), finished)
+    }
+    /// `update` at the time since the first one.
+    pub fn update_now(&mut self, wants_show: impl FnOnce(i64) -> bool) -> (Option<bool>, bool) {
+        let origin = *self.origin.get_or_insert_with(Instant::now);
+        self.update(origin.elapsed().as_millis() as i64, wants_show)
+    }
+}
+
+/// `SystemToast`: a yellow title over a white message (or the title alone,
+/// lower down) on the system background. It stays until its display time
+/// has passed since its last change, or until it is hidden.
+pub struct SystemToast {
+    pub slide: Slide,
+    /// `ToastInstance.firstSlotIndex`: its 32-pixel slot once shown.
+    pub slot: Option<usize>,
+    title: String,
+    message: Option<String>,
+    /// `changed`: the next update takes its time as `lastChanged`.
+    changed: bool,
+    last_changed: i64,
+    force_hide: bool,
+    /// `SystemToastId.displayTime`, in milliseconds.
+    display_time: f64,
+    /// The title's colour (`ChatFormatting.YELLOW` unless the text is styled).
+    title_color: u32,
+}
+impl SystemToast {
+    /// `SystemToastId.displayTime`'s default, in milliseconds.
+    const DISPLAY_TIME: f64 = 5000.0;
+    /// `SystemToastId.LOW_DISK_SPACE`'s and `UNSECURE_SERVER_WARNING`'s display time.
+    pub const LONG_DISPLAY_TIME: f64 = 10000.0;
+    pub fn new(title: String, message: Option<String>) -> Self {
+        Self {
+            slide: Slide::default(),
+            slot: None,
+            title,
+            message,
+            changed: false,
+            last_changed: 0,
+            force_hide: false,
+            display_time: Self::DISPLAY_TIME,
+            title_color: crate::hud::rgba(255, 255, 0, 255),
+        }
+    }
+    /// A toast of an id with its own display time (`new SystemToastId(displayTime)`).
+    pub fn with_display_time(mut self, ms: f64) -> Self {
+        self.display_time = ms;
+        self
+    }
+    /// A title with its own colour (`Component.withStyle(ChatFormatting.RED)`).
+    pub fn with_title_color(mut self, color: u32) -> Self {
+        self.title_color = color;
+        self
+    }
+    /// `reset`: new text, and the display time starts again.
+    pub fn reset(&mut self, title: String, message: Option<String>) {
+        self.title = title;
+        self.message = message;
+        self.changed = true;
+    }
+    pub fn display_time(&self) -> f64 {
+        self.display_time
+    }
+    /// `addOrUpdate` on a toast that is still shown: `reset` to `other`'s text.
+    pub fn reset_from(&mut self, other: SystemToast) {
+        self.title_color = other.title_color;
+        self.reset(other.title, other.message);
+    }
+    pub fn force_hide(&mut self) {
+        self.force_hide = true;
+    }
+    /// `ToastInstance.update` with `SystemToast.update`, the display time
+    /// scaled by the Notification Time option: the visibility it switched
+    /// to (the sound to play), and whether it has slid out.
+    pub fn update(&mut self, multiplier: f64) -> (Option<bool>, bool) {
+        self.slide.update_now(|fully| {
+            if std::mem::take(&mut self.changed) {
+                self.last_changed = fully;
+            }
+            !self.force_hide
+                && ((fully - self.last_changed) as f64) < self.display_time * multiplier
+        })
+    }
+    /// `extractRenderState` at `y`, in from the right edge by the visible
+    /// portion (`Toast.xPos`).
+    pub fn draw(&self, atlas: &HudAtlas, batch: &mut HudBatch, y: f32) {
+        let width = std::iter::once(&self.title)
+            .chain(&self.message)
+            .map(|line| HudBatch::text_width(atlas, line))
+            .fold(0.0, f32::max)
+            .ceil()
+            .max(160.0)
+            + 30.0;
+        let x = batch.width - width * self.slide.portion;
+        background(atlas, batch, x, y, width);
+        let yellow = self.title_color;
+        match &self.message {
+            Some(message) => {
+                batch.text(atlas, &self.title, x + 18.0, y + 7.0, yellow, false);
+                batch.text(atlas, message, x + 18.0, y + 19.0, u32::MAX, false);
+            }
+            None => {
+                batch.text(atlas, &self.title, x + 18.0, y + 12.0, yellow, false);
+            }
+        }
+    }
+}
+/// SystemToast's 32-pixel background keeps the notice icon and borders intact.
+pub fn background(atlas: &HudAtlas, batch: &mut HudBatch, x: f32, y: f32, width: f32) {
+    let Some(rect) = atlas.sprites.get("gui/sprites/toast/system").copied() else {
+        return;
+    };
+    let source_x = [0.0, 17.0, rect.w as f32 - 4.0, rect.w as f32];
+    let target_x = [x, x + 17.0, x + width - 4.0, x + width];
+    for col in 0..3 {
+        for (sy, sh, y, h) in [
+            (0.0, 28.0, y, 28.0),
+            (rect.h as f32 - 4.0, 4.0, y + 28.0, 4.0),
+        ] {
+            let mut piece = rect;
+            let du = (rect.u1 - rect.u0) / rect.w as f32;
+            let dv = (rect.v1 - rect.v0) / rect.h as f32;
+            piece.u0 = rect.u0 + source_x[col] * du;
+            piece.u1 = rect.u0 + source_x[col + 1] * du;
+            piece.v0 = rect.v0 + sy * dv;
+            piece.v1 = rect.v0 + (sy + sh) * dv;
+            batch.rect_uv(
+                target_x[col],
+                y,
+                target_x[col + 1] - target_x[col],
+                h,
+                piece,
+                u32::MAX,
+            );
+        }
+    }
+}
diff --git a/crates/horizon-client-ui/src/ui.rs b/crates/horizon-client-ui/src/ui.rs
new file mode 100644
index 0000000000000000000000000000000000000000..39086210460cde09e5604b0e1cf4b4c33ab96d91
--- /dev/null
+++ b/crates/horizon-client-ui/src/ui.rs
@@ -0,0 +1,2421 @@
+//! Shared GUI widgets drawn as HUD quads: nine-slice sprites (gui.scaling
+//! metadata), buttons, sliders, tiled menu backgrounds, separators and the
+//! EditBox text field with vanilla cursor, selection and scrolling.
+use crate::{
+    hud::{HudAtlas, HudBatch, Rect, rgba},
+    text::Text,
+};
+use std::{
+    collections::HashMap,
+    path::{Path, PathBuf},
+    sync::RwLock,
+    time::Instant,
+};
+
+/// `GuiSpriteScaling.NineSlice`: the sprite's size in GUI pixels, whatever
+/// its texture's resolution, its borders (left, top, right, bottom) in the
+/// same units, and whether the edges and centre stretch rather than tile.
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct NineSlice {
+    width: u32,
+    height: u32,
+    border: [u32; 4],
+    stretch_inner: bool,
+}
+/// Nine-slice scaling from `.png.mcmeta` files.
+static NINE_SLICE: RwLock<Option<HashMap<String, NineSlice>>> = RwLock::new(None);
+
+/// A `gui.scaling` section of type `nine_slice`.
+fn parse_nine_slice(v: &serde_json::Value) -> Option<NineSlice> {
+    let s = &v["gui"]["scaling"];
+    if s["type"] != "nine_slice" {
+        return None;
+    }
+    let size = |k: &str| s[k].as_u64().map(|n| n as u32);
+    let border = &s["border"];
+    let border = if let Some(n) = border.as_u64() {
+        [n as u32; 4]
+    } else {
+        let g = |k: &str| border[k].as_u64().unwrap_or(0) as u32;
+        [g("left"), g("top"), g("right"), g("bottom")]
+    };
+    let (width, height) = (size("width")?, size("height")?);
+    // `NineSlice.validate`: borders that meet leave no centre slice, so the
+    // sprite has no nine-slice metadata (vanilla draws it as a stretch).
+    let [l, t, r, b] = border;
+    if l.saturating_add(r) >= width || t.saturating_add(b) >= height {
+        return None;
+    }
+    Some(NineSlice {
+        width,
+        height,
+        border,
+        stretch_inner: s["stretch_inner"].as_bool().unwrap_or(false),
+    })
+}
+/// Read `gui.scaling` metadata for every GUI sprite under `root`.
+pub fn load_metadata(root: &Path) {
+    set_metadata(read_metadata(root));
+}
+/// The GUI sprites' nine-slice metadata of a resource root, read off the
+/// render thread by a pack reload ([`read_metadata`]) and put in use with
+/// [`set_metadata`].
+pub struct UiMetadata(HashMap<String, NineSlice>);
+/// Puts read metadata in use ([`load_metadata`] in two halves).
+pub fn set_metadata(metadata: UiMetadata) {
+    *NINE_SLICE.write().unwrap_or_else(|e| e.into_inner()) = Some(metadata.0);
+}
+/// Reads the metadata [`load_metadata`] puts in use, without putting it in use.
+pub fn read_metadata(root: &Path) -> UiMetadata {
+    let mut map = HashMap::new();
+    let base = root.join("assets/minecraft/textures");
+    let sprites = base.join("gui/sprites");
+    // A prepared root's: from its data file, without listing the disk.
+    let files: Vec<PathBuf> = match horizon_core::prepared_files::files_under(&sprites) {
+        Some(files) => files
+            .iter()
+            .filter(|file| file.ends_with(".png.mcmeta"))
+            .map(|file| sprites.join(file))
+            .collect(),
+        None => {
+            let mut files = Vec::new();
+            let mut stack = vec![sprites];
+            while let Some(dir) = stack.pop() {
+                let Ok(entries) = std::fs::read_dir(&dir) else {
+                    continue;
+                };
+                for e in entries.flatten() {
+                    let p = e.path();
+                    if p.is_dir() {
+                        stack.push(p);
+                    } else if p.to_string_lossy().ends_with(".png.mcmeta") {
+                        files.push(p);
+                    }
+                }
+            }
+            files
+        }
+    };
+    for p in files {
+        let name = p.to_string_lossy().into_owned();
+        let Some(stripped) = name.strip_suffix(".png.mcmeta") else {
+            continue;
+        };
+        let Ok(text) = horizon_core::prepared_files::read_to_string(&p) else {
+            continue;
+        };
+        let Some(nine_slice) = serde_json::from_str(&text)
+            .ok()
+            .as_ref()
+            .and_then(parse_nine_slice)
+        else {
+            continue;
+        };
+        #[cfg(target_os = "cafe")]
+        let key = horizon_client_platform::path::resource_png_name(
+            Path::new(&format!("{stripped}.png")),
+            &base,
+        )
+        .unwrap_or_default();
+        #[cfg(not(target_os = "cafe"))]
+        let key = Path::new(stripped)
+            .strip_prefix(&base)
+            .map(|r| r.to_string_lossy().replace('\\', "/"))
+            .unwrap_or_default();
+        map.insert(key, nine_slice);
+    }
+    UiMetadata(map)
+}
+/// The sprite's nine-slice metadata, when its `.png.mcmeta` has any.
+fn nine_slice_metadata(sprite: &str) -> Option<NineSlice> {
+    NINE_SLICE
+        .read()
+        .unwrap_or_else(|e| e.into_inner())
+        .as_ref()
+        .and_then(|m| m.get(sprite).copied())
+}
+/// The sprite's nine-slice metadata; without any (no resources loaded), its
+/// GUI size and the widgets' usual borders.
+fn scaling(sprite: &str, r: &Rect) -> NineSlice {
+    nine_slice_metadata(sprite).unwrap_or(NineSlice {
+        width: r.w,
+        height: r.h,
+        border: match sprite {
+            "gui/sprites/widget/button"
+            | "gui/sprites/widget/button_highlighted"
+            | "gui/sprites/widget/button_disabled" => [3; 4],
+            "gui/sprites/widget/slider_handle" | "gui/sprites/widget/slider_handle_highlighted" => {
+                [2, 2, 2, 3]
+            }
+            _ => [1; 4],
+        },
+        stretch_inner: false,
+    })
+}
+/// The region `[x, y, w, h]` of a sprite `size` GUI pixels large, in its
+/// own units (`TextureAtlasSprite.getU(x / width)`).
+fn sub(r: Rect, size: [f32; 2], [x, y, w, h]: [f32; 4]) -> Rect {
+    let (du, dv) = ((r.u1 - r.u0) / size[0], (r.v1 - r.v0) / size[1]);
+    Rect {
+        u0: r.u0 + x * du,
+        v0: r.v0 + y * dv,
+        u1: r.u0 + (x + w) * du,
+        v1: r.v0 + (y + h) * dv,
+        w: w as u32,
+        h: h as u32,
+    }
+}
+/// `blitTiledSprite`: `src` (a region of a sprite `size` large, in its
+/// units) repeated over `dst` from its top left, the last row and column cut.
+fn tile(batch: &mut HudBatch, r: Rect, size: [f32; 2], src: [f32; 4], dst: [f32; 4], color: u32) {
+    let [sx, sy, sw, sh] = src;
+    let [dx, dy, dw, dh] = dst;
+    if sw <= 0.0 || sh <= 0.0 || dw <= 0.0 || dh <= 0.0 {
+        return;
+    }
+    let mut y = 0.0;
+    while y < dh {
+        let h = sh.min(dh - y);
+        let mut x = 0.0;
+        while x < dw {
+            let w = sw.min(dw - x);
+            batch.rect_uv(dx + x, dy + y, w, h, sub(r, size, [sx, sy, w, h]), color);
+            x += sw;
+        }
+        y += sh;
+    }
+}
+/// `GuiGraphicsExtractor.blitNineSlicedSprite`: the corners at their size,
+/// the edges and centre tiled (or stretched with `stretch_inner`), all in
+/// the sprite's `gui.scaling` units, so a high-resolution pack's sprite draws
+/// as the default one does.
+pub fn nine_slice(
+    batch: &mut HudBatch,
+    atlas: &HudAtlas,
+    sprite: &str,
+    x: f32,
+    y: f32,
+    w: f32,
+    h: f32,
+    color: u32,
+) {
+    if let Some(r) = atlas.sprites.get(sprite) {
+        draw_nine_slice(batch, *r, scaling(sprite, r), [x, y, w, h], color);
+    }
+}
+/// `GuiGraphicsExtractor.blitSprite`: a sprite over `w` × `h` as its
+/// `gui.scaling` says, nine-sliced, or stretched when it has no metadata.
+/// (`tile`, which no vanilla sprite uses, isn't read yet: it stretches.)
+pub fn blit_sprite(
+    batch: &mut HudBatch,
+    atlas: &HudAtlas,
+    sprite: &str,
+    x: f32,
+    y: f32,
+    w: f32,
+    h: f32,
+    color: u32,
+) {
+    if let Some(r) = atlas.sprites.get(sprite) {
+        draw_sprite(batch, *r, nine_slice_metadata(sprite), [x, y, w, h], color);
+    }
+}
+fn draw_sprite(
+    batch: &mut HudBatch,
+    r: Rect,
+    nine_slice: Option<NineSlice>,
+    [x, y, w, h]: [f32; 4],
+    color: u32,
+) {
+    match nine_slice {
+        Some(n) => draw_nine_slice(batch, r, n, [x, y, w, h], color),
+        None => batch.rect_uv(x, y, w, h, r, color),
+    }
+}
+fn draw_nine_slice(
+    batch: &mut HudBatch,
+    r: Rect,
+    n: NineSlice,
+    [x, y, w, h]: [f32; 4],
+    color: u32,
+) {
+    let size = [n.width as f32, n.height as f32];
+    let [sw, sh] = size;
+    let [l, t, rr, b] = n.border.map(|v| v as f32);
+    let (half_w, half_h) = ((w / 2.0).floor(), (h / 2.0).floor());
+    let (l, rr, t, b) = (l.min(half_w), rr.min(half_w), t.min(half_h), b.min(half_h));
+    // blitSprite(sprite, width, height, textureX, textureY, x, y, w, h).
+    let part = |batch: &mut HudBatch, tx: f32, ty: f32, dst: [f32; 4]| {
+        if dst[2] != 0.0 && dst[3] != 0.0 {
+            batch.rect_uv(
+                dst[0],
+                dst[1],
+                dst[2],
+                dst[3],
+                sub(r, size, [tx, ty, dst[2], dst[3]]),
+                color,
+            );
+        }
+    };
+    // blitNineSliceInnerSegment.
+    let inner = |batch: &mut HudBatch, dst: [f32; 4], src: [f32; 4]| {
+        if dst[2] <= 0.0 || dst[3] <= 0.0 {
+            return;
+        }
+        if n.stretch_inner {
+            batch.rect_uv(dst[0], dst[1], dst[2], dst[3], sub(r, size, src), color);
+        } else {
+            tile(batch, r, size, src, dst, color);
+        }
+    };
+    if w == sw && h == sh {
+        part(batch, 0.0, 0.0, [x, y, w, h]);
+        return;
+    }
+    if h == sh {
+        part(batch, 0.0, 0.0, [x, y, l, h]);
+        inner(batch, [x + l, y, w - rr - l, h], [l, 0.0, sw - rr - l, sh]);
+        part(batch, sw - rr, 0.0, [x + w - rr, y, rr, h]);
+        return;
+    }
+    if w == sw {
+        part(batch, 0.0, 0.0, [x, y, w, t]);
+        inner(batch, [x, y + t, w, h - b - t], [0.0, t, sw, sh - b - t]);
+        part(batch, 0.0, sh - b, [x, y + h - b, w, b]);
+        return;
+    }
+    let (cw, ch) = (w - rr - l, h - b - t);
+    let (scw, sch) = (sw - rr - l, sh - b - t);
+    part(batch, 0.0, 0.0, [x, y, l, t]);
+    inner(batch, [x + l, y, cw, t], [l, 0.0, scw, t]);
+    part(batch, sw - rr, 0.0, [x + w - rr, y, rr, t]);
+    part(batch, 0.0, sh - b, [x, y + h - b, l, b]);
+    inner(batch, [x + l, y + h - b, cw, b], [l, sh - b, scw, b]);
+    part(batch, sw - rr, sh - b, [x + w - rr, y + h - b, rr, b]);
+    inner(batch, [x, y + t, l, ch], [0.0, t, l, sch]);
+    inner(batch, [x + l, y + t, cw, ch], [l, t, scw, sch]);
+    inner(batch, [x + w - rr, y + t, rr, ch], [sw - rr, t, rr, sch]);
+}
+/// Repeat a whole texture with each copy drawn `size` GUI pixels square.
+pub fn tiled(
+    batch: &mut HudBatch,
+    atlas: &HudAtlas,
+    sprite: &str,
+    x: f32,
+    y: f32,
+    w: f32,
+    h: f32,
+    size: f32,
+    color: u32,
