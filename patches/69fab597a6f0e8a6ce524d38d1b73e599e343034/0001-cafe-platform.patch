+    /// Keys and their arguments as they are, so the tests read what the
+    /// narration is made of without a language loaded.
+    fn keys(key: &str, args: &[&str]) -> String {
+        if args.is_empty() {
+            key.to_owned()
+        } else {
+            format!("{key}({})", args.join(", "))
