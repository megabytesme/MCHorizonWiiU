-/// Text drawn at `scale` times its size (a scaled pose).
-pub fn text_scaled(
-    batch: &mut HudBatch,
-    atlas: &HudAtlas,
-    text: &Text,
-    x: f32,
-    y: f32,
-    scale: f32,
-    color: u32,
-) {
-    let start = batch.vertices.len();
-    batch.text_styled(atlas, text, 0.0, 0.0, color, true);
-    for v in &mut batch.vertices[start..] {
-        v.pos = [x + v.pos[0] * scale, y + v.pos[1] * scale];
-    }
-}
