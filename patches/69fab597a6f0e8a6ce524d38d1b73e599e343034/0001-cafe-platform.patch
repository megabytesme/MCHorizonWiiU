-        v
-    };
-    let mut out = Vec::with_capacity(poly.len() + 2);
-    for i in 0..poly.len() {
-        let (a, b) = (&poly[i], &poly[(i + 1) % poly.len()]);
-        let (ia, ib) = (inside(a), inside(b));
