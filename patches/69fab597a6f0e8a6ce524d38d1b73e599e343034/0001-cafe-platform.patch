@@ -0,0 +1,474 @@
+//! `MipmapGenerator`: the mip levels of a sprite. Cutout textures keep the
+//! alpha-test coverage of their base level at every level
+//! (`scaleAlphaToCoverage`), so thin cutout edges (cactus sides, leaves,
+//! flowers) don't erode into gaps with distance; colours average in linear
+//! light (`ARGB.meanLinear`).
+
+/// `MipmapStrategy`, from the texture's `.mcmeta` `texture` section.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Strategy {
+    #[default]
+    Auto,
+    Mean,
+    Cutout,
+    StrictCutout,
+    DarkCutout,
+}
+impl Strategy {
+    pub fn parse(name: &str) -> Option<Self> {
+        Some(match name {
+            "auto" => Self::Auto,
+            "mean" => Self::Mean,
+            "cutout" => Self::Cutout,
+            "strict_cutout" => Self::StrictCutout,
+            "dark_cutout" => Self::DarkCutout,
+            _ => return None,
+        })
+    }
+}
+
+/// How a sprite's mips are made: its `.mcmeta` `texture` section, whether
+/// it has a fully transparent pixel and whether it is an `item/` sprite.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Settings {
+    /// Original square frame edge, before fitting the sprite into the array.
+    /// Zero means the supplied image is already at its native size.
+    pub native_size: u32,
+    pub strategy: Strategy,
+    pub alpha_cutoff_bias: f32,
+    pub has_transparent: bool,
+    pub item: bool,
+    /// Whether a high-resolution cutout's small levels are dithered ([`dither_cutout_levels`]).
+    pub dither_cutouts: bool,
+}
+
+/// The `ditherCutoutMips` setting, for textures loaded from now on.
+static DITHER_CUTOUTS: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Sets `ditherCutoutMips`; true if that changes it, when the textures must load again.
+pub fn set_dither_cutouts(on: bool) -> bool {
+    DITHER_CUTOUTS.swap(on, std::sync::atomic::Ordering::Relaxed) != on
+}
+
+/// The `ditherCutoutMips` setting.
+pub fn dither_cutouts() -> bool {
+    DITHER_CUTOUTS.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// A square or rectangular RGBA8 image, rows top to bottom.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Image {
+    pub width: u32,
+    pub height: u32,
+    pub pixels: Vec<[u8; 4]>,
+}
+impl Image {
+    fn resized(&self, size: u32) -> Self {
+        Self {
+            width: size,
+            height: size,
+            pixels: (0..size * size)
+                .map(|i| self.get(i % size * self.width / size, i / size * self.height / size))
+                .collect(),
+        }
+    }
+    fn get(&self, x: u32, y: u32) -> [u8; 4] {
+        self.pixels[(x + y * self.width) as usize]
+    }
+    fn set(&mut self, x: u32, y: u32, p: [u8; 4]) {
+        self.pixels[(x + y * self.width) as usize] = p;
+    }
+}
+
+/// `ARGB.SRGB_TO_LINEAR`: an sRGB channel in linear light, 0 to 1023.
+fn srgb_to_linear() -> &'static [u16; 256] {
+    static TABLE: std::sync::OnceLock<[u16; 256]> = std::sync::OnceLock::new();
+    TABLE.get_or_init(|| {
+        std::array::from_fn(|i| {
+            let x = i as f32 / 255.0;
+            let linear = if x >= 0.04045 {
+                ((f64::from(x) + 0.055) / 1.055).powf(2.4) as f32
+            } else {
+                x / 12.92
+            };
+            horizon_core::jmath::round_f32(linear * 1023.0) as u16
+        })
+    })
+}
+/// `ARGB.LINEAR_TO_SRGB`: 1024 linear steps back to sRGB.
+fn linear_to_srgb() -> &'static [u8; 1024] {
+    static TABLE: std::sync::OnceLock<[u8; 1024]> = std::sync::OnceLock::new();
+    TABLE.get_or_init(|| {
+        std::array::from_fn(|i| {
+            let x = i as f32 / 1023.0;
+            let srgb = if x >= 0.003_130_8 {
+                (1.055 * f64::from(x).powf(0.416_666_666_666_666_7) - 0.055) as f32
+            } else {
+                12.92 * x
+            };
+            horizon_core::jmath::round_f32(srgb * 255.0) as u8
+        })
+    })
+}
+/// `ARGB.alphaFloat`.
+fn alpha_float(p: [u8; 4]) -> f32 {
+    f32::from(p[3]) / 255.0
+}
+
+/// `MipmapGenerator.alphaTestCoverage`: the share of the image (bilinearly
+/// subsampled 4x4 per texel) whose scaled alpha passes `alpha_ref`.
+fn alpha_test_coverage(image: &Image, alpha_ref: f32, alpha_scale: f32) -> f32 {
+    let (width, height) = (image.width as i32, image.height as i32);
+    let mut coverage = 0.0f32;
+    let a =
+        |x: i32, y: i32| (alpha_float(image.get(x as u32, y as u32)) * alpha_scale).clamp(0.0, 1.0);
+    for y in 0..height - 1 {
+        for x in 0..width - 1 {
+            let (a00, a10, a01, a11) = (a(x, y), a(x + 1, y), a(x, y + 1), a(x + 1, y + 1));
+            let mut texel = 0.0f32;
+            for sy in 0..4 {
+                let fy = (sy as f32 + 0.5) / 4.0;
+                for sx in 0..4 {
+                    let fx = (sx as f32 + 0.5) / 4.0;
+                    let alpha = a00 * (1.0 - fx) * (1.0 - fy)
+                        + a10 * fx * (1.0 - fy)
+                        + a01 * (1.0 - fx) * fy
+                        + a11 * fx * fy;
+                    if alpha > alpha_ref {
+                        texel += 1.0;
+                    }
+                }
+            }
+            coverage += texel / 16.0;
+        }
+    }
+    coverage / ((width - 1) * (height - 1)) as f32
+}
+
+/// `MipmapGenerator.scaleAlphaToCoverage`: five bisection steps for the
+/// alpha scale whose coverage is nearest `desired`, then every alpha scaled
+/// and biased.
+fn scale_alpha_to_coverage(image: &mut Image, desired: f32, alpha_ref: f32, bias: f32) {
+    let (mut min_scale, mut max_scale) = (0.0f32, 4.0f32);
+    let mut scale = 1.0f32;
+    let mut best_scale = 1.0f32;
+    let mut best_error = f32::MAX;
+    for _ in 0..5 {
+        let current = alpha_test_coverage(image, alpha_ref, scale);
+        let error = (current - desired).abs();
+        if error < best_error {
+            best_error = error;
+            best_scale = scale;
+        }
+        if current < desired {
+            min_scale = scale;
+        } else if current > desired {
+            max_scale = scale;
+        } else {
+            break;
+        }
+        scale = (min_scale + max_scale) * 0.5;
+    }
+    for p in &mut image.pixels {
+        let alpha = (alpha_float(*p) * best_scale + bias + 0.025).clamp(0.0, 1.0);
+        p[3] = (alpha * 255.0).floor() as u8;
+    }
+}
+
+/// `TextureUtil.solidify`: every transparent pixel takes the colour of the
+/// nearest opaque one (breadth first, keeping its zero alpha).
+fn solidify(image: &mut Image) {
+    let (width, height) = (image.width as i32, image.height as i32);
+    let n = image.pixels.len();
+    let mut nearest = vec![[0u8; 4]; n];
+    let mut distance = vec![i32::MAX; n];
+    let mut queue = std::collections::VecDeque::new();
+    for x in 0..width {
+        for y in 0..height {
+            let i = (x + y * width) as usize;
+            let p = image.pixels[i];
+            if p[3] != 0 {
+                distance[i] = 0;
+                nearest[i] = p;
+                queue.push_back(i);
+            }
+        }
+    }
+    while let Some(i) = queue.pop_front() {
+        let (x, y) = (i as i32 % width, i as i32 / width);
+        for (dx, dy) in [(1, 0), (-1, 0), (0, 1), (0, -1)] {
+            let (nx, ny) = (x + dx, y + dy);
+            if nx >= 0 && ny >= 0 && nx < width && ny < height {
+                let j = (nx + ny * width) as usize;
+                if distance[j] > distance[i] + 1 {
+                    distance[j] = distance[i] + 1;
+                    nearest[j] = nearest[i];
+                    queue.push_back(j);
+                }
+            }
+        }
+    }
+    for (i, p) in image.pixels.iter_mut().enumerate() {
+        if p[3] == 0 {
+            let c = nearest[i];
+            *p = [c[0], c[1], c[2], 0];
+        }
+    }
+}
+
+/// `TextureUtil.fillEmptyAreasWithDarkColor`: transparent pixels take three
+/// quarters of the darkest visible colour.
+fn fill_empty_dark(image: &mut Image) {
+    let mut darkest = [255u8; 4];
+    let mut min = i32::MAX;
+    for x in 0..image.width {
+        for y in 0..image.height {
+            let p = image.get(x, y);
+            if p[3] != 0 {
+                let brightness = i32::from(p[0]) + i32::from(p[1]) + i32::from(p[2]);
+                if brightness < min {
+                    min = brightness;
+                    darkest = p;
+                }
+            }
+        }
+    }
+    let dark = |c: u8| (3 * i32::from(c) / 4) as u8;
+    let fill = [dark(darkest[0]), dark(darkest[1]), dark(darkest[2]), 0];
+    for p in &mut image.pixels {
+        if p[3] == 0 {
+            *p = fill;
+        }
+    }
+}
+
+/// `ARGB.meanLinear`.
+fn mean_linear(c: [[u8; 4]; 4]) -> [u8; 4] {
+    let (to_linear, to_srgb) = (srgb_to_linear(), linear_to_srgb());
+    let channel = |k: usize| {
+        let sum: u32 = c.iter().map(|p| u32::from(to_linear[p[k] as usize])).sum();
+        to_srgb[(sum / 4) as usize]
+    };
+    let alpha = c.iter().map(|p| u32::from(p[3])).sum::<u32>() / 4;
+    [channel(0), channel(1), channel(2), alpha as u8]
+}
+
+/// `MipmapGenerator.darkenedAlphaBlend`: the visible pixels' mean in linear
+/// light, transparent ones counting as black.
+fn darkened_alpha_blend(c: [[u8; 4]; 4]) -> [u8; 4] {
+    let to_linear = srgb_to_linear();
+    let linear = |v: u8| f32::from(to_linear[v as usize]) / 1023.0;
+    let mut total = [0.0f32; 4];
+    for p in c.iter().filter(|p| p[3] != 0) {
+        total[3] += linear(p[3]);
+        for k in 0..3 {
+            total[k] += linear(p[k]);
+        }
+    }
+    let to_srgb = |v: f32| linear_to_srgb()[(v / 4.0 * 1023.0).floor() as usize];
+    [
+        to_srgb(total[0]),
+        to_srgb(total[1]),
+        to_srgb(total[2]),
+        to_srgb(total[3]),
+    ]
+}
+
+/// `MipmapGenerator.generateMipLevels` from the base image (`levels` mips
+/// below it). Array-only enlargement must not run extra alpha-coverage steps
+/// before the sprite's native mip chain.
+pub fn generate(base: Image, levels: u32, settings: Settings) -> Vec<Image> {
+    let native = settings.native_size;
+    if native.is_power_of_two()
+        && native < base.width
+        && base.width == base.height
+        && base.width.is_power_of_two()
+    {
+        let extra = (base.width / native).ilog2();
+        let mut mips =
+            generate_native(base.resized(native), levels.saturating_sub(extra), settings);
+        let mut out: Vec<_> = (0..extra.min(levels + 1))
+            .map(|level| mips[0].resized(base.width >> level))
+            .collect();
+        if levels >= extra {
+            out.append(&mut mips);
+        }
+        return out;
+    }
+    generate_native(base, levels, settings)
+}
+
+fn generate_native(mut base: Image, levels: u32, settings: Settings) -> Vec<Image> {
+    let Settings {
+        strategy,
+        alpha_cutoff_bias,
+        has_transparent,
+        item,
+        ..
+    } = settings;
+    let strategy = match strategy {
+        Strategy::Auto if has_transparent => Strategy::Cutout,
+        Strategy::Auto => Strategy::Mean,
+        s => s,
+    };
+    if !item {
+        match strategy {
+            Strategy::Cutout | Strategy::StrictCutout => solidify(&mut base),
+            Strategy::DarkCutout => fill_empty_dark(&mut base),
+            _ => {}
+        }
+    }
+    let cutout = matches!(
+        strategy,
+        Strategy::Cutout | Strategy::StrictCutout | Strategy::DarkCutout
+    );
+    let alpha_ref = if strategy == Strategy::StrictCutout {
+        0.3
+    } else {
+        0.5
+    };
+    let coverage = if cutout {
+        alpha_test_coverage(&base, alpha_ref, 1.0)
+    } else {
+        0.0
+    };
+    let mut out = vec![base];
+    for _ in 1..=levels {
+        let last = out.last().expect("the base level");
+        let (width, height) = (last.width >> 1, last.height >> 1);
+        let mut data = Image {
+            width,
+            height,
+            pixels: vec![[0; 4]; (width * height) as usize],
+        };
+        for x in 0..width {
+            for y in 0..height {
+                let c = [
+                    last.get(x * 2, y * 2),
+                    last.get(x * 2 + 1, y * 2),
+                    last.get(x * 2, y * 2 + 1),
+                    last.get(x * 2 + 1, y * 2 + 1),
+                ];
+                let p = if strategy == Strategy::DarkCutout {
+                    darkened_alpha_blend(c)
+                } else {
+                    mean_linear(c)
+                };
+                data.set(x, y, p);
+            }
+        }
+        if cutout {
+            scale_alpha_to_coverage(&mut data, coverage, alpha_ref, alpha_cutoff_bias);
+        }
+        out.push(data);
+    }
+    if settings.dither_cutouts && cutout && out[0].width >= DITHERED_CUTOUT_SIZE {
+        dither_cutout_levels(&mut out);
+    }
+    out
+}
+
+/// From this size a cutout texture's mips can be dithered ([`dither_cutout_levels`]).
+const DITHERED_CUTOUT_SIZE: u32 = 64;
+/// A high-resolution cutout's detail is finer than its small mips: grass blades a few
+/// texels wide at 2048 average to about the same alpha everywhere at 64, and no scale of
+/// that alpha can keep the coverage, so the alpha test passes the whole quad or none of it.
+/// Each level below the base takes the base's mean alpha through an ordered dither instead:
+/// its texels are in or out, about as many in as the base has.
+fn dither_cutout_levels(levels: &mut [Image]) {
+    const BAYER: [[f32; 4]; 4] = [
+        [0.0, 8.0, 2.0, 10.0],
+        [12.0, 4.0, 14.0, 6.0],
+        [3.0, 11.0, 1.0, 9.0],
+        [15.0, 7.0, 13.0, 5.0],
+    ];
+    let (mut w, mut h) = (levels[0].width as usize, levels[0].height as usize);
+    let mut alpha: Vec<f32> = levels[0]
+        .pixels
+        .iter()
+        .map(|p| f32::from(p[3]) / 255.0)
+        .collect();
+    for level in &mut levels[1..] {
+        let (nw, nh) = (level.width as usize, level.height as usize);
+        let mut next = vec![0.0; nw * nh];
+        for y in 0..nh {
+            for x in 0..nw {
+                let at = |dx: usize, dy: usize| {
+                    alpha[(y * 2 + dy).min(h - 1) * w + (x * 2 + dx).min(w - 1)]
+                };
+                let mean = (at(0, 0) + at(1, 0) + at(0, 1) + at(1, 1)) / 4.0;
+                next[y * nw + x] = mean;
+                let threshold = (BAYER[y % 4][x % 4] + 0.5) / 16.0;
+                level.pixels[y * nw + x][3] = if mean > threshold { 255 } else { 0 };
+            }
+        }
+        alpha = next;
+        (w, h) = (nw, nh);
+    }
+}
+
+#[cfg(test)]
+mod dither_tests {
+    use super::*;
+    #[test]
+    fn the_dither_only_runs_when_asked_for_and_from_its_size() {
+        let cutout = |side: u32| Image {
+            width: side,
+            height: side,
+            pixels: (0..side * side)
+                .map(|i| {
+                    [
+                        90,
+                        140,
+                        40,
+                        if (i % side).is_multiple_of(4) { 255 } else { 0 },
+                    ]
+                })
+                .collect(),
+        };
+        let settings = |dither_cutouts| Settings {
+            has_transparent: true,
+            dither_cutouts,
+            ..Settings::default()
+        };
+        assert_ne!(
+            generate(cutout(128), 4, settings(false)),
+            generate(cutout(128), 4, settings(true))
+        );
+        assert_eq!(
+            generate(cutout(32), 4, settings(false)),
+            generate(cutout(32), 4, settings(true))
+        );
+    }
+    #[test]
+    fn a_high_resolution_cutouts_fine_detail_keeps_its_coverage_in_small_mips() {
+        // Blades one texel wide, one column in four: too fine for the mips to hold.
+        let side = 128u32;
+        let pixels = (0..side * side)
+            .map(|i| {
+                [
+                    90,
+                    140,
+                    40,
+                    if (i % side).is_multiple_of(4) { 255 } else { 0 },
+                ]
+            })
+            .collect();
+        let base = Image {
+            width: side,
+            height: side,
+            pixels,
+        };
+        let settings = Settings {
+            has_transparent: true,
+            dither_cutouts: true,
+            ..Settings::default()
+        };
+        let mips = generate(base, 4, settings);
+        for level in &mips[3..] {
+            let passing = level.pixels.iter().filter(|p| p[3] >= 128).count() as f32;
+            let coverage = passing / level.pixels.len() as f32;
+            assert!((0.15..0.35).contains(&coverage), "{coverage}");
+        }
+    }
+}
diff --git a/crates/horizon-terrain-mesh/src/model_library.rs b/crates/horizon-terrain-mesh/src/model_library.rs
new file mode 100644
index 0000000000000000000000000000000000000000..da09f3d51a567c90bec5f6b87c803d174fbce467
--- /dev/null
+++ b/crates/horizon-terrain-mesh/src/model_library.rs
@@ -0,0 +1,424 @@
+//! Parsed resource models for one startup or resource-pack reload.
+use crate::Result;
+use horizon_assets::{
+    model::CuboidModel,
+    resolve::{AssetReader, ModelLibrary},
+};
+use std::{
+    collections::BTreeMap,
+    fs,
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+
+#[cfg(target_os = "cafe")]
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+macro_rules! cafe_model_stage {
+    ($($arg:tt)*) => {{
+        #[cfg(target_os = "cafe")]
+        log::info!($($arg)*);
+    }};
+}
+
+#[derive(Default)]
+pub struct ParsedModels {
+    models: BTreeMap<String, Arc<CuboidModel>>,
+    root: PathBuf,
+}
+/// Asset files under a content root, for models that name a file (obj).
+struct RootAssets(PathBuf);
+impl AssetReader for RootAssets {
+    fn read_text(&self, location: &str) -> Option<String> {
+        let (namespace, path) = location.split_once(':')?;
+        // Only a resource location's characters, and no `.`/`..` step: an
+        // .obj's `mtllib` names its .mtl as raw text, so it must not reach a
+        // file outside the content root (`../..:x` as a namespace would).
+        let valid = |c: u8| c.is_ascii_lowercase() || c.is_ascii_digit() || b"_.-".contains(&c);
+        if !namespace.bytes().all(valid)
+            || matches!(namespace, "" | "." | "..")
+            || !path.bytes().all(|c| valid(c) || c == b'/')
+            || path.split('/').any(|part| matches!(part, "" | "." | ".."))
+        {
+            return None;
+        }
+        horizon_core::prepared_files::read_to_string(
+            &self.0.join(format!("assets/{namespace}/{path}")),
+        )
+        .ok()
+    }
+}
+impl ParsedModels {
+    /// Every `models/**.json` of a namespace directory, by identifier.
+    pub fn load(root: &Path) -> Self {
+        cafe_model_stage!("Horizon model library: enumeration begin");
+        cafe_model_stage!("Horizon model library: assets namespace read_dir begin");
+        let namespaces = fs::read_dir(root.join("assets"));
+        cafe_model_stage!("Horizon model library: assets namespace read_dir returned");
+        let Ok(namespaces) = namespaces else {
+            cafe_model_stage!("Horizon model library: assets directory unavailable");
+            return Self {
+                root: root.to_owned(),
+                ..Self::default()
+            };
+        };
+        // Listed first, then read and parsed at once: a content pack has tens
+        // of thousands of models.
+        let mut files = Vec::new();
+        #[cfg(target_os = "cafe")]
+        let mut directories = 0usize;
+        #[cfg(target_os = "cafe")]
+        let mut first_namespace = true;
+        #[cfg(target_os = "cafe")]
+        let mut first_models_read_dir = true;
+        #[cfg(target_os = "cafe")]
+        let mut enumerated_entries = 0usize;
+        for ns in namespaces.flatten() {
+            #[cfg(target_os = "cafe")]
+            if first_namespace {
+                log::info!("Horizon model library: first assets namespace yielded");
+                first_namespace = false;
+            }
+            let namespace = ns.file_name().to_string_lossy().into_owned();
+            let base = ns.path().join("models");
+            let mut stack = vec![base.clone()];
+            while let Some(dir) = stack.pop() {
+                #[cfg(target_os = "cafe")]
+                {
+                    directories += 1;
+                    if directories % 128 == 0 {
+                        log::info!(
+                            "Horizon model library: enumerating directories={directories} files={}",
+                            files.len()
+                        );
+                    }
+                }
+                #[cfg(target_os = "cafe")]
+                if first_models_read_dir {
+                    log::info!("Horizon model library: first models read_dir begin");
+                }
+                let entries = fs::read_dir(&dir);
+                #[cfg(target_os = "cafe")]
+                if first_models_read_dir {
+                    if entries.is_ok() {
+                        log::info!("Horizon model library: first models read_dir complete");
+                    } else {
+                        log::info!("Horizon model library: first models read_dir failed");
+                    }
+                    first_models_read_dir = false;
+                }
+                let Ok(entries) = entries else {
+                    continue;
+                };
+                for e in entries.flatten() {
+                    #[cfg(target_os = "cafe")]
+                    {
+                        enumerated_entries += 1;
+                        if enumerated_entries == 1 {
+                            log::info!("Horizon model library: first models-tree entry yielded");
+                        }
+                        if enumerated_entries % 512 == 0 {
+                            log::info!(
+                                "Horizon model library: enumerated entries={enumerated_entries} files={}",
+                                files.len()
+                            );
+                        }
+                    }
+                    let path = e.path();
+                    // The entry's own type saves a stat per file; a link
+                    // (content roots link into the base) is followed.
+                    let is_dir = match e.file_type() {
+                        Ok(t) if !t.is_symlink() => t.is_dir(),
+                        _ => path.is_dir(),
+                    };
+                    if is_dir {
+                        stack.push(path);
+                    } else {
+                        #[cfg(target_os = "cafe")]
+                        let is_json = {
+                            // Cafe paths use `/` as their separator. Check the
+                            // last component directly; Path::extension stalls
+                            // here in the Cemu Cafe interpreter.
+                            let bytes = path.as_os_str().as_encoded_bytes();
+                            let file_name =
+                                bytes.rsplit(|byte| *byte == b'/').next().unwrap_or(&[]);
+                            match file_name.iter().rposition(|byte| *byte == b'.') {
+                                Some(dot) if dot > 0 => &file_name[dot + 1..] == b"json",
+                                _ => false,
+                            }
+                        };
+                        #[cfg(not(target_os = "cafe"))]
+                        let is_json = path.extension().is_some_and(|x| x == "json");
+                        if is_json {
+                            #[cfg(target_os = "cafe")]
+                            let rel = {
+                                // These paths are rooted at `base` and use
+                                // slash-separated child names on Cafe.
+                                let path = path.as_os_str().as_encoded_bytes();
+                                let base = base.as_os_str().as_encoded_bytes();
+                                path.strip_prefix(base)
+                                    .and_then(|relative| relative.strip_prefix(b"/"))
+                                    .and_then(|relative| relative.strip_suffix(b".json"))
+                                    .map(|relative| {
+                                        String::from_utf8_lossy(relative).replace('\\', "/")
+                                    })
+                            };
+                            #[cfg(not(target_os = "cafe"))]
+                            let rel = path.strip_prefix(&base).ok().map(|rel| {
+                                rel.with_extension("").to_string_lossy().replace('\\', "/")
+                            });
+                            if let Some(rel) = rel {
+                                files.push((format!("{namespace}:{rel}"), path));
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        #[cfg(target_os = "cafe")]
+        log::info!(
+            "Horizon model library: enumeration complete directories={directories} files={}",
+            files.len()
+        );
+        cafe_model_stage!("Horizon model library: parse begin files={}", files.len());
+        #[cfg(target_os = "cafe")]
+        let model_count = files.len();
+        #[cfg(target_os = "cafe")]
+        let completed = AtomicUsize::new(0);
+        let parsed = crate::par::par_map(&files, |(_, path)| {
+            let model = horizon_core::prepared_files::read_to_string(path)
+                .ok()
+                .and_then(|text| CuboidModel::from_json(&text).ok())
+                .map(Arc::new);
+            #[cfg(target_os = "cafe")]
+            {
+                let count = completed.fetch_add(1, Ordering::Relaxed) + 1;
+                if count % 512 == 0 || count == model_count {
+                    log::info!("Horizon model library: parsed {count}/{model_count} files");
+                }
+            }
+            model
+        });
+        #[cfg(target_os = "cafe")]
+        log::info!(
+            "Horizon model library: parse complete parsed={} files={model_count}",
+            parsed.iter().filter(|model| model.is_some()).count()
+        );
+        let models = files
+            .into_iter()
+            .zip(parsed)
+            .filter_map(|((id, _), model)| Some((id, model?)))
+            .collect();
+        Self {
+            models,
+            root: root.to_owned(),
+        }
+    }
+
+    /// Blocks require every referenced resource, including parents. Items instead
+    /// skip broken resources and use the resolver's missing-model fallback.
+    pub fn block_library(&self, root: &Path, pending: Vec<String>) -> Result<ModelLibrary> {
+        self.block_models(root, pending, false)
+    }
+    /// [`Self::block_library`], but a model that does not read takes the
+    /// built-in missing model, logged, as vanilla's model discovery does
+    /// ("Missing block model"). Mods' content gets this; vanilla's resources
+    /// always read.
+    pub fn block_library_or_missing(
+        &self,
+        root: &Path,
+        pending: Vec<String>,
+    ) -> Result<ModelLibrary> {
+        self.block_models(root, pending, true)
+    }
+    fn block_models(
+        &self,
+        root: &Path,
+        mut pending: Vec<String>,
+        or_missing: bool,
+    ) -> Result<ModelLibrary> {
+        let mut models = BTreeMap::new();
+        let mut skipped = std::collections::BTreeSet::new();
+        while let Some(name) = pending.pop() {
+            if models.contains_key(&name) || skipped.contains(&name) {
+                continue;
+            }
+            let model = match self.models.get(&name) {
+                Some(model) => Arc::clone(model),
+                None => {
+                    let read = || -> Result<CuboidModel> {
+                        let (namespace, path) =
+                            name.split_once(':').ok_or("invalid model identifier")?;
+                        let text = horizon_core::prepared_files::read_to_string(
+                            &root.join(format!("assets/{namespace}/models/{path}.json")),
+                        )?;
+                        Ok(CuboidModel::from_json(&text)?)
+                    };
+                    match read() {
+                        Ok(model) => Arc::new(model),
+                        Err(e) if or_missing => {
+                            log::warn!("Horizon: missing block model {name}: {e}");
+                            skipped.insert(name);
+                            continue;
+                        }
+                        Err(e) => return Err(e),
+                    }
+                }
+            };
+            pending.extend(model.referenced_models());
+            models.insert(name, model);
+        }
+        Ok(ModelLibrary::from_shared(models)?.with_assets(Arc::new(RootAssets(root.to_owned()))))
+    }
+    pub fn into_item_library(self) -> std::result::Result<Arc<ModelLibrary>, String> {
+        let root = self.root;
+        ModelLibrary::with_shared_item_generator(self.models)
+            .map(|library| Arc::new(library.with_assets(Arc::new(RootAssets(root)))))
+            .map_err(|e| format!("item models: {e:?}"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use horizon_assets::resolve::{GENERATED_MODEL, MISSING_MODEL};
+
+    struct Fixture(std::path::PathBuf);
+    impl Fixture {
+        fn write(&self, name: &str, json: &str) {
+            let (namespace, path) = name.split_once(':').unwrap();
+            let path = self
+                .0
+                .join(format!("assets/{namespace}/models/{path}.json"));
+            fs::create_dir_all(path.parent().unwrap()).unwrap();
+            fs::write(path, json).unwrap();
+        }
+    }
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    #[test]
+    fn shared_views_preserve_resolution_errors_builtins_and_reload() -> Result<()> {
+        let fixture = Fixture(
+            std::env::temp_dir().join(format!("horizon-shared-models-{}", std::process::id())),
+        );
+        fixture.write("horizon:parent", r##"{"textures":{"side":"#all","all":"block/stone"},"elements":[{"from":[0,0,0],"to":[16,8,16],"faces":{"up":{"texture":"#side"}}}]}"##);
+        fixture.write("horizon:nested/child", r#"{"parent":"horizon:parent","textures":{"all":"block/glass"},"display":{"gui":{"rotation":[30,45,0]}}}"#);
+        fixture.write("horizon:broken", "{");
+        fixture.write("horizon:dangling", r#"{"parent":"horizon:absent"}"#);
+        fixture.write("horizon:a", r#"{"parent":"horizon:b"}"#);
+        fixture.write("horizon:b", r#"{"parent":"horizon:a"}"#);
+        fixture.write(
+            GENERATED_MODEL,
+            r#"{"elements":[{"from":[0,0,0],"to":[1,1,1],"faces":{"up":{"texture":"particle"}}}],"gui_light":"side"}"#,
+        );
+        fixture.write(MISSING_MODEL, r#"{"elements":[]}"#);
+        let parsed = ParsedModels::load(&fixture.0);
+        let direct = ParsedModels::default();
+        let names = vec![
+            "horizon:nested/child".into(),
+            GENERATED_MODEL.into(),
+            MISSING_MODEL.into(),
+            "horizon:a".into(),
+        ];
+        let old = direct.block_library(&fixture.0, names.clone())?;
+        let shared = parsed.block_library(&fixture.0, names)?;
+        for name in ["horizon:nested/child", GENERATED_MODEL, MISSING_MODEL] {
+            assert_eq!(
+                format!("{:?}", old.resolve(name)?),
+                format!("{:?}", shared.resolve(name)?)
+            );
+        }
+        assert!(shared.resolve("horizon:a").is_err());
+        for name in ["horizon:broken", "horizon:absent", "horizon:dangling"] {
+            let load = |models: &ParsedModels| {
+                models
+                    .block_library(&fixture.0, vec![name.into()])
+                    .err()
+                    .unwrap()
+                    .to_string()
+            };
+            assert_eq!(load(&direct), load(&parsed));
+            // Mods' content: vanilla's missing model instead of an error.
+            let lenient = parsed.block_library_or_missing(&fixture.0, vec![name.into()])?;
+            assert_eq!(
+                format!("{:?}", lenient.resolve(name)?.elements()),
+                format!("{:?}", lenient.resolve(MISSING_MODEL)?.elements()),
+                "{name}"
+            );
+        }
+        let items = parsed.into_item_library()?;
+        let block = shared.resolve("horizon:nested/child")?;
+        let item = items.resolve("horizon:nested/child")?;
+        assert!(std::ptr::eq(
+            block.elements().as_ptr(),
+            item.elements().as_ptr()
+        ));
+        assert_eq!(
+            item.material("side")?.unwrap().sprite,
+            "minecraft:block/glass"
+        );
+        assert_eq!(shared.resolve(GENERATED_MODEL)?.elements().len(), 1);
+        assert!(items.resolve(GENERATED_MODEL)?.elements().is_empty());
+        assert!(items.resolve(GENERATED_MODEL)?.uses_item_generator());
+        for name in [
+            "horizon:broken",
+            "horizon:absent",
+            "horizon:dangling",
+            MISSING_MODEL,
+        ] {
+            assert_eq!(items.resolve(name)?.elements().len(), 1);
+        }
+        assert!(items.resolve("horizon:a").is_err());
+        fixture.write("horizon:parent", r#"{"elements":[]}"#);
+        let reloaded = ParsedModels::load(&fixture.0).into_item_library()?;
+        assert!(
+            reloaded
+                .resolve("horizon:nested/child")?
+                .elements()
+                .is_empty()
+        );
+        assert_eq!(items.resolve("horizon:nested/child")?.elements().len(), 1);
+        // An unrelated bad item identifier must not make block preparation fail
+        // (which would trigger resource-pack rollback at a different stage).
+        fixture.write("horizon:INVALID", "{}");
+        let parsed = ParsedModels::load(&fixture.0);
+        assert!(
+            parsed
+                .block_library(&fixture.0, vec!["horizon:nested/child".into()])
+                .is_ok()
+        );
+        assert!(parsed.into_item_library().is_err());
+        Ok(())
+    }
+
+    /// An .obj's `mtllib` is raw text: no namespace or path step reaches a
+    /// file outside the content root.
+    #[test]
+    fn root_assets_stay_inside_the_content_root() {
+        let root = std::env::temp_dir().join(format!("horizon-root-assets-{}", std::process::id()));
+        let inside = root.join("content");
+        fs::create_dir_all(inside.join("assets/m/models")).unwrap();
+        fs::write(inside.join("assets/m/models/a.mtl"), "newmtl a").unwrap();
+        fs::write(root.join("secret.mtl"), "newmtl secret").unwrap();
+        let assets = RootAssets(inside);
+        assert_eq!(
+            assets.read_text("m:models/a.mtl").as_deref(),
+            Some("newmtl a")
+        );
+        for escape in [
+            "../..:secret.mtl",
+            "..:../secret.mtl",
+            "m:../../../secret.mtl",
+            "m:models/./a.mtl",
+            "M:models/a.mtl",
+            ":models/a.mtl",
+        ] {
+            assert_eq!(assets.read_text(escape), None, "{escape}");
+        }
+        fs::remove_dir_all(&root).unwrap();
+    }
+}
diff --git a/crates/horizon-terrain-mesh/src/models.rs b/crates/horizon-terrain-mesh/src/models.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3c1f69364312c97d88760e8fdb603806a183b4ad
--- /dev/null
+++ b/crates/horizon-terrain-mesh/src/models.rs
@@ -0,0 +1,275 @@
+//! A blockstate-driven inspection gallery, separate from gameplay simulation.
+pub mod catalog;
+mod cube;
+use crate::{Result, sprites::Sprites};
+pub use catalog::StateModels;
+use catalog::descriptor;
+pub use cube::CubeStyle;
+use horizon_core::position::BlockPos;
+use horizon_world::registry::{BlockRegistry, BlockStateId};
+use serde_json::Value;
+#[cfg(not(target_os = "cafe"))]
+use serde_json::json;
+use std::path::Path;
+
+/// The standalone models native mods asked for (`native_standalone_models`).
+static STANDALONE: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+
+/// Sets the models no blockstate names that every resource load bakes
+/// beside the block models ([`StateModels::standalone`]): once, at start,
+/// as vanilla's `ModelEvent.RegisterStandalone` is posted once per model
+/// discovery. Names are sorted and deduplicated; one without a namespace
+/// (`mymod:block/shaft_half`) is dropped. False when already set.
+pub fn register_standalone(mut names: Vec<String>) -> bool {
+    names.retain(|n| {
+        n.split_once(':')
+            .is_some_and(|(ns, path)| !ns.is_empty() && !path.is_empty())
+    });
+    names.sort();
+    names.dedup();
+    STANDALONE.set(names).is_ok()
+}
+
+/// What [`register_standalone`] set; none before.
+pub fn standalone() -> &'static [String] {
+    STANDALONE.get().map_or(&[], Vec::as_slice)
+}
+
+type Placement = (&'static str, &'static [(&'static str, &'static str)]);
+const GALLERY: [Placement; 16] = [
+    (
+        "oak_stairs",
+        &[
+            ("facing", "north"),
+            ("half", "top"),
+            ("shape", "inner_left"),
+        ],
+    ),
+    ("stone_slab", &[("type", "top")]),
+    ("anvil", &[("facing", "east")]),
+    ("torch", &[]),
+    ("lantern", &[]),
+    ("oak_fence", &[("north", "true"), ("east", "true")]),
+    ("oak_fence_gate", &[("facing", "west"), ("open", "true")]),
+    ("iron_bars", &[("north", "true"), ("south", "true")]),
+    ("cobweb", &[]),
+    ("grindstone", &[("face", "wall"), ("facing", "west")]),
+    ("ladder", &[("facing", "west")]),
+    ("amethyst_cluster", &[("facing", "east")]),
+    ("stone", &[]),
+    ("stone", &[]),
+    ("stone", &[]),
+    ("stone", &[]),
+];
+
+#[repr(C)]
+#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct ModelInstance {
+    pub positions: [[f32; 3]; 4],
+    pub uv: [[f32; 2]; 4],
+    pub layer: u32,
+    pub shade: f32,
+}
+#[derive(Default)]
+pub struct PreparedModels {
+    pub catalog: StateModels,
+    pub placements: Vec<(BlockPos, BlockStateId)>,
+    pub states: Vec<Value>,
+}
+pub fn prepare(
+    root: &Path,
+    registry: &BlockRegistry,
+    sprites: &mut Sprites,
+) -> Result<PreparedModels> {
+    prepare_with_models(
+        root,
+        registry,
+        sprites,
+        &crate::model_library::ParsedModels::default(),
+    )
+}
+pub(crate) fn prepare_with_models(
+    root: &Path,
+    registry: &BlockRegistry,
+    sprites: &mut Sprites,
+    models: &crate::model_library::ParsedModels,
+) -> Result<PreparedModels> {
+    let facts: std::collections::BTreeMap<String, Value> =
+        serde_json::from_slice(&std::fs::read(root.join("model-states.json"))?)?;
+    let blocks: Vec<&str> = facts
+        .keys()
+        .filter(|name| registry.default_state(name).is_some())
+        .map(|name| name.strip_prefix("minecraft:").unwrap_or(name))
+        .collect();
+    let mut catalog = {
+        let _step = crate::spans::startup::step("core.bake_states");
+        StateModels::from_facts_with_models(root, registry, &blocks, sprites, &facts, models)?
+    };
+    {
+        let _step = crate::spans::startup::step("core.bake_standalone");
+        catalog.bake_standalone(root, sprites, models, standalone())?;
+    }
+    let mut placements = Vec::new();
+    #[cfg(not(target_os = "cafe"))]
+    let mut states = Vec::new();
+    #[cfg(target_os = "cafe")]
+    let states = Vec::new();
+    for (index, (name, properties)) in GALLERY.iter().enumerate() {
+        #[cfg(target_os = "cafe")]
+        log::info!(
+            "Horizon Cafe model gallery entry begin index={} total={} block={name}",
+            index + 1,
+            GALLERY.len()
+        );
+        let state = {
+            #[cfg(target_os = "cafe")]
+            let _step = crate::spans::startup::step("core.models_bake.gallery.registry");
+            registry.resolve(&descriptor(name, properties))?
+        };
+        let actual = registry
+            .state(state)
+            .ok_or("missing gallery registry state")?;
+        #[cfg(target_os = "cafe")]
+        let _ = actual;
+        let position = BlockPos::new((index % 4) as i32 * 4 - 7, 4, (index / 4) as i32 * 4 + 14);
+        // A state no definition binds (a pack's partial blockstate file
+        // without vanilla's below it) is left out, as the mesher skips it,
+        // instead of failing the whole pack.
+        let selected = {
+            #[cfg(target_os = "cafe")]
+            let _step = crate::spans::startup::step("core.models_bake.gallery.collect");
+            catalog.collect(state, position)
+        };
+        let selected = match selected {
+            Ok(selected) => selected,
+            Err(e) => {
+                log::warn!("Horizon: gallery block {name} has no model: {e}");
+                continue;
+            }
+        };
+        // This JSON view is probe metadata; Cafe needs the same baked catalog
+        // and placements but does not consume its serialized gallery copy.
+        #[cfg(target_os = "cafe")]
+        drop(selected);
+        #[cfg(not(target_os = "cafe"))]
+        states.push(json!({"block":actual.name,"properties":actual.properties,"state_id":state.0,
+            "position":[position.x,position.y,position.z],
+            "models":selected.iter().map(|(v,_)| json!({"model":v.model,"rotations":v.rotations,"uv_lock":v.uv_lock})).collect::<Vec<_>>() }));
+        placements.push((position, state));
+        #[cfg(target_os = "cafe")]
+        log::info!(
+            "Horizon Cafe model gallery entry complete index={} block={name}",
+            index + 1
+        );
+    }
+    Ok(PreparedModels {
+        catalog,
+        placements,
+        states,
+    })
+}
+
+/// Block models and textures needed to mesh terrain, without the standalone
+/// models or inspection gallery used by the full client asset load. The
+/// resolver reads only block models referenced by blockstates and their
+/// parents, using the same binding and baking path as [`prepare_with_models`].
+pub(crate) fn prepare_for_terrain(
+    root: &Path,
+    registry: &BlockRegistry,
+    sprites: &mut Sprites,
+) -> Result<PreparedModels> {
+    let facts: std::collections::BTreeMap<String, Value> =
+        serde_json::from_slice(&std::fs::read(root.join("model-states.json"))?)?;
+    let blocks: Vec<&str> = facts
+        .keys()
+        .filter(|name| registry.default_state(name).is_some())
+        .map(|name| name.strip_prefix("minecraft:").unwrap_or(name))
+        .collect();
+    let catalog = {
+        let _step = crate::spans::startup::step("core.bake_states");
+        StateModels::from_facts_with_models(
+            root,
+            registry,
+            &blocks,
+            sprites,
+            &facts,
+            &crate::model_library::ParsedModels::default(),
+        )?
+    };
+    Ok(PreparedModels {
+        catalog,
+        placements: Vec::new(),
+        states: Vec::new(),
+    })
+}
+pub fn instance(face: &catalog::BakedFace, position: BlockPos) -> ModelInstance {
+    let origin = [position.x as f32, position.y as f32, position.z as f32];
+    ModelInstance {
+        positions: face
+            .quad
+            .positions
+            .map(|v| std::array::from_fn(|i| v[i] + origin[i])),
+        uv: face.quad.uv,
+        layer: face.layer,
+        shade: cube::shade(face),
+    }
+}
+
+pub fn load_visibility(
+    root: &Path,
+    registry: &BlockRegistry,
+) -> Result<horizon_world::block_render::FaceVisibility> {
+    use horizon_world::{
+        block_render::{FaceVisibility, RenderDefinition, SkipRendering},
+        collision::CachedCollisionRegistry,
+        registry::BlockTableFile,
+    };
+    use std::{collections::BTreeMap, fs};
+    let file = BlockTableFile::open(&root.join("occlusion.nbt"), registry)?;
+    let occlusion = CachedCollisionRegistry::from_table(file.table("occlusion")?)?;
+    let raw: BTreeMap<String, Value> =
+        serde_json::from_slice(&fs::read(root.join("render-definitions.json"))?)?;
+    let definitions = raw
+        .into_iter()
+        .map(|(name, v)| {
+            let skip = match v["rule"].as_str().ok_or("missing render rule")? {
+                "never" => SkipRendering::Never,
+                "same_block" => SkipRendering::SameBlock,
+                "bars" => SkipRendering::Bars,
+                "leaves" => SkipRendering::Leaves,
+                "liquid" => SkipRendering::Liquid,
+                "mangrove_roots" => SkipRendering::MangroveRoots,
+                _ => return Err("unrecognized render rule"),
+            };
+            Ok((
+                name,
+                RenderDefinition {
+                    skip,
+                    can_occlude: v["can_occlude"].as_bool().ok_or("missing occlusion flag")?,
+                    bars_tag: v["bars_tag"].as_bool().ok_or("missing bars tag")?,
+                },
+            ))
+        })
+        .collect::<std::result::Result<_, &str>>()?;
+    Ok(FaceVisibility::new(&occlusion, &definitions)?)
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn standalone_names_are_namespaced_sorted_and_set_once() {
+        assert!(super::standalone().is_empty());
+        let names = [
+            "lanef:block/b",
+            "nonamespace",
+            ":x",
+            "lanef:",
+            "lanef:block/a",
+            "lanef:block/b",
+        ];
+        assert!(super::register_standalone(names.map(str::to_owned).into()));
+        assert_eq!(super::standalone(), ["lanef:block/a", "lanef:block/b"]);
+        assert!(!super::register_standalone(vec!["other:block/c".into()]));
+        assert_eq!(super::standalone(), ["lanef:block/a", "lanef:block/b"]);
+    }
+}
