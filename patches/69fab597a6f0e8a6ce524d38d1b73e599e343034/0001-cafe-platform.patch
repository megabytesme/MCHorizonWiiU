@@ -0,0 +1,373 @@
+//! The ban notices `Gui.addInitialScreens` queues before the title screen:
+//! `Minecraft.multiplayerBan()` (the account's MULTIPLAYER ban from the services
+//! attributes call), the forced name change and the banned skin
+//! (`ProfileResult.actions()`), and the text `BanNoticeScreens` shows for each.
+//! The network calls are in `auth.rs`; this file parses what they return.
+use crate::text::Text;
+
+/// `CommonLinks.SUSPENSION_HELP`.
+pub const SUSPENSION_HELP: &str = "https://aka.ms/mcjavamoderation";
+
+/// authlib's `BanDetails` (the id is never shown).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct BanDetails {
+    /// Epoch milliseconds the ban ends; `None` is permanent.
+    pub expires_ms: Option<i64>,
+    pub reason: Option<String>,
+    pub reason_message: Option<String>,
+}
+
+/// authlib's `UserProperties`, as far as the title screen reads it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct UserProperties {
+    /// `UserFlag.SERVERS_ALLOWED` (`privileges.multiplayerServer.enabled`).
+    pub servers_allowed: bool,
+    /// `bannedScopes.get("MULTIPLAYER")`.
+    pub multiplayer_ban: Option<BanDetails>,
+}
+impl Default for UserProperties {
+    /// `UserApiService.OFFLINE_PROPERTIES`: what a failed fetch falls back to.
+    fn default() -> Self {
+        Self {
+            servers_allowed: true,
+            multiplayer_ban: None,
+        }
+    }
+}
+
+/// authlib's `ProfileResult.actions()`.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ProfileActions {
+    pub forced_name_change: bool,
+    pub using_banned_skin: bool,
+}
+
+/// What the title screen learns about the account.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct AccountStatus {
+    pub properties: UserProperties,
+    pub actions: ProfileActions,
+}
+impl AccountStatus {
+    /// `Minecraft.allowsMultiplayer` (without the `--disableMultiplayer` flag).
+    pub fn allows_multiplayer(&self) -> bool {
+        self.properties.servers_allowed
+            && self.properties.multiplayer_ban.is_none()
+            && !self.actions.forced_name_change
+    }
+}
+
+/// One of the screens `Gui.addInitialScreens` adds.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Notice {
+    /// `BanNoticeScreens.create`.
+    Multiplayer(BanDetails),
+    /// `BanNoticeScreens.createNameBan` with the profile's name.
+    Name(String),
+    /// `BanNoticeScreens.createSkinBan`.
+    Skin,
+}
+
+/// `Gui.addInitialScreens`' ban part, in its order: the multiplayer ban, the
+/// name ban, the skin ban.
+pub fn initial_notices(status: &AccountStatus, profile_name: &str) -> Vec<Notice> {
+    let mut notices = Vec::new();
+    if let Some(ban) = &status.properties.multiplayer_ban {
+        notices.push(Notice::Multiplayer(ban.clone()));
+    }
+    if status.actions.forced_name_change {
+        notices.push(Notice::Name(profile_name.to_owned()));
+    }
+    if status.actions.using_banned_skin {
+        notices.push(Notice::Skin);
+    }
+    notices
+}
+
+impl Notice {
+    /// The screen's title (bold).
+    pub fn title(&self) -> Text {
+        let key = match self {
+            Self::Multiplayer(ban) if ban.expires_ms.is_some() => "gui.banned.title.temporary",
+            Self::Multiplayer(_) => "gui.banned.title.permanent",
+            Self::Name(_) => "gui.banned.name.title",
+            Self::Skin => "gui.banned.skin.title",
+        };
+        Text::translate(key, &[]).bold()
+    }
+    /// The screen's message; `now_ms` is `Instant.now()`.
+    pub fn message(&self, now_ms: i64) -> Text {
+        let link = || Text::literal(SUSPENSION_HELP);
+        match self {
+            Self::Multiplayer(ban) => Text::translate(
+                "gui.banned.description",
+                &[reason_text(ban), status_text(ban, now_ms), link()],
+            ),
+            Self::Name(name) => Text::translate(
+                "gui.banned.name.description",
+                &[Text::colored(name.clone(), YELLOW), link()],
+            ),
+            Self::Skin => Text::translate("gui.banned.skin.description", &[link()]),
+        }
+    }
+}
+
+/// `ChatFormatting.YELLOW`.
+const YELLOW: u32 = 0xFFFF55;
+
+/// `BanReason.byId`: the translation key suffix.
+fn ban_reason(id: i32) -> Option<&'static str> {
+    Some(match id {
+        2 => "false_reporting",
+        5 => "hate_speech",
+        16 | 25 => "hate_terrorism_notorious_figure",
+        17 | 19 | 23 | 31 => "generic_violation",
+        21 => "harassment_or_bullying",
+        27 => "defamation_impersonation_false_information",
+        28 => "drugs",
+        29 => "fraud",
+        30 => "spam_or_advertising",
+        32 => "nudity_or_pornography",
+        33 | 35 | 36 => "sexually_inappropriate",
+        34 => "extreme_violence_or_gore",
+        53 => "imminent_harm_to_person_or_property",
+        _ => return None,
+    })
+}
+
+/// `BanNoticeScreens.getBanReasonText`.
+fn reason_text(ban: &BanDetails) -> Text {
+    let numeric = ban
+        .reason
+        .as_deref()
+        .filter(|r| !r.is_empty() && r.bytes().all(|b| b.is_ascii_digit()));
+    let Some(reason) = numeric else {
+        return Text::translate("gui.banned.description.unknownreason", &[]);
+    };
+    // Integer.parseInt: past i32 the vanilla screen would throw; show the code as is.
+    let id = reason.parse::<i32>().ok();
+    let text = if let Some(key) = id.and_then(ban_reason) {
+        Text::translate(&format!("gui.banned.reason.{key}"), &[]).bold()
+    } else if let Some(message) = &ban.reason_message {
+        Text::translate(
+            "gui.banned.description.reason_id_message",
+            &[Text::literal(reason), Text::literal(message.clone())],
+        )
+        .bold()
+    } else {
+        Text::translate("gui.banned.description.reason_id", &[Text::literal(reason)]).bold()
+    };
+    Text::translate("gui.banned.description.reason", &[text])
+}
+
+/// `BanNoticeScreens.getBanStatusText`.
+fn status_text(ban: &BanDetails, now_ms: i64) -> Text {
+    match ban.expires_ms {
+        Some(expires) => {
+            let duration = Text::translate(
+                "gui.banned.description.temporary.duration",
+                &[duration_text(expires - now_ms)],
+            )
+            .bold();
+            Text::translate("gui.banned.description.temporary", &[duration])
+        }
+        None => Text::translate("gui.banned.description.permanent", &[]).bold(),
+    }
+}
+
+/// `BanNoticeScreens.getBanDurationText`: days past 72 hours, else hours,
+/// else minutes (`Duration.toHours` and friends truncate toward zero).
+fn duration_text(millis: i64) -> Text {
+    let count = |n: i64| Text::literal(n.to_string());
+    let hours = millis / 3_600_000;
+    if hours > 72 {
+        Text::translate("gui.days", &[count(millis / 86_400_000)])
+    } else if hours < 1 {
+        Text::translate("gui.minutes", &[count(millis / 60_000)])
+    } else {
+        Text::translate("gui.hours", &[count(hours)])
+    }
+}
+
+/// `Instant` as authlib's gson adapter reads it: an ISO-8601 string, or epoch milliseconds.
+fn parse_instant(value: &serde_json::Value) -> Option<i64> {
+    match value {
+        serde_json::Value::Number(n) => n.as_i64(),
+        serde_json::Value::String(s) => chrono::DateTime::parse_from_rfc3339(s)
+            .ok()
+            .map(|t| t.timestamp_millis())
+            .or_else(|| s.parse().ok()),
+        _ => None,
+    }
+}
+
+/// `UserAttributesResponse` into `UserProperties` (`fetchProperties`). Bad JSON
+/// is an error, which vanilla answers with the offline properties.
+pub fn parse_properties(body: &str) -> Option<UserProperties> {
+    let v: serde_json::Value = serde_json::from_str(body).ok()?;
+    let servers_allowed = v
+        .pointer("/privileges/multiplayerServer/enabled")
+        .and_then(|e| e.as_bool())
+        .unwrap_or(false);
+    let multiplayer_ban = v
+        .pointer("/banStatus/bannedScopes/MULTIPLAYER")
+        .filter(|b| b.is_object())
+        .map(|b| {
+            let text = |k: &str| b.get(k).and_then(|s| s.as_str()).map(str::to_owned);
+            BanDetails {
+                expires_ms: b.get("expires").and_then(parse_instant),
+                reason: text("reason"),
+                reason_message: text("reasonMessage"),
+            }
+        });
+    Some(UserProperties {
+        servers_allowed,
+        multiplayer_ban,
+    })
+}
+
+/// `MinecraftProfilePropertiesResponse.profileActions` into `ProfileActionType`s.
+pub fn parse_profile_actions(body: &str) -> ProfileActions {
+    let mut actions = ProfileActions::default();
+    let v: serde_json::Value = serde_json::from_str(body).unwrap_or_default();
+    for action in v
+        .get("profileActions")
+        .and_then(|a| a.as_array())
+        .into_iter()
+        .flatten()
+    {
+        match action.get("type").and_then(|t| t.as_str()) {
+            Some("FORCED_NAME_CHANGE") => actions.forced_name_change = true,
+            Some("USING_BANNED_SKIN") => actions.using_banned_skin = true,
+            _ => {}
+        }
+    }
+    actions
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const HOUR: i64 = 3_600_000;
+    /// 2026-11-01T00:00:00Z.
+    const EXPIRES: i64 = 1_793_491_200_000;
+
+    #[test]
+    fn parses_a_multiplayer_ban() {
+        let body = r#"{"privileges":{"multiplayerServer":{"enabled":false}},
+            "banStatus":{"bannedScopes":{"MULTIPLAYER":{"banId":"6b0f0a0e-0000-4000-8000-000000000000",
+            "expires":"2026-11-01T00:00:00Z","reason":"21","reasonMessage":"x"}}}}"#;
+        let p = parse_properties(body).unwrap();
+        assert!(!p.servers_allowed);
+        let ban = p.multiplayer_ban.unwrap();
+        assert_eq!(ban.expires_ms, Some(EXPIRES));
+        assert_eq!(ban.reason.as_deref(), Some("21"));
+        let numeric =
+            parse_properties(r#"{"banStatus":{"bannedScopes":{"MULTIPLAYER":{"expires":5}}}}"#)
+                .unwrap();
+        assert_eq!(numeric.multiplayer_ban.unwrap().expires_ms, Some(5));
+        assert!(parse_properties("nope").is_none());
+        let clean = parse_properties(
+            r#"{"privileges":{"multiplayerServer":{"enabled":true}},"banStatus":{"bannedScopes":{}}}"#,
+        )
+        .unwrap();
+        assert!(clean.servers_allowed && clean.multiplayer_ban.is_none());
+    }
+
+    #[test]
+    fn parses_profile_actions() {
+        let a = parse_profile_actions(
+            r#"{"id":"x","profileActions":[{"type":"FORCED_NAME_CHANGE"},{"type":"OTHER"}]}"#,
+        );
+        assert!(a.forced_name_change && !a.using_banned_skin);
+        let a = parse_profile_actions(r#"{"profileActions":[{"type":"USING_BANNED_SKIN"}]}"#);
+        assert!(!a.forced_name_change && a.using_banned_skin);
+        assert_eq!(parse_profile_actions("{}"), ProfileActions::default());
+    }
+
+    #[test]
+    fn queues_in_vanilla_order() {
+        let ban = BanDetails {
+            expires_ms: None,
+            reason: None,
+            reason_message: None,
+        };
+        let status = AccountStatus {
+            properties: UserProperties {
+                servers_allowed: true,
+                multiplayer_ban: Some(ban.clone()),
+            },
+            actions: ProfileActions {
+                forced_name_change: true,
+                using_banned_skin: true,
+            },
+        };
+        assert_eq!(
+            initial_notices(&status, "Steve"),
+            vec![
+                Notice::Multiplayer(ban),
+                Notice::Name("Steve".into()),
+                Notice::Skin
+            ]
+        );
+        assert!(!status.allows_multiplayer());
+        assert!(initial_notices(&AccountStatus::default(), "Steve").is_empty());
+        assert!(AccountStatus::default().allows_multiplayer());
+        let no_servers = AccountStatus {
+            properties: UserProperties {
+                servers_allowed: false,
+                multiplayer_ban: None,
+            },
+            ..Default::default()
+        };
+        assert!(!no_servers.allows_multiplayer());
+    }
+
+    /// The message's component JSON: the keys and arguments, whatever language is loaded.
+    fn json(notice: &Notice, now: i64) -> String {
+        notice.message(now).component().to_string()
+    }
+
+    #[test]
+    fn ban_text_follows_banned_screens() {
+        let temp = |reason: Option<&str>, message: Option<&str>| {
+            Notice::Multiplayer(BanDetails {
+                expires_ms: Some(100 * HOUR),
+                reason: reason.map(str::to_owned),
+                reason_message: message.map(str::to_owned),
+            })
+        };
+        assert_eq!(
+            temp(None, None).title().translation_key(),
+            Some("gui.banned.title.temporary")
+        );
+        let perm = Notice::Multiplayer(BanDetails {
+            expires_ms: None,
+            reason: Some("5".into()),
+            reason_message: None,
+        });
+        assert_eq!(
+            perm.title().translation_key(),
+            Some("gui.banned.title.permanent")
+        );
+        let text = json(&perm, 0);
+        assert!(text.contains("gui.banned.reason.hate_speech"));
+        assert!(text.contains("gui.banned.description.permanent"));
+        assert!(text.contains(SUSPENSION_HELP));
+        // Unknown ids show their code, with the message when there is one.
+        let with_message = json(&temp(Some("999"), Some("why")), 0);
+        assert!(with_message.contains("gui.banned.description.reason_id_message"));
+        assert!(with_message.contains("why"));
+        assert!(json(&temp(Some("999"), None), 0).contains("gui.banned.description.reason_id\""));
+        assert!(json(&temp(Some("abc"), None), 0).contains("gui.banned.description.unknownreason"));
+        // 100 hours left is past 72: days (4); less is hours; under an hour is minutes.
+        let duration = |now| json(&temp(None, None), now);
+        assert!(duration(0).contains("gui.days") && duration(0).contains("[4]"));
+        assert!(duration(60 * HOUR).contains("gui.hours") && duration(60 * HOUR).contains("[40]"));
+        let minutes = duration(100 * HOUR - 90_000);
+        assert!(minutes.contains("gui.minutes") && minutes.contains("[1]"));
+        assert!(json(&Notice::Name("Bob".into()), 0).contains("Bob"));
+        assert!(json(&Notice::Skin, 0).contains(SUSPENSION_HELP));
+    }
+}
diff --git a/crates/horizon-client-core/src/dialog.rs b/crates/horizon-client-core/src/dialog.rs
new file mode 100644
index 0000000000000000000000000000000000000000..72e257b65e31d490cacad7acfb75b3fa44f6efd6
--- /dev/null
+++ b/crates/horizon-client-core/src/dialog.rs
@@ -0,0 +1,949 @@
+//! Server dialogs (`net.minecraft.server.dialog`): what `Dialog.DIRECT_CODEC`
+//! decodes from a `show_dialog` packet, the values its inputs hold, and the
+//! click event an action makes of them (`Action.createAction`).
+use crate::text::Text;
+use horizon_world::nbt::Tag;
+use serde_json::{Value, json};
+
+/// `CommonDialogData` and the type's own fields.
+#[derive(Clone, Debug)]
+pub struct Dialog {
+    pub kind: Kind,
+    pub title: Text,
+    pub external_title: Option<Text>,
+    pub can_close_with_escape: bool,
+    pub pause: bool,
+    pub after_action: AfterAction,
+    pub body: Vec<Body>,
+    pub inputs: Vec<Input>,
+}
+
+/// The dialog types (`DialogTypes`).
+#[derive(Clone, Debug)]
+pub enum Kind {
+    /// `NoticeDialog`: one button, "OK" when the server names none.
+    Notice(Button),
+    Confirmation {
+        yes: Button,
+        no: Button,
+    },
+    MultiAction {
+        actions: Vec<Button>,
+        exit: Option<Button>,
+        columns: i32,
+    },
+    ServerLinks {
+        exit: Option<Button>,
+        columns: i32,
+        button_width: i32,
+    },
+    /// `DialogListDialog`: its dialogs as sent (ids, a tag or inline dialogs),
+    /// and one button per dialog they resolve to (`set_list`).
+    DialogList {
+        dialogs: Tag,
+        entries: Vec<Button>,
+        exit: Option<Button>,
+        columns: i32,
+        button_width: i32,
+    },
+}
+
+/// `DialogAction`: the screen after an action runs.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AfterAction {
+    Close,
+    None,
+    WaitForResponse,
+}
+
+/// `ActionButton`: `CommonButtonData` and what it does.
+#[derive(Clone, Debug)]
+pub struct Button {
+    pub label: Text,
+    pub tooltip: Option<Text>,
+    pub width: i32,
+    pub action: Option<Action>,
+}
+
+/// `Action`: a fixed click event, or one made from the inputs' values.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Action {
+    /// `StaticAction`: a click event as it is.
+    Static(Click),
+    /// `CommandTemplate`: a command with `$(key)` replaced by input values.
+    RunCommand(String),
+    /// `CustomAll`: a custom click event whose payload is `additions` plus
+    /// every input's value under its key.
+    Custom { id: String, additions: Option<Tag> },
+}
+
+/// `ClickEvent`, the kinds a server may send (`isAllowedFromServer`).
+#[derive(Clone, Debug, PartialEq)]
+pub enum Click {
+    OpenUrl(String),
+    RunCommand(String),
+    SuggestCommand(String),
+    /// The dialog: an id of the `minecraft:dialog` registry or the dialog itself.
+    ShowDialog(Tag),
+    ChangePage(i32),
+    CopyToClipboard(String),
+    Custom {
+        id: String,
+        payload: Option<Tag>,
+    },
+}
+
+/// `DialogBody`.
+#[derive(Clone, Debug)]
+pub enum Body {
+    /// `PlainMessage`: centred text wrapped to `width`.
+    Message { contents: Text, width: i32 },
+    /// `ItemBody`: the item as `ItemStackTemplate` sent it.
+    Item {
+        item: Tag,
+        description: Option<(Text, i32)>,
+        show_decorations: bool,
+        show_tooltip: bool,
+        width: i32,
+        height: i32,
+    },
+}
+
+/// `Input`: the key its value goes by, and its control.
+#[derive(Clone, Debug)]
+pub struct Input {
+    pub key: String,
+    pub control: Control,
+}
+
+/// `InputControl`.
+#[derive(Clone, Debug)]
+pub enum Control {
+    Text {
+        width: i32,
+        label: Text,
+        label_visible: bool,
+        initial: String,
+        max_length: i32,
+        /// `MultilineOptions`: the most lines and the height, when set.
+        multiline: Option<(Option<i32>, Option<i32>)>,
+    },
+    Boolean {
+        label: Text,
+        initial: bool,
+        on_true: String,
+        on_false: String,
+    },
+    SingleOption {
+        width: i32,
+        /// Each option's id, its label and whether it is the initial one.
+        options: Vec<(String, Option<Text>, bool)>,
+        label: Text,
+        label_visible: bool,
+    },
+    NumberRange {
+        width: i32,
+        label: Text,
+        label_format: String,
+        start: f32,
+        end: f32,
+        initial: Option<f32>,
+        step: Option<f32>,
+    },
+}
+
+/// What an input holds while the dialog is open.
+#[derive(Clone, Debug, PartialEq)]
+pub enum InputValue {
+    Text(String),
+    Bool(bool),
+    /// The chosen option's index.
+    Option(usize),
+    /// The slider's position, 0 to 1.
+    Slider(f32),
+}
+
+fn text(t: &Tag) -> Text {
+    crate::scoreboard::comp_text(&crate::scoreboard::tag_to_json(t))
+}
+fn string(t: Option<&Tag>) -> Option<String> {
+    match t? {
+        Tag::String(s) => Some(s.to_string_lossy()),
+        _ => None,
+    }
+}
+fn number(t: Option<&Tag>) -> Option<f64> {
+    Some(match t? {
+        Tag::Byte(v) => f64::from(*v),
+        Tag::Short(v) => f64::from(*v),
+        Tag::Int(v) => f64::from(*v),
+        Tag::Long(v) => *v as f64,
+        Tag::Float(v) => f64::from(f32::from_bits(*v)),
+        Tag::Double(v) => f64::from_bits(*v),
+        _ => return None,
+    })
+}
+fn int(t: &Tag, key: &str, default: i32) -> i32 {
+    number(t.get(key)).map_or(default, |v| v as i32)
+}
+fn boolean(t: &Tag, key: &str, default: bool) -> bool {
+    number(t.get(key)).map_or(default, |v| v != 0.0)
+}
+fn list(t: Option<&Tag>) -> &[Tag] {
+    match t {
+        Some(Tag::List(items)) => items,
+        _ => &[],
+    }
+}
+/// A registry name without its default namespace.
+fn path(id: &str) -> &str {
+    id.strip_prefix("minecraft:").unwrap_or(id)
+}
+
+impl Button {
+    /// `ActionButton.CODEC`.
+    fn parse(t: &Tag) -> Option<Self> {
+        Some(Self {
+            label: text(t.get("label")?),
+            tooltip: t.get("tooltip").map(text),
+            width: int(t, "width", 150),
+            action: t.get("action").and_then(Action::parse),
+        })
+    }
+    /// `NoticeDialog.DEFAULT_ACTION`.
+    fn ok() -> Self {
+        Self {
+            label: Text::translate("gui.ok", &[]),
+            tooltip: None,
+            width: 150,
+            action: None,
+        }
+    }
+}
+
+impl Click {
+    /// `ClickEvent.CODEC`, from its `action` (a click event in a component)
+    /// or `type` (an action) field.
+    pub fn parse(t: &Tag, kind: &str) -> Option<Self> {
+        let s = |key| string(t.get(key));
+        Some(match path(kind) {
+            // ClickEvent.OpenUrl's url is an ExtraCodecs.UNTRUSTED_URI.
+            "open_url" => {
+                Self::OpenUrl(s("url").filter(|url| crate::component::untrusted_http_url(url))?)
+            }
+            "run_command" => Self::RunCommand(s("command")?),
+            "suggest_command" => Self::SuggestCommand(s("command")?),
+            "show_dialog" => Self::ShowDialog(t.get("dialog")?.clone()),
+            "change_page" => Self::ChangePage(int(t, "page", 1)),
+            "copy_to_clipboard" => Self::CopyToClipboard(s("value")?),
+            "custom" => Self::Custom {
+                id: s("id")?,
+                payload: t.get("payload").cloned(),
+            },
+            _ => return None,
+        })
+    }
+}
+
+impl Action {
+    /// `Action.CODEC`, dispatched on `type`.
+    fn parse(t: &Tag) -> Option<Self> {
+        let kind = string(t.get("type"))?;
+        Some(match path(&kind) {
+            "dynamic/run_command" => Self::RunCommand(string(t.get("template"))?),
+            "dynamic/custom" => Self::Custom {
+                id: string(t.get("id"))?,
+                additions: t.get("additions").cloned(),
+            },
+            other => Self::Static(Click::parse(t, other)?),
+        })
+    }
+    /// `createAction`: the click event, given each input's key, control and value.
+    pub fn click(&self, inputs: &[Input], values: &[InputValue]) -> Option<Click> {
+        let values = || inputs.iter().zip(values);
+        Some(match self {
+            Self::Static(click) => click.clone(),
+            Self::RunCommand(template) => Click::RunCommand(substitute(template, &|key| {
+                values()
+                    .find(|(i, _)| i.key == key)
+                    .map(|(i, v)| i.control.substitution(v))
+            })),
+            Self::Custom { id, additions } => {
+                let mut tag = match additions {
+                    Some(t @ Tag::Compound(_)) => t.clone(),
+                    _ => Tag::Compound(Default::default()),
+                };
+                for (input, value) in values() {
+                    if let Tag::Compound(map) = &mut tag {
+                        map.insert(input.key.as_str().into(), input.control.tag(value));
+                    }
+                }
+                Click::Custom {
+                    id: id.clone(),
+                    payload: Some(tag),
+                }
+            }
+        })
+    }
+}
+
+/// `ParsedTemplate.instantiate`: each `$(key)` replaced by its value, or by
+/// nothing for a key no input has.
+fn substitute(template: &str, value: &dyn Fn(&str) -> Option<String>) -> String {
+    let mut out = String::new();
+    let mut rest = template;
+    while let Some(at) = rest.find("$(") {
+        let Some(end) = rest[at..].find(')') else {
+            break;
+        };
+        out.push_str(&rest[..at]);
+        out.push_str(&value(&rest[at + 2..at + end]).unwrap_or_default());
+        rest = &rest[at + end + 1..];
+    }
+    out.push_str(rest);
+    out
+}
+
+/// `StringTag.escapeWithoutQuotes`.
+fn escape(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    for c in s.chars() {
+        match c {
+            '"' | '\'' | '\\' => {
+                out.push('\\');
+                out.push(c);
+            }
+            '\u{8}' => out.push_str("\\b"),
+            '\t' => out.push_str("\\t"),
+            '\n' => out.push_str("\\n"),
+            '\u{c}' => out.push_str("\\f"),
+            '\r' => out.push_str("\\r"),
+            c if c < ' ' => out.push_str(&format!("\\x{:02x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out
+}
+
+impl Control {
+    /// `InputControl.MAP_CODEC`, dispatched on `type`.
+    fn parse(t: &Tag) -> Option<Self> {
+        let label = || t.get("label").map(text);
+        Some(match path(&string(t.get("type"))?) {
+            "text" => {
+                let initial = string(t.get("initial")).unwrap_or_default();
+                let max_length = int(t, "max_length", 32);
+                // TextInput: the default text may not be longer than the length.
+                if initial.encode_utf16().count() > max_length.max(0) as usize {
+                    return None;
+                }
+                Self::Text {
+                    width: int(t, "width", 200),
+                    label: label()?,
+                    label_visible: boolean(t, "label_visible", true),
+                    initial,
+                    max_length,
+                    multiline: t.get("multiline").map(|m| {
+                        let get = |key| number(m.get(key)).map(|v| v as i32);
+                        (get("max_lines"), get("height"))
+                    }),
+                }
+            }
+            "boolean" => Self::Boolean {
+                label: label()?,
+                initial: boolean(t, "initial", false),
+                on_true: string(t.get("on_true")).unwrap_or_else(|| "true".into()),
+                on_false: string(t.get("on_false")).unwrap_or_else(|| "false".into()),
+            },
+            "single_option" => {
+                // SingleOptionInput.Entry.CODEC: a full entry or just its id.
+                let options: Vec<_> = list(t.get("options"))
+                    .iter()
+                    .map(|o| match o {
+                        Tag::String(id) => Some((id.to_string_lossy(), None, false)),
+                        o => Some((
+                            string(o.get("id"))?,
+                            o.get("display").map(text),
+                            boolean(o, "initial", false),
+                        )),
+                    })
+                    .collect::<Option<_>>()?;
+                // A non-empty list with at most one initial entry.
+                if options.is_empty() || options.iter().filter(|o| o.2).count() > 1 {
+                    return None;
+                }
+                Self::SingleOption {
+                    width: int(t, "width", 200),
+                    options,
+                    label: label()?,
+                    label_visible: boolean(t, "label_visible", true),
+                }
+            }
+            "number_range" => {
+                let float = |key| number(t.get(key)).map(|v| v as f32);
+                Self::NumberRange {
+                    width: int(t, "width", 200),
+                    label: label()?,
+                    label_format: string(t.get("label_format"))
+                        .unwrap_or_else(|| "options.generic_value".into()),
+                    start: float("start")?,
+                    end: float("end")?,
+                    initial: float("initial"),
+                    step: float("step"),
+                }
+            }
+            _ => return None,
+        })
+    }
+    /// The value it starts with.
+    pub fn initial(&self) -> InputValue {
+        match self {
+            Self::Text { initial, .. } => InputValue::Text(initial.clone()),
+            Self::Boolean { initial, .. } => InputValue::Bool(*initial),
+            Self::SingleOption { options, .. } => {
+                InputValue::Option(options.iter().position(|o| o.2).unwrap_or(0))
+            }
+            Self::NumberRange {
+                start,
+                end,
+                initial,
+                ..
+            } => InputValue::Slider(to_slider(
+                initial.unwrap_or((start + end) / 2.0),
+                *start,
+                *end,
+            )),
+        }
+    }
+    /// The text on a cycle button or slider holding `value`
+    /// (`CycleButton.createFullName`, `NumberRangeInput.computeLabel`).
+    pub fn message(&self, value: &InputValue) -> Option<Text> {
+        match (self, value) {
+            (
+                Self::SingleOption {
+                    options,
+                    label,
+                    label_visible,
+                    ..
+                },
+                InputValue::Option(i),
+            ) => {
+                let (id, display, _) = options.get(*i)?;
+                let shown = display.clone().unwrap_or_else(|| Text::literal(id));
+                Some(if *label_visible {
+                    Text::translate("options.generic_value", &[label.clone(), shown])
+                } else {
+                    shown
+                })
+            }
+            (
+                Self::NumberRange {
+                    label,
+                    label_format,
+                    ..
+                },
+                InputValue::Slider(_),
+            ) => {
+                let shown = number_string(self.scaled(value)?);
+                Some(Text::translate(
+                    label_format,
+                    &[label.clone(), Text::literal(shown)],
+                ))
+            }
+            _ => None,
+        }
+    }
+    /// `ValueGetter.asTemplateSubstitution`.
+    pub fn substitution(&self, value: &InputValue) -> String {
+        match (self, value) {
+            (Self::Text { .. }, InputValue::Text(s)) => escape(s),
+            (
+                Self::Boolean {
+                    on_true, on_false, ..
+                },
+                InputValue::Bool(b),
+            ) => if *b { on_true } else { on_false }.clone(),
+            (Self::SingleOption { options, .. }, InputValue::Option(i)) => {
+                options.get(*i).map(|o| o.0.clone()).unwrap_or_default()
+            }
+            (Self::NumberRange { .. }, InputValue::Slider(_)) => {
+                number_string(self.scaled(value).unwrap_or(0.0))
+            }
+            _ => String::new(),
+        }
+    }
+    /// `ValueGetter.asTag`.
+    pub fn tag(&self, value: &InputValue) -> Tag {
+        match (self, value) {
+            (Self::Boolean { .. }, InputValue::Bool(b)) => Tag::Byte(i8::from(*b)),
+            (Self::NumberRange { .. }, _) => {
+                Tag::Float(self.scaled(value).unwrap_or(0.0).to_bits())
+            }
+            (Self::Text { .. }, InputValue::Text(s)) => Tag::String(s.as_str().into()),
+            _ => Tag::String(self.substitution(value).as_str().into()),
+        }
+    }
+    /// `RangeInfo.computeScaledValue`: a number range's value at its slider position.
+    pub fn scaled(&self, value: &InputValue) -> Option<f32> {
+        let (
+            Self::NumberRange {
+                start,
+                end,
+                initial,
+                step,
+                ..
+            },
+            InputValue::Slider(slider),
+        ) = (self, value)
+        else {
+            return None;
+        };
+        let (start, end) = (*start, *end);
+        let in_range = start + slider * (end - start);
+        let Some(step) = step else {
+            return Some(in_range);
+        };
+        let first = initial.unwrap_or((start + end) / 2.0);
+        // Math.round: half up.
+        let steps = ((in_range - first) / step + 0.5).floor() as i32;
+        let result = first + steps as f32 * step;
+        let position = to_slider(result, start, end);
+        if (0.0..=1.0).contains(&position) {
+            return Some(result);
+        }
+        Some(first + (steps - steps.signum()) as f32 * step)
+    }
+}
+
+/// `RangeInfo.scaledValueToSlider`.
+fn to_slider(value: f32, start: f32, end: f32) -> f32 {
+    if start == end {
+        0.5
+    } else {
+        (value - start) / (end - start)
+    }
+}
+
+/// `SliderImpl.valueToString`: whole numbers without a fraction, the rest as
+/// Java's `Float.toString`.
+pub fn number_string(v: f32) -> String {
+    if v == (v as i32) as f32 {
+        (v as i32).to_string()
+    } else {
+        crate::snbt::java_float(v)
+    }
+}
