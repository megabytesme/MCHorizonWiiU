+    pub fn new(x: f32, y: f32, width: f32, height: f32) -> Self {
+        Self {
+            value: String::new(),
+            cursor: 0,
+            highlight: 0,
+            display: 0,
+            max_length: 32,
+            bordered: true,
+            multiline: false,
+            x,
+            y,
+            width,
+            height,
+            focused: true,
+            focused_at: Instant::now(),
+            suggestion: None,
+            text_color: rgba(224, 224, 224, 255),
+            message: String::new(),
+            frame: None,
