+                );
+            }
+            if let Some(files) = open_with_trace(root, trace_lock) {
+                if trace_lock {
+                    prepared_trace!(
+                        "Horizon prepared files: Cafe separator candidate opened index={index}"
+                    );
+                }
+                return Some((files, rel));
+            }
+        }
+        if trace_lock {
+            index += 1;
