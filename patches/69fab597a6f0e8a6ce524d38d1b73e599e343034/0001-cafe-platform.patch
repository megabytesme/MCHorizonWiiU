+            })
+            .expect("main title declares its Options action")
+            .rect;
+        let options_target = session
+            .loading
+            .menu_key_targets()
+            .into_iter()
+            .find(|target| {
+                target
+                    .rect
+                    .iter()
+                    .zip(options_rect)
+                    .all(|(a, b)| (a - b).abs() < 0.5)
+            })
+            .unwrap_or_else(|| {
+                panic!(
+                    "main-menu Options rect {options_rect:?} is missing from focus targets {:?}",
+                    session.loading.menu_key_targets(),
