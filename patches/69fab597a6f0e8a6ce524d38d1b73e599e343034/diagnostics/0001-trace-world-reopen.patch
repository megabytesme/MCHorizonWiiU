diff --git a/tools/agent_control_e2e.py b/tools/agent_control_e2e.py
index 79a75d60fd1b7654ae0aa2d8f471b35dff12e656..26ff1aa2a1f36c9914a81d42456e8dc0778aae6e 100644
--- a/tools/agent_control_e2e.py
+++ b/tools/agent_control_e2e.py
@@ -906,10 +906,65 @@ def pause_save_scenario(d, out):
     return {'saved_on_pause': saved}
 
 
+def reopen_scenario(d, _out):
+    """Save and reopen twice in one game process, keeping blocks and weather."""
+    world = 'Reopen'
+    d('click_button', label='Singleplayer')
+    d('type', text=world, field='name', replace=True)
+    d('click_button', label='Allow Commands: OFF')
+    d('click_button', label='World')
+    d('type', text='12345', field='seed', replace=True)
+    d('click_button', label='Create New World')
+    d('wait_for', condition='loaded', timeout=400)
+    state = d('state')
+    assert state['gamemode'] == 'survival', state
+    x, y, z = state['player']['block_pos']
+    markers = []
+
+    for cycle, weather, raining, block in (
+        (0, 'rain', True, 'gold_block'),
+        (1, 'clear', False, 'emerald_block'),
+    ):
+        pos = (x + cycle, y + 3, z)
+        markers.append((pos, f'minecraft:{block}'))
+        d('command', command=f'setblock {pos[0]} {pos[1]} {pos[2]} minecraft:{block}')
+        d('command', command=f'weather {weather} 3600s')
+        # Weather changes arrive on the local play connection after the command reply.
+        deadline = time.monotonic() + 15
+        while True:
+            observed = d('state')['weather']
+            if observed['raining'] == raining or time.monotonic() >= deadline:
+                break
+            d('wait', ticks=10)
+        assert observed['raining'] == raining, observed
+        # For the integrated server, disconnect enters the same closing save as
+        # Save and Quit. This works without a rendered pause screen.
+        d('disconnect')
+        d('wait_for', condition='screen', value='title', timeout=120)
+        saved = [w for w in d('worlds')['worlds'] if w['folder'] == world]
+        assert len(saved) == 1 and not saved[0]['corrupted'], saved
+        d('open', world=world)
+        d('wait_for', condition='loaded', timeout=400)
+        state = d('state')
+        assert state['world'] == world and state['player'] is not None, state
+        assert state['weather']['raining'] == raining, state['weather']
+        for (bx, by, bz), expected in markers:
+            # The playable frame only requires the player's own section.
+            deadline = time.monotonic() + 30
+            while True:
+                found = d('block', x=bx, y=by, z=bz)
+                if found['loaded'] or time.monotonic() >= deadline:
+                    break
+                d('wait', ticks=10)
+            assert found['loaded'] and found['block'] == expected, found
+
+    return {'reopens': 2, 'persisted_blocks': len(markers)}
+
+
 SCENARIOS = {'survival': scenario, 'ui': ui_scenario, 'options': options_scenario, 'events': events_scenario,
              'consume': consume_scenario, 'use-screen': use_screen_scenario, 'pick': pick_scenario,
              'suggestions': suggestions_scenario, 'manage': manage_scenario, 'pause-save': pause_save_scenario,
-             'repro': repro_scenario}
+             'repro': repro_scenario, 'reopen': reopen_scenario}
 
 
 REFUSAL = "AI features are off: turn off No AI in the launcher's settings"
