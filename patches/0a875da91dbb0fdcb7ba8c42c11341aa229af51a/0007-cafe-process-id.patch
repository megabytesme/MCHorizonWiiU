diff --git a/wiiu/platform/src/process_id.c b/wiiu/platform/src/process_id.c
new file mode 100644
index 0000000000000000000000000000000000000000..226e34d6a18dddb988fc7108563fe547b0acf1cb
--- /dev/null
+++ b/wiiu/platform/src/process_id.c
@@ -0,0 +1,9 @@
+#include <stdint.h>
+#include <coreinit/debug.h>
+
+/* The Toolchain 1.0.0 Rust process::id entry point takes no arguments and
+ * returns u32. CafeOS provides the current process identity through WUT. */
+uint32_t __wrap__RNvNtCscY6WUuIVqxx_3std7process2id(void)
+{
+   return OSGetUPID();
+}
