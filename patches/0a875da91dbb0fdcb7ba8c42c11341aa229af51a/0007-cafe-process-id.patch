--- a/wiiu/loading_app/CMakeLists.txt
+++ b/wiiu/loading_app/CMakeLists.txt
@@ -180,6 +180,7 @@ add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../loading_host"
 add_executable(horizon_wiiu_loading_app
    "${WUT_CRT0_OBJECT}"
    memory.c
+   ../platform/src/process_id.c
    ../audio/audio.c
    ../platform/src/keyboard_bridge.c
    ../platform/src/mouse_bridge.c
@@ -211,6 +212,9 @@ if(NOT HORIZON_WIIU_PREBUILT_STATICLIB)
 endif()
 target_link_options(horizon_wiiu_loading_app PRIVATE
    -mcpu=750 -meabi -mhard-float
+   # std::process::id() panics on the pinned Cafe sysroot. Wrap that exact
