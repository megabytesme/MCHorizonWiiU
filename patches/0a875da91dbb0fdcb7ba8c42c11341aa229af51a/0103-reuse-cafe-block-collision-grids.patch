@@ -388,6 +427,41 @@ mod pipe_tests {
     use horizon_core::geometry::ShapeOp;
     use std::path::PathBuf;
 
+    #[test]
+    fn behaviour_shapes_reuse_exported_aliases_without_sharing_noncanonical_identities() {
+        let (registry, _) = BlockRegistry::from_facts_json_bytes(
+            br#"{"states":[["minecraft:air",true,false,"x","minecraft:air"]],
+                    "defaults":{"minecraft:air":0}}"#,
+        )
+        .unwrap();
+        let block = VoxelShape::block();
+        let ordinary = block.fresh_identity();
+        let equivalent = ordinary.fresh_identity();
+        let cached = CachedCollisionRegistry {
+            registry: &registry,
+            shapes: vec![ordinary.clone(), equivalent.clone(), block.clone()],
+            state_shapes: vec![1, -1, 2, 1, 0, 2, 0],
+            grid_count: 1,
+            canonical_identities: true,
+            contexts: HashMap::new(),
+            outline_edges: HashMap::new(),
+        };
+        let (local, indices) = cached.behaviour_shapes(false);
+        assert_eq!(indices, [0, -1, 1, 0, 2, 1, 2]);
+        assert!(local[0].same_identity(&equivalent));
+        assert!(local[1].same_identity(&block));
+        assert!(local[2].same_identity(&ordinary));
+
+        let (separate, indices) = cached.behaviour_shapes(true);
+        assert_eq!(indices, [0, -1, 1, 0, 2, 1, 2]);
+        assert!(!separate[0].same_identity(&equivalent));
+        assert!(!separate[2].same_identity(&ordinary));
+        assert!(!separate[0].same_identity(&separate[2]));
+        assert!(separate[1].same_identity(&block));
+        assert_eq!(separate[0].boxes(), local[0].boxes());
+        assert_eq!(separate[2].boxes(), local[2].boxes());
+    }
+
