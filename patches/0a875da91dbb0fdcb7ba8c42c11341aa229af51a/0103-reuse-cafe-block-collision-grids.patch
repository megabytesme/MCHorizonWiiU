+    /// The behaviour table's dense shape indices, assigned in first-state-use
+    /// order. The export reader gives every shape entry a distinct identity,
+    /// even when different entries share the same geometry.
+    pub(crate) fn behaviour_shapes(
+        &self,
+        independent_identities: bool,
+    ) -> (Vec<VoxelShape>, Vec<i32>) {
+        let mut index = vec![-1; self.shapes.len()];
+        let mut shapes = Vec::new();
+        let canonical = [VoxelShape::empty(), VoxelShape::block()];
+        let states = self
+            .state_shapes
+            .iter()
+            .map(|&id| {
+                if id < 0 {
+                    return -1;
+                }
+                let new = &mut index[id as usize];
+                if *new < 0 {
+                    let shape = &self.shapes[id as usize];
+                    *new = shapes.len() as i32;
+                    shapes.push(
+                        if independent_identities
+                            && !canonical
+                                .iter()
+                                .any(|singleton| singleton.same_identity(shape))
+                        {
+                            shape.fresh_identity()
+                        } else {
+                            shape.clone()
+                        },
+                    );
+                }
+                *new
+            })
+            .collect();
+        (shapes, states)
+    }
