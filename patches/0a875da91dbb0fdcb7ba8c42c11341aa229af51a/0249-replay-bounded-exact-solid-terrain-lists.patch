@@ -0,0 +1,278 @@
+//! Optional two-output cache of the exact ordinary solid draw sequence.
+use super::{solid_draw_plan::SolidDraw, solid_list_census::ViewKey, SectionKey, TerrainSection};
+use std::{collections::HashMap, ffi::c_void, ptr::NonNull};
+
+pub(super) const MAX_DRAWS: usize = 174;
+
+#[repr(C)]
+pub(super) struct ListDraw {
+    section: *mut c_void,
+    clip_rows: *const f32,
+    origin: [f32; 4],
+}
+
+#[repr(C)]
+#[derive(Default)]
+pub(super) struct Uses {
+    queued_after: [i64; 2],
+    receipt: i64,
+    pub(super) recovered: u32,
+}
+
+impl Uses {
+    pub(super) fn sealed(&self, called: [bool; 2]) -> bool {
+        let queued = self.queued_after.map(|floor| floor > 0);
+        if self.queued_after == [0; 2] && called == [false; 2] {
+            return true;
+        }
+        self.receipt > self.queued_after[0].max(self.queued_after[1]).max(0)
+            && ((queued == called && self.queued_after.iter().all(|&floor| floor >= 0))
+                || self.recovered != 0)
+    }
+}
+
+unsafe extern "C" {
+    fn horizon_gx2_solid_list_create() -> *mut c_void;
+    fn horizon_gx2_solid_list_destroy(list: *mut c_void);
+    fn horizon_gx2_solid_list_eligible(terrain: *mut c_void) -> bool;
+    fn horizon_gx2_solid_list_record(
+        list: *mut c_void,
+        terrain: *mut c_void,
+        draws: *const ListDraw,
+        count: u32,
+    ) -> bool;
+    fn horizon_gx2_solid_list_queue(list: *const c_void, uses: *mut Uses, target: u32) -> bool;
+}
+
+struct Arena(NonNull<c_void>);
+impl Drop for Arena {
+    fn drop(&mut self) {
+        // The synchronous host has already sealed every queued use.
+        unsafe { horizon_gx2_solid_list_destroy(self.0.as_ptr()) };
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) struct Key {
+    pub(super) view: ViewKey,
+    pub(super) terrain: NonNull<c_void>,
+    pub(super) world_targets: NonNull<c_void>,
+    pub(super) output_viewport: [u32; 4],
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct Counts {
+    pub(super) tested: usize,
+    pub(super) drawn: usize,
+    pub(super) indices: usize,
+}
+
+pub(super) struct Frame {
+    sequence: u32,
+    keys: [Option<Key>; 2],
+    pub(super) uses: *mut Uses,
+    pub(super) called: [bool; 2],
+}
+
+impl Frame {
+    pub(super) fn new(sequence: u32, uses: *mut Uses) -> Self {
+        Self {
+            sequence,
+            keys: [None; 2],
+            called: [false; 2],
+            uses,
+        }
+    }
+}
+
+#[derive(Default)]
+struct Slot {
+    recent: Option<(u32, Key)>,
+    cached: Option<(Key, Counts)>,
+    refused: Option<Key>,
+    arena: Option<Arena>,
+    allocation_failed: bool,
+}
+
+impl Slot {
+    fn stable(&self, now: u32, key: Key) -> bool {
+        self.recent
+            .is_some_and(|(prior, existing)| prior.checked_add(1) == Some(now) && key == existing)
+    }
+
+    fn invalidate(&mut self) {
+        self.recent = None;
+        self.cached = None;
+        self.refused = None;
+    }
+}
+
+#[derive(Default)]
+pub(super) struct Trial {
+    slots: [Slot; 2],
+    scratch: Vec<ListDraw>,
+}
+
+impl Trial {
+    pub(super) fn invalidate(&mut self) {
+        for slot in &mut self.slots {
+            slot.invalidate();
+        }
+    }
+
+    pub(super) fn observe(&self, frame: &mut Frame, index: usize, key: Key) -> bool {
+        frame.keys[index] = Some(key);
+        let slot = &self.slots[index];
+        slot.stable(frame.sequence, key) && !slot.allocation_failed && slot.refused != Some(key)
+    }
+
+    pub(super) fn finish(&mut self, frame: Option<Frame>, complete: bool) {
+        if let Some(frame) = frame.filter(|_| complete) {
+            for (slot, key) in self.slots.iter_mut().zip(frame.keys) {
+                slot.recent = key.map(|key| (frame.sequence, key));
+            }
+        } else {
+            self.invalidate();
+        }
+    }
+
+    pub(super) fn draw(
+        &mut self,
+        frame: &mut Frame,
+        index: usize,
+        terrain: NonNull<c_void>,
+        tested: usize,
+        draws: &[SolidDraw],
+        sections: &HashMap<SectionKey, TerrainSection>,
+    ) -> Option<(Counts, bool)> {
+        let key = frame.keys[index]?;
+        let slot = &mut self.slots[index];
+        let terrain = terrain.as_ptr();
+        if !unsafe { horizon_gx2_solid_list_eligible(terrain) } || draws.is_empty() {
+            slot.refused = Some(key);
+            return None;
+        }
+        if slot.arena.is_none() {
+            slot.arena = unsafe { NonNull::new(horizon_gx2_solid_list_create()) }.map(Arena);
+            slot.allocation_failed = slot.arena.is_none();
+        }
+        let arena = slot.arena.as_ref()?.0.as_ptr();
+        let (counts, warm) = match slot.cached {
+            Some((cached, counts)) if cached == key => (counts, true),
+            _ => {
+                slot.cached = None;
+                let scratch = &mut self.scratch;
+                scratch.clear();
+                if draws.len() > MAX_DRAWS || scratch.try_reserve_exact(draws.len()).is_err() {
+                    slot.refused = Some(key);
+                    return None;
+                }
+                let mut indices = 0;
+                for draw in draws {
+                    let section = sections.get(&draw.key)?.solid.as_ref()?;
+                    let [x, y, z] = draw.origin.map(|value| value as f32);
+                    scratch.push(ListDraw {
+                        section: section.native.as_ptr(),
+                        clip_rows: draw.clip.rows.as_ptr().cast(),
+                        origin: [x, y, z, 0.0],
+                    });
+                    indices += section.vertex_count as usize / 4 * 6;
+                }
+                // Pointers into the ordered plan only live through this call.
+                let recorded = unsafe {
+                    horizon_gx2_solid_list_record(
+                        arena,
+                        terrain,
+                        scratch.as_ptr(),
+                        draws.len() as u32,
+                    )
+                };
+                scratch.clear();
+                if !recorded {
+                    slot.refused = Some(key);
+                    return None;
+                }
+                let counts = Counts {
+                    tested,
+                    drawn: draws.len(),
+                    indices,
+                };
+                slot.cached = Some((key, counts));
+                (counts, false)
+            }
+        };
+        frame.called[index] =
+            unsafe { horizon_gx2_solid_list_queue(arena, frame.uses, index as u32) };
+        frame.called[index].then_some((counts, warm))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn key(x: f64) -> Key {
+        Key {
+            view: ViewKey::new(
+                [x, 1.0, 2.0],
+                [[1.0; 4]; 4],
+                -64,
+                [1280, 720],
+                [0, 0, 960, 540],
+                true,
+            )
+            .unwrap(),
+            terrain: NonNull::dangling(),
+            world_targets: NonNull::dangling(),
+            output_viewport: [0, 0, 1280, 720],
+        }
+    }
+
+    #[test]
+    fn needs_preceding_complete_output_and_exact_view() {
+        let mut trial = Trial::default();
+        let mut uses = Uses::default();
+        let mut first = Frame::new(20, &raw mut uses);
+        assert!(!trial.observe(&mut first, 0, key(0.0)));
+        assert!(!trial.observe(&mut first, 1, key(32.)));
+        trial.finish(Some(first), true);
+        let mut next = Frame::new(21, &raw mut uses);
+        assert!(!trial.observe(&mut next, 0, key(-0.0)));
+        assert!(trial.observe(&mut next, 1, key(32.)));
+        trial.finish(Some(next), false);
+        let mut after = Frame::new(22, &raw mut uses);
+        assert!(!trial.observe(&mut after, 1, key(32.)));
+    }
+
+    #[test]
+    fn receipt_must_cover_every_observed_call() {
+        let mut uses = Uses::default();
+        assert!(uses.sealed([false; 2]));
+        assert!(!uses.sealed([true, false]));
+        uses.queued_after = [10, 15];
+        uses.receipt = 15;
+        assert!(!uses.sealed([true; 2]));
+        uses.receipt = 16;
+        assert!(uses.sealed([true; 2]));
+        assert!(!uses.sealed([true, false]));
+        uses.queued_after = [10, -3];
+        assert!(!uses.sealed([true, false]));
+        uses.recovered = 1;
+        assert!(uses.sealed([true; 2]));
+    }
+
+    #[test]
+    fn seam_invalidation_refuses_same_address_and_sequence_gap() {
+        let mut trial = Trial::default();
+        let mut uses = Uses::default();
+        let mut first = Frame::new(3, &raw mut uses);
+        assert!(!trial.observe(&mut first, 0, key(0.0)));
+        trial.finish(Some(first), true);
+        let mut after_gap = Frame::new(5, &raw mut uses);
+        assert!(!trial.observe(&mut after_gap, 0, key(0.0)));
+        trial.finish(Some(after_gap), true);
+        trial.invalidate();
+        let mut next = Frame::new(6, &raw mut uses);
+        assert!(!trial.observe(&mut next, 0, key(0.0)));
+    }
+}
