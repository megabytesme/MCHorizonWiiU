+   const OSTime list_floor = max_submitted(uses->queued_after[0], uses->queued_after[1]);
+   const OSTime submitted = GX2GetLastSubmittedTimeStamp();
+   const OSTime retired = GX2GetRetiredTimeStamp();
+   if (before_finish >= list_floor && submitted > before_finish && retired >= submitted) {
+      uses->receipt = submitted;
+      return 0;
+   }
+   return recover_solid_lists(uses, max_submitted(before_finish, submitted));
+}
