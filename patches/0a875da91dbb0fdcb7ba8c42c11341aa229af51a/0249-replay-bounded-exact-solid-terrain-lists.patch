+enum {
+   SOLID_LIST_MAX_DRAWS = 174,
+   SOLID_LIST_MAX_DRAW_BYTES = 256,
+   SOLID_LIST_CAP = 64 * 1024,
+   SOLID_LIST_ALIGN = 256,
+   SOLID_LIST_LINE = 32,
+   SOLID_LIST_GUARD = 0x6b,
+};
+_Static_assert(SOLID_LIST_MAX_DRAWS * SOLID_LIST_MAX_DRAW_BYTES <= SOLID_LIST_CAP,
+               "solid list draw budget exceeds its arena");
+
+struct HorizonGx2SolidList {
+   _Alignas(SOLID_LIST_ALIGN) uint8_t initial_guard[SOLID_LIST_ALIGN];
+   uint8_t commands[SOLID_LIST_CAP];
+   uint8_t final_guard[SOLID_LIST_ALIGN];
+   uint32_t bytes;
+};
+
+HorizonGx2SolidList *horizon_gx2_solid_list_create(void)
+{
+   HorizonGx2SolidList *list = MEMAllocFromDefaultHeapEx(sizeof(*list), SOLID_LIST_ALIGN);
+   if (list) list->bytes = 0;
+   return list;
+}
+
+void horizon_gx2_solid_list_destroy(HorizonGx2SolidList *list)
+{
+   if (list) MEMFreeToDefaultHeap(list);
+}
+
+bool horizon_gx2_solid_list_eligible(HorizonGx2Terrain *t)
+{
+   return t && t->bound && t->shader.vertexShader &&
+          t->shader.vertexShader->mode == GX2_SHADER_MODE_UNIFORM_REGISTER &&
+          t->section_uniform_words >= 16 && !t->legacy_attributes && !t->legacy_uniforms &&
+          !t->half_active && !t->half_allowed && !t->atlas_cells && !t->solid_back_culling &&
+          !t->opaque_pixel.shader &&
+#ifdef HORIZON_GX2_CLEAR_FOG
+          !t->near_fog_pixel && !t->clear_fog_bound && !t->opaque_bound &&
+#endif
+          GX2RBufferExists(&t->quad_indices);
+}
+
+static void hold_solid_recorder(const char *reason)
+{
+   OSReport("Horizon GX2 solid list retaining ownership: %s\n", reason);
+   for (;;) OSSleepTicks(OSMillisecondsToTicks(16));
+}
+
+static void require_solid_recorder_closed(void)
+{
+   if (GX2GetDisplayListWriteStatus()) hold_solid_recorder("recorder did not close");
+}
+
+static bool solid_list_guard_ok(const uint8_t *guard)
+{
+   for (unsigned i = 0; i < SOLID_LIST_LINE; ++i)
+      if (guard[i] != SOLID_LIST_GUARD) return false;
+   return true;
+}
+
+bool horizon_gx2_solid_list_record(HorizonGx2SolidList *list, HorizonGx2Terrain *t,
+                                   const HorizonGx2SolidListDraw *draws, uint32_t count)
+{
+   if (!list) return false;
+   list->bytes = 0;
+   if (!draws || !count || count > SOLID_LIST_MAX_DRAWS ||
+       !horizon_gx2_solid_list_eligible(t)) return false;
+   for (uint32_t i = 0; i < count; ++i) {
+      HorizonGx2TerrainSection *section = draws[i].section;
+      if (!section || !draws[i].clip_rows || section->atlas_cells ||
+          section->buffer.elemSize != sizeof(HorizonTerrainVertex) ||
+          !section->vertex_count || section->vertex_count % 4 || section->vertex_count > 65536 ||
+          GX2RBufferExists(&section->sorted_indices) || !GX2RBufferExists(&section->buffer))
+         return false;
+      for (unsigned j = 0; j < 16; ++j)
+         if (!isfinite(draws[i].clip_rows[j])) return false;
+      for (unsigned j = 0; j < 4; ++j)
+         if (!isfinite(draws[i].origin[j])) return false;
+   }
+
+   require_solid_recorder_closed();
+   uint8_t *head = list->initial_guard + SOLID_LIST_ALIGN - SOLID_LIST_LINE;
+   uint8_t *tail = list->final_guard;
+   memset(head, SOLID_LIST_GUARD, SOLID_LIST_LINE);
+   memset(tail, SOLID_LIST_GUARD, SOLID_LIST_LINE);
+   DCFlushRange(head, SOLID_LIST_LINE);
+   DCFlushRange(tail, SOLID_LIST_LINE);
+   DCInvalidateRange(list->commands, SOLID_LIST_CAP);
+   GX2BeginDisplayListEx(list->commands, SOLID_LIST_CAP, FALSE);
+   if (!GX2GetDisplayListWriteStatus()) return false;
+   bool ok = true;
+   for (uint32_t i = 0; i < count; ++i) {
+      if (horizon_gx2_terrain_draw_bound(t, draws[i].section,
+                                        draws[i].clip_rows, draws[i].origin) != 0) {
+         ok = false;
+         break;
+      }
+   }
+   const uint32_t bytes = GX2EndDisplayList(list->commands);
+   require_solid_recorder_closed();
+   DCInvalidateRange(head, SOLID_LIST_LINE);
+   DCInvalidateRange(tail, SOLID_LIST_LINE);
+   if (bytes > SOLID_LIST_CAP || !solid_list_guard_ok(head) || !solid_list_guard_ok(tail))
+      hold_solid_recorder("recording exceeded the arena");
+   if (!ok || !bytes || bytes % SOLID_LIST_LINE || bytes > count * SOLID_LIST_MAX_DRAW_BYTES)
+      return false;
+   DCFlushRange(list->commands, bytes);
+   OSMemoryBarrier();
+   list->bytes = bytes;
+   return true;
+}
+
+bool horizon_gx2_solid_list_queue(const HorizonGx2SolidList *list,
+                                  HorizonGx2SolidListUses *uses, uint32_t target)
+{
+   if (!list || !list->bytes || !uses || target > 1 || uses->queued_after[target]) return false;
+   require_solid_recorder_closed();
+   const OSTime floor = GX2GetLastSubmittedTimeStamp();
+   if (floor <= 0) return false;
+   uses->queued_after[target] = floor;
+   GX2CallDisplayList(list->commands, list->bytes);
+   return true;
+}
