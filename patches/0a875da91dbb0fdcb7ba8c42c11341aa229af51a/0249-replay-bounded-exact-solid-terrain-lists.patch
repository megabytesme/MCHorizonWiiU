+static OSTime max_submitted(OSTime a, OSTime b)
+{
+   return a > b ? a : b;
+}
+
+static OSTime recover_solid_lists(HorizonGx2SolidListUses *uses, OSTime prior)
+{
+   /* Submit a known nonvisual command. An empty flush need not advance a
+    * timestamp. No callback, resource release or ProcUI pump during recovery. */
+   uses->recovered = 1;
+   static _Alignas(32) GX2Semaphore fence[32 / sizeof(GX2Semaphore)];
+   const OSTime start = OSGetTime();
+   const OSTime list_floor = max_submitted(uses->queued_after[0], uses->queued_after[1]);
+   const OSTime floor = max_submitted(max_submitted(list_floor, prior),
+                                     GX2GetLastSubmittedTimeStamp());
+   DCFlushRange(fence, sizeof(fence));
+   GX2SetSemaphore(fence, GX2_SEMAPHORE_ACTION_SIGNAL);
+   GX2Flush();
+   OSTime latest = GX2GetLastSubmittedTimeStamp();
+   GX2DrawDone();
+   OSReport("Horizon GX2 solid list retaining ownership until recovery retires\n");
+   for (;;) {
+      const OSTime current = GX2GetLastSubmittedTimeStamp();
+      if (current > floor && current >= latest && GX2GetRetiredTimeStamp() >= current) {
+         uses->receipt = current;
+         return OSGetTime() - start;
+      }
+      latest = max_submitted(latest, current);
+      OSSleepTicks(OSMillisecondsToTicks(16));
+   }
+}
+
+void horizon_loading_host_recover_solid_lists(HorizonGx2SolidListUses *uses)
+{
+   recover_solid_lists(uses, uses->receipt);
+}
+
+static OSTime retire_solid_lists(HorizonGx2SolidListUses *uses, OSTime before_finish)
