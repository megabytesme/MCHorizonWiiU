+    let preload = std::mem::replace(
+        &mut *PRELOAD.lock().unwrap_or_else(|e| e.into_inner()),
+        Preload::Idle,
+    );
+    if let Preload::Started { thread, .. } = preload {
+        let _ = thread.join();
+    }
+    let workers = std::mem::take(
+        &mut *CAFE_PRELOAD_WORKERS.lock().unwrap_or_else(|e| e.into_inner()),
+    );
+    for worker in workers {
+        let _ = worker.join();
+    }
+    forget_cached_world_data();
+}
