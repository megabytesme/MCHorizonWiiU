+
+    #[derive(Default)]
+    struct Memory(Option<zeroize::Zeroizing<Vec<u8>>>);
+
+    impl Persistence for Memory {
+        fn load(&self) -> io::Result<Option<zeroize::Zeroizing<Vec<u8>>>> {
+            Ok(self.0.clone())
+        }
+
+        fn save(&mut self, bytes: &[u8]) -> io::Result<()> {
