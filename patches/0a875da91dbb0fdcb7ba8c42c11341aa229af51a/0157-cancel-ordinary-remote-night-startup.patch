new file mode 100644
index 0000000000000000000000000000000000000000..e464c018be9f04355f196de4e377ee2070a97cf7
--- /dev/null
+++ b/wiiu/loading_app/src/night_startup.rs
@@ -0,0 +1,269 @@
+//! Ownership and cancellation for one ordinary remote startup.
+use std::sync::Mutex;
+
+use horizon_wiiu_mcp::oauth::{self, Principal};
+use serde_json::{json, Value};
+
+use super::launch_authorized;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Phase {
+    Queued,
+    Loading,
+    Draining,
+    Handoff,
+    Cancelled,
+    Failed,
+}
+
+impl Phase {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Queued => "queued",
+            Self::Loading => "loading",
+            Self::Draining => "draining",
+            Self::Handoff => "handoff_started",
+            Self::Cancelled => "cancelled",
+            Self::Failed => "failed",
+        }
+    }
+
+    fn cancellable(self) -> bool {
+        matches!(self, Self::Queued | Self::Loading)
+    }
+}
+
+struct State {
+    phase: Phase,
+    cancel: Option<Principal>,
+}
+
+impl State {
+    fn poll_cancel(&mut self) -> bool {
+        if self.phase.cancellable()
+            && self
+                .cancel
+                .take()
+                .is_some_and(|principal| launch_authorized(&principal))
+        {
+            self.phase = Phase::Draining;
+        }
+        self.phase == Phase::Draining
+    }
+}
+
+pub(crate) struct Startup {
+    pub(super) id: String,
+    pub(super) owner: String,
+    state: Mutex<State>,
+}
+
+impl Startup {
+    pub(super) fn new(owner: &Principal) -> Result<Self, oauth::Error> {
+        let id = u128::from_be_bytes(oauth::random_bytes()?);
+        Ok(Self {
+            id: format!("{id:032x}"),
+            owner: owner.client_id.clone(),
+            state: Mutex::new(State {
+                phase: Phase::Queued,
+                cancel: None,
+            }),
+        })
+    }
+
+    pub(super) fn status(&self) -> Value {
+        let state = self.state.lock().unwrap();
+        json!({
+            "launch_id": self.id,
+            "phase": state.phase.name(),
+            "cancel_requested": state.cancel.is_some() || state.phase == Phase::Draining,
+        })
+    }
+
+    pub(super) fn request_cancel(&self, principal: &Principal) -> bool {
+        let mut state = self.state.lock().unwrap();
+        if self.owner != principal.client_id
+            || !launch_authorized(principal)
+            || !state.phase.cancellable()
+        {
+            return false;
+        }
+        state.cancel = Some(principal.clone());
+        true
+    }
+
+    pub(super) fn begin_loading(&self) -> bool {
+        let mut state = self.state.lock().unwrap();
+        if state.phase != Phase::Queued || state.poll_cancel() {
+            return false;
+        }
+        state.phase = Phase::Loading;
+        true
+    }
+
+    pub(crate) fn poll_cancel(&self) -> bool {
+        self.state.lock().unwrap().poll_cancel()
+    }
+
+    /// Cancel and handoff compete under the same lock. The winner determines
+    /// whether the foreground returns to Night or starts the pending game.
+    pub(crate) fn begin_handoff(&self) -> bool {
+        let mut state = self.state.lock().unwrap();
+        if state.phase != Phase::Loading || state.poll_cancel() {
+            return false;
+        }
+        state.phase = Phase::Handoff;
+        true
+    }
+
+    pub(crate) fn finish(&self, returned: bool) {
+        let mut state = self.state.lock().unwrap();
+        if !returned {
+            state.phase = Phase::Failed;
+        } else if matches!(
+            state.phase,
+            Phase::Queued | Phase::Loading | Phase::Draining
+        ) {
+            state.phase = Phase::Cancelled;
+        }
+        state.cancel = None;
+    }
+}
