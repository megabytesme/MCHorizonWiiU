+
+    fn pair(oauth: &mut OAuth<Memory>, now: u64, label: &str) -> (Principal, Tokens) {
+        let redirect = "http://127.0.0.1:55171/oauth/callback";
+        oauth.open_pairing(now);
+        let client = oauth
+            .register(now, label, &[redirect.into()], true)
+            .unwrap();
+        let request = oauth
+            .authorization(
+                now,
+                AuthorizeRequest {
+                    client_id: &client,
+                    redirect_uri: redirect,
+                    scope: Some("launcher.read launcher.manage game.control"),
+                    challenge: "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM",
+                    state: "fixture",
+                    resource: None,
+                },
+            )
+            .unwrap();
+        let approval = oauth.begin_consent(now, request).unwrap();
+        oauth.decide(now, &approval, true).unwrap();
+        let url = oauth
+            .finish(now, &approval, "https://horizon.test")
+            .unwrap()
+            .unwrap();
+        let code = url.query_pairs().find(|(key, _)| key == "code").unwrap().1;
+        let tokens = oauth
+            .exchange(
+                now,
+                &client,
+                redirect,
+                &code,
+                "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk",
+                None,
+            )
+            .unwrap();
+        (
+            oauth.authenticate(now, &tokens.access_token).unwrap(),
+            tokens,
+        )
+    }
+
+    #[test]
+    fn authorized_cancel_and_game_handoff_have_one_winner() {
+        super::super::load_policy(Policy {
+            enabled: true,
+            allow_game: true,
+            allow_launch: true,
+            no_ai: false,
+        });
+        let now = SystemTime::now()
+            .duration_since(SystemTime::UNIX_EPOCH)
+            .unwrap()
+            .as_secs();
+        let mut auth = OAuth::open(Memory::default(), "https://horizon.test/mcp".into()).unwrap();
+        let (owner, tokens) = pair(&mut auth, now, "Launch owner");
+        let (other, _) = pair(&mut auth, now, "Another client");
+        let refreshed = auth
+            .refresh(
+                now,
+                &owner.client_id,
+                tokens.refresh_token.as_deref().unwrap(),
+                None,
+                None,
+            )
+            .unwrap();
+        let caller = auth.authenticate(now, &refreshed.access_token).unwrap();
+
+        let cancelled = Startup::new(&owner).unwrap();
+        assert!(cancelled.begin_loading());
+        assert!(!cancelled.request_cancel(&other));
+        std::thread::scope(|scope| {
+            let (allow_handoff, wait) = mpsc::channel();
+            let startup = &cancelled;
+            let foreground = scope.spawn(move || {
+                wait.recv().unwrap();
+                startup.begin_handoff()
+            });
+            assert!(cancelled.request_cancel(&caller));
+            allow_handoff.send(()).unwrap();
+            assert!(!foreground.join().unwrap());
+        });
+        assert_eq!(cancelled.status()["phase"], "draining");
+        cancelled.finish(true);
+        assert_eq!(cancelled.status()["phase"], "cancelled");
+
+        let handed_off = Startup::new(&owner).unwrap();
+        assert_ne!(handed_off.id, cancelled.id);
+        assert!(handed_off.begin_loading());
+        std::thread::scope(|scope| {
+            let (sealed, wait) = mpsc::channel();
+            let startup = &handed_off;
+            let foreground = scope.spawn(move || {
+                let allowed = startup.begin_handoff();
+                sealed.send(allowed).unwrap();
+            });
+            assert!(wait.recv().unwrap());
+            assert!(!handed_off.request_cancel(&caller));
+            foreground.join().unwrap();
+        });
+        assert!(!handed_off.poll_cancel());
+        assert_eq!(handed_off.status()["phase"], "handoff_started");
+        handed_off.finish(false);
+        assert_eq!(handed_off.status()["phase"], "failed");
+
+        let revoked = Startup::new(&owner).unwrap();
+        assert!(revoked.begin_loading());
+        assert!(revoked.request_cancel(&caller));
+        auth.revoke_client(&owner.client_id).unwrap();
+        assert!(revoked.begin_handoff());
+        assert!(!revoked.poll_cancel());
+        super::super::load_policy(Policy::default());
+    }
