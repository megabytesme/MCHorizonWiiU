+/// A bounded observation of one column after the current streaming update.
+#[cfg(target_os = "cafe")]
+pub struct CafeMeshColumnSample {
+    pub in_view: bool,
+    pub region_resident: bool,
+    pub stable_light: bool,
+    pub dirty: u16,
+    pub ready_unserved: u16,
+    /// The latest mesh revision is outstanding, regardless of worker claim.
+    pub active: u16,
+}
+
 /// Snapshot only after a scan found no missing candidates. Public range fields
 /// and `World::chunks` can change without going through Streaming, so compare
 /// their values and structural membership token rather than a frame timeout.
@@ -1797,6 +1809,44 @@ impl Streaming {
         }
         Some(Arc::new(region))
     }
+    #[inline]
+    fn mesh_neighborhood_lit(&self, x: i32, z: i32) -> bool {
+        (-1..=1).all(|dz| {
+            (-1..=1).all(|dx| {
+                let n = (x + dx, z + dz);
+                self.lit.contains(&n) && !self.lighting.contains_key(&n)
+            })
+        })
+    }
+
+    #[cfg(target_os = "cafe")]
+    pub fn sample_cafe_mesh_column(&self, world: &World, x: i32, z: i32) -> CafeMeshColumnSample {
+        let in_view = self.mesh && !self.paused && self.ranges().in_view(x, z);
+        // This is equivalent to looking up the nine columns in Self::region,
+        // without cloning their Arcs for the diagnostic.
+        let region_resident = world.chunks.surrounded((x, z));
+        let stable_light = region_resident && self.mesh_neighborhood_lit(x, z);
+        let sections = world.layout().sections().min(SectionMask::CAPACITY);
+        let dirty = world.dirty_sections.column_mask((x, z)) & SectionMask::below(sections);
+        let mut active = 0;
+        let mut ready_unserved = 0;
+        for sy in 0..sections {
+            if self.is_meshing((x, sy as i32, z)) {
+                active += 1;
+            } else if in_view && stable_light && dirty.contains(sy) {
+                ready_unserved += 1;
+            }
+        }
+        CafeMeshColumnSample {
+            in_view,
+            region_resident,
+            stable_light,
+            dirty: dirty.len() as u16,
+            ready_unserved,
+            active,
+        }
+    }
