 //! Bounded submission: the light and mesh stages hand the workers only the
 //! nearest of what is ready.
 
+use crate::section_mask::SectionMask;
+
 /// The nearest `room` of the `candidates`, ordered: the light and mesh
 /// stages submit bounded work, chosen from everything that is ready each
 /// `update`, so what runs is always the nearest of what is left — chosen
@@ -15,10 +17,45 @@ pub(super) fn nearest_first<T: Ord>(candidates: &mut Vec<T>, room: usize) {
     candidates.sort_unstable();
 }
 
+/// Reserve part of one column from a shared section-job budget. Both
+/// returned masks keep the original section order.
+pub(super) fn mesh_batch(sections: SectionMask, room: &mut usize) -> (SectionMask, SectionMask) {
+    let count = sections.len();
+    if count <= *room {
+        *room -= count;
+        return (sections, SectionMask::EMPTY);
+    }
+    let cutoff = sections
+        .iter()
+        .nth(*room)
+        .expect("at least one section is deferred");
+    *room = 0;
+    let deferred = sections.from(cutoff);
+    (sections & !deferred, deferred)
+}
