+        let replacement = ResourceSource::indexed(Default::default());
+        client.reload(&replacement);
+        assert!(client.registry_for(&source).is_none());
+        assert!(server.registry_for(&replacement).is_none());
+        assert!(client.registry_for(&replacement).unwrap().is_empty());
+        let server_registry = server.registry_for(&source).unwrap();
+        assert!(server_registry.get("example:tone").is_some());
+        assert!(server_registry.get("example:extra").is_some());
+        assert!(!server.backend.live);
+    }
