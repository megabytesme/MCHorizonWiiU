diff --git a/crates/horizon-client/src/platform/cafe_performance.rs b/crates/horizon-client/src/platform/cafe_performance.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ef144432dbce1571a8d43f8e4e245c47603a3c6a
--- /dev/null
+++ b/crates/horizon-client/src/platform/cafe_performance.rs
@@ -0,0 +1,164 @@
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy, Default)]
+pub struct CafeFrameWork {
+    pub presented: [bool; 2],
+    pub submission: Duration,
+    pub gpu_wait: Duration,
+    pub uploaded_sections: u64,
+    pub uploaded_bytes: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(in crate::game) enum Phase {
+    Loading,
+    Title,
+    Gameplay,
+    Menu,
+}
+
+impl Phase {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Loading => "loading",
+            Self::Title => "title",
+            Self::Gameplay => "gameplay",
+            Self::Menu => "menu",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+pub(in crate::game) struct Totals {
+    pub(in crate::game) meshed: u64,
+    pub(in crate::game) server_ticks: Option<u32>,
+    pub(in crate::game) combined_flips: Option<u32>,
+}
+
+#[derive(Default)]
+pub(in crate::game) struct CafePerformance {
+    active: Option<Window>,
+    pub(in crate::game) latest: Option<Sample>,
+    pub(in crate::game) presented: u64,
+}
+
+struct Window {
+    phase: Phase,
+    start: Instant,
+    base: Totals,
+    iterations: u32,
+    frames: u32,
+    outputs: [u32; 2],
+    cpu: Duration,
+    submission: Duration,
+    gpu_wait: Duration,
+    uploaded_sections: u64,
+    uploaded_bytes: u64,
+}
+
+pub(in crate::game) struct Sample {
+    window: Window,
+    end: Instant,
+    totals: Totals,
+}
+
+impl CafePerformance {
+    pub(in crate::game) fn begin(&mut self, phase: Phase, now: Instant, totals: Totals) {
+        if self
+            .active
+            .as_ref()
+            .is_none_or(|window| window.phase != phase)
+        {
+            self.latest = None;
+            self.active = Some(Window {
+                phase,
+                start: now,
+                base: totals,
+                iterations: 0,
+                frames: 0,
+                outputs: [0; 2],
+                cpu: Duration::ZERO,
+                submission: Duration::ZERO,
+                gpu_wait: Duration::ZERO,
+                uploaded_sections: 0,
+                uploaded_bytes: 0,
+            });
+        }
+    }
+
+    pub(in crate::game) fn finish(
+        &mut self,
+        now: Instant,
+        totals: Totals,
+        built: bool,
+        redraw: Duration,
+        work: CafeFrameWork,
+    ) -> bool {
+        let Some(window) = self.active.as_mut() else {
+            return false;
+        };
+        window.iterations += 1;
+        window.frames += u32::from(built);
+        for (count, success) in window.outputs.iter_mut().zip(work.presented) {
+            *count += u32::from(success);
+        }
+        self.presented += u64::from(work.presented == [true; 2]);
+        window.cpu += redraw.saturating_sub(work.submission);
+        window.submission += work.submission.saturating_sub(work.gpu_wait);
+        window.gpu_wait += work.gpu_wait;
+        window.uploaded_sections += work.uploaded_sections;
+        window.uploaded_bytes += work.uploaded_bytes;
+        if now.duration_since(window.start) < Duration::from_secs(2) {
+            return false;
+        }
+
+        let window = self.active.take().unwrap();
+        self.begin(window.phase, now, totals);
+        self.latest = Some(Sample {
+            window,
+            end: now,
+            totals,
+        });
+        true
+    }
+}
+
+impl Sample {
+    pub(in crate::game) fn paired_fps(&self) -> f64 {
+        f64::from(self.window.outputs[0].min(self.window.outputs[1])) / self.seconds()
+    }
+
+    fn seconds(&self) -> f64 {
+        self.end.duration_since(self.window.start).as_secs_f64()
+    }
+
+    pub(in crate::game) fn json(&self, session_start: Instant, now: Instant) -> serde_json::Value {
+        let window = &self.window;
+        let seconds = self.seconds();
+        let delta = |end: Option<u32>, start: Option<u32>| {
+            end.zip(start)
+                .map(|(end, start)| f64::from(end.wrapping_sub(start)) / seconds)
+        };
+        let mean_ms = |value: Duration| {
+            (window.frames != 0).then(|| value.as_secs_f64() * 1000.0 / f64::from(window.frames))
+        };
+        serde_json::json!({
+            "phase": window.phase.name(),
+            "window_ms": seconds * 1000.0,
+            "sample_at_session_ms": self.end.saturating_duration_since(session_start).as_secs_f64() * 1000.0,
+            "sample_age_ms": now.saturating_duration_since(self.end).as_secs_f64() * 1000.0,
+            "host_iterations_per_second": f64::from(window.iterations) / seconds,
+            "game_frames_built_per_second": f64::from(window.frames) / seconds,
+            "tv_submissions_per_second": f64::from(window.outputs[0]) / seconds,
+            "gamepad_submissions_per_second": f64::from(window.outputs[1]) / seconds,
+            "combined_gx2_flips_per_second": delta(self.totals.combined_flips, window.base.combined_flips),
+            "integrated_ticks_per_second": delta(self.totals.server_ticks, window.base.server_ticks),
+            "meshed_sections_per_second": self.totals.meshed.saturating_sub(window.base.meshed) as f64 / seconds,
+            "uploaded_sections_per_second": window.uploaded_sections as f64 / seconds,
+            "uploaded_vertex_bytes_per_second": window.uploaded_bytes as f64 / seconds,
+            "redraw_outside_submission_ms_per_game_frame": mean_ms(window.cpu),
+            "submission_outside_measured_waits_ms_per_game_frame": mean_ms(window.submission),
+            "measured_gx2_wait_ms_per_game_frame": mean_ms(window.gpu_wait),
+        })
+    }
+}
