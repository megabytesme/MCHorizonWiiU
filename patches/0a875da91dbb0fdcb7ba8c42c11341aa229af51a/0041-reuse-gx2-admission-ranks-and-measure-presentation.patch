+/// Bound both the retry batch and the memory needed to choose it.
+pub(super) fn best_retries(
+    candidates: impl IntoIterator<Item = (Priority, usize)>,
+) -> Vec<(Priority, usize)> {
+    const RETRIES: usize = 8;
+    let mut best = BinaryHeap::with_capacity(RETRIES);
+    for candidate in candidates {
+        if best.len() < RETRIES {
+            best.push(candidate);
+        } else if let Some(mut worst) = best.peek_mut() {
+            if candidate < *worst {
+                *worst = candidate;
+            }
+        }
+    }
+    best.into_sorted_vec()
+}
