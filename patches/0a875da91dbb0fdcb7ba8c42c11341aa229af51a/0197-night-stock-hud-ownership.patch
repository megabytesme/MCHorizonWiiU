+use super::*;
+use sha2::{Digest, Sha256};
+use std::{fs, path::PathBuf};
+
+struct Installation {
+    _root: tempfile::TempDir,
+    resources: PathBuf,
+    receipt: PathBuf,
+}
+
+impl Installation {
+    fn new() -> crate::Result<Self> {
+        let root = tempfile::tempdir()?;
+        let resources = root.path().join("stock");
+        let receipt = root.path().join("installed-stock.json");
+        fs::create_dir_all(resources.join("assets/minecraft/font"))?;
+        fs::write(resources.join("horizon-resources.json"), b"{}")?;
+        Ok(Self {
+            _root: root,
+            resources,
+            receipt,
+        })
+    }
+
+    fn publish(&self, advance: u32) -> crate::Result<()> {
+        let definition =
+            serde_json::json!({"providers": [{"type": "space", "advances": {"A": advance}}]});
+        fs::write(
+            self.resources.join("assets/minecraft/font/default.json"),
+            serde_json::to_vec(&definition)?,
+        )?;
+        horizon_core::prepared_files::write(&self.resources)?;
+        let bytes = fs::read(self.resources.join(horizon_core::prepared_files::FILE_NAME))?;
+        let expected = format!("{:x}", Sha256::digest(bytes));
+        let receipt = serde_json::json!({"archive_version": 2, "archive_sha256": expected, "guest_root": &self.resources});
+        let next = self.receipt.with_extension("new");
+        fs::write(&next, serde_json::to_vec(&receipt)?)?;
+        fs::rename(next, &self.receipt)?;
+        Ok(())
+    }
+
+    fn open<'a>(
+        &self,
+        night: &'a NightStockHudOwner,
+        cancel: &AtomicBool,
+    ) -> crate::Result<Option<StockHudLaunch<'a>>> {
+        let resolved = ResourceSource::directory(self.resources.clone());
+        Ok(night.begin_launch(&resolved, &self.resources, &self.receipt, cancel)?)
+    }
+}
+
+#[test]
+#[cfg(unix)]
+fn warm_failure_uses_one_cold_build_from_the_same_open_generation() -> crate::Result<()> {
+    let installation = Installation::new()?;
+    installation.publish(2)?;
+    let night = NightStockHudOwner::default();
+    let cancel = AtomicBool::new(false);
+    let mut first = installation
+        .open(&night, &cancel)?
+        .ok_or("first open failed")?;
+    assert!(installation.open(&night, &cancel)?.is_none());
+    assert!(first.try_warm(&cancel).is_none());
+    let ui = first.build_cold(&cancel)?.ok_or("cold plan missing")?;
+    assert_eq!(ui.atlas().font.glyph('A').advance, 2.0);
+    assert!(first.mark_presented(&ui, &cancel));
+    let first_source = first.assets().liveness();
+    drop(ui);
+    first.park_after_drain(true, &cancel);
+    assert!(!first_source());
+
+    let mut next = installation
+        .open(&night, &cancel)?
+        .ok_or("next open failed")?;
+    let warm = next.try_warm(&cancel).ok_or("expected warm seed")?;
+    assert!(next.try_warm(&cancel).is_none());
+    let old_snapshot = next.assets().clone();
+    installation.publish(4)?;
+    assert!(warm.finish_mapped(&mut [], 0, &cancel).is_none());
+    let fallback = next
+        .build_cold(&cancel)?
+        .ok_or("verified cold fallback missing")?;
+    assert!(next.build_cold(&cancel)?.is_none());
+    assert!(old_snapshot.same_generation(fallback.assets()));
+    assert_eq!(fallback.atlas().font.glyph('A').advance, 2.0);
+    assert!(next.mark_presented(&fallback, &cancel));
+    drop(fallback);
+    next.park_after_drain(true, &cancel);
+
+    let mut replaced = installation
+        .open(&night, &cancel)?
+        .ok_or("replacement open failed")?;
+    assert!(replaced.try_warm(&cancel).is_none());
+    let fresh = replaced
+        .build_cold(&cancel)?
+        .ok_or("new cold atlas missing")?;
+    assert!(!old_snapshot.same_generation(fresh.assets()));
+    assert_eq!(fresh.atlas().font.glyph('A').advance, 4.0);
+    Ok(())
+}
+
+#[test]
+fn unpresented_failed_and_shutdown_launches_cannot_park_art() -> crate::Result<()> {
+    let installation = Installation::new()?;
+    installation.publish(2)?;
+    let night = NightStockHudOwner::default();
+    let cancel = AtomicBool::new(false);
+    let mut unpresented = installation
+        .open(&night, &cancel)?
+        .ok_or("launch missing")?;
+    let ui = unpresented.build_cold(&cancel)?.ok_or("cold UI missing")?;
+    drop(ui);
+    unpresented.park_after_drain(true, &cancel);
+    let mut failed = installation
+        .open(&night, &cancel)?
+        .ok_or("next launch missing")?;
+    assert!(failed.try_warm(&cancel).is_none());
+    let ui = failed.build_cold(&cancel)?.ok_or("cold UI missing")?;
+    assert!(failed.mark_presented(&ui, &cancel));
+    drop(ui);
+    failed.park_after_drain(false, &cancel);
+    let mut canceled = installation
+        .open(&night, &cancel)?
+        .ok_or("cancel candidate missing")?;
+    assert!(canceled.try_warm(&cancel).is_none());
+    cancel.store(true, Ordering::Release);
+    assert!(canceled.build_cold(&cancel)?.is_none());
+    drop(canceled);
+    cancel.store(false, Ordering::Release);
+    let mut late_cancel = installation
+        .open(&night, &cancel)?
+        .ok_or("late cancel candidate missing")?;
+    let ui = late_cancel.build_cold(&cancel)?.ok_or("cold UI missing")?;
+    assert!(late_cancel.mark_presented(&ui, &cancel));
+    drop(ui);
+    cancel.store(true, Ordering::Release);
+    late_cancel.park_after_drain(true, &cancel);
+    cancel.store(false, Ordering::Release);
+    let mut closing = installation
+        .open(&night, &cancel)?
+        .ok_or("close candidate missing")?;
+    assert!(closing.try_warm(&cancel).is_none());
+    let ui = closing.build_cold(&cancel)?.ok_or("cold UI missing")?;
+    assert!(closing.mark_presented(&ui, &cancel));
+    night.shutdown();
+    drop(ui);
+    closing.park_after_drain(true, &cancel);
+    assert!(installation.open(&night, &cancel)?.is_none());
+    Ok(())
+}
+
+#[test]
+fn resolved_overlays_and_unavailable_receipts_evict_previous_seed() -> crate::Result<()> {
+    let installation = Installation::new()?;
+    installation.publish(2)?;
+    let night = NightStockHudOwner::default();
+    let cancel = AtomicBool::new(false);
+    let mut first = installation
+        .open(&night, &cancel)?
+        .ok_or("first open failed")?;
+    let ui = first.build_cold(&cancel)?.ok_or("cold UI missing")?;
+    assert!(first.mark_presented(&ui, &cancel));
+    drop(ui);
+    first.park_after_drain(true, &cancel);
+    let overlay = ResourceSource::indexed(Default::default());
+    assert!(
+        night
+            .begin_launch(
+                &overlay,
+                &installation.resources,
+                &installation.receipt,
+                &cancel
+            )?
+            .is_none()
+    );
+    let mut stock = installation
+        .open(&night, &cancel)?
+        .ok_or("stock open failed")?;
+    assert!(stock.try_warm(&cancel).is_none());
+    let ui = stock.build_cold(&cancel)?.ok_or("new cold UI missing")?;
+    assert!(stock.mark_presented(&ui, &cancel));
+    drop(ui);
+    stock.park_after_drain(true, &cancel);
+    let receipt = fs::read(&installation.receipt)?;
+    fs::remove_file(&installation.receipt)?;
+    assert!(installation.open(&night, &cancel)?.is_none());
+    fs::write(&installation.receipt, receipt)?;
+    let mut back = installation
+        .open(&night, &cancel)?
+        .ok_or("restored receipt missing")?;
+    assert!(back.try_warm(&cancel).is_none());
+    Ok(())
+}
