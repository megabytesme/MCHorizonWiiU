+//! Park immutable stock art in Night and lend it to one hosted launch.
+
+use super::{
+    CompleteStockHud, HudAtlas, InstalledStockAssets, PlannedStockHud, ResourceSource, StockHudSlot,
+};
+use std::{
+    io,
+    path::Path,
+    sync::{
+        Mutex, MutexGuard, PoisonError,
+        atomic::{AtomicBool, Ordering},
+    },
+};
+
+enum NightSlot {
+    Parked(StockHudSlot),
+    InUse,
+    Closed,
+}
+
+pub struct NightStockHudOwner(Mutex<NightSlot>);
+
+impl Default for NightStockHudOwner {
+    fn default() -> Self {
+        Self(Mutex::new(NightSlot::Parked(StockHudSlot::default())))
+    }
+}
+
+impl NightStockHudOwner {
+    fn state(&self) -> MutexGuard<'_, NightSlot> {
+        self.0.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+
+    /// Close at Night shutdown, even if a hosted launch still has the lease.
+    pub fn shutdown(&self) {
+        *self.state() = NightSlot::Closed;
+    }
+
+    /// Verify the installation selected by the resolved load. A pack, mod
+    /// mirror or generated texture layer must remain on the ordinary path.
+    pub fn begin_launch(
+        &self,
+        resolved: &ResourceSource,
+        stock_root: &Path,
+        installer_receipt: &Path,
+        cancel: &AtomicBool,
+    ) -> io::Result<Option<StockHudLaunch<'_>>> {
+        let Some(lease) = self.checkout() else {
+            return Ok(None);
+        };
+        if !resolved.is_direct_directory(stock_root) || super::sprites::labpbr_maps() {
+            return Ok(None);
+        }
+        let Some(assets) = InstalledStockAssets::reopen(stock_root, installer_receipt, cancel)?
+        else {
+            return Ok(None);
+        };
+        if cancel.load(Ordering::Acquire) || !lease.active() {
+            return Ok(None);
+        }
+        Ok(Some(StockHudLaunch {
+            assets,
+            lease,
+            stage: LaunchStage::New,
+        }))
+    }
+
+    fn checkout(&self) -> Option<Lease<'_>> {
+        let mut state = self.state();
+        if !matches!(*state, NightSlot::Parked(_)) {
+            return None;
+        }
+        let NightSlot::Parked(slot) = std::mem::replace(&mut *state, NightSlot::InUse) else {
+            unreachable!("only a parked slot can be loaned")
+        };
+        Some(Lease {
+            owner: self,
+            slot: Some(slot),
+        })
+    }
+}
+
+struct Lease<'a> {
+    owner: &'a NightStockHudOwner,
+    slot: Option<StockHudSlot>,
+}
+
+impl Lease<'_> {
+    fn active(&self) -> bool {
+        matches!(*self.owner.state(), NightSlot::InUse)
+    }
+
+    fn slot(&mut self) -> &mut StockHudSlot {
+        self.slot.as_mut().expect("live launch retains its slot")
+    }
+
+    fn return_to_night(&mut self, keep: bool) {
+        let Some(mut slot) = self.slot.take() else {
+            return;
+        };
+        if !keep {
+            slot.clear();
+        }
+        let mut state = self.owner.state();
+        if matches!(*state, NightSlot::InUse) {
+            *state = NightSlot::Parked(slot);
+        }
+    }
+}
+
+impl Drop for Lease<'_> {
+    fn drop(&mut self) {
+        self.return_to_night(false);
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum LaunchStage {
+    New,
+    Warm,
+    Cold,
+    Presented,
+}
+
+/// One installed generation serves both the warm plan and its cold fallback.
+/// Drain the hosted session before parking its successfully uploaded art.
+pub struct StockHudLaunch<'a> {
+    assets: InstalledStockAssets,
+    lease: Lease<'a>,
+    stage: LaunchStage,
+}
+
+impl StockHudLaunch<'_> {
+    pub fn assets(&self) -> &ResourceSource {
+        self.assets.assets()
+    }
+
+    pub fn try_warm(&mut self, cancel: &AtomicBool) -> Option<PlannedStockHud> {
+        if self.stage != LaunchStage::New || !self.lease.active() {
+            return None;
+        }
+        self.stage = LaunchStage::Warm;
+        // Both owners point to the same freshly verified descriptor.
+        self.lease
+            .slot()
+            .prepare(Some(InstalledStockAssets(self.assets.0.clone())), cancel)
+    }
+
+    /// Build the complete ordinary stock HUD on the pinned descriptor. A
+    /// failed warm upload can take this path once, without reopening a path.
+    pub fn build_cold(&mut self, cancel: &AtomicBool) -> crate::Result<Option<CompleteStockHud>> {
+        if matches!(self.stage, LaunchStage::Cold | LaunchStage::Presented) || !self.lease.active()
+        {
+            return Ok(None);
+        }
+        self.stage = LaunchStage::Cold;
+        self.lease.slot().clear();
+        if cancel.load(Ordering::Acquire) {
+            return Ok(None);
+        }
+        let source = self.assets.0.clone();
+        let (atlas, panorama) = std::thread::scope(|scope| {
+            let panorama = horizon_guest_stack::builder()
+                .name("load-panorama".into())
+                .spawn_scoped(scope, || self.assets.load_panorama())?;
+            let atlas =
+                HudAtlas::build_over_with_image_cancel(&source, &source, false, Some(cancel));
+            Ok::<_, io::Error>((
+                atlas,
+                panorama
+                    .join()
+                    .unwrap_or_else(|panic| std::panic::resume_unwind(panic)),
+            ))
+        })?;
+        if cancel.load(Ordering::Acquire) || !self.lease.active() {
+            return Ok(None);
+        }
+        let mut atlas = atlas?;
+        // An over-budget seed still gives an ordinary usable atlas.
+        let _ = self
+            .lease
+            .slot()
+            .capture(&mut atlas, &self.assets, &panorama, cancel);
+        if cancel.load(Ordering::Acquire) || !self.lease.active() {
+            return Ok(None);
+        }
+        Ok(Some(CompleteStockHud {
+            atlas,
+            panorama: panorama.faces,
+            source,
+        }))
+    }
+
+    /// Confirm that this generation's atlas and panorama reached the renderer.
+    pub fn mark_presented(&mut self, product: &CompleteStockHud, cancel: &AtomicBool) -> bool {
+        if !matches!(self.stage, LaunchStage::Warm | LaunchStage::Cold)
+            || cancel.load(Ordering::Acquire)
+            || !self.lease.active()
+            || !self.assets().same_generation(product.assets())
+        {
+            return false;
+        }
+        self.stage = LaunchStage::Presented;
+        true
+    }
+
+    /// Return only source-free reusable art after the hosted loop and workers
+    /// have released all UI state. Failures and actual exits discard it.
+    pub fn park_after_drain(self, successful_return: bool, cancel: &AtomicBool) {
+        let Self {
+            assets,
+            mut lease,
+            stage,
+        } = self;
+        drop(assets);
+        lease.return_to_night(
+            successful_return && stage == LaunchStage::Presented && !cancel.load(Ordering::Acquire),
+        );
+    }
+}
