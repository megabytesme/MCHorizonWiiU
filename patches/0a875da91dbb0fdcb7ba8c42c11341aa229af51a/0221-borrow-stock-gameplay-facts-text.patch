+/// Borrow unescaped strings directly from the prepared document. The old
+/// Value path remains for unexpected containers, which still validate before
+/// yielding the field's default.
+#[derive(Default)]
+struct Text<'a>(Option<Cow<'a, str>>);
+impl<'de> Container<'de> for Text<'de> {
+    fn borrowed_text(text: &'de str) -> Self {
+        Self(Some(Cow::Borrowed(text)))
+    }
+    fn text(text: &str) -> Self {
+        Self(Some(Cow::Owned(text.to_owned())))
+    }
+    fn owned_text(text: String) -> Self {
+        Self(Some(Cow::Owned(text)))
+    }
+    fn map<A: MapAccess<'de>>(map: A) -> Result<Self, A::Error> {
+        Value::deserialize(MapAccessDeserializer::new(map)).map(|_| Self::default())
+    }
+    fn seq<A: SeqAccess<'de>>(seq: A) -> Result<Self, A::Error> {
+        Value::deserialize(SeqAccessDeserializer::new(seq)).map(|_| Self::default())
+    }
+}
+impl<'de> Deserialize<'de> for Text<'de> {
+    fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+        container(d)
     }
 }
 
