+    fn stationary_diagnostic_freezes_scene_and_reports_a_fixed_camera_interval() {
+        use serde_json::json;
+        let (requests, game) = mpsc::channel::<Request>();
+        let control = Control::new(requests);
+        let mock_game = thread::spawn(move || {
+            let renderer = stationary_status()["renderer"].clone();
+            let targets = stationary_targets(&stationary_status()).unwrap();
+            let mut at_scene = false;
+            let mut checks = 0;
+            let mut measured = false;
+            let mut scene_commands = Vec::new();
+            for request in game {
+                let (first, _) = request.line.split_once(' ').unwrap_or((&request.line, ""));
+                let reply = match first {
+                    "status" => {
+                        if at_scene {
+                            checks += 1;
+                        }
+                        json!({
+                            "screen": "playing",
+                            "player": {"position": if at_scene { SCENES[0].1 } else { [0.0; 3] }},
+                            "chunks": 150,
+                            "pending_chunks": 0,
+                            "render_distance": 6,
+                            "meshed_sections": if measured { 99 } else { 98 },
+                            "generated_chunks": if checks > 1 { 150 } else { 149 },
+                            "renderer": renderer,
+                        })
+                    }
+                    "tp" => {
+                        at_scene = true;
+                        json!({"ok": true})
+                    }
+                    "fly" if request.line.ends_with(" raw") => {
+                        assert!(at_scene && checks > 2);
+                        assert_eq!(request.line, "fly -960 125 80 -960 125 80 30 35 raw");
+                        measured = true;
+                        json!({
+                            "frame_ms": vec![200.0; 126],
+                            "cpu_ms": vec![98.0; 126],
+                            "cafe_stationary_targets": targets.json(),
+                            "cafe_flight_coverage": {
+                                "host_frames": 127, "paired_frames": 127, "terrain_paired_frames": 127,
+                                "eligible_intervals": 126,
+                                "eligible_interval_ms": 25_200.0,
+                                "elapsed_ms": 30_000.0,
+                            }
+                        })
+                    }
+                    "command" | "time" => {
+                        scene_commands.push(request.line);
+                        json!({"ok": true})
+                    }
+                    _ => json!({"ok": true}),
+                };
+                request.reply.send(reply.to_string()).unwrap();
+            }
+            scene_commands
+        });
+        let mut report = Report::new(Kind::Game, App::default());
+        let mut steady = Vec::new();
+        stationary(&control, &mut report, &mut steady).unwrap();
+        drop(control);
+        assert_eq!(
+            mock_game.join().unwrap(),
+            [
+                "command gamerule advance_time false",
+                "command gamerule advance_weather false",
+                "command weather clear",
+                "time 6000",
+                "command gamerule random_tick_speed 0",
+                "command gamerule spawn_mobs false",
+            ]
+        );
+        assert!(report.label.as_deref().unwrap().contains("Stationary"));
+        assert_eq!(report.frames[0].phase, CAFE_STATIONARY_SCENARIO);
+        assert_eq!(report.frames[0].frames, 126);
+        assert_eq!(report.frames[0].gpu_p50_ms, None);
+        assert_eq!(report.metrics["cafe.stationary.fixed_scale"].mean, 75.0);
+        assert_eq!(report.metrics["cafe.stationary.meshed_sections"].mean, 1.0);
+        assert_eq!(
+            report.metrics["cafe.cafe-stationary.eligible_intervals"].mean,
+            126.0
+        );
+        assert_eq!(steady.len(), 1);
+    }
