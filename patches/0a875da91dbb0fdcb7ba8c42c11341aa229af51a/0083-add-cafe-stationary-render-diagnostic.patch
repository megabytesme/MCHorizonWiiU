+/// Read a fixed scale override from Night's owned stationary scratch directory.
+#[cfg(any(target_os = "cafe", test))]
+pub fn cafe_stationary_scale(game_dir: &Path) -> Result<u32, String> {
+    use std::fs::{File, symlink_metadata};
+    use std::io::{ErrorKind, Read};
+
+    if !owned_cafe_workspace(game_dir) {
+        return Err("the Cafe stationary diagnostic needs an owned benchmark workspace".into());
+    }
+    let path = game_dir.join(STATIONARY_SCALE_FILE);
+    let invalid = || format!("{STATIONARY_SCALE_FILE} must contain 50, 75 or 100");
+    match symlink_metadata(&path) {
+        Ok(metadata) if metadata.is_file() && metadata.len() <= 5 => {}
+        Err(error) if error.kind() == ErrorKind::NotFound => return Ok(100),
+        Ok(_) => return Err(invalid()),
+        Err(error) => return Err(error.to_string()),
+    }
+    let mut value = Vec::new();
+    File::open(path)
+        .and_then(|file| file.take(6).read_to_end(&mut value))
+        .map_err(|error| error.to_string())?;
+    match value.as_slice() {
+        b"50" | b"50\n" | b"50\r\n" => Ok(50),
+        b"75" | b"75\n" | b"75\r\n" => Ok(75),
+        b"100" | b"100\n" | b"100\r\n" => Ok(100),
+        _ => Err(invalid()),
+    }
+}
