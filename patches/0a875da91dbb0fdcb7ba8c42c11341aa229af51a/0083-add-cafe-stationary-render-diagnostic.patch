+#[cfg(any(target_os = "cafe", test))]
+fn stationary(
+    control: &Control,
+    report: &mut Report,
+    steady: &mut Vec<(Instant, Instant)>,
+) -> Result<(), String> {
+    let name = CAFE_STATIONARY_SCENARIO;
+    // Keep the Village starting view while the original Village benchmark
+    // continues to measure its complete traversal.
+    let (_, view, _, pitch) = SCENES[0];
+    freeze_daylight(control)?;
+    control.call("command gamerule random_tick_speed 0")?;
+    control.call("command gamerule spawn_mobs false")?;
+    load_scene(control, name, view, view, pitch, report)?;
+    control.settle(STATIONARY_WARMUP)?;
+    let before = control.call("status")?;
+    let targets = stationary_targets(&before)?;
+    #[cfg(target_os = "cafe")]
+    horizon_client_platform::cafe_memory::report("benchmark.stationary.before");
+    let flight = measure_flight(
+        control,
+        (name, view, view, pitch),
+        STATIONARY_SECONDS,
+        steady,
+        report,
+    )?;
+    verify_stationary_coverage(&flight, targets)?;
+    #[cfg(target_os = "cafe")]
+    horizon_client_platform::cafe_memory::report("benchmark.stationary.after");
+    let after = control.call("status")?;
+    if stationary_targets(&after)? != targets {
+        return Err("the stationary diagnostic changed scale or target dimensions".into());
+    }
+    // Retain the amount of streaming work observed during the fixed view.
+    // Reports with that work present need separate interpretation.
+    for key in ["generated_chunks", "meshed_sections"] {
+        if let Some((before, after)) = before[key].as_u64().zip(after[key].as_u64()) {
+            report.metric(
+                &format!("cafe.stationary.{key}"),
+                &[after.saturating_sub(before) as f64],
+            );
+        }
+    }
+    report.label = Some("Cafe GX2 Stationary Render Diagnostic / paired submissions".into());
+    report.conditions.backend = Some("gx2".into());
+    report.metric(
+        "cafe.stationary.fixed_scale",
+        &[f64::from(targets.resolution.effective_scale)],
+    );
+    let frames = frames_of(&flight, name, 0)?;
+    let blocks = std::slice::from_ref(&frames);
+    fps_metrics(report, name, blocks);
+    timing_metrics(report, name, blocks);
+    report.frames.push(frames);
+    Ok(())
+}
+
+#[cfg(any(target_os = "cafe", test))]
+fn stationary_targets(status: &Value) -> Result<CafeStationaryTargets, String> {
+    let renderer = &status["renderer"];
+    if renderer["backend"] != "gx2" || renderer["terrain_presented"] != true {
+        return Err("the stationary view must submit terrain on both GX2 outputs".into());
+    }
+    let field = |key: &str| {
+        renderer[key]
+            .as_u64()
+            .and_then(|value| u32::try_from(value).ok())
+            .ok_or("the stationary diagnostic lacks complete target metadata")
+    };
+    let targets = CafeStationaryTargets {
+        resolution: WorldResolution {
+            requested_scale: field("requested_scale")?,
+            effective_scale: field("effective_scale")?,
+            dimensions: [
+                [field("tv_world_width")?, field("tv_world_height")?],
+                [
+                    field("gamepad_world_width")?,
+                    field("gamepad_world_height")?,
+                ],
+            ],
+            surface_bytes: field("world_surface_bytes")?,
+        },
+        displays: [
+            [field("tv_width")?, field("tv_height")?],
+            [field("gamepad_width")?, field("gamepad_height")?],
+        ],
+    };
+    if targets.matches_scale(field("configured_scale")?) {
+        Ok(targets)
+    } else {
+        Err("the stationary diagnostic did not achieve its configured fixed scale".into())
+    }
+}
+
+#[cfg(any(target_os = "cafe", test))]
+fn verify_stationary_coverage(
+    flight: &Value,
+    expected: CafeStationaryTargets,
+) -> Result<(), String> {
+    let coverage = &flight["cafe_flight_coverage"];
+    let mismatches = coverage["stationary_target_mismatches"]
+        .as_u64()
+        .unwrap_or(0);
+    if mismatches != 0 {
+        return Err(format!(
+            "the stationary measurement changed or lost target metadata ({mismatches} mismatched submissions)"
+        ));
+    }
+    let elapsed = coverage["elapsed_ms"].as_f64().unwrap_or(0.0);
+    let eligible = coverage["eligible_interval_ms"].as_f64().unwrap_or(0.0);
+    let intervals = coverage["eligible_intervals"].as_u64().unwrap_or(0);
+    if elapsed < STATIONARY_SECONDS * 1000.0
+        || eligible < elapsed * STATIONARY_MIN_FRACTION
+        || eligible > elapsed
+        || intervals < STATIONARY_MIN_INTERVALS
+    {
+        return Err(format!(
+            "insufficient stationary coverage ({intervals} intervals, {eligible:.0}/{elapsed:.0} ms eligible)"
+        ));
+    }
+    if flight["cafe_stationary_targets"] != expected.json() {
+        return Err("the stationary measurement changed or lost target metadata".into());
+    }
+    Ok(())
+}
