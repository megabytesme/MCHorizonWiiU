new file mode 100644
index 0000000000000000000000000000000000000000..e7de02adb00a0687dce86b7ba39f8ffd539e3657
--- /dev/null
+++ b/crates/horizon-mod-package/tests/cafe_recipe_package.rs
@@ -0,0 +1,34 @@
+use horizon_mod_package::{Package, selection::content_packages};
+use std::{collections::BTreeSet, fs, path::Path};
+
+#[test]
+fn recipe_pilot_selects_the_original_namespaced_recipe_when_enabled() {
+    let game = tempfile::tempdir().unwrap();
+    let fixture = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../tools/fixtures/recipes_hmod");
+    let mods = game.path().join("horizon-mods");
+    fs::create_dir(&mods).unwrap();
+    let archive = mods.join("recipe_pilot.hmod");
+    fs::write(&archive, Package::pack_directory(&fixture).unwrap()).unwrap();
+
+    let disabled = BTreeSet::new();
+    assert_eq!(content_packages(game.path(), &disabled, &[]).count(), 0);
+    let enabled = BTreeSet::from(["recipe_pilot".to_owned()]);
+    let mut selected = content_packages(game.path(), &enabled, &[]);
+    let selected_mod = selected.next().unwrap();
+    assert!(selected.next().is_none());
+    assert_eq!(selected_mod.path, archive);
+    assert_eq!(selected_mod.package.manifest.id, "recipe_pilot");
+
+    let entry = "data/recipe_pilot/recipe/flint_to_echo_shard.json";
+    let recipe = Package::entry(&selected_mod.path, entry, 1024)
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        serde_json::from_slice::<serde_json::Value>(&recipe).unwrap(),
+        serde_json::json!({
+            "type": "minecraft:crafting_shapeless",
+            "ingredients": ["minecraft:flint"],
+            "result": {"id": "minecraft:echo_shard", "count": 2}
+        })
+    );
+}
