new file mode 100644
index 0000000000000000000000000000000000000000..f39b6cb68b8f5b1d8ee091513c99c1c0fc17aefa
--- /dev/null
+++ b/wiiu/loading_host/solid_draw_plan.rs
@@ -0,0 +1,93 @@
+//! CPU-only prepared solid draws for an unchanged output projection.
+use super::{SectionKey, TerrainClipRows, TerrainProjection};
+use horizon_wiiu_gx2_terrain::TerrainBounds;
+
+const MAX_DRAWS: usize = 1024;
+
+pub(super) struct SolidDraw {
+    pub(super) key: SectionKey,
+    pub(super) origin: [f64; 3],
+    pub(super) clip: TerrainClipRows,
+}
+
+impl SolidDraw {
+    pub(super) fn project(
+        key: SectionKey,
+        bounds: Option<TerrainBounds>,
+        projection: &TerrainProjection,
+    ) -> Option<Self> {
+        let origin = projection.section_origin(key);
+        let clip = projection.clip_rows(origin);
+        if bounds.is_some_and(|bounds| !clip.may_intersect(bounds)) {
+            return None;
+        }
+        Some(Self { key, origin, clip })
+    }
+}
+
+#[derive(Default)]
+enum PlanState {
+    #[default]
+    Unbuilt,
+    Ready(usize),
+    Unavailable,
+}
+
+#[derive(Default)]
+pub(super) struct SolidDrawPlan {
+    draws: Vec<SolidDraw>,
+    state: PlanState,
+    logged: bool,
+}
+
+impl SolidDrawPlan {
+    pub(super) fn invalidate(&mut self) {
+        self.draws.clear();
+        self.state = PlanState::Unbuilt;
+    }
+
+    pub(super) fn prepare(
+        &mut self,
+        sections: impl Iterator<Item = (SectionKey, Option<TerrainBounds>)>,
+        projection: &TerrainProjection,
+    ) {
+        if !matches!(self.state, PlanState::Unbuilt) {
+            return;
+        }
+        if self.draws.try_reserve_exact(MAX_DRAWS).is_err() {
+            self.state = PlanState::Unavailable;
+            return;
+        }
+        let mut tested = 0;
+        for (key, bounds) in sections {
+            tested += 1;
+            if let Some(draw) = SolidDraw::project(key, bounds, projection) {
+                if self.draws.len() == MAX_DRAWS {
+                    self.draws.clear();
+                    self.state = PlanState::Unavailable;
+                    return;
+                }
+                self.draws.push(draw);
+            }
+        }
+        self.state = PlanState::Ready(tested);
+    }
+
+    pub(super) fn ready(&self) -> Option<(usize, &[SolidDraw])> {
+        match self.state {
+            PlanState::Ready(tested) => Some((tested, &self.draws)),
+            _ => None,
+        }
+    }
+
+    pub(super) fn first_use(&mut self) -> Option<(usize, usize)> {
+        let PlanState::Ready(tested) = self.state else {
+            return None;
+        };
+        if self.logged {
+            return None;
+        }
+        self.logged = true;
+        Some((tested, self.draws.len()))
+    }
+}
