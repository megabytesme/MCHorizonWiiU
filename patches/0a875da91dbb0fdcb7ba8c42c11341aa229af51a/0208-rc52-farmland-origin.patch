+fn trace_farmland_join_miss(
+    definitions: &BTreeMap<String, LandingDefinition>,
+    definition: &LandingDefinition,
+    state_name: &str,
+    owned: &String,
+) {
+    const FARMLAND: &str = "minecraft:farmland";
+    // Locate the actual value returned by the original join without a key search.
+    let selected = definitions
+        .iter()
+        .take(4096)
+        .find(|(_, candidate)| std::ptr::eq(*candidate, definition));
+    let owned_len = owned.len();
+    let view_len = std::hint::black_box(owned).as_str().len();
+    log::error!(
+        "Horizon Cafe farmland join state_stock={} definition_found={} definition_stock={} owned_len={owned_len} view_len={view_len}",
+        state_name == FARMLAND,
+        selected.is_some(),
+        selected.is_some_and(|(name, _)| name == FARMLAND),
+    );
+}
