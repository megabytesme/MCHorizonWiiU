+    fn section_info(mesh: &SectionMesh) -> Option<DeferredTerrain> {
+        let count = u32::try_from(mesh.solid.len()).ok()?;
+        let mut bytes = 0;
+        if unsafe { horizon_gx2_terrain_section_estimate(count, &mut bytes) } != 0 {
+            return None;
+        }
