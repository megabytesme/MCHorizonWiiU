diff --git a/crates/horizon-client-render/src/streaming/cafe_upload_budget.rs b/crates/horizon-client-render/src/streaming/cafe_upload_budget.rs
new file mode 100644
index 0000000..9afdae2
--- /dev/null
+++ b/crates/horizon-client-render/src/streaming/cafe_upload_budget.rs
@@ -0,0 +1,67 @@
+//! Byte budget shared by native mesh workers and the pending upload queue.
+use std::sync::{
+    Arc,
+    atomic::{AtomicUsize, Ordering},
+};
+
+pub(crate) const LIMIT: usize = 24 * 1024 * 1024;
+
+#[derive(Default)]
+pub(crate) struct Budget(Arc<AtomicUsize>);
+
+impl Budget {
+    pub(crate) fn used(&self) -> usize {
+        self.0.load(Ordering::Relaxed)
+    }
+
+    pub(crate) fn reserve(&self, bytes: usize) -> Option<Charge> {
+        self.0
+            .try_update(Ordering::Relaxed, Ordering::Relaxed, |used| {
+                used.checked_add(bytes).filter(|&total| total <= LIMIT)
+            })
+            .ok()?;
+        Some(Charge {
+            used: Arc::clone(&self.0),
+            bytes,
+        })
+    }
+}
+
+pub struct Charge {
+    used: Arc<AtomicUsize>,
+    bytes: usize,
+}
+
+impl Drop for Charge {
+    fn drop(&mut self) {
+        self.used.fetch_sub(self.bytes, Ordering::Relaxed);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn charges_follow_ownership_across_threads_until_disposed() {
+        let budget = Budget::default();
+        let held = budget.reserve(LIMIT - 256).unwrap();
+        let full = std::thread::scope(|threads| {
+            threads
+                .spawn(|| {
+                    assert!(budget.reserve(257).is_none());
+                    budget.reserve(256).unwrap()
+                })
+                .join()
+                .unwrap()
+        });
+        assert_eq!(budget.used(), LIMIT);
+        assert!(budget.reserve(1).is_none());
+        drop(held);
+        assert_eq!(budget.used(), 256);
+        assert!(budget.reserve(usize::MAX).is_none());
+        drop(full);
+        assert_eq!(budget.used(), 0);
+        assert!(budget.reserve(LIMIT).is_some());
+    }
+}
