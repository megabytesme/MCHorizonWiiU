+{
+   if (!bytes || count % 4) return -1;
+   *bytes = 0;
+   if (!count) return 0;
+   const GX2RResourceFlags flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER |
+      GX2R_RESOURCE_USAGE_CPU_WRITE | GX2R_RESOURCE_USAGE_GPU_READ;
+   const uint32_t alignment = GX2RGetBufferAlignment(flags);
+   const uint64_t payload = (uint64_t)sizeof(HorizonTerrainVertex) * count;
+   if (!alignment || payload > UINT32_MAX - (alignment - 1)) return -1;
+   GX2RBuffer layout = { .flags = flags, .elemSize = sizeof(HorizonTerrainVertex), .elemCount = count };
+   *bytes = GX2RGetBufferAllocationSize(&layout);
+   return *bytes < payload ? -1 : 0;
+}
