+/* Leave room for the region writer, heaps shared with native libraries,
+ * and textures that are outside the terrain vertex residency meter. */
+int horizon_wiiu_memory_can_upload_terrain(uint32_t bytes)
+{
+   const uint32_t reserve = 48u * 1024 * 1024;
+   if (!bulk_heap) return 1;
+   const uint32_t free = MEMGetTotalFreeSizeForExpHeap(bulk_heap);
+   const uint32_t largest = MEMGetAllocatableSizeForExpHeapEx(bulk_heap, 64);
+   return free >= reserve && bytes <= free - reserve && bytes <= largest;
+}
