+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn visible_near_updates_evict_invisible_or_far_residents() {
+        let camera = (4, 8, 3);
+        let visible = priority((2, 8, 3), camera, true);
+        let hidden = priority((4, 8, 3), camera, false);
+        let far = priority((-5, 5, 3), camera, true);
+        assert_eq!(
+            victims(visible, 800, [(hidden, 700), (far, 500)]),
+            Some(vec![hidden.2, far.2])
+        );
+        assert_eq!(victims(hidden, 1, [(far, 800)]), None);
+        assert_eq!(victims(visible, 1201, [(hidden, 700), (far, 500)]), None);
+    }
+
+    #[test]
+    fn lowering_residency_for_a_larger_replacement_keeps_its_better_neighbours() {
+        let camera = (0, 0, 0);
+        let best = priority((0, 0, 0), camera, true);
+        let replacement = priority((0, 0, 1), camera, true);
+        let worst = priority((3, 0, 2), camera, false);
+        assert_eq!(victims(replacement, 256, [(worst, 255), (best, 256)]), None);
+        assert_eq!(
+            victims(replacement, 255, [(worst, 255), (best, 256)]),
+            Some(vec![worst.2])
+        );
+    }
