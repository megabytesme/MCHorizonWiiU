+    fn retire_section(&mut self, removed: TerrainSection) {
+        self.terrain_resident_bytes -= removed.allocation_bytes as usize;
+        self.terrain_retired_bytes += removed.allocation_bytes as usize;
+        self.retired_terrain.push(removed);
+    }
+
+    fn finish_retired_after_wait(&mut self) {
+        for section in self.retired_terrain.drain(..) {
+            let section = std::mem::ManuallyDrop::new(section);
+            unsafe { horizon_gx2_terrain_section_destroy_after_wait(section.native.as_ptr()) };
+        }
+        self.terrain_retired_bytes = 0;
+    }
+
+    fn flush_retired(&mut self) {
+        if self.retired_terrain.is_empty() {
+            return;
+        }
+        let _wait = Span::new(Stage::TerrainWait);
+        unsafe { horizon_gx2_terrain_wait_idle() };
+        self.finish_retired_after_wait();
+    }
+
+    fn clear_native_sections(&mut self) {
+        self.retired_terrain
+            .extend(self.sections.drain().map(|(_, section)| section));
+        self.terrain_resident_bytes = 0;
+        self.deferred_terrain.clear();
+        self.terrain_views = [None, None];
+        self.next_terrain_retry = None;
+        self.terrain_allocation_backoff = None;
+        self.flush_retired();
+    }
+
+    fn defer_native_section(&mut self, key: SectionKey, info: DeferredTerrain) {
+        if info.bytes <= RESIDENT_VERTEX_BYTES {
+            self.deferred_terrain.insert(key, info);
+        }
+    }
+}
+
+impl Drop for Gx2LoadingPresenter<'_> {
+    fn drop(&mut self) {
+        self.clear_native_sections();
+    }
