+            bytes: bytes as usize,
+            bounds: horizon_wiiu_gx2_terrain::TerrainBounds::from_vertices(&mesh.solid),
+        })
+    }
+
+    fn section_rank(
+        &self,
+        key: SectionKey,
+        bounds: Option<horizon_wiiu_gx2_terrain::TerrainBounds>,
+    ) -> terrain_residency::Priority {
+        let visible = bounds.is_none_or(|bounds| {
+            self.terrain_views.iter().any(Option::is_none)
+                || self.terrain_views.iter().flatten().any(|view| {
+                    view.clip_rows(view.section_origin(key))
+                        .may_intersect(bounds)
+                })
+        });
