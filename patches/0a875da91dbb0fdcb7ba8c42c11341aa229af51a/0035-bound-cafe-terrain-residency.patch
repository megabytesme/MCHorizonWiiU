+//! Admission policy for the shared TV and GamePad indexed geometry.
+pub(super) const RESIDENT_VERTEX_BYTES: usize = 128 * 1024 * 1024;
+pub(super) const RETIRE_BATCH_BYTES: usize = 2 * 1024 * 1024;
+pub(super) type Key = (i32, i32, i32);
+pub(super) type Priority = (bool, u64, Key);
+
+pub(super) fn priority(key: Key, camera: Key, visible: bool) -> Priority {
+    let axis = |a: i32, b: i32| (i64::from(a) - i64::from(b)).unsigned_abs();
+    let distance = axis(key.0, camera.0)
+        .saturating_pow(2)
+        .saturating_add(axis(key.1, camera.1).saturating_pow(2))
+        .saturating_add(axis(key.2, camera.2).saturating_pow(2));
+    (!visible, distance, key)
+}
+
+/// The caller supplies its least important residents first. Evict only if
+/// enough space can be recovered without sacrificing a more important mesh.
+pub(super) fn victims(
+    candidate: Priority,
+    need: usize,
+    least_important_first: impl IntoIterator<Item = (Priority, usize)>,
+) -> Option<Vec<Key>> {
+    if need == 0 {
+        return Some(Vec::new());
+    }
+    let mut proposed = Vec::new();
+    let mut freed = 0usize;
+    for (rank, bytes) in least_important_first {
+        if rank <= candidate {
+            break;
+        }
+        proposed.push(rank.2);
+        freed = freed.saturating_add(bytes);
+        if freed >= need {
+            return Some(proposed);
+        }
+    }
+    None
+}
