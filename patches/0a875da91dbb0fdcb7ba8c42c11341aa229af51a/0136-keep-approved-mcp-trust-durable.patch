+    #[test]
+    fn valid_legacy_refresh_migrates_durable_trust_without_reviving_expired_grants() {
+        let memory = Memory::default();
+        let mut oauth = OAuth::open(memory.clone(), RESOURCE.into()).unwrap();
+        oauth.open_pairing(1);
+        let id = oauth
+            .register(1, "Codex", &[REDIRECT.into()], true)
+            .unwrap();
+        let code = approve(&mut oauth, 2, &id, FULL_SCOPE);
+        let tokens = oauth
+            .exchange(2, &id, REDIRECT, &code, VERIFIER, None)
+            .unwrap();
+        let refresh = tokens.refresh_token.as_deref().unwrap();
+
+        let legacy_expiry = 2 + LEGACY_REFRESH_LIFE;
+        let mut legacy = oauth.db.clone();
+        legacy
+            .clients
+            .get_mut(&id)
+            .unwrap()
+            .grant
+            .as_mut()
+            .unwrap()
+            .expires = legacy_expiry;
+        oauth.commit(legacy).unwrap();
+        drop(oauth);
+
+        let mut oauth = OAuth::open(memory.clone(), RESOURCE.into()).unwrap();
+        assert!(matches!(
+            oauth.refresh(legacy_expiry, &id, refresh, None, None),
+            Err(Error::InvalidGrant)
+        ));
+        let migrated = oauth
+            .refresh(legacy_expiry - 1, &id, refresh, None, None)
+            .unwrap();
+        drop(oauth);
+
+        let mut restarted = OAuth::open(memory, RESOURCE.into()).unwrap();
+        let renewed = restarted
+            .refresh(
+                legacy_expiry + 365 * 86400,
+                &id,
+                migrated.refresh_token.as_deref().unwrap(),
+                None,
+                None,
+            )
+            .unwrap();
+        assert_eq!(renewed.scope, FULL_SCOPE);
+    }
