+    #[test]
+    fn full_permission_pairing_survives_long_inactivity_and_can_be_revoked() {
+        let memory = Memory::default();
+        let mut oauth = OAuth::open(memory.clone(), RESOURCE.into()).unwrap();
+        oauth.open_pairing(1);
+        let id = oauth
+            .register(1, "Codex", &[REDIRECT.into()], true)
+            .unwrap();
+        let code = approve(&mut oauth, 2, &id, FULL_SCOPE);
+        let original = oauth
+            .exchange(2, &id, REDIRECT, &code, VERIFIER, None)
+            .unwrap();
+        drop(oauth);
+
+        let later = 2 + 365 * 86400;
+        let mut restarted = OAuth::open(memory.clone(), RESOURCE.into()).unwrap();
+        assert!(restarted
+            .authenticate(later, &original.access_token)
+            .is_none());
+        assert_eq!(
+            restarted.trusted().next().unwrap().scopes.as_text(),
+            FULL_SCOPE
+        );
+        let renewed = restarted
+            .refresh(
+                later,
+                &id,
+                original.refresh_token.as_deref().unwrap(),
+                None,
+                None,
+            )
+            .unwrap();
+        assert_eq!(renewed.scope, FULL_SCOPE);
+        assert_eq!(renewed.expires_in, ACCESS_LIFE);
+        assert!(restarted
+            .authenticate(later, &renewed.access_token)
+            .is_some());
+        restarted.revoke_client(&id).unwrap();
+        drop(restarted);
+
+        let mut restarted = OAuth::open(memory, RESOURCE.into()).unwrap();
+        assert_eq!(restarted.trusted().count(), 0);
+        assert!(restarted
+            .authenticate(later, &renewed.access_token)
+            .is_none());
+        assert!(matches!(
+            restarted.refresh(
+                later,
+                &id,
+                renewed.refresh_token.as_deref().unwrap(),
+                None,
+                None
+            ),
+            Err(Error::InvalidGrant)
+        ));
+    }
