+/// CPU-only frustum prepared once for an output. Submitted rows retain the
+/// original GX2 shader ABI and camera-relative f64 translation.
+pub struct PreparedTerrainClip {
+    clip: TerrainClipRows,
+    offsets: [[f64; 4]; 4],
+    axes: [[TerrainClipAxis; 2]; 3],
+}
+
+struct TerrainClipAxis {
+    sign: f32,
+    support: [f32; 3],
+    error: [f32; 3],
+}
+
+impl PreparedTerrainClip {
+    pub fn new(clip: TerrainClipRows) -> Self {
+        let w = clip.rows[3];
+        Self {
+            clip,
+            offsets: clip.rows.map(|row| row.map(f64::from)),
+            axes: core::array::from_fn(|i| {
+                let axis = clip.rows[i];
+                [1.0, -1.0].map(|sign| TerrainClipAxis {
+                    sign,
+                    support: core::array::from_fn(|j| w[j] + sign * axis[j]),
+                    error: core::array::from_fn(|j| w[j].abs() + axis[j].abs()),
+                })
+            }),
+        }
+    }
+
+    pub fn project(&self, [x, y, z]: [f64; 3], bounds: TerrainBounds) -> Option<TerrainClipRows> {
+        let translate = |[a, b, c, d]: [f64; 4]| (a * x + b * y + c * z + d) as f32;
+        let w = translate(self.offsets[3]);
+        let mut offsets = [0.0, 0.0, 0.0, w];
+        let abs: [f32; 3] = core::array::from_fn(|i| bounds.min[i].abs().max(bounds.max[i].abs()));
+        let w_abs = w.abs();
+        for (i, planes) in self.axes.iter().enumerate() {
+            let offset = translate(self.offsets[i]);
+            let initial_error = w_abs + offset.abs();
+            for plane in planes {
+                let mut maximum = w + plane.sign * offset;
+                let mut error = initial_error;
+                for j in 0..3 {
+                    let coefficient = plane.support[j];
+                    let support = if coefficient < 0.0 {
+                        bounds.min[j]
+                    } else {
+                        bounds.max[j]
+                    };
+                    maximum += coefficient * support;
+                    error += plane.error[j] * abs[j];
+                }
+                if maximum.is_finite() && maximum < -8.0 * f32::EPSILON * error.max(1.0) {
+                    return None;
+                }
+            }
+            offsets[i] = offset;
+        }
+        let mut rows = self.clip.rows;
+        for (row, offset) in rows.iter_mut().zip(offsets) {
+            row[3] = offset;
+        }
+        Some(TerrainClipRows { rows })
+    }
+}
