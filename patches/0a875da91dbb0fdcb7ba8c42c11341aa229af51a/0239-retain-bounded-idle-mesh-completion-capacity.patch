+    /// A deferred completion may have emptied the producer queue already.
+    /// Keep only a small unused reserve, so waiting between server ticks
+    /// does not make the next worker grow the same deque again.
+    fn take_after_deferral(&self) -> VecDeque<Done> {
+        const MAX_IDLE_BYTES: usize = 4 * 1024;
+        let Some(mut done) = self.try_lock() else {
+            return VecDeque::new();
+        };
+        if done.is_empty() && done.capacity() <= MAX_IDLE_BYTES / std::mem::size_of::<Done>() {
+            return VecDeque::new();
+        }
+        std::mem::take(&mut *done)
+    }
