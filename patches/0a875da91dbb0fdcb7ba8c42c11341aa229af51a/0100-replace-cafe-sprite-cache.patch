+/// Cafe rename requires a vacant target. Keep the previous complete cache
+/// until the staged replacement reaches the live name.
+#[cfg(any(target_os = "cafe", test))]
+fn publish_cafe_cache(temporary: &std::path::Path, path: &std::path::Path) -> std::io::Result<()> {
+    use std::io::{Error, ErrorKind};
+
+    let backup = path.with_extension("cache.previous");
+    let backed_up = match fs::symlink_metadata(path) {
+        Ok(info) if info.is_file() => {
+            match fs::remove_file(&backup) {
+                Err(error) if error.kind() != ErrorKind::NotFound => return Err(error),
+                _ => {}
+            }
+            fs::rename(path, &backup)?;
+            true
+        }
+        Err(error) if error.kind() == ErrorKind::NotFound => false,
+        Err(error) => return Err(error),
+        Ok(_) => {
+            return Err(Error::new(
+                ErrorKind::InvalidInput,
+                "cache target is not a file",
+            ));
+        }
+    };
+    if let Err(error) = fs::rename(temporary, path) {
+        if backed_up && let Err(restore_error) = fs::rename(&backup, path) {
+            log::warn!(
+                "Horizon sprite cache: previous copy remains at {}: {restore_error}",
+                backup.display()
+            );
+        }
+        return Err(error);
+    }
+    let _ = fs::remove_file(backup);
+    Ok(())
+}
