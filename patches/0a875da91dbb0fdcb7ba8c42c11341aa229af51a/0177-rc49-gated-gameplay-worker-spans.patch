+/* The host owns phase changes. Keep the marker gate open between gameplay
+ * loops so worker jobs need no dependency on the frame's recording state. */
+static void update_worker_capture_phase(uint32_t phase)
+{
+   const bool active = worker_marker_enabled && phase == PLAYING_PHASE;
+   if (active == worker_playing) return;
+   worker_playing = active;
+   atomic_store_explicit(&worker_capture_active, active, memory_order_relaxed);
+}
