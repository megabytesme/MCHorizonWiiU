+/// The ordinary export contains only string properties. Borrow their bytes
+/// to avoid an owned JSON object and strings for every state. Anything the
+/// stricter reader cannot borrow takes the original permissive parser.
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ModelStateFields<'a> {
+    schema: Value,
+    #[serde(borrow)]
+    states: Vec<BTreeMap<&'a str, &'a str>>,
+}
+
+pub(super) struct BorrowedModelStateBlock<'a>(ModelStateFields<'a>);
+
+impl<'de> serde::Deserialize<'de> for BorrowedModelStateBlock<'de> {
+    fn deserialize<D: serde::Deserializer<'de>>(
+        deserializer: D,
+    ) -> std::result::Result<Self, D::Error> {
+        struct Object;
+        impl<'de> serde::de::Visitor<'de> for Object {
+            type Value = BorrowedModelStateBlock<'de>;
+
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                f.write_str("a prepared model-state object")
+            }
+
+            fn visit_map<M: serde::de::MapAccess<'de>>(
+                self,
+                map: M,
+            ) -> std::result::Result<Self::Value, M::Error> {
+                let object = serde::de::value::MapAccessDeserializer::new(map);
+                serde::Deserialize::deserialize(object).map(BorrowedModelStateBlock)
+            }
+        }
+        deserializer.deserialize_map(Object)
+    }
+}
+
+pub(super) enum ModelStateFacts<'a> {
+    Borrowed(BTreeMap<&'a str, BorrowedModelStateBlock<'a>>),
+    Legacy(std::borrow::Cow<'a, BTreeMap<String, Value>>),
+}
+
+impl<'a> ModelStateFacts<'a> {
+    pub(super) fn parse(path: &std::path::Path, bytes: &'a [u8]) -> Result<Self> {
+        if let Ok(facts) = serde_json::from_slice(bytes) {
+            return Ok(Self::Borrowed(facts));
+        }
+        Ok(Self::Legacy(std::borrow::Cow::Owned(
+            horizon_world::json_file::parse(path, bytes)?,
+        )))
+    }
+
+    pub(super) fn blocks(&self, registry: &BlockRegistry) -> Vec<&str> {
+        let keep = |name: &str| registry.default_state(name).is_some();
+        fn short(name: &str) -> &str {
+            name.strip_prefix("minecraft:").unwrap_or(name)
+        }
+        match self {
+            Self::Borrowed(facts) => facts
+                .keys()
+                .copied()
+                .filter(|name| keep(name))
+                .map(short)
+                .collect(),
+            Self::Legacy(facts) => facts
+                .keys()
+                .map(String::as_str)
+                .filter(|name| keep(name))
+                .map(short)
+                .collect(),
+        }
+    }
+
+    fn schema_and_states(
+        &self,
+        name: &str,
+        native: &[(BlockStateId, &BlockProperties)],
+    ) -> Result<(PropertySchema, Option<Vec<Properties>>)> {
+        match self {
+            Self::Borrowed(facts) => {
+                let block = &facts.get(name).ok_or("missing block model state schema")?.0;
+                let schema = model_state_schema(&block.schema)?;
+                let matches = block.states.len() == native.len()
+                    && block.states.iter().zip(native).all(|(row, (_, props))| {
+                        row.len() == props.len()
+                            && props.iter().all(|(key, value)| {
+                                row.get(key.as_str()).copied() == Some(value.as_str())
+                            })
+                    });
+                let possible = (!matches).then(|| {
+                    block
+                        .states
+                        .iter()
+                        .map(|row| {
+                            row.iter()
+                                .map(|(&k, &v)| (k.to_owned(), v.to_owned()))
+                                .collect()
+                        })
+                        .collect()
+                });
+                Ok((schema, possible))
+            }
+            Self::Legacy(facts) => {
+                let block = facts.get(name).ok_or("missing block model state schema")?;
+                let schema = model_state_schema(&block["schema"])?;
+                let states = &block["states"];
+                let possible = if prepared_states_match(states, native) {
+                    None
+                } else {
+                    Some(serde_json::from_value::<Vec<Properties>>(states.clone())?)
+                };
+                Ok((schema, possible))
+            }
+        }
+    }
+}
+
+fn model_state_schema(value: &Value) -> Result<PropertySchema> {
+    value
+        .as_object()
+        .ok_or("invalid model schema")?
+        .iter()
+        .map(|(key, value)| {
+            let values = if let Some(range) = value.get("integer") {
+                PropertyValues::Integer {
+                    minimum: i32::try_from(
+                        range[0]
+                            .as_i64()
+                            .ok_or("invalid integer property minimum")?,
+                    )?,
+                    maximum: i32::try_from(
+                        range[1]
+                            .as_i64()
+                            .ok_or("invalid integer property maximum")?,
+                    )?,
+                }
+            } else {
+                PropertyValues::Named(
+                    value["named"]
+                        .as_array()
+                        .ok_or("missing named property values")?
+                        .iter()
+                        .map(|v| {
+                            v.as_str()
+                                .map(str::to_owned)
+                                .ok_or("invalid named property value")
+                        })
+                        .collect::<std::result::Result<_, _>>()?,
+                )
+            };
+            Ok((key.clone(), values))
+        })
+        .collect()
+}
