+   const bool reuse = tv_depth_lease.epoch == foreground_epoch;
+   if (reuse) {
+      if (!same_depth_layout(&tv_depth_lease.layout, image) ||
+          MEMFindContainHeap(tv_depth_lease.layout.image) != heap)
+         return "lease layout or arena changed";
+      image->image = tv_depth_lease.layout.image;
+   } else {
+      if (MEMGetTotalFreeSizeForExpHeap(heap) < image->imageSize + MEM1_DEPTH_RESERVE ||
+          MEMGetAllocatableSizeForExpHeapEx(heap, (int32_t)image->alignment) < image->imageSize)
+         return "capacity or reserve";
+      image->image = MEMAllocFromExpHeapEx(heap, image->imageSize, (int32_t)image->alignment);
+      if (!image->image) return "allocation failed";
+      if (((uintptr_t)image->image & (image->alignment - 1)) != 0 ||
+          MEMFindContainHeap(image->image) != heap) {
+         MEMFreeToExpHeap(heap, image->image);
+         return "allocation identity";
+      }
+      if (MEMGetTotalFreeSizeForExpHeap(heap) < MEM1_DEPTH_RESERVE) {
+         MEMFreeToExpHeap(heap, image->image);
+         return "reserve after allocation";
+      }
+   }
+
+   image->use = GX2_SURFACE_USE_DEPTH_BUFFER;
+   GX2InitDepthBufferRegs(&candidate);
