+      if (!reuse) MEMFreeToExpHeap(heap, image->image);
+      return "register layout";
+   }
+   if (!reuse) {
+      GX2Invalidate(GX2_INVALIDATE_MODE_CPU, image->image, image->imageSize);
+      tv_depth_lease.epoch = foreground_epoch;
+      tv_depth_lease.layout = *image;
+   }
+
+   scale->mem1_tv_depth = candidate;
+   scale->mem1_epoch = foreground_epoch;
+   return reuse ? "reused" : "active";
+}
