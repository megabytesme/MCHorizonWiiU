+      bytes += (uint64_t)target->color.surface.imageSize + target->color.surface.alignment;
+      bytes += (uint64_t)target->depth.surface.imageSize + target->depth.surface.alignment;
+   }
+   if (bytes > SURFACE_BUDGET) return "surface budget";
