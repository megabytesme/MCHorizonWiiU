+bool horizon_gx2_terrain_load_near_fog(HorizonGx2Terrain *t, const void *gfd)
+{
+   if (!t || !gfd || !t->atlas_grid[0] || t->opaque_pixel.shader || t->half_shader ||
+       t->legacy_attributes || t->legacy_uniforms || t->solid_back_culling) return false;
+   if (t->near_fog_pixel) return true;
+   const GX2VertexShader *stock = t->shader.vertexShader;
+   GX2VertexShader *vertex = WHBGfxLoadGFDVertexShader(0, gfd);
+   bool compatible = clear_fog_vertex_layout(stock, vertex) && vertex->size == stock->size &&
+      !memcmp(&vertex->regs, &stock->regs, sizeof(stock->regs)) &&
+      !memcmp(vertex->program, stock->program, stock->size);
+   if (vertex) WHBGfxFreeVertexShader(vertex);
+   if (!compatible) return false;
+
+   GX2PixelShader *pixel = WHBGfxLoadGFDPixelShader(0, gfd);
+   if (!near_fog_pixel_compatible(&t->pixel, pixel)) {
+      if (pixel) WHBGfxFreePixelShader(pixel);
+      return false;
+   }
+   t->near_fog_pixel = pixel;
+   return true;
+}
