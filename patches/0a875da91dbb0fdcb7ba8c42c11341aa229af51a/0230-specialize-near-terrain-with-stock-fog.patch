+static bool near_fog_pixel_compatible(const TerrainPixelShader *original, GX2PixelShader *candidate)
+{
+   const GX2PixelShader *stock = original->shader;
+   TerrainPixelShader reflection = {0};
+   if (!stock || !candidate || !stock->program || !candidate->program ||
+       stock->size != 142u * 4 || candidate->size != 124u * 4 ||
+       candidate->mode != stock->mode ||
+       memcmp(&candidate->regs, &stock->regs, sizeof(stock->regs)) ||
+       stock->uniformBlockCount || candidate->uniformBlockCount ||
+       stock->uniformVarCount != 3 || candidate->uniformVarCount != 3 ||
+       !stock->uniformVars || !candidate->uniformVars ||
+       stock->initialValueCount || candidate->initialValueCount ||
+       stock->samplerVarCount != 1 || candidate->samplerVarCount != 1 ||
+       !clear_fog_loop_layout(stock->loopVarCount, stock->loopVars,
+                              candidate->loopVarCount, candidate->loopVars) ||
+       !terrain_pixel_shader(&reflection, candidate) ||
+       reflection.sampler_slot != original->sampler_slot ||
+       reflection.fog_color_offset != original->fog_color_offset ||
+       reflection.fog_ranges_offset != original->fog_ranges_offset ||
+       reflection.material_offset != original->material_offset) return false;
+
+   /* Candidate retains the pinned ordinary sampler and both discard branches.
+    * Word 17 contains the size of the final fog/lighting ALU clause. */
+   const uint32_t *a = stock->program, *b = candidate->program;
+   return !memcmp(a, b, 17u * sizeof(*a)) &&
+          !memcmp(a + 18, b + 18, (86u - 18u) * sizeof(*a));
+}
