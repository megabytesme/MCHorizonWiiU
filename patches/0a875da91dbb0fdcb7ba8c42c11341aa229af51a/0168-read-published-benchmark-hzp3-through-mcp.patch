+            records,
+            records,
+        ]
+        .into_iter()
+        .flat_map(u32::to_be_bytes)
+        .collect::<Vec<_>>();
+        fixture.extend((0..records * 352).map(|index| index as u8));
+        fs::write(&path, &fixture).unwrap();
+        assert!(capture_chunk(folder, id, 0).is_none());
+        fs::write(folder.join(format!("{report}.json")), "{}").unwrap();
+
+        let (total, first) = capture_chunk(folder, id, 0).unwrap();
+        assert_eq!(total, fixture.len() as u64);
+        assert_eq!(first.len(), 48 * 1024);
+        let (_, tail) = capture_chunk(folder, id, first.len() as u64).unwrap();
+        assert_eq!([first, tail].concat(), fixture);
