+pub(super) const CAPTURE_CHUNK_BYTES: u64 = 48 * 1024;
+// Keep the published HZP3 layout in sync with gx2_profile.c.
+const CAPTURE_HEADER_BYTES: usize = 28;
+const CAPTURE_FRAME_BYTES: u32 = 352;
+const CAPTURE_CAPACITY: u32 = 4096;
+
+pub(super) fn capture_chunk(folder: &Path, id: &str, offset: u64) -> Option<(u64, Vec<u8>)> {
+    let (report_stem, profile) = id.strip_suffix(".hzp")?.rsplit_once('-')?;
+    BenchmarkProfile::parse(profile)?;
+    let (stamp, scenario) = report_stem.strip_prefix("game-")?.split_once('-')?;
+    if stamp.len() != 14
+        || !stamp.bytes().all(|byte| byte.is_ascii_digit())
+        || !BENCHMARK_SCENES.iter().any(|(name, _)| *name == scenario)
+        || !plain(folder, true)
+        || !plain(&folder.join(format!("{report_stem}.json")), false)
+    {
+        return None;
+    }
+    let path = folder.join(id);
+    if !plain(&path, false) {
+        return None;
+    }
+
+    let mut capture = File::open(path).ok()?;
+    let metadata = capture
+        .metadata()
+        .ok()
+        .filter(|metadata| metadata.is_file())?;
+    let mut header = [0; CAPTURE_HEADER_BYTES];
+    capture.read_exact(&mut header).ok()?;
+    let [magic, version, clock_hz, record_size, capacity, count, total] =
+        std::array::from_fn(|index| {
+            u32::from_be_bytes(header[index * 4..index * 4 + 4].try_into().unwrap())
+        });
+    let size = CAPTURE_HEADER_BYTES as u64 + u64::from(count) * u64::from(CAPTURE_FRAME_BYTES);
+    if magic != u32::from_be_bytes(*b"HZP3")
+        || version != 3
+        || clock_hz == 0
+        || record_size != CAPTURE_FRAME_BYTES
+        || capacity != CAPTURE_CAPACITY
+        || count == 0
+        || count != capacity.min(total)
+        || metadata.len() != size
+        || offset >= size
+    {
+        return None;
+    }
+
+    capture.seek(SeekFrom::Start(offset)).ok()?;
+    let mut bytes = vec![0; (size - offset).min(CAPTURE_CHUNK_BYTES) as usize];
+    capture.read_exact(&mut bytes).ok()?;
+    Some((size, bytes))
+}
