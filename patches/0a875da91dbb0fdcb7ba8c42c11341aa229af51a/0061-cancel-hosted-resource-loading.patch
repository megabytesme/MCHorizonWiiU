+
+#[test]
+fn cancelled_generation_skips_deferred_core_and_a_fresh_generation_runs() {
+    let menu = Progress::new();
+    let worker = menu.clone();
+    let other = Progress::new();
+    std::thread::scope(|scope| {
+        let (entered, began) = std::sync::mpsc::sync_channel(0);
+        let (release, released) = std::sync::mpsc::sync_channel(0);
+        let loader = scope.spawn(move || {
+            let core = Step::Later(Box::new(|| panic!("cancelled startup began its core")));
+            entered.send(()).unwrap();
+            released.recv().unwrap();
+            core.join_if_loading(&worker)
+        });
+        began.recv().unwrap();
+        assert!(menu.request_cancel());
+        release.send(()).unwrap();
+        assert!(loader.join().unwrap().is_err());
+    });
+    let core = Step::Later(Box::new(|| 42));
+    assert_eq!(core.join_if_loading(&other).unwrap(), 42);
+}
