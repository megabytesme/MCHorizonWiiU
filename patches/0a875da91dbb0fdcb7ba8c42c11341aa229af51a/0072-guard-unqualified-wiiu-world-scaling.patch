 use std::{fs, path::Path};
 
 pub const FILE: &str = "horizon-graphics.txt";
-/// Cafe renders directly at 100% and scales down its world surfaces.
+/// Cafe's saved world scale ranges up to its direct-rendering resolution.
 pub const RESOLUTION_SCALE_MAX: u32 = if cfg!(target_os = "cafe") { 100 } else { 200 };
+
+/// Fixed scaling is restricted to disposable diagnostic runs pending Wii U qualification.
+/// The setting and presenter share this process-wide decision.
+#[cfg(target_os = "cafe")]
+pub fn cafe_experimental_world_scaling() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        Path::new("/vol/external01/wiiu/apps/HorizonWiiU/gx2-world-scale-experimental.enable")
+            .is_file()
+    })
+}
