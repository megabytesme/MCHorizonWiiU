+    #[test]
+    fn deferred_sections_survive_reprioritization_when_the_camera_moves() {
+        let ahead: SectionMask = [0, 1, 2, 3].into_iter().collect();
+        let behind: SectionMask = [4, 5].into_iter().collect();
+        let (submitted, deferred) = mesh_batch(ahead, &mut 2);
+        assert_eq!(submitted.iter().collect::<Vec<_>>(), [0, 1]);
+        assert_eq!(deferred.iter().collect::<Vec<_>>(), [2, 3]);
+
+        let mut candidates = vec![(6, deferred), (1, behind)];
+        nearest_first(&mut candidates, 1);
+        assert_eq!(candidates, [(1, behind)]);
+        let (submitted, remaining) = mesh_batch(candidates[0].1, &mut 2);
+        assert_eq!((submitted, remaining), (behind, SectionMask::EMPTY));
+
+        let mut candidates = vec![(6, deferred)];
+        nearest_first(&mut candidates, 2);
+        assert_eq!(mesh_batch(candidates[0].1, &mut 2), (deferred, SectionMask::EMPTY));
+    }
