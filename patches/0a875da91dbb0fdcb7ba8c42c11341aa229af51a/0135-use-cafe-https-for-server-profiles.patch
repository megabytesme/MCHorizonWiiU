+fn services_agent() -> ureq::Agent {
+    let timeout = Duration::from_secs(15);
+    let builder = ureq::AgentBuilder::new();
+    #[cfg(not(target_os = "cafe"))]
+    let builder = builder.timeout(timeout);
+    // ureq's overall timeout sets a socket send timeout before TLS. Cafe
+    // supports connect deadlines and emulates timeouts for individual reads.
+    #[cfg(target_os = "cafe")]
+    let builder = builder
+        .timeout_connect(timeout)
+        .timeout_read(timeout)
+        .https_only(true)
+        .redirects(0);
+    builder
+        .user_agent(&format!("Horizon/{}", horizon_core::release::VERSION))
+        .build()
+}
+
+fn get_service(agent: &ureq::Agent, url: &str) -> Option<String> {
+    let response = agent.get(url).call().ok()?;
+    (200..300).contains(&response.status()).then_some(())?;
+    // ureq's string reader already caps the response body at 10 MiB.
+    response.into_string().ok()
+}
