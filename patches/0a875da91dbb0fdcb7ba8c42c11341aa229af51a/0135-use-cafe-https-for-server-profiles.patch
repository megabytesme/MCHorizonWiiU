+    fn service_requests_follow_discovery_and_reject_a_redirect_body() {
+        use std::io::{BufRead, BufReader, Write};
+        use std::net::TcpListener;
+
+        const ID: u128 = 0x069a79f444e94726a5befca90e38aaf5;
+        const PROFILE: &str = r#"{"id":"069a79f444e94726a5befca90e38aaf5","name":"Notch"}"#;
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let base = format!("http://{}", listener.local_addr().unwrap());
+        let discovery = format!(
+            r#"{{
+                "discovery": {{
+                    "profiles": {{"endpoints": {{"getByName": {{"uri": "{base}/name/{{name}}"}}}}}},
+                    "session": {{"endpoints": {{"getProfileById": {{"uri": "{base}/id/{{profileId}}?fixture=1"}}}}}},
+                    "authentication": {{"endpoints": {{"getPublicKeys": {{"uri": "{base}/keys"}}}}}}
+                }}
+            }}"#
+        );
+        let server = std::thread::spawn(move || {
+            for (path, status, body) in [
+                ("/discovery", "200 OK", discovery.as_str()),
+                ("/name/notch", "200 OK", PROFILE),
+                ("/discovery", "200 OK", discovery.as_str()),
+                (
+                    "/id/069a79f444e94726a5befca90e38aaf5?fixture=1&unsigned=false",
+                    "200 OK",
+                    PROFILE,
+                ),
+                ("/discovery", "200 OK", discovery.as_str()),
+                ("/keys", "200 OK", "{}"),
+                ("/discovery", "302 Found", discovery.as_str()),
+            ] {
+                let (mut stream, _) = listener.accept().unwrap();
+                stream
+                    .set_read_timeout(Some(Duration::from_secs(3)))
+                    .unwrap();
+                let mut reader = BufReader::new(&mut stream);
+                let mut line = String::new();
+                assert_ne!(reader.read_line(&mut line).unwrap(), 0);
+                assert_eq!(line, format!("GET {path} HTTP/1.1\r\n"));
+                loop {
+                    line.clear();
+                    assert_ne!(reader.read_line(&mut line).unwrap(), 0);
+                    if line == "\r\n" {
+                        break;
+                    }
+                }
+                write!(
+                    stream,
+                    "HTTP/1.1 {status}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+                    body.len()
+                )
+                .unwrap();
+            }
+        });
+        let url = format!("{base}/discovery");
+        let profile = Some(NameAndId {
+            id: ID,
+            name: "Notch".into(),
+        });
+        assert_eq!(find_by_name(&url, "Notch"), profile);
+        assert_eq!(find_by_id(&url, ID), profile);
+        assert!(fetch_profile_key_keys(&url).unwrap().is_empty());
+        assert!(fetch_profile_key_keys(&url).is_err());
+        server.join().unwrap();
+    }
