+HorizonGx2GroupedRetirement *horizon_gx2_profile_grouped_retirement_sample(void)
+{
+   if (!grouped_retirement_enabled || history != &process_history || !recording ||
+       current.phase != PLAYING_PHASE || history->total % GROUPED_RETIREMENT_PERIOD != 0 ||
+       grouped_retirement_count >= GROUPED_RETIREMENT_CAPACITY)
+      return NULL;
+   HorizonGx2GroupedRetirement *sample = &grouped_retirement[grouped_retirement_count++];
+   *sample = (HorizonGx2GroupedRetirement){
+      .sequence = history->total,
+      .start_ticks = started - history->epoch,
+   };
+   return sample;
+}
+
+static const char *grouped_retirement_class(const HorizonGx2GroupedRetirement *sample)
+{
+   if (!sample->draw_done) return "invalid-draw-done";
+   if (sample->before_flush <= 0 || sample->submitted <= sample->before_flush)
+      return "invalid-flush-token";
+   if (sample->retired_after_flush < 0 || sample->retired_after_flush > sample->submitted ||
+       sample->submitted_after_draw_done < sample->submitted ||
+       sample->retired_after_draw_done < sample->retired_after_flush ||
+       sample->retired_after_draw_done != sample->submitted_after_draw_done)
+      return "invalid-retirement";
+   if (!sample->accepted) return "invalid-pair-rejected";
+   return sample->retired_after_flush < sample->submitted ? "pending-after-flush" : "retired-after-flush";
+}
+
+static void report_grouped_retirement(void)
+{
+   if (history != &process_history) return;
+   for (uint32_t i = 0; i < grouped_retirement_count; ++i) {
+      const HorizonGx2GroupedRetirement *sample = &grouped_retirement[i];
+      // Match the existing serial convention for 64-bit fields.
+      char line[384];
+      snprintf(line, sizeof(line),
+               "Horizon GX2 grouped queue retirement seq=%u start_ticks=%llu class=%s "
+               "before_flush=%lld submitted=%lld retired_at_flush=%lld "
+               "submitted_after_draw_done=%lld retired_after_draw_done=%lld "
+               "draw_done=%u paired_accept=%u\n",
+               sample->sequence, (unsigned long long)sample->start_ticks,
+               grouped_retirement_class(sample), (long long)sample->before_flush,
+               (long long)sample->submitted, (long long)sample->retired_after_flush,
+               (long long)sample->submitted_after_draw_done, (long long)sample->retired_after_draw_done,
+               (unsigned)sample->draw_done, (unsigned)sample->accepted);
+      OSReport("%s", line);
+   }
+   grouped_retirement_count = 0;
+}
