+/* Exact WUT 1.9.2 WHBGfxFinishRender order, sampled only in grouped presents.
+ * Read-only observations preserve the original acceptance and recovery rules. */
+static void grouped_finish_observed(HorizonGx2GroupedRetirement *sample)
+{
+   GX2SwapScanBuffers();
+   sample->before_flush = GX2GetLastSubmittedTimeStamp();
+   GX2Flush();
+   sample->submitted = GX2GetLastSubmittedTimeStamp();
+   sample->retired_after_flush = GX2GetRetiredTimeStamp();
+   sample->draw_done = GX2DrawDone();
+   sample->submitted_after_draw_done = GX2GetLastSubmittedTimeStamp();
+   sample->retired_after_draw_done = GX2GetRetiredTimeStamp();
+   GX2SetTVEnable(TRUE);
+   GX2SetDRCEnable(TRUE);
+}
