+bool horizon_gx2_profile_render_tail_arm(int64_t prior, int64_t submitted, int64_t retired)
+{
+   RenderTail *tail = render_tail_current();
+   if (!tail) return false;
+   if (tail->state != TAIL_NO_EARLY_FLUSH) {
+      tail->state = TAIL_QUEUE_CHANGED;
+      return false;
+   }
+
+   const DeadlinePoint *start = &deadline_current->points[GX2_DEADLINE_START];
+   if (!(deadline_current->mask & (1u << GX2_DEADLINE_START)) || prior <= 0 ||
+       start->submitted != (uint64_t)prior || start->retired != (uint64_t)prior ||
+       submitted != prior || retired != prior || GX2GetLastSubmittedTimeStamp() != prior) {
+      tail->state = TAIL_UNCLEAN_PRIOR;
+      return false;
+   }
+   tail->prior = prior;
+   tail->state = TAIL_ARMED;
+   return true;
+}
