+   if (!(deadline_current->mask & (1u << GX2_DEADLINE_AFTER_FLIP_WAIT)) ||
+       waited->submitted != (uint64_t)tail->token || waited->retired < (uint64_t)tail->prior ||
+       waited->retired > (uint64_t)tail->token) {
