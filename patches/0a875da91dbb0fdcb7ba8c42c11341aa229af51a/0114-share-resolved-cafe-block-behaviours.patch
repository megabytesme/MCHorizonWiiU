-    collision: Option<(PathBuf, Arc<BlockCollisionRegistry<'static>>)>,
+    collision: Option<SharedCollision>,
+}
+
+struct SharedCollision {
+    root: PathBuf,
+    registry: Arc<BlockCollisionRegistry<'static>>,
+    behaviour_pair: Option<Mutex<BehaviourPair>>,
+}
+
+enum BehaviourPair {
+    Pending,
+    Available(Box<Behaviours>),
+    Consumed,
+}
+
+/// Supply the separately owned gameplay and worldgen instances. Keep at most
+/// one unclaimed result. An I/O failure leaves the next request free to retry.
+fn paired_behaviours(
+    pair: &Mutex<BehaviourPair>,
+    build: impl FnOnce() -> io::Result<Behaviours>,
+) -> io::Result<Behaviours> {
+    let mut pair = pair.lock().unwrap_or_else(|error| error.into_inner());
+    match std::mem::replace(&mut *pair, BehaviourPair::Pending) {
+        BehaviourPair::Pending => {
+            let first = build()?;
+            *pair = BehaviourPair::Available(Box::new(first.fresh_instance()));
+            Ok(first)
+        }
+        BehaviourPair::Available(second) => {
+            *pair = BehaviourPair::Consumed;
+            log::info!("Horizon: reused resolved block behaviour tables");
+            Ok(*second)
+        }
+        BehaviourPair::Consumed => {
+            *pair = BehaviourPair::Consumed;
+            drop(pair);
+            build()
+        }
+    }
 }
 
