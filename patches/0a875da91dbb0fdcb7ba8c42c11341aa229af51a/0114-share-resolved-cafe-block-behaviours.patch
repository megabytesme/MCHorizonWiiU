 impl Behaviours {
+    /// Fork freshly resolved tables for a second consumer in the same resource
+    /// load. Each world retains its own mutable state and shape identities.
+    fn fresh_instance(&self) -> Self {
+        let canonical = [VoxelShape::empty(), VoxelShape::block()];
+        let shapes = self
+            .shapes
+            .iter()
+            .map(|shape| {
+                if canonical
+                    .iter()
+                    .any(|canonical| canonical.same_identity(shape))
+                {
+                    shape.clone()
+                } else {
+                    shape.fresh_identity()
+                }
+            })
+            .collect();
+        Self {
+            table: self.table.clone(),
+            props: self.props,
+            named: self.named,
+            tags: self.tags.clone(),
+            all_tags: self.all_tags.clone(),
+            facts: self.facts.clone(),
+            shapes,
+            shape_info: self.shape_info.clone(),
+            fluid_tags: self.fluid_tags,
+            fluid_definitions: self.fluid_definitions.clone(),
+            blocks: self.blocks.clone(),
+            items: self.items.clone(),
+            potted_by_content: self.potted_by_content.clone(),
+            liquid_blocks: self.liquid_blocks.clone(),
+            dynamic: self.dynamic.clone(),
+            occlusion_cache: Default::default(),
+            growth: Default::default(),
+            block_maps: Default::default(),
+        }
+    }
