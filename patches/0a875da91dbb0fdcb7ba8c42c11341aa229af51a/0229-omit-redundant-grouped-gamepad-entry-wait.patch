+//! Evidence for omitting one GamePad terrain entry wait in a grouped pair.
+
+#[derive(Default)]
+pub(super) enum EntryWait<T> {
+    #[default]
+    Disabled,
+    AwaitingTv,
+    TvDrained(T),
+    TvComplete(T),
+    Authorized(T),
+    Omitted,
+}
+
+impl<T: PartialEq> EntryWait<T> {
+    pub(super) fn armed() -> Self {
+        Self::AwaitingTv
+    }
+
+    pub(super) fn tv_drained(&mut self, snapshot: impl FnOnce() -> Option<T>) {
+        if matches!(self, Self::AwaitingTv) {
+            *self = snapshot().map_or(Self::Disabled, Self::TvDrained);
+        } else {
+            *self = Self::Disabled;
+        }
+    }
+
+    pub(super) fn tv_complete(&mut self, lane: bool) {
+        *self = match std::mem::take(self) {
+            Self::TvDrained(scene) if lane => Self::TvComplete(scene),
+            _ => Self::Disabled,
+        };
+    }
+
+    pub(super) fn authorize(&mut self) -> bool {
+        if let Self::TvComplete(scene) = std::mem::take(self) {
+            *self = Self::Authorized(scene);
+            return true;
+        }
+        false
+    }
+
+    pub(super) fn omit_gamepad(&mut self, snapshot: impl FnOnce() -> Option<T>) -> bool {
+        match std::mem::take(self) {
+            Self::Authorized(scene) if snapshot().as_ref() == Some(&scene) => {
+                *self = Self::Omitted;
+                true
+            }
+            _ => false,
+        }
+    }
+
+    pub(super) fn omitted(&self) -> bool {
+        matches!(self, Self::Omitted)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::EntryWait;
+
+    #[test]
+    fn same_scene_needs_exactly_one_verified_tv_lane_and_its_host_authorization() {
+        let mut wait = EntryWait::armed();
+        wait.tv_drained(|| Some((1, 2, 3)));
+        wait.tv_complete(true);
+        wait.authorize();
+        assert!(wait.omit_gamepad(|| Some((1, 2, 3))));
+        assert!(wait.omitted());
+        assert!(!wait.omit_gamepad(|| panic!("second GamePad callback")));
+    }
+
+    #[test]
+    fn terminal_failures_leave_gamepad_on_the_existing_wait() {
+        let mut disabled = EntryWait::<u32>::default();
+        disabled.tv_drained(|| panic!("default path sampled"));
+        assert!(!disabled.omit_gamepad(|| panic!("default path sampled")));
+        let mut missing_drain = EntryWait::<u32>::armed();
+        missing_drain.tv_complete(true);
+        missing_drain.authorize();
+        assert!(!missing_drain.omit_gamepad(|| panic!("TV never drained")));
+        let mut bad_tv_dimensions = EntryWait::armed();
+        bad_tv_dimensions.tv_drained(|| None::<u32>);
+        bad_tv_dimensions.tv_complete(true);
+        bad_tv_dimensions.authorize();
+        assert!(!bad_tv_dimensions.omit_gamepad(|| panic!("TV identity missing")));
+        let mut fallback = EntryWait::armed();
+        fallback.tv_drained(|| Some(1));
+        fallback.tv_complete(false);
+        fallback.authorize();
+        assert!(!fallback.omit_gamepad(|| panic!("TV used the direct HUD")));
+        let mut early = EntryWait::armed();
+        early.tv_drained(|| Some(1));
+        early.authorize();
+        early.tv_complete(true);
+        assert!(!early.omit_gamepad(|| panic!("host authorized too early")));
+        let mut missing_authorization = EntryWait::armed();
+        missing_authorization.tv_drained(|| Some(1));
+        missing_authorization.tv_complete(true);
+        assert!(!missing_authorization.omit_gamepad(|| panic!("host declined")));
+        let mut changed = EntryWait::armed();
+        changed.tv_drained(|| Some(1));
+        changed.tv_complete(true);
+        changed.authorize();
+        assert!(!changed.omit_gamepad(|| Some(2)));
+    }
+}
