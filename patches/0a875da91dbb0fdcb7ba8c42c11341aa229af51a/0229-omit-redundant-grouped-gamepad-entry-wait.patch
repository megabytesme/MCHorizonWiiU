+static bool grouped_drc_overlap_attachments(const void *images[4])
+{
+   const GX2ColorBuffer *tv = WHBGfxGetTVColourBuffer();
+   const GX2ColorBuffer *drc = WHBGfxGetDRCColourBuffer();
+   const GX2DepthBuffer *tv_depth = WHBGfxGetTVDepthBuffer();
+   const GX2DepthBuffer *drc_depth = WHBGfxGetDRCDepthBuffer();
+   if (!tv || !drc || !tv_depth || !drc_depth) return false;
+   images[0] = tv->surface.image;
+   images[1] = drc->surface.image;
+   images[2] = tv_depth->surface.image;
+   images[3] = drc_depth->surface.image;
+   for (size_t i = 0; i < 4; ++i) {
+      if (!images[i]) return false;
+      for (size_t j = 0; j < i; ++j) {
+         if (images[i] == images[j]) return false;
+      }
+   }
+   return true;
+}
