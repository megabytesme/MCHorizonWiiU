+static bool read_deadline_sections(FILE *file, uint32_t *sections)
+{
+   uint32_t value = 0;
+   bool digits = false, trailing = false;
+   for (unsigned length = 0;; ++length) {
+      const int ch = fgetc(file);
+      if (ch == EOF) break;
+      if (length == 32) return false;
+      if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r') {
+         trailing = digits;
+         continue;
+      }
+      if (trailing || ch < '0' || ch > '9') return false;
+      const uint32_t digit = (uint32_t)(ch - '0');
+      if (value > (UINT32_MAX - digit) / 10) return false;
+      value = value * 10 + digit;
+      digits = true;
+   }
+   if (ferror(file)) return false;
+   *sections = value;
+   return true;
+}
