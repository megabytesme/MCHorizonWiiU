+static bool deadline_matches_frame(const ProfileFrame *frame)
+{
+   if (frame->phase != PLAYING_PHASE || frame->counters[GX2_PROFILE_PRESENTED] != 1 ||
+       frame->stages[SCREENSHOT_STAGE]) return false;
+   if (!deadline_sections) return true;
+   const uint32_t *extra = frame->extra_counters;
+   return extra[TV_SUBMISSIONS] == 1 && extra[DRC_SUBMISSIONS] == 1 &&
+      extra[TV_SECTIONS_DRAWN] == deadline_sections && extra[DRC_SECTIONS_DRAWN] == deadline_sections;
+}
