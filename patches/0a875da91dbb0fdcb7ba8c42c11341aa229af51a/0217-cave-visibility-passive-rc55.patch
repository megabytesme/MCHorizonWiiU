diff --git a/wiiu/loading_host/cave_visibility.rs b/wiiu/loading_host/cave_visibility.rs
new file mode 100644
index 0000000000000000000000000000000000000000..efbe16e840bafc4475ce4f1daf57d050be2e6282
--- /dev/null
+++ b/wiiu/loading_host/cave_visibility.rs
@@ -0,0 +1,197 @@
+//! Opt-in passive observer of the stock native terrain candidate lists.
+use horizon_client::{
+    chunk::ColumnLayout,
+    gfx::{Frame, SectionKey, SectionOcclusion},
+    mesher::ALL_VISIBLE,
+};
+
+const MARKER: &str = "/vol/external01/wiiu/apps/HorizonWiiU/gx2-cave-visibility.enable";
+const MAX_COLUMNS: usize = 512;
+const INTERVAL: u32 = 120;
+const STILL_FRAMES: u8 = 8;
+
+#[derive(Default)]
+struct Counts {
+    pre: u32,
+    eligible: u32,
+    unknown: u32,
+}
+
+impl Counts {
+    fn record(&mut self, visible: Option<bool>) {
+        self.pre += 1;
+        self.eligible += u32::from(visible != Some(false));
+        self.unknown += u32::from(visible.is_none());
+    }
+}
+
+pub(super) struct Sample {
+    origin: SectionKey,
+    generation: u64,
+    radius: i32,
+    solid: [Counts; 2],
+    translucent: [Counts; 2],
+}
+
+pub(super) struct Probe {
+    enabled: bool,
+    supported_layout: bool,
+    graph: Option<Box<SectionOcclusion>>,
+    eye: Option<[f64; 3]>,
+    searched_eye: Option<[f64; 3]>,
+    still_frames: u8,
+    pairs: u32,
+    remaining: u32,
+}
+
+impl Probe {
+    pub(super) fn new() -> Self {
+        let enabled = std::path::Path::new(MARKER).is_file();
+        if enabled {
+            unsafe {
+                super::OSReport(c"Horizon GX2 cave visibility observation requested\n".as_ptr())
+            };
+        }
+        Self {
+            enabled,
+            supported_layout: false,
+            graph: None,
+            eye: None,
+            searched_eye: None,
+            still_frames: 0,
+            pairs: 0,
+            remaining: 0,
+        }
+    }
+
+    pub(super) fn set_layout(&mut self, layout: ColumnLayout) {
+        // The first observer has stock Overworld-sized storage only.
+        self.supported_layout = layout.min_y() == -64 && layout.sections() == 24;
+        if self.enabled && self.supported_layout && self.graph.is_none() {
+            self.graph = SectionOcclusion::new_async(-64, 24).map(Box::new);
+            if self.graph.is_none() {
+                self.disable(c"worker");
+            }
+        }
+    }
+
+    pub(super) fn clear(&mut self) {
+        if let Some(graph) = &mut self.graph {
+            graph.clear();
+        }
+        self.eye = None;
+        self.searched_eye = None;
+        self.still_frames = 0;
+        self.remaining = 0;
+    }
+
+    pub(super) fn forget(&mut self, key: SectionKey) {
+        if let Some(graph) = self.graph.as_mut().filter(|_| self.supported_layout) {
+            graph.set(key, ALL_VISIBLE);
+        }
+    }
+
+    pub(super) fn publish(&mut self, key: SectionKey, visibility: u64) {
+        if let Some(graph) = self.graph.as_mut().filter(|_| self.supported_layout) {
+            if !graph.set_bounded(key, visibility, MAX_COLUMNS) {
+                self.disable(c"topology-cap");
+            }
+        }
+    }
+
+    pub(super) fn prepare(&mut self, frame: &Frame<'_>) -> Option<Sample> {
+        if !self.enabled {
+            return None;
+        }
+        let eye = frame.camera.to_array();
+        if !self.supported_layout
+            || frame.title
+            || !frame.cave_culling
+            || !(16.0..=96.0).contains(&frame.detail_distance)
+            || frame.distance > frame.detail_distance
+            || !eye
+                .iter()
+                .all(|v| (-30_000_000.0..=30_000_000.0).contains(v))
+            || !(-64.0..320.0).contains(&eye[1])
+        {
+            self.eye = None;
+            self.still_frames = 0;
+            return None;
+        }
+        if self.eye != Some(eye) {
+            self.eye = Some(eye);
+            self.still_frames = 0;
+            return None;
+        }
+        self.still_frames = self.still_frames.saturating_add(1);
+        if self.remaining != 0 || self.still_frames < STILL_FRAMES {
+            return None;
+        }
+
+        let graph = self.graph.as_mut()?;
+        if self.searched_eye != Some(eye) {
+            graph.invalidate_view();
+            self.searched_eye = Some(eye);
+        }
+        let radius = (frame.detail_distance / 16.0) as i32 + 2;
+        if !graph.update_async(frame.camera, radius) {
+            self.disable(c"worker");
+            return None;
+        }
+        let (origin, generation) = graph.fresh_origin(frame.camera, radius)?;
+        Some(Sample {
+            origin,
+            generation,
+            radius,
+            solid: Default::default(),
+            translucent: Default::default(),
+        })
+    }
+
+    fn visible(&self, key: SectionKey, origin: SectionKey) -> Option<bool> {
+        self.graph.as_ref()?.visible_for_camera(key, origin)
+    }
+
+    pub(super) fn solid(&self, sample: &mut Sample, output: usize, key: SectionKey) {
+        sample.solid[output].record(self.visible(key, sample.origin));
+    }
+
+    pub(super) fn translucent(&self, sample: &mut Sample, output: usize, key: SectionKey) {
+        sample.translucent[output].record(self.visible(key, sample.origin));
+    }
+
+    pub(super) fn paired(&mut self, sample: Option<Sample>) {
+        if !self.enabled {
+            return;
+        }
+        self.pairs = self.pairs.wrapping_add(1);
+        self.remaining = self.remaining.saturating_sub(1);
+        let Some(sample) = sample else { return };
+        self.remaining = INTERVAL;
+        let (x, y, z) = sample.origin;
+        // Keep each line independently parseable and short enough for OSReport.
+        for (output, (solid, translucent)) in
+            sample.solid.iter().zip(&sample.translucent).enumerate()
+        {
+            unsafe {
+                super::OSReport(
+                    c"Horizon GX2 cave visibility pair=%u graph=%llu origin=%d,%d,%d radius=%d output=%u solid=%u,%u,%u translucent=%u,%u,%u\n".as_ptr(),
+                    self.pairs, sample.generation, x, y, z, sample.radius, output as u32,
+                    solid.pre, solid.eligible, solid.unknown,
+                    translucent.pre, translucent.eligible, translucent.unknown,
+                );
+            }
+        }
+    }
+
+    fn disable(&mut self, reason: &std::ffi::CStr) {
+        self.enabled = false;
+        self.graph = None;
+        unsafe {
+            super::OSReport(
+                c"Horizon GX2 cave visibility observation disabled reason=%s\n".as_ptr(),
+                reason.as_ptr(),
+            );
+        }
+    }
+}
