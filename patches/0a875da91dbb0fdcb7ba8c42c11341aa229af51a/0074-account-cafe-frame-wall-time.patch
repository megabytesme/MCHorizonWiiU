+#[derive(Clone, Copy, Default)]
+pub(in crate::game) struct StepSpans {
+    pub(super) idle: Duration,
+    pub(super) artwork: Duration,
+    pub(super) redraw: Duration,
+}
+
+#[derive(Default)]
+struct WallTimes {
+    game_steps: Duration,
+    idle: Duration,
+    artwork: Duration,
+    redraw_outside_submission: Duration,
+    submission_outside_waits: Duration,
+    waits: Duration,
+    other_game_step: Duration,
+    invalid_steps: u32,
+}
+
+impl WallTimes {
+    fn observe(&mut self, elapsed: Duration, spans: StepSpans, work: CafeFrameWork) {
+        self.game_steps += elapsed;
+        // These are nested wall spans on the render thread. A broken nesting
+        // boundary must not be hidden by independently saturating each bucket.
+        let covered = spans.idle + spans.artwork + spans.redraw;
+        if covered > elapsed || work.submission > spans.redraw || work.gpu_wait > work.submission {
+            self.invalid_steps += 1;
+            self.other_game_step += elapsed;
+            return;
+        }
+        self.idle += spans.idle;
+        self.artwork += spans.artwork;
+        self.redraw_outside_submission += spans.redraw - work.submission;
+        self.submission_outside_waits += work.submission - work.gpu_wait;
+        self.waits += work.gpu_wait;
+        self.other_game_step += elapsed - covered;
+    }
+
+    // Recorded iterations are game steps reaching finish, including ones without a built frame.
+    fn per_iteration(&self, window: Duration, iterations: u32) -> serde_json::Value {
+        let mean = |duration: Duration| duration.as_secs_f64() * 1000.0 / f64::from(iterations);
+        serde_json::json!({
+            "game_steps": mean(self.game_steps),
+            "game_idle": mean(self.idle),
+            "artwork_preparation": mean(self.artwork),
+            "redraw_outside_submission": mean(self.redraw_outside_submission),
+            "submission_outside_measured_waits": mean(self.submission_outside_waits),
+            "measured_gx2_waits": mean(self.waits),
+            "other_inside_game_step": mean(self.other_game_step),
+            "outside_timed_game_steps": window.checked_sub(self.game_steps).map(mean),
+            "invalid_game_steps": self.invalid_steps,
+            "recorded_iterations": iterations,
+        })
+    }
+}
