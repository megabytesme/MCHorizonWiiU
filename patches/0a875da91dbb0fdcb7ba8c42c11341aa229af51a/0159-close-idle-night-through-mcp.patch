+struct PendingClose {
+    principal: Principal,
+    deadline: Instant,
+}
+
+impl PendingClose {
+    fn active(&self) -> bool {
+        HOME.load(Ordering::Acquire)
+            && launcher_allowed()
+            && Instant::now() < self.deadline
+            && self.principal.scopes.contains(Scopes::LAUNCHER_MANAGE)
+            && self.principal.is_active()
+    }
+}
+
+fn queue_close(principal: &Principal, args: &Value, disconnected: &dyn Fn() -> bool) -> Value {
+    if !args.as_object().is_some_and(|args| args.is_empty()) {
+        return text_result("This tool does not take arguments.", true);
+    }
+    let request = PendingClose {
+        principal: principal.clone(),
+        deadline: Instant::now() + Duration::from_secs(3),
+    };
+    if !request.active() {
+        return text_result("Return to idle Night with Agent Control enabled.", true);
+    }
+    let mut close = CLOSE.lock().unwrap();
+    let launch = LAUNCH.lock().unwrap();
+    let profile = PROFILE.lock().unwrap();
+    if launch.is_some() || profile.is_some() || close.as_ref().is_some_and(PendingClose::active) {
+        return text_result("Wait for Night to finish the pending action.", true);
+    }
+    let service = local_service().lock().unwrap();
+    if disconnected() || !request.active() || !service.can_agent_close() {
+        return text_result("Return to idle Night before closing Horizon.", true);
+    }
+    *close = Some(request);
+    text_result("Night close requested.", false)
+}
+
+pub(super) fn take_close() -> bool {
+    let mut close = CLOSE.lock().unwrap();
+    let Some(request) = close.take() else {
+        return false;
+    };
+    let launch = LAUNCH.lock().unwrap();
+    let profile = PROFILE.lock().unwrap();
+    if launch.is_some() || profile.is_some() {
+        return false;
+    }
+    let service = local_service().lock().unwrap();
+    if !request.active() || !service.can_agent_close() {
+        return false;
+    }
+    HOME.store(false, Ordering::Release);
+    true
+}
