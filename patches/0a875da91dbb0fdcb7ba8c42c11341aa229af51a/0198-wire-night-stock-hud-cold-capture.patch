+    /// Qualify the already-open ordinary snapshot without changing its lookup
+    /// identity or file position. Installed generations must be immutable.
+    pub fn matches_verified_content(
+        &self,
+        expected: [u8; 32],
+        cancel: &std::sync::atomic::AtomicBool,
+    ) -> io::Result<bool> {
+        use sha2::{Digest, Sha256};
+        use std::sync::atomic::Ordering;
+
+        if cancel.load(Ordering::Acquire) || self.size > 192 * 1024 * 1024 {
+            return Ok(false);
+        }
+        let mut memo = self
+            .verified_content
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner);
+        if let Some(digest) = *memo {
+            return Ok(digest == expected);
+        }
+        let mut digest = Sha256::new();
+        let mut buffer = vec![0; 128 * 1024];
+        let mut offset = 0;
+        while offset < self.size {
+            if cancel.load(Ordering::Acquire) {
+                return Ok(false);
+            }
+            let count = (self.size - offset).min(buffer.len() as u64) as usize;
+            let chunk = &mut buffer[..count];
+            read_at(&self.file, chunk, offset)?;
+            digest.update(chunk);
+            offset += count as u64;
+        }
+        let actual: [u8; 32] = digest.finalize().into();
+        *memo = Some(actual);
+        Ok(actual == expected && !cancel.load(Ordering::Acquire))
+    }
+
