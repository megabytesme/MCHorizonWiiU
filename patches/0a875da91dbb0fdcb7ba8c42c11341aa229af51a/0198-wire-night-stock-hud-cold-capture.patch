new file mode 100644
index 0000000000000000000000000000000000000000..6bedb18bcb914d9f1f46d210a496ce0e2a755d64
--- /dev/null
+++ b/crates/horizon-client/src/platform/cafe_stock_hud.rs
@@ -0,0 +1,149 @@
+//! One opt-in Night launch. Keep the candidate private until a clean return.
+
+use super::{HudAtlas, UiResources};
+use horizon_assets::resource_source::ResourceSource;
+use horizon_client_render::hud::stock_seed::{NightStockHudOwner, StockHudLaunch};
+use std::{
+    path::PathBuf,
+    sync::{
+        Mutex, MutexGuard, PoisonError,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::Instant,
+};
+
+enum Attempt {
+    Unused,
+    Building,
+    Prepared(StockHudLaunch<'static>),
+    Spent,
+}
+
+pub struct CafeStockHudRequest {
+    owner: &'static NightStockHudOwner,
+    resource_root: PathBuf,
+    installed_receipt: PathBuf,
+    attempt: Mutex<Attempt>,
+    canceled: AtomicBool,
+}
+
+impl CafeStockHudRequest {
+    pub fn new(
+        owner: &'static NightStockHudOwner,
+        resource_root: PathBuf,
+        installed_receipt: PathBuf,
+    ) -> Self {
+        Self {
+            owner,
+            resource_root,
+            installed_receipt,
+            attempt: Mutex::new(Attempt::Unused),
+            canceled: AtomicBool::new(false),
+        }
+    }
+
+    fn state(&self) -> MutexGuard<'_, Attempt> {
+        self.attempt.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+
+    /// The current renderer accepts complete CPU artwork. Capture a cold
+    /// candidate here until the planned warm GX2 completion path is enabled.
+    pub(in crate::game) fn cold_ui(
+        &self,
+        source: &ResourceSource,
+        cancel: &AtomicBool,
+    ) -> Option<UiResources> {
+        {
+            let mut state = self.state();
+            if !matches!(*state, Attempt::Unused) {
+                // A later UI indicates pack rollback or a different candidate.
+                let previous = std::mem::replace(&mut *state, Attempt::Spent);
+                drop(state);
+                drop(previous);
+                return None;
+            }
+            *state = Attempt::Building;
+        }
+        let start = Instant::now();
+        let result = (|| -> crate::Result<Option<_>> {
+            let Some(mut launch) = self.owner.begin_launch(
+                source,
+                &self.resource_root,
+                &self.installed_receipt,
+                cancel,
+            )?
+            else {
+                return Ok(None);
+            };
+            let verify = start.elapsed();
+            if !launch.matches_ordinary_archive(&self.resource_root, cancel)? {
+                log::info!(
+                    "Horizon stock HUD declined: the ordinary archive has another generation"
+                );
+                return Ok(None);
+            }
+            let ordinary = start.elapsed() - verify;
+            let cold = Instant::now();
+            let Some(ui) = launch.build_cold(cancel)? else {
+                return Ok(None);
+            };
+            log::info!(
+                "Horizon stock HUD cold candidate: verify_ms={} ordinary_verify_ms={} cold_capture_ms={} retained_bytes={}",
+                verify.as_millis(),
+                ordinary.as_millis(),
+                cold.elapsed().as_millis(),
+                launch
+                    .retained_capacity()
+                    .map_or(0, |capacity| capacity.retained_bytes)
+            );
+            Ok(Some((launch, UiResources::from_verified_stock(ui))))
+        })();
+        let mut state = self.state();
+        match result {
+            Ok(Some((launch, ui)))
+                if matches!(*state, Attempt::Building)
+                    && !cancel.load(Ordering::Acquire)
+                    && !self.canceled.load(Ordering::Acquire) =>
+            {
+                *state = Attempt::Prepared(launch);
+                Some(ui)
+            }
+            result => {
+                *state = Attempt::Spent;
+                drop(state);
+                if let Err(error) = result {
+                    log::warn!("Horizon stock HUD uses the ordinary loader: {error}");
+                }
+                None
+            }
+        }
+    }
+
+    pub(super) fn owns_atlas(&self, atlas: &HudAtlas) -> bool {
+        matches!(&*self.state(), Attempt::Prepared(launch) if launch.owns_atlas(atlas))
+    }
+
+    pub(super) fn after_present(&self, atlas: &HudAtlas, cancel: &AtomicBool) {
+        if let Attempt::Prepared(launch) = &mut *self.state() {
+            if launch.mark_atlas_presented(atlas, cancel) {
+                log::info!("Horizon stock HUD candidate presented");
+            }
+        }
+    }
+
+    pub(in crate::game) fn cancel(&self) {
+        self.canceled.store(true, Ordering::Release);
+        let previous = std::mem::replace(&mut *self.state(), Attempt::Spent);
+        drop(previous);
+    }
+
+    /// The Night driver calls this after the presenter and worker drains.
+    /// A raw startup return, failed save or fatal error gives no reuse credit.
+    pub fn finish(&self, saved_return: bool) {
+        let previous = std::mem::replace(&mut *self.state(), Attempt::Spent);
+        match previous {
+            Attempt::Prepared(launch) => launch.park_after_drain(saved_return, &self.canceled),
+            _ => self.owner.clear_parked(),
+        }
+    }
+}
