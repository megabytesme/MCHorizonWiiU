+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn quad(layer: u32, x: f32) -> [SharedVertex; 4] {
+        [SharedVertex {
+            pos: [x, 0.0, 0.0],
+            uv: [0.0; 2],
+            layer,
+            color: u32::MAX,
+            light: 0xfff0,
+            normal: [0; 4],
+            glint_uv: [0.0; 2],
+        }; 4]
+    }
+
+    #[test]
+    fn separates_the_stock_particle_layer_without_reordering() {
+        let geometry = [
+            quad(0, 0.0),
+            quad(TRANSLUCENT_PARTICLE_OVERLAY | (9 << 16), 1.0),
+            quad(0, 2.0),
+            quad(TRANSLUCENT_PARTICLE_OVERLAY, 3.0),
+        ]
+        .concat();
+        let mut models = Models::default();
+        let report = models.prepare_world_geometry(&geometry, 1.0);
+        assert!(!report.world_partial && !report.particles_partial);
+        let positions = |vertices: &[Vertex]| {
+            vertices
+                .as_chunks::<4>()
+                .0
+                .iter()
+                .map(|quad| quad[0].position_light[0])
+                .collect::<Vec<_>>()
+        };
+        assert_eq!(positions(&models.world), [0.0, 2.0]);
+        assert_eq!(positions(&models.particles), [1.0, 3.0]);
+    }
+
+    #[test]
+    fn over_budget_world_models_do_not_hide_later_particles() {
+        let mut geometry = quad(0, 0.0).repeat(MAX_WORLD_QUADS + 1);
+        geometry.extend(quad(TRANSLUCENT_PARTICLE_OVERLAY, 1.0));
+        let mut models = Models::default();
+        let report = models.prepare_world_geometry(&geometry, 1.0);
+        assert!(report.world_partial && !report.particles_partial);
+        assert_eq!(models.world.len(), 4 * MAX_WORLD_QUADS);
+        assert_eq!(models.particles.len(), 4);
+
+        let mut geometry = quad(TRANSLUCENT_PARTICLE_OVERLAY, 1.0).repeat(MAX_PARTICLE_QUADS + 1);
+        geometry.extend(quad(0, 2.0));
+        let report = models.prepare_world_geometry(&geometry, 1.0);
+        assert!(!report.world_partial && report.particles_partial);
+        assert_eq!(models.world.len(), 4);
+        assert_eq!(models.particles.len(), 4 * MAX_PARTICLE_QUADS);
+    }
+}
