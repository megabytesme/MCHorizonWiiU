+    /// Append complete models up to the caller's vertex budget. A model that
+    /// would cross the limit ends this frame's extraction without a partial model.
+    pub fn render_bounded<'a>(
+        &self,
+        scene: &Scene,
+        blocks: impl Iterator<Item = &'a ([i32; 3], u32)>,
+        out: &mut Vec<Vertex>,
+        vertex_budget: usize,
+    ) -> bool {
+        let first = out.len();
+        let exhausted = std::cell::Cell::new(false);
+        let _ = self.render_inner(
+            scene,
+            blocks.take_while(|_| !exhausted.get()),
+            CacheOptions::default(),
+            out,
+            |_, _, _| {},
+            |_, _, start, vertices| {
+                if vertices.len() - first > vertex_budget {
+                    vertices.truncate(start);
+                    exhausted.set(true);
+                }
+            },
+            false,
+            None,
+            false,
+            None,
+        );
+        exhausted.get()
+    }
