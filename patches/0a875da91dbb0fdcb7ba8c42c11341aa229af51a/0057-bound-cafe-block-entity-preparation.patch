+    fn with_block_entity_scene<T>(
+        &self,
+        camera: glam::DVec3,
+        partial: f32,
+        dynamic_visible: Option<&dyn Fn([i32; 3], u32, glam::DVec3, glam::DVec3) -> bool>,
+        sign_text: bool,
