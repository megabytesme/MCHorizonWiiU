+        let scene = BlockEntityScene {
+            camera,
+            spyglass_outline: self.camera_type.is_first_person() && self.scoping(),
+            orientation: self.camera_orientation(),
+            anim: &anim,
+            texts: None,
+            partial,
+            game_time: self.world.game_time,
