+//! Bounded renderable-position snapshots from admitted Cafe section meshes.
+
+use std::collections::{BTreeMap, BinaryHeap, HashSet};
+
+type SectionKey = (i32, i32, i32);
+type Block = ([i32; 3], u32);
+
+const MAX_SECTIONS: usize = 4096;
+const MAX_POSITIONS: usize = 16 * 1024;
+const MAX_PER_FRAME: usize = 256;
+
+#[derive(Clone)]
+struct Section {
+    blocks: Box<[Block]>,
+    incomplete: bool,
+}
+
+#[derive(Clone, Default)]
+pub struct CafeBlockEntitySections {
+    sections: BTreeMap<SectionKey, Section>,
+    positions: usize,
+    incomplete_sections: usize,
+    saturated: bool,
+}
+
+impl CafeBlockEntitySections {
+    pub fn replace(&mut self, key: SectionKey, blocks: &[Block]) {
+        self.remove(key);
+        if blocks.is_empty() {
+            return;
+        }
+        if self.sections.len() == MAX_SECTIONS {
+            self.saturated = true;
+            return;
+        }
+        let count = blocks.len().min(MAX_POSITIONS - self.positions);
+        let incomplete = count < blocks.len();
+        self.sections.insert(
+            key,
+            Section {
+                blocks: blocks[..count].into(),
+                incomplete,
+            },
+        );
+        self.positions += count;
+        self.incomplete_sections += usize::from(incomplete);
+    }
+
+    pub fn remove(&mut self, key: SectionKey) {
+        if let Some(section) = self.sections.remove(&key) {
+            self.positions -= section.blocks.len();
+            self.incomplete_sections -= usize::from(section.incomplete);
+        }
+    }
+
+    pub fn remove_columns(&mut self, gone: &HashSet<(i32, i32)>) {
+        self.sections.retain(|&(x, _, z), section| {
+            if !gone.contains(&(x, z)) {
+                return true;
+            }
+            self.positions -= section.blocks.len();
+            self.incomplete_sections -= usize::from(section.incomplete);
+            false
+        });
+    }
+
+    pub fn clear(&mut self) {
+        *self = Self::default();
+    }
+
+    /// Keep the closest eligible models. The caller supplies nonnegative squared
+    /// distances and filters live state and visibility before they enter the heap.
+    pub fn select(&self, mut rank: impl FnMut(Block) -> Option<f64>) -> (Vec<Block>, bool) {
+        let mut nearest = BinaryHeap::new();
+        let mut partial = self.saturated || self.incomplete_sections != 0;
+        for block in self.sections.values().flat_map(|section| &*section.blocks) {
+            let Some(distance) = rank(*block) else {
+                continue;
+            };
+            let entry = (distance.to_bits(), *block);
+            if nearest.len() < MAX_PER_FRAME {
+                nearest.push(entry);
+            } else {
+                partial = true;
+                let mut farthest = nearest.peek_mut().unwrap();
+                if entry < *farthest {
+                    *farthest = entry;
+                }
+            }
+        }
+        (
+            nearest
+                .into_sorted_vec()
+                .into_iter()
+                .map(|(_, block)| block)
+                .collect(),
+            partial,
+        )
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn model(x: i32) -> Block {
+        ([x, 64, 0], 7)
+    }
+
+    #[test]
+    fn replacement_empty_section_unload_and_clear_remove_old_marks() {
+        let mut index = CafeBlockEntitySections::default();
+        index.replace((0, 0, 0), &[model(1), model(2)]);
+        index.replace((2, 0, 0), &[model(32)]);
+        index.replace((0, 0, 0), &[model(3)]);
+        assert_eq!(
+            index.select(|(pos, _)| Some(pos[0] as f64)).0,
+            [model(3), model(32)]
+        );
+        index.remove_columns(&HashSet::from([(2, 0)]));
+        assert_eq!(index.select(|_| Some(0.0)).0, [model(3)]);
+        index.replace((0, 0, 0), &[]);
+        assert!(index.select(|_| Some(0.0)).0.is_empty());
+        index.replace((1, 0, 0), &[model(16)]);
+        index.clear();
+        assert_eq!(index.select(|_| Some(0.0)), (vec![], false));
+    }
+
+    #[test]
+    fn selection_keeps_nearest_after_filtering_and_reports_overflow() {
+        let mut index = CafeBlockEntitySections::default();
+        let blocks: Vec<_> = (0..350).rev().map(model).collect();
+        index.replace((0, 0, 0), &blocks);
+        let (selected, partial) = index.select(|(pos, _)| (pos[0] != 4).then(|| f64::from(pos[0])));
+        assert!(partial);
+        assert_eq!(
+            selected,
+            (0..257).filter(|&x| x != 4).map(model).collect::<Vec<_>>()
+        );
+    }
+
+    #[test]
+    fn metadata_budget_marks_and_removes_truncation() {
+        let mut index = CafeBlockEntitySections::default();
+        let blocks = vec![model(1); MAX_POSITIONS + 1];
+        index.replace((0, 0, 0), &blocks);
+        assert_eq!(index.positions, MAX_POSITIONS);
+        assert_eq!(index.select(|_| None), (vec![], true));
+        index.remove((0, 0, 0));
+        assert_eq!(index.select(|_| None), (vec![], false));
+    }
+}
