+            translucent_sprites: &self.gui.atlas.translucent,
+            atlas_revision: self.gui.atlas.revision,
+            nether: self.nether_lighting(),
+            lid: &|pos| self.chest_lid(pos, partial),
+            sign: &|[x, y, z]| {
+                if !sign_text {
+                    return None;
+                }
+                match self.world.block_entities.get(&(x, y, z)) {
+                    Some(BlockEntity::Sign(sign)) => Some(sign),
+                    _ => None,
+                }
+            },
+            banner: &|pos| self.banner_layers_at(pos),
+            skull: &|pos| self.skull_skin_at(pos),
+            glyph: &|c| self.gui.atlas.glyph_cell(c),
+            glyphs: self.gui.atlas.font.epoch(),
+            font: Some(&self.gui.atlas.font),
+            dynamic_visible,
+        };
+        render(&scene)
+    }
+
+    #[cfg(target_os = "cafe")]
+    fn cafe_block_entity_geometry(
+        &self,
+        sections: &CafeBlockEntitySections,
+        camera: glam::DVec3,
+        alpha: f32,
+        cracks: &[([i32; 3], horizon_client::breaking::CrackSprite)],
+        out: &mut Vec<Vertex>,
+    ) -> bool {
+        const VERTEX_BUDGET: usize = 16 * 1024;
+        let reach = block_entity_reach(&self.res);
+        let (visible, mut partial) = sections.select(|(pos, state)| {
+            let flags = reach.get(state as usize).copied().unwrap_or(0);
+            let relative = glam::DVec3::from_array(pos.map(f64::from)) - camera;
+            let squared = (relative + 0.5).length_squared();
+            let distance: f64 = if flags & 2 != 0 { 256.0 } else { 64.0 };
+            if squared > distance * distance {
+                return None;
+            }
+            let at = relative.as_vec3();
+            if flags & 1 == 0
+                && self.view_frustum.is_some_and(|view| {
+                    !view.intersects(at - glam::Vec3::ONE, at + glam::Vec3::splat(2.0))
+                })
+            {
+                return None;
+            }
+            self.live_block_entity_render(pos, state).then_some(squared)
+        });
+        partial |= self.world.block_entities.has_mods()
+            || visible.iter().any(|&([x, y, z], _)| {
+                matches!(
+                    self.world.block_entities.get(&(x, y, z)),
+                    Some(BlockEntity::Sign(sign))
+                        if [&sign.front, &sign.back].into_iter().any(|side| {
+                            side.lines.iter().any(|line| !line.is_empty())
+                                || side.saved.iter().any(Option::is_some)
+                        })
+                )
+            });
+
+        let first = out.len();
+        self.with_block_entity_scene(camera, alpha, None, false, |scene| {
+            let renderer = self.res.block_entity_render();
+            partial |= renderer.render_bounded(scene, visible.iter(), out, VERTEX_BUDGET);
+            self.lit_block_entity(first..out.len());
+            self.mark_stage(out.len(), "DESTROY");
+            for &(pos, stage) in cracks {
+                let start = out.len();
+                let state = self.world.block(pos[0], pos[1], pos[2]).0;
+                renderer.render_breaking(scene, pos, state, stage, out);
+                if out.len() - first > VERTEX_BUDGET {
+                    out.truncate(start);
+                    partial = true;
+                    break;
+                }
+            }
+        });
+        partial
+    }
