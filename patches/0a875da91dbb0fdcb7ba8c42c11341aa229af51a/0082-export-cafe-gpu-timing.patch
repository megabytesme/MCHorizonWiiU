+            "scope": "per_output_draw_callback",
+            "qualified_for_drs": false,
+            "frequency_hz": GX2_GPU_HZ,
+            "status": status,
+            "hzp_sequence": sample.sequence,
+            "age_ms": now.saturating_duration_since(self.at).as_secs_f64() * 1000.0,
+            "submitted": format!("{:016x}", sample.submitted),
+            "retired": format!("{:016x}", sample.retired),
+            "endpoints_tv_gamepad": endpoints,
+            "span_ticks_tv_gamepad": span_ticks,
