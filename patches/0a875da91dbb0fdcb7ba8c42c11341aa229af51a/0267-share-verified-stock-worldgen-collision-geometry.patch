+    /// Decode and validate the same file snapshot used to record its identity.
+    #[cfg(feature = "stock-worldgen-collision")]
+    pub fn open_with_source_stamp(path: &Path, registry: &'r BlockRegistry) -> io::Result<Self> {
+        let (file, stamp) = {
+            let bytes = std::fs::read(path)?;
+            let file = read_collision_table(path, &bytes, registry)?;
+            (file, CollisionSourceStamp::of(&bytes))
+        };
+        let mut cached = Self::from_table(file.table("collision")?)?;
+        cached.source_stamp = stamp;
+        Ok(cached)
+    }
