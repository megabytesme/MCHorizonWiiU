+    #[cfg(feature = "stock-worldgen-collision")]
+    pub(crate) fn read_prepared_for_reuse(
+        &self,
+        path: &Path,
+        registry: &'r BlockRegistry,
+    ) -> io::Result<Option<BlockTableFile<'r>>> {
+        let bytes = std::fs::read(path)?;
+        if std::ptr::eq(self.registry, registry)
+            && self.source_stamp.as_ref().is_some_and(|stamp| {
+                stamp.len == bytes.len() && CollisionSourceStamp::of(&bytes).as_ref() == Some(stamp)
+            })
+        {
+            return Ok(None);
+        }
+        read_collision_table(path, &bytes, registry).map(Some)
+    }
