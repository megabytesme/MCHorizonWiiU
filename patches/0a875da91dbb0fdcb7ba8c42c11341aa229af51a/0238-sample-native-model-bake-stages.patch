+    #[cfg(target_os = "cafe")]
+    static MODEL_BAKE_PHASE: AtomicU32 = AtomicU32::new(0);
+
+    /// Opt-in Cafe model startup sampling. The ordinary startup trace is independent.
+    #[cfg(target_os = "cafe")]
+    pub fn set_model_bake_phase(phase: Option<u8>) {
+        MODEL_BAKE_PHASE.store(phase.map_or(0, |phase| u32::from(phase) + 1), Ordering::Relaxed);
+    }
+
+    #[inline]
+    pub(crate) fn model_bake_phase() -> Option<u8> {
+        #[cfg(target_os = "cafe")]
+        return match MODEL_BAKE_PHASE.load(Ordering::Relaxed) {
+            1 => Some(0),
+            2 => Some(1),
+            _ => None,
+        };
+        #[cfg(not(target_os = "cafe"))]
+        None
+    }
+
     static SINK: OnceLock<Option<Mutex<std::fs::File>>> = OnceLock::new();
     static ORIGIN: OnceLock<Instant> = OnceLock::new();
     static NEXT_THREAD: AtomicU32 = AtomicU32::new(1);
