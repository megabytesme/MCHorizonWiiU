@@ -166,6 +166,28 @@ fn report_core_topology_once() {
 
 mod hosted;
 
+fn model_bake_profile_phase() -> Option<u8> {
+    use std::io::Read as _;
+    // Hosted launches switch to the world directory before startup diagnostics.
+    const MARKER: &str = "/vol/external01/wiiu/apps/HorizonWiiU/model-bake-profile.enable";
+    let mut marker = std::fs::File::open(MARKER).ok()?;
+    let len = marker.metadata().ok()?.len();
+    let mut bytes = [0; 3];
+    let text = bytes.get_mut(..usize::try_from(len).ok()?)?;
+    marker.read_exact(text).ok()?;
+    match &*text {
+        b"" | b"0" | b"0\n" | b"0\r\n" => Some(0),
+        b"1" | b"1\n" | b"1\r\n" => Some(1),
+        _ => None,
+    }
+}
+
+fn enable_cafe_startup_diagnostics() {
+    use horizon_client::spans::startup;
+    startup::enable_log_sink();
+    startup::set_model_bake_phase(model_bake_profile_phase());
+}
+
