diff --git a/crates/horizon-client-render/src/models/catalog/bake_sample.rs b/crates/horizon-client-render/src/models/catalog/bake_sample.rs
new file mode 100644
index 0000000..9230f66
--- /dev/null
+++ b/crates/horizon-client-render/src/models/catalog/bake_sample.rs
@@ -0,0 +1,84 @@
+use std::time::{Duration, Instant};
+
+const STRIDE: usize = 32;
+const CLOCK_PAIRS: u32 = 16;
+
+#[derive(Default)]
+struct Sample {
+    elapsed: [Duration; 4],
+    models: usize,
+    faces: usize,
+}
+
+pub(super) struct BakeSamples {
+    phase: u8,
+    sampled: Sample,
+    faces: usize,
+}
+
+impl BakeSamples {
+    pub(super) fn new(phase: u8) -> Self {
+        Self {
+            phase,
+            sampled: Sample::default(),
+            faces: 0,
+        }
+    }
+
+    pub(super) fn sample(&mut self, index: usize) -> Option<BakeLaps<'_>> {
+        let group = index / STRIDE;
+        // Pick one per complete group. The two phases always choose different models.
+        let offset = (group * 17 + 5 + usize::from(self.phase) * (STRIDE / 2)) % STRIDE;
+        (index % STRIDE == offset).then(|| BakeLaps {
+            sample: &mut self.sampled,
+            at: Instant::now(),
+        })
+    }
+
+    pub(super) fn count_faces(&mut self, faces: usize) {
+        self.faces += faces;
+    }
+
+    pub(super) fn report(&self, variants: usize) {
+        let mut clock = Duration::ZERO;
+        for _ in 0..CLOCK_PAIRS {
+            let start = Instant::now();
+            clock += Instant::now().saturating_duration_since(start);
+        }
+        let [particle, raw, faces, cube] = self.sampled.elapsed.map(|d| d.as_nanos());
+        log::info!(
+            "Horizon model bake phase={} models={}/{} quads={}/{} clock_pair_ns={} particle_ns={} raw_ns={} bind_ns={} cube_ns={}",
+            self.phase,
+            self.sampled.models,
+            variants,
+            self.sampled.faces,
+            self.faces,
+            clock.as_nanos() / u128::from(CLOCK_PAIRS),
+            particle,
+            raw,
+            faces,
+            cube,
+        );
+    }
+}
+
+pub(super) struct BakeLaps<'a> {
+    sample: &'a mut Sample,
+    at: Instant,
+}
+
+pub(super) fn lap(laps: &mut Option<BakeLaps<'_>>, stage: usize) {
+    if let Some(laps) = laps {
+        let now = Instant::now();
+        laps.sample.elapsed[stage] += now.saturating_duration_since(laps.at);
+        laps.at = now;
+    }
+}
+
+pub(super) fn finish(laps: &mut Option<BakeLaps<'_>>, faces: usize) {
+    lap(laps, 3);
+    if let Some(laps) = laps {
+        laps.sample.models += 1;
+        laps.sample.faces += faces;
+    }
+}
