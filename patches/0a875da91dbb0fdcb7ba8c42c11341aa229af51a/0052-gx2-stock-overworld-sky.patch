diff --git a/wiiu/loading_host/stock_sky.c b/wiiu/loading_host/stock_sky.c
new file mode 100644
index 0000000000000000000000000000000000000000..39f0e5b2ad76c17207bd9333d271e42c3cc4a4c0
--- /dev/null
+++ b/wiiu/loading_host/stock_sky.c
@@ -0,0 +1,139 @@
+#include "stock_sky.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <gx2/draw.h>
+#include <gx2/event.h>
+#include <gx2/registers.h>
+#include <gx2/shaders.h>
+#include <gx2/utils.h>
+#include <gx2r/buffer.h>
+#include <gx2r/draw.h>
+#include <whb/gfx.h>
+
+extern const uint8_t _binary_stock_sky_gsh_start[];
+
+enum { SKY_MAX_VERTICES = 96 };
+
+_Static_assert(sizeof(HorizonSkyVertex) == 24, "sky vertex ABI changed");
+_Static_assert(offsetof(HorizonSkyVertex, factors) == 16, "sky factors offset changed");
+
+struct HorizonGx2StockSky {
+   WHBGfxShaderGroup shader;
+   GX2RBuffer vertices[2];
+   uint32_t fog, color, settings;
+};
+
+static bool uniform_offset(const GX2PixelShader *shader, const char *name, uint32_t *offset)
+{
+   const GX2UniformVar *uniform = GX2GetPixelUniformVar(shader, name);
+   if (!uniform || uniform->type != GX2_SHADER_VAR_TYPE_FLOAT4 || uniform->count != 1 ||
+       uniform->block >= 0) return false;
+   *offset = uniform->offset;
+   return true;
+}
+
+static void release(HorizonGx2StockSky *sky)
+{
+   for (unsigned i = 0; i < 2; ++i)
+      if (GX2RBufferExists(&sky->vertices[i])) GX2RDestroyBufferEx(&sky->vertices[i], 0);
+   if (sky->shader.vertexShader) WHBGfxFreeShaderGroup(&sky->shader);
+   free(sky);
+}
+
+int horizon_gx2_stock_sky_create(HorizonGx2StockSky **out)
+{
+   if (!out) return -1;
+   *out = NULL;
+   HorizonGx2StockSky *sky = calloc(1, sizeof(*sky));
+   if (!sky) return -2;
+   WHBGfxShaderGroup *shader = &sky->shader;
+   if (!WHBGfxLoadGFDShaderGroup(shader, 0, _binary_stock_sky_gsh_start) ||
+       !shader->vertexShader || !shader->pixelShader ||
+       shader->vertexShader->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       shader->pixelShader->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       !uniform_offset(shader->pixelShader, "uFogColor", &sky->fog) ||
+       !uniform_offset(shader->pixelShader, "uColor", &sky->color) ||
+       !uniform_offset(shader->pixelShader, "uSettings", &sky->settings) ||
+       !WHBGfxInitShaderAttribute(shader, "aClip", 0, offsetof(HorizonSkyVertex, clip),
+                                  GX2_ATTRIB_FORMAT_FLOAT_32_32_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aFactors", 0, offsetof(HorizonSkyVertex, factors),
+                                  GX2_ATTRIB_FORMAT_FLOAT_32_32) ||
+       !WHBGfxInitFetchShader(shader)) {
+      release(sky);
+      return -3;
+   }
+
+   const GX2RResourceFlags flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER |
+      GX2R_RESOURCE_USAGE_CPU_WRITE | GX2R_RESOURCE_USAGE_GPU_READ;
+   for (unsigned i = 0; i < 2; ++i) {
+      GX2RBuffer *buffer = &sky->vertices[i];
+      *buffer = (GX2RBuffer){
+         .flags = flags, .elemSize = sizeof(HorizonSkyVertex), .elemCount = SKY_MAX_VERTICES,
+      };
+      if (!GX2RCreateBuffer(buffer)) {
+         release(sky);
+         return -2;
+      }
+   }
+   *out = sky;
+   return 0;
+}
+
+void horizon_gx2_stock_sky_destroy(HorizonGx2StockSky *sky)
+{
+   if (!sky) return;
+   GX2DrawDone();
+   release(sky);
+}
+
+int horizon_gx2_stock_sky_draw(HorizonGx2StockSky *sky, uint32_t target,
+                              const uint32_t rect[4], const HorizonSkyVertex *vertices,
+                              const uint32_t counts[3], const float fog[4], float sky_end,
+                              const float top[4], const float sunrise[4])
+{
+   if (!sky || target > 1 || !rect || !rect[2] || !rect[3] ||
+       !vertices || !counts || !fog || !top || !sunrise ||
+       counts[0] != 24 || (counts[1] != 0 && counts[1] != 48) ||
+       (counts[2] != 0 && counts[2] != 24)) return -1;
+   GX2RBuffer *buffer = &sky->vertices[target];
+   void *mapped = GX2RLockBufferEx(buffer, 0);
+   if (!mapped) return -2;
+   memcpy(mapped, vertices, (counts[0] + counts[1] + counts[2]) * sizeof(*vertices));
+   GX2RUnlockBufferEx(buffer, 0);
+
+   WHBGfxShaderGroup *shader = &sky->shader;
+   GX2SetViewport(rect[0], rect[1], rect[2], rect[3], 0, 1);
+   GX2SetScissor(rect[0], rect[1], rect[2], rect[3]);
+   GX2SetShaderMode(shader->vertexShader->mode);
+   GX2SetFetchShader(&shader->fetchShader);
+   GX2SetVertexShader(shader->vertexShader);
+   GX2SetPixelShader(shader->pixelShader);
+   GX2SetPixelUniformReg(sky->fog, 4, fog);
+   GX2RSetAttributeBuffer(buffer, 0, sizeof(HorizonSkyVertex), 0);
+   GX2SetCullOnlyControl(GX2_FRONT_FACE_CCW, FALSE, FALSE);
+   GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+   GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0.0f);
+   GX2SetDepthOnlyControl(FALSE, FALSE, GX2_COMPARE_FUNC_ALWAYS);
+   GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, 0, 0, 0, 0, 0, 0, 0);
+   GX2SetBlendControl(GX2_RENDER_TARGET_0, GX2_BLEND_MODE_SRC_ALPHA, GX2_BLEND_MODE_INV_SRC_ALPHA,
+                      GX2_BLEND_COMBINE_MODE_ADD, TRUE, GX2_BLEND_MODE_ZERO,
+                      GX2_BLEND_MODE_ONE, GX2_BLEND_COMBINE_MODE_ADD);
+
+   const float dark[4] = {0, 0, 0, 1};
+   const float *colors[] = {top, sunrise, dark};
+   uint32_t first = 0;
+   for (unsigned i = 0; i < 3; ++i) {
+      if (counts[i] == 0) continue;
+      const bool blend = i == 1;
+      const float settings[4] = {sky_end, blend ? 1.0f : 0.0f, 0, 0};
+      GX2SetColorControl(GX2_LOGIC_OP_COPY, blend ? 1 : 0, FALSE, TRUE);
+      GX2SetPixelUniformReg(sky->color, 4, colors[i]);
+      GX2SetPixelUniformReg(sky->settings, 4, settings);
+      GX2DrawEx(GX2_PRIMITIVE_MODE_TRIANGLES, counts[i], first, 1);
+      first += counts[i];
+   }
+   return 0;
+}
diff --git a/wiiu/loading_host/stock_sky.frag b/wiiu/loading_host/stock_sky.frag
new file mode 100644
index 0000000000000000000000000000000000000000..d6e42fcf2f4480200c69f772f46506b09a3c1e7b
--- /dev/null
+++ b/wiiu/loading_host/stock_sky.frag
@@ -0,0 +1,19 @@
+#version 330
+
+in vec2 vFactors;
+uniform vec4 uFogColor;
+uniform vec4 uColor;
+uniform vec4 uSettings;
+out vec4 fragColor;
+
+void main() {
+    if (uSettings.y > 0.5) {
+        fragColor = vec4(uColor.rgb, vFactors.x * uColor.a);
+    } else {
+        float end = uSettings.x;
+        float spherical = vFactors.x >= end ? 1.0 : max(0.0, vFactors.x / end);
+        float cylindrical = vFactors.y > end ? 1.0 : 0.0;
+        float fog = max(spherical, cylindrical) * uFogColor.a;
+        fragColor = vec4(mix(uColor.rgb, uFogColor.rgb, fog), 1.0);
+    }
+}
