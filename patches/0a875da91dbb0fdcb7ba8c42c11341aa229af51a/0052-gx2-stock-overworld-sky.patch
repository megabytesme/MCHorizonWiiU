 /// The End during the dragon fight, whose world fog leaves out vanilla's sky: a shader pack's
 /// `gbuffers_skybasic` still draws a fan around the horizon (`pack_sky`), as our probe packs read
 /// it in Iris 1.11.7.
diff --git a/crates/horizon-client-render/src/gfx/stock_sky.rs b/crates/horizon-client-render/src/gfx/stock_sky.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a1f66995fc1d5ae644146a7a4da1d3e7ac631a80
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/stock_sky.rs
@@ -0,0 +1,134 @@
+//! Stock SDR sky geometry shared with the Cafe presenter.
+
+use super::sunrise_fan;
+use glam::{Mat4, Vec3};
+
+const DISC_VERTICES: usize = 8 * 3;
+const VERTICES: usize = 2 * DISC_VERTICES + sunrise_fan::VERTICES;
+const RADIUS: f32 = 512.0;
+const DIAGONAL: f32 = RADIUS * std::f32::consts::FRAC_1_SQRT_2;
+const RIM: [[f32; 2]; 8] = [
+    [RADIUS, 0.0],
+    [DIAGONAL, DIAGONAL],
+    [0.0, RADIUS],
+    [-DIAGONAL, DIAGONAL],
+    [-RADIUS, 0.0],
+    [-DIAGONAL, -DIAGONAL],
+    [0.0, -RADIUS],
+    [DIAGONAL, -DIAGONAL],
+];
+
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+pub struct SkyVertex {
+    pub clip: [f32; 4],
+    /// Spherical and cylindrical fog distances on the discs. The sunrise
+    /// fan uses the first component as the weight of its centre vertex.
+    pub factors: [f32; 2],
+}
+
+const _: () = assert!(std::mem::size_of::<SkyVertex>() == 24);
+
+pub struct StockSky {
+    pub vertices: [SkyVertex; VERTICES],
+    pub counts: [u32; 3],
+}
+
+impl StockSky {
+    pub(super) fn new(
+        projection: Mat4,
+        view: Mat4,
+        sunrise_alpha: f32,
+        sun_angle: f32,
+        dark_disc: bool,
+    ) -> Self {
+        let mut vertices = [SkyVertex::default(); VERTICES];
+        // terrain.wgsl's inverse view transforms rays with w = 0. Use the
+        // same pose without translation for geometry evaluated along those rays.
+        let rays = Mat4::from_cols(view.x_axis, view.y_axis, view.z_axis, Mat4::IDENTITY.w_axis);
+        let disc_matrix = projection * rays;
+        vertices[..DISC_VERTICES].copy_from_slice(&disc(disc_matrix, 16.0));
+        let mut next = DISC_VERTICES;
+        let mut counts = [DISC_VERTICES as u32, 0, 0];
+        if sunrise_alpha > 0.001 {
+            let angle = sun_angle.to_radians();
+            let sun = Vec3::new(0.0, angle.cos(), -angle.sin());
+            let fan_matrix = projection * view;
+            let fan = sunrise_fan::mesh(sunrise_alpha, sun);
+            for (vertex, [x, y, z, weight]) in vertices[next..].iter_mut().zip(fan) {
+                *vertex = SkyVertex {
+                    clip: (fan_matrix * Vec3::new(x, y, z).extend(1.0)).to_array(),
+                    factors: [weight, 0.0],
+                };
+            }
+            counts[1] = fan.len() as u32;
+            next += fan.len();
+        }
+        if dark_disc {
+            vertices[next..next + DISC_VERTICES].copy_from_slice(&disc(disc_matrix, -4.0));
+            counts[2] = DISC_VERTICES as u32;
+        }
+        Self { vertices, counts }
+    }
+}
+
+fn disc(matrix: Mat4, y: f32) -> [SkyVertex; DISC_VERTICES] {
+    let top = y.abs();
+    let rim = (RADIUS * RADIUS + y * y).sqrt();
+    let vertex = |x, z, factors| {
+        let mut clip = matrix * Vec3::new(x, y, z).extend(1.0);
+        // The shader's ray intersection has no far-plane limit. Keep the
+        // geometry inside the depth clip volume regardless of view distance.
+        clip.z = 0.5 * clip.w;
+        SkyVertex {
+            clip: clip.to_array(),
+            factors,
+        }
+    };
+    let center = vertex(0.0, 0.0, [top, top]);
+    let rim = RIM.map(|[x, z]| vertex(x, z, [rim, RADIUS]));
+    std::array::from_fn(|i| match i % 3 {
+        0 => center,
+        1 => rim[i / 3],
+        _ => rim[(i / 3 + 1) % rim.len()],
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn stock_disc_rim_matches_the_ray_intersection_half_planes() {
+        let mesh = disc(Mat4::IDENTITY, 16.0);
+        for triangle in mesh.chunks_exact(3) {
+            assert_eq!(triangle[0].factors, [16.0, 16.0]);
+            for corner in &triangle[1..] {
+                let x = corner.clip[0].abs();
+                // Recover world Z from the shared rim table since disc
+                // projection deliberately replaces clip-space depth.
+                let z = (RADIUS * RADIUS - x * x).max(0.0).sqrt();
+                let s = (x + z * 0.41421356).max(z + x * 0.41421356) / RADIUS;
+                assert!((s - 1.0).abs() < 0.0001);
+                assert!((corner.factors[0] - 512.24994).abs() < 0.0001);
+                assert_eq!(corner.factors[1], RADIUS);
+                assert_eq!(corner.clip[2], 0.5 * corner.clip[3]);
+            }
+        }
+    }
+
+    #[test]
+    fn sky_layers_pack_sunrise_and_dark_disc_at_their_draw_offsets() {
+        let camera = Mat4::from_translation(Vec3::X);
+        let dawn = StockSky::new(Mat4::IDENTITY, camera, 0.5, 270.0, true);
+        assert_eq!(dawn.counts, [24, 48, 24]);
+        assert_eq!(dawn.vertices[0].clip[0], 0.0);
+        assert_eq!(dawn.vertices[24].factors, [1.0, 0.0]);
+        assert_eq!(dawn.vertices[25].factors, [0.0, 0.0]);
+        assert_eq!(dawn.vertices[72].clip[1], -4.0);
+
+        let day = StockSky::new(Mat4::IDENTITY, camera, 0.0, 0.0, true);
+        assert_eq!(day.counts, [24, 0, 24]);
+        assert_eq!(day.vertices[24].factors, [4.0, 4.0]);
+    }
+}
