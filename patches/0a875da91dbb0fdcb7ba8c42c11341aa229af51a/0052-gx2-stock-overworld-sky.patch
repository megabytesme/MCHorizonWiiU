+++ b/wiiu/loading_host/stock_sky.rs
@@ -0,0 +1,78 @@
+use horizon_client::gfx::{Frame, SkyVertex, fog_uniform, stock_sky_mesh};
+use std::{ffi::c_void, ptr::NonNull};
+
+unsafe extern "C" {
+    fn horizon_gx2_stock_sky_create(out: *mut *mut c_void) -> i32;
+    fn horizon_gx2_stock_sky_destroy(sky: *mut c_void);
+    fn horizon_gx2_stock_sky_draw(
+        sky: *mut c_void,
+        target: u32,
+        rect: *const u32,
+        vertices: *const SkyVertex,
+        counts: *const u32,
+        fog: *const f32,
+        sky_end: f32,
+        top: *const f32,
+        sunrise: *const f32,
+    ) -> i32;
+}
+
+#[derive(Default)]
+pub(crate) struct Sky(Option<NonNull<c_void>>);
+
+impl Sky {
+    pub(crate) fn draw(
+        &mut self,
+        frame: &Frame<'_>,
+        target: u32,
+        rect: [u32; 4],
+        aspect: f32,
+    ) -> Result<(), &'static str> {
+        let Some(mesh) = stock_sky_mesh(frame, aspect) else {
+            return Ok(());
+        };
+        let native = match self.0 {
+            Some(native) => native,
+            None => {
+                let mut native = std::ptr::null_mut();
+                if unsafe { horizon_gx2_stock_sky_create(&mut native) } != 0 {
+                    return Err("could not create the GX2 stock sky pipeline");
+                }
+                let native = NonNull::new(native).ok_or("missing GX2 stock sky pipeline")?;
+                self.0 = Some(native);
+                native
+            }
+        };
+        let (fog_color, _) = fog_uniform(frame);
+        let sky_end = frame.fog.map_or(frame.distance.min(512.0), |f| f.sky_end);
+        let [r, g, b] = frame.sky.sky_color;
+        // WHBGfxFinishRender retires both outputs every frame. Each output
+        // owns its vertex storage, and GX2 copies the temporary data here.
+        let result = unsafe {
+            horizon_gx2_stock_sky_draw(
+                native.as_ptr(),
+                target,
+                rect.as_ptr(),
+                mesh.vertices.as_ptr(),
+                mesh.counts.as_ptr(),
+                fog_color.as_ptr(),
+                sky_end,
+                [r, g, b, 1.0].as_ptr(),
+                frame.sky.sunrise_color.as_ptr(),
+            )
+        };
+        if result == 0 {
+            Ok(())
+        } else {
+            Err("GX2 stock sky draw failed")
+        }
+    }
+}
+
+impl Drop for Sky {
+    fn drop(&mut self) {
+        if let Some(native) = self.0.take() {
+            unsafe { horizon_gx2_stock_sky_destroy(native.as_ptr()) };
+        }
+    }
+}
