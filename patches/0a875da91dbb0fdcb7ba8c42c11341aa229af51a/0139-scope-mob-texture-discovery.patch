+    #[cfg(not(target_arch = "wasm32"))]
+    #[test]
+    fn archived_hats_use_only_villager_type_and_profession_textures() {
+        use std::io::Write;
+        let root = std::env::temp_dir().join(format!("horizon-archive-hats-{}", std::process::id()));
+        fs::create_dir_all(&root).unwrap();
+        let path = root.join("hats.zip");
+        let mut writer = zip::ZipWriter::new(fs::File::create(&path).unwrap());
+        for (path, bytes) in [
+            (
+                "assets/z_mod/textures/entity/zombie_villager/profession/nested/farmer.png",
+                [].as_slice(),
+            ),
+            (
+                "assets/z_mod/textures/entity/zombie_villager/profession/nested/farmer.png.mcmeta",
+                br#"{"villager":{"hat":"full"}}"#,
+            ),
+            (
+                "assets/a_mod/textures/entity/villager/profession_overlay/test.png",
+                [].as_slice(),
+            ),
+            (
+                "assets/a_mod/textures/entity/villager/profession_overlay/test.png.mcmeta",
+                br#"{"villager":{"hat":"partial"}}"#,
+            ),
+        ] {
+            writer
+                .start_file(path, zip::write::SimpleFileOptions::default())
+                .unwrap();
+            writer.write_all(bytes).unwrap();
+        }
+        drop(writer.finish().unwrap());
+        let source = ResourceSource::archive(&path).unwrap();
+        let hats = VillagerHats::load(&source);
+        assert_eq!(
+            hats.policy(
+                "entity/zombie_villager",
+                "profession",
+                "z_mod:nested/farmer",
+            ),
+            Hat::Full,
+        );
+        assert_eq!(hats.0.len(), 1);
+        drop(source);
+        fs::remove_dir_all(root).unwrap();
+    }
