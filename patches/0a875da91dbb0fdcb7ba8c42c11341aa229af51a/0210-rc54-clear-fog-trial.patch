+       candidate->uniformBlockCount || candidate->uniformVarCount != 1 ||
+       !candidate->uniformVars || candidate->samplerVarCount != 1 || !candidate->samplerVars ||
+       candidate->initialValueCount || candidate->loopVarCount) return false;
