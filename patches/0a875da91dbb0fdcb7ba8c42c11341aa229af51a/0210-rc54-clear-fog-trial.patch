index 0000000000000000000000000000000000000000..f634cc69ea9f4bfc71c185038d79c15aef11684e
--- /dev/null
+++ b/wiiu/loading_host/clear_fog.rs
@@ -0,0 +1,121 @@
+//! Matched opaque pixel-shader trial for one contiguous proven clear run.
+
+use std::ffi::c_void;
+use std::ptr::NonNull;
+
+unsafe extern "C" {
+    fn horizon_loading_host_clear_fog_gfd() -> *const u8;
+    fn horizon_gx2_terrain_load_clear_fog_shader(terrain: *mut c_void, gfd: *const c_void) -> bool;
+    fn horizon_gx2_terrain_set_clear_fog(
+        terrain: *mut c_void,
+        enabled: bool,
+        color: *const f32,
+        ranges: *const f32,
+    ) -> bool;
+}
+
+/// # Safety
+/// The opaque, full-precision native terrain must be rooted on the render thread.
+pub(super) unsafe fn load(terrain: NonNull<c_void>) -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if !*ENABLED.get_or_init(|| {
+        std::path::Path::new("/vol/external01/wiiu/apps/HorizonWiiU/gx2-clear-fog.enable").is_file()
+    }) {
+        return false;
+    }
+    let loaded = unsafe {
+        horizon_gx2_terrain_load_clear_fog_shader(
+            terrain.as_ptr(),
+            horizon_loading_host_clear_fog_gfd().cast(),
+        )
+    };
+    unsafe {
+        super::OSReport(if loaded {
+            c"Horizon GX2 clear opaque fog trial ready\n".as_ptr()
+        } else {
+            c"Horizon GX2 clear opaque fog shader rejected\n".as_ptr()
+        });
+    }
+    loaded
+}
+
+/// # Safety
+/// The same live terrain's opaque state must already be bound.
+pub(super) unsafe fn select(
+    terrain: NonNull<c_void>,
+    enabled: bool,
+    color: &[f32; 4],
+    ranges: &[f32; 4],
+) -> bool {
+    unsafe {
+        horizon_gx2_terrain_set_clear_fog(
+            terrain.as_ptr(),
+            enabled,
+            color.as_ptr(),
+            ranges.as_ptr(),
+        )
+    }
+}
+
+/// The native vertex shader sees the F32 origin and the complete solid AABB.
+/// Stay one block inside both ramps and within a bounded near-world distance.
+pub(super) fn clear(bounds: [[f32; 3]; 2], origin: [f32; 3], ranges: [f32; 4]) -> bool {
+    let [env_start, env_end, render_start, render_end] = ranges.map(f64::from);
+    if !ranges.iter().all(|f| f.is_finite())
+        || env_start <= 1.0
+        || render_start <= 1.0
+        || env_end < env_start
+        || render_end < render_start
+    {
+        return false;
+    }
+    let mut max_abs = [0.0f64; 3];
+    for (i, extent) in max_abs.iter_mut().enumerate() {
+        let [lo, hi] = bounds.map(|end| f64::from(end[i]));
+        let origin = f64::from(origin[i]);
+        if !lo.is_finite() || !hi.is_finite() || !origin.is_finite() || lo > hi {
+            return false;
+        }
+        *extent = (origin + lo).abs().max((origin + hi).abs());
+    }
+    let [x, y, z] = max_abs;
+    let horizontal_squared = x * x + z * z;
+    let radial_squared = horizontal_squared + y * y;
+    radial_squared <= 256.0 * 256.0
+        && radial_squared < (env_start - 1.0) * (env_start - 1.0)
+        && horizontal_squared < (render_start - 1.0) * (render_start - 1.0)
+        && y < render_start - 1.0
+}
+
+const MAX_RUN: u8 = 32;
+
+#[derive(Default)]
+pub(super) struct Run {
+    admitted: u8,
+    closed: bool,
+}
+
+impl Run {
+    /// Inspect sections only until the first accepted run ends.
+    pub(super) fn admit(&mut self, qualifies: impl FnOnce() -> bool) -> bool {
+        if self.closed {
+            return false;
+        }
+        if self.admitted == MAX_RUN {
+            self.close();
+            return false;
+        }
+        if qualifies() {
+            self.admitted += 1;
+            return true;
+        }
+        if self.admitted != 0 {
+            self.close();
+        }
+        false
+    }
+
+    pub(super) fn close(&mut self) {
+        self.closed = true;
+    }
+}
