+   // Pinned CafeGLSL keeps both live semantic descriptors in their original
+   // order. Only the middle fog input and the input-count bits disappear.
+   if (stock->regs.spi_ps_in_control_0 != 0x10000003 ||
+       candidate->regs.spi_ps_in_control_0 != 0x10000002 ||
+       stock->regs.num_spi_ps_input_cntl != 3 || candidate->regs.num_spi_ps_input_cntl != 2 ||
+       stock->regs.spi_ps_input_cntls[1] != 0x8c ||
+       candidate->regs.spi_ps_input_cntls[0] != stock->regs.spi_ps_input_cntls[0] ||
+       candidate->regs.spi_ps_input_cntls[1] != stock->regs.spi_ps_input_cntls[2] ||
+       candidate->regs.spi_ps_in_control_1 != stock->regs.spi_ps_in_control_1 ||
+       candidate->regs.spi_input_z != stock->regs.spi_input_z ||
+       candidate->regs.sq_pgm_resources_ps != stock->regs.sq_pgm_resources_ps ||
+       candidate->regs.sq_pgm_exports_ps != stock->regs.sq_pgm_exports_ps ||
+       candidate->regs.cb_shader_mask != stock->regs.cb_shader_mask ||
+       candidate->regs.cb_shader_control != stock->regs.cb_shader_control ||
+       candidate->regs.db_shader_control != stock->regs.db_shader_control) return false;
+   const GX2SamplerVar *sampler = &candidate->samplerVars[0];
+   if (sampler->type != GX2_SAMPLER_VAR_TYPE_SAMPLER_2D || !sampler->name ||
+       strcmp(sampler->name, "uTerrain") || sampler->location != opaque->sampler_slot ||
+       !uniform_offset(GX2GetPixelUniformVar(candidate, "uMaterial"), &out->material_offset))
+      return false;
+   out->sampler_slot = sampler->location;
