+static bool clear_fog_vertex_compatible(const GX2VertexShader *stock, const GX2VertexShader *candidate)
+{
+   if (!candidate || !stock || !candidate->program || !stock->program ||
+       candidate->mode != stock->mode || candidate->size != stock->size ||
+       memcmp(&candidate->regs, &stock->regs, sizeof(stock->regs)) ||
+       memcmp(candidate->program, stock->program, stock->size) ||
+       candidate->attribVarCount != 3 || stock->attribVarCount != 3 ||
+       !candidate->attribVars || !stock->attribVars) return false;
+   for (uint32_t i = 0; i < 3; ++i) {
+      const GX2AttribVar *a = &stock->attribVars[i], *b = &candidate->attribVars[i];
+      if (!a->name || !b->name || strcmp(a->name, b->name) || a->location != b->location ||
+          a->type != b->type || a->count != b->count) return false;
+   }
+   return true;
+}
+
+static bool clear_fog_pixel_compatible(const TerrainPixelShader *opaque, GX2PixelShader *candidate,
+                                       TerrainPixelShader *out)
+{
+   const GX2PixelShader *stock = opaque->shader;
+   if (!stock || !candidate || !candidate->program || !candidate->size ||
