new file mode 100644
index 0000000000000000000000000000000000000000..016dc25f2db91cacb6a1edde095aa785e875e6db
--- /dev/null
+++ b/wiiu/loading_host/solid_list_census.rs
@@ -0,0 +1,338 @@
+//! Passive upper bound on reuse of the fixture's stock per-section command span.
+
+const QUADS_PER_DRAW: u32 = 16_384;
+const FIXTURE_SECTIONS: u32 = 174;
+const PAIRS_PER_WINDOW: u32 = 120;
+
+#[derive(PartialEq, Eq)]
+pub(super) struct ViewKey {
+    camera: [u64; 3],
+    clip: [[u32; 4]; 4],
+    min_y: i32,
+    output_size: [u32; 2],
+    world_rect: [u32; 4],
+    scaled: bool,
+}
+
+impl ViewKey {
+    pub(super) fn new(
+        camera: [f64; 3],
+        clip: [[f32; 4]; 4],
+        min_y: i32,
+        output_size: [u32; 2],
+        world_rect: [u32; 4],
+        scaled: bool,
+    ) -> Option<Self> {
+        if !camera.iter().all(|value| value.is_finite())
+            || !clip.iter().flatten().all(|value| value.is_finite())
+        {
+            return None;
+        }
+        Some(Self {
+            camera: camera.map(f64::to_bits),
+            clip: clip.map(|row| row.map(f32::to_bits)),
+            min_y,
+            output_size,
+            world_rect,
+            scaled,
+        })
+    }
+}
+
+#[derive(Default, PartialEq, Eq)]
+struct DrawBudget {
+    sections: u32,
+    commands: u32,
+    non_unit: bool,
+}
+
+impl DrawBudget {
+    fn add(&mut self, vertex_count: u32) {
+        self.sections = self.sections.saturating_add(1);
+        let commands = (vertex_count / 4).div_ceil(QUADS_PER_DRAW);
+        self.commands = self.commands.saturating_add(commands);
+        self.non_unit |= commands != 1;
+    }
+
+    fn fits_fixture(&self) -> bool {
+        !self.non_unit && (1..=FIXTURE_SECTIONS).contains(&self.sections)
+    }
+}
+
+pub(super) struct View {
+    key: ViewKey,
+    native: usize,
+    budget: DrawBudget,
+}
+
+impl View {
+    pub(super) fn new(key: ViewKey, native: usize) -> Self {
+        Self {
+            key,
+            native,
+            budget: DrawBudget::default(),
+        }
+    }
+
+    pub(super) fn draw(&mut self, vertex_count: u32) {
+        self.budget.add(vertex_count);
+    }
+}
+
+pub(super) struct Pair {
+    sequence: u32,
+    pub(super) views: [Option<View>; 2],
+}
+
+impl Pair {
+    pub(super) fn sequence(&self) -> u32 {
+        self.sequence
+    }
+
+    pub(super) fn new(sequence: u32) -> Self {
+        Self {
+            sequence,
+            views: [None, None],
+        }
+    }
+}
+
+struct Previous {
+    sequence: u32,
+    view: View,
+    age: u32,
+}
+
+#[derive(Default)]
+pub(super) struct Counts {
+    pub(super) samples: u32,
+    pub(super) eligible: u32,
+    pub(super) hits: u32,
+    pub(super) view_changes: u32,
+    pub(super) mesh_changes: u32,
+    pub(super) max_sections: u32,
+    pub(super) max_commands: u32,
+    pub(super) age: u32,
+    pub(super) max_age: u32,
+}
+
+#[derive(Default)]
+pub(super) struct Window {
+    pub(super) first: u32,
+    pub(super) pairs: u32,
+    pub(super) mesh_mutations: u32,
+    pub(super) counts: [Counts; 2],
+}
+
+#[derive(Default)]
+pub(super) struct Census {
+    previous: [Option<Previous>; 2],
+    mutations: u32,
+    window: Window,
+}
+
+impl Census {
+    pub(super) fn invalidate(&mut self) {
+        self.previous = [None, None];
+    }
+
+    // Structural changes can reorder the HashMap even when outside the view.
+    // A dirty interval is sufficient and a saturated count stays dirty.
+    pub(super) fn resident_changed(&mut self) {
+        self.mutations = self.mutations.saturating_add(1);
+    }
+
+    pub(super) fn paired(&mut self, pair: Pair) -> Option<Window> {
+        let mutations = std::mem::take(&mut self.mutations);
+        let window = &mut self.window;
+        if window.pairs == 0 {
+            window.first = pair.sequence;
+        }
+        window.pairs += 1;
+        window.mesh_mutations = window.mesh_mutations.saturating_add(mutations);
+        for ((previous, counts), view) in self
+            .previous
+            .iter_mut()
+            .zip(&mut window.counts)
+            .zip(pair.views)
+        {
+            counts.age = 0;
+            let prior = previous
+                .take()
+                .filter(|prior| prior.sequence.checked_add(1) == Some(pair.sequence));
+            let Some(view) = view else { continue };
+            counts.samples += 1;
+            counts.max_sections = counts.max_sections.max(view.budget.sections);
+            counts.max_commands = counts.max_commands.max(view.budget.commands);
+            if view.budget.fits_fixture() {
+                counts.eligible += 1;
+                counts.age = 1;
+            }
+            if let Some(prior) = prior {
+                let view_changed = prior.view.key != view.key;
+                let mesh_changed = mutations != 0 || prior.view.native != view.native;
+                counts.view_changes += u32::from(view_changed);
+                counts.mesh_changes += u32::from(mesh_changed);
+                // Bit-identical projection and unchanged resident identities
+                // imply the same culls, order and per-section GPU bindings.
+                if counts.age != 0
+                    && prior.age != 0
+                    && !view_changed
+                    && !mesh_changed
+                    && prior.view.budget == view.budget
+                {
+                    counts.hits += 1;
+                    counts.age = prior.age.saturating_add(1);
+                }
+            }
+            counts.max_age = counts.max_age.max(counts.age);
+            *previous = Some(Previous {
+                sequence: pair.sequence,
+                view,
+                age: counts.age,
+            });
+        }
+        (window.pairs == PAIRS_PER_WINDOW).then(|| std::mem::take(window))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn view(camera_x: f64, clip_x: f32, size: [u32; 2], native: usize, vertices: u32) -> View {
+        let mut clip = [[1.0; 4]; 4];
+        clip[0][0] = clip_x;
+        let key = ViewKey::new(
+            [camera_x, 3.0, 4.0],
+            clip,
+            -64,
+            size,
+            [0, 0, 640, 360],
+            true,
+        )
+        .unwrap();
+        let mut view = View::new(key, native);
+        view.draw(vertices);
+        view
+    }
+
+    fn normal(sequence: u32) -> Pair {
+        let mut pair = Pair::new(sequence);
+        assert_eq!(pair.sequence(), sequence);
+        pair.views = [
+            Some(view(0.0, 0.0, [1920, 1080], 1, 16)),
+            Some(view(0.0, 1.0, [854, 480], 1, 24)),
+        ];
+        pair
+    }
+
+    #[test]
+    fn native_draw_boundaries_and_owner_change() {
+        let mut budget = DrawBudget::default();
+        budget.add(65_536);
+        assert!(budget.fits_fixture());
+        let mut budget = DrawBudget::default();
+        budget.add(0);
+        budget.add(65_540);
+        assert_eq!((budget.sections, budget.commands), (2, 2));
+        assert!(!budget.fits_fixture());
+
+        let mut census = Census::default();
+        census.paired(normal(20));
+        let mut next = normal(21);
+        next.views[0].as_mut().unwrap().native = 2;
+        census.paired(next);
+        assert_eq!(
+            census.window.counts.map(|c| (c.hits, c.mesh_changes)),
+            [(0, 1), (1, 0)]
+        );
+    }
+
+    #[test]
+    fn raw_projection_bits_and_dimensions_are_per_view() {
+        let mut census = Census::default();
+        census.paired(normal(11));
+        census.paired(normal(12));
+        let mut next = normal(13);
+        next.views[0] = Some(view(-0.0, 0.0, [1920, 1080], 1, 16));
+        census.paired(next);
+        let mut next = normal(14);
+        next.views[0] = Some(view(-0.0, -0.0, [1920, 1080], 1, 16));
+        next.views[1] = Some(view(0.0, 1.0, [856, 480], 1, 24));
+        census.paired(next);
+        assert_eq!(
+            census
+                .window
+                .counts
+                .map(|c| (c.hits, c.view_changes, c.age, c.max_age)),
+            [(1, 2, 1, 2), (2, 1, 1, 3)]
+        );
+        assert!(
+            ViewKey::new([f64::NAN; 3], [[1.0; 4]; 4], 0, [1, 1], [0, 0, 1, 1], false).is_none()
+        );
+    }
+
+    #[test]
+    fn resident_replacement_at_same_address_and_discontinuities_restart_age() {
+        let mut census = Census::default();
+        census.paired(normal(50));
+        census.resident_changed(); // Remove old native geometry.
+        census.resident_changed(); // Publish a replacement at the same address.
+        census.paired(normal(51));
+        census.paired(normal(52));
+        census.paired(normal(54)); // Previous row did not present a successful pair.
+        census.invalidate(); // Same-size surface returned after foreground loss.
+        census.paired(normal(55));
+        let mut next = normal(56);
+        next.views[1] = None;
+        census.paired(next);
+        census.paired(normal(57));
+        assert_eq!(census.window.mesh_mutations, 2);
+        assert_eq!(
+            census
+                .window
+                .counts
+                .map(|c| (c.samples, c.hits, c.mesh_changes, c.age)),
+            [(7, 3, 1, 3), (6, 1, 1, 1)]
+        );
+    }
+
+    #[test]
+    fn only_fixture_capacity_is_admitted_and_window_keeps_ongoing_age() {
+        let mut census = Census::default();
+        for sequence in 100..220 {
+            let mut pair = normal(sequence);
+            let tv = pair.views[0].as_mut().unwrap();
+            for _ in 1..FIXTURE_SECTIONS {
+                tv.draw(4);
+            }
+            if sequence == 100 {
+                tv.draw(4);
+            }
+            pair.views[1].as_mut().unwrap().draw(65_540); // Two native draws.
+            if let Some(window) = census.paired(pair) {
+                assert_eq!((sequence, window.first, window.pairs), (219, 100, 120));
+                assert_eq!(
+                    window.counts.map(|c| (
+                        c.eligible,
+                        c.hits,
+                        c.max_sections,
+                        c.max_commands,
+                        c.max_age
+                    )),
+                    [(119, 118, 175, 175, 119), (0, 0, 2, 3, 0)]
+                );
+            } else {
+                assert_ne!(sequence, 219);
+            }
+        }
+        let mut pair = normal(220);
+        for _ in 1..FIXTURE_SECTIONS {
+            pair.views[0].as_mut().unwrap().draw(4);
+        }
+        census.paired(pair);
+        assert_eq!(census.window.counts[0].age, 120);
+        assert!(std::mem::size_of::<Census>() <= 512);
+    }
+}
