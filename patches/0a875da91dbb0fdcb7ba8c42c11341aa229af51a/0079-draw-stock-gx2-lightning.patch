diff --git a/wiiu/loading_host/lightning.c b/wiiu/loading_host/lightning.c
new file mode 100644
index 0000000000000000000000000000000000000000..504046ae6460d824c3db4e3bd973092326293f9f
--- /dev/null
+++ b/wiiu/loading_host/lightning.c
@@ -0,0 +1,128 @@
+#include "lightning.h"
+
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <gx2/event.h>
+#include <gx2/registers.h>
+#include <gx2/shaders.h>
+#include <gx2/utils.h>
+#include <gx2r/buffer.h>
+#include <gx2r/draw.h>
+#include <whb/gfx.h>
+
+extern const uint8_t _binary_lightning_gsh_start[];
+
+enum { MAX_VERTICES = 8 * 224 * 4 };
+_Static_assert(sizeof(HorizonGx2LightningVertex) == 16, "lightning vertex ABI changed");
+_Static_assert(offsetof(HorizonGx2LightningVertex, color) == 12, "lightning color offset changed");
+
+struct HorizonGx2Lightning {
+   WHBGfxShaderGroup shader;
+   GX2RBuffer vertices;
+   uint32_t clip_offsets[4];
+   uint32_t count;
+};
+
+int horizon_gx2_lightning_create(HorizonGx2Lightning **out)
+{
+   if (!out) return -1;
+   *out = NULL;
+   HorizonGx2Lightning *lightning = calloc(1, sizeof(*lightning));
+   if (!lightning) return -2;
+   WHBGfxShaderGroup *shader = &lightning->shader;
+   if (!WHBGfxLoadGFDShaderGroup(shader, 0, _binary_lightning_gsh_start)) {
+      free(lightning);
+      return -3;
+   }
+
+   const GX2VertexShader *vs = shader->vertexShader;
+   const GX2PixelShader *ps = shader->pixelShader;
+   if (!vs || !ps || vs->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       ps->mode != GX2_SHADER_MODE_UNIFORM_REGISTER) goto invalid_shader;
+
+   const char *clip_names[] = {"uClipX", "uClipY", "uClipZ", "uClipW"};
+   for (unsigned row = 0; row < 4; ++row) {
+      const GX2UniformVar *var = GX2GetVertexUniformVar(vs, clip_names[row]);
+      if (!var || var->type != GX2_SHADER_VAR_TYPE_FLOAT4 || var->count != 1 ||
+          var->block >= 0) goto invalid_shader;
+      lightning->clip_offsets[row] = var->offset;
+   }
+   if (!WHBGfxInitShaderAttribute(shader, "aPosition", 0,
+         offsetof(HorizonGx2LightningVertex, position), GX2_ATTRIB_FORMAT_FLOAT_32_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aColor", 0,
+         offsetof(HorizonGx2LightningVertex, color), GX2_ATTRIB_FORMAT_UNORM_8_8_8_8) ||
+       !WHBGfxInitFetchShader(shader)) goto invalid_shader;
+
+   *out = lightning;
+   return 0;
+
+invalid_shader:
+   WHBGfxFreeShaderGroup(shader);
+   free(lightning);
+   return -3;
+}
+
+void horizon_gx2_lightning_destroy(HorizonGx2Lightning *lightning)
+{
+   if (!lightning) return;
+   GX2DrawDone();
+   if (GX2RBufferExists(&lightning->vertices))
+      GX2RDestroyBufferEx(&lightning->vertices, 0);
+   WHBGfxFreeShaderGroup(&lightning->shader);
+   free(lightning);
+}
+
+int horizon_gx2_lightning_upload(HorizonGx2Lightning *lightning,
+                                 const HorizonGx2LightningVertex *vertices, uint32_t count)
+{
+   if (!lightning || !vertices || !count || count % 4 || count > MAX_VERTICES) return -1;
+   lightning->count = 0;
+   GX2RBuffer *buffer = &lightning->vertices;
+   /* The preceding WHB frame retired before the render thread writes again. */
+   if (count > buffer->elemCount) {
+      const GX2RResourceFlags flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER |
+         GX2R_RESOURCE_USAGE_CPU_WRITE | GX2R_RESOURCE_USAGE_GPU_READ;
+      GX2RBuffer replacement = {
+         .flags = flags, .elemSize = sizeof(HorizonGx2LightningVertex), .elemCount = count,
+      };
+      if (!GX2RCreateBuffer(&replacement)) return -2;
+      if (GX2RBufferExists(buffer)) GX2RDestroyBufferEx(buffer, 0);
+      *buffer = replacement;
+   }
+   void *mapped = GX2RLockBufferEx(buffer, 0);
+   if (!mapped) return -2;
+   memcpy(mapped, vertices, count * sizeof(*vertices));
+   GX2RUnlockBufferEx(buffer, 0);
+   lightning->count = count;
+   return 0;
+}
+
+int horizon_gx2_lightning_draw(HorizonGx2Lightning *lightning, HorizonGx2Terrain *terrain,
+                               const uint32_t rect[4], const float clip_rows[4][4])
+{
+   if (!lightning || !lightning->count || !terrain || !rect || !rect[2] || !rect[3] ||
+       !clip_rows) return -1;
+   const WHBGfxShaderGroup *shader = &lightning->shader;
+   GX2SetViewport(rect[0], rect[1], rect[2], rect[3], 0, 1);
+   GX2SetScissor(rect[0], rect[1], rect[2], rect[3]);
+   GX2SetShaderMode(shader->vertexShader->mode);
+   GX2SetFetchShader(&shader->fetchShader);
+   GX2SetVertexShader(shader->vertexShader);
+   GX2SetPixelShader(shader->pixelShader);
+   for (unsigned row = 0; row < 4; ++row)
+      GX2SetVertexUniformReg(lightning->clip_offsets[row], 4, clip_rows[row]);
+   GX2RSetAttributeBuffer(&lightning->vertices, 0, sizeof(HorizonGx2LightningVertex), 0);
+
+   GX2SetCullOnlyControl(GX2_FRONT_FACE_CCW, FALSE, FALSE);
+   GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+   GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0.0f);
+   GX2SetDepthOnlyControl(TRUE, FALSE, GX2_COMPARE_FUNC_LEQUAL);
+   GX2SetColorControl(GX2_LOGIC_OP_COPY, 1, FALSE, TRUE);
+   GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, 0, 0, 0, 0, 0, 0, 0);
+   GX2SetBlendControl(GX2_RENDER_TARGET_0, GX2_BLEND_MODE_SRC_ALPHA, GX2_BLEND_MODE_ONE,
+                      GX2_BLEND_COMBINE_MODE_ADD, TRUE, GX2_BLEND_MODE_SRC_ALPHA,
+                      GX2_BLEND_MODE_ONE, GX2_BLEND_COMBINE_MODE_ADD);
+   horizon_gx2_terrain_draw_quads(terrain, lightning->count);
+   return 0;
+}
