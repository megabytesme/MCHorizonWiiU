index 0000000000000000000000000000000000000000..a7dacaded676dd10afacf8df884e4f7982870da9
--- /dev/null
+++ b/wiiu/loading_host/lightning.vert
@@ -0,0 +1,15 @@
+#version 330
+layout(location = 0) in vec3 aPosition;
+layout(location = 1) in vec4 aColor;
+uniform vec4 uClipX;
+uniform vec4 uClipY;
+uniform vec4 uClipZ;
+uniform vec4 uClipW;
+out vec4 vColor;
+
+void main() {
+    vec4 pos = vec4(aPosition, 1.0);
+    gl_Position = vec4(dot(uClipX, pos), dot(uClipY, pos),
+                       dot(uClipZ, pos), dot(uClipW, pos));
+    vColor = aColor;
+}
