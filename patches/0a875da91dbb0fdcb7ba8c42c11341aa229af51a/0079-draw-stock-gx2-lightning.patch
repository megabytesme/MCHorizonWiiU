diff --git a/wiiu/loading_host/lightning.rs b/wiiu/loading_host/lightning.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ab5b9feabe7509954638014cbed70da9d9d9bc69
--- /dev/null
+++ b/wiiu/loading_host/lightning.rs
@@ -0,0 +1,118 @@
+//! Seeded bolt geometry shared with the desktop renderer.
+
+use horizon_client::gfx::lightning::{geometry, Bolt};
+use horizon_wiiu_gx2_terrain::TerrainClipRows;
+use std::{ffi::c_void, ptr::NonNull};
+
+const MAX_BOLTS: usize = 8;
+
+#[repr(C)]
+struct Vertex {
+    position: [f32; 3],
+    color: [u8; 4],
+}
+
+const _: () = {
+    assert!(std::mem::size_of::<Vertex>() == 16);
+    assert!(std::mem::offset_of!(Vertex, color) == 12);
+};
+
+unsafe extern "C" {
+    fn horizon_gx2_lightning_create(out: *mut *mut c_void) -> i32;
+    fn horizon_gx2_lightning_destroy(lightning: *mut c_void);
+    fn horizon_gx2_lightning_upload(
+        lightning: *mut c_void,
+        vertices: *const Vertex,
+        count: u32,
+    ) -> i32;
+    fn horizon_gx2_lightning_draw(
+        lightning: *mut c_void,
+        terrain: *mut c_void,
+        rect: *const u32,
+        clip_rows: *const f32,
+    ) -> i32;
+}
+
+#[derive(Default)]
+pub(crate) struct Lightning {
+    native: Option<NonNull<c_void>>,
+    vertices: Vec<Vertex>,
+    ready: bool,
+}
+
+impl Lightning {
+    /// Prepare one camera-relative buffer for both outputs, preserving simulation order.
+    /// Returns true if an active bolt was omitted.
+    pub(crate) fn prepare(&mut self, bolts: &[Bolt], camera: [f64; 3]) -> bool {
+        self.ready = false;
+        self.vertices.clear();
+        if bolts.is_empty() {
+            return false;
+        }
+        for bolt in bolts.iter().take(MAX_BOLTS) {
+            // Match the shared desktop bolt's f64 camera subtraction before
+            // adding the small, bolt-local mesh in f32.
+            let [x, y, z] = std::array::from_fn(|i| (bolt.at[i] - camera[i]) as f32);
+            self.vertices.extend(
+                geometry(bolt.seed, [0.0; 2])
+                    .into_iter()
+                    .map(|vertex| Vertex {
+                        position: [vertex.pos[0] + x, vertex.pos[1] + y, vertex.pos[2] + z],
+                        color: vertex.color.to_le_bytes(),
+                    }),
+            );
+        }
+        let native = match self.native {
+            Some(native) => native,
+            None => {
+                let mut ptr = std::ptr::null_mut();
+                if unsafe { horizon_gx2_lightning_create(&mut ptr) } != 0 {
+                    return true;
+                }
+                let Some(native) = NonNull::new(ptr) else {
+                    return true;
+                };
+                self.native = Some(native);
+                native
+            }
+        };
+        self.ready = unsafe {
+            horizon_gx2_lightning_upload(
+                native.as_ptr(),
+                self.vertices.as_ptr(),
+                self.vertices.len() as u32,
+            )
+        } == 0;
+        !self.ready || bolts.len() > MAX_BOLTS
+    }
+
+    pub(crate) fn draw(
+        &self,
+        terrain: NonNull<c_void>,
+        rect: [u32; 4],
+        projection: &TerrainClipRows,
+    ) -> Result<(), &'static str> {
+        if let Some(native) = self.native.filter(|_| self.ready) {
+            if unsafe {
+                horizon_gx2_lightning_draw(
+                    native.as_ptr(),
+                    terrain.as_ptr(),
+                    rect.as_ptr(),
+                    projection.rows.as_ptr().cast(),
+                )
+            } != 0
+            {
+                return Err("GX2 lightning draw failed");
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Drop for Lightning {
+    fn drop(&mut self) {
+        if let Some(native) = self.native.take() {
+            unsafe { horizon_gx2_lightning_destroy(native.as_ptr()) };
+        }
+    }
+}
