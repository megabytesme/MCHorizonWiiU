-                        resume.stale.push(((x, sy, z), mesh));
+                    let key = (x, sy, z);
+                    if self.meshing.get(&key) != Some(&seq) {
+                        resume.stale.push((key, mesh));
                         continue;
                     }
+                    self.meshing.remove(&key);
                     // Its column unloaded while it was meshed: nothing would
