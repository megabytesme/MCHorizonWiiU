+    // Keep a dirty request while the server holds the column. The running
+    // revision keeps its own slot and may still finish on return.
+    #[cfg(target_os = "cafe")]
+    fn park_mesh_outside_view(&self, world: &mut World, key: (i32, i32, i32)) -> bool {
+        let (x, _, z) = key;
+        if !self.remote
+            || !self.mesh
+            || in_view_distance(self.center, self.radius, x, z)
+            || self.forced.contains(&(x, z))
+        {
+            return false;
+        }
+        if world.chunks.contains_key(&(x, z)) {
+            world.dirty_sections.insert(key);
+        }
+        true
+    }
+
+    /// Drop old CPU upload work before calculating the current mesh room.
+    /// Already published render meshes keep their ordinary residency.
+    #[cfg(target_os = "cafe")]
+    pub fn prune_cafe_pending_uploads(
+        &mut self,
+        world: &mut World,
+        pending: &mut Vec<((i32, i32, i32), SectionMesh)>,
+    ) {
+        // Each new completion already checks the current view. A settled,
+        // unforced view has no old arrivals to scan for again.
+        if !self.remote
+            || !self.mesh
+            || pending.is_empty()
+            || (self.forced.is_empty() && self.waiting_area == (self.center, self.radius, 0))
+        {
+            return;
+        }
+        let stale = pending
+            .extract_if(.., |(key, _)| {
+                if !self.park_mesh_outside_view(world, *key) {
+                    return false;
+                }
+                // This accepted revision never reached the renderer.
+                self.compile_started.remove(key);
+                true
+            })
+            .collect();
+        self.free(stale);
+    }
+
     /// Give back meshes the renderer has copied: a worker frees them, ahead of
     /// other jobs, as vanilla's compile task closes its mesh data on its own
     /// thread once copied (`SectionRenderDispatcher.RenderSection.CompileTask.doTask`).
