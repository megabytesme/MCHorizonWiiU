+    /// Verify every addressable atlas cell fits the signed fetch format.
+    pub fn atlas_cell_layout(&self) -> Option<AtlasCellLayout> {
+        let max_cells = u32::from(i16::MAX as u16) + 1;
+        if self.columns == 0
+            || self.columns > max_cells
+            || self.cell_size <= 2
+            || self.columns.checked_mul(self.cell_size) != Some(self.width)
+            || self.height % self.cell_size != 0
+            || self.layers == 0
+            || self.layers > 0x8000
+        {
+            return None;
+        }
+        let rows = self.height / self.cell_size;
+        if rows > max_cells || self.layers > self.columns * rows {
+            return None;
+        }
+        Some(AtlasCellLayout {
+            columns: self.columns,
+            layers: self.layers,
+        })
+    }
