+    #[test]
+    fn signed_atlas_uv_preserves_the_stock_cafeglsl_export() {
+        for layer_byte in 0..=u8::MAX {
+            let layer_shift = atlas_uv_quantum_shift(layer_byte);
+            for uv in 0..=u16::MAX {
+                let packed = ((u32::from(layer_byte) << 16) | u32::from(uv)) as f32;
+                let ideal = f32::from(uv) / 32768.0;
+                // Stock CafeGLSL emits two separate MULADD instructions.
+                let delta = ideal - packed;
+                let expected = delta + packed;
+                let code = quantized_atlas_uv(uv, layer_shift);
+                let actual = if code == i16::MAX {
+                    2.0
+                } else {
+                    f32::from(code) / 32768.0 + 1.0
+                };
+                assert_eq!(
+                    actual.to_bits(),
+                    expected.to_bits(),
+                    "UV {uv}, layer byte {layer_byte}"
+                );
+            }
+        }
+    }
+
