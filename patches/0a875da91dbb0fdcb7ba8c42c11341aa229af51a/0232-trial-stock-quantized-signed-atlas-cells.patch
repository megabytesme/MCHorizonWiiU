+/// Indexed terrain feed with signed 16-bit UVs and integer atlas cells.
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct AtlasCellTerrainVertex {
+    pub position: [f32; 4],
+    pub uv_cell: [i16; 4],
+    pub color_cutout: [u8; 4],
+}
+
+/// Validated atlas dimensions for the signed vertex feed.
+#[cfg(feature = "atlas")]
+#[derive(Clone, Copy)]
+pub struct AtlasCellLayout {
+    columns: u32,
+    layers: u32,
+}
+
+#[cfg(feature = "atlas")]
+impl AtlasCellLayout {
+    pub fn writer(self) -> AtlasCellWriter {
+        AtlasCellWriter {
+            atlas: self,
+            last_cell: None,
+        }
+    }
+}
+
+/// Cache one atlas cell for a contiguous run of vertices on the same layer.
+/// A writer is local to one mapped section upload, including reversed quads.
+#[cfg(feature = "atlas")]
+pub struct AtlasCellWriter {
+    atlas: AtlasCellLayout,
+    last_cell: Option<(u32, [i16; 2], [u32; 2])>,
+}
+
+#[cfg(feature = "atlas")]
+fn atlas_uv_quantum_shift(layer_byte: u8) -> u32 {
+    // Zero means the packed value's exponent depends on the UV.
+    if layer_byte == 0 {
+        0
+    } else {
+        layer_byte.ilog2() + 8
+    }
+}
+
+/// Preserve the stock CafeGLSL mix export. Intermediate cancellation rounds
+/// the intended UV to the packed float's ULP before its layer bits cancel.
+#[cfg(feature = "atlas")]
+fn quantized_atlas_uv(uv: u16, layer_shift: u32) -> i16 {
+    if uv & 0x7fff == 0 {
+        // Zero and one survive all stock layer placements exactly.
+        return (uv ^ 0x8000) as i16;
+    }
+    let uv = u32::from(uv);
+    let shift = if layer_shift == 0 {
+        uv.ilog2().saturating_sub(8)
+    } else {
+        layer_shift
+    };
+    let rounded = if shift == 0 {
+        uv
+    } else {
+        let quantum = 1 << shift;
+        let tie_to_even = (uv >> shift) & 1;
+        (uv + (quantum >> 1) - 1 + tie_to_even) & !(quantum - 1)
+    };
+    // Stock can export 65536/32768 but never 65535/32768. Reserve the
+    // signed endpoint for 2.0 and decode it in the vertex shader.
+    (rounded.min(u16::MAX as u32) as u16 ^ 0x8000) as i16
+}
+
+#[cfg(feature = "atlas")]
+impl AtlasCellWriter {
+    pub fn write_vertices(
+        &mut self,
+        source: &[TerrainVertex],
+        output: &mut [core::mem::MaybeUninit<AtlasCellTerrainVertex>],
+        translucent: bool,
+    ) -> Result<(), &'static str> {
+        if source.len() % 4 != 0 || source.len() != output.len() {
+            return Err("GX2 terrain quad vertex count mismatch");
+        }
+        for (&vertex, dest) in source.iter().zip(output) {
+            let layer = u32::from(vertex.layer & 0x7fff);
+            let ([col, row], [u_shift, v_shift]) = match self.last_cell {
+                Some((last, cell, shifts)) if layer == last => (cell, shifts),
+                _ => {
+                    if layer >= self.atlas.layers {
+                        return Err("terrain vertex references absent sprite layer");
+                    }
+                    let row = layer / self.atlas.columns;
+                    let col = layer - row * self.atlas.columns;
+                    // Admission bounded both cell counts to the signed ABI.
+                    let cell = [col as i16, row as i16];
+                    let shifts = [layer as u8, (layer >> 8) as u8].map(atlas_uv_quantum_shift);
+                    self.last_cell = Some((layer, cell, shifts));
+                    (cell, shifts)
+                }
+            };
+            let [u, v] = vertex.uv;
+            let u = quantized_atlas_uv(u, u_shift);
+            let v = quantized_atlas_uv(v, v_shift);
+            let [x, y, z] = vertex.pos;
+            let [r, g, b, a] = vertex.rgba();
+            let material = if translucent {
+                a
+            } else if vertex.layer & 0x8000 == 0 {
+                u8::MAX
+            } else {
+                0
+            };
+            dest.write(AtlasCellTerrainVertex {
+                position: [x, y, z, f32::from(vertex.light)],
+                uv_cell: [u, v, col, row],
+                color_cutout: [r, g, b, material],
+            });
+        }
+        Ok(())
+    }
+}
