+    fn signed_atlas_writer_keeps_position_light_and_material() {
+        let atlas = TerrainAtlasLayout {
+            width: 7 * 18,
+            height: 5 * 18,
+            sprite_size: 16,
+            layers: 35,
+            cell_size: 18,
+            columns: 7,
+        };
+        let front =
+            TerrainVertex::packed_uv([1.25, -0.0, 2.0], [0, u16::MAX], 34, 0x8dbca521, 0xcc20);
+        let mut back = front;
+        back.layer |= 0x8000;
+        let mut writer = atlas.atlas_cell_layout().unwrap().writer();
+        let mut out = [MaybeUninit::uninit(); 4];
+        assert!(writer.write_vertices(&[front; 3], &mut out, false).is_err());
+        for (translucent, expected) in [(false, [255, 0]), (true, [0x8d; 2])] {
+            writer
+                .write_vertices(&[front, back, front, back], &mut out, translucent)
+                .unwrap();
+            for (index, vertex) in out
+                .map(|item| unsafe { item.assume_init() })
+                .into_iter()
+                .enumerate()
+            {
+                assert_eq!(
+                    vertex.position.map(f32::to_bits),
+                    [1.25, -0.0, 2.0, 52256.0_f32].map(f32::to_bits)
+                );
+                assert_eq!(vertex.uv_cell, [i16::MIN, i16::MAX, 6, 4]);
+                assert_eq!(vertex.color_cutout, [0x21, 0xa5, 0xbc, expected[index % 2]]);
+            }
+        }
+        let absent = TerrainVertex { layer: 35, ..front };
+        assert_eq!(
+            writer.write_vertices(&[absent; 4], &mut out, false),
+            Err("terrain vertex references absent sprite layer")
+        );
+    }
