+static bool terrain_atlas_cell_inputs(const HorizonGx2Terrain *t, const GX2VertexShader *vs)
+{
+   const GX2VertexShader *stock = t->shader.vertexShader;
+   if (!vs || !vs->program || !vs->size || vs->mode != stock->mode ||
+       vs->regs.spi_vs_out_config != stock->regs.spi_vs_out_config ||
+       vs->regs.num_spi_vs_out_id != stock->regs.num_spi_vs_out_id ||
+       memcmp(vs->regs.spi_vs_out_id, stock->regs.spi_vs_out_id, sizeof(stock->regs.spi_vs_out_id)) ||
+       vs->regs.pa_cl_vs_out_cntl != stock->regs.pa_cl_vs_out_cntl ||
+       vs->uniformVarCount != 6 || !vs->uniformVars ||
+       vs->samplerVarCount != 1 || !vs->samplerVars ||
+       vs->attribVarCount != 3 || !vs->attribVars)
+      return false;
+
+   const GX2SamplerVar *lightmap = vs->samplerVars;
+   if (!lightmap->name || strcmp(lightmap->name, "uLightmap") ||
+       lightmap->type != GX2_SAMPLER_VAR_TYPE_SAMPLER_2D || lightmap->location != t->lightmap_slot)
+      return false;
+   static const char *uniforms[6] = {
+      "uClipX", "uClipY", "uClipZ", "uClipW", "uSectionOrigin", "uAtlasGrid",
+   };
+   const uint32_t expected[6] = {
+      t->clip_offsets[0], t->clip_offsets[1], t->clip_offsets[2], t->clip_offsets[3],
+      t->section_origin_offset, t->atlas_grid_offset,
+   };
+   for (unsigned i = 0; i < 6; ++i) if (!vs->uniformVars[i].name) return false;
+   for (unsigned i = 0; i < 6; ++i) {
+      uint32_t offset;
+      if (!uniform_offset(GX2GetVertexUniformVar(vs, uniforms[i]), &offset) ||
+          offset != expected[i]) return false;
+   }
+
+   static const char *attributes[3] = { "aPosition", "aColor", "aAtlasCellUv" };
+   unsigned seen = 0;
+   for (unsigned i = 0; i < 3; ++i) {
+      const GX2AttribVar *var = &vs->attribVars[i];
+      const unsigned slot = var->location;
+      if (!var->name || slot >= 3 || var->count != 0 || var->type != GX2_SHADER_VAR_TYPE_FLOAT4 ||
+          strcmp(var->name, attributes[slot]) || t->shader.attributes[slot].location != slot ||
+          t->shader.attributes[slot].buffer != 0) return false;
+      seen |= 1u << slot;
+   }
+   return seen == 7;
+}
+
+bool horizon_gx2_terrain_load_atlas_cells(HorizonGx2Terrain *t, const void *gfd)
+{
+   if (!t || !gfd || !t->shader_loaded || t->bound || t->atlas_cells ||
+       t->half_shader || t->opaque_pixel.shader || t->legacy_attributes || t->legacy_uniforms ||
+       !t->texture.surface.image || t->atlas_grid[3] != 1.0f ||
+       t->texture.surface.format != GX2_SURFACE_FORMAT_UNORM_R8_G8_B8_A8 ||
+       t->shader.numAttributes != 3 || !t->shader.fetchShaderProgram) return false;
+#ifdef HORIZON_GX2_CLEAR_FOG
+   if (t->near_fog_pixel) return false;
+#endif
+
+   const uint32_t fetch_size = GX2CalcFetchShaderSizeEx(t->shader.numAttributes,
+      GX2_FETCH_SHADER_TESSELLATION_NONE, GX2_TESSELLATION_MODE_DISCRETE);
+   if (!fetch_size || fetch_size != t->shader.fetchShader.size ||
+       t->shader.fetchShader.program != t->shader.fetchShaderProgram) return false;
+
+   GX2VertexShader *vs = WHBGfxLoadGFDVertexShader(0, gfd);
+   if (!terrain_atlas_cell_inputs(t, vs)) {
+      if (vs) WHBGfxFreeVertexShader(vs);
+      return false;
+   }
+
+   /* The original fetch allocation has the same stream count and has never
+    * been bound. Use it after all fallible validation and loading succeeded. */
+   GX2AttribStream *cell = &t->shader.attributes[2];
+   cell->format = GX2_ATTRIB_FLAG_SCALED | GX2_ATTRIB_FLAG_SIGNED | GX2_ATTRIB_TYPE_16_16_16_16;
+   cell->mask = GX2_COMP_MAP(GX2_SQ_SEL_R, GX2_SQ_SEL_G, GX2_SQ_SEL_B, GX2_SQ_SEL_A);
+   cell->endianSwap = GX2_ENDIAN_SWAP_8_IN_16;
+   GX2InitFetchShaderEx(&t->shader.fetchShader, t->shader.fetchShaderProgram,
+                        t->shader.numAttributes, t->shader.attributes,
+                        GX2_FETCH_SHADER_TESSELLATION_NONE, GX2_TESSELLATION_MODE_DISCRETE);
+   GX2Invalidate(GX2_INVALIDATE_MODE_CPU_SHADER, t->shader.fetchShaderProgram, fetch_size);
+   WHBGfxFreeVertexShader(t->shader.vertexShader);
+   t->shader.vertexShader = vs;
+   t->atlas_cells = true;
+   return true;
+}
