+   string(REPLACE "#version 330\n" "#version 330\n#define HORIZON_MODEL_OVERLAYS 1\n"
+      model_overlay_source "${model_overlay_source}")
+   file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/model_overlay.${stage}" CONTENT "${model_overlay_source}")
