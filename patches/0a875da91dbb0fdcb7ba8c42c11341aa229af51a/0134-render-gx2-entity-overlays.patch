+   DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/model_overlay.vert" "${CMAKE_CURRENT_BINARY_DIR}/model_overlay.frag"
+   WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
+   VERBATIM)
