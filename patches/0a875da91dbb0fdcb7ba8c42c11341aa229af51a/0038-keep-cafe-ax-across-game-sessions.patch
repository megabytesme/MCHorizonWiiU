+# Configure with powerpc-eabi-cmake and build with the pinned Cafe toolchain.
+cmake_minimum_required(VERSION 3.13)
+project(horizon_cafe_ax_reopen C)
+
+add_executable(horizon_cafe_ax_reopen main.c)
+target_compile_options(horizon_cafe_ax_reopen PRIVATE -Wall -Wextra -Werror)
+wut_create_rpx(horizon_cafe_ax_reopen)
diff --git a/wiiu/audio/tests/reopen/main.c b/wiiu/audio/tests/reopen/main.c
new file mode 100644
index 0000000..1e91661
--- /dev/null
+++ b/wiiu/audio/tests/reopen/main.c
@@ -0,0 +1,44 @@
+/* Include the bridge so this probe can inspect its callback milestones. */
+#include "../../audio.c"
+
+#include <coreinit/time.h>
+#include <whb/proc.h>
+
+int main(void)
+{
+   WHBProcInit();
+   unsigned failures = 0;
+   for (unsigned session = 1; session <= 3; ++session) {
+      uint32_t frames = 0, sample_rate = 0;
+      HorizonWiiUAudio *audio = horizon_wiiu_audio_open(&frames, &sample_rate);
+      if (!audio) {
+         OSReport("Horizon AX reopen probe session=%u open failed\n", session);
+         failures++;
+         continue;
+      }
+      float stereo[HORIZON_AUDIO_MAX_FRAME_SAMPLES * 2u] = { 0 };
+      stereo[0] = 0.015625f;
+      stereo[1] = -0.015625f;
+      uint32_t seen = 0;
+      for (unsigned poll = 0; poll < 100; ++poll) {
+         horizon_wiiu_audio_submit(audio, stereo, frames);
+         OSSleepTicks(OSMillisecondsToTicks(3));
+         seen = __atomic_load_n(&audio->callback_milestones, __ATOMIC_ACQUIRE);
+         if ((seen & (AUDIO_CALLBACK_SEEN | AUDIO_PCM_DELIVERED)) ==
+             (AUDIO_CALLBACK_SEEN | AUDIO_PCM_DELIVERED)) {
+            break;
+         }
+      }
+      OSReport("Horizon AX reopen probe session=%u rate=%u callback=%u nonzero=%u\n",
+               session, sample_rate, (seen & AUDIO_CALLBACK_SEEN) != 0,
+               (seen & AUDIO_PCM_DELIVERED) != 0);
+      if (seen != (AUDIO_CALLBACK_SEEN | AUDIO_PCM_DELIVERED)) failures++;
+      OSSleepTicks(OSMillisecondsToTicks(4000));
+      horizon_wiiu_audio_close(audio);
+      if (session < 3) OSSleepTicks(OSMillisecondsToTicks(6000));
+   }
+   horizon_wiiu_audio_shutdown();
+   OSReport("Horizon AX reopen probe failures=%u\n", failures);
+   WHBProcShutdown();
+   return failures != 0;
+}
