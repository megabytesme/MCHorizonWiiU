+    /// Decode the terrain source sequentially without a second full CPU
+    /// image. At most one partial layer crosses a compression block.
+    pub(crate) fn visit_layers(
+        &self,
+        length: usize,
+        layer_bytes: usize,
+        mut visit: impl FnMut(&[u8]) -> Option<()>,
+    ) -> Option<()> {
+        if layer_bytes == 0
+            || !length.is_multiple_of(layer_bytes)
+            || self.0.len() != length.div_ceil(BLOCK_BYTES)
+        {
+            return None;
+        }
+        let mut scratch = vec![0; length.min(BLOCK_BYTES)];
+        let mut partial = Vec::new();
+        for (index, packed) in self.0.iter().enumerate() {
+            let decoded = &mut scratch[..(length - index * BLOCK_BYTES).min(BLOCK_BYTES)];
+            if decompress_into(packed, decoded).ok()? != decoded.len() {
+                return None;
+            }
+            let mut bytes = &*decoded;
+            if !partial.is_empty() {
+                let copied = bytes.len().min(layer_bytes - partial.len());
+                partial.extend_from_slice(&bytes[..copied]);
+                bytes = &bytes[copied..];
+                if partial.len() == layer_bytes {
+                    visit(&partial)?;
+                    partial.clear();
+                }
+            }
+            let layers = bytes.chunks_exact(layer_bytes);
+            partial.extend_from_slice(layers.remainder());
+            for layer in layers {
+                visit(layer)?;
+            }
+        }
+        partial.is_empty().then_some(())
+    }
+
     pub(crate) fn decompress(&self, length: usize) -> Option<Vec<u8>> {
         if self.0.len() != length.div_ceil(BLOCK_BYTES) {
             return None;
