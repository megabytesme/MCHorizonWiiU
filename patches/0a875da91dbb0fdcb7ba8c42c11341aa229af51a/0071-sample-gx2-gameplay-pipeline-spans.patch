+
+typedef struct {
+   _Alignas(64) uint64_t value;
+} GpuCycleSlot;
+
+_Static_assert(sizeof(GpuCycleSlot) == 64, "isolate GPU sample cache lines");
+
+static GpuCycleSlot gpu_slots[2][2];
+static bool gpu_cycle_probe;
