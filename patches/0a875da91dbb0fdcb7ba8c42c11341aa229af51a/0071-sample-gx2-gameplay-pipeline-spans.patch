+bool horizon_gx2_profile_gpu_begin(void)
+{
+   if (!gpu_cycle_probe || !recording || current.phase != PLAYING_PHASE) return false;
+   gpu_before = GX2GetLastSubmittedTimeStamp();
+   return true;
+}
+
+void horizon_gx2_profile_gpu_marker(uint32_t target, bool end)
+{
+   GpuCycleSlot *slot = &gpu_slots[target][end];
+   slot->value = UINT64_MAX;
+   DCFlushRange(slot, sizeof(*slot));
+   if (end) GX2SampleBottomGPUCycle(&slot->value);
+   else GX2SampleTopGPUCycle(&slot->value);
+}
+
+static uint64_t gpu_slot_read(GpuCycleSlot *slot)
+{
+   DCInvalidateRange(slot, sizeof(*slot));
+   return *(volatile uint64_t *)&slot->value;
+}
+
+void horizon_gx2_profile_gpu_finish(uint32_t outputs)
+{
+   // WHB has already flushed and called GX2DrawDone for the presented frame.
+   const OSTime submitted = GX2GetLastSubmittedTimeStamp();
+   if (submitted <= gpu_before || GX2GetRetiredTimeStamp() < submitted) {
+      // Leave the static slots alone for the rest of this process.
+      gpu_cycle_probe = false;
+      OSReport("Horizon GX2 GPU samples unavailable: submission not verified retired\n");
+      return;
+   }
+   if (outputs != 3) return;
+
+   uint64_t spans[2];
+   for (unsigned target = 0; target < 2; ++target) {
+      const uint64_t top = gpu_slot_read(&gpu_slots[target][0]);
+      const uint64_t bottom = gpu_slot_read(&gpu_slots[target][1]);
+      if (!top || bottom == UINT64_MAX || bottom <= top) {
+         gpu_cycle_probe = false;
+         OSReport("Horizon GX2 GPU samples unavailable: invalid GPU cycle pair\n");
+         return;
+      }
+      spans[target] = bottom - top;
+   }
+
+   const OSTime now = OSGetSystemTime();
+   if (now < gpu_report_at) return;
+   gpu_report_at = now + OSMillisecondsToTicks(2000);
+   OSReport("Horizon GX2 GPU span source=gx2-top-bottom hz=27000000 seq=%u tv_ticks=%llu drc_ticks=%llu\n",
+            total, (unsigned long long)spans[0], (unsigned long long)spans[1]);
+}
+
 bool horizon_gx2_profile_begin(uint32_t phase)
 {
    if (!atomic_load_explicit(&enabled, memory_order_acquire)) return false;
