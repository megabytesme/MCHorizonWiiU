diff --git a/crates/horizon-world/src/cafe_persistence.rs b/crates/horizon-world/src/cafe_persistence.rs
new file mode 100644
index 0000000000000000000000000000000000000000..74affdb190dd282fffe873a361033b6d08fcc451
--- /dev/null
+++ b/crates/horizon-world/src/cafe_persistence.rs
@@ -0,0 +1,295 @@
+//! Close and flush a complete replacement before publishing it on Cafe SD.
+//!
+//! Cafe FSRename requires an absent destination. Keep the old file under an
+//! adjacent recovery name until the staged file has been published. Readers
+//! recognize that recovery name if power was lost between the two renames.
+use std::{
+    ffi::OsString,
+    fs::{self, File},
+    io::{self, ErrorKind, Write},
+    path::{Path, PathBuf},
+    sync::{
+        Mutex,
+        atomic::{AtomicU32, Ordering},
+    },
+};
+
+static TRANSACTION: Mutex<()> = Mutex::new(());
+static NEXT_STAGE: AtomicU32 = AtomicU32::new(0);
+
+/// Append a suffix without changing the encoding or dropping an extension.
+pub fn sibling(path: &Path, suffix: &str) -> PathBuf {
+    let mut name = OsString::from(path.file_name().unwrap_or_default());
+    name.push(suffix);
+    path.with_file_name(name)
+}
+
+pub fn read(path: &Path, backup: &Path) -> io::Result<Vec<u8>> {
+    let _guard = TRANSACTION
+        .lock()
+        .map_err(|_| io::Error::other("Cafe save transaction lock poisoned"))?;
+    match fs::read(path) {
+        Err(err) if err.kind() == ErrorKind::NotFound => fs::read(backup),
+        result => result,
+    }
+}
+
+/// A staging directory is reserved with mkdir rather than create_new: Cafe
+/// std's latter API does a nonexclusive stat followed by a truncating open.
+struct Stage(PathBuf);
+
+impl Stage {
+    fn reserve(path: &Path) -> io::Result<Self> {
+        loop {
+            let id = NEXT_STAGE.fetch_add(1, Ordering::Relaxed);
+            let dir = sibling(path, &format!(".horizon-stage-{id}"));
+            match fs::create_dir(&dir) {
+                Ok(()) => return Ok(Self(dir)),
+                Err(err) if err.kind() == ErrorKind::AlreadyExists => continue,
+                Err(err) => return Err(err),
+            }
+        }
+    }
+}
+
+impl Drop for Stage {
+    fn drop(&mut self) {
+        // Only touch our own reservation. An interruption can leave a stage,
+        // which must never be used as a committed save or reused by a writer.
+        let _ = fs::remove_file(self.0.join("payload"));
+        let _ = fs::remove_dir(&self.0);
+    }
+}
+
+fn is_file(path: &Path) -> io::Result<bool> {
+    match fs::metadata(path) {
+        Ok(metadata) if metadata.is_file() => Ok(true),
+        Ok(_) => Err(io::Error::new(
+            ErrorKind::InvalidInput,
+            "save transaction path is not a regular file",
+        )),
+        Err(err) if err.kind() == ErrorKind::NotFound => Ok(false),
+        Err(err) => Err(err),
+    }
+}
+
+#[cfg(target_os = "cafe")]
+pub fn replace(path: &Path, backup: &Path, bytes: &[u8], keep_backup: bool) -> io::Result<()> {
+    replace_and_flush(
+        path,
+        backup,
+        bytes,
+        keep_backup,
+        |from, to| fs::rename(from, to),
+        || horizon_core::flush_cafe_volume(path),
+    )
+}
+
+#[cfg(test)]
+fn replace_with(
+    path: &Path,
+    backup: &Path,
+    bytes: &[u8],
+    keep_backup: bool,
+    rename: impl Fn(&Path, &Path) -> io::Result<()>,
+) -> io::Result<()> {
+    replace_and_flush(path, backup, bytes, keep_backup, rename, || Ok(()))
+}
+
+fn replace_and_flush(
+    path: &Path,
+    backup: &Path,
+    bytes: &[u8],
+    keep_backup: bool,
+    rename: impl Fn(&Path, &Path) -> io::Result<()>,
+    flush: impl Fn() -> io::Result<()>,
+) -> io::Result<()> {
+    let _guard = TRANSACTION
+        .lock()
+        .map_err(|_| io::Error::other("Cafe save transaction lock poisoned"))?;
+    if let Some(parent) = path.parent().filter(|p| !p.as_os_str().is_empty()) {
+        fs::create_dir_all(parent)?;
+    }
+    let stage = Stage::reserve(path)?;
+    let payload = stage.0.join("payload");
+    {
+        let mut file = File::create(&payload)?;
+        file.write_all(bytes)?;
+        file.sync_all()?;
+    }
+
+    let live = is_file(path)?;
+    let saved = is_file(backup)?;
+    if live {
+        if saved {
+            // The current file is still present and is the recovery source
+            // for this transaction. Do not unlink it.
+            fs::remove_file(backup)?;
+        }
+        rename(path, backup)?;
+        if let Err(err) = flush() {
+            let _ = rename(backup, path);
+            return Err(err);
+        }
+    }
+    if let Err(err) = rename(&payload, path) {
+        // Attempt to restore the live name. A failed rollback leaves the
+        // intact backup readable at the next open and returns the first error.
+        if live {
+            let _ = rename(backup, path);
+        }
+        return Err(err);
+    }
+    // File flush protects the payload and volume flush commits the directory
+    // changes. On failure leave both names available and surface the error.
+    flush()?;
+    if !keep_backup && (live || saved) {
+        fs::remove_file(backup)?;
+    }
+    fs::remove_dir(&stage.0)?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::AtomicUsize;
+
+    struct Scratch(PathBuf);
+
+    impl Scratch {
+        fn new() -> Self {
+            static NEXT: AtomicUsize = AtomicUsize::new(0);
+            let root = std::env::temp_dir().join(format!(
+                "horizon-cafe-saves-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::create_dir(&root).unwrap();
+            Self(root)
+        }
+    }
+
+    impl Drop for Scratch {
+        fn drop(&mut self) {
+            fs::remove_dir_all(&self.0).unwrap();
+        }
+    }
+
+    fn no_replace(from: &Path, to: &Path) -> io::Result<()> {
+        if to.try_exists()? {
+            return Err(ErrorKind::AlreadyExists.into());
+        }
+        fs::rename(from, to)
+    }
+
+    #[test]
+    fn absent_and_repeated_replacement_preserve_the_previous_record() {
+        let root = Scratch::new();
+        let path = root.0.join("level.dat");
+        let backup = root.0.join("level.dat_old");
+        for n in 1..=3 {
+            replace_with(&path, &backup, &[n], true, no_replace).unwrap();
+            assert_eq!(read(&path, &backup).unwrap(), [n]);
+            if n > 1 {
+                assert_eq!(fs::read(&backup).unwrap(), [n - 1]);
+            }
+        }
+        assert_eq!(fs::read_dir(&root.0).unwrap().count(), 2);
+    }
+
+    #[test]
+    fn interrupted_replacement_loads_only_the_previous_complete_record() {
+        let root = Scratch::new();
+        let path = root.0.join("player.json");
+        let backup = sibling(&path, ".horizon-prev");
+        fs::write(&backup, b"previous").unwrap();
+        // A crash can leave abandoned payload bytes alongside the backup.
+        let stage = Stage::reserve(&path).unwrap();
+        fs::write(stage.0.join("payload"), b"partial").unwrap();
+        assert_eq!(read(&path, &backup).unwrap(), b"previous");
+        replace_with(&path, &backup, b"latest", false, no_replace).unwrap();
+        assert_eq!(read(&path, &backup).unwrap(), b"latest");
+        assert!(!backup.exists());
+        assert_eq!(fs::read(stage.0.join("payload")).unwrap(), b"partial");
+    }
+
+    #[test]
+    fn collision_leaves_foreign_staging_data_alone() {
+        let root = Scratch::new();
+        let path = root.0.join("weather.dat");
+        let backup = sibling(&path, "_old");
+        // Reserve the next consecutive IDs, including ones used by other tests.
+        for n in 0..256 {
+            let dir = sibling(&path, &format!(".horizon-stage-{n}"));
+            fs::create_dir(&dir).unwrap();
+            fs::write(dir.join("payload"), b"foreign").unwrap();
+        }
+        replace_with(&path, &backup, b"weather", true, no_replace).unwrap();
+        assert_eq!(fs::read(&path).unwrap(), b"weather");
+        for n in 0..256 {
+            let dir = sibling(&path, &format!(".horizon-stage-{n}"));
+            assert_eq!(fs::read(dir.join("payload")).unwrap(), b"foreign");
+        }
+    }
+
+    #[test]
+    fn failed_publish_rolls_back_or_leaves_readable_recovery() {
+        let root = Scratch::new();
+        let path = root.0.join("level.dat");
+        let backup = root.0.join("level.dat_old");
+        for fail_rollback in [false, true] {
+            fs::write(&path, b"original").unwrap();
+            let err = replace_with(&path, &backup, b"replacement", true, |from, to| {
+                if to == path && (from.ends_with("payload") || fail_rollback) {
+                    return Err(ErrorKind::PermissionDenied.into());
+                }
+                no_replace(from, to)
+            })
+            .unwrap_err();
+            assert_eq!(err.kind(), ErrorKind::PermissionDenied);
+            assert_eq!(path.exists(), !fail_rollback);
+            assert_eq!(read(&path, &backup).unwrap(), b"original");
+            assert_eq!(fs::read_dir(&root.0).unwrap().count(), 1);
+        }
+    }
+
+    #[test]
+    fn a_failed_directory_flush_does_not_report_success_or_discard_the_old_record() {
+        let root = Scratch::new();
+        let path = root.0.join("player.json");
+        let backup = sibling(&path, ".horizon-prev");
+        fs::write(&path, b"original").unwrap();
+        let calls = std::cell::Cell::new(0);
+        let err = replace_and_flush(&path, &backup, b"latest", false, no_replace, || {
+            calls.set(calls.get() + 1);
+            if calls.get() == 2 {
+                return Err(ErrorKind::StorageFull.into());
+            }
+            Ok(())
+        })
+        .unwrap_err();
+        assert_eq!(err.kind(), ErrorKind::StorageFull);
+        assert_eq!(fs::read(&backup).unwrap(), b"original");
+        assert_eq!(read(&path, &backup).unwrap(), b"latest");
+    }
+
+    #[test]
+    fn overlapping_writes_leave_a_complete_record_and_no_stages() {
+        let root = Scratch::new();
+        let path = root.0.join("stats.json");
+        let backup = sibling(&path, ".horizon-prev");
+        std::thread::scope(|scope| {
+            for n in 0..8 {
+                let (path, backup) = (&path, &backup);
+                scope.spawn(move || {
+                    replace_with(path, backup, &[n; 8192], false, no_replace).unwrap()
+                });
+            }
+        });
+        let bytes = read(&path, &backup).unwrap();
+        assert_eq!(bytes.len(), 8192);
+        assert!(bytes.iter().all(|byte| *byte == bytes[0]));
+        assert_eq!(fs::read_dir(&root.0).unwrap().count(), 1);
+    }
+}
