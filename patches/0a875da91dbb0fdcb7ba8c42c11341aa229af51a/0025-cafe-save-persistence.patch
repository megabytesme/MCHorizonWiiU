+#[cfg(target_os = "cafe")]
+/// Commit directory updates on the Cafe volume that owns this filesystem path.
+pub fn flush_cafe_volume(path: &Path) -> std::io::Result<()> {
+    use std::{ffi::CString, io::{self, ErrorKind}, os::raw::c_char};
+
+    unsafe extern "C" {
+        fn FSAAddClient(attach: *const std::ffi::c_void) -> i32;
+        fn FSAFlushVolume(client: i32, path: *const c_char) -> i32;
+        fn FSADelClient(client: i32) -> i32;
+    }
+
+    let absolute = if path.is_absolute() {
+        path.to_owned()
+    } else {
+        std::env::current_dir()?.join(path)
+    };
+    let volume = absolute
+        .to_str()
+        .and_then(|path| path.strip_prefix("/vol/"))
+        .and_then(|rest| rest.split_once('/'))
+        .map(|(volume, _)| volume)
+        .filter(|volume| !volume.is_empty() && *volume != "." && *volume != "..")
+        .ok_or_else(|| io::Error::new(ErrorKind::InvalidInput, "save path has no Cafe volume"))?;
+    let volume = CString::new(format!("/vol/{volume}"))
+        .map_err(|_| io::Error::new(ErrorKind::InvalidInput, "invalid Cafe volume"))?;
+    // Staging has already mounted the volume through Cafe std. Use a dedicated
+    // FSA client so a storage error is returned without changing std's client state.
+    // SAFETY: A null attach pointer disables the optional async callback.
+    let client = unsafe { FSAAddClient(std::ptr::null()) };
+    if client < 0 {
+        return Err(io::Error::other(format!(
+            "Cafe volume flush client: {client}"
+        )));
+    }
+    // SAFETY: The path is NUL-terminated and the valid handle is owned here.
+    let status = unsafe { FSAFlushVolume(client, volume.as_ptr()) };
+    // SAFETY: The owned handle is closed exactly once after its final use.
+    let closed = unsafe { FSADelClient(client) };
+    if status != 0 || closed != 0 {
+        return Err(io::Error::other(format!(
+            "Cafe volume flush failed: flush={status}, close={closed}"
+        )));
+    }
+    Ok(())
+}
