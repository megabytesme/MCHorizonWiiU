+    pub(crate) fn may_use_fusion<'a>(
+        &self,
+        source: &ResourceSource,
+        mut model_ids: impl Iterator<Item = &'a str>,
+    ) -> bool {
+        if !self.source.same_generation(source) || self.has_connecting_models {
+            return true;
+        }
+        model_ids.any(|id| {
+            let name = if id.contains(':') && !id.bytes().any(|c| c.is_ascii_uppercase()) {
+                Cow::Borrowed(id)
+            } else {
+                Cow::Owned(horizon_optifine::matchers::namespaced(id))
+            };
+            // A direct lookup can still find an unlisted model or a model
+            // that only Fusion's lenient reader accepts.
+            !self.models.contains_key(name.as_ref())
+        })
+    }
