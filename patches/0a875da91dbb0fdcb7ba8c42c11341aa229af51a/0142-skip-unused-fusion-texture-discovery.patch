+/// Uses the same JSON reader as connecting_model, including escaped loader names.
+pub(crate) fn defines_connecting_model(text: &str) -> bool {
+    (text.contains("fusion:model") || text.contains('\\'))
+        && Json::parse(text)
+            .ok()
+            .is_some_and(|model| ModelType::of(&model) == Some(ModelType::Connecting))
+}
