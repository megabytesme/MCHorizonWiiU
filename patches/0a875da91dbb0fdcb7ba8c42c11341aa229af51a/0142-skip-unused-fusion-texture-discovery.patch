+    #[test]
+    fn fusion_discovery_handles_effective_models_and_unlisted_references() {
+        let fixture = Fixture(
+            std::env::temp_dir().join(format!("horizon-fusion-discovery-{}", std::process::id())),
+        );
+        fixture.write("demo:block/vanilla", r#"{"elements":[]}"#);
+        fixture.write("demo:block/malformed", r#"{"loader":"fusion:model""#);
+        let source = ResourceSource::directory(fixture.0.clone());
+        let parsed = ParsedModels::load(&source);
+        assert!(!parsed.may_use_fusion(&source, ["demo:block/vanilla"].into_iter()));
+        assert!(parsed.may_use_fusion(&source, ["minecraft:builtin/missing"].into_iter()));
+        assert!(parsed.may_use_fusion(&source, ["demo:block/malformed"].into_iter()));
+
+        // A model obtained through a direct lookup absent from the initial listing.
+        fixture.write(
+            "minecraft:block/late",
+            r#"{"loader":"fusion:model","type":"connecting"}"#,
+        );
+        assert!(parsed.may_use_fusion(&source, ["BLOCK/LATE"].into_iter()));
+
+        let replacement = ResourceSource::indexed(Default::default());
+        assert!(parsed.may_use_fusion(&replacement, ["demo:block/vanilla"].into_iter()));
+    }
