diff --git a/crates/horizon-world/src/worldgen/load_profile.rs b/crates/horizon-world/src/worldgen/load_profile.rs
new file mode 100644
index 0000000..191c5e1
--- /dev/null
+++ b/crates/horizon-world/src/worldgen/load_profile.rs
@@ -0,0 +1,56 @@
+//! Optional timing for one generator-resource load and its worker branches.
+use std::{
+    cell::Cell,
+    time::{Duration, Instant},
+};
+
+type Record = fn(&'static str, Instant, Duration);
+
+thread_local! {
+    static CURRENT: Cell<Option<Record>> = const { Cell::new(None) };
+}
+
+/// Time the generator-resource load initiated by this thread's operation.
+/// Its loader takes a snapshot before spawning its worker branches.
+pub fn with<T>(record: Record, operation: impl FnOnce() -> T) -> T {
+    struct Restore(Option<Record>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            CURRENT.set(self.0);
+        }
+    }
+
+    let _scope = Restore(CURRENT.replace(Some(record)));
+    operation()
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct Profile(Option<Record>);
+
+impl Profile {
+    pub(super) fn current() -> Self {
+        Self(CURRENT.get())
+    }
+
+    #[inline]
+    pub(super) fn step(self, name: &'static str) -> Option<Step> {
+        self.0.map(|record| Step {
+            record,
+            name,
+            start: Instant::now(),
+        })
+    }
+}
+
+#[must_use = "the step ends when this is dropped"]
+pub(super) struct Step {
+    record: Record,
+    name: &'static str,
+    start: Instant,
+}
+
+impl Drop for Step {
+    fn drop(&mut self) {
+        (self.record)(self.name, self.start, self.start.elapsed());
+    }
+}
