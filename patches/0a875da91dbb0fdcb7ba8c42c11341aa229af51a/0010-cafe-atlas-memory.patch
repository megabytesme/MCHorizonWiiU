diff --git a/crates/horizon-client-render/src/cafe_pixels.rs b/crates/horizon-client-render/src/cafe_pixels.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0421b1f2adc4bf0ba3cc34c1d2b51c28db876ecc
--- /dev/null
+++ b/crates/horizon-client-render/src/cafe_pixels.rs
@@ -0,0 +1,81 @@
+//! Lossless atlas storage with a bounded temporary allocation on CafeOS.
+
+use lz4_flex::block::{compress_into, decompress_into, get_maximum_output_size};
+
+const BLOCK_BYTES: usize = 256 * 1024;
+
+#[derive(Default)]
+pub(crate) struct PackedPixels(Vec<Box<[u8]>>);
+
+impl PackedPixels {
+    /// Use small blocks so the encoder never reserves an atlas-sized output.
+    /// Retain the original if the packed copy would cost over half its size
+    /// or the heap can't provide a block's workspace.
+    pub(crate) fn compress(pixels: &[u8]) -> Option<Self> {
+        let mut budget = pixels.len() / 2;
+        let mut blocks = Vec::new();
+        blocks
+            .try_reserve_exact(pixels.len().div_ceil(BLOCK_BYTES))
+            .ok()?;
+        let scratch_size = get_maximum_output_size(pixels.len().min(BLOCK_BYTES));
+        let mut scratch = Vec::new();
+        scratch.try_reserve_exact(scratch_size).ok()?;
+        scratch.resize(scratch_size, 0);
+        for block in pixels.chunks(BLOCK_BYTES) {
+            let length = compress_into(block, &mut scratch).ok()?;
+            budget = budget.checked_sub(length)?;
+            let mut stored = Vec::new();
+            stored.try_reserve_exact(length).ok()?;
+            stored.extend_from_slice(&scratch[..length]);
+            blocks.push(stored.into_boxed_slice());
+        }
+        Some(Self(blocks))
+    }
+
+    #[cfg(target_os = "cafe")]
+    pub(crate) fn encoded_len(&self) -> usize {
+        self.0.iter().map(|block| block.len()).sum()
+    }
+
+    pub(crate) fn decompress(&self, length: usize) -> Option<Vec<u8>> {
+        if self.0.len() != length.div_ceil(BLOCK_BYTES) {
+            return None;
+        }
+        let mut pixels = vec![0; length];
+        for (packed, block) in self.0.iter().zip(pixels.chunks_mut(BLOCK_BYTES)) {
+            if decompress_into(packed, block).ok()? != block.len() {
+                return None;
+            }
+        }
+        Some(pixels)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rebuild_recovers_every_pixel_including_the_partial_last_block() {
+        let pixels: Vec<u8> = (0..BLOCK_BYTES * 2 + 517)
+            .map(|index| (index / 17 + index / BLOCK_BYTES) as u8)
+            .collect();
+        let packed = PackedPixels::compress(&pixels).unwrap();
+        assert_eq!(packed.decompress(pixels.len()).unwrap(), pixels);
+        assert!(packed.decompress(pixels.len() - 1).is_none());
+    }
+
+    #[test]
+    fn an_incompressible_texture_keeps_its_existing_backing() {
+        let mut state = 17_u32;
+        let bytes: Vec<u8> = (0..BLOCK_BYTES)
+            .map(|_| {
+                state ^= state << 13;
+                state ^= state >> 17;
+                state ^= state << 5;
+                state as u8
+            })
+            .collect();
+        assert!(PackedPixels::compress(&bytes).is_none());
+    }
+}
