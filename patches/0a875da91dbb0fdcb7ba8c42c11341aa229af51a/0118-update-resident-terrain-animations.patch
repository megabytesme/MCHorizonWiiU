+++ b/wiiu/loading_host/terrain_animation.rs
@@ -7,6 +7,86 @@ use std::{ffi::c_void, ptr::NonNull};
 
 const ATLAS_BYTES_PER_UPDATE: usize = 1024 * 1024;
 
+fn atlas_update_limit(layout: &TerrainAtlasLayout) -> usize {
+    let cell_bytes = (layout.cell_size as usize).pow(2) * 4;
+    (ATLAS_BYTES_PER_UPDATE / cell_bytes).max(1)
+}
+
+/// The atlas is sampled only by native terrain. Keep clips current whenever any
+/// published section uses them, including sections outside either view.
+pub(super) struct ResidentAnimations {
+    pub(super) clips: Box<[SpriteAnimation]>,
+    layer_bits: Vec<u64>,
+    active_layers: Option<u64>,
+    tick: Option<u64>,
+    playing: bool,
+}
+
+impl ResidentAnimations {
+    pub(super) fn new(layout: &TerrainAtlasLayout, clips: &[SpriteAnimation]) -> Option<Self> {
+        // Only select layers when the ordinary path can finish every changed
+        // clip this tick. Larger packs retain their budgeted update order.
+        if clips.is_empty()
+            || clips.len() > u64::BITS as usize
+            || clips.len() > atlas_update_limit(layout)
+        {
+            return None;
+        }
+        let mut layer_bits = vec![0; layout.layers as usize];
+        for (index, clip) in clips.iter().enumerate() {
+            let slot = layer_bits.get_mut(clip.layer as usize)?;
+            if *slot != 0 {
+                return None; // Two clips sharing a layer depend on write order.
+            }
+            *slot = 1_u64 << index;
+        }
+        Some(Self {
+            clips: clips.into(),
+            layer_bits,
+            active_layers: None,
+            tick: None,
+            playing: false,
+        })
+    }
+
+    pub(super) fn layers(&self, sprites: impl Iterator<Item = u16>) -> u64 {
+        sprites.fold(0, |used, layer| {
+            let bit = self
+                .layer_bits
+                .get(usize::from(layer))
+                .copied()
+                .unwrap_or(0);
+            used | bit
+        })
+    }
+
+    pub(super) fn residency_changed(&mut self) {
+        self.active_layers = None;
+    }
+
+    pub(super) fn artwork_tick(&mut self, tick: Option<u64>) {
+        self.playing = tick.is_some();
+        if tick.is_some() {
+            self.tick = tick;
+        }
+    }
+
+    pub(super) fn selection(
+        &mut self,
+        sections: impl Iterator<Item = u64>,
+    ) -> Option<(u64, Option<u64>)> {
+        let tick = self.tick?;
+        // Disabling animation freezes all clips at the most recent tick, even
+        // those a later section might start using while animation stays off.
+        let layers = self.playing.then(|| {
+            *self
+                .active_layers
+                .get_or_insert_with(|| sections.fold(0, |a, b| a | b))
+        });
+        Some((tick, layers))
+    }
+}
