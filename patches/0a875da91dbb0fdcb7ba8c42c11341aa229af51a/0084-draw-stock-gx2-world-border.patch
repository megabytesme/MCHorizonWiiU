diff --git a/wiiu/loading_host/world_border.rs b/wiiu/loading_host/world_border.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d453d2ec3789976be1a5a0f9bc79b6261bfff02b
--- /dev/null
+++ b/wiiu/loading_host/world_border.rs
@@ -0,0 +1,161 @@
+//! Stock camera-relative wall, status tint and scrolling UVs from the shared renderer.
+use horizon_client::{border_render::BorderVertex, gfx::BorderDraw};
+use horizon_wiiu_gx2_terrain::TerrainClipRows;
+use std::{ffi::c_void, ptr::NonNull, sync::Arc};
+
+const TRIANGLES: [usize; 6] = [0, 1, 2, 0, 2, 3];
+const MAX_VERTICES: usize = 24;
+const MAX_TEXTURE_SIDE: u32 = 512;
+type Forcefield = Arc<(u32, u32, Vec<u8>)>;
+
+unsafe extern "C" {
+    fn horizon_gx2_world_border_create(out: *mut *mut c_void) -> i32;
+    fn horizon_gx2_world_border_destroy(border: *mut c_void);
+    fn horizon_gx2_world_border_texture(border: *mut c_void, rgba: *const u8, side: u32) -> i32;
+    fn horizon_gx2_world_border_upload(
+        border: *mut c_void,
+        vertices: *const BorderVertex,
+        count: u32,
+    ) -> i32;
+    fn horizon_gx2_world_border_draw(
+        border: *mut c_void,
+        rect: *const u32,
+        clip_rows: *const f32,
+        offset: *const f32,
+        tint: *const f32,
+    ) -> i32;
+}
+
+#[derive(PartialEq)]
+struct Walls {
+    vertices: [BorderVertex; MAX_VERTICES],
+    count: usize,
+}
+
+impl Walls {
+    fn ordered(vertices: &[BorderVertex; 16], sides: &[usize]) -> Option<Self> {
+        let count = sides.len().checked_mul(TRIANGLES.len())?;
+        let mut walls = Self {
+            vertices: [[0.0; 5]; MAX_VERTICES],
+            count,
+        };
+        for (&side, triangles) in sides.iter().zip(
+            walls
+                .vertices
+                .get_mut(..count)?
+                .chunks_exact_mut(TRIANGLES.len()),
+        ) {
+            let first = side.checked_mul(4)?;
+            let wall = vertices.get(first..first.checked_add(4)?)?;
+            for (vertex, index) in triangles.iter_mut().zip(TRIANGLES) {
+                *vertex = wall[index];
+            }
+        }
+        Some(walls)
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct WorldBorder {
+    native: Option<NonNull<c_void>>,
+    texture: Option<Forcefield>,
+    walls: Option<Walls>,
+    transforms: Option<([f32; 4], [f32; 4])>,
+}
+
+impl WorldBorder {
+    /// True denotes a requested border that could not be prepared.
+    pub(crate) fn prepare(&mut self, draw: Option<&BorderDraw>) -> bool {
+        self.transforms = None;
+        let Some(draw) = draw.filter(|draw| !draw.sides.is_empty()) else {
+            return false;
+        };
+        let Some(walls) = Walls::ordered(&draw.vertices, &draw.sides) else {
+            return true;
+        };
+        let (width, height, pixels) = &*draw.forcefield;
+        if width != height
+            || !width.is_power_of_two()
+            || *width > MAX_TEXTURE_SIDE
+            || pixels.len() != (*width * *height * 4) as usize
+        {
+            return true;
+        }
+        let native = match self.native {
+            Some(native) => native,
+            None => {
+                let mut pointer = std::ptr::null_mut();
+                if unsafe { horizon_gx2_world_border_create(&mut pointer) } != 0 {
+                    return true;
+                }
+                let Some(native) = NonNull::new(pointer) else {
+                    return true;
+                };
+                self.native = Some(native);
+                native
+            }
+        };
+        if !self
+            .texture
+            .as_ref()
+            .is_some_and(|texture| Arc::ptr_eq(texture, &draw.forcefield))
+        {
+            if unsafe { horizon_gx2_world_border_texture(native.as_ptr(), pixels.as_ptr(), *width) }
+                != 0
+            {
+                return true;
+            }
+            self.texture = Some(Arc::clone(&draw.forcefield));
+        }
+        if self.walls.as_ref() != Some(&walls) {
+            self.walls = None;
+            if unsafe {
+                horizon_gx2_world_border_upload(
+                    native.as_ptr(),
+                    walls.vertices.as_ptr(),
+                    walls.count as u32,
+                )
+            } != 0
+            {
+                return true;
+            }
+            self.walls = Some(walls);
+        }
+        let [x, y, z] = draw.transforms.model_offset;
+        self.transforms = Some((
+            [x, y, z, draw.transforms.texture_offset],
+            draw.transforms.color,
+        ));
+        false
+    }
+
+    pub(crate) fn draw(
+        &self,
+        rect: [u32; 4],
+        projection: &TerrainClipRows,
+    ) -> Result<(), &'static str> {
+        if let Some((native, (offset, tint))) = self.native.zip(self.transforms) {
+            if unsafe {
+                horizon_gx2_world_border_draw(
+                    native.as_ptr(),
+                    rect.as_ptr(),
+                    projection.rows.as_ptr().cast(),
+                    offset.as_ptr(),
+                    tint.as_ptr(),
+                )
+            } != 0
+            {
+                return Err("GX2 world border draw failed");
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Drop for WorldBorder {
+    fn drop(&mut self) {
+        if let Some(native) = self.native.take() {
+            unsafe { horizon_gx2_world_border_destroy(native.as_ptr()) };
+        }
+    }
+}
