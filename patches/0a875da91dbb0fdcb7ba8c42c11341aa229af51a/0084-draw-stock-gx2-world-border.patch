diff --git a/wiiu/loading_host/world_border.c b/wiiu/loading_host/world_border.c
new file mode 100644
index 0000000000000000000000000000000000000000..d1f4d67e404b16c77a0d3dca22f91e3fc420dd18
--- /dev/null
+++ b/wiiu/loading_host/world_border.c
@@ -0,0 +1,162 @@
+#include "world_border.h"
+
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <gx2/draw.h>
+#include <gx2/event.h>
+#include <gx2/registers.h>
+#include <gx2/sampler.h>
+#include <gx2/shaders.h>
+#include <gx2/texture.h>
+#include <gx2/utils.h>
+#include <gx2r/buffer.h>
+#include <gx2r/draw.h>
+#include <gx2r/surface.h>
+#include <whb/gfx.h>
+
+extern const uint8_t _binary_world_border_gsh_start[];
+/* Shared linear RGBA upload path used by the existing HUD textures. */
+int horizon_hud_texture_create(GX2Texture *texture, uint32_t width, uint32_t height,
+                               const uint8_t *rgba);
+
+enum { MAX_VERTICES = 24, MAX_TEXTURE_SIDE = 512 };
+_Static_assert(sizeof(HorizonGx2WorldBorderVertex) == 20, "border vertex ABI changed");
+_Static_assert(offsetof(HorizonGx2WorldBorderVertex, uv) == 12, "border UV offset changed");
+
+struct HorizonGx2WorldBorder {
+   WHBGfxShaderGroup shader;
+   GX2RBuffer vertices;
+   GX2Texture texture;
+   GX2Sampler sampler;
+   uint32_t vertex_uniforms[5];
+   uint32_t tint_offset;
+   uint32_t texture_slot;
+   uint32_t count;
+};
+
+static bool float4_uniform(const GX2UniformVar *var)
+{
+   return var && var->type == GX2_SHADER_VAR_TYPE_FLOAT4 && var->count == 1 && var->block < 0;
+}
+
+int horizon_gx2_world_border_create(HorizonGx2WorldBorder **out)
+{
+   if (!out) return -1;
+   *out = NULL;
+   HorizonGx2WorldBorder *border = calloc(1, sizeof(*border));
+   if (!border) return -2;
+   WHBGfxShaderGroup *shader = &border->shader;
+   if (!WHBGfxLoadGFDShaderGroup(shader, 0, _binary_world_border_gsh_start)) {
+      free(border);
+      return -3;
+   }
+   const GX2VertexShader *vs = shader->vertexShader;
+   const GX2PixelShader *ps = shader->pixelShader;
+   if (!vs || !ps || vs->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       ps->mode != GX2_SHADER_MODE_UNIFORM_REGISTER) goto invalid_shader;
+   const char *names[] = {"uClipX", "uClipY", "uClipZ", "uClipW", "uOffset"};
+   for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); ++i) {
+      const GX2UniformVar *var = GX2GetVertexUniformVar(vs, names[i]);
+      if (!float4_uniform(var)) goto invalid_shader;
+      border->vertex_uniforms[i] = var->offset;
+   }
+   const GX2UniformVar *tint = GX2GetPixelUniformVar(ps, "uColor");
+   const GX2SamplerVar *texture = ps->samplerVars;
+   if (!float4_uniform(tint) || ps->samplerVarCount != 1 || !texture || !texture->name ||
+       strcmp(texture->name, "uForcefield") || texture->type != GX2_SAMPLER_VAR_TYPE_SAMPLER_2D)
+      goto invalid_shader;
+   border->tint_offset = tint->offset;
+   border->texture_slot = texture->location;
+   if (!WHBGfxInitShaderAttribute(shader, "aPosition", 0,
+         offsetof(HorizonGx2WorldBorderVertex, position), GX2_ATTRIB_FORMAT_FLOAT_32_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aUv", 0,
+         offsetof(HorizonGx2WorldBorderVertex, uv), GX2_ATTRIB_FORMAT_FLOAT_32_32) ||
+       !WHBGfxInitFetchShader(shader)) goto invalid_shader;
+
+   GX2InitSampler(&border->sampler, GX2_TEX_CLAMP_MODE_WRAP, GX2_TEX_XY_FILTER_MODE_POINT);
+   GX2InitSamplerXYFilter(&border->sampler, GX2_TEX_XY_FILTER_MODE_POINT,
+                        GX2_TEX_XY_FILTER_MODE_LINEAR, GX2_TEX_ANISO_RATIO_NONE);
+   border->vertices.flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER |
+      GX2R_RESOURCE_USAGE_CPU_WRITE | GX2R_RESOURCE_USAGE_GPU_READ;
+   border->vertices.elemSize = sizeof(HorizonGx2WorldBorderVertex);
+   border->vertices.elemCount = MAX_VERTICES;
+   if (!GX2RCreateBuffer(&border->vertices)) goto invalid_shader;
+   *out = border;
+   return 0;
+
+invalid_shader:
+   WHBGfxFreeShaderGroup(shader);
+   free(border);
+   return -3;
+}
+
+void horizon_gx2_world_border_destroy(HorizonGx2WorldBorder *border)
+{
+   if (!border) return;
+   GX2DrawDone();
+   if (border->texture.surface.image) GX2RDestroySurfaceEx(&border->texture.surface, 0);
+   GX2RDestroyBufferEx(&border->vertices, 0);
+   WHBGfxFreeShaderGroup(&border->shader);
+   free(border);
+}
+
+int horizon_gx2_world_border_texture(HorizonGx2WorldBorder *border, const uint8_t *rgba, uint32_t side)
+{
+   if (!border || !rgba || !side || side > MAX_TEXTURE_SIDE || (side & (side - 1))) return -1;
+   GX2Texture replacement = {0};
+   if (!horizon_hud_texture_create(&replacement, side, side, rgba)) return -2;
+   /* The preceding WHB frame retired before new resources are prepared. */
+   if (border->texture.surface.image) GX2RDestroySurfaceEx(&border->texture.surface, 0);
+   border->texture = replacement;
+   return 0;
+}
+
+int horizon_gx2_world_border_upload(HorizonGx2WorldBorder *border,
+                                   const HorizonGx2WorldBorderVertex *vertices, uint32_t count)
+{
+   if (!border || !vertices || !count || count > MAX_VERTICES || count % 6) return -1;
+   border->count = 0;
+   void *mapped = GX2RLockBufferEx(&border->vertices, 0);
+   if (!mapped) return -2;
+   memcpy(mapped, vertices, count * sizeof(*vertices));
+   GX2RUnlockBufferEx(&border->vertices, 0);
+   border->count = count;
+   return 0;
+}
+
+int horizon_gx2_world_border_draw(HorizonGx2WorldBorder *border, const uint32_t rect[4],
+                                 const float clip_rows[4][4], const float offset[4], const float tint[4])
+{
+   if (!border || !border->texture.surface.image || !border->count || !rect || !rect[2] ||
+       !rect[3] || !clip_rows || !offset || !tint) return -1;
+   const WHBGfxShaderGroup *shader = &border->shader;
+   GX2SetViewport(rect[0], rect[1], rect[2], rect[3], 0, 1);
+   GX2SetScissor(rect[0], rect[1], rect[2], rect[3]);
+   GX2SetShaderMode(shader->vertexShader->mode);
+   GX2SetFetchShader(&shader->fetchShader);
+   GX2SetVertexShader(shader->vertexShader);
+   GX2SetPixelShader(shader->pixelShader);
+   for (unsigned row = 0; row < 4; ++row)
+      GX2SetVertexUniformReg(border->vertex_uniforms[row], 4, clip_rows[row]);
+   GX2SetVertexUniformReg(border->vertex_uniforms[4], 4, offset);
+   GX2SetPixelUniformReg(border->tint_offset, 4, tint);
+   GX2SetPixelTexture(&border->texture, border->texture_slot);
+   GX2SetPixelSampler(&border->sampler, border->texture_slot);
+   GX2RSetAttributeBuffer(&border->vertices, 0, sizeof(HorizonGx2WorldBorderVertex), 0);
+
+   GX2SetDepthOnlyControl(TRUE, TRUE, GX2_COMPARE_FUNC_LEQUAL);
+   /* Bias the forward-depth Cafe surface toward the viewer. */
+   GX2SetPolygonOffset(-3.0f, -3.0f, -3.0f, -3.0f, 0.0f);
+   GX2SetPolygonControl(GX2_FRONT_FACE_CCW, FALSE, FALSE, FALSE, GX2_POLYGON_MODE_TRIANGLE,
+                        GX2_POLYGON_MODE_TRIANGLE, TRUE, TRUE, FALSE);
+   GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+   GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0.0f);
+   GX2SetColorControl(GX2_LOGIC_OP_COPY, 1, FALSE, TRUE);
+   GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, 0, 0, 0, 0, 0, 0, 0);
+   GX2SetBlendControl(GX2_RENDER_TARGET_0, GX2_BLEND_MODE_SRC_ALPHA, GX2_BLEND_MODE_ONE,
+                      GX2_BLEND_COMBINE_MODE_ADD, TRUE, GX2_BLEND_MODE_ONE,
+                      GX2_BLEND_MODE_ZERO, GX2_BLEND_COMBINE_MODE_ADD);
+   GX2DrawEx(GX2_PRIMITIVE_MODE_TRIANGLES, border->count, 0, 1);
+   return 0;
+}
diff --git a/wiiu/loading_host/world_border.frag b/wiiu/loading_host/world_border.frag
new file mode 100644
index 0000000000000000000000000000000000000000..07c8f3710ec1961efc62f78b05f4b07f1386af83
--- /dev/null
+++ b/wiiu/loading_host/world_border.frag
@@ -0,0 +1,11 @@
+#version 330
+uniform sampler2D uForcefield;
+uniform vec4 uColor;
+in vec2 vUv;
+out vec4 oColor;
+
+void main() {
+    vec4 sampled = texture(uForcefield, vUv);
+    if (sampled.a == 0.0) discard;
+    oColor = sampled * uColor;
+}
