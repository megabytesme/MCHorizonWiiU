+/// Imported by `horizon-prepare sounds`, which can run after the archive was built.
+const SOUND_REGISTRY: &str = "assets/minecraft/sounds.json";
+
+fn read_prepared(path: &Path, max: u64) -> Option<io::Result<Vec<u8>>> {
+    let (files, relative) = find(path)?;
+    if !holds_file(&relative) {
+        return None;
+    }
+    let entry = files.read_head(&relative, max);
+    match entry {
+        None if relative != SOUND_REGISTRY => Some(Err(io::ErrorKind::NotFound.into())),
+        entry => entry,
     }
 }
 
+/// Read from the prepared archive when it owns the file. An ordinary archive
+/// miss stays missing, saving loose file lookups for optional texture and
+/// model data. The separately imported sound registry may appear on disk
+/// after the archive was written.
+pub fn read(path: &Path) -> io::Result<Vec<u8>> {
+    read_prepared(path, u64::MAX).unwrap_or_else(|| fs::read(path))
+}
