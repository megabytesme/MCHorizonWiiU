+    #[test]
+    fn reads_loose_sound_registry_imported_after_pack() {
+        let root = root("late-sound-registry");
+        write(&root).unwrap();
+        let registry = root.join(SOUND_REGISTRY);
+        assert_eq!(read(&registry).unwrap_err().kind(), io::ErrorKind::NotFound);
+        assert!(open(&root).unwrap().read(SOUND_REGISTRY).is_none());
+
+        let sounds = br#"{"block.sand.step":{"sounds":["step/sand1"]}}"#;
+        fs::write(&registry, sounds).unwrap();
+        assert_eq!(read(&registry).unwrap(), sounds);
+        assert_eq!(read_head(&registry, 8).unwrap(), b"{\"block.");
+        let _ = fs::remove_dir_all(root);
+    }
+
+    #[test]
+    fn archived_sound_registry_stays_authoritative() {
+        let root = root("archived-sound-registry");
+        let registry = root.join(SOUND_REGISTRY);
+        let sounds = br#"{"block.sand.step":{"sounds":["step/sand1"]}}"#;
+        fs::write(&registry, sounds).unwrap();
+        write(&root).unwrap();
+        fs::write(&registry, b"later loose file").unwrap();
+        assert_eq!(read(&registry).unwrap(), sounds);
+        let _ = fs::remove_dir_all(root);
+    }
