diff --git a/wiiu/loading_host/stars.c b/wiiu/loading_host/stars.c
new file mode 100644
index 0000000000000000000000000000000000000000..cb790fe4910ab8914d72760a3ffbe296c3eee52f
--- /dev/null
+++ b/wiiu/loading_host/stars.c
@@ -0,0 +1,125 @@
+#include "stars.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <gx2/draw.h>
+#include <gx2/event.h>
+#include <gx2/registers.h>
+#include <gx2/shaders.h>
+#include <gx2/utils.h>
+#include <gx2r/buffer.h>
+#include <gx2r/draw.h>
+#include <whb/gfx.h>
+
+extern const uint8_t _binary_stars_gsh_start[];
+
+/* The stock generator emits at most 1,500 six-vertex stars. */
+enum { MAX_VERTICES = 1500 * 6, VERTEX_BYTES = 3 * sizeof(float) };
+_Static_assert(VERTEX_BYTES == 12, "stars vertex ABI changed");
+
+struct HorizonGx2Stars {
+   WHBGfxShaderGroup shader;
+   GX2RBuffer vertices;
+   uint32_t clip_offsets[4];
+   uint32_t color_offset;
+};
+
+static void release(HorizonGx2Stars *stars)
+{
+   if (GX2RBufferExists(&stars->vertices)) GX2RDestroyBufferEx(&stars->vertices, 0);
+   if (stars->shader.vertexShader) WHBGfxFreeShaderGroup(&stars->shader);
+   free(stars);
+}
+
+static bool uniform_offset(const GX2UniformVar *uniform, uint32_t *offset)
+{
+   if (!uniform || uniform->type != GX2_SHADER_VAR_TYPE_FLOAT4 || uniform->count != 1 ||
+       uniform->block >= 0) return false;
+   *offset = uniform->offset;
+   return true;
+}
+
+int horizon_gx2_stars_create(HorizonGx2Stars **out, const float (*vertices)[3], uint32_t count)
+{
+   if (!out) return -1;
+   *out = NULL;
+   if (!vertices || !count || count % 6 || count > MAX_VERTICES) return -1;
+   HorizonGx2Stars *stars = calloc(1, sizeof(*stars));
+   if (!stars) return -2;
+   WHBGfxShaderGroup *shader = &stars->shader;
+   if (!WHBGfxLoadGFDShaderGroup(shader, 0, _binary_stars_gsh_start)) goto invalid_shader;
+   const GX2VertexShader *vs = shader->vertexShader;
+   const GX2PixelShader *ps = shader->pixelShader;
+   if (!vs || !ps || vs->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       ps->mode != GX2_SHADER_MODE_UNIFORM_REGISTER) goto invalid_shader;
+
+   const char *clip_names[] = {"uClipX", "uClipY", "uClipZ", "uClipW"};
+   for (unsigned row = 0; row < 4; ++row) {
+      if (!uniform_offset(GX2GetVertexUniformVar(vs, clip_names[row]), &stars->clip_offsets[row]))
+         goto invalid_shader;
+   }
+   if (!uniform_offset(GX2GetPixelUniformVar(ps, "uColor"), &stars->color_offset) ||
+       !WHBGfxInitShaderAttribute(shader, "aPosition", 0, 0, GX2_ATTRIB_FORMAT_FLOAT_32_32_32) ||
+       !WHBGfxInitFetchShader(shader)) goto invalid_shader;
+
+   GX2RBuffer *buffer = &stars->vertices;
+   *buffer = (GX2RBuffer){
+      .flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER | GX2R_RESOURCE_USAGE_CPU_WRITE |
+               GX2R_RESOURCE_USAGE_GPU_READ,
+      .elemSize = VERTEX_BYTES, .elemCount = count,
+   };
+   if (GX2RCreateBuffer(buffer)) {
+      void *mapped = GX2RLockBufferEx(buffer, 0);
+      if (mapped) {
+         memcpy(mapped, vertices, count * VERTEX_BYTES);
+         GX2RUnlockBufferEx(buffer, 0);
+         *out = stars;
+         return 0;
+      }
+   }
+   release(stars);
+   return -2;
+
+invalid_shader:
+   release(stars);
+   return -3;
+}
+
+void horizon_gx2_stars_destroy(HorizonGx2Stars *stars)
+{
+   if (!stars) return;
+   GX2DrawDone();
+   release(stars);
+}
+
+int horizon_gx2_stars_draw(HorizonGx2Stars *stars, const uint32_t rect[4],
+                           const float clip_rows[4][4], float brightness)
+{
+   if (!stars || !rect || !rect[2] || !rect[3] || !clip_rows || !(brightness >= 0.0f)) return -1;
+   if (brightness > 1.0f) brightness = 1.0f;
+   /* Stock SDR adds the brightness premultiplied by itself and replaces alpha. */
+   const float light = brightness * brightness;
+   const float color[4] = {light, light, light, 1.0f};
+   WHBGfxShaderGroup *shader = &stars->shader;
+   GX2SetViewport(rect[0], rect[1], rect[2], rect[3], 0, 1);
+   GX2SetScissor(rect[0], rect[1], rect[2], rect[3]);
+   GX2SetShaderMode(shader->vertexShader->mode);
+   GX2SetFetchShader(&shader->fetchShader);
+   GX2SetVertexShader(shader->vertexShader);
+   GX2SetPixelShader(shader->pixelShader);
+   GX2RSetAttributeBuffer(&stars->vertices, 0, VERTEX_BYTES, 0);
+   for (unsigned row = 0; row < 4; ++row)
+      GX2SetVertexUniformReg(stars->clip_offsets[row], 4, clip_rows[row]);
+   GX2SetPixelUniformReg(stars->color_offset, 4, color);
+   GX2SetCullOnlyControl(GX2_FRONT_FACE_CCW, FALSE, FALSE);
+   GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+   GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0.0f);
+   GX2SetDepthOnlyControl(FALSE, FALSE, GX2_COMPARE_FUNC_ALWAYS);
+   GX2SetColorControl(GX2_LOGIC_OP_COPY, 1, FALSE, TRUE);
+   GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, 0, 0, 0, 0, 0, 0, 0);
+   GX2SetBlendControl(GX2_RENDER_TARGET_0, GX2_BLEND_MODE_ONE, GX2_BLEND_MODE_ONE,
+                      GX2_BLEND_COMBINE_MODE_ADD, TRUE, GX2_BLEND_MODE_ONE,
+                      GX2_BLEND_MODE_ZERO, GX2_BLEND_COMBINE_MODE_ADD);
+   GX2DrawEx(GX2_PRIMITIVE_MODE_TRIANGLES, stars->vertices.elemCount, 0, 1);
+   return 0;
+}
