index 0000000000000000000000000000000000000000..ca86ed36165298feab99b76c37b5fd020afcdb6f
--- /dev/null
+++ b/wiiu/loading_host/stars.vert
@@ -0,0 +1,12 @@
+#version 330
+
+in vec3 aPosition;
+uniform vec4 uClipX;
+uniform vec4 uClipY;
+uniform vec4 uClipZ;
+uniform vec4 uClipW;
+
+void main() {
+    vec4 p = vec4(aPosition, 1.0);
+    gl_Position = vec4(dot(uClipX, p), dot(uClipY, p), dot(uClipZ, p), dot(uClipW, p));
+}
