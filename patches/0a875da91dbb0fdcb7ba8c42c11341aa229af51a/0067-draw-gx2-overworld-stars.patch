+#ifndef HORIZON_GX2_STARS_H
+#define HORIZON_GX2_STARS_H
+
+#include <stdint.h>
+
+typedef struct HorizonGx2Stars HorizonGx2Stars;
+
+/* Copies the camera-relative triangle positions to one immutable GX2 buffer. */
+int horizon_gx2_stars_create(HorizonGx2Stars **out, const float (*vertices)[3], uint32_t count);
+void horizon_gx2_stars_destroy(HorizonGx2Stars *stars);
+
+/* Model-view-projection rows for the current output, including sky rotation. */
+int horizon_gx2_stars_draw(HorizonGx2Stars *stars, const uint32_t rect[4],
+                           const float clip_rows[4][4], float brightness);
+
+#endif
