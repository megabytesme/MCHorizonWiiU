+
+        scan.opened(start);
+        for millis in 0..10 {
+            let wake = start + Duration::from_millis(millis);
+            assert_eq!(scan.wait(wake, sweep), Duration::from_millis(10 - millis));
+            assert!(!scan.due(wake));
+        }
+        scan.opened(start + Duration::from_millis(9));
+        let first_scan = start + Duration::from_millis(10);
+        assert!(scan.due(first_scan));
+        assert!(!scan.due(first_scan));
+
+        scan.closed();
+        assert_eq!(scan.wait(first_scan, sweep), Duration::from_millis(10));
+        assert!(scan.due(first_scan + Duration::from_millis(10)));
+        scan.closed();
+        assert!(!scan.due(sweep));
+        assert_eq!(scan.wait(first_scan, sweep), Duration::from_millis(90));
