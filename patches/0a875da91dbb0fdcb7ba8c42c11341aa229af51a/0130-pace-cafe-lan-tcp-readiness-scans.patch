+    #[test]
+    fn pipe_wakeups_do_not_advance_the_tcp_scan() {
+        let start = Instant::now();
+        let sweep = start + Duration::from_millis(100);
+        let mut scan = TcpScan::default();
+
+        assert_eq!(scan.wait(start, sweep), Duration::from_millis(100));
