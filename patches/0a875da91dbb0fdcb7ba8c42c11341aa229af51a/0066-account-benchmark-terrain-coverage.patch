+    #[test]
+    fn cafe_flight_times_only_adjacent_paired_terrain_and_reports_coverage() {
+        let begin = Instant::now();
+        let mut coverage = CafeFlightCoverage::default();
+        // Terrain commands alone and paired blank frames cannot bridge a gap.
+        for (offset, paired, terrain, interval) in [
+            (0, true, true, None),
+            (16, false, true, None),
+            (32, true, true, None),
+            (48, true, false, None),
+            (64, true, true, None),
+            (81, true, true, Some(17)),
+        ] {
+            assert_eq!(
+                coverage.observe(begin + Duration::from_millis(offset), paired, terrain),
+                interval.map(Duration::from_millis)
+            );
+        }
+
+        let mut reply = serde_json::json!({ "frame_ms": [17.0] });
+        coverage.append_to_reply(&mut reply, Duration::from_millis(100));
+        let mut report = Report::new(Kind::Game, App::default());
+        record_cafe_flight_coverage(&mut report, "village", &reply);
+        for (key, expected) in [
+            ("host_frames", 6.0),
+            ("paired_frames", 5.0),
+            ("terrain_paired_frames", 4.0),
+            ("paired_terrain_intervals", 1.0),
+            ("elapsed_ms", 100.0),
+        ] {
+            assert_eq!(
+                report.metrics[&format!("cafe.village.{key}")].mean,
+                expected
+            );
+        }
+        assert_eq!(frames_of(&reply, "village", 0).unwrap().frames, 1);
+        reply["frame_ms"] = serde_json::json!([]);
+        assert!(frames_of(&reply, "village", 0).is_err());
+    }
