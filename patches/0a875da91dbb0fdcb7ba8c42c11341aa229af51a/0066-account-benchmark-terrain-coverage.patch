+/// Counts Cafe frame attempts in the measurement window and times adjacent
+/// submissions that both drew terrain on both outputs.
+#[cfg(any(target_os = "cafe", test))]
+#[derive(Default)]
+pub struct CafeFlightCoverage {
+    previous_terrain_start: Option<Instant>,
+    host_frames: u64,
+    paired_frames: u64,
+    terrain_paired_frames: u64,
+}
+
+#[cfg(any(target_os = "cafe", test))]
+impl CafeFlightCoverage {
+    pub fn observe(
+        &mut self,
+        start: Instant,
+        paired: bool,
+        gameplay_terrain: bool,
+    ) -> Option<Duration> {
+        self.host_frames += 1;
+        self.paired_frames += u64::from(paired);
+        let previous = self.previous_terrain_start.take();
+        if paired && gameplay_terrain {
+            self.terrain_paired_frames += 1;
+            self.previous_terrain_start = Some(start);
+            previous.map(|previous| start.duration_since(previous))
+        } else {
+            None
+        }
+    }
+
+    pub fn append_to_reply(&self, reply: &mut Value, elapsed: Duration) {
+        reply["cafe_flight_coverage"] = serde_json::json!({
+            "host_frames": self.host_frames,
+            "paired_frames": self.paired_frames,
+            "terrain_paired_frames": self.terrain_paired_frames,
+            "elapsed_ms": ms(elapsed),
+        });
+    }
+}
