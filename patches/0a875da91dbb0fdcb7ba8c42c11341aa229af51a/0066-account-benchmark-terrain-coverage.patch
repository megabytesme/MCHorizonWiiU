+fn record_cafe_flight_coverage(report: &mut Report, phase: &str, reply: &Value) {
+    let Some(coverage) = reply["cafe_flight_coverage"].as_object() else {
+        return;
+    };
+    for key in [
+        "host_frames",
+        "paired_frames",
+        "terrain_paired_frames",
+        "elapsed_ms",
+    ] {
+        if let Some(value) = coverage.get(key).and_then(Value::as_f64) {
+            report.metric(&format!("cafe.{phase}.{key}"), &[value]);
+        }
+    }
+    let samples = reply["frame_ms"].as_array().map_or(0, Vec::len);
+    report.metric(
+        &format!("cafe.{phase}.paired_terrain_intervals"),
+        &[samples as f64],
+    );
+    #[cfg(target_os = "cafe")]
+    log::info!(
+        "Cafe benchmark terrain {phase}: host={} paired={} terrain={} intervals={samples}",
+        reply["cafe_flight_coverage"]["host_frames"],
+        reply["cafe_flight_coverage"]["paired_frames"],
+        reply["cafe_flight_coverage"]["terrain_paired_frames"],
+    );
+}
