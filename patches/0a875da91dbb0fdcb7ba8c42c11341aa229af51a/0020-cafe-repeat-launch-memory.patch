+/// Keep the content fingerprint identical to the parallel desktop reader.
+/// Cafe hashes each piece incrementally to bound the temporary allocation.
+#[cfg(any(target_os = "cafe", test))]
+fn hash_reader(reader: &mut impl std::io::Read, len: u64) -> io::Result<[u8; 32]> {
+    let mut remaining = len;
+    let mut buffer = [0; 8192];
+    let mut pieces = Sha256::new();
+    let digest = loop {
+        let mut left = remaining.min(HASH_PIECE as u64) as usize;
+        remaining -= left as u64;
+        let mut piece = Sha256::new();
+        while left != 0 {
+            let count = left.min(buffer.len());
+            reader.read_exact(&mut buffer[..count])?;
+            piece.update(&buffer[..count]);
+            left -= count;
+        }
+        let digest = piece.finalize();
+        if len <= HASH_PIECE as u64 {
+            break digest.into();
+        }
+        pieces.update(digest);
+        if remaining == 0 {
+            break pieces.finalize().into();
+        }
+    };
+    if reader.read(&mut buffer[..1])? != 0 {
+        return Err(invalid("the cache source grew while hashing"));
+    }
+    Ok(digest)
+}
