+
+#ifdef HORIZON_GX2_HUD_VIEW_LANES
+enum {
+   MIN_VIEW_LANES = 2,
+   MAX_VIEW_LANES = 5,
+   VIEW_VERTEX_LIMIT = 16384,
+   VIEW_ALLOCATION_LIMIT = 4 * 1024 * 1024,
+};
+
+typedef enum { VIEW_IDLE, VIEW_ACTIVE, VIEW_PENDING } ViewLaneState;
+
+struct HorizonHudViewLanes {
+   GX2RBuffer buffers[MAX_VIEW_LANES];
+   OSTime prior_pair, after_last_draw, recovery_submission;
+   uint32_t count, bytes, consumed;
+   bool gpu_used;
+   ViewLaneState state;
+};
+
+_Static_assert(sizeof(HorizonHudGpuVertex) == 48, "Unexpected GPU HUD vertex size");
+
+static bool is_retired_pair(uint64_t expected, OSTime floor)
+{
+   if (expected > INT64_MAX || (OSTime)expected <= floor) return false;
+   const OSTime submitted = GX2GetLastSubmittedTimeStamp();
+   return submitted == (OSTime)expected && GX2GetRetiredTimeStamp() >= submitted;
+}
+
+bool horizon_gx2_hud_view_lanes_destroy(HorizonHudViewLanes *lanes)
+{
+   if (!lanes) return true;
+   if (lanes->state != VIEW_IDLE) return false;
+   for (uint32_t i = 0; i < lanes->count; ++i) {
+      if (GX2RBufferExists(&lanes->buffers[i])) GX2RDestroyBufferEx(&lanes->buffers[i], 0);
+   }
+   free(lanes);
+   return true;
+}
+
+HorizonHudViewLanes *horizon_gx2_hud_view_lanes_create(uint32_t views, uint32_t vertices_per_view)
+{
+   if (views < MIN_VIEW_LANES || views > MAX_VIEW_LANES ||
+       !vertices_per_view || vertices_per_view > VIEW_VERTEX_LIMIT) return NULL;
+   HorizonHudViewLanes *lanes = calloc(1, sizeof(*lanes));
+   if (!lanes) return NULL;
+   lanes->count = views;
+   for (uint32_t i = 0; i < views; ++i) {
+      GX2RBuffer *buffer = &lanes->buffers[i];
+      buffer->flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER |
+         GX2R_RESOURCE_USAGE_CPU_WRITE | GX2R_RESOURCE_USAGE_GPU_READ;
+      buffer->elemSize = sizeof(HorizonHudGpuVertex);
+      buffer->elemCount = vertices_per_view;
+      const uint32_t bytes = GX2RGetBufferAllocationSize(buffer);
+      if (bytes < buffer->elemCount * buffer->elemSize ||
+          bytes > VIEW_ALLOCATION_LIMIT - lanes->bytes || !GX2RCreateBuffer(buffer)) {
+         horizon_gx2_hud_view_lanes_destroy(lanes);
+         return NULL;
+      }
+      lanes->bytes += bytes;
+   }
+   return lanes;
+}
+
+uint32_t horizon_gx2_hud_view_lanes_bytes(const HorizonHudViewLanes *lanes)
+{
+   return lanes ? lanes->bytes : 0;
+}
+
+bool horizon_gx2_hud_view_lanes_begin(HorizonHudViewLanes *lanes, uint64_t prior_pair)
+{
+   if (!lanes || lanes->state != VIEW_IDLE || !is_retired_pair(prior_pair, lanes->prior_pair))
+      return false;
+   lanes->state = VIEW_ACTIVE;
+   lanes->prior_pair = (OSTime)prior_pair;
+   lanes->after_last_draw = lanes->prior_pair;
+   lanes->consumed = 0;
+   lanes->gpu_used = false;
+   return true;
+}
+
+HorizonHudResult horizon_gx2_hud_view_lanes_draw(
+   HorizonHudViewLanes *lanes, HorizonGx2Hud *hud, const HorizonHudFrame *frame,
+   uint32_t slot, uint32_t output, uint32_t x, uint32_t y, uint32_t width, uint32_t height)
+{
+   if (!hud || !frame || output > 1) return HORIZON_HUD_INVALID;
+   if (!lanes || lanes->state != VIEW_ACTIVE || slot >= lanes->count ||
+       (lanes->consumed & (1u << slot)) || frame->patch_count) return HORIZON_HUD_VIEW_FALLBACK;
+   GX2RBuffer *vertices = &lanes->buffers[slot];
+   if (frame->vertex_count > vertices->elemCount) return HORIZON_HUD_VIEW_FALLBACK;
+   HorizonHudResult result = validate_frame(hud, frame);
+   if (result != HORIZON_HUD_OK) return result;
+   const HudOutput target = hud_output(output);
+   result = validate_draw_target(frame, x, y, width, height, &target);
+   if (result != HORIZON_HUD_OK) return result;
+   result = upload_vertices(vertices, frame);
+   if (result != HORIZON_HUD_OK) return HORIZON_HUD_VIEW_FALLBACK;
+   lanes->consumed |= 1u << slot;
+   lanes->gpu_used |= frame->vertex_count != 0;
+   hud->last_draw_wait_ns = 0;
+   result = draw_uploaded(hud, vertices, frame, x, y, width, height, &target);
+   if (frame->vertex_count) {
+      const OSTime submitted = GX2GetLastSubmittedTimeStamp();
+      if (submitted > lanes->after_last_draw) lanes->after_last_draw = submitted;
+   }
+   return result;
+}
+
+HorizonHudResult horizon_gx2_hud_draw_verified_to_output(
+   HorizonGx2Hud *hud, const HorizonHudFrame *frame,
+   uint32_t output, uint32_t x, uint32_t y, uint32_t width, uint32_t height)
+{
+   if (output > 1) return HORIZON_HUD_INVALID;
+   const HudOutput target = hud_output(output);
+   return draw_to(hud, frame, x, y, width, height, &target, true);
+}
+
+bool horizon_gx2_hud_view_lanes_seal(HorizonHudViewLanes *lanes, uint64_t retired_pair)
+{
+   if (!lanes || lanes->state != VIEW_ACTIVE) return false;
+   if (!lanes->gpu_used || is_retired_pair(retired_pair, lanes->after_last_draw)) {
+      lanes->state = VIEW_IDLE;
+      return true;
+   }
+   lanes->state = VIEW_PENDING;
+   lanes->recovery_submission = 0;
+   return false;
+}
+
+void horizon_gx2_hud_view_lanes_finish_verified(HorizonHudViewLanes *lanes)
+{
+   lanes->state = VIEW_IDLE;
+}
+
+bool horizon_gx2_hud_view_lanes_recover(HorizonHudViewLanes *lanes, bool foreground)
+{
+   if (!lanes) return false;
+   if (lanes->state != VIEW_PENDING) return lanes->state == VIEW_IDLE;
+   if (!foreground) return false;
+   if (!lanes->recovery_submission) {
+      // Explicit recovery only. The guarded normal host has already flushed
+      // and drained the pair before returning its verified token.
+      const OSTime before = GX2GetLastSubmittedTimeStamp();
+      GX2Flush();
+      OSTime submitted = GX2GetLastSubmittedTimeStamp();
+      if (submitted <= before || submitted <= lanes->after_last_draw) {
+         // A void flush with a stationary watermark is not fresh proof.
+         // Only the exceptional recovery path may perform a full drain.
+         if (!GX2DrawDone()) return false;
+         submitted = GX2GetLastSubmittedTimeStamp();
+         if (submitted < lanes->after_last_draw) return false;
+      }
+      lanes->recovery_submission = submitted;
+   }
+   if (GX2GetRetiredTimeStamp() < lanes->recovery_submission) return false;
+   lanes->state = VIEW_IDLE;
+   return true;
+}
+#endif
