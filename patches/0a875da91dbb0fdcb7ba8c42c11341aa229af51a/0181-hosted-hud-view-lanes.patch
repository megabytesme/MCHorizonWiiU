+
+#ifdef HORIZON_GX2_HUD_VIEW_LANES
+#include <stdbool.h>
+
+/* Optional, separately owned vertex slots for two through five logical views.
+ * Prepare at a frame boundary and keep the owner on the foreground GX2 thread.
+ * The normal HUD texture and fallback buffer remain owned by HorizonGx2Hud. */
+typedef struct HorizonHudViewLanes HorizonHudViewLanes;
+HorizonHudViewLanes *horizon_gx2_hud_view_lanes_create(uint32_t views, uint32_t vertices_per_view);
+uint32_t horizon_gx2_hud_view_lanes_bytes(const HorizonHudViewLanes *lanes);
+
+/* The token is the last known positive completion from the guarded host. */
+bool horizon_gx2_hud_view_lanes_begin(HorizonHudViewLanes *lanes, uint64_t prior_pair);
+
+/* Bind the specified WHB output first and set this view's style. A slot accepts
+ * one draw per pair; a frame with any atlas patch returns VIEW_FALLBACK before
+ * an upload. Use the verified direct entry below for that fallback.
+ * No borrowed descriptor survives the call. Finish each view's world before
+ * depth HUD runs, which retain their original target-wide depth clear. */
+HorizonHudResult horizon_gx2_hud_view_lanes_draw(
+   HorizonHudViewLanes *lanes, HorizonGx2Hud *hud, const HorizonHudFrame *frame,
+   uint32_t slot, uint32_t output, uint32_t x, uint32_t y, uint32_t width, uint32_t height);
+
+/* The ordinary HUD buffer and atlas, with explicit drain verification. A
+ * timed-out/unverified drain changes no atlas, vertex, or drawing state. */
+HorizonHudResult horizon_gx2_hud_draw_verified_to_output(
+   HorizonGx2Hud *hud, const HorizonHudFrame *frame,
+   uint32_t output, uint32_t x, uint32_t y, uint32_t width, uint32_t height);
+
+/* Always seal after the host returns, including callback error and retry. A
+ * nonzero token must come from that host call's positive final retirement.
+ * A false result pins the owner until recovery. Recovery may drain when
+ * an explicit flush produces no fresh watermark. Do not tear down the HUD atlas, GX2 context or native stream on failure. */
+bool horizon_gx2_hud_view_lanes_seal(HorizonHudViewLanes *lanes, uint64_t retired_pair);
+bool horizon_gx2_hud_view_lanes_recover(HorizonHudViewLanes *lanes, bool foreground);
+bool horizon_gx2_hud_view_lanes_destroy(HorizonHudViewLanes *lanes);
+/* Native host only. The current GX2 thread has positively drained all
+ * callbacks, including aborted pairs, and issued no new lane commands. */
+void horizon_gx2_hud_view_lanes_finish_verified(HorizonHudViewLanes *lanes);
+#endif
