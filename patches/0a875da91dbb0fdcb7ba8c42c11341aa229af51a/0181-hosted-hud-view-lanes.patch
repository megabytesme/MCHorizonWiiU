diff --git a/wiiu/loading_host/hud_views.rs b/wiiu/loading_host/hud_views.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b686f143d358ba7d4ce6aceb08d09cebdf23dd67
--- /dev/null
+++ b/wiiu/loading_host/hud_views.rs
@@ -0,0 +1,193 @@
+//! Lifecycle for the ordinary-profile, non-deferred independent HUD buffers.
+
+use super::{OSReport, RETRY_GUARDED_FLIP};
+use std::ffi::{c_char, c_void};
+use std::ptr::NonNull;
+
+type DrawTarget = unsafe extern "C" fn(*mut c_void, u32, u32, u32) -> i32;
+
+unsafe extern "C" {
+    fn horizon_gx2_profile_view_hud() -> bool;
+    fn horizon_loading_host_prepare_view_hud(prior_pair: u64) -> i32;
+    fn horizon_loading_host_present_view_hud(
+        draw: DrawTarget,
+        context: *mut c_void,
+        clear: *const f32,
+        retired_pair: *mut u64,
+        active_lanes: *mut c_void,
+    ) -> i32;
+    fn horizon_gx2_hud_view_lanes_create(views: u32, capacity: u32) -> *mut c_void;
+    fn horizon_gx2_hud_view_lanes_bytes(lanes: *const c_void) -> u32;
+    fn horizon_gx2_hud_view_lanes_begin(lanes: *mut c_void, prior_pair: u64) -> bool;
+    fn horizon_gx2_hud_view_lanes_destroy(lanes: *mut c_void) -> bool;
+}
+
+#[derive(Clone, Copy)]
+#[repr(u8)]
+pub(super) enum Reason {
+    Bootstrap,
+    ForegroundOrRetirement,
+    TitleOrNoTerrain,
+    Capture,
+    Keyboard,
+    FramePatches,
+    Allocation,
+    LaneToken,
+    AtlasAnimation,
+    LaneDeclined,
+    TargetDrain,
+    AtlasDrain,
+}
+
+impl Reason {
+    fn label(self) -> *const c_char {
+        match self {
+            Self::Bootstrap => c"bootstrap",
+            Self::ForegroundOrRetirement => c"foreground-or-prior-retirement",
+            Self::TitleOrNoTerrain => c"title-or-no-terrain",
+            Self::Capture => c"capture",
+            Self::Keyboard => c"keyboard",
+            Self::FramePatches => c"frame-atlas-patches",
+            Self::Allocation => c"lane-allocation",
+            Self::LaneToken => c"lane-token",
+            Self::AtlasAnimation => c"hud-atlas-animation",
+            Self::LaneDeclined => c"native-lane-declined",
+            Self::TargetDrain => c"target-retirement",
+            Self::AtlasDrain => c"prepatch-retirement",
+        }
+        .as_ptr()
+    }
+}
+
+struct Arena(NonNull<c_void>);
+
+impl Drop for Arena {
+    fn drop(&mut self) {
+        // The synchronous host always seals an opened arena before returning,
+        // including callback failure. Never destroy an allocation it still owns.
+        assert!(unsafe { horizon_gx2_hud_view_lanes_destroy(self.0.as_ptr()) });
+    }
+}
+
+#[derive(Default)]
+pub(super) struct Trial {
+    arena: Option<Arena>,
+    allocation_failed: bool,
+    reasons: u16,
+    accepted: [u32; 2],
+    direct: [u32; 2],
+    waits_ns: [u64; 2],
+    pairs: u32,
+}
+
+impl Trial {
+    pub(super) fn requested() -> bool {
+        unsafe { horizon_gx2_profile_view_hud() }
+    }
+
+    pub(super) fn verify_before_frame(prior_pair: u64) -> Result<bool, ()> {
+        match unsafe { horizon_loading_host_prepare_view_hud(prior_pair) } {
+            1 => Ok(true),
+            0 => Ok(false),
+            RETRY_GUARDED_FLIP => Err(()),
+            _ => unreachable!("invalid native HUD retirement status"),
+        }
+    }
+
+    pub(super) fn drain_before_mutation() -> bool {
+        Self::verify_before_frame(0).is_ok()
+    }
+
+    pub(super) fn release_surface(&mut self) {
+        self.arena = None;
+        self.allocation_failed = false;
+    }
+
+    pub(super) fn activate(&mut self, prior: u64, capacity: u32) -> Option<NonNull<c_void>> {
+        if self.arena.is_none() && !self.allocation_failed {
+            let ptr = unsafe { horizon_gx2_hud_view_lanes_create(2, capacity.min(16_384)) };
+            self.arena = NonNull::new(ptr).map(Arena);
+            if self.arena.is_none() {
+                self.allocation_failed = true;
+            } else {
+                unsafe {
+                    OSReport(
+                        c"Horizon GX2 HUD lanes allocated bytes=%u views=2\n".as_ptr(),
+                        horizon_gx2_hud_view_lanes_bytes(ptr),
+                    );
+                }
+            }
+        }
+        let Some(arena) = &self.arena else {
+            self.reason(Reason::Allocation);
+            return None;
+        };
+        let lanes = arena.0;
+        if unsafe { horizon_gx2_hud_view_lanes_begin(lanes.as_ptr(), prior) } {
+            Some(lanes)
+        } else {
+            self.reason(Reason::LaneToken);
+            None
+        }
+    }
+
+    pub(super) unsafe fn present(
+        draw: DrawTarget,
+        context: *mut c_void,
+        clear: &[f32; 4],
+        ticket: &mut u64,
+        lanes: Option<NonNull<c_void>>,
+    ) -> i32 {
+        unsafe {
+            horizon_loading_host_present_view_hud(
+                draw,
+                context,
+                clear.as_ptr(),
+                ticket,
+                lanes.map_or(std::ptr::null_mut(), NonNull::as_ptr),
+            )
+        }
+    }
+
+    pub(super) fn reason(&mut self, reason: Reason) {
+        let mask = 1 << reason as u8;
+        if self.reasons & mask == 0 {
+            self.reasons |= mask;
+            unsafe {
+                OSReport(
+                    c"Horizon GX2 HUD lanes fallback reason=%s\n".as_ptr(),
+                    reason.label(),
+                );
+            }
+        }
+    }
+
+    pub(super) fn draw(&mut self, target: usize, lane: bool, wait_ns: u64) {
+        if lane {
+            self.accepted[target] += 1;
+        } else {
+            self.direct[target] += 1;
+        }
+        self.waits_ns[target] = self.waits_ns[target].saturating_add(wait_ns);
+    }
+
+    pub(super) fn finish(&mut self, completed: bool) {
+        self.pairs += u32::from(completed);
+        if self.pairs >= 300
+            || self.accepted.iter().sum::<u32>() + self.direct.iter().sum::<u32>() >= 610
+        {
+            unsafe {
+                OSReport(
+                    c"Horizon GX2 HUD lanes pairs=%u tv_slots=%u drc_slots=%u tv_direct=%u drc_direct=%u tv_hud_wait_us=%u drc_hud_wait_us=%u\n".as_ptr(),
+                    self.pairs, self.accepted[0], self.accepted[1], self.direct[0], self.direct[1],
+                    (self.waits_ns[0] / 1000).min(u64::from(u32::MAX)) as u32,
+                    (self.waits_ns[1] / 1000).min(u64::from(u32::MAX)) as u32,
+                );
+            }
+            self.pairs = 0;
+            self.accepted = [0; 2];
+            self.direct = [0; 2];
+            self.waits_ns = [0; 2];
+        }
+    }
+}
