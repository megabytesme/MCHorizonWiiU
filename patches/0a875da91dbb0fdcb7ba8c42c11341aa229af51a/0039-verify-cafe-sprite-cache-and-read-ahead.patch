+        let file = File::open(path).unwrap();
+        let mut window = ReadAhead::default();
+        for (offset, length) in [
+            (0, 103),
+            (13, 19),
+            (3, 5000),
+            (31, 64),
+            (READ_AHEAD_BYTES, 31),
+            (1, 12),
+        ] {
+            let mut actual = vec![0; length];
+            window
+                .read(&file, bytes.len() as u64, &mut actual, offset as u64)
+                .unwrap();
+            assert_eq!(actual, bytes[offset..offset + length]);
+            assert!(window.bytes.len() <= READ_AHEAD_BYTES);
+        }
+        drop(file);
+        fs::remove_dir_all(&root).unwrap();
+    }
