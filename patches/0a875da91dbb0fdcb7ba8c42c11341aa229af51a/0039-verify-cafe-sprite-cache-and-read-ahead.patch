+    #[test]
+    fn failed_speculation_preserves_an_in_bounds_short_read() {
+        let root = root("readahead-truncated");
+        let path = root.join("fixture.bin");
+        fs::write(&path, b"complete entry").unwrap();
+        let file = File::open(path).unwrap();
+        let mut window = ReadAhead::default();
+        let mut actual = [0; 8];
+        window.read(&file, 4096, &mut actual, 0).unwrap();
+        assert!(window.bytes.is_empty());
+        window.read(&file, 4096, &mut actual, 1).unwrap();
+        assert_eq!(&actual, b"omplete ");
+        assert!(window.bytes.is_empty());
+        drop(file);
+        fs::remove_dir_all(&root).unwrap();
+    }
