+/// A single bounded window. Keep it across small reads and bypass it for
+/// bulk reads, which already amortize the Cafe seek cost.
+const READ_AHEAD_BYTES: usize = 32 * 1024;
+const SMALL_ENTRY_BYTES: usize = 4 * 1024;
+const READ_AHEAD_GAP: u64 = 1024;
+
+#[derive(Default)]
+struct ReadAhead {
+    previous_small: Option<(u64, u64)>,
+    start: u64,
+    bytes: Vec<u8>,
+}
+
+impl ReadAhead {
+    fn read(&mut self, file: &File, size: u64, out: &mut [u8], offset: u64) -> io::Result<()> {
+        if out.is_empty() {
+            return Ok(());
+        }
+        #[cfg(target_os = "cafe")]
+        {
+            use std::sync::atomic::Ordering::Relaxed;
+            cafe_io::count(&cafe_io::READ_REQUESTS);
+            cafe_io::REQUEST_BYTES.fetch_add(out.len() as u64, Relaxed);
+        }
+        if out.len() > SMALL_ENTRY_BYTES {
+            return read_at(file, out, offset);
+        }
+        let end = offset + out.len() as u64;
+        let previous = self.previous_small.replace((offset, end));
+        let hit = offset
+            .checked_sub(self.start)
+            .and_then(|gap| usize::try_from(gap).ok())
+            .and_then(|gap| self.bytes.get(gap..)?.get(..out.len()));
+        if let Some(bytes) = hit {
+            #[cfg(target_os = "cafe")]
+            cafe_io::count(&cafe_io::READ_AHEAD_HITS);
+            out.copy_from_slice(bytes);
+            return Ok(());
+        }
+
+        // Pay for an exact read until the request order shows locality.
+        let Some((previous, _)) = previous.filter(|&(start, last_end)| {
+            offset.saturating_sub(last_end).max(start.saturating_sub(end)) <= READ_AHEAD_GAP
+        }) else {
+            return read_at(file, out, offset);
+        };
+        // A recent backwards step can still belong to the same batch.
+        let start = offset.min(previous);
+        self.start = start;
+        self.bytes
+            .resize((size - start).min(READ_AHEAD_BYTES as u64) as usize, 0);
+        if read_at(file, &mut self.bytes, start).is_err() {
+            // A failed speculative read may extend past the requested bytes.
+            self.bytes.clear();
+            return read_at(file, out, offset);
+        }
+        let at = (offset - start) as usize;
+        out.copy_from_slice(&self.bytes[at..at + out.len()]);
+        Ok(())
+    }
+}
