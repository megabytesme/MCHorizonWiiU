+#[cfg(any(target_os = "cafe", test))]
+fn cafe_village_diagnostic(game_dir: &Path, scenario: &str) -> bool {
+    use std::fs::{File, symlink_metadata};
+    use std::io::Read;
+
+    fn matches_file(path: &Path, expected: &[u8]) -> bool {
+        if !symlink_metadata(path)
+            .is_ok_and(|metadata| metadata.is_file() && metadata.len() == expected.len() as u64)
+        {
+            return false;
+        }
+        let Ok(file) = File::open(path) else {
+            return false;
+        };
+        let mut content = Vec::new();
+        file.take(expected.len() as u64 + 1)
+            .read_to_end(&mut content)
+            .is_ok()
+            && content == expected
+    }
+
+    scenario == "village"
+        && game_dir
+            .file_name()
+            .is_some_and(|name| name == ".benchmark-run")
+        && symlink_metadata(game_dir).is_ok_and(|metadata| metadata.is_dir())
+        && matches_file(&game_dir.join(CAFE_WORKSPACE_MARKER), CAFE_WORKSPACE_OWNER)
+        && matches_file(
+            &game_dir.join(VILLAGE_DIAGNOSTIC_MARKER),
+            VILLAGE_DIAGNOSTIC_CONTENT,
+        )
+}
