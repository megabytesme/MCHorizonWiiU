+/// The diagnostic may admit an unfinished view, but the position and the
+/// frame actually submitted by GX2 must both be from the expected view.
+fn diagnostic_terrain(status: &Value, at_view: &impl Fn(&Value) -> bool) -> bool {
+    let renderer = &status["renderer"];
+    let position = &status["player"]["position"];
+    let camera = &renderer["terrain_camera"];
+    let xyz = |value: &Value| -> Option<[f64; 3]> {
+        let [x, y, z] = value.as_array()?.as_slice() else {
+            return None;
+        };
+        Some([x.as_f64()?, y.as_f64()?, z.as_f64()?])
+    };
+    if status["screen"] != "playing"
+        || renderer["backend"] != "gx2"
+        || renderer["terrain_presented"] != true
+        || status["chunks"].as_u64().unwrap_or(0) == 0
+        || !at_view(position)
+    {
+        return false;
+    }
+    let Some((position, camera)) = xyz(position).zip(xyz(camera)) else {
+        return false;
+    };
+    // The player's position is at their feet and the native camera is at eye
+    // height. X/Z must agree and Y must be close enough for that offset.
+    (position[0] - camera[0]).abs() < 2.0
+        && (position[1] - camera[1]).abs() < 3.0
+        && (position[2] - camera[2]).abs() < 2.0
+        && renderer["terrain_sections"]
+            .as_array()
+            .is_some_and(|sections| {
+                sections.len() == 2
+                    && sections
+                        .iter()
+                        .all(|count| count.as_u64().is_some_and(|count| count > 0))
+            })
+}
+
+fn wait_for_diagnostic_terrain(
+    control: &Control,
+    at_view: impl Fn(&Value) -> bool,
+    report: &mut Report,
+    phase: &str,
+) -> Result<Instant, String> {
+    let status = poll(control, LOAD_LIMIT, |status| {
+        diagnostic_terrain(status, &at_view)
+    })?;
+    let observed = Instant::now();
+    let renderer = &status["renderer"];
+    for (name, value) in [
+        ("resident_columns", &status["chunks"]),
+        ("pending_chunks", &status["pending_chunks"]),
+        ("tv_terrain_sections", &renderer["terrain_sections"][0]),
+        ("gamepad_terrain_sections", &renderer["terrain_sections"][1]),
+    ] {
+        if let Some(value) = value.as_f64() {
+            report.metric(&format!("cafe.diagnostic.{phase}.{name}"), &[value]);
+        }
+    }
+    Ok(observed)
+}
