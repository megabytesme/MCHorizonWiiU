+/// The resolved input may hold a block-tag ingredient in any nested shape.
+/// Search the values rather than a serialized spelling or a list of slots so
+/// that custom displays and future nested ingredient forms remain covered.
+fn uses_block_tag_ingredient(value: &Value) -> bool {
+    match value {
+        Value::String(name) => name == "neoforge:block_tag",
+        Value::Array(entries) => entries.iter().any(uses_block_tag_ingredient),
+        Value::Object(components) => components.values().any(uses_block_tag_ingredient),
+        _ => false,
+    }
+}
