+    #[test]
+    fn stock_recipes_skip_block_facts_and_nested_block_tags_keep_item_aliases() {
+        use horizon_world::{item_defaults, loot::PackOverlay};
+        use std::fs;
+
+        let root = std::env::temp_dir().join(format!(
+            "horizon-recipe-catalog-block-tags-{}",
+            std::process::id()
+        ));
+        let tags = root.join("data/minecraft/tags/block");
+        fs::create_dir_all(&tags).unwrap();
+        fs::write(
+            root.join("items.json"),
+            r#"{"minecraft:oak_sign":{},"minecraft:stick":{}}"#,
+        )
+        .unwrap();
+        fs::write(
+            tags.join("signs.json"),
+            r#"{"values":["minecraft:oak_wall_sign"]}"#,
+        )
+        .unwrap();
+        fs::write(
+            root.join("facts.json"),
+            r#"{"defaults":{"minecraft:oak_wall_sign":0}}"#,
+        )
+        .unwrap();
+        let gameplay = root.join("gameplay-facts.json");
+        fs::write(&gameplay, b"not JSON").unwrap();
+        let defaults = item_defaults::read(&root).unwrap();
+        let run = |ingredient| {
+            let sources = ResolvedSources::resolve(
+                vec![(
+                    "example".into(),
+                    json!({
+                        "type": "minecraft:crafting_shapeless",
+                        "ingredients": [ingredient],
+                        "result": {"id": "minecraft:stick"}
+                    }),
+                )],
+                &load(EngineDataLoadOrigin::ServerDataLoad),
+            )
+            .unwrap();
+            network_recipes(
+                &root,
+                &PackOverlay::NONE,
+                &defaults,
+                &sources,
+                Default::default(),
+            )
+        };
+        let (stock, _) = run(json!("minecraft:oak_sign")).unwrap();
+        let stock: Value = serde_json::from_str(&stock["minecraft:example"]).unwrap();
+        assert_eq!(stock["ingredients"], json!(["minecraft:oak_sign"]));
+
+        let block_tag = json!({
+            "type": "neoforge:compound",
+            "children": [
+                {"neoforge:ingredient_type": "neoforge:block_tag", "tag": "minecraft:signs"}
+            ]
+        });
+        assert!(run(block_tag.clone()).is_err());
+        fs::write(&gameplay, r#"{"states":[{"item":"minecraft:oak_sign"}]}"#).unwrap();
+        let (nested, _) = run(block_tag).unwrap();
+        let nested: Value = serde_json::from_str(&nested["minecraft:example"]).unwrap();
+        assert_eq!(nested["ingredients"], json!([["minecraft:oak_sign"]]));
+        fs::remove_dir_all(root).unwrap();
+    }
