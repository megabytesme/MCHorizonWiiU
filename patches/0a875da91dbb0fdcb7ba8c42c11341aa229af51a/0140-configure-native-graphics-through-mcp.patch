diff --git a/crates/horizon-client/src/game/interface/options/cafe_graphics_control.rs b/crates/horizon-client/src/game/interface/options/cafe_graphics_control.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1362b07416de94dcb01ada4d2c8363966d047c90
--- /dev/null
+++ b/crates/horizon-client/src/game/interface/options/cafe_graphics_control.rs
@@ -0,0 +1,193 @@
+//! Wii U native graphics options for the existing options-get/set interface.
+
+use horizon_client::{
+    graphics::{Preset, RESOLUTION_SCALE_MAX, apply_preset},
+    settings::Settings,
+};
+
+const PRESET: &str = "horizonGraphicsPreset";
+const SCALE: &str = "resolutionScale";
+const DYNAMIC: &str = "dynamicResolution";
+const TARGET: &str = "targetFps";
+const SCALE_MIN: u32 = 50;
+const TARGET_MIN: u32 = 30;
+const TARGET_MAX: u32 = 240;
+const SLIDER_STEP: u32 = 5;
+
+#[cfg(target_os = "cafe")]
+pub(super) const KEYS: &[&str] = &[PRESET, SCALE, DYNAMIC, TARGET];
+
+#[cfg(target_os = "cafe")]
+pub(super) fn is_preset_option(key: &str) -> bool {
+    matches!(
+        key,
+        "renderDistance"
+            | "simulationDistance"
+            | "entityDistanceScaling"
+            | "renderClouds"
+            | "particles"
+            | "entityShadows"
+            | "mipmapLevels"
+            | "biomeBlendRadius"
+            | "weatherRadius"
+    )
+}
+
+fn slider_value(key: &str, value: &str, min: u32, max: u32) -> Result<u32, String> {
+    value
+        .parse::<u32>()
+        .ok()
+        .filter(|v| (min..=max).contains(v) && (v - min).is_multiple_of(SLIDER_STEP))
+        .ok_or_else(|| {
+            format!("{key} accepts integers from {min} to {max} in steps of {SLIDER_STEP}")
+        })
+}
+
+fn set(s: &mut Settings, key: &str, value: &str, drs_offered: bool) -> Result<bool, String> {
+    let graphics = &mut s.horizon;
+    let changed = match key {
+        PRESET => {
+            let preset = Preset::ALL
+                .into_iter()
+                .find(|preset| preset.name() == value)
+                .ok_or("Unknown Horizon graphics preset")?;
+            apply_preset(preset, s);
+            s.horizon.preset = preset;
+            return Ok(true);
+        }
+        DYNAMIC | TARGET if !drs_offered => {
+            return Err(
+                "Automatic resolution is awaiting Wii U gameplay timing validation.".into(),
+            );
+        }
+        SCALE => {
+            let scale = slider_value(key, value, SCALE_MIN, RESOLUTION_SCALE_MAX)?;
+            std::mem::replace(&mut graphics.resolution_scale, scale) != scale
+        }
+        DYNAMIC => {
+            let enabled = value
+                .parse::<bool>()
+                .map_err(|_| "dynamicResolution accepts true or false")?;
+            std::mem::replace(&mut graphics.dynamic_resolution, enabled) != enabled
+        }
+        TARGET => {
+            let fps = slider_value(key, value, TARGET_MIN, TARGET_MAX)?;
+            std::mem::replace(&mut graphics.target_fps, fps) != fps
+        }
+        _ => return Ok(false),
+    };
+    if changed {
+        graphics.preset = Preset::Custom;
+    }
+    Ok(true)
+}
+
+#[cfg(target_os = "cafe")]
+impl super::Game<'_> {
+    pub(super) fn set_cafe_graphics(&mut self, key: &str, value: &str) -> super::Result<bool> {
+        let previous = &self.settings.horizon;
+        let previous = (
+            previous.resolution_scale,
+            previous.dynamic_resolution,
+            previous.target_fps,
+        );
+        let trial = horizon_client::graphics::cafe_dynamic_resolution_trial();
+        if !set(&mut self.settings, key, value, trial)? {
+            return Ok(false);
+        }
+        let graphics = &self.settings.horizon;
+        if previous
+            != (
+                graphics.resolution_scale,
+                graphics.dynamic_resolution,
+                graphics.target_fps,
+            )
+        {
+            self.dynamic_resolution.reset();
+        }
+        self.handle_option_events(vec![super::Event::Changed])?;
+        self.ui_wait.clicked();
+        Ok(true)
+    }
+
+    pub(super) fn describe_cafe_graphics(&self, key: &str) -> Option<super::Value> {
+        use super::json;
+        let graphics = &self.settings.horizon;
+        let trial = horizon_client::graphics::cafe_dynamic_resolution_trial();
+        let dynamic = self.cafe_drs_trial_active();
+        let writable = self.options.benchmark.is_none();
+        Some(match key {
+            PRESET => json!({
+                "value": graphics.preset.name(), "type": "enum", "writable": writable,
+                "choices": Preset::ALL.map(Preset::name),
+            }),
+            SCALE => {
+                let requested = if dynamic {
+                    self.dynamic_resolution.scale(graphics.resolution_scale)
+                } else {
+                    graphics.resolution_scale
+                };
+                let last_pair = self.cafe_performance.paired_resolution.map(|(r, at)| {
+                    json!({
+                        "requested": r.requested_scale,
+                        "effective": r.effective_scale,
+                        "age_ms": at.elapsed().as_secs_f64() * 1000.0,
+                    })
+                });
+                json!({
+                    "value": graphics.resolution_scale, "type": "integer", "writable": writable,
+                    "min": SCALE_MIN, "max": RESOLUTION_SCALE_MAX, "step": SLIDER_STEP,
+                    "requested": requested, "last_paired_submission": last_pair,
+                })
+            }
+            DYNAMIC => json!({
+                "value": graphics.dynamic_resolution, "type": "boolean", "writable": writable && trial,
+                "experimental_active": dynamic,
+            }),
+            TARGET => json!({
+                "value": graphics.target_fps, "type": "integer", "writable": writable && trial,
+                "min": TARGET_MIN, "max": TARGET_MAX, "step": SLIDER_STEP,
+            }),
+            _ => return None,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn preset_and_fixed_scale_apply_ui_values_and_reject_invalid_scale() {
+        let mut settings = Settings::default();
+        assert!(set(&mut settings, PRESET, "full_performance", false).unwrap());
+        assert_eq!(settings.render_distance, 6);
+        assert_eq!(settings.simulation_distance, 5);
+        assert_eq!(settings.horizon.resolution_scale, 75);
+        assert!(!settings.horizon.dynamic_resolution);
+        assert_eq!(settings.horizon.preset, Preset::FullPerformance);
+        for rejected in ["49", "76", "nan"] {
+            assert!(set(&mut settings, SCALE, rejected, false).is_err());
+            assert_eq!(settings.horizon.resolution_scale, 75);
+        }
+        for value in [100, 75, 50, 75] {
+            assert!(set(&mut settings, SCALE, &value.to_string(), false).unwrap());
+            assert_eq!(settings.horizon.resolution_scale, value);
+        }
+        assert_eq!(settings.horizon.preset, Preset::Custom);
+    }
+
+    #[test]
+    fn drs_changes_follow_trial_gate_and_slider_limits() {
+        let mut settings = Settings::default();
+        assert!(set(&mut settings, DYNAMIC, "true", false).is_err());
+        assert!(set(&mut settings, TARGET, "30", false).is_err());
+        assert!(!settings.horizon.dynamic_resolution);
+        assert_eq!(settings.horizon.target_fps, 60);
+        assert!(set(&mut settings, TARGET, "31", true).is_err());
+        assert!(set(&mut settings, DYNAMIC, "true", true).unwrap());
+        assert!(set(&mut settings, TARGET, "30", true).unwrap());
+        assert!(settings.horizon.dynamic_resolution);
+        assert_eq!(settings.horizon.target_fps, 30);
+    }
+}
