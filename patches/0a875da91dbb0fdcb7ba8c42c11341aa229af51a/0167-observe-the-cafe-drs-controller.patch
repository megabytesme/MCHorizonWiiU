+#[derive(Default)]
+pub(in crate::game) struct DrsDiagnostics {
+    sample: Option<DrsSample>,
+    transition: Option<(Instant, u32, u32)>,
+}
+
+struct DrsSample {
+    at: Instant,
+    target_fps: u32,
+    floor: u32,
+    timing: Result<f32, &'static str>,
+}
+
+impl DrsDiagnostics {
+    pub(super) fn record(
+        &mut self,
+        at: Instant,
+        floor: u32,
+        target_fps: u32,
+        timing: Result<f32, &'static str>,
+        transition: Option<(u32, u32)>,
+    ) {
+        if self
+            .sample
+            .as_ref()
+            .is_some_and(|sample| sample.floor != floor || sample.target_fps != target_fps)
+        {
+            self.transition = None;
+        }
+        self.sample = Some(DrsSample {
+            at,
+            target_fps,
+            floor,
+            timing,
+        });
+        if let Some((from, to)) = transition {
+            self.transition = Some((at, from, to));
+        }
+    }
+
+    pub(in crate::game) fn status(
+        &self,
+        now: Instant,
+        floor: u32,
+        target_fps: u32,
+        inactive_reason: Option<&str>,
+    ) -> (bool, serde_json::Value) {
+        let Some(sample) = self.sample.as_ref().filter(|sample| {
+            inactive_reason.is_none() && sample.floor == floor && sample.target_fps == target_fps
+        }) else {
+            return (
+                false,
+                serde_json::json!({"status": inactive_reason.unwrap_or("awaiting_sample")}),
+            );
+        };
+        let age = |at| now.saturating_duration_since(at).as_secs_f64() * 1000.0;
+        let (status, pipeline_ms) = match sample.timing {
+            Ok(ms) => ("accepted", Some(ms)),
+            Err(reason) => (reason, None),
+        };
+        let transition = self.transition.map(|(at, from, to)| {
+            serde_json::json!({
+                "from": from, "to": to, "age_ms": age(at),
+                "reason": if to > from { "gpu_headroom" } else { "gpu_over_budget" },
+            })
+        });
+        (
+            sample.timing.is_ok(),
+            serde_json::json!({
+                "status": status,
+                "sample_age_ms": age(sample.at),
+                "pipeline_ms": pipeline_ms,
+                "last_transition": transition,
+            }),
+        )
+    }
+}
