+    #[test]
+    fn drs_status_tracks_accepted_rejected_and_fixed_steps_without_reusing_old_targets() {
+        let start = Instant::now();
+        let ms = Duration::from_millis;
+        let mut drs = DrsDiagnostics::default();
+        assert_eq!(
+            drs.status(start, 75, 60, None).1["status"],
+            "awaiting_sample"
+        );
+
+        drs.record(start, 75, 60, Ok(8.0), Some((75, 85)));
+        let (available, status) = drs.status(start + ms(20), 75, 60, None);
+        assert!(available);
+        assert_eq!(status["pipeline_ms"], 8.0);
+        assert_eq!(status["sample_age_ms"], 20.0);
+        assert_eq!(status["last_transition"]["reason"], "gpu_headroom");
+        assert_eq!(status["last_transition"]["to"], 85);
+
+        drs.record(start + ms(25), 75, 60, Err("invalid_gpu_endpoints"), None);
+        let (available, status) = drs.status(start + ms(40), 75, 60, None);
+        assert!(!available);
+        assert_eq!(status["status"], "invalid_gpu_endpoints");
+        assert!(status["pipeline_ms"].is_null());
+        assert_eq!(status["last_transition"]["age_ms"], 40.0);
+
+        drs.record(start + ms(50), 75, 60, Ok(20.0), Some((85, 75)));
+        let (_, status) = drs.status(start + ms(60), 75, 60, None);
+        assert_eq!(status["last_transition"]["reason"], "gpu_over_budget");
+        assert_eq!(status["last_transition"]["from"], 85);
+
+        let (available, status) = drs.status(start + ms(65), 75, 60, Some("benchmark"));
+        assert!(!available);
+        assert_eq!(status, serde_json::json!({"status": "benchmark"}));
+        assert_eq!(
+            drs.status(start + ms(65), 75, 30, None).1["status"],
+            "awaiting_sample"
+        );
+        drs.record(start + ms(70), 75, 30, Ok(20.0), None);
+        let (available, status) = drs.status(start + ms(80), 75, 30, None);
+        assert!(available);
+        assert!(status["last_transition"].is_null());
+    }
+
+    #[test]
+    fn paired_resolution_reports_the_sample_used_by_the_trial_on_that_frame() {
+        let start = Instant::now();
+        let span = Duration::from_secs(2);
+        let totals = Totals::default();
+        let mut performance = CafePerformance::default();
+        let frame = CafeFrameWork {
+            presented: [true; 2],
+            world_resolution: Some(WorldResolution {
+                requested_scale: 75,
+                effective_scale: 75,
+                dimensions: [[1440, 810], [640, 360]],
+                surface_bytes: 0,
+            }),
+            ..Default::default()
+        };
+        performance.begin(Phase::Gameplay, start, totals);
+        for (index, accepted) in [true, false].into_iter().enumerate() {
+            let frame_start = start + span * index as u32;
+            let now = frame_start + span;
+            if accepted {
+                performance.drs.record(now, 75, 60, Ok(9.0), None);
+            }
+            assert!(performance.finish(
+                now,
+                frame_start,
+                totals,
+                true,
+                StepSpans::default(),
+                frame
+            ));
+            let snapshot = performance.latest.as_ref().unwrap().json(start, now);
+            assert_eq!(
+                snapshot["world_resolution"]["dynamic_timing_available"],
+                accepted
+            );
+            assert_eq!(snapshot["world_resolution"]["effective_scale"], 75);
+        }
