+/* Cafe has no canonicalize implementation or filesystem symlinks. Resolve a
+ * normalized relative root against the current directory, but reject other
+ * spellings rather than borrowing another root's resources. */
+#[cfg(any(target_os = "cafe", test))]
+fn cafe_cache_root(path: &Path, current: Option<&Path>) -> io::Result<PathBuf> {
+    let text = path
+        .to_str()
+        .filter(|text| !text.is_empty())
+        .ok_or_else(|| {
+            io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "cache root is empty or not UTF-8",
+            )
+        })?;
+    let absolute = if text.starts_with('/') {
+        text.to_owned()
+    } else {
+        let base = current.and_then(Path::to_str).ok_or_else(|| {
+            io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "cache root has no current directory",
+            )
+        })?;
+        format!("{}/{text}", base.trim_end_matches('/'))
+    };
+    let text = absolute.as_str();
+    if !text.starts_with('/') || text.len() <= 1 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "cache root is not absolute",
+        ));
+    }
+    if text[1..]
+        .split('/')
+        .any(|part| part.is_empty() || part == "." || part == "..")
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "cache root is not normalized",
+        ));
+    }
+    Ok(PathBuf::from(text))
+}
+
+fn cache_root(path: &Path) -> io::Result<PathBuf> {
+    #[cfg(target_os = "cafe")]
+    {
+        let current = if path.to_str().is_some_and(|text| text.starts_with('/')) {
+            None
+        } else {
+            Some(std::env::current_dir()?)
+        };
+        let root = cafe_cache_root(path, current.as_deref())?;
+        if !fs::metadata(&root)?.is_dir() {
+            return Err(io::Error::new(
+                io::ErrorKind::NotADirectory,
+                "cache root is not a directory",
+            ));
+        }
+        Ok(root)
+    }
+    #[cfg(not(target_os = "cafe"))]
+    {
+        fs::canonicalize(path)
+    }
+}
