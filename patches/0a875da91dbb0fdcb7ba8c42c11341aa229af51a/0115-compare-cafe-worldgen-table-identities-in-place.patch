+/// Compare ordinary exported rows in place. Decode nonmatching rows to
+/// preserve the NBT reader's handling of malformed strings and the different
+/// key order of UTF-16 and UTF-8 for some non-ASCII property names.
+fn matches_table_state(expected: Option<&BlockState>, row: &Tag) -> io::Result<bool> {
+    fn equals(text: &str, units: &horizon_core::nbt::JavaString) -> bool {
+        let bytes = text.as_bytes();
+        bytes.len() == units.0.len()
+            && bytes
+                .iter()
+                .zip(&units.0)
+                .all(|(&byte, &unit)| byte.is_ascii() && u16::from(byte) == unit)
+    }
+
+    fn matches(expected: &BlockState, row: &Tag) -> bool {
+        if let Tag::String(id) = row {
+            return expected.properties.is_empty() && equals(&expected.name, id);
+        }
+        let Some(Tag::String(id)) = row.get("id") else {
+            return false;
+        };
+        equals(&expected.name, id)
+            && match row.get("properties") {
+                None => expected.properties.is_empty(),
+                Some(Tag::Compound(properties)) => {
+                    properties.len() == expected.properties.len()
+                        && expected.properties.iter().zip(properties).all(
+                            |((name, value), (key, tag))| {
+                                equals(name, key)
+                                    && matches!(tag, Tag::String(text) if equals(value, text))
+                            },
+                        )
+                }
+                Some(_) => false,
+            }
+    }
+
+    if expected.is_some_and(|state| matches(state, row)) {
+        return Ok(true);
+    }
+    Ok(expected == Some(&BlockState::from_nbt(row)?))
+}
