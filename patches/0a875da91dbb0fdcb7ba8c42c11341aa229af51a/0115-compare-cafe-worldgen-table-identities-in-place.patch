+    #[test]
+    fn table_identity_check_keeps_valid_nbt_forms_and_rejects_invalid_rows() {
+        let air = BlockState::from_nbt(&state("minecraft:air", &[])).unwrap();
+        assert!(matches_table_state(Some(&air), &Tag::String("minecraft:air".into())).unwrap());
+        assert!(!matches_table_state(Some(&air), &Tag::String("minecraft:water".into())).unwrap());
+        assert!(matches_table_state(Some(&air), &Tag::String(JavaString(vec![0xd800]))).is_err());
+
+        let door = state("test:door", &[("facing", "east"), ("open", "false")]);
+        let expected = BlockState::from_nbt(&door).unwrap();
+        assert!(matches_table_state(Some(&expected), &door).unwrap());
+        let west = state("test:door", &[("facing", "west"), ("open", "false")]);
+        assert!(!matches_table_state(Some(&expected), &west).unwrap());
+
+        let unicode = state("test:unicode", &[("\u{10000}", "a"), ("\u{e000}", "b")]);
+        let expected = BlockState::from_nbt(&unicode).unwrap();
+        assert!(matches_table_state(Some(&expected), &unicode).unwrap());
+    }
