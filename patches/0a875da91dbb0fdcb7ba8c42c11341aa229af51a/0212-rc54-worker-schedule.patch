+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Foreground profile owner. Emit captured rows after the hosted game drops. */
+void horizon_worker_schedule_enable(bool enabled);
+void horizon_worker_schedule_report(void);
+
+/* Same worker thread at begin/end. A zero ticket starts no observation. */
+uint32_t horizon_worker_schedule_begin(uint32_t role, uint32_t worker);
+void horizon_worker_schedule_end(uint32_t ticket);
