diff --git a/wiiu/loading_host/worker_schedule.c b/wiiu/loading_host/worker_schedule.c
new file mode 100644
index 0000000000000000000000000000000000000000..434e2552c8b60d8657adad5933b3b7f5e96fa9b2
--- /dev/null
+++ b/wiiu/loading_host/worker_schedule.c
@@ -0,0 +1,92 @@
+#include "worker_schedule.h"
+
+#include <coreinit/core.h>
+#include <coreinit/debug.h>
+#include <coreinit/thread.h>
+#include <coreinit/time.h>
+#include <stdatomic.h>
+
+enum { ROLES = 5, WORKERS = 4, SAMPLES = 4, WORK_STRIDE = 64, CORE_COUNT = 3 };
+_Static_assert(ATOMIC_INT_LOCK_FREE == 2 && ATOMIC_BOOL_LOCK_FREE == 2,
+               "worker observations require lock-free state");
+
+typedef struct {
+   OSTime start, end;
+   uint32_t start_core, end_core, affinity;
+   int32_t base_priority;
+   atomic_bool complete;
+} Sample;
+
+typedef struct {
+   atomic_uint visits;
+   Sample samples[SAMPLES];
+} Lane;
+
+static atomic_bool enabled;
+static Lane lanes[ROLES][WORKERS];
+
+void horizon_worker_schedule_enable(bool active)
+{
+   if (active != atomic_load_explicit(&enabled, memory_order_relaxed))
+      atomic_store_explicit(&enabled, active, memory_order_relaxed);
+}
+
+uint32_t horizon_worker_schedule_begin(uint32_t role, uint32_t worker)
+{
+   if (!atomic_load_explicit(&enabled, memory_order_relaxed) ||
+       role >= ROLES || worker >= WORKERS)
+      return 0;
+
+   // The two save roles are intermittent. Sample their first few batches.
+   const uint32_t stride = role >= 3 ? 1 : WORK_STRIDE;
+   Lane *lane = &lanes[role][worker];
+   unsigned seen = atomic_load_explicit(&lane->visits, memory_order_relaxed);
+   do {
+      if (seen >= SAMPLES * stride) return 0;
+   } while (!atomic_compare_exchange_weak_explicit(&lane->visits, &seen, seen + 1,
+                                                  memory_order_relaxed, memory_order_relaxed));
+   if (seen % stride != 0) return 0;
+
+   OSThread *self = OSGetCurrentThread();
+   if (!self) return 0;
+   const uint32_t index = seen / stride;
+   Sample *sample = &lane->samples[index];
+   sample->affinity = OSGetThreadAffinity(self);
+   sample->base_priority = OSGetThreadPriority(self);
+   sample->start_core = OSGetCoreId();
+   sample->start = OSGetSystemTime();
+   return 1 + (role * WORKERS + worker) * SAMPLES + index;
+}
+
+void horizon_worker_schedule_end(uint32_t ticket)
+{
+   if (!ticket || ticket > ROLES * WORKERS * SAMPLES) return;
+   const uint32_t index = ticket - 1;
+   const uint32_t lane = index / SAMPLES;
+   Sample *sample = &lanes[lane / WORKERS][lane % WORKERS].samples[index % SAMPLES];
+   sample->end = OSGetSystemTime();
+   sample->end_core = OSGetCoreId();
+   atomic_store_explicit(&sample->complete, true, memory_order_release);
+}
+
+void horizon_worker_schedule_report(void)
+{
+   static const char *const names[ROLES] = {
+      "stream", "mesh", "integrated-tick", "proto-save", "region-write"
+   };
+   for (uint32_t role = 0; role < ROLES; ++role) {
+      for (uint32_t worker = 0; worker < WORKERS; ++worker) {
+         for (uint32_t index = 0; index < SAMPLES; ++index) {
+            Sample *sample = &lanes[role][worker].samples[index];
+            if (!atomic_exchange_explicit(&sample->complete, false, memory_order_acquire)) continue;
+            if (sample->start_core >= CORE_COUNT || sample->end_core >= CORE_COUNT ||
+                sample->start < 0 || sample->end < sample->start)
+               continue;
+            OSReport("Horizon Cafe worker schedule role=%s pool_index=%u sample=%u core_start=%u core_end=%u allowed_mask=%u base_priority=%d wall_ticks=%llu cpu_time=unavailable\n",
+                     names[role], worker, index, sample->start_core, sample->end_core,
+                     sample->affinity, sample->base_priority,
+                     (unsigned long long)(sample->end - sample->start));
+         }
+      }
+   }
+}
