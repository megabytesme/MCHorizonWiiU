+/// Roles in the separate marker-only scheduler observation. Order matches C.
+#[repr(u32)]
+#[derive(Clone, Copy)]
+pub enum ScheduleRole {
+    Streaming,
+    Mesh,
+    IntegratedTick,
+    ProtoSave,
+    RegionWrite,
+}
+
+/// Captures boundary cores and wall ticks on the worker that owns this guard.
+pub struct Schedule(u32, PhantomData<*mut ()>);
+
+impl Schedule {
+    pub fn new(role: ScheduleRole, pool_index: usize) -> Self {
+        let ticket = u32::try_from(pool_index).ok().map_or(0, |index| {
+            unsafe { horizon_worker_schedule_begin(role as u32, index) }
+        });
+        Self(ticket, PhantomData)
+    }
+}
+
+impl Drop for Schedule {
+    fn drop(&mut self) {
+        if self.0 != 0 {
+            unsafe { horizon_worker_schedule_end(self.0) };
+        }
+    }
+}
+
