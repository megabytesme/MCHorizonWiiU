+static bool marker_end(FILE *file, int next)
+{
+   const bool ended = next == EOF || (next == '\n' && fgetc(file) == EOF) ||
+      (next == '\r' && fgetc(file) == '\n' && fgetc(file) == EOF);
+   return ended && !ferror(file);
+}
+
+static void init_tv_terrain_wait_trial(void)
+{
+   FILE *marker = fopen(ROOT "gx2-tv-terrain-wait.enable", "rb");
+   if (!marker) return;
+   const int mode = fgetc(marker), tail = fgetc(marker);
+   if ((mode == '0' || mode == '1') && marker_end(marker, tail)) {
+      tv_terrain_wait_mode = mode == '0' ? 1 : 2;
+      OSReport("Horizon GX2 TV terrain wait trial: %s\n",
+               mode == '0' ? "forced slow" : "verified skip");
+   }
+   fclose(marker);
+}
+
+uint32_t horizon_gx2_profile_tv_terrain_wait(bool playing_only)
+{
+   if (playing_only && (history != &process_history || !recording || current.phase != PLAYING_PHASE))
+      return 0;
+   return tv_terrain_wait_mode;
+}
+
 void horizon_gx2_profile_init(void)
 {
    FILE *marker = fopen(ROOT "gx2-profile.enable", "rb");
    if (!marker) return;
    marker_mode = fgetc(marker);
    marker_variant = marker_mode == '4' ? fgetc(marker) : EOF;
+   const bool plain_profile = marker_mode == '4' && marker_end(marker, marker_variant);
    fclose(marker);
    marker_enabled = true;
    select_mode(marker_mode, marker_variant);
+   if (plain_profile) init_tv_terrain_wait_trial();
    process_history.epoch = (uint64_t)OSGetSystemTime();
    atomic_store_explicit(&enabled, true, memory_order_release);
    OSReport("Horizon GX2 capture enabled, clock_hz=%u\n", OSTimerClockSpeed);
