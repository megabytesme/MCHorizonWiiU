+/// Status messages from the built-in benchmark driver to the Cafe host.
+pub enum Progress {
+    LoadingWorld,
+    LoadingScene(String),
+    MeasuringScene(String),
+    Holding,
+}
+
+#[cfg(any(target_os = "cafe", test))]
+pub struct HostedRun {
+    progress: mpsc::Receiver<Progress>,
+    completed: mpsc::Receiver<Result<PathBuf, String>>,
+    cancelled: std::sync::Arc<std::sync::atomic::AtomicBool>,
+    worker: Option<thread::JoinHandle<()>>,
+}
+
+#[cfg(any(target_os = "cafe", test))]
+impl HostedRun {
+    pub fn start(requests: Sender<Request>, setup: Setup) -> std::io::Result<Self> {
+        let (result, completed) = mpsc::sync_channel(1);
+        let (progress_tx, progress) = mpsc::channel();
+        let cancelled = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let control = Control {
+            requests,
+            progress: Some(progress_tx),
+            cancelled: Some(cancelled.clone()),
+        };
+        let worker = thread::Builder::new()
+            .name("horizon-benchmark".into())
+            .spawn(move || {
+                let _ = result.send(run(&control, setup));
+            })?;
+        Ok(Self {
+            completed,
+            progress,
+            cancelled,
+            worker: Some(worker),
+        })
+    }
+
+    pub fn progress(&self) -> Option<Progress> {
+        self.progress.try_iter().last()
+    }
+
+    pub fn completed(&self) -> Option<Result<PathBuf, String>> {
+        match self.completed.try_recv() {
+            Ok(result) => Some(result),
+            Err(mpsc::TryRecvError::Empty) => None,
+            Err(mpsc::TryRecvError::Disconnected) => Some(Err("benchmark worker stopped".into())),
+        }
+    }
+}
+
+#[cfg(any(target_os = "cafe", test))]
+impl Drop for HostedRun {
+    fn drop(&mut self) {
+        self.cancelled
+            .store(true, std::sync::atomic::Ordering::Relaxed);
+        if let Some(worker) = self.worker.take() {
+            let _ = worker.join();
+        }
+    }
+}
