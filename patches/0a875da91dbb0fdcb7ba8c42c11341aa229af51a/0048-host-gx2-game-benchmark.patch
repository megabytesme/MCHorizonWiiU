+fn publish_benchmark(path: &Path, reports: &Path) -> std::io::Result<()> {
+    use std::fs;
+    use std::io::{Error, ErrorKind};
+
+    match fs::create_dir(reports) {
+        Ok(()) => {}
+        Err(error)
+            if error.kind() == ErrorKind::AlreadyExists
+                && fs::symlink_metadata(reports).is_ok_and(|metadata| metadata.is_dir()) => {}
+        Err(error) => return Err(error),
+    }
+    let name = path
+        .file_name()
+        .ok_or_else(|| Error::new(ErrorKind::InvalidInput, "missing report name"))?;
+    let destination = reports.join(name);
+    if fs::symlink_metadata(&destination).is_ok() {
+        return Err(Error::new(
+            ErrorKind::AlreadyExists,
+            "report already exists",
+        ));
+    }
+    fs::rename(path, destination)
+}
