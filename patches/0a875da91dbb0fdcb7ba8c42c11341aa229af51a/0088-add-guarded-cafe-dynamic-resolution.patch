+/// The Wii U experiment uses the hosted profiling mode that records GPU endpoints.
+#[cfg(target_os = "cafe")]
+pub fn cafe_dynamic_resolution_trial() -> bool {
+    use std::io::Read;
+
+    static AVAILABLE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *AVAILABLE.get_or_init(|| {
+        let root = Path::new("/vol/external01/wiiu/apps/HorizonWiiU");
+        if !root.join("gx2-drs-experimental.enable").is_file() {
+            return false;
+        }
+        let mut mode = [0];
+        fs::File::open(root.join("gx2-profile.enable"))
+            .and_then(|mut marker| marker.read_exact(&mut mode))
+            .is_ok()
+            && mode == [b'4']
+    })
+}
