@@ -87,6 +87,39 @@ pub struct CafeFrameWork {
     pub world_resolution: Option<WorldResolution>,
 }
 
+impl CafeFrameWork {
+    /// The paired bracket can include pipeline idle time. Only the opt-in trial
+    /// uses it, and CPU work outside native submission must fit in the budget.
+    pub(super) fn drs_pipeline_ms(
+        &self,
+        frame_ms: f32,
+        cpu_floor: Duration,
+        target_fps: u32,
+    ) -> Option<f32> {
+        let sample = self.gpu_sample?;
+        let resolution = self.world_resolution?;
+        let [[tv_top, tv_bottom], [pad_top, pad_bottom]] = sample.endpoints;
+        let target_ms = 1000.0 / target_fps.max(1) as f32;
+        if sample.status != 1
+            || sample.submitted == 0
+            || sample.retired < sample.submitted
+            || self.presented != [true; 2]
+            || self.terrain_sections.contains(&0)
+            || resolution.requested_scale != resolution.effective_scale
+            || tv_top == 0
+            || tv_top >= tv_bottom
+            || tv_bottom > pad_top
+            || pad_top >= pad_bottom
+            || pad_bottom == u64::MAX
+            || cpu_floor.as_secs_f32() * 1000.0 >= target_ms
+        {
+            return None;
+        }
+        let pipeline_ms = (pad_bottom - tv_top) as f32 * 1000.0 / GX2_GPU_HZ as f32;
+        (pipeline_ms <= frame_ms).then_some(pipeline_ms)
+    }
+}
