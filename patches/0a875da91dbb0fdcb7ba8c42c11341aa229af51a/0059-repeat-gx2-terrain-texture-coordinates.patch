+                                        uint32_t columns, uint32_t cell_size)
+{
+   if (!t || !columns || cell_size <= 2) return -1;
+   const GX2Surface *surface = &t->texture.surface;
+   if ((uint64_t)columns * cell_size != surface->width || surface->height % cell_size) return -1;
+   t->atlas_grid[0] = (float)columns;
+   t->atlas_grid[1] = (float)cell_size;
+   t->atlas_grid[2] = 1.0f / (float)columns;
+   t->atlas_grid[3] = 1.0f;
+   return 0;
