+/* Only the foreground host changes generations. A sampled server iteration
+ * can read the active generation without touching host frame history. */
+static void server_pump_set_active(bool active)
+{
+   if (!server_pump_requested) return;
+   const uint32_t previous = atomic_load_explicit(&server_pump_generation, memory_order_relaxed);
+   if (!active && previous)
+      atomic_store_explicit(&server_pump_generation, 0, memory_order_release);
+   else if (active && !previous && server_pump_next_generation != UINT32_MAX)
+      atomic_store_explicit(&server_pump_generation, ++server_pump_next_generation, memory_order_release);
+}
+
+void horizon_gx2_profile_server_pump_scope(bool ordinary_focused)
+{
+   if (!server_pump_requested) return;
+   server_pump_ordinary_focused = ordinary_focused;
+   if (!ordinary_focused) server_pump_set_active(false);
+}
+
+uint32_t horizon_gx2_profile_server_pump_generation(void)
+{
+   return atomic_load_explicit(&server_pump_generation, memory_order_relaxed);
+}
+
+uint64_t horizon_gx2_profile_server_pump_clock(void)
+{
+   return (uint64_t)OSGetSystemTime();
+}
+
+void horizon_gx2_profile_server_pump_report(uint32_t generation, uint32_t samples,
+                                            const uint64_t ticks[6])
+{
+   if (!generation || !samples ||
+       generation != atomic_load_explicit(&server_pump_generation, memory_order_acquire)) return;
+   /* The process epoch is initialized before the first enabled generation
+    * and remains immutable across hosted sessions. */
+   const uint64_t epoch = process_history.epoch;
+   if (ticks[0] < epoch || ticks[1] < ticks[0]) return;
+   OSReport("Horizon Cafe server pump wall generation=%u samples=%u clock_hz=%u first_ticks=%llu last_ticks=%llu wait_ticks=%llu update_ticks=%llu wait_max_ticks=%llu update_max_ticks=%llu\n",
+            generation, samples, OSTimerClockSpeed, (unsigned long long)(ticks[0] - epoch),
+            (unsigned long long)(ticks[1] - epoch), (unsigned long long)ticks[2],
+            (unsigned long long)ticks[3], (unsigned long long)ticks[4], (unsigned long long)ticks[5]);
+}
+
