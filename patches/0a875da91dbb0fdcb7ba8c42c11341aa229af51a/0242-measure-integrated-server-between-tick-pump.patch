+//! Sparse integrated-server wall timing for the between-tick chunk pump.
+const SAMPLE_EVERY: u8 = 8;
+const WINDOW_SAMPLES: u32 = 32;
+const MAX_WINDOWS: u8 = 8;
+
+unsafe extern "C" {
+    fn horizon_gx2_profile_server_pump_generation() -> u32;
+    fn horizon_gx2_profile_server_pump_clock() -> u64;
+    fn horizon_gx2_profile_server_pump_report(generation: u32, samples: u32, ticks: *const u64);
+}
+
+fn generation() -> u32 {
+    unsafe { horizon_gx2_profile_server_pump_generation() }
+}
+
+fn clock() -> u64 {
+    unsafe { horizon_gx2_profile_server_pump_clock() }
+}
+
+/// Owned by one integrated tick loop. Sampling never keeps a job or world data.
+#[derive(Default)]
+pub struct ServerPumpProfile {
+    generation: u32,
+    until_sample: u8,
+    windows: u8,
+    window: Window,
+}
+
+#[derive(Default)]
+struct Window {
+    samples: u32,
+    first: u64,
+    wait_sum: u64,
+    update_sum: u64,
+    wait_max: u64,
+    update_max: u64,
+}
+
+pub struct PumpSample {
+    generation: u32,
+    start: u64,
+    wait_end: Option<u64>,
+}
+
+impl ServerPumpProfile {
+    pub fn begin(&mut self) -> Option<PumpSample> {
+        let active = generation();
+        if active == 0 {
+            return None;
+        }
+        if active != self.generation {
+            *self = Self {
+                generation: active,
+                until_sample: SAMPLE_EVERY,
+                ..Self::default()
+            };
+        }
+        if self.windows == MAX_WINDOWS {
+            return None;
+        }
+        self.until_sample -= 1;
+        if self.until_sample != 0 {
+            return None;
+        }
+        self.until_sample = SAMPLE_EVERY;
+        Some(PumpSample {
+            generation: active,
+            start: clock(),
+            wait_end: None,
+        })
+    }
+
+    pub fn finish(&mut self, sample: PumpSample) {
+        let Some(wait_end) = sample.wait_end else {
+            return;
+        };
+        if sample.generation != self.generation || sample.generation != generation() {
+            return;
+        }
+        let end = clock();
+        let (Some(wait), Some(update)) = (
+            wait_end.checked_sub(sample.start),
+            end.checked_sub(wait_end),
+        ) else {
+            return;
+        };
+        let window = &mut self.window;
+        if window.samples == 0 {
+            window.first = sample.start;
+        }
+        window.samples += 1;
+        window.wait_sum = window.wait_sum.saturating_add(wait);
+        window.update_sum = window.update_sum.saturating_add(update);
+        window.wait_max = window.wait_max.max(wait);
+        window.update_max = window.update_max.max(update);
+        if window.samples == WINDOW_SAMPLES {
+            let ticks = [
+                window.first,
+                end,
+                window.wait_sum,
+                window.update_sum,
+                window.wait_max,
+                window.update_max,
+            ];
+            unsafe {
+                horizon_gx2_profile_server_pump_report(
+                    self.generation,
+                    window.samples,
+                    ticks.as_ptr(),
+                );
+            }
+            self.windows += 1;
+            *window = Window::default();
+        }
+    }
+}
+
+impl PumpSample {
+    pub fn wait_finished(&mut self) {
+        if self.generation == generation() {
+            self.wait_end = Some(clock());
+        }
+    }
+}
