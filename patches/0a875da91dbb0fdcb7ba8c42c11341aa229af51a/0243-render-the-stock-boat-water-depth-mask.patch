+static bool prepare_water_mask(HorizonGx2Hand *hand)
+{
+   WHBGfxShaderGroup *shader = &hand->water_mask;
+   if (!WHBGfxLoadGFDShaderGroup(shader, 0, _binary_water_mask_gsh_start)) return false;
+   GX2VertexShader *vs = shader->vertexShader;
+   GX2PixelShader *ps = shader->pixelShader;
+   if (!vs || !ps || vs->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       ps->mode != GX2_SHADER_MODE_UNIFORM_REGISTER) goto fail;
+
+   const char *names[] = {"uClipX", "uClipY", "uClipZ", "uClipW"};
+   for (unsigned row = 0; row < 4; ++row)
+      if (!uniform_offset(GX2GetVertexUniformVar(vs, names[row]), &hand->water_mask_clip[row]))
+         goto fail;
+   if (!WHBGfxInitShaderAttribute(shader, "aPosition", 0, offsetof(HandVertex, position_light),
+                                   GX2_ATTRIB_FORMAT_FLOAT_32_32_32) ||
+       !WHBGfxInitFetchShader(shader)) goto fail;
+   return true;
+
+fail:
+   WHBGfxFreeShaderGroup(shader);
+   memset(shader, 0, sizeof(*shader));
+   return false;
+}
+
+int horizon_gx2_draw_water_mask(HorizonGx2Hand *hand, uint32_t target, const uint32_t rect[4],
+                               HorizonGx2Terrain *terrain, const HandVertex *vertices,
+                               uint32_t count, const float clip_rows[16])
+{
+   if (!hand || target > 1 || !rect || !rect[2] || !rect[3] || !terrain ||
+       !vertices || !count || count % 4 || count > WORLD_MAX_VERTICES || !clip_rows) return -1;
+   if (!hand->water_mask.vertexShader && !prepare_water_mask(hand)) return -3;
+   GX2RBuffer *buffer;
+   const int result = prepare_vertices(hand, target, WATER_MASK_PASS, vertices, count, 0,
+                                       WORLD_MAX_VERTICES, &buffer);
+   if (result) return result;
+
+   WHBGfxShaderGroup *shader = &hand->water_mask;
+   GX2SetViewport(rect[0], rect[1], rect[2], rect[3], 0, 1);
+   GX2SetScissor(rect[0], rect[1], rect[2], rect[3]);
+   GX2SetShaderMode(shader->vertexShader->mode);
+   GX2SetFetchShader(&shader->fetchShader);
+   GX2SetVertexShader(shader->vertexShader);
+   GX2SetPixelShader(shader->pixelShader);
+   for (unsigned row = 0; row < 4; ++row)
+      GX2SetVertexUniformReg(hand->water_mask_clip[row], 4, clip_rows + 4 * row);
+   GX2RSetAttributeBuffer(buffer, 0, sizeof(HandVertex), 0);
+   GX2SetCullOnlyControl(GX2_FRONT_FACE_CCW, FALSE, FALSE);
+   GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+   GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0.0f);
+   GX2SetDepthOnlyControl(TRUE, TRUE, GX2_COMPARE_FUNC_LEQUAL);
+   GX2SetTargetChannelMasks((GX2ChannelMask)0, (GX2ChannelMask)0, (GX2ChannelMask)0,
+                            (GX2ChannelMask)0, (GX2ChannelMask)0, (GX2ChannelMask)0,
+                            (GX2ChannelMask)0, (GX2ChannelMask)0);
+   horizon_gx2_terrain_draw_quads(terrain, count);
+   GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, (GX2ChannelMask)0, (GX2ChannelMask)0,
+                            (GX2ChannelMask)0, (GX2ChannelMask)0, (GX2ChannelMask)0,
+                            (GX2ChannelMask)0, (GX2ChannelMask)0);
+   return 0;
+}
