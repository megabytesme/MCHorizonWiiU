+/// Resolved, generation-local feature constructor inputs. Runtime execution
+/// state and per-biome/decoration choices stay with their original owners.
+pub(in crate::worldgen) struct PreparedFeatureInputs {
+    pub(in crate::worldgen) tags: super::super::tags::TagDefinitions,
+    pub(in crate::worldgen) catalog: super::super::feature_catalog::FeatureCatalog,
+    pub(in crate::worldgen) bindings: super::super::block_feature::FeatureBlockBindings<'static>,
+}
+
+/// Share only while construction or a consumer needs this generation's inputs.
+#[derive(Default)]
+struct FeaturePreparation(std::sync::Mutex<std::sync::Weak<PreparedFeatureInputs>>);
+impl FeaturePreparation {
+    fn get(
+        &self,
+        build: impl FnOnce() -> Result<PreparedFeatureInputs, GeneratorError>,
+    ) -> Result<Arc<PreparedFeatureInputs>, GeneratorError> {
+        let mut slot = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(prepared) = slot.upgrade() {
+            return Ok(prepared);
+        }
+        let prepared = Arc::new(build()?);
+        *slot = Arc::downgrade(&prepared);
+        Ok(prepared)
+    }
+}
