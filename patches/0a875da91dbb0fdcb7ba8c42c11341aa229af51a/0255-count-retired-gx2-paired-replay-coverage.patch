+    #[test]
+    fn counts_only_retired_complete_pairs_and_resumes_across_mesh_changes() {
+        let mut trial = Trial::default();
+        let mut uses = Uses::default();
+        let mut incomplete = Frame::new(49, &raw mut uses);
+        incomplete.called = [true; 2];
+        incomplete.warm = [true; 2];
+        assert!(trial.finish(Some(incomplete), false, [4, 4]).is_none());
+        for sequence in 50..169 {
+            let mut frame = Frame::new(sequence, &raw mut uses);
+            match sequence {
+                51 => frame.called = [true, false],
+                52 => {
+                    frame.called = [true; 2];
+                    frame.warm = [true, false];
+                }
+                _ => {}
+            }
+            assert!(trial.finish(Some(frame), true, [100, 174]).is_none());
+            if sequence == 100 {
+                trial.invalidate();
+            }
+        }
+        let mut final_frame = Frame::new(169, &raw mut uses);
+        final_frame.called = [true; 2];
+        final_frame.warm = [true; 2];
+        let row = trial.finish(Some(final_frame), true, [174, 100]).unwrap();
+        assert_eq!((row.first, row.last), (50, 169));
+        assert_eq!((row.cold, row.warm, row.warm_both), ([1, 1], [2, 1], 1));
+        assert_eq!((row.min_sections, row.max_sections), ([100, 100], [174, 174]));
+    }
+
+    #[test]
+    fn treats_sequence_wrap_and_holes_as_new_windows_and_caps_reports() {
+        let mut observation = ReplayObservation::default();
+        let mut uses = Uses::default();
+        for sequence in [u32::MAX - 1, u32::MAX, 0, 1, 4] {
+            assert!(observation.complete_pair(&Frame::new(sequence, &raw mut uses), [3; 2]).is_none());
+        }
+        assert_eq!(observation.window.unwrap().first, 4);
+        for sequence in 5..(4 + PAIRS_PER_WINDOW * MAX_WINDOWS) {
+            observation.complete_pair(&Frame::new(sequence, &raw mut uses), [3; 2]);
+        }
+        assert_eq!(observation.reported, MAX_WINDOWS);
+        assert!(observation.complete_pair(&Frame::new(8000, &raw mut uses), [3; 2]).is_none());
+        assert!(observation.window.is_none());
+    }
