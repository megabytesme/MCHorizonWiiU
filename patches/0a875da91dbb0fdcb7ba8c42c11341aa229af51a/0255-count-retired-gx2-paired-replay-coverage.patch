+const PAIRS_PER_WINDOW: u32 = 120;
+const MAX_WINDOWS: u32 = 64;
+
+#[derive(Clone, Copy)]
+pub(super) struct Report {
+    pub(super) first: u32,
+    pub(super) last: u32,
+    pub(super) cold: [u32; 2],
+    pub(super) warm: [u32; 2],
+    pub(super) warm_both: u32,
+    pub(super) min_sections: [u32; 2],
+    pub(super) max_sections: [u32; 2],
+}
+
+#[derive(Default)]
+struct ReplayObservation {
+    window: Option<Report>,
+    reported: u32,
+}
+
+impl ReplayObservation {
+    fn complete_pair(&mut self, frame: &Frame, sections: [u32; 2]) -> Option<Report> {
+        if self.reported >= MAX_WINDOWS {
+            return None;
+        }
+        let sequence = frame.sequence;
+        if self.window.is_some_and(|window| window.last.checked_add(1) != Some(sequence)) {
+            self.window = None;
+        }
+        let report = self.window.get_or_insert(Report {
+            first: sequence,
+            last: sequence,
+            cold: [0; 2],
+            warm: [0; 2],
+            warm_both: 0,
+            min_sections: sections,
+            max_sections: sections,
+        });
+        report.last = sequence;
+        for (output, count) in sections.into_iter().enumerate() {
+            report.cold[output] += u32::from(frame.called[output] && !frame.warm[output]);
+            report.warm[output] += u32::from(frame.warm[output]);
+            report.min_sections[output] = report.min_sections[output].min(count);
+            report.max_sections[output] = report.max_sections[output].max(count);
+        }
+        report.warm_both += u32::from(frame.warm == [true; 2]);
+        if sequence - report.first == PAIRS_PER_WINDOW - 1 {
+            self.reported += 1;
+            return self.window.take();
+        }
+        None
+    }
+}
