+/// A local-space bound measured from the actual retained mesh. Block models
+/// can extend beyond the nominal coordinates of their 16-block section.
+#[derive(Clone, Copy, Debug)]
+pub struct TerrainBounds {
+    min: [f32; 3],
+    max: [f32; 3],
+}
+
+impl TerrainBounds {
+    pub fn from_vertices(vertices: &[TerrainVertex]) -> Option<Self> {
+        let first = vertices.first()?.pos;
+        let mut bounds = Self { min: first, max: first };
+        for vertex in vertices {
+            for (axis, position) in vertex.pos.into_iter().enumerate() {
+                if !position.is_finite() {
+                    return None;
+                }
+                bounds.min[axis] = bounds.min[axis].min(position);
+                bounds.max[axis] = bounds.max[axis].max(position);
+            }
+        }
+        Some(bounds)
+    }
+}
