 impl TerrainClipRows {
+    /// Conservatively reject a bound wholly outside a homogeneous clip plane.
+    /// Use the same affine rows as the shader, including the output aspect and
+    /// the camera pose. The wider -W near plane is safe for forward-Z cameras
+    /// with a zero-based depth range.
+    pub fn may_intersect(&self, bounds: TerrainBounds) -> bool {
+        let [x, y, z, w] = self.rows;
+        for (axis, sign) in [(x, 1.0), (x, -1.0), (y, 1.0), (y, -1.0), (z, 1.0), (z, -1.0)] {
+            let mut maximum = w[3] + sign * axis[3];
+            let mut error = w[3].abs() + axis[3].abs();
+            for i in 0..3 {
+                let coefficient = w[i] + sign * axis[i];
+                let support = if coefficient < 0.0 { bounds.min[i] } else { bounds.max[i] };
+                maximum += coefficient * support;
+                error += (w[i].abs() + axis[i].abs()) * bounds.min[i].abs().max(bounds.max[i].abs());
+            }
+            // Bound the f32 dot product rounding on both CPU and shader.
+            // Unordered/non-finite values fall through to submission.
+            if maximum.is_finite() && maximum < -8.0 * f32::EPSILON * error.max(1.0) {
+                return false;
+            }
+        }
+        true
+    }
