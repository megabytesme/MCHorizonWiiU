+#[test]
+fn replacement_installer_receipt_and_cancel_evict_the_previous_slot() -> crate::Result<()> {
+    const FONT: &str = "assets/minecraft/font/default.json";
+    let temp = tempfile::tempdir()?;
+    let root = temp.path().join("resources");
+    let receipt = temp.path().join("installed-stock.json");
+    fs::create_dir_all(root.join(FONT).parent().unwrap())?;
+    fs::write(root.join("horizon-resources.json"), b"{}")?;
+    let cancel = AtomicBool::new(false);
+    let open = || InstalledStockAssets::reopen(&root, &receipt, &cancel);
+    let publish = |advance| -> crate::Result<String> {
+        fs::write(
+            root.join(FONT),
+            format!(r#"{{"providers":[{{"type":"space","advances":{{"A":{advance}}}}}]}}"#),
+        )?;
+        horizon_core::prepared_files::write(&root)?;
+        let bytes = fs::read(root.join(horizon_core::prepared_files::FILE_NAME))?;
+        Ok(format!("{:x}", Sha256::digest(bytes)))
+    };
+    assert!(open()?.is_none());
+    let first = publish(2)?;
+    fs::write(&receipt, serde_json::to_vec(&asset_receipt(&root, &first))?)?;
+    let old = open()?.ok_or("first receipt open failed")?;
+    let mut cold = HudAtlas::build(old.assets())?;
+    assert_eq!(cold.font.glyph('A').advance, 2.0);
+    let mut slot = StockHudSlot::default();
+    let old_panorama = old.load_panorama();
+    assert!(
+        slot.capture(&mut cold, &old, &old_panorama, &cancel)
+            .is_some()
+    );
+    let old_size = fs::metadata(root.join(horizon_core::prepared_files::FILE_NAME))?.len();
+    let second = publish(4)?;
+    assert_eq!(
+        old_size,
+        fs::metadata(root.join(horizon_core::prepared_files::FILE_NAME))?.len()
+    );
+    assert_ne!(first, second);
+    assert!(open().is_err());
+    fs::write(
+        &receipt,
+        serde_json::to_vec(&asset_receipt(&root, &second))?,
+    )?;
+    let new = open()?.ok_or("second receipt open failed")?;
+    assert!(slot.prepare(Some(new), &cancel).is_none());
+    assert!(slot.0.is_none());
+    assert_eq!(cold.font.glyph('A').advance, 2.0);
+
+    let new = open()?.unwrap();
+    let mut new_atlas = HudAtlas::build(new.assets())?;
+    assert_eq!(new_atlas.font.glyph('A').advance, 4.0);
+    assert!(
+        slot.capture(&mut new_atlas, &new, &old_panorama, &cancel)
+            .is_none()
+    );
+    let new_panorama = new.load_panorama();
+    assert!(
+        slot.capture(&mut new_atlas, &new, &new_panorama, &cancel)
+            .is_some()
+    );
+    cancel.store(true, Ordering::Release);
+    assert!(slot.prepare(open()?, &cancel).is_none());
+    assert!(slot.0.is_none());
+    cancel.store(false, Ordering::Release);
+    fs::remove_file(&receipt)?;
+    assert!(open()?.is_none());
+    fs::write(&receipt, vec![0; RECEIPT_CAP as usize + 1])?;
+    assert!(open().is_err());
+    Ok(())
+}
