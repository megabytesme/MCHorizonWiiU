@@ -0,0 +1,461 @@
+//! Opt-in stock HUD preparation. Night can retain one source-free seed.
+
+use super::{HudAtlas, Rect, TextureFlags, atlas_entity_variants, pictures, sprite_modifiers};
+use crate::{
+    cafe_pixels::PackedPixels,
+    font::Font,
+    gfx::panorama::{Faces, VerifiedFaceLayout},
+    resource_source::ResourceSource,
+    sprites,
+};
+use std::{
+    collections::HashMap,
+    fs::File,
+    io::{self, Read},
+    mem::size_of,
+    path::Path,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+    },
+};
+
+const SLOT_CAP: usize = 16 * 1024 * 1024;
+const RECEIPT_CAP: u64 = 16 * 1024;
+
+/// Constructed from the trusted installer's receipt and a fresh archive open.
+/// The caller selects the installer-owned receipt path, outside user packs.
+pub struct InstalledStockAssets(ResourceSource);
+
+#[derive(serde::Deserialize)]
+struct Receipt {
+    archive_version: u32,
+    archive_sha256: String,
+    guest_root: String,
+}
+
+impl InstalledStockAssets {
+    pub fn reopen(
+        resource_root: &Path,
+        installed_receipt: &Path,
+        cancel: &AtomicBool,
+    ) -> io::Result<Option<Self>> {
+        if cancel.load(Ordering::Acquire) || std::env::var_os("HORIZON_NO_DATA_FILE").is_some() {
+            return Ok(None);
+        }
+        let file = match File::open(installed_receipt) {
+            Ok(file) => file,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+            Err(error) => return Err(error),
+        };
+        let mut bytes = Vec::new();
+        file.take(RECEIPT_CAP + 1).read_to_end(&mut bytes)?;
+        let malformed = || {
+            io::Error::new(
+                io::ErrorKind::InvalidData,
+                "invalid installed stock archive receipt",
+            )
+        };
+        if bytes.len() as u64 > RECEIPT_CAP {
+            return Err(malformed());
+        }
+        let receipt: Receipt = serde_json::from_slice(&bytes).map_err(|_| malformed())?;
+        let text = receipt.archive_sha256.as_bytes();
+        if receipt.archive_version != 2
+            || !resource_root.is_absolute()
+            || resource_root.to_str() != Some(receipt.guest_root.as_str())
+            || text.len() != 64
+            || !text.iter().all(u8::is_ascii_hexdigit)
+        {
+            return Err(malformed());
+        }
+        let mut expected = [0; 32];
+        for (i, slot) in expected.iter_mut().enumerate() {
+            *slot = u8::from_str_radix(&receipt.archive_sha256[2 * i..2 * i + 2], 16)
+                .map_err(|_| malformed())?;
+        }
+        ResourceSource::reopen_verified_assets(resource_root, expected, cancel)
+            .map(|source| source.map(Self))
+    }
+
+    pub fn assets(&self) -> &ResourceSource {
+        &self.0
+    }
+
+    pub fn load_panorama(&self) -> InstalledStockPanorama {
+        InstalledStockPanorama {
+            generation: self
+                .0
+                .verified_assets_generation()
+                .expect("installed assets are verified"),
+            faces: Arc::new(Faces::load(&self.0, &self.0)),
+        }
+    }
+}
+
+/// The decoded and validated cold title art, branded to the verified source.
+pub struct InstalledStockPanorama {
+    generation: [u8; 32],
+    faces: Arc<Faces>,
+}
+
+impl InstalledStockPanorama {
+    pub fn faces(&self) -> &Arc<Faces> {
+        &self.faces
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct StockHudCapacity {
+    pub retained_bytes: usize,
+    pub encoded_bytes: usize,
+    pub layout_bytes: usize,
+}
+
+type Layout = Vec<(String, Rect)>;
+type Glint = (Vec<u8>, u32, u32);
+
+struct StockHudSeed {
+    generation: [u8; 32],
+    packed: Arc<PackedPixels>,
+    dimensions: (u32, u32),
+    glyph_region: (u32, u32),
+    panorama: VerifiedFaceLayout,
+    white: Rect,
+    galactic_widths: [u16; 128],
+    sprites: Layout,
+    translucent: Vec<String>,
+    flags: Vec<(String, TextureFlags)>,
+    animation_names: Vec<String>,
+    capacity: StockHudCapacity,
+}
+
+/// Fixed-capacity, single-generation storage. Neither a resource handle nor
+/// mutable glyph, picture, object-skin, or GPU state survives in this slot.
+#[derive(Default)]
+pub struct StockHudSlot(Option<Arc<StockHudSeed>>);
+
+impl StockHudSlot {
+    pub fn clear(&mut self) {
+        self.0 = None;
+    }
+
+    /// Called once with the verified cold atlas, before it is ordinarily packed.
+    /// Success shares the compact pixel backing with that whole atlas.
+    pub fn capture(
+        &mut self,
+        atlas: &mut HudAtlas,
+        source: &InstalledStockAssets,
+        panorama: &InstalledStockPanorama,
+        cancel: &AtomicBool,
+    ) -> Option<StockHudCapacity> {
+        self.capture_bounded(atlas, source, panorama, cancel, SLOT_CAP)
+    }
+
+    fn capture_bounded(
+        &mut self,
+        atlas: &mut HudAtlas,
+        source: &InstalledStockAssets,
+        panorama: &InstalledStockPanorama,
+        cancel: &AtomicBool,
+        cap: usize,
+    ) -> Option<StockHudCapacity> {
+        self.clear();
+        let seed = StockHudSeed::capture(atlas, source, panorama, cancel, cap)?;
+        let retained = seed.capacity;
+        self.0 = Some(Arc::new(seed));
+        Some(retained)
+    }
+
+    /// A mismatch, missing receipt/source or canceled launch evicts this slot.
+    /// An unsuccessful preparation leaves the ordinary loader available.
+    pub fn prepare(
+        &mut self,
+        source: Option<InstalledStockAssets>,
+        cancel: &AtomicBool,
+    ) -> Option<PlannedStockHud> {
+        let ready = self.0.as_ref().and_then(|seed| {
+            let source = source?;
+            let generation = source.0.verified_assets_generation()?;
+            if generation != seed.generation
+                || cancel.load(Ordering::Acquire)
+                || sprites::labpbr_maps()
+            {
+                return None;
+            }
+            PlannedStockHud::prepare(Arc::clone(seed), source.0, cancel)
+        });
+        if ready.is_none() {
+            self.clear();
+        }
+        ready
+    }
+}
+
+fn rect_key(rect: Rect) -> [u32; 6] {
+    [
+        rect.u0.to_bits(),
+        rect.v0.to_bits(),
+        rect.u1.to_bits(),
+        rect.v1.to_bits(),
+        rect.w,
+        rect.h,
+    ]
+}
+
+fn named_capacity<T>(entries: &Vec<(String, T)>) -> usize {
+    entries.capacity() * size_of::<(String, T)>()
+        + entries
+            .iter()
+            .map(|(name, _)| name.capacity())
+            .sum::<usize>()
+}
+
+fn strings_capacity(entries: &Vec<String>) -> usize {
+    entries.capacity() * size_of::<String>() + entries.iter().map(String::capacity).sum::<usize>()
+}
+
+impl StockHudSeed {
+    fn capture(
+        atlas: &mut HudAtlas,
+        source: &InstalledStockAssets,
+        panorama: &InstalledStockPanorama,
+        cancel: &AtomicBool,
+        cap: usize,
+    ) -> Option<Self> {
+        if cancel.load(Ordering::Acquire)
+            || sprites::labpbr_maps()
+            || atlas.packed.is_some()
+            || atlas.stock_packed.is_some()
+            || atlas.pixels.is_empty()
+            || atlas.material_maps.iter().any(Option::is_some)
+            || atlas.sprites.contains_key("horizon/modimage")
+            || atlas.text_shaders.gui.is_some()
+            || atlas.text_shaders.world.is_some()
+            || atlas.text_shaders.see_through.is_some()
+            || atlas.lines_shader.is_some()
+            || atlas.sky_shader.is_some()
+            || atlas.stars_shader.is_some()
+        {
+            return None;
+        }
+        let glyph_region = atlas.font.stock_glyph_region(source.assets())?;
+        let generation = source.0.verified_assets_generation()?;
+        if generation != panorama.generation {
+            return None;
+        }
+        let panorama = panorama.faces.verified_layout()?;
+        let mut regions = HashMap::new();
+        for (name, &rect) in &atlas.sprites {
+            regions
+                .entry(rect_key(rect))
+                .and_modify(|value| *value = None)
+                .or_insert(Some(name));
+        }
+        let animation_names = atlas
+            .sprite_animations
+            .iter()
+            .map(|(rect, _)| regions.get(&rect_key(*rect))?.map(String::clone))
+            .collect::<Option<Vec<_>>>()?;
+        drop(regions);
+        let sprites: Layout = atlas
+            .sprites
+            .iter()
+            .map(|(name, &rect)| (name.clone(), rect))
+            .collect();
+        let translucent: Vec<_> = atlas.translucent.iter().cloned().collect();
+        let flags: Vec<_> = atlas
+            .flags
+            .iter()
+            .map(|(name, &flags)| (name.clone(), flags))
+            .collect();
+        let layout_bytes = named_capacity(&sprites)
+            + named_capacity(&flags)
+            + strings_capacity(&translucent)
+            + strings_capacity(&animation_names);
+        let fixed = size_of::<Self>()
+            + size_of::<StockHudSlot>()
+            + size_of::<PackedPixels>()
+            + 4 * size_of::<usize>();
+        let metadata = layout_bytes.checked_add(fixed)?;
+        let packed = PackedPixels::compress_with_budget(&atlas.pixels, cap.checked_sub(metadata)?)?;
+        let retained_bytes = metadata.checked_add(packed.retained_bytes())?;
+        if retained_bytes > cap || cancel.load(Ordering::Acquire) {
+            return None;
+        }
+        let capacity = StockHudCapacity {
+            retained_bytes,
+            encoded_bytes: packed.encoded_len(),
+            layout_bytes,
+        };
+        let packed = Arc::new(packed);
+        atlas.stock_packed = Some(Arc::clone(&packed));
+        atlas.pixels = Vec::new();
+        Some(Self {
+            generation,
+            packed,
+            glyph_region,
+            panorama,
+            capacity,
+            dimensions: (atlas.width, atlas.height),
+            white: atlas.white,
+            galactic_widths: atlas.galactic_widths,
+            sprites,
+            translucent,
+            flags,
+            animation_names,
+        })
+    }
+}
+
+/// All inputs for a mapped restore, pinned to the newly verified descriptor.
+/// The public complete output has no placeholder font.
+pub struct PlannedStockHud {
+    seed: Arc<StockHudSeed>,
+    source: ResourceSource,
+    sprites: HashMap<String, Rect>,
+    animations: Vec<(Rect, sprites::SpriteAnimation)>,
+    glint: Glint,
+    glint_armor: Glint,
+    panorama: Arc<Faces>,
+    random_textures: horizon_optifine::random_textures::RandomTextures,
+    blinks: horizon_optifine::blink::Blinks,
+    emissive: Arc<horizon_optifine::emissive::Emissive>,
+    sprite_modifiers: Arc<sprite_modifiers::SpriteModifiers>,
+}
+
+pub struct CompleteStockHud {
+    pub atlas: HudAtlas,
+    pub panorama: Arc<Faces>,
+}
+
+impl PlannedStockHud {
+    fn prepare(
+        seed: Arc<StockHudSeed>,
+        source: ResourceSource,
+        cancel: &AtomicBool,
+    ) -> Option<Self> {
+        let layout: HashMap<_, _> = seed.sprites.iter().cloned().collect();
+        let mut sprites = sprites::Sprites::new(source.clone());
+        let mut animations = Vec::new();
+        for name in &seed.animation_names {
+            if cancel.load(Ordering::Acquire) {
+                return None;
+            }
+            let id = if name.contains(':') {
+                name.clone()
+            } else {
+                format!("minecraft:{name}")
+            };
+            let layer = sprites.insert(&id).ok()?;
+            let animation = sprites
+                .animations
+                .iter()
+                .find(|animation| animation.layer == layer)?;
+            animations.push((*layout.get(name)?, animation.clone()));
+        }
+        drop(sprites);
+        let (random_textures, blinks, emissive) = atlas_entity_variants(&source);
+        let sprite_modifiers = Arc::new(sprite_modifiers::SpriteModifiers::read(
+            &source,
+            layout.keys(),
+        ));
+        let glint = HudAtlas::glint_texture(&source, &source, "enchanted_glint_item");
+        let glint_armor = HudAtlas::glint_texture(&source, &source, "enchanted_glint_armor");
+        let panorama = Arc::new(seed.panorama.reopen(&source, cancel)?);
+        if cancel.load(Ordering::Acquire) {
+            return None;
+        }
+        Some(Self {
+            seed,
+            source,
+            sprites: layout,
+            animations,
+            glint,
+            glint_armor,
+            panorama,
+            random_textures,
+            blinks,
+            emissive,
+            sprite_modifiers,
+        })
+    }
+
+    pub fn dimensions(&self) -> (u32, u32) {
+        self.seed.dimensions
+    }
+
+    pub fn glint(&self) -> &(Vec<u8>, u32, u32) {
+        &self.glint
+    }
+
+    pub fn panorama(&self) -> &Faces {
+        &self.panorama
+    }
+
+    /// Construct a CPU-complete atlas with a fresh font using only the existing
+    /// mapped image. The caller publishes it after the native upload succeeds.
+    pub fn finish_mapped(
+        self,
+        rgba: &mut [u8],
+        pitch: usize,
+        cancel: &AtomicBool,
+    ) -> Option<CompleteStockHud> {
+        if cancel.load(Ordering::Acquire) {
+            return None;
+        }
+        let (width, height) = self.seed.dimensions;
+        self.seed
+            .packed
+            .write_pitched(rgba, width as usize * 4, pitch, height as usize)?;
+        let font = Font::load_stock_mapped(
+            &self.source,
+            &self.sprites,
+            rgba,
+            pitch,
+            self.seed.dimensions,
+            self.seed.glyph_region,
+            self.seed.white,
+        )?;
+        if cancel.load(Ordering::Acquire) {
+            return None;
+        }
+        let atlas = HudAtlas {
+            pictures: Mutex::new(pictures::Cache::new(&self.source, &self.source)),
+            revision: HudAtlas::next_revision(),
+            pixels: Vec::new(),
+            packed: None,
+            stock_packed: Some(Arc::clone(&self.seed.packed)),
+            galactic_widths: self.seed.galactic_widths,
+            width,
+            height,
+            sprites: self.sprites,
+            object_skins: HashMap::new(),
+            object_skins_revision: HudAtlas::next_revision(),
+            translucent: self.seed.translucent.iter().cloned().collect(),
+            flags: self.seed.flags.iter().cloned().collect(),
+            sprite_animations: self.animations,
+            font,
+            glint: self.glint,
+            glint_armor: self.glint_armor,
+            text_shaders: Default::default(),
+            lines_shader: None,
+            sky_shader: None,
+            stars_shader: None,
+            sprite_modifiers: self.sprite_modifiers,
+            random_textures: self.random_textures,
+            emissive: self.emissive,
+            blinks: self.blinks,
+            material_maps: Arc::default(),
+            white: self.seed.white,
+        };
+        Some(CompleteStockHud {
+            atlas,
+            panorama: self.panorama,
+        })
+    }
+}
