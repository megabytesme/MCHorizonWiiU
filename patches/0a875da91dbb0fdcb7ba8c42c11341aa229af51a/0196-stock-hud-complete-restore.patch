+#[test]
+#[ignore = "requires a privately installed archived stock fixture and receipt"]
+fn installed_stock_cached_backing_restores_full_hud_and_panorama() -> crate::Result<()> {
+    fn assert_send<T: Send>() {}
+    assert_send::<StockHudSlot>();
+    assert_send::<PlannedStockHud>();
+    assert_send::<CompleteStockHud>();
+    let root =
+        PathBuf::from(std::env::var_os("HORIZON_VERIFIED_HUD_ROOT").ok_or("stock root missing")?);
+    let receipt = PathBuf::from(
+        std::env::var_os("HORIZON_STOCK_INSTALL_RECEIPT").ok_or("stock receipt missing")?,
+    );
+    let cancel = AtomicBool::new(false);
+    let open = || -> crate::Result<InstalledStockAssets> {
+        InstalledStockAssets::reopen(&root, &receipt, &cancel)?
+            .ok_or("installed source missing".into())
+    };
+    let cold = open()?;
+    let cold_lifetime = cold.assets().liveness();
+    let build_start = Instant::now();
+    let mut original = HudAtlas::build(cold.assets())?;
+    let original_atlas_time = build_start.elapsed();
+    let expected_rgba = Sha256::digest(&original.pixels);
+    assert_eq!(
+        format!("{expected_rgba:x}"),
+        "a4f3e9e48e982b03a68ac752ab4f52d81665feba7259b1ff628d8ced1e96155b"
+    );
+    let expected_sprite_rects: HashMap<_, _> = original
+        .sprites
+        .iter()
+        .map(|(name, &rect)| (name.clone(), rect_key(rect)))
+        .collect();
+    assert_eq!(expected_sprite_rects.len(), 4545);
+    assert_eq!(original.sprite_animations.len(), 63);
+    let expected_animations = animation_digest(&original.sprite_animations);
+    let expected_font = font_digest(&original.font);
+    let panorama_started = Instant::now();
+    let cold_panorama = cold.load_panorama();
+    let cold_panorama_time = panorama_started.elapsed();
+    let expected_cubemap = panorama_digest(cold_panorama.faces());
+    let expected_glint = original.glint.clone();
+    let expected_armor = original.glint_armor.clone();
+    let expected_widths = original.galactic_widths;
+    let expected_translucent = original.translucent.clone();
+    let expected_flags = original.flags.clone();
+    let original_epoch = original.font.epoch();
+    let original_revision = original.revision;
+    let original_skins = original.object_skins_revision;
+    original
+        .object_skins
+        .insert("old-session".into(), "fixture:skin".into());
+
+    let mut slot = StockHudSlot::default();
+    assert!(
+        slot.capture_bounded(&mut original, &cold, &cold_panorama, &cancel, 1024)
+            .is_none()
+    );
+    assert_eq!(original.pixels.len(), 117_440_512);
+    let capture = Instant::now();
+    let capacity = slot
+        .capture(&mut original, &cold, &cold_panorama, &cancel)
+        .ok_or("capture failed")?;
+    let capture = capture.elapsed();
+    assert!(capacity.retained_bytes <= SLOT_CAP);
+    assert!(original.pixels.is_empty());
+    let backing = Arc::downgrade(original.stock_packed.as_ref().unwrap());
+    assert_eq!(backing.strong_count(), 2);
+    drop(original);
+    drop(cold_panorama);
+    drop(cold);
+    assert_eq!(backing.strong_count(), 1);
+    assert!(!cold_lifetime());
+
+    for pad in [0, 128] {
+        let started = Instant::now();
+        let source = open()?;
+        let verify = started.elapsed();
+        let cold_lifetime = source.assets().liveness();
+        let plan = slot
+            .prepare(Some(source), &cancel)
+            .ok_or("stock cache miss")?;
+        let planned_at = started.elapsed();
+        assert_eq!(plan.glint(), &expected_glint);
+        assert_eq!(plan.panorama().size, 1024);
+        let (width, height) = plan.dimensions();
+        assert_eq!((width, height), (4096, 7168));
+        let row_bytes = width as usize * 4;
+        let pitch = row_bytes + pad;
+        let mut surface = vec![0xa5; pitch * height as usize];
+        let restored = plan
+            .finish_mapped(&mut surface, pitch, &cancel)
+            .ok_or("mapped restore failed")?;
+        let restored_at = started.elapsed();
+        let mut digest = Sha256::new();
+        for row in surface.chunks_exact(pitch) {
+            digest.update(&row[..row_bytes]);
+            assert!(row[row_bytes..].iter().all(|&value| value == 0xa5));
+        }
+        assert_eq!(digest.finalize(), expected_rgba);
+        drop(surface);
+        assert!(restored.atlas.pixels.is_empty());
+        assert!(!restored.atlas.font.uniform && !restored.atlas.font.japanese);
+        assert!(restored.atlas.font.take_patches().is_empty());
+        assert_eq!(font_digest(&restored.atlas.font), expected_font);
+        assert_eq!(
+            animation_digest(&restored.atlas.sprite_animations),
+            expected_animations
+        );
+        assert_eq!(restored.atlas.galactic_widths, expected_widths);
+        assert_eq!(restored.atlas.translucent, expected_translucent);
+        assert_eq!(restored.atlas.flags, expected_flags);
+        assert_eq!(
+            restored
+                .atlas
+                .sprites
+                .iter()
+                .map(|(name, &rect)| (name.clone(), rect_key(rect)))
+                .collect::<HashMap<_, _>>(),
+            expected_sprite_rects
+        );
+        assert_eq!(restored.atlas.glint, expected_glint);
+        assert_eq!(restored.atlas.glint_armor, expected_armor);
+        assert_eq!(panorama_digest(&restored.panorama), expected_cubemap);
+        assert_ne!(restored.atlas.revision, original_revision);
+        assert_ne!(restored.atlas.font.epoch(), original_epoch);
+        assert_ne!(restored.atlas.object_skins_revision, original_skins);
+        assert!(restored.atlas.object_skins.is_empty());
+        assert!(cold_lifetime());
+        assert_eq!(backing.strong_count(), 2);
+        // The installed atlas remains independently uploadable after the slot is cleared.
+        if pad != 0 {
+            slot.clear();
+        }
+        let mut reupload = vec![0; row_bytes * height as usize];
+        assert!(restored.atlas.write_mapped_rgba(&mut reupload, row_bytes));
+        assert_eq!(Sha256::digest(reupload), expected_rgba);
+        drop(restored);
+        assert!(!cold_lifetime());
+        assert_eq!(backing.strong_count(), usize::from(pad == 0));
+        println!(
+            "stock hit padding={pad} verify={verify:?} plan={:?} map_font={:?} total={restored_at:?}",
+            planned_at - verify,
+            restored_at - planned_at
+        );
+    }
+    println!(
+        "stock slot {capacity:?} capture={capture:?} cold_atlas={original_atlas_time:?} cold_panorama={cold_panorama_time:?} glint_bytes={} armor_glint_bytes={} panorama_streamed_rgba_bytes={}",
+        expected_glint.0.len(),
+        expected_armor.0.len(),
+        expected_cubemap.1
+    );
+    Ok(())
+}
