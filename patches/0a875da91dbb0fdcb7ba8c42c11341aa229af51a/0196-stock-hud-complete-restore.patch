+use super::*;
+use sha2::{Digest, Sha256};
+use std::{fs, path::PathBuf, time::Instant};
+
+fn asset_receipt(root: &Path, digest: &str) -> serde_json::Value {
+    serde_json::json!({"archive_version": 2, "archive_sha256": digest, "guest_root": root})
+}
+
+fn panorama_digest(panorama: &Faces) -> ([u8; 32], usize) {
+    let mut digest = Sha256::new();
+    let mut bytes = 0;
+    panorama
+        .visit_rows(|row| {
+            digest.update(row);
+            bytes += row.len();
+            Some(())
+        })
+        .unwrap();
+    (digest.finalize().into(), bytes)
+}
+
+fn font_digest(font: &Font) -> [u8; 32] {
+    let mut digest = Sha256::new();
+    for id in ["minecraft:default", "minecraft:alt", "minecraft:uniform"] {
+        for ch in (' '..='~').chain(['§', 'Ω', '漢', '\u{301}', '界', '⛏']) {
+            let g = font.glyph_in(id, ch);
+            for metric in [g.left, g.top, g.right, g.bottom, g.advance, g.offset] {
+                digest.update(metric.to_bits().to_le_bytes());
+            }
+            digest.update([u8::from(g.rect.is_some())]);
+            if let Some(rect) = g.rect {
+                for value in rect_key(rect) {
+                    digest.update(value.to_le_bytes());
+                }
+            }
+        }
+    }
+    digest.finalize().into()
+}
+
+fn animation_digest(items: &[(Rect, sprites::SpriteAnimation)]) -> [u8; 32] {
+    let mut digest = Sha256::new();
+    for (rect, animation) in items {
+        for bits in rect_key(*rect) {
+            digest.update(bits.to_le_bytes());
+        }
+        digest.update(animation.layer.to_le_bytes());
+        for tick in [0, 1, 7, 20, 256, 4097] {
+            let blend = animation.blend(tick);
+            digest.update((blend.frame as u32).to_le_bytes());
+            digest.update((blend.next as u32).to_le_bytes());
+            digest.update(blend.millis.to_le_bytes());
+            let rgba = animation.pixels(blend.frame);
+            digest.update((rgba.len() as u32).to_le_bytes());
+            digest.update(rgba);
+        }
+    }
+    digest.finalize().into()
+}
