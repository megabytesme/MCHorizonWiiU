+#[cfg(target_os = "cafe")]
+mod cafe_io {
+    use crate::AtomicU64;
+    use std::sync::atomic::Ordering::Relaxed;
+
+    pub(super) static ARCHIVE_OPENS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static DISK_FALLBACKS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static ENTRY_HITS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static ENTRY_MISSES: AtomicU64 = AtomicU64::new(0);
+    pub(super) static READS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static SMALL_READS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static READ_BYTES: AtomicU64 = AtomicU64::new(0);
+
+    pub(super) fn count(counter: &AtomicU64) {
+        counter.fetch_add(1, Relaxed);
+    }
+
+    pub(super) fn read(bytes: usize) {
+        count(&READS);
+        if bytes <= 4096 {
+            count(&SMALL_READS);
+        }
+        READ_BYTES.fetch_add(bytes as u64, Relaxed);
+    }
+
+    pub(super) fn log_totals(stage: &str) {
+        log::info!(
+            "Horizon prepared I/O: stage={stage} archive_opens={} disk_fallbacks={} entry_hits={} entry_misses={} reads={} small_reads={} read_bytes={}",
+            ARCHIVE_OPENS.load(Relaxed),
+            DISK_FALLBACKS.load(Relaxed),
+            ENTRY_HITS.load(Relaxed),
+            ENTRY_MISSES.load(Relaxed),
+            READS.load(Relaxed),
+            SMALL_READS.load(Relaxed),
+            READ_BYTES.load(Relaxed),
+        );
+    }
+}
+
+/// Emit process-wide prepared resource I/O counts at a startup phase boundary.
+/// The read counters describe successful archive reads through this adapter.
+#[cfg(target_os = "cafe")]
+pub fn log_io_totals(stage: &str) {
+    cafe_io::log_totals(stage);
+}
