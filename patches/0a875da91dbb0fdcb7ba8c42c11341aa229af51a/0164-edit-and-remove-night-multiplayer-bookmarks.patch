+    fn server_record(name: &str, address: &str) -> Result<Server, &'static str> {
+        if !store::label(name, 24) {
+            return Err("Enter a label with 1-24 bytes and no control characters.");
+        }
+        let address = store::endpoint(address)
+            .ok_or("Enter a hostname or IP and an optional port (1-65535).")?;
+        Ok(Server {
+            name: name.to_owned(),
+            address,
+        })
+    }
+
+    fn commit_servers(&mut self, next: Preferences) -> Result<(), &'static str> {
+        if !self.save(next) {
+            return Err(self.message);
+        }
+        if matches!(self.target, Target::Server(_)) {
+            self.target = self
+                .preferences
+                .server
+                .map(|index| Target::Server(self.preferences.servers[index].address.clone()))
+                .unwrap_or(Target::Menu);
+        }
+        Ok(())
+    }
+
+    fn save_server(
+        &mut self,
+        mut next: Preferences,
+        index: Option<usize>,
+        server: Server,
+    ) -> Result<(), &'static str> {
+        match index {
+            Some(index) => {
+                *next
+                    .servers
+                    .get_mut(index)
+                    .ok_or("The saved server is unavailable.")? = server;
+            }
+            None if next.servers.len() < store::ENTRIES => next.servers.push(server),
+            None => return Err("The saved server list is full."),
+        }
+        self.commit_servers(next)
+    }
+
+    fn remove_server(
+        &mut self,
+        mut next: Preferences,
+        index: usize,
+    ) -> Result<Server, &'static str> {
+        if index >= next.servers.len() {
+            return Err("The saved server is unavailable.");
+        }
+        let removed = next.servers.remove(index);
+        next.server = next
+            .server
+            .filter(|&selected| selected != index)
+            .map(|selected| selected - usize::from(selected > index));
+        self.commit_servers(next)?;
+        Ok(removed)
+    }
