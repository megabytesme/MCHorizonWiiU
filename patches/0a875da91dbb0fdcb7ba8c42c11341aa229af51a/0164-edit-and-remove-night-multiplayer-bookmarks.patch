+    fn bookmark_to_change(&self, args: &Value, key: &str) -> Result<usize, &'static str> {
+        if matches!(
+            self.page,
+            Page::Items(List::Servers, _)
+                | Page::Server(_)
+                | Page::Confirm { profile: false, .. }
+                | Page::Edit(Edit::NewServerName | Edit::ServerName(_) | Edit::Address { .. })
+        ) {
+            return Err("Close Night's local server list or editor before changing a bookmark.");
+        }
+        let address = args[key]
+            .as_str()
+            .filter(|address| store::endpoint(address).as_deref() == Some(*address))
+            .ok_or("Use the exact address from multiplayer_list.")?;
+        let current_name = match args.get("current_name") {
+            Some(value) => Some(
+                value
+                    .as_str()
+                    .filter(|name| store::label(name, 24))
+                    .ok_or("Use the existing bookmark name from multiplayer_list.")?,
+            ),
+            None => None,
+        };
+        let mut matching = self
+            .preferences
+            .servers
+            .iter()
+            .enumerate()
+            .filter(|(_, server)| {
+                server.address == address && current_name.is_none_or(|name| server.name == name)
+            });
+        let (index, _) = matching
+            .next()
+            .ok_or("No saved bookmark matches the supplied identity.")?;
+        if matching.next().is_some() {
+            return Err(if current_name.is_none() {
+                "More than one bookmark has this address. Supply its current_name from multiplayer_list."
+            } else {
+                "Multiple bookmarks have this address and name. Choose one in Night's server list."
+            });
+        }
+        Ok(index)
+    }
