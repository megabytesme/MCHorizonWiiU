+bool horizon_gx2_profile_grouped_present(bool screenshot)
+{
+   if (!marker_enabled || marker_mode != '4' ||
+       (marker_variant != EOF && marker_variant != '\r' && marker_variant != '\n') ||
+       history != &process_history || !recording || current.phase != PLAYING_PHASE)
+      return false;
+#ifdef HORIZON_GX2_HUD_VIEW_LANES
+   // Qualify grouping and the view-owned HUD lanes as separate arms.
+   if (horizon_gx2_profile_view_hud()) return false;
+#endif
+
+   static bool checked, requested;
+   if (!checked) {
+      checked = true;
+      FILE *file = fopen(ROOT "gx2-grouped-present.enable", "rb");
+      if (file) {
+         fclose(file);
+         file = fopen(ROOT "gx2-profile.enable", "rb");
+         if (file) {
+            const int mode = fgetc(file), next = fgetc(file);
+            requested = mode == '4' && (next == EOF ||
+               (next == '\n' && fgetc(file) == EOF) ||
+               (next == '\r' && fgetc(file) == '\n' && fgetc(file) == EOF));
+            requested = requested && !ferror(file);
+            fclose(file);
+         }
+      }
+      if (requested) OSReport("Horizon GX2 grouped pair trial requested\n");
+   }
+
+   static bool reported_screenshot;
+   if (requested && screenshot && !reported_screenshot) {
+      reported_screenshot = true;
+      OSReport("Horizon GX2 grouped pair used stock screenshot ordering\n");
+   }
+   return requested && !screenshot;
+}
