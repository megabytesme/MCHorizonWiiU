+enum GroupedDisposition {
+   GROUPED_KEYBOARD,
+   GROUPED_BACKGROUND,
+   GROUPED_PRIOR_PENDING,
+   GROUPED_CALLBACK_FAILED,
+   GROUPED_SCAN_PENDING,
+   GROUPED_FINISH_UNVERIFIED,
+   GROUPED_ACCEPTED,
+};
+
+static void report_grouped(enum GroupedDisposition disposition, const char *message)
+{
+   static uint32_t reported;
+   const uint32_t bit = 1u << disposition;
+   if (reported & bit) return;
+   reported |= bit;
+   OSReport("Horizon GX2 grouped pair: %s\n", message);
+}
+
+static int reject_grouped(OSTime flip_wait, bool gpu_sample, const uint32_t dimensions[4],
+                          int result)
+{
+   last_wait_ns = OSTicksToNanoseconds(flip_wait + drain_guarded_commands());
+   horizon_gx2_profile_outputs(0, dimensions);
+   if (gpu_sample) horizon_gx2_profile_gpu_finish(0);
+   return result;
+}
+
+int horizon_loading_host_present_grouped(HorizonLoadingDrawTarget draw, void *context,
+                                          const float rgba[4], const uint32_t opaque_viewports[8])
+{
+   last_outputs = 0;
+   last_wait_ns = 0;
+   if (!draw || !rgba) return -1;
+   if (!ProcUIInForeground()) {
+      report_grouped(GROUPED_BACKGROUND, "foreground unavailable, no publication");
+      return HORIZON_LOADING_RETRY_FLIP;
+   }
+   if (horizon_swkbd_is_open()) {
+      report_grouped(GROUPED_KEYBOARD, "using stock keyboard ordering");
+      return horizon_loading_host_present_with_clear(draw, context, rgba, opaque_viewports);
+   }
+
+   uint32_t dimensions[4];
+   if (horizon_loading_host_dimensions(dimensions) != 0) return -4;
+   const OSTime prior = GX2GetLastSubmittedTimeStamp();
+   if (prior <= 0 || GX2GetRetiredTimeStamp() < prior) {
+      report_grouped(GROUPED_PRIOR_PENDING, "prior GPU retirement unverified, no publication");
+      return reject_grouped(0, false, dimensions, HORIZON_LOADING_RETRY_FLIP);
+   }
+
+   uint32_t ticket, swaps, flips;
+   OSTime last_flip, last_vsync;
+   GX2GetSwapStatus(&ticket, &flips, &last_flip, &last_vsync);
+   const bool gpu_sample = horizon_gx2_profile_gpu_begin();
+   int result = 0;
+   for (uint32_t output = 0; output < 2; ++output) {
+      const uint64_t stamp = horizon_gx2_profile_stamp();
+      if (output == 0) WHBGfxBeginRenderTV();
+      else WHBGfxBeginRenderDRC();
+      // Plain marker 4 uses the stock clear and per-output resources.
+      WHBGfxClearColor(rgba[0], rgba[1], rgba[2], rgba[3]);
+      horizon_gx2_profile_end(output == 0 ? GX2_PROFILE_CLEAR_TV : GX2_PROFILE_CLEAR_DRC, stamp);
+      if (gpu_sample) horizon_gx2_profile_gpu_marker(output, false);
+      if (draw(context, output, dimensions[2 * output], dimensions[2 * output + 1]) != 0 ||
+          horizon_swkbd_draw(output) != 0)
+         result = output == 0 ? -2 : -3;
+      if (gpu_sample) horizon_gx2_profile_gpu_marker(output, true);
+      horizon_gx2_profile_end(output == 0 ? GX2_PROFILE_SUBMIT_TV : GX2_PROFILE_SUBMIT_DRC, stamp);
+   }
+   if (result) {
+      report_grouped(GROUPED_CALLBACK_FAILED, "target callback failed, no publication");
+      return reject_grouped(0, gpu_sample, dimensions, result);
+   }
+
+   const OSTime flip_wait = wait_for_previous_flip();
+   GX2GetSwapStatus(&swaps, &flips, &last_flip, &last_vsync);
+   if (swaps != ticket || flips != ticket) {
+      report_grouped(GROUPED_SCAN_PENDING, "scan ticket unconfirmed, no publication");
+      return reject_grouped(flip_wait, gpu_sample, dimensions, HORIZON_LOADING_RETRY_FLIP);
+   }
+
+   uint64_t stamp = horizon_gx2_profile_stamp();
+   WHBGfxFinishRenderTV();
+   horizon_gx2_profile_end(GX2_PROFILE_SCAN_COPY_TV, stamp);
+   horizon_gx2_profile_end(GX2_PROFILE_SUBMIT_TV, stamp);
+   stamp = horizon_gx2_profile_stamp();
+   WHBGfxFinishRenderDRC();
+   horizon_gx2_profile_end(GX2_PROFILE_SCAN_COPY_DRC, stamp);
+   horizon_gx2_profile_end(GX2_PROFILE_SUBMIT_DRC, stamp);
+
+   stamp = horizon_gx2_profile_stamp();
+   const OSTime before_finish = GX2GetLastSubmittedTimeStamp();
+   const OSTime finish_start = OSGetTime();
+   WHBGfxFinishRender();
+   const OSTime waited = flip_wait + OSGetTime() - finish_start;
+   horizon_gx2_profile_end(GX2_PROFILE_FINISH, stamp);
+   const OSTime submitted = GX2GetLastSubmittedTimeStamp();
+   if (submitted <= 0 || submitted <= before_finish || GX2GetRetiredTimeStamp() < submitted) {
+      report_grouped(GROUPED_FINISH_UNVERIFIED, "swap issued, final GPU retirement unverified");
+      return reject_grouped(waited, gpu_sample, dimensions, HORIZON_LOADING_RETRY_FLIP);
+   }
+
+   last_wait_ns = OSTicksToNanoseconds(waited);
+   last_outputs = 3;
+   horizon_gx2_profile_outputs(last_outputs, dimensions);
+   if (gpu_sample) horizon_gx2_profile_gpu_finish(last_outputs);
+   ++completed_presents;
+   horizon_gx2_profile_count(GX2_PROFILE_PRESENTED, 1);
+   report_grouped(GROUPED_ACCEPTED, "both targets presented and retired");
+   return 0;
+}
