+// Decode directly into the compact runtime state row. The tuple deserializer
+// keeps the prepared export's field types, including borrowed path strings.
+impl<'de> serde::Deserialize<'de> for StateData {
+    fn deserialize<D: serde::Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+        let (path, flags, top) = <(&str, u64, f64)>::deserialize(d)?;
+        Ok(Self {
+            path: PathType::from_name(path),
+            flags: flags as u16,
+            top: top as f32,
+        })
+    }
+}
