@@ -31,10 +31,50 @@ pub struct IndexedTerrainVertex {
     pub uv: [f32; 2],
     pub color_cutout: [u8; 4],
 }
+
+/// Qualified GX2 half-position vertex. The fourth half is padding. Packed
+/// light, UVs and colour keep their stock representations.
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct HalfTerrainVertex {
+    pub position: [u16; 4],
+    pub light: f32,
+    pub uv: [f32; 2],
+    pub color_cutout: [u8; 4],
+}
+
+#[cfg(feature = "atlas")]
+fn exact_half_position(value: f32) -> Option<u16> {
+    let bits = value.to_bits();
+    let sign = ((bits >> 16) & 0x8000) as u16;
+    if bits & 0x7fff_ffff == 0 {
+        return Some(sign);
+    }
+    let exponent = (bits >> 23) & 0xff;
+    if !(113..=142).contains(&exponent) || bits & 0x1fff != 0 {
+        return None;
+    }
+    Some(sign | (((exponent - 112) << 10) | ((bits >> 13) & 0x3ff)) as u16)
+}
+
+/// No half subnormals are admitted, so the feed never relies on preserving
+/// them through the vertex format. A single rejected coordinate keeps the
+/// entire solid section on stock.
+#[cfg(feature = "atlas")]
+pub fn exact_half_positions(source: &[TerrainVertex]) -> bool {
+    source
+        .iter()
+        .all(|v| v.pos.into_iter().all(|p| exact_half_position(p).is_some()))
+}
+
 const _: () = {
     assert!(core::mem::size_of::<IndexedTerrainVertex>() == 28);
     assert!(core::mem::offset_of!(IndexedTerrainVertex, uv) == 16);
     assert!(core::mem::offset_of!(IndexedTerrainVertex, color_cutout) == 24);
+    assert!(core::mem::size_of::<HalfTerrainVertex>() == 24);
+    assert!(core::mem::offset_of!(HalfTerrainVertex, light) == 8);
+    assert!(core::mem::offset_of!(HalfTerrainVertex, uv) == 12);
+    assert!(core::mem::offset_of!(HalfTerrainVertex, color_cutout) == 20);
 };
 
 /// A local-space bound measured from the actual retained mesh. Block models
@@ -651,6 +691,37 @@ impl TerrainAtlasLayout {
         }
         Ok(())
     }
+
+    pub fn write_half_solid_vertices(
+        &self,
+        source: &[TerrainVertex],
+        output: &mut [core::mem::MaybeUninit<HalfTerrainVertex>],
+    ) -> Result<(), &'static str> {
+        if source.len() % 4 != 0 || source.len() != output.len() {
+            return Err("GX2 half-position terrain quad vertex count mismatch");
+        }
+        for (&vertex, dest) in source.iter().zip(output) {
+            let [x, y, z] = vertex.pos.map(exact_half_position);
+            let (Some(x), Some(y), Some(z)) = (x, y, z) else {
+                return Err("nonrepresentable GX2 half-position terrain coordinate");
+            };
+            let layer = u32::from(vertex.layer & 0x7fff);
+            if layer >= self.layers {
+                return Err("terrain vertex references absent sprite layer");
+            }
+            let [u, v] = vertex.uv.map(u32::from);
+            let uv = [u | ((layer & 0xff) << 16), v | ((layer >> 8) << 16)].map(|n| n as f32);
+            let [r, g, b, _] = vertex.rgba();
+            let cutout = if vertex.layer & 0x8000 == 0 { u8::MAX } else { 0 };
+            dest.write(HalfTerrainVertex {
+                position: [x, y, z, 0x3800],
+                light: f32::from(vertex.light),
+                uv,
+                color_cutout: [r, g, b, cutout],
+            });
+        }
+        Ok(())
+    }
 }
 
