+pub(crate) fn copy_rows(
+    mut source: &[u8],
+    target: &mut [u8],
+    mut offset: usize,
+    row_bytes: usize,
+    pitch: usize,
+) {
+    while !source.is_empty() {
+        let (row, column) = (offset / row_bytes, offset % row_bytes);
+        let copied = source.len().min(row_bytes - column);
+        let start = row * pitch + column;
+        target[start..start + copied].copy_from_slice(&source[..copied]);
+        source = &source[copied..];
+        offset += copied;
+    }
+}
