+static bool centered_light;
+
+static void init_centered_light(void)
+{
+   FILE *marker = fopen(ROOT "gx2-centered-light.enable", "rb");
+   if (!marker) return;
+   fclose(marker);
+
+   // Preserve existing trial precedence. Passive pass/deadline observations
+   // are allowed with the same settings in both A/B arms.
+   const char *const incompatible[] = {
+      ROOT "gx2-atlas-cells.enable",
+      ROOT "gx2-half-position.enable",
+      ROOT "gx2-clear-fog.enable",
+      ROOT "gx2-clear-fog-vertex.enable",
+      ROOT "gx2-near-fog.enable",
+      ROOT "gx2-solid-list-replay.enable",
+      ROOT "gx2-solid-list-census.enable",
+      ROOT "gx2-prepared-solid-frustum.enable",
+      ROOT "gx2-reverse-translucent.enable",
+      ROOT "gx2-mem1-tv-depth.enable",
+      ROOT "gx2-tv-terrain-wait.enable",
+      ROOT "gx2-grouped-present.enable",
+      ROOT "gx2-hud-view-lanes.enable",
+      ROOT "gx2-screen-overlays.enable",
+      ROOT "gx2-scaled-color-clear.enable",
+      ROOT "gx2-opaque-tiles.enable",
+      ROOT "gx2-cave-visibility.enable",
+   };
+   for (size_t i = 0; i < sizeof(incompatible) / sizeof(incompatible[0]); ++i) {
+      marker = fopen(incompatible[i], "rb");
+      if (marker) {
+         fclose(marker);
+         OSReport("Horizon GX2 centered light skipped: separate renderer trial is enabled\n");
+         return;
+      }
+   }
+   centered_light = true;
+}
+
+bool horizon_gx2_profile_centered_light(void)
+{
+   return centered_light && history == &process_history;
+}
