+    fn cadence_percentiles(&self) -> Option<(usize, [f32; 4])> {
+        let window = &self.window;
+        let count = window.cadence_count.min(CADENCE_SAMPLES);
+        (count != 0).then(|| {
+            let percentiles = [50, 95, 99, 100]
+                .map(|percent| window.cadence_ms[(count * percent).div_ceil(100) - 1]);
+            (count, percentiles)
+        })
+    }
+
+    pub(in crate::game) fn log_serial(&self, session_start: Instant) {
+        let window = &self.window;
+        let at = self
+            .end
+            .saturating_duration_since(session_start)
+            .as_millis();
+        // The Cafe console backend can split long writes. Emit complete,
+        // independently useful lines with a common window timestamp.
+        log::info!(
+            "Horizon Cafe cadence: t_ms={at} phase={} span_ms={:.1} paired_hz={:.3} loops={} built={} tv={} gamepad={} paired={} partial={}",
+            window.phase.name(),
+            self.seconds() * 1000.0,
+            self.paired_fps(),
+            window.iterations,
+            window.frames,
+            window.outputs[0],
+            window.outputs[1],
+            window.paired,
+            window.partial,
+        );
+        if let Some((count, [median, p95, p99, max])) = self.cadence_percentiles() {
+            log::info!(
+                "Horizon Cafe pacing: t_ms={at} samples={count} median_ms={median:.2} p95_ms={p95:.2} p99_ms={p99:.2} max_ms={max:.2}"
+            );
+        }
+        let delta = |end: Option<u32>, start: Option<u32>| {
+            end.zip(start).map(|(end, start)| end.wrapping_sub(start))
+        };
+        log::info!(
+            "Horizon Cafe streaming: t_ms={at} ticks={:?} flips={:?} meshed={} uploaded={} upload_bytes={} tv_sections={} gamepad_sections={}",
+            delta(self.totals.server_ticks, window.base.server_ticks),
+            delta(self.totals.combined_flips, window.base.combined_flips),
+            self.totals.meshed.saturating_sub(window.base.meshed),
+            window.uploaded_sections,
+            window.uploaded_bytes,
+            window.terrain_sections[0],
+            window.terrain_sections[1],
+        );
+        if window.frames != 0 {
+            let mean =
+                |duration: Duration| duration.as_secs_f64() * 1000.0 / f64::from(window.frames);
+            log::info!(
+                "Horizon Cafe CPU per frame: t_ms={at} redraw_ms={:.2} submit_ms={:.2} gx2_wait_ms={:.2}",
+                mean(window.cpu),
+                mean(window.submission),
+                mean(window.gpu_wait),
+            );
+        }
+        if let Some(resolution) = window.world_resolution {
+            let [[tv_w, tv_h], [pad_w, pad_h]] = resolution.dimensions;
+            log::info!(
+                "Horizon Cafe world: t_ms={at} requested={} effective={} tv={tv_w}x{tv_h} gamepad={pad_w}x{pad_h} surface_bytes={} omitted_passes={:#x}",
+                resolution.requested_scale,
+                resolution.effective_scale,
+                resolution.surface_bytes,
+                window.omitted_pass_mask,
+            );
+        }
+    }
