+#[cfg(test)]
+mod export_tests {
+    use super::*;
+
+    #[test]
+    fn prepared_mob_rows_keep_legacy_defaults_and_check_state_count() {
+        let ordinary = br#"{
+            "states":[["OPEN",3,1.25]],
+            "placements":{"test:mob":{"placement":"in_water","heightmap":"MOTION_BLOCKING"}},
+            "animations":{"test:walk":{"length":1.5,"looping":true}}
+        }"#;
+        let data = MobData::from_prepared_json(ordinary, 1).unwrap();
+        assert_eq!(data.states[0].path, PathType::Open);
+        assert_eq!(data.states[0].flags, 3);
+        assert_eq!(data.states[0].top.to_bits(), 1.25_f32.to_bits());
+        assert_eq!(data.placements["test:mob"], Placement::InWater);
+        assert_eq!(data.heightmaps["test:mob"], "MOTION_BLOCKING");
+        assert_eq!(data.animations["test:walk"].length, 1.5);
+        assert!(data.animations["test:walk"].looping);
+        assert!(MobData::from_prepared_json(ordinary, 2).is_none());
+
+        let unusual = br#"{"states":[["LAVA",65539,null,"unused"],["UNKNOWN",-1]]}"#;
+        let data = MobData::from_prepared_json(unusual, 2).unwrap();
+        assert_eq!(data.states[0].path, PathType::Lava);
+        assert_eq!(data.states[0].flags, 3);
+        assert_eq!(data.states[0].top.to_bits(), 0.0_f32.to_bits());
+        assert_eq!(data.states[1].path, PathType::Blocked);
+        assert_eq!(data.states[1].flags, 0);
+        assert!(MobData::from_prepared_json(unusual, 1).is_none());
+    }
+}
