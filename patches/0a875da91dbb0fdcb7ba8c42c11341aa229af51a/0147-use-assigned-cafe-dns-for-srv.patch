@@ -37,7 +37,29 @@ pub(super) fn system_name_servers() -> Vec<SocketAddr> {
     servers
 }
 
-#[cfg(not(any(unix, windows)))]
+#[cfg(target_os = "cafe")]
+pub(super) fn system_name_servers() -> Vec<SocketAddr> {
+    use std::sync::Mutex;
+
+    unsafe extern "C" {
+        fn horizon_cafe_system_name_servers(addresses: *mut [u8; 4]) -> u32;
+    }
+
+    static NETCONF: Mutex<()> = Mutex::new(());
+    let mut addresses = [[0; 4]; 2];
+    let Ok(_guard) = NETCONF.lock() else {
+        return Vec::new();
+    };
+    // The bridge writes at most two IPv4 addresses and retains no pointer.
+    let count = unsafe { horizon_cafe_system_name_servers(addresses.as_mut_ptr()) } as usize;
+    addresses
+        .into_iter()
+        .take(count)
+        .map(|address| SocketAddr::from((address, 53)))
+        .collect()
+}
+
+#[cfg(not(any(unix, windows, target_os = "cafe")))]
 pub(super) fn system_name_servers() -> Vec<SocketAddr> {
     Vec::new()
 }
