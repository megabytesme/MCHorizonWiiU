diff --git a/wiiu/platform/src/netconf_bridge.c b/wiiu/platform/src/netconf_bridge.c
new file mode 100644
index 0000000000000000000000000000000000000000..cf301fc75829b226f63feb3de866cf336281975c
--- /dev/null
+++ b/wiiu/platform/src/netconf_bridge.c
@@ -0,0 +1,49 @@
+#include <coreinit/dynload.h>
+#include <nsysnet/netconfig.h>
+#include <stdint.h>
+#include <string.h>
+
+typedef __typeof__(&netconf_init) NetConfInit;
+typedef __typeof__(&netconf_close) NetConfClose;
+typedef __typeof__(&netconf_get_assigned_dns) NetConfAssignedDns;
+
+static void *find_export(OSDynLoad_Module module, const char *name)
+{
+   void *address = NULL;
+   return OSDynLoad_FindExport(module, OS_DYNLOAD_EXPORT_FUNC, name, &address) == OS_DYNLOAD_OK
+          ? address : NULL;
+}
+
+static unsigned read_interface(NetConfAssignedDns assigned, NetConfInterfaceType interface,
+                               uint8_t addresses[2][4])
+{
+   uint32_t primary = 0, secondary = 0;
+   if (assigned(interface, &primary, &secondary) != 0) return 0;
+
+   // CafeOS runs big-endian. Preserve the network bytes supplied by NetConf.
+   unsigned count = 0;
+   if (primary != 0 && primary != UINT32_MAX)
+      memcpy(addresses[count++], &primary, sizeof(primary));
+   if (secondary != 0 && secondary != UINT32_MAX && secondary != primary)
+      memcpy(addresses[count++], &secondary, sizeof(secondary));
+   return count;
+}
+
+// The caller serializes init/read/close on the protocol's network threads.
+unsigned horizon_cafe_system_name_servers(uint8_t addresses[2][4])
+{
+   OSDynLoad_Module module = NULL;
+   if (OSDynLoad_Acquire("nsysnet.rpl", &module) != OS_DYNLOAD_OK) return 0;
+   NetConfInit init = (NetConfInit)find_export(module, "netconf_init");
+   NetConfClose close = (NetConfClose)find_export(module, "netconf_close");
+   NetConfAssignedDns assigned = (NetConfAssignedDns)find_export(module, "netconf_get_assigned_dns");
+   unsigned count = 0;
+   if (init && close && assigned && init() == 0) {
+      count = read_interface(assigned, NET_CONF_INTERFACE_TYPE_WIFI, addresses);
+      if (count == 0)
+         count = read_interface(assigned, NET_CONF_INTERFACE_TYPE_ETHERNET, addresses);
+      close();
+   }
+   OSDynLoad_Release(module);
+   return count;
+}
