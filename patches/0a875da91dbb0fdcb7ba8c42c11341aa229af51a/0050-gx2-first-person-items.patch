diff --git a/wiiu/loading_host/hand.c b/wiiu/loading_host/hand.c
new file mode 100644
index 0000000000000000000000000000000000000000..09e3ecb43cf50ced0e9e3093207e87d62e3d59cd
--- /dev/null
+++ b/wiiu/loading_host/hand.c
@@ -0,0 +1,197 @@
+#include "terrain.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <gx2/draw.h>
+#include <gx2/event.h>
+#include <gx2/registers.h>
+#include <gx2/sampler.h>
+#include <gx2/shaders.h>
+#include <gx2/texture.h>
+#include <gx2/utils.h>
+#include <gx2r/buffer.h>
+#include <gx2r/draw.h>
+#include <whb/gfx.h>
+
+extern const uint8_t _binary_hand_gsh_start[];
+
+typedef struct HandVertex {
+   float position_light[4], uv[2];
+   uint8_t color[4];
+   int8_t normal[4];
+} HandVertex;
+
+_Static_assert(sizeof(HandVertex) == 32, "hand vertex ABI changed");
+_Static_assert(offsetof(HandVertex, uv) == 16, "hand UV offset changed");
+_Static_assert(offsetof(HandVertex, color) == 24, "hand color offset changed");
+_Static_assert(offsetof(HandVertex, normal) == 28, "hand normal offset changed");
+
+enum { DEPTH_TRIANGLE_VERTICES = 3, HAND_MAX_VERTICES = 4096 * 6 };
+
+typedef struct HorizonGx2Hand {
+   WHBGfxShaderGroup shader;
+   GX2RBuffer vertices[2];
+   GX2Sampler sampler;
+   uint32_t vertex_uniforms[5];
+   uint32_t pixel_uniforms[2];
+   uint32_t lightmap_slot, atlas_slot;
+} HorizonGx2Hand;
+
+static bool uniform_offset(const GX2UniformVar *var, uint32_t *offset)
+{
+   if (!var || var->type != GX2_SHADER_VAR_TYPE_FLOAT4 || var->count != 1 || var->block >= 0)
+      return false;
+   *offset = var->offset;
+   return true;
+}
+
+static bool sampler_slot(const GX2SamplerVar *vars, unsigned count, const char *name, uint32_t *out)
+{
+   for (unsigned i = 0; vars && i < count; ++i) {
+      if (vars[i].type == GX2_SAMPLER_VAR_TYPE_SAMPLER_2D && vars[i].name &&
+          !strcmp(vars[i].name, name)) {
+         *out = vars[i].location;
+         return true;
+      }
+   }
+   return false;
+}
+
+int horizon_gx2_hand_create(HorizonGx2Hand **out)
+{
+   if (!out) return -1;
+   *out = NULL;
+   HorizonGx2Hand *hand = calloc(1, sizeof(*hand));
+   if (!hand) return -2;
+   WHBGfxShaderGroup *shader = &hand->shader;
+   if (!WHBGfxLoadGFDShaderGroup(shader, 0, _binary_hand_gsh_start)) {
+      free(hand);
+      return -3;
+   }
+   GX2VertexShader *vs = shader->vertexShader;
+   GX2PixelShader *ps = shader->pixelShader;
+   if (!vs || !ps || vs->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       ps->mode != GX2_SHADER_MODE_UNIFORM_REGISTER) goto fail;
+   const char *vertex_names[] = {"uClipX", "uClipY", "uClipZ", "uClipW", "uOptions"};
+   const char *pixel_names[] = {"uFogColor", "uFogRanges"};
+   for (unsigned i = 0; i < 5; ++i)
+      if (!uniform_offset(GX2GetVertexUniformVar(vs, vertex_names[i]), &hand->vertex_uniforms[i]))
+         goto fail;
+   for (unsigned i = 0; i < 2; ++i)
+      if (!uniform_offset(GX2GetPixelUniformVar(ps, pixel_names[i]), &hand->pixel_uniforms[i]))
+         goto fail;
+   if (!sampler_slot(vs->samplerVars, vs->samplerVarCount, "uLightmap", &hand->lightmap_slot) ||
+       !sampler_slot(ps->samplerVars, ps->samplerVarCount, "uAtlas", &hand->atlas_slot) ||
+       !WHBGfxInitShaderAttribute(shader, "aPositionLight", 0, offsetof(HandVertex, position_light), GX2_ATTRIB_FORMAT_FLOAT_32_32_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aUv", 0, offsetof(HandVertex, uv), GX2_ATTRIB_FORMAT_FLOAT_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aColor", 0, offsetof(HandVertex, color), GX2_ATTRIB_FORMAT_UNORM_8_8_8_8) ||
+       !WHBGfxInitShaderAttribute(shader, "aNormal", 0, offsetof(HandVertex, normal), GX2_ATTRIB_FORMAT_SNORM_8_8_8_8) ||
+       !WHBGfxInitFetchShader(shader)) goto fail;
+   GX2InitSampler(&hand->sampler, GX2_TEX_CLAMP_MODE_CLAMP, GX2_TEX_XY_FILTER_MODE_POINT);
+   *out = hand;
+   return 0;
+
+fail:
+   WHBGfxFreeShaderGroup(shader);
+   free(hand);
+   return -3;
+}
+
+void horizon_gx2_hand_destroy(HorizonGx2Hand *hand)
+{
+   if (!hand) return;
+   GX2DrawDone();
+   for (unsigned i = 0; i < 2; ++i) {
+      GX2RBuffer *buffer = &hand->vertices[i];
+      if (GX2RBufferExists(buffer)) GX2RDestroyBufferEx(buffer, 0);
+   }
+   WHBGfxFreeShaderGroup(&hand->shader);
+   free(hand);
+}
+
+static int upload(GX2RBuffer *buffer, const HandVertex *vertices, uint32_t count)
+{
+   const uint32_t needed = count + DEPTH_TRIANGLE_VERTICES;
+   if (needed > buffer->elemCount) {
+      uint32_t capacity = buffer->elemCount ? buffer->elemCount : 64;
+      while (capacity < needed) capacity *= 2;
+      if (capacity > HAND_MAX_VERTICES + DEPTH_TRIANGLE_VERTICES)
+         capacity = HAND_MAX_VERTICES + DEPTH_TRIANGLE_VERTICES;
+      GX2RBuffer replacement = {
+         .flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER | GX2R_RESOURCE_USAGE_CPU_WRITE |
+                  GX2R_RESOURCE_USAGE_GPU_READ,
+         .elemSize = sizeof(HandVertex), .elemCount = capacity,
+      };
+      if (!GX2RCreateBuffer(&replacement)) return -2;
+      if (GX2RBufferExists(buffer)) GX2RDestroyBufferEx(buffer, 0);
+      *buffer = replacement;
+   }
+   HandVertex *mapped = GX2RLockBufferEx(buffer, 0);
+   if (!mapped) return -2;
+   const HandVertex reset[DEPTH_TRIANGLE_VERTICES] = {
+      {.position_light = {-1.0f, -1.0f, 1.0f, 0}},
+      {.position_light = { 3.0f, -1.0f, 1.0f, 0}},
+      {.position_light = {-1.0f,  3.0f, 1.0f, 0}},
+   };
+   memcpy(mapped, reset, sizeof(reset));
+   memcpy(mapped + DEPTH_TRIANGLE_VERTICES, vertices, count * sizeof(*mapped));
+   GX2RUnlockBufferEx(buffer, 0);
+   return 0;
+}
+
+int horizon_gx2_hand_draw(HorizonGx2Hand *hand, uint32_t target, const uint32_t rect[4],
+                          const GX2Texture *atlas, const HorizonGx2Terrain *terrain,
+                          const HandVertex *vertices, uint32_t count, const float clip_rows[16],
+                          const float fog_color[4], const float fog_ranges[4], uint32_t nether)
+{
+   if (!hand || target > 1 || !rect || !rect[2] || !rect[3] || !atlas || !atlas->surface.image ||
+       !terrain || !vertices || !count || count % 6 || count > HAND_MAX_VERTICES ||
+       !clip_rows || !fog_color || !fog_ranges) return -1;
+   GX2RBuffer *buffer = &hand->vertices[target];
+   int result = upload(buffer, vertices, count);
+   if (result) return result;
+
+   WHBGfxShaderGroup *shader = &hand->shader;
+   GX2SetViewport(rect[0], rect[1], rect[2], rect[3], 0, 1);
+   GX2SetScissor(rect[0], rect[1], rect[2], rect[3]);
+   GX2SetShaderMode(shader->vertexShader->mode);
+   GX2SetFetchShader(&shader->fetchShader);
+   GX2SetVertexShader(shader->vertexShader);
+   GX2SetPixelShader(shader->pixelShader);
+   for (unsigned row = 0; row < 4; ++row)
+      GX2SetVertexUniformReg(hand->vertex_uniforms[row], 4, clip_rows + 4 * row);
+   GX2SetPixelUniformReg(hand->pixel_uniforms[0], 4, fog_color);
+   GX2SetPixelUniformReg(hand->pixel_uniforms[1], 4, fog_ranges);
+   horizon_gx2_terrain_bind_lightmap(terrain, hand->lightmap_slot);
+   GX2SetPixelTexture(atlas, hand->atlas_slot);
+   GX2SetPixelSampler(&hand->sampler, hand->atlas_slot);
+   GX2RSetAttributeBuffer(buffer, 0, sizeof(HandVertex), 0);
+   GX2SetCullOnlyControl(GX2_FRONT_FACE_CCW, FALSE, FALSE);
+   GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+   GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0.0f);
+   GX2SetColorControl(GX2_LOGIC_OP_COPY, 1, FALSE, TRUE);
+
+   /* Clear the bound world depth without changing attachments or colour. */
+   float options[4] = {(float)(nether != 0), 1.0f, 0, 0};
+   GX2SetVertexUniformReg(hand->vertex_uniforms[4], 4, options);
+   GX2SetDepthOnlyControl(TRUE, TRUE, GX2_COMPARE_FUNC_ALWAYS);
+   GX2SetTargetChannelMasks((GX2ChannelMask)0, (GX2ChannelMask)0, (GX2ChannelMask)0,
+                            (GX2ChannelMask)0, (GX2ChannelMask)0, (GX2ChannelMask)0,
+                            (GX2ChannelMask)0, (GX2ChannelMask)0);
+   GX2DrawEx(GX2_PRIMITIVE_MODE_TRIANGLES, DEPTH_TRIANGLE_VERTICES, 0, 1);
+
+   options[1] = 0.0f;
+   GX2SetVertexUniformReg(hand->vertex_uniforms[4], 4, options);
+   GX2SetDepthOnlyControl(TRUE, TRUE, GX2_COMPARE_FUNC_LEQUAL);
+   GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, (GX2ChannelMask)0, (GX2ChannelMask)0,
+                            (GX2ChannelMask)0, (GX2ChannelMask)0, (GX2ChannelMask)0,
+                            (GX2ChannelMask)0, (GX2ChannelMask)0);
+   GX2SetBlendControl(GX2_RENDER_TARGET_0, GX2_BLEND_MODE_SRC_ALPHA, GX2_BLEND_MODE_INV_SRC_ALPHA,
+                      GX2_BLEND_COMBINE_MODE_ADD, TRUE, GX2_BLEND_MODE_ONE,
+                      GX2_BLEND_MODE_INV_SRC_ALPHA, GX2_BLEND_COMBINE_MODE_ADD);
+   GX2DrawEx(GX2_PRIMITIVE_MODE_TRIANGLES, count, DEPTH_TRIANGLE_VERTICES, 1);
+   return 0;
+}
