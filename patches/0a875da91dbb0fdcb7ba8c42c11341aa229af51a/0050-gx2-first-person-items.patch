+#version 330
+layout(location = 0) in vec4 aPositionLight;
+layout(location = 1) in vec2 aUv;
+layout(location = 2) in vec4 aColor;
+layout(location = 3) in vec4 aNormal;
+uniform vec4 uClipX;
+uniform vec4 uClipY;
+uniform vec4 uClipZ;
+uniform vec4 uClipW;
+uniform vec4 uOptions;
+uniform sampler2D uLightmap;
+out vec2 vUv;
+out vec4 vColor;
+out vec2 vFogDistance;
+out vec4 vShade;
+
+float shade(vec3 normal, vec3 l0, vec3 l1) {
+    return min(1.0, (max(0.0, dot(l0, normal)) + max(0.0, dot(l1, normal))) * 0.6 + 0.4);
+}
+
+void main() {
+    vShade = vec4(1.0, 1.0, 0.0, uOptions.y);
+    vec3 position = aPositionLight.xyz;
+    if (uOptions.y > 0.5) {
+        gl_Position = vec4(position, 1.0);
+        vUv = vec2(0.0);
+        vColor = vec4(0.0);
+        vFogDistance = vec2(0.0);
+        return;
+    }
+    vec4 pos = vec4(position, 1.0);
+    gl_Position = vec4(dot(uClipX, pos), dot(uClipY, pos),
+                       dot(uClipZ, pos), dot(uClipW, pos));
+    float packedLight = aPositionLight.w;
+    vec2 levels = min(vec2(floor(packedLight / 256.0), mod(packedLight, 256.0)), vec2(240.0));
+    vec2 lightUv = levels / 256.0 + vec2(0.5 / 16.0);
+    vColor = aColor * textureLod(uLightmap, lightUv, 0.0);
+    vUv = aUv;
+    vFogDistance = vec2(length(position), max(length(position.xz), abs(position.y)));
+
+    float mode = aNormal.w;
+    if ((mode > 0.0 && mode < 0.5) || (mode < 0.0 && mode > -0.996)) vShade.z = 1.0;
+    if (abs(mode) >= 0.5) {
+        vec3 l0 = normalize(vec3(0.2, 1.0, -0.7));
+        vec3 l1 = normalize(vec3(-0.2, uOptions.x > 0.5 ? -1.0 : 1.0, 0.7));
+        vShade.x = shade(aNormal.xyz, l0, l1);
+        vShade.y = mode < 0.0 ? shade(-aNormal.xyz, l0, l1) : vShade.x;
+    }
+}
