+    gfx::{Frame, TRANSLUCENT_GLINT_ITEM_OVERLAY, TRANSLUCENT_ITEM_OVERLAY, fog_uniform},
+};
+use horizon_wiiu_gx2_terrain::terrain_view_rows;
+use horizon_wiiu_platform::hud::horizon::HorizonPresenter;
+use std::{ffi::c_void, ptr::NonNull};
+
+const MAX_QUADS: usize = 4096;
+const CORNERS: [usize; 6] = [0, 1, 2, 0, 2, 3];
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct Vertex {
+    position_light: [f32; 4],
+    uv: [f32; 2],
+    color: [u8; 4],
+    normal: [i8; 4],
+}
+
+const _: () = {
+    assert!(std::mem::size_of::<Vertex>() == 32);
+    assert!(std::mem::offset_of!(Vertex, uv) == 16);
+    assert!(std::mem::offset_of!(Vertex, color) == 24);
+    assert!(std::mem::offset_of!(Vertex, normal) == 28);
+};
+
+unsafe extern "C" {
+    fn horizon_gx2_hand_create(out: *mut *mut c_void) -> i32;
+    fn horizon_gx2_hand_destroy(hand: *mut c_void);
+    fn horizon_gx2_hand_draw(
+        hand: *mut c_void,
+        target: u32,
+        rect: *const u32,
+        atlas: *const c_void,
+        terrain: *const c_void,
+        vertices: *const Vertex,
+        vertex_count: u32,
+        clip_rows: *const f32,
+        fog_color: *const f32,
+        fog_ranges: *const f32,
+        nether_lighting: u32,
+    ) -> i32;
+}
+
+#[derive(Default)]
+pub(crate) struct Hand {
+    native: Option<NonNull<c_void>>,
+    vertices: Vec<Vertex>,
+}
+
+impl Hand {
+    pub(crate) fn is_empty(&self) -> bool {
+        self.vertices.is_empty()
+    }
+
+    /// Return true if active material effects or geometry exceeded this path.
+    pub(crate) fn prepare(&mut self, frame: &Frame<'_>) -> bool {
+        self.vertices.clear();
+        let mut partial = !frame.hand.len().is_multiple_of(4);
+        for quad in frame.hand.chunks_exact(4) {
+            if self.vertices.len() == MAX_QUADS * CORNERS.len() {
+                return true;
+            }
+            match quad[0].layer & 0xffff {
+                0 | TRANSLUCENT_ITEM_OVERLAY => {}
+                7 | 8 | TRANSLUCENT_GLINT_ITEM_OVERLAY => {
+                    // The unenchanted base still uses the shared item atlas.
+                    partial |= frame.glint_alpha > 0.0;
+                }
+                _ => {
+                    partial = true;
+                    continue;
+                }
+            }
+            let vertices = [quad[0], quad[1], quad[2], quad[3]].map(|vertex| {
+                let [x, y, z] = vertex.pos;
+                Vertex {
+                    position_light: [x, y, z, (vertex.light & 0xffff) as f32],
+                    uv: vertex.uv,
+                    color: vertex.color.to_le_bytes(),
+                    normal: vertex.normal,
+                }
+            });
+            self.vertices.extend(CORNERS.map(|corner| vertices[corner]));
+        }
+        partial
+    }
+
+    pub(crate) fn draw(
+        &mut self,
+        frame: &Frame<'_>,
+        target: u32,
+        rect: [u32; 4],
+        aspect: f32,
+        hud: &HorizonPresenter<'_>,
+        terrain: NonNull<c_void>,
+    ) -> Result<(), &'static str> {
+        if self.is_empty() {
+            return Ok(());
+        }
+        let native = match self.native {
+            Some(native) => native,
+            None => {
+                let mut resource = std::ptr::null_mut();
+                if unsafe { horizon_gx2_hand_create(&mut resource) } != 0 {
+                    return Err("could not create the GX2 first-person pipeline");
+                }
+                let native = NonNull::new(resource).ok_or("missing GX2 first-person pipeline")?;
+                self.native = Some(native);
+                native
+            }
+        };
+        // The shared hand vertices are in camera-relative world space. Match
+        // the hand projection and bob without applying the level's spin.
+        let view = frame.bob * camera::view_matrix(frame.yaw, frame.pitch);
+        let perspective = camera::perspective(
+            frame.hand_fov_degrees,
+            aspect,
+            1.0,
+            0.05,
+            frame.depth_far,
+            true,
+        );
+        let projection = terrain_view_rows(
+            view.transpose().to_cols_array_2d(),
+            perspective[5],
+            aspect,
+            perspective[10],
+            perspective[14],
+        );
+        let (fog_color, fog_ranges) = fog_uniform(frame);
+        let result = hud.with_native_atlas(|atlas| {
+            // The active output has completed its previous frame's uses.
+            // This copies the scratch vertices, binds the existing textures,
+            // and resets only the depth of the currently bound world target.
+            unsafe {
+                horizon_gx2_hand_draw(
+                    native.as_ptr(),
+                    target,
+                    rect.as_ptr(),
+                    atlas,
+                    terrain.as_ptr(),
+                    self.vertices.as_ptr(),
+                    self.vertices.len() as u32,
+                    projection.rows.as_ptr().cast(),
+                    fog_color.as_ptr(),
+                    fog_ranges.as_ptr(),
+                    u32::from(frame.nether_lighting),
+                )
+            }
+        });
+        if result == 0 {
+            Ok(())
+        } else {
+            Err("GX2 first-person draw failed")
+        }
+    }
+}
+
+impl Drop for Hand {
+    fn drop(&mut self) {
+        if let Some(native) = self.native.take() {
+            unsafe { horizon_gx2_hand_destroy(native.as_ptr()) };
+        }
+    }
+}
