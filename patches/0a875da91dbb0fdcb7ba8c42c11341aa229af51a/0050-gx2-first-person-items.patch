diff --git a/wiiu/loading_host/hand.frag b/wiiu/loading_host/hand.frag
new file mode 100644
index 0000000000000000000000000000000000000000..70be886c74a7881e9d28e6d5392ad5b7cb5ee77b
--- /dev/null
+++ b/wiiu/loading_host/hand.frag
@@ -0,0 +1,28 @@
+#version 330
+uniform sampler2D uAtlas;
+uniform vec4 uFogColor;
+uniform vec4 uFogRanges;
+in vec2 vUv;
+in vec4 vColor;
+in vec2 vFogDistance;
+in vec4 vShade;
+out vec4 fragColor;
+
+float linearFog(float distance, float start, float end) {
+    if (distance <= start) return 0.0;
+    if (distance >= end) return 1.0;
+    return (distance - start) / (end - start);
+}
+
+void main() {
+    if (vShade.w > 0.5) {
+        fragColor = vec4(0.0);
+        return;
+    }
+    vec4 color = texture(uAtlas, vUv) * vColor;
+    if (color.a < 0.1 || (vShade.z > 0.5 && !gl_FrontFacing)) discard;
+    color.rgb *= gl_FrontFacing ? vShade.x : vShade.y;
+    float fog = max(linearFog(vFogDistance.x, uFogRanges.x, uFogRanges.y),
+                    linearFog(vFogDistance.y, uFogRanges.z, uFogRanges.w));
+    fragColor = vec4(mix(color.rgb, uFogColor.rgb, fog * uFogColor.a), color.a);
+}
