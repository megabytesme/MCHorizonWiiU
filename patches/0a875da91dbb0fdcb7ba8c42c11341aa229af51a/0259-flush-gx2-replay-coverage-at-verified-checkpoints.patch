+enum { SOLID_REPLAY_PAIRS = 120, SOLID_REPLAY_WINDOWS = 64 };
+typedef struct {
+   uint32_t first, last, cold[2], warm[2], warm_both, min_sections[2], max_sections[2];
+} SolidReplayReport;
+typedef struct {
+   uint64_t start, end;
+   SolidReplayReport report;
+} SolidReplaySample;
+static uint32_t solid_replay_count;
+static SolidReplaySample solid_replays[SOLID_REPLAY_WINDOWS];
+_Static_assert(sizeof(SolidReplayReport) == 44, "Rust solid replay report FFI size");
+_Static_assert(sizeof(solid_replays) <= 4 * 1024, "bounded solid replay storage");
+
+static uint64_t solid_replay_row_start(const ProfileFrame *frame)
+{
+   return ((uint64_t)frame->start_hi << 32) | frame->start_lo;
+}
+
+void horizon_gx2_profile_record_solid_replay(const SolidReplayReport *report)
+{
+   if (!report || !horizon_gx2_profile_solid_list_replay() || !recording ||
+       current.phase != PLAYING_PHASE || solid_replay_count >= SOLID_REPLAY_WINDOWS ||
+       report->last != history->total || report->first > report->last ||
+       report->last - report->first != SOLID_REPLAY_PAIRS - 1) return;
+   const ProfileFrame *first = &history->ring[report->first % CAPACITY];
+   if (first->sequence != report->first || first->phase != PLAYING_PHASE) return;
+   solid_replays[solid_replay_count++] = (SolidReplaySample){
+      .start = solid_replay_row_start(first),
+      .end = started - history->epoch,
+      .report = *report,
+   };
+}
+
+static void report_solid_replay(void)
+{
+   for (uint32_t i = 0; i < solid_replay_count; ++i) {
+      const SolidReplaySample *sample = &solid_replays[i];
+      const SolidReplayReport *row = &sample->report;
+      if (row->last >= history->total || history->total - row->first > CAPACITY) continue;
+      const ProfileFrame *last = &history->ring[row->last % CAPACITY];
+      if (last->sequence != row->last || last->phase != PLAYING_PHASE ||
+          solid_replay_row_start(last) != sample->end) continue;
+      OSReport("Horizon GX2 solid list replay first=%u last=%u start=%llx end=%llx "
+               "tv_cold=%u drc_cold=%u tv_warm=%u drc_warm=%u warm_both=%u "
+               "tv_min=%u drc_min=%u tv_max=%u drc_max=%u\n", row->first, row->last,
+               (unsigned long long)sample->start, (unsigned long long)sample->end,
+               row->cold[0], row->cold[1], row->warm[0], row->warm[1], row->warm_both,
+               row->min_sections[0], row->min_sections[1], row->max_sections[0], row->max_sections[1]);
+   }
+   solid_replay_count = 0;
+}
+
 bool horizon_gx2_profile_solid_list_census(void)
