diff --git a/wiiu/loading_host/outline.c b/wiiu/loading_host/outline.c
new file mode 100644
index 0000000000000000000000000000000000000000..4007263ae7c988c271a629cf167387b8244a62c0
--- /dev/null
+++ b/wiiu/loading_host/outline.c
@@ -0,0 +1,136 @@
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <gx2/draw.h>
+#include <gx2/event.h>
+#include <gx2/registers.h>
+#include <gx2/shaders.h>
+#include <gx2/utils.h>
+#include <gx2r/buffer.h>
+#include <gx2r/draw.h>
+#include <whb/gfx.h>
+
+extern const uint8_t _binary_outline_gsh_start[];
+
+typedef struct OutlineVertex {
+   float clip[4];
+   float fog_distance[2];
+   uint8_t rgba[4];
+} OutlineVertex;
+
+_Static_assert(sizeof(OutlineVertex) == 28, "outline vertex ABI changed");
+_Static_assert(offsetof(OutlineVertex, fog_distance) == 16, "outline fog offset changed");
+_Static_assert(offsetof(OutlineVertex, rgba) == 24, "outline color offset changed");
+
+typedef struct HorizonGx2Outline {
+   WHBGfxShaderGroup shader;
+   GX2RBuffer vertices[2];
+   uint32_t fog_color_offset;
+   uint32_t fog_ranges_offset;
+} HorizonGx2Outline;
+
+static bool uniform_offset(const GX2PixelShader *shader, const char *name, uint32_t *offset)
+{
+   const GX2UniformVar *var = GX2GetPixelUniformVar(shader, name);
+   if (!var || var->type != GX2_SHADER_VAR_TYPE_FLOAT4 || var->count != 1 || var->block >= 0)
+      return false;
+   *offset = var->offset;
+   return true;
+}
+
+static void release(HorizonGx2Outline *outline)
+{
+   for (unsigned i = 0; i < 2; ++i)
+      if (GX2RBufferExists(&outline->vertices[i])) GX2RDestroyBufferEx(&outline->vertices[i], 0);
+   if (outline->shader.vertexShader) WHBGfxFreeShaderGroup(&outline->shader);
+   free(outline);
+}
+
+int horizon_gx2_outline_create(HorizonGx2Outline **out, uint32_t capacity)
+{
+   if (!out || !capacity || capacity > UINT32_MAX / sizeof(OutlineVertex)) return -1;
+   *out = NULL;
+   HorizonGx2Outline *outline = calloc(1, sizeof(*outline));
+   if (!outline) return -2;
+
+   WHBGfxShaderGroup *shader = &outline->shader;
+   if (!WHBGfxLoadGFDShaderGroup(shader, 0, _binary_outline_gsh_start) ||
+       !shader->vertexShader || !shader->pixelShader ||
+       shader->vertexShader->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       shader->pixelShader->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       !uniform_offset(shader->pixelShader, "uFogColor", &outline->fog_color_offset) ||
+       !uniform_offset(shader->pixelShader, "uFogRanges", &outline->fog_ranges_offset) ||
+       !WHBGfxInitShaderAttribute(shader, "aClip", 0, offsetof(OutlineVertex, clip), GX2_ATTRIB_FORMAT_FLOAT_32_32_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aFogDistance", 0, offsetof(OutlineVertex, fog_distance), GX2_ATTRIB_FORMAT_FLOAT_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aColor", 0, offsetof(OutlineVertex, rgba), GX2_ATTRIB_FORMAT_UNORM_8_8_8_8) ||
+       !WHBGfxInitFetchShader(shader)) {
+      release(outline);
+      return -3;
+   }
+   const GX2RResourceFlags flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER |
+      GX2R_RESOURCE_USAGE_CPU_WRITE | GX2R_RESOURCE_USAGE_GPU_READ;
+   for (unsigned i = 0; i < 2; ++i) {
+      GX2RBuffer *buffer = &outline->vertices[i];
+      *buffer = (GX2RBuffer){ .flags = flags, .elemSize = sizeof(OutlineVertex), .elemCount = capacity };
+      if (!GX2RCreateBuffer(buffer)) {
+         release(outline);
+         return -2;
+      }
+   }
+   *out = outline;
+   return 0;
+}
+
+void horizon_gx2_outline_destroy(HorizonGx2Outline *outline)
+{
+   if (!outline) return;
+   GX2DrawDone();
+   release(outline);
+}
+
+int horizon_gx2_outline_draw(HorizonGx2Outline *outline, uint32_t target, const uint32_t rect[4],
+                             const OutlineVertex *vertices, uint32_t count, uint32_t secondary_count,
+                             const float fog_color[4], const float fog_ranges[4])
+{
+   if (!outline || target > 1 || !rect || !rect[2] || !rect[3] || !vertices ||
+       !count || count % 6 || secondary_count % 6 || secondary_count > count ||
+       !fog_color || !fog_ranges) return -1;
+   GX2RBuffer *buffer = &outline->vertices[target];
+   if (count > buffer->elemCount) return -1;
+   void *mapped = GX2RLockBufferEx(buffer, 0);
+   if (!mapped) return -2;
+   memcpy(mapped, vertices, count * sizeof(*vertices));
+   GX2RUnlockBufferEx(buffer, 0);
+
+   WHBGfxShaderGroup *shader = &outline->shader;
+   GX2SetViewport(rect[0], rect[1], rect[2], rect[3], 0, 1);
+   GX2SetScissor(rect[0], rect[1], rect[2], rect[3]);
+   GX2SetShaderMode(shader->vertexShader->mode);
+   GX2SetFetchShader(&shader->fetchShader);
+   GX2SetVertexShader(shader->vertexShader);
+   GX2SetPixelShader(shader->pixelShader);
+   GX2SetPixelUniformReg(outline->fog_color_offset, 4, fog_color);
+   GX2SetPixelUniformReg(outline->fog_ranges_offset, 4, fog_ranges);
+   GX2RSetAttributeBuffer(buffer, 0, sizeof(OutlineVertex), 0);
+   GX2SetCullOnlyControl(GX2_FRONT_FACE_CCW, FALSE, FALSE);
+   GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+   GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0.0f);
+   GX2SetColorControl(GX2_LOGIC_OP_COPY, 1, FALSE, TRUE);
+   GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, (GX2ChannelMask)0, (GX2ChannelMask)0,
+                            (GX2ChannelMask)0, (GX2ChannelMask)0, (GX2ChannelMask)0,
+                            (GX2ChannelMask)0, (GX2ChannelMask)0);
+   GX2SetBlendControl(GX2_RENDER_TARGET_0, GX2_BLEND_MODE_SRC_ALPHA, GX2_BLEND_MODE_INV_SRC_ALPHA,
+                      GX2_BLEND_COMBINE_MODE_ADD, TRUE, GX2_BLEND_MODE_ONE,
+                      GX2_BLEND_MODE_INV_SRC_ALPHA, GX2_BLEND_COMBINE_MODE_ADD);
+   if (secondary_count) {
+      GX2SetDepthOnlyControl(TRUE, FALSE, GX2_COMPARE_FUNC_LEQUAL);
+      GX2DrawEx(GX2_PRIMITIVE_MODE_TRIANGLES, secondary_count, 0, 1);
+   }
+   if (count > secondary_count) {
+      GX2SetDepthOnlyControl(TRUE, TRUE, GX2_COMPARE_FUNC_LEQUAL);
+      GX2DrawEx(GX2_PRIMITIVE_MODE_TRIANGLES, count - secondary_count, secondary_count, 1);
+   }
+   return 0;
+}
diff --git a/wiiu/loading_host/outline.frag b/wiiu/loading_host/outline.frag
new file mode 100644
index 0000000000000000000000000000000000000000..8db26821906661327d74d837cfd1f820267ab4cf
--- /dev/null
+++ b/wiiu/loading_host/outline.frag
@@ -0,0 +1,18 @@
+#version 330
+uniform vec4 uFogColor;
+uniform vec4 uFogRanges;
+in vec2 vFogDistance;
+in vec4 vColor;
+out vec4 fragColor;
+
+float linearFog(float distance, float start, float end) {
+    if (distance <= start) return 0.0;
+    if (distance >= end) return 1.0;
+    return (distance - start) / (end - start);
+}
+
+void main() {
+    float fog = max(linearFog(vFogDistance.x, uFogRanges.x, uFogRanges.y),
+                    linearFog(vFogDistance.y, uFogRanges.z, uFogRanges.w));
+    fragColor = vec4(mix(vColor.rgb, uFogColor.rgb, fog * uFogColor.a), vColor.a);
+}
diff --git a/wiiu/loading_host/outline.rs b/wiiu/loading_host/outline.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d6bf38b0ffdf1c00c617328cc0e723dded0f7326
--- /dev/null
+++ b/wiiu/loading_host/outline.rs
@@ -0,0 +1,118 @@
+//! GX2 block selection using the same world projection and fog as terrain.
+
+use crate::TerrainProjection;
+use horizon_client::gfx::{fog_uniform, outline_width, Frame};
+use std::{ffi::c_void, ptr::NonNull};
+
+#[path = "outline_vertices.rs"]
+mod geometry;
+
+unsafe extern "C" {
+    fn horizon_gx2_outline_create(out: *mut *mut c_void, capacity: u32) -> i32;
+    fn horizon_gx2_outline_destroy(outline: *mut c_void);
+    fn horizon_gx2_outline_draw(
+        outline: *mut c_void,
+        target: u32,
+        rect: *const u32,
+        vertices: *const geometry::Vertex,
+        count: u32,
+        secondary_count: u32,
+        fog_color: *const f32,
+        fog_ranges: *const f32,
+    ) -> i32;
+}
+
+#[derive(Default)]
+pub(crate) struct Outline {
+    native: Option<NonNull<c_void>>,
+    vertices: Vec<geometry::Vertex>,
+}
+
+impl Outline {
+    pub(crate) fn draw(
+        &mut self,
+        frame: &Frame<'_>,
+        projection: &TerrainProjection,
+        target: u32,
+        rect: [u32; 4],
+    ) -> Result<(), &'static str> {
+        if frame.outline.is_empty() {
+            return Ok(());
+        }
+
+        let [_, _, width, height] = rect;
+        let (custom, scale) = frame.pvp.outline.map_or((None, 1.0), |(c, s)| (Some(c), s));
+        let edges = &frame.outline[..frame.outline.len().min(geometry::MAX_EDGES)];
+        self.vertices.clear();
+        let mut add_stroke = |argb, stroke_width| {
+            for &edge in edges {
+                geometry::append_edge(
+                    &mut self.vertices,
+                    edge,
+                    projection.camera,
+                    |position| projection.clip.transform(position),
+                    [width, height],
+                    stroke_width * scale,
+                    argb,
+                );
+            }
+            self.vertices.len() as u32
+        };
+        let secondary = if frame.outline_high_contrast {
+            add_stroke(0xff00_0000, 7.0)
+        } else {
+            0
+        };
+        let default = if frame.outline_high_contrast {
+            0xff57_ffe1
+        } else {
+            0x6600_0000
+        };
+        let count = add_stroke(custom.unwrap_or(default), outline_width(width));
+        if count == 0 {
+            return Ok(());
+        }
+
+        let native = match self.native {
+            Some(native) => native,
+            None => {
+                let mut resource = std::ptr::null_mut();
+                let capacity = 2 * geometry::MAX_EDGES * geometry::VERTICES_PER_EDGE;
+                if unsafe { horizon_gx2_outline_create(&mut resource, capacity as u32) } != 0 {
+                    return Err("could not allocate the GX2 block outline");
+                }
+                let native = NonNull::new(resource).ok_or("missing GX2 block outline")?;
+                self.native = Some(native);
+                native
+            }
+        };
+        let (fog_color, fog_ranges) = fog_uniform(frame);
+        // The callback owns the active output and the pre-terrain wait has
+        // retired the last use of this output's backing. The upload copies
+        // the CPU scratch before the synchronous call returns.
+        if unsafe {
+            horizon_gx2_outline_draw(
+                native.as_ptr(),
+                target,
+                rect.as_ptr(),
+                self.vertices.as_ptr(),
+                count,
+                secondary,
+                fog_color.as_ptr(),
+                fog_ranges.as_ptr(),
+            )
+        } != 0
+        {
+            return Err("GX2 block outline draw failed");
+        }
+        Ok(())
+    }
+}
+
+impl Drop for Outline {
+    fn drop(&mut self) {
+        if let Some(native) = self.native.take() {
+            unsafe { horizon_gx2_outline_destroy(native.as_ptr()) };
+        }
+    }
+}
