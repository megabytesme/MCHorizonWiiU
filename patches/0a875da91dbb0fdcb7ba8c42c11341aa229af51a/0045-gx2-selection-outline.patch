diff --git a/wiiu/loading_host/outline_vertices.rs b/wiiu/loading_host/outline_vertices.rs
new file mode 100644
index 0000000000000000000000000000000000000000..acb30d923bac4e5abe1bb8566104c1e01200a608
--- /dev/null
+++ b/wiiu/loading_host/outline_vertices.rs
@@ -0,0 +1,146 @@
+//! Selection strokes expanded to clip-space triangles for GX2.
+
+pub const MAX_EDGES: usize = 256;
+pub const VERTICES_PER_EDGE: usize = 6;
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct Vertex {
+    pub clip: [f32; 4],
+    pub fog_distance: [f32; 2],
+    pub rgba: [u8; 4],
+}
+
+const _: () = {
+    assert!(std::mem::size_of::<Vertex>() == 28);
+    assert!(std::mem::offset_of!(Vertex, fog_distance) == 16);
+    assert!(std::mem::offset_of!(Vertex, rgba) == 24);
+};
+
+fn fog_distance([x, y, z]: [f32; 3]) -> [f32; 2] {
+    [(x * x + y * y + z * z).sqrt(), x.hypot(z).max(y.abs())]
+}
+
+pub fn append_edge(
+    vertices: &mut Vec<Vertex>,
+    edge: [f64; 6],
+    camera: [f64; 3],
+    project: impl Fn([f32; 3]) -> [f32; 4],
+    [width, height]: [u32; 2],
+    stroke_width: f32,
+    argb: u32,
+) {
+    // Keep the reference line shader's perspective layering and view shrink.
+    let shrink = (1.0 - 1.0 / 4096.0) * (1.0 - 1.0 / 256.0);
+    let relative: [[f32; 3]; 2] = std::array::from_fn(|end| {
+        std::array::from_fn(|axis| (edge[end * 3 + axis] - camera[axis]) as f32)
+    });
+    let mut clip = relative.map(|position| project(position.map(|value| value * shrink)));
+    let mut fog = relative.map(fog_distance);
+    if !clip.iter().flatten().all(|value| value.is_finite()) {
+        return;
+    }
+
+    // Clip before dividing by W. The terrain projection maps the near plane
+    // to Z=0, so a segment crossing it has one visible endpoint at most.
+    if clip[0][2] < 0.0 && clip[1][2] < 0.0 {
+        return;
+    }
+    for i in 0..2 {
+        if clip[i][2] < 0.0 {
+            let other = 1 - i;
+            let t = clip[i][2] / (clip[i][2] - clip[other][2]);
+            for axis in [0, 1, 3] {
+                clip[i][axis] += (clip[other][axis] - clip[i][axis]) * t;
+            }
+            clip[i][2] = 0.0;
+            for axis in 0..2 {
+                fog[i][axis] += (fog[other][axis] - fog[i][axis]) * t;
+            }
+        }
+    }
+    if clip.iter().any(|position| position[3] <= 0.0) {
+        return;
+    }
+
+    let screen = [width as f32, height as f32];
+    let ndc = clip.map(|[x, y, _, w]| [x / w, y / w]);
+    let dx = (ndc[1][0] - ndc[0][0]) * screen[0];
+    let dy = (ndc[1][1] - ndc[0][1]) * screen[1];
+    let length = dx.hypot(dy);
+    if !length.is_finite() || length == 0.0 {
+        return;
+    }
+    let [a, r, g, b] = argb.to_be_bytes();
+    let perpendicular = [-dy / length, dx / length];
+    let corners: [Vertex; 4] = std::array::from_fn(|i| {
+        let end = i / 2;
+        let side = if i % 2 == 0 { 1.0 } else { -1.0 };
+        let mut position = clip[end];
+        for axis in 0..2 {
+            position[axis] +=
+                perpendicular[axis] * stroke_width / screen[axis] * side * position[3];
+        }
+        Vertex {
+            clip: position,
+            fog_distance: fog[end],
+            rgba: [r, g, b, a],
+        }
+    });
+    vertices.extend([0, 1, 2, 2, 1, 3].map(|i| corners[i]));
+}
