+    shapes: &mut Vec<VoxelShape>,
+    by_geometry: &mut HashMap<Vec<u64>, u16>,
+) -> u16 {
+    let key = face
+        .boxes()
+        .iter()
+        .flat_map(|b| {
+            b.min_position()
+                .components()
+                .into_iter()
+                .chain(b.max_position().components())
+        })
+        .map(f64::to_bits)
+        .collect();
+    *by_geometry.entry(key).or_insert_with(|| {
+        shapes.push(face);
+        (shapes.len() - 1) as u16
+    })
+}
