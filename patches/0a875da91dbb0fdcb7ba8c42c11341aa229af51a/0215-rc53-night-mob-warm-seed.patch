diff --git a/crates/horizon-client/src/mobs/data/cafe_seed.rs b/crates/horizon-client/src/mobs/data/cafe_seed.rs
new file mode 100644
index 0000000000000000000000000000000000000000..54e3f7df8848d1e14ea946ba472e64825631feb9
--- /dev/null
+++ b/crates/horizon-client/src/mobs/data/cafe_seed.rs
@@ -0,0 +1,285 @@
+//! Case-specific ownership for the stock prepared mob export on Cafe.
+//! Night lends one parsed base to a launch. Only a drained, saved game may
+//! move it back. Session-specific spawn overrides and pack overlays stay live.
+use super::{Animation, BlockFacts, MobData, Placement, ResourceRoot, StateData};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::HashMap,
+    path::PathBuf,
+    sync::{
+        Mutex,
+        atomic::{AtomicBool, Ordering::Relaxed},
+    },
+};
+
+const EXPORT: &str = "mob-data.json";
+const INPUT_CAP: u64 = 1_250_000;
+const RETAINED_CAP: usize = 768 * 1024;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct Key {
+    // A successful prepared decode depends only on these exact export bytes
+    // and the live facts' row count. All ID binding and fallback stay live.
+    export: [u8; 32],
+    rows: usize,
+}
+
+struct Parked {
+    root: PathBuf,
+    key: Key,
+    data: BaseMobData,
+}
+
+#[derive(Default)]
+struct Available {
+    epoch: u64,
+    parked: Option<Parked>,
+}
+
+/// Foreground Night ownership. An older launch can release its own attempt,
+/// but cannot publish into a later launch.
+#[derive(Default)]
+pub struct NightMobSeedOwner(Mutex<Available>);
+
+impl NightMobSeedOwner {
+    pub fn begin(&'static self, root: PathBuf) -> CafeMobSeedRequest {
+        let mut available = self.0.lock().unwrap_or_else(|error| error.into_inner());
+        available.epoch = available.epoch.wrapping_add(1);
+        let parked = available.parked.take().filter(|seed| seed.root == root);
+        CafeMobSeedRequest {
+            owner: self,
+            epoch: available.epoch,
+            root,
+            state: Mutex::new(Attempt::Offered(parked)),
+        }
+    }
+
+    pub fn clear(&self) {
+        let mut available = self.0.lock().unwrap_or_else(|error| error.into_inner());
+        available.epoch = available.epoch.wrapping_add(1);
+        available.parked = None;
+    }
+}
+
+enum Attempt {
+    Offered(Option<Parked>),
+    Reading,
+    Active(Key),
+    Drained(Parked),
+    Closed,
+}
+
+/// One loading generation. Does not hold any Resources, ResourceSource,
+/// pack data or active Game.
+pub struct CafeMobSeedRequest {
+    owner: &'static NightMobSeedOwner,
+    epoch: u64,
+    root: PathBuf,
+    state: Mutex<Attempt>,
+}
+
+impl CafeMobSeedRequest {
+    pub fn cancel(&self) {
+        *self.state.lock().unwrap_or_else(|error| error.into_inner()) = Attempt::Closed;
+    }
+
+    fn current(&self) -> bool {
+        self.owner
+            .0
+            .lock()
+            .unwrap_or_else(|error| error.into_inner())
+            .epoch
+            == self.epoch
+    }
+
+    pub fn is_active(&self) -> bool {
+        matches!(
+            *self.state.lock().unwrap_or_else(|error| error.into_inner()),
+            Attempt::Active(_)
+        )
+    }
+
+    // Called from the live resource worker. Read only from the direct
+    // selected source for this exact prepared root, which serves the same
+    // loose export file as the cold path. Indexed overlays are ineligible.
+    pub(super) fn load(
+        &self,
+        root: &ResourceRoot,
+        facts: &BlockFacts,
+        cancelled: &AtomicBool,
+    ) -> Option<MobData> {
+        if cancelled.load(Relaxed)
+            || !self.current()
+            || self.root != root.prepared()
+            || !root.source().is_direct_directory(root.prepared())
+        {
+            self.cancel();
+            return None;
+        }
+        let offered = {
+            let mut state = self.state.lock().unwrap_or_else(|error| error.into_inner());
+            if !matches!(*state, Attempt::Offered(_)) {
+                *state = Attempt::Closed;
+                return None;
+            }
+            match std::mem::replace(&mut *state, Attempt::Reading) {
+                Attempt::Offered(seed) => seed,
+                _ => unreachable!(),
+            }
+        };
+        use crate::spans::startup;
+        let bytes = startup::time("rest.mobs.data.seed_read", || {
+            root.source().read_limited(EXPORT, INPUT_CAP)
+        });
+        let Ok(bytes) = bytes else {
+            self.cancel();
+            return None;
+        };
+        let key = Key {
+            export: startup::time("rest.mobs.data.seed_hash", || Sha256::digest(&bytes).into()),
+            rows: facts.states.len(),
+        };
+        if !self.current() {
+            self.cancel();
+            return None;
+        }
+        let matching = offered.filter(|seed| seed.key == key && !cancelled.load(Relaxed));
+        let prepared = if let Some(seed) = matching {
+            log::info!("Horizon Cafe mob seed: adopted");
+            Some(seed.data.into_live())
+        } else {
+            MobData::from_prepared_json(&bytes, key.rows)
+        };
+        let mut state = self.state.lock().unwrap_or_else(|error| error.into_inner());
+        if matches!(*state, Attempt::Reading) && !cancelled.load(Relaxed) {
+            *state = if prepared.is_some() {
+                Attempt::Active(key)
+            } else {
+                Attempt::Closed
+            };
+        }
+        Some(prepared.unwrap_or_else(|| MobData::fallback(facts)))
+    }
+
+    /// Accept only the exclusive MobData from the generation whose Game and
+    /// workers have stopped. Dynamic overlays/derived tables drop here.
+    pub fn stage_drained(&self, loaded: MobData) {
+        let mut state = self.state.lock().unwrap_or_else(|error| error.into_inner());
+        let Attempt::Active(key) = std::mem::replace(&mut *state, Attempt::Closed) else {
+            return;
+        };
+        // Mod declarations may replace vanilla placement/heightmap rows.
+        if !loaded.mod_spawns.is_empty() || loaded.states.len() != key.rows {
+            return;
+        }
+        let base = BaseMobData {
+            states: loaded.states,
+            placements: loaded.placements,
+            heightmaps: loaded.heightmaps,
+            animations: loaded.animations,
+        };
+        let retained = base
+            .retained_allowance()
+            .saturating_add(self.root.capacity())
+            .saturating_add(32);
+        if retained > RETAINED_CAP {
+            return;
+        }
+        log::info!("Horizon Cafe mob seed: staged allowance={retained}");
+        *state = Attempt::Drained(Parked {
+            root: self.root.clone(),
+            key,
+            data: base,
+        });
+    }
+
+    /// Called after the hosted owner returns and the Night cwd is restored.
+    /// Failure and cancellation never restore the old generation.
+    pub fn finish(&self, saved: bool) {
+        let staged = std::mem::replace(
+            &mut *self.state.lock().unwrap_or_else(|error| error.into_inner()),
+            Attempt::Closed,
+        );
+        let Attempt::Drained(seed) = staged else {
+            return;
+        };
+        if !saved {
+            return;
+        }
+        let mut available = self
+            .owner
+            .0
+            .lock()
+            .unwrap_or_else(|error| error.into_inner());
+        if available.epoch == self.epoch {
+            available.parked = Some(seed);
+            log::info!("Horizon Cafe mob seed: parked");
+        }
+    }
+}
+
+struct BaseMobData {
+    states: Vec<StateData>,
+    placements: HashMap<String, Placement>,
+    heightmaps: HashMap<String, String>,
+    animations: HashMap<String, Animation>,
+}
+
+impl BaseMobData {
+    fn into_live(self) -> MobData {
+        MobData::from_parts(
+            self.states,
+            self.placements,
+            self.heightmaps,
+            self.animations,
+        )
+    }
+
+    fn retained_allowance(&self) -> usize {
+        fn owned<T>(capacity: usize) -> usize {
+            capacity.saturating_mul(size_of::<T>()).saturating_add(32)
+        }
+        fn map<K, V>(data: &HashMap<K, V>) -> usize {
+            // HashMap capacity is the number of entries permitted, rather
+            // than an allocation size. Cover buckets, controls and padding.
+            let buckets = data.capacity().saturating_mul(2);
+            owned::<(K, V)>(buckets).saturating_add(buckets)
+        }
+        fn string(text: &String) -> usize {
+            owned::<u8>(text.capacity())
+        }
+        let mut total = size_of::<Parked>()
+            .saturating_add(owned::<StateData>(self.states.capacity()))
+            .saturating_add(map(&self.placements))
+            .saturating_add(map(&self.heightmaps))
+            .saturating_add(map(&self.animations));
+        for name in self.placements.keys() {
+            total = total.saturating_add(string(name));
+        }
+        for (name, kind) in &self.heightmaps {
+            total = total
+                .saturating_add(string(name))
+                .saturating_add(string(kind));
+        }
+        for (name, animation) in &self.animations {
+            total = total.saturating_add(string(name)).saturating_add(owned::<(
+                String,
+                Vec<mod_api::AnimationChannel>,
+            )>(
+                animation.bones.capacity()
+            ));
+            for (bone, channels) in &animation.bones {
+                total = total.saturating_add(string(bone)).saturating_add(owned::<
+                    mod_api::AnimationChannel,
+                >(
+                    channels.capacity()
+                ));
+                for channel in channels {
+                    total = total
+                        .saturating_add(owned::<mod_api::Keyframe>(channel.keyframes.capacity()));
+                }
+            }
+        }
+        total
+    }
+}
