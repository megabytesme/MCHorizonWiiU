+    /// Read the selected blend in the atlas's dimensions. For upsampling, mixing
+    /// before nearest-neighbour sampling rounds each output channel identically
+    /// and only blends the source texels once.
+    pub fn blend_at_reusing<'a>(
+        &'a self,
+        blend: FrameBlend,
+        side: u32,
+        atlas: &'a mut Vec<u8>,
+        scratch: &'a mut Vec<u8>,
+    ) -> &'a [u8] {
+        if blend.millis == 0 {
+            return self.frame_at_reusing(blend.frame, side, atlas);
+        }
+
+        let source = self.pixels(blend.frame);
+        let next = self.pixels(blend.next);
+        let [w, h] = self.frame_dimensions(source);
+        if [w, h] == [side; 2] {
+            atlas.resize(source.len(), 0);
+            mix_pixels(atlas, source, next, blend.millis);
+        } else if w.max(h) <= side {
+            scratch.resize(source.len(), 0);
+            mix_pixels(scratch, source, next, blend.millis);
+            write_region_layer(scratch, w, [0, 0, w, h], side, atlas);
+        } else {
+            // Oversized sources can have many texels that the atlas never samples.
+            self.write_frame_at(blend.frame, side, atlas);
+            let next = self.frame_at_reusing(blend.next, side, scratch);
+            for (a, &b) in atlas.iter_mut().zip(next) {
+                *a = mix_channel(*a, b, blend.millis);
+            }
+        }
+        atlas
+    }
+
     pub fn frame_count(&self) -> usize {
         self.frames.len()
     }
 }
 
+fn mix_pixels(out: &mut [u8], source: &[u8], next: &[u8], millis: u32) {
+    for ((pixel, &a), &b) in out.iter_mut().zip(source).zip(next) {
+        *pixel = mix_channel(a, b, millis);
+    }
+}
+
+/// Keep Cafe's thousandth-step rounding across all RGBA channels.
+fn mix_channel(a: u8, b: u8, millis: u32) -> u8 {
+    ((u32::from(a) * (1000 - millis) + u32::from(b) * millis + 500) / 1000) as u8
+}
