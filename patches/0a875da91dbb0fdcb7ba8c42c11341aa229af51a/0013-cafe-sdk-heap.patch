+static MEMAllocFromDefaultHeapExFn original_alloc;
+static MEMFreeToDefaultHeapFn original_free;
+
+static void *alloc_for_default_heap(uint32_t bytes, int32_t alignment)
+{
+   if (alignment <= 0) return original_alloc(bytes, alignment);
+   const int32_t bulk_alignment = alignment < 4 ? 4 : alignment;
+   const int large = bytes >= 8 * 1024 * 1024;
+   if (large) {
+      void *bulk = MEMAllocFromExpHeapEx(bulk_heap, bytes, bulk_alignment);
+      if (bulk) return bulk;
+   }
+   void *data = original_alloc(bytes, alignment);
+   if (data || large) return data;
+   return MEMAllocFromExpHeapEx(bulk_heap, bytes, -bulk_alignment);
+}
+
+static void free_to_default_heap(void *data)
+{
+   const uintptr_t address = (uintptr_t)data;
+   if (address >= bulk_start && address - bulk_start < BULK_HEAP_BYTES)
+      MEMFreeToExpHeap(bulk_heap, data);
+   else
+      original_free(data);
+}
 
