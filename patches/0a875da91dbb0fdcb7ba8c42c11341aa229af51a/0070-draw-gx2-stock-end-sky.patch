+uniform vec4 uClipX;
+uniform vec4 uClipY;
+uniform vec4 uClipZ;
+uniform vec4 uClipW;
+out vec2 vTile;
+
+void main() {
+    vec4 p = vec4(aPosition, 1.0);
+    gl_Position = vec4(dot(uClipX, p), dot(uClipY, p), dot(uClipZ, p), dot(uClipW, p));
+    vTile = aTile;
+}
