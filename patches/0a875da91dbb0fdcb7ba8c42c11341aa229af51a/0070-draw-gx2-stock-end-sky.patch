diff --git a/wiiu/loading_host/end_sky.c b/wiiu/loading_host/end_sky.c
new file mode 100644
index 0000000000000000000000000000000000000000..63d767dff45d0b11332c81697a783bae23f3642c
--- /dev/null
+++ b/wiiu/loading_host/end_sky.c
@@ -0,0 +1,143 @@
+#include "end_sky.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <gx2/draw.h>
+#include <gx2/event.h>
+#include <gx2/registers.h>
+#include <gx2/sampler.h>
+#include <gx2/shaders.h>
+#include <gx2/utils.h>
+#include <gx2r/buffer.h>
+#include <gx2r/draw.h>
+#include <whb/gfx.h>
+
+extern const uint8_t _binary_end_sky_gsh_start[];
+
+enum { VERTEX_BYTES = 5 * sizeof(float) };
+_Static_assert(VERTEX_BYTES == 20, "End sky vertex ABI changed");
+
+struct HorizonGx2EndSky {
+   WHBGfxShaderGroup shader;
+   GX2RBuffer vertices;
+   GX2Sampler sampler;
+   uint32_t clip_offsets[4];
+   uint32_t sprite_offset, limits_offset, atlas_slot;
+};
+
+static void release(HorizonGx2EndSky *sky)
+{
+   if (GX2RBufferExists(&sky->vertices)) GX2RDestroyBufferEx(&sky->vertices, 0);
+   if (sky->shader.vertexShader) WHBGfxFreeShaderGroup(&sky->shader);
+   free(sky);
+}
+
+static bool uniform_offset(const GX2UniformVar *uniform, uint32_t *offset)
+{
+   if (!uniform || uniform->type != GX2_SHADER_VAR_TYPE_FLOAT4 || uniform->count != 1 ||
+       uniform->block >= 0) return false;
+   *offset = uniform->offset;
+   return true;
+}
+
+int horizon_gx2_end_sky_create(HorizonGx2EndSky **out,
+                             const float vertices[HORIZON_END_SKY_VERTICES][5])
+{
+   if (!out) return -1;
+   *out = NULL;
+   if (!vertices) return -1;
+   HorizonGx2EndSky *sky = calloc(1, sizeof(*sky));
+   if (!sky) return -2;
+   WHBGfxShaderGroup *shader = &sky->shader;
+   if (!WHBGfxLoadGFDShaderGroup(shader, 0, _binary_end_sky_gsh_start)) goto invalid_shader;
+   const GX2VertexShader *vs = shader->vertexShader;
+   const GX2PixelShader *ps = shader->pixelShader;
+   if (!vs || !ps || vs->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       ps->mode != GX2_SHADER_MODE_UNIFORM_REGISTER) goto invalid_shader;
+
+   const char *clip_names[] = {"uClipX", "uClipY", "uClipZ", "uClipW"};
+   for (unsigned row = 0; row < 4; ++row) {
+      if (!uniform_offset(GX2GetVertexUniformVar(vs, clip_names[row]), &sky->clip_offsets[row]))
+         goto invalid_shader;
+   }
+   if (!uniform_offset(GX2GetPixelUniformVar(ps, "uSprite"), &sky->sprite_offset) ||
+       !uniform_offset(GX2GetPixelUniformVar(ps, "uLimits"), &sky->limits_offset) ||
+       !WHBGfxInitShaderAttribute(shader, "aPosition", 0, 0, GX2_ATTRIB_FORMAT_FLOAT_32_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aTile", 0, 3 * sizeof(float), GX2_ATTRIB_FORMAT_FLOAT_32_32) ||
+       !WHBGfxInitFetchShader(shader)) goto invalid_shader;
+   const GX2SamplerVar *sampler = ps->samplerVars;
+   if (ps->samplerVarCount != 1 || !sampler || !sampler->name || strcmp(sampler->name, "uAtlas") ||
+       sampler->type != GX2_SAMPLER_VAR_TYPE_SAMPLER_2D) goto invalid_shader;
+   sky->atlas_slot = sampler->location;
+   GX2InitSampler(&sky->sampler, GX2_TEX_CLAMP_MODE_CLAMP, GX2_TEX_XY_FILTER_MODE_POINT);
+
+   GX2RBuffer *buffer = &sky->vertices;
+   *buffer = (GX2RBuffer){
+      .flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER | GX2R_RESOURCE_USAGE_CPU_WRITE |
+               GX2R_RESOURCE_USAGE_GPU_READ,
+      .elemSize = VERTEX_BYTES, .elemCount = HORIZON_END_SKY_VERTICES,
+   };
+   if (GX2RCreateBuffer(buffer)) {
+      void *mapped = GX2RLockBufferEx(buffer, 0);
+      if (mapped) {
+         memcpy(mapped, vertices, HORIZON_END_SKY_VERTICES * VERTEX_BYTES);
+         GX2RUnlockBufferEx(buffer, 0);
+         *out = sky;
+         return 0;
+      }
+   }
+   release(sky);
+   return -2;
+
+invalid_shader:
+   release(sky);
+   return -3;
+}
+
+void horizon_gx2_end_sky_destroy(HorizonGx2EndSky *sky)
+{
+   if (!sky) return;
+   GX2DrawDone();
+   release(sky);
+}
+
+int horizon_gx2_end_sky_draw(HorizonGx2EndSky *sky, const uint32_t rect[4],
+                           const GX2Texture *atlas, const float sprite[4],
+                           const float clip_rows[4][4])
+{
+   if (!sky || !rect || !rect[2] || !rect[3] || !atlas || !atlas->surface.image ||
+       !atlas->surface.width || !atlas->surface.height || !sprite || !clip_rows ||
+       !(sprite[0] >= 0 && sprite[1] >= 0 && sprite[2] <= 1 && sprite[3] <= 1 &&
+         sprite[0] < sprite[2] && sprite[1] < sprite[3])) return -1;
+
+   /* Point sampling is unchanged inside the sprite. Clamp the endpoint to
+      its own texel centre so rounding at a repeat never hits the next cell. */
+   const float dx = 0.5f / (float)atlas->surface.width;
+   const float dy = 0.5f / (float)atlas->surface.height;
+   const float limits[4] = {sprite[0] + dx, sprite[1] + dy, sprite[2] - dx, sprite[3] - dy};
+   WHBGfxShaderGroup *shader = &sky->shader;
+   GX2SetViewport(rect[0], rect[1], rect[2], rect[3], 0, 1);
+   GX2SetScissor(rect[0], rect[1], rect[2], rect[3]);
+   GX2SetShaderMode(shader->vertexShader->mode);
+   GX2SetFetchShader(&shader->fetchShader);
+   GX2SetVertexShader(shader->vertexShader);
+   GX2SetPixelShader(shader->pixelShader);
+   GX2SetPixelTexture(atlas, sky->atlas_slot);
+   GX2SetPixelSampler(&sky->sampler, sky->atlas_slot);
+   GX2RSetAttributeBuffer(&sky->vertices, 0, VERTEX_BYTES, 0);
+   for (unsigned row = 0; row < 4; ++row)
+      GX2SetVertexUniformReg(sky->clip_offsets[row], 4, clip_rows[row]);
+   GX2SetPixelUniformReg(sky->sprite_offset, 4, sprite);
+   GX2SetPixelUniformReg(sky->limits_offset, 4, limits);
+   GX2SetCullOnlyControl(GX2_FRONT_FACE_CCW, FALSE, FALSE);
+   GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+   GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0.0f);
+   GX2SetDepthOnlyControl(FALSE, FALSE, GX2_COMPARE_FUNC_ALWAYS);
+   GX2SetColorControl(GX2_LOGIC_OP_COPY, 1, FALSE, TRUE);
+   GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, 0, 0, 0, 0, 0, 0, 0);
+   GX2SetBlendControl(GX2_RENDER_TARGET_0, GX2_BLEND_MODE_ONE, GX2_BLEND_MODE_ONE,
+                      GX2_BLEND_COMBINE_MODE_ADD, TRUE, GX2_BLEND_MODE_ZERO,
+                      GX2_BLEND_MODE_ONE, GX2_BLEND_COMBINE_MODE_ADD);
+   GX2DrawEx(GX2_PRIMITIVE_MODE_TRIANGLES, HORIZON_END_SKY_VERTICES, 0, 1);
+   return 0;
+}
diff --git a/wiiu/loading_host/end_sky.frag b/wiiu/loading_host/end_sky.frag
new file mode 100644
index 0000000000000000000000000000000000000000..e377ed4168d5dafb4d3bc7eafc1f90a7beb2259d
--- /dev/null
+++ b/wiiu/loading_host/end_sky.frag
@@ -0,0 +1,13 @@
+#version 330
+
+uniform sampler2D uAtlas;
+uniform vec4 uSprite;
+uniform vec4 uLimits;
+in vec2 vTile;
+out vec4 fragColor;
+
+void main() {
+    vec2 uv = mix(uSprite.xy, uSprite.zw, fract(vTile));
+    vec4 color = texture(uAtlas, clamp(uv, uLimits.xy, uLimits.zw));
+    fragColor = vec4(color.rgb * (40.0 / 255.0) * color.a, 0.0);
+}
