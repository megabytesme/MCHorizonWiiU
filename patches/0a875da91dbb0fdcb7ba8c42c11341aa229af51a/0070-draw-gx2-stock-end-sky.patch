+#[test]
+fn repeated_faces_match_the_stock_tiled_corners() {
+    let triangles = stock_end_sky_triangles();
+    let tiled = vertices([0.0, 0.0, 1.0, 1.0]);
+    let outer_corners = [
+        0,
+        (16 - 1) * 4 + 1,
+        (16 * 16 - 1) * 4 + 2,
+        (16 * (16 - 1)) * 4 + 3,
+    ];
+    let uv = [[0.0, 0.0], [0.0, 16.0], [16.0, 16.0], [16.0, 0.0]];
+    for (face, tiled) in triangles
+        .chunks_exact(6)
+        .zip(tiled.chunks_exact(16 * 16 * 4))
+    {
+        for (vertex, corner) in face.iter().zip([0, 1, 2, 0, 2, 3]) {
