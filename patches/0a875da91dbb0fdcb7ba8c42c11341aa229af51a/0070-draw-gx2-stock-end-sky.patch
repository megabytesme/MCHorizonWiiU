diff --git a/wiiu/loading_host/end_sky.rs b/wiiu/loading_host/end_sky.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f4072a608a68d1710123b7994d58552322da0137
--- /dev/null
+++ b/wiiu/loading_host/end_sky.rs
@@ -0,0 +1,90 @@
+use horizon_client::gfx::{Frame, View, sky_open, stock_end_sky_triangles};
+use horizon_wiiu_platform::hud::horizon::HorizonPresenter;
+use std::{ffi::c_void, ptr::NonNull};
+
+unsafe extern "C" {
+    fn horizon_gx2_end_sky_create(out: *mut *mut c_void, vertices: *const [f32; 5]) -> i32;
+    fn horizon_gx2_end_sky_destroy(sky: *mut c_void);
+    fn horizon_gx2_end_sky_draw(
+        sky: *mut c_void,
+        rect: *const u32,
+        atlas: *const c_void,
+        sprite: *const f32,
+        clip_rows: *const [f32; 4],
+    ) -> i32;
+}
+
+fn sprite(frame: &Frame<'_>) -> Option<[f32; 4]> {
+    if frame.end_sky && !frame.title && sky_open(frame) {
+        frame.end_sky_sprite
+    } else {
+        None
+    }
+}
+
+pub(crate) fn unsupported(frame: &Frame<'_>, has_atlas: bool) -> bool {
+    !has_atlas && sprite(frame).is_some()
+}
+
+#[derive(Default)]
+pub(crate) struct EndSky(Option<NonNull<c_void>>);
+
+impl EndSky {
+    pub(crate) fn draw(
+        &mut self,
+        frame: &Frame<'_>,
+        atlas: Option<&HorizonPresenter<'_>>,
+        rect: [u32; 4],
+        aspect: f32,
+    ) -> Result<(), &'static str> {
+        let Some((sprite, atlas)) = sprite(frame).zip(atlas) else {
+            return Ok(());
+        };
+        let native = match self.0 {
+            Some(native) => native,
+            None => {
+                let vertices = stock_end_sky_triangles();
+                let mut sky = std::ptr::null_mut();
+                if unsafe { horizon_gx2_end_sky_create(&mut sky, vertices.as_ptr()) } != 0 {
+                    return Err("could not create the GX2 End sky pipeline");
+                }
+                let sky = NonNull::new(sky).ok_or("missing GX2 End sky pipeline")?;
+                self.0 = Some(sky);
+                sky
+            }
+        };
+        let view = View::screen(
+            frame.yaw,
+            frame.pitch,
+            frame.fov_degrees,
+            aspect,
+            frame.depth_far,
+        );
+        let clip_rows = view
+            .view_proj(frame.bob * frame.spin)
+            .transpose()
+            .to_cols_array_2d();
+        let result = atlas.with_native_atlas(|texture| unsafe {
+            horizon_gx2_end_sky_draw(
+                native.as_ptr(),
+                rect.as_ptr(),
+                texture,
+                sprite.as_ptr(),
+                clip_rows.as_ptr(),
+            )
+        });
+        if result == 0 {
+            Ok(())
+        } else {
+            Err("GX2 End sky draw failed")
+        }
+    }
+}
+
+impl Drop for EndSky {
+    fn drop(&mut self) {
+        if let Some(sky) = self.0.take() {
+            unsafe { horizon_gx2_end_sky_destroy(sky.as_ptr()) };
+        }
+    }
+}
