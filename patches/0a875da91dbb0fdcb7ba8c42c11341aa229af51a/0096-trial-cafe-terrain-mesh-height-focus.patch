+/// A ready column and its still-unsubmitted sections, ordered by horizontal distance.
+pub(super) type MeshCandidate = (i64, i32, i32, SectionMask);
+
+/// On Cafe, use at most half the existing queue room for sections around the
+/// player's height. The rest uses the usual order, including when the band is
+/// all air or all its jobs have run. Missing regions leave their slots free.
+pub(super) fn submit_mesh_batches(
+    candidates: &mut Vec<MeshCandidate>,
+    mut room: usize,
+    focus_section: Option<i32>,
+    mut submit: impl FnMut(i32, i32, SectionMask) -> bool,
+) {
+    nearest_first(candidates, room);
+    if let Some(y) = focus_section.filter(|_| room >= 2) {
+        let start = y.saturating_sub(2).max(0) as usize;
+        let end = y.saturating_add(3).max(0) as usize;
+        let band = SectionMask::below(end).from(start);
+        let focused_room = room / 2;
+        let remaining = submit_mesh_pass(candidates, focused_room, band, &mut submit);
+        room -= focused_room - remaining;
+    }
+    submit_mesh_pass(candidates, room, SectionMask::ALL, &mut submit);
+    candidates.clear();
+}
+
+fn submit_mesh_pass(
+    candidates: &mut [MeshCandidate],
+    mut room: usize,
+    allowed: SectionMask,
+    mut submit: impl FnMut(i32, i32, SectionMask) -> bool,
+) -> usize {
+    for (_, x, z, sections) in candidates {
+        if room == 0 {
+            break;
+        }
+        let mut remaining = room;
+        let (selected, _) = mesh_batch(*sections & allowed, &mut remaining);
+        if !selected.is_empty() && submit(*x, *z, selected) {
+            *sections = *sections & !selected;
+            room = remaining;
+        }
+    }
+    room
+}
