+        for focus in [63, 255, 0, 64] {
+            let mut cols = vec![(1, 0, 0, all), (2, 1, 1, waiting)];
+            let limit = 3;
+            let expected = waiting.len().min(limit);
+            let mut used = 0;
+            submit_mesh_batches(&mut cols, limit, Some(focus), |x, _, jobs| {
+                if x == 0 {
+                    return false; // Region was not available at dequeue.
+                }
+                assert!((submitted & jobs).is_empty());
+                waiting = waiting & !jobs;
+                submitted = submitted | jobs;
+                used += jobs.len();
+                true
+            });
+            assert_eq!(used, expected);
+        }
+        assert_eq!(submitted, all);
