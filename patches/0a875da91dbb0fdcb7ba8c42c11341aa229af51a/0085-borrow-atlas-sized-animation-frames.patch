+    #[test]
+    fn animation_reuses_atlas_sized_frames_and_resamples_other_shapes() {
+        let square = test_animation(2, 0);
+        let mut scratch = vec![17; 8];
+        let borrowed = square.frame_at_reusing(1, 2, &mut scratch);
+        assert_eq!(
+            borrowed,
+            &[0, 0, 99, 255, 1, 0, 99, 255, 0, 1, 99, 255, 1, 1, 99, 255]
+        );
+        assert_eq!(borrowed.as_ptr(), square.pixels(1).as_ptr());
+        assert_eq!(scratch, [17; 8]);
+
+        // This strip has the same byte count as a 2x2 image, but its rows differ.
+        let mut strip = square.clone();
+        strip.shape = Some([1, 4]);
+        assert_eq!(
+            strip.frame_at_reusing(1, 2, &mut scratch),
+            &[0, 0, 99, 255, 0, 0, 99, 255, 0, 1, 99, 255, 0, 1, 99, 255],
+        );
+        assert_eq!(
+            square.frame_at_reusing(1, 1, &mut scratch),
+            &[0, 0, 99, 255],
+        );
+    }
