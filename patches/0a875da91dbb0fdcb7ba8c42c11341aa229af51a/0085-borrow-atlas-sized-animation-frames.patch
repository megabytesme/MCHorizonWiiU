+    /// Read an atlas-sized frame without copying or resample it into reusable storage.
+    pub fn frame_at_reusing<'a>(
+        &'a self,
+        frame: usize,
+        side: u32,
+        scratch: &'a mut Vec<u8>,
+    ) -> &'a [u8] {
+        let source = self.pixels(frame);
+        let bytes = (side as usize)
+            .checked_pow(2)
+            .and_then(|len| len.checked_mul(4));
+        if self.shape.unwrap_or([side; 2]) == [side; 2] && bytes == Some(source.len()) {
+            return source;
+        }
+        self.write_frame_at(frame, side, scratch);
+        scratch
+    }
+
     pub fn frame_count(&self) -> usize {
         self.frames.len()
     }
