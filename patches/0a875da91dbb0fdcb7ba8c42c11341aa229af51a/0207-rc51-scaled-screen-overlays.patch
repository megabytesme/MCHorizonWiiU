diff --git a/wiiu/loading_host/screen.frag b/wiiu/loading_host/screen.frag
new file mode 100644
index 0000000000000000000000000000000000000000..86a5db3a8e03dae63e6b339142775e010b76aa03
--- /dev/null
+++ b/wiiu/loading_host/screen.frag
@@ -0,0 +1,22 @@
+#version 400
+in vec2 vUv;
+in vec4 vColor;
+uniform sampler2D uAtlas;
+uniform vec4 uRect;
+uniform vec4 uEdges;
+uniform vec4 uMode;
+out vec4 fragColor;
+
+void main(void) {
+    bool clamped = uMode.x != 0.0;
+    vec2 offset = clamped ? vUv : fract(vUv);
+    vec2 uv = uRect.xy + offset * (uRect.zw - uRect.xy);
+    if (clamped) uv = clamp(uv, uEdges.xy, uEdges.zw);
+    vec4 sampled = textureLod(uAtlas, uv, 0.0) * vColor;
+    if (uMode.y != 0.0) {
+        fragColor = vec4(sampled.rgb, 1.0);
+    } else {
+        if (sampled.a <= 0.0) discard;
+        fragColor = sampled;
+    }
+}
