+#ifdef HORIZON_GX2_SCREEN_OVERLAYS
+int horizon_loading_host_present_screen_overlays(
+   HorizonLoadingDrawTarget draw, void *context, const float rgba[4],
+   uint64_t *retired_pair, bool prepublished)
+{
+   *retired_pair = 0;
+   last_outputs = 0;
+   last_wait_ns = 0;
+   if (!ProcUIInForeground()) {
+      if (prepublished) last_wait_ns = OSTicksToNanoseconds(drain_guarded_commands());
+      return HORIZON_LOADING_RETRY_FLIP;
+   }
+   bool verified_finish = false;
+   const int result =
+      present_with_clear(draw, context, rgba, NULL, false, retired_pair, &verified_finish, false);
+   // A scan wait timeout already drained through discard_guarded_pair. An
+   // early error still must retire any pre-frame atlas/geometry invalidation.
+   if (prepublished && !verified_finish && result != HORIZON_LOADING_RETRY_FLIP)
+      last_wait_ns += OSTicksToNanoseconds(drain_guarded_commands());
+   return result;
+}
+#endif
