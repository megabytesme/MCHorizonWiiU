diff --git a/wiiu/loading_host/screen_geometry.c b/wiiu/loading_host/screen_geometry.c
new file mode 100644
index 0000000000000000000000000000000000000000..c0d3bd89405a4e6d435bea6f33096bd52dd794a2
--- /dev/null
+++ b/wiiu/loading_host/screen_geometry.c
@@ -0,0 +1,30 @@
+#include "screen_overlay.h"
+
+#include <math.h>
+#include <stddef.h>
+
+_Static_assert(sizeof(ScreenVertex) == 56, "screen vertex ABI");
+_Static_assert(offsetof(ScreenVertex, uv) == 16 && offsetof(ScreenVertex, color) == 40,
+               "screen vertex fetch offsets");
+_Static_assert(sizeof(ScreenQuad) == 232, "normalized screen command ABI");
+
+bool screen_overlay_valid(const ScreenQuad *quads, uint32_t count)
+{
+    if (count > SCREEN_MAX_QUADS || (count && !quads)) return false;
+    for (uint32_t quad = 0; quad < count; ++quad) {
+        const ScreenQuad *q = &quads[quad];
+        if (q->vignette > 1 || q->sampling & ~(SCREEN_BLUR | SCREEN_CLAMP)) return false;
+        const float *rect = q->vertices[0].rect;
+        if (!(rect[0] >= 0.0f && rect[1] >= 0.0f && rect[2] <= 1.0f && rect[3] <= 1.0f &&
+              rect[0] < rect[2] && rect[1] < rect[3])) return false;
+        for (unsigned corner = 0; corner < 4; ++corner) {
+            const ScreenVertex *v = &q->vertices[corner];
+            if (!(isfinite(v->position[0]) && isfinite(v->position[1]) &&
+                  v->position[2] == 0.0f && v->position[3] == 1.0f &&
+                  isfinite(v->uv[0]) && isfinite(v->uv[1]))) return false;
+            for (unsigned i = 0; i < 4; ++i)
+                if (v->rect[i] != rect[i] || !isfinite(v->color[i])) return false;
+        }
+    }
+    return true;
+}
diff --git a/wiiu/loading_host/screen_overlay.c b/wiiu/loading_host/screen_overlay.c
new file mode 100644
index 0000000000000000000000000000000000000000..2580d6457422c69ed3ee1b795d550932fae1eacf
--- /dev/null
+++ b/wiiu/loading_host/screen_overlay.c
@@ -0,0 +1,170 @@
+#include "screen_overlay.h"
+
+#include <gx2/draw.h>
+#include <gx2/registers.h>
+#include <gx2/sampler.h>
+#include <gx2/shaders.h>
+#include <gx2/state.h>
+#include <gx2/texture.h>
+#include <gx2r/buffer.h>
+#include <stdlib.h>
+#include <string.h>
+#include <whb/gfx.h>
+
+extern const uint8_t _binary_screen_gsh_start[];
+
+typedef struct {
+    float rect[4];
+    uint32_t vignette, sampling;
+} ScreenMaterial;
+
+struct ScreenOverlay {
+    WHBGfxShaderGroup shader;
+    GX2RBuffer geometry;
+    GX2Sampler samplers[2];
+    ScreenMaterial materials[SCREEN_MAX_QUADS];
+    uint32_t uniforms[3], atlas_slot, count;
+};
+
+void screen_overlay_destroy_retired(ScreenOverlay *screen)
+{
+    if (!screen) return;
+    if (GX2RBufferExists(&screen->geometry)) GX2RDestroyBufferEx(&screen->geometry, 0);
+    if (screen->shader.vertexShader) WHBGfxFreeShaderGroup(&screen->shader);
+    free(screen);
+}
+
+ScreenOverlay *screen_overlay_create(void)
+{
+    ScreenOverlay *screen = calloc(1, sizeof(*screen));
+    if (!screen) return NULL;
+    WHBGfxShaderGroup *group = &screen->shader;
+    if (!WHBGfxLoadGFDShaderGroup(group, 0, _binary_screen_gsh_start)) goto fail;
+    const GX2PixelShader *ps = group->pixelShader;
+    if (!ps || !group->vertexShader || ps->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+        group->vertexShader->mode != GX2_SHADER_MODE_UNIFORM_REGISTER) goto fail;
+    const char *names[] = {"uRect", "uEdges", "uMode"};
+    for (unsigned i = 0; i < 3; ++i) {
+        const GX2UniformVar *var = GX2GetPixelUniformVar(ps, names[i]);
+        if (!var || var->type != GX2_SHADER_VAR_TYPE_FLOAT4 || var->count != 1 || var->block >= 0)
+            goto fail;
+        screen->uniforms[i] = var->offset;
+    }
+    if (ps->samplerVarCount != 1 || !ps->samplerVars ||
+        ps->samplerVars[0].type != GX2_SAMPLER_VAR_TYPE_SAMPLER_2D ||
+        !ps->samplerVars[0].name || strcmp(ps->samplerVars[0].name, "uAtlas")) goto fail;
+    screen->atlas_slot = ps->samplerVars[0].location;
+    if (!WHBGfxInitShaderAttribute(group, "aPosition", 0, offsetof(ScreenVertex, position),
+                                   GX2_ATTRIB_FORMAT_FLOAT_32_32_32_32) ||
+        !WHBGfxInitShaderAttribute(group, "aUv", 0, offsetof(ScreenVertex, uv),
+                                   GX2_ATTRIB_FORMAT_FLOAT_32_32) ||
+        !WHBGfxInitShaderAttribute(group, "aColor", 0, offsetof(ScreenVertex, color),
+                                   GX2_ATTRIB_FORMAT_FLOAT_32_32_32_32) ||
+        !WHBGfxInitFetchShader(group)) goto fail;
+    screen->geometry = (GX2RBuffer){
+        .flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER | GX2R_RESOURCE_USAGE_CPU_WRITE |
+                 GX2R_RESOURCE_USAGE_GPU_READ | GX2R_RESOURCE_USAGE_FORCE_MEM2,
+        .elemSize = sizeof(ScreenVertex),
+        .elemCount = SCREEN_MAX_QUADS * 6,
+    };
+    if (!GX2RCreateBuffer(&screen->geometry)) goto fail;
+    GX2InitSampler(&screen->samplers[0], GX2_TEX_CLAMP_MODE_CLAMP, GX2_TEX_XY_FILTER_MODE_POINT);
+    GX2InitSampler(&screen->samplers[1], GX2_TEX_CLAMP_MODE_CLAMP, GX2_TEX_XY_FILTER_MODE_LINEAR);
+    return screen;
+
+fail:
+    screen_overlay_destroy_retired(screen);
+    return NULL;
+}
+
+bool screen_overlay_upload_retired(ScreenOverlay *screen, const ScreenQuad *quads,
+                                   uint32_t count)
+{
+    if (!screen) return false;
+    screen->count = 0;
+    if (!screen_overlay_valid(quads, count)) return false;
+    if (!count) return true;
+    ScreenVertex *vertices = GX2RLockBufferEx(&screen->geometry, 0);
+    if (!vertices) return false;
+    static const unsigned corners[] = {0, 1, 2, 0, 2, 3};
+    for (uint32_t i = 0; i < count; ++i) {
+        const ScreenQuad *quad = &quads[i];
+        ScreenMaterial *material = &screen->materials[i];
+        memcpy(material->rect, quad->vertices[0].rect, sizeof(material->rect));
+        material->sampling = quad->sampling;
+        material->vignette = quad->vignette;
+        for (unsigned v = 0; v < 6; ++v) vertices[i * 6 + v] = quad->vertices[corners[v]];
+    }
+    GX2RUnlockBufferEx(&screen->geometry, 0);
+    screen->count = count;
+    return true;
+}
+
+bool screen_overlay_draw(const ScreenOverlay *screen, const void *native_atlas, uint32_t output,
+                         const uint32_t rect[4])
+{
+    if (!screen || output > 1 || !rect) return false;
+    if (!screen->count) return true;
+    const GX2Texture *atlas = native_atlas;
+    if (!atlas || !atlas->surface.image || !atlas->surface.width || !atlas->surface.height)
+        return false;
+    GX2ContextState *context = output ? WHBGfxGetDRCContextState() : WHBGfxGetTVContextState();
+    GX2ColorBuffer *color = output ? WHBGfxGetDRCColourBuffer() : WHBGfxGetTVColourBuffer();
+    GX2DepthBuffer *depth = output ? WHBGfxGetDRCDepthBuffer() : WHBGfxGetTVDepthBuffer();
+    if (!context || !color || !depth || !rect[2] || !rect[3] ||
+        (uint64_t)rect[0] + rect[2] > color->surface.width ||
+        (uint64_t)rect[1] + rect[3] > color->surface.height) return false;
+
+    const float half[2] = {0.5f / atlas->surface.width, 0.5f / atlas->surface.height};
+    /* A clampable sprite occupies at least one texel along each axis. */
+    for (unsigned i = 0; i < screen->count; ++i) {
+        const ScreenMaterial *material = &screen->materials[i];
+        const float *r = material->rect;
+        if ((material->sampling & SCREEN_CLAMP) &&
+            (r[0] + half[0] > r[2] - half[0] || r[1] + half[1] > r[3] - half[1]))
+            return false;
+    }
+
+    GX2SetContextState(context);
+    GX2SetColorBuffer(color, GX2_RENDER_TARGET_0);
+    GX2SetDepthBuffer(depth);
+    GX2SetViewport(rect[0], rect[1], rect[2], rect[3], 0, 1);
+    GX2SetScissor(rect[0], rect[1], rect[2], rect[3]);
+    GX2SetShaderMode(screen->shader.pixelShader->mode);
+    GX2SetFetchShader(&screen->shader.fetchShader);
+    GX2SetVertexShader(screen->shader.vertexShader);
+    GX2SetPixelShader(screen->shader.pixelShader);
+    GX2SetPixelTexture(atlas, screen->atlas_slot);
+    GX2SetAttribBuffer(0, screen->count * 6 * sizeof(ScreenVertex), sizeof(ScreenVertex),
+                       screen->geometry.buffer);
+    GX2SetDepthOnlyControl(FALSE, FALSE, GX2_COMPARE_FUNC_ALWAYS);
+    GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0);
+    GX2SetCullOnlyControl(GX2_FRONT_FACE_CCW, FALSE, FALSE);
+    GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+    GX2SetColorControl(GX2_LOGIC_OP_COPY, 1, FALSE, TRUE);
+    GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, 0, 0, 0, 0, 0, 0, 0);
+    for (unsigned i = 0; i < screen->count; ++i) {
+        const ScreenMaterial *material = &screen->materials[i];
+        const float *r = material->rect;
+        const float edges[4] = {r[0] + half[0], r[1] + half[1],
+                                r[2] - half[0], r[3] - half[1]};
+        const float mode[4] = {!!(material->sampling & SCREEN_CLAMP), material->vignette, 0, 0};
+        GX2SetPixelSampler(&screen->samplers[!!(material->sampling & SCREEN_BLUR)],
+                           screen->atlas_slot);
+        GX2SetPixelUniformReg(screen->uniforms[0], 4, r);
+        GX2SetPixelUniformReg(screen->uniforms[1], 4, edges);
+        GX2SetPixelUniformReg(screen->uniforms[2], 4, mode);
+        if (material->vignette) {
+            GX2SetBlendControl(GX2_RENDER_TARGET_0, GX2_BLEND_MODE_ZERO,
+                              GX2_BLEND_MODE_INV_SRC_COLOR, GX2_BLEND_COMBINE_MODE_ADD, TRUE,
+                              GX2_BLEND_MODE_ZERO, GX2_BLEND_MODE_ONE, GX2_BLEND_COMBINE_MODE_ADD);
+        } else {
+            GX2SetBlendControl(GX2_RENDER_TARGET_0, GX2_BLEND_MODE_SRC_ALPHA,
+                              GX2_BLEND_MODE_INV_SRC_ALPHA, GX2_BLEND_COMBINE_MODE_ADD, TRUE,
+                              GX2_BLEND_MODE_ONE, GX2_BLEND_MODE_INV_SRC_ALPHA,
+                              GX2_BLEND_COMBINE_MODE_ADD);
+        }
+        GX2DrawEx(GX2_PRIMITIVE_MODE_TRIANGLES, 6, i * 6, 1);
+    }
+    return true;
+}
