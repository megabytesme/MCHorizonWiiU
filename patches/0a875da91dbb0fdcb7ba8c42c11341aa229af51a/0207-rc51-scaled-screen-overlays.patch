new file mode 100644
index 0000000000000000000000000000000000000000..024bcdefe871d5bf95425114e768c0f0f98a71c6
--- /dev/null
+++ b/wiiu/loading_host/screen_overlay.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum { SCREEN_BLUR = 1, SCREEN_CLAMP = 2, SCREEN_MAX_QUADS = 16 };
+
+typedef struct {
+    float position[4], uv[2], rect[4], color[4];
+} ScreenVertex;
+
+typedef struct {
+    ScreenVertex vertices[4];
+    uint32_t vignette, sampling;
+} ScreenQuad;
+
+typedef struct ScreenOverlay ScreenOverlay;
+
+/* Validate the entire frame before either output uses the shared upload. */
+bool screen_overlay_valid(const ScreenQuad *quads, uint32_t count);
+ScreenOverlay *screen_overlay_create(void);
+
+/* Previous consumers of the overlay vertices must have positively retired. */
+bool screen_overlay_upload_retired(ScreenOverlay *screen, const ScreenQuad *quads,
+                                   uint32_t count);
+
+/* Borrow the resident HUD atlas; this call cannot change the atlas or vertices. */
+bool screen_overlay_draw(const ScreenOverlay *screen, const void *atlas, uint32_t output,
+                         const uint32_t rect[4]);
+
+/* The caller has positively retired every successful or partial draw. */
+void screen_overlay_destroy_retired(ScreenOverlay *screen);
diff --git a/wiiu/loading_host/screen_overlays.rs b/wiiu/loading_host/screen_overlays.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7c4989faa244d634cee743d4384524504b3c10f0
--- /dev/null
+++ b/wiiu/loading_host/screen_overlays.rs
@@ -0,0 +1,209 @@
+//! Optional screen effects using one retired geometry upload and the HUD atlas.
+
+use horizon_client::screen_effects::{Blend, ScreenQuad, ScreenVertex};
+use std::ffi::c_void;
+use std::ptr::NonNull;
+
+pub(super) const MAX_QUADS: usize = 16;
+pub(super) const OMISSION: u32 = 1 << 9;
+
+pub(super) fn complete(host: i32, outputs: u32, overlay_draws: u32) -> bool {
+    host == 0 && outputs == 3 && overlay_draws == 3
+}
+
+#[derive(Clone, Copy)]
+#[repr(C)]
+struct NativeQuad {
+    vertices: [ScreenVertex; 4],
+    vignette: u32,
+    sampling: u32,
+}
+
+const _: () = {
+    assert!(std::mem::size_of::<ScreenVertex>() == 56);
+    assert!(std::mem::offset_of!(ScreenVertex, uv) == 16);
+    assert!(std::mem::offset_of!(ScreenVertex, color) == 40);
+    assert!(std::mem::size_of::<NativeQuad>() == 232);
+};
+
+type DrawTarget = unsafe extern "C" fn(*mut c_void, u32, u32, u32) -> i32;
+
+unsafe extern "C" {
+    fn horizon_loading_host_present_screen_overlays(
+        draw: DrawTarget,
+        context: *mut c_void,
+        clear: *const f32,
+        ticket: *mut u64,
+        prepublished: bool,
+    ) -> i32;
+    fn horizon_gx2_profile_screen_overlays() -> bool;
+    fn screen_overlay_valid(quads: *const NativeQuad, count: u32) -> bool;
+    fn screen_overlay_create() -> *mut c_void;
+    fn screen_overlay_upload_retired(
+        screen: *mut c_void,
+        quads: *const NativeQuad,
+        count: u32,
+    ) -> bool;
+    fn screen_overlay_draw(
+        screen: *const c_void,
+        atlas: *const c_void,
+        output: u32,
+        rect: *const u32,
+    ) -> bool;
+    fn screen_overlay_destroy_retired(screen: *mut c_void);
+}
+
+struct Native(NonNull<c_void>);
+
+impl Drop for Native {
+    fn drop(&mut self) {
+        // Only the synchronous guarded present may reference this backing.
+        // That present retires its GPU commands before releasing the Rust call.
+        unsafe { screen_overlay_destroy_retired(self.0.as_ptr()) };
+    }
+}
+
+#[derive(Clone, Copy)]
+#[repr(u8)]
+pub(super) enum Reason {
+    Bootstrap,
+    Geometry,
+    Allocation,
+    Upload,
+    Atlas,
+    Draw,
+}
+
+#[derive(Default)]
+pub(super) struct Trial {
+    native: Option<Native>,
+    allocation_failed: bool,
+    reasons: u8,
+    reported_active: bool,
+}
+
+impl Trial {
+    pub(super) fn requested() -> bool {
+        unsafe { horizon_gx2_profile_screen_overlays() }
+    }
+
+    /// # Safety
+    /// The frame pointers and draw callback must live through this synchronous call.
+    pub(super) unsafe fn present(
+        draw: DrawTarget,
+        context: *mut c_void,
+        clear: &[f32; 4],
+        ticket: &mut u64,
+        prepublished: bool,
+    ) -> i32 {
+        unsafe {
+            horizon_loading_host_present_screen_overlays(
+                draw,
+                context,
+                clear.as_ptr(),
+                ticket,
+                prepublished,
+            )
+        }
+    }
+
+    pub(super) fn release_surface(&mut self) {
+        self.native = None;
+        self.allocation_failed = false;
+    }
+
+    /// A complete plan returns atlas bounds.
+    ///
+    /// # Safety
+    /// The preceding pair must have positively retired, and no current draw
+    /// may reference this backing.
+    pub(super) unsafe fn upload_retired(
+        &mut self,
+        quads: &[ScreenQuad],
+    ) -> Option<[[f32; 4]; MAX_QUADS]> {
+        let Some(first) = quads.first().filter(|_| quads.len() <= MAX_QUADS) else {
+            self.reason(Reason::Geometry);
+            return None;
+        };
+        let native = |q: &ScreenQuad| NativeQuad {
+            vertices: q.vertices,
+            vignette: u32::from(q.blend == Blend::Vignette),
+            sampling: q.sampling,
+        };
+        let mut plan = [native(first); MAX_QUADS];
+        let mut rects = [[0.0; 4]; MAX_QUADS];
+        for ((q, dest), rect) in quads.iter().zip(&mut plan).zip(&mut rects) {
+            *dest = native(q);
+            *rect = q.vertices[0].rect;
+        }
+        let count = quads.len() as u32;
+        if !unsafe { screen_overlay_valid(plan.as_ptr(), count) } {
+            self.reason(Reason::Geometry);
+            return None;
+        }
+        if self.native.is_none() && !self.allocation_failed {
+            self.native = NonNull::new(unsafe { screen_overlay_create() }).map(Native);
+            self.allocation_failed = self.native.is_none();
+        }
+        let Some(native) = &self.native else {
+            self.reason(Reason::Allocation);
+            return None;
+        };
+        if !unsafe { screen_overlay_upload_retired(native.0.as_ptr(), plan.as_ptr(), count) } {
+            self.reason(Reason::Upload);
+            return None;
+        }
+        Some(rects)
+    }
+
+    /// # Safety
+    /// The atlas must be borrowed from the current native HUD generation.
+    /// Call only inside a guarded paired present with an active upload.
+    pub(super) unsafe fn draw(
+        &mut self,
+        atlas: *const c_void,
+        output: u32,
+        rect: [u32; 4],
+    ) -> bool {
+        let drew = self.native.as_ref().is_some_and(|native| unsafe {
+            screen_overlay_draw(native.0.as_ptr(), atlas, output, rect.as_ptr())
+        });
+        if !drew {
+            self.reason(Reason::Draw);
+        }
+        drew
+    }
+
+    pub(super) fn active_pair(&mut self) {
+        if !self.reported_active {
+            self.reported_active = true;
+            unsafe {
+                super::OSReport(
+                    c"Horizon GX2 scaled screen effects submitted on both outputs\n".as_ptr(),
+                );
+            }
+        }
+    }
+
+    pub(super) fn reason(&mut self, reason: Reason) {
+        let mask = 1 << reason as u8;
+        if self.reasons & mask != 0 {
+            return;
+        }
+        self.reasons |= mask;
+        let name = match reason {
+            Reason::Bootstrap => c"prior-retirement",
+            Reason::Geometry => c"geometry",
+            Reason::Allocation => c"allocation",
+            Reason::Upload => c"vertex-upload",
+            Reason::Atlas => c"atlas-upload",
+            Reason::Draw => c"native-draw",
+        };
+        unsafe {
+            super::OSReport(
+                c"Horizon GX2 scaled screen effects fallback reason=%s\n".as_ptr(),
+                name.as_ptr(),
+            );
+        }
+    }
+}
