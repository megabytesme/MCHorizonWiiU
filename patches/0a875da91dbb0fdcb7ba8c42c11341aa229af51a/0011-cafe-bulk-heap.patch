index faec2b778d52d86e716ba678ab519cbce0442154..1bab9e023eac65951941e0be264870313d069485 100644
--- a/wiiu/loading_app/memory.c
+++ b/wiiu/loading_app/memory.c
@@ -4,12 +4,53 @@
 #include <coreinit/memheap.h>
 #include <gx2/surface.h>
 #include <stdint.h>
+#include <string.h>
 #include <whb/gfx.h>
 
 static MEMHeapHandle default_heap;
 
+// Keep large transient Rust blocks together in process-owned backing.
+// Small persistent allocations in the default heap can't split these blocks.
+enum { BULK_HEAP_BYTES = 256 * 1024 * 1024 };
+static MEMHeapHandle bulk_heap;
+static uintptr_t bulk_start;
+
+static void init_bulk_heap(void)
+{
+   if (bulk_heap) return;
+   void *buffer = MEMAllocFromDefaultHeapEx(BULK_HEAP_BYTES, 64);
+   if (!buffer) {
+      OSReport("Horizon memory bulk_heap unavailable\n");
+      return;
+   }
+   bulk_heap = MEMCreateExpHeapEx(buffer, BULK_HEAP_BYTES, MEM_HEAP_FLAG_USE_LOCK);
+   if (!bulk_heap) {
+      MEMFreeToDefaultHeap(buffer);
+      OSReport("Horizon memory bulk_heap initialization failed\n");
+      return;
+   }
+   bulk_start = (uintptr_t)buffer;
+   OSReport("Horizon memory bulk_heap capacity=%u\n", BULK_HEAP_BYTES);
+}
+
+void *horizon_wiiu_memory_alloc_bulk(uint32_t bytes, uint32_t align)
+{
+   if (!bulk_heap || align > INT32_MAX) return NULL;
+   return MEMAllocFromExpHeapEx(bulk_heap, bytes, (int32_t)(align < 4 ? 4 : align));
+}
+
+int horizon_wiiu_memory_free_bulk(void *data)
+{
+   uintptr_t address = (uintptr_t)data;
+   if (!bulk_heap || address < bulk_start || address - bulk_start >= BULK_HEAP_BYTES)
+      return 0;
+   MEMFreeToExpHeap(bulk_heap, data);
+   return 1;
+}
+
 void horizon_wiiu_memory_init(void)
 {
+   init_bulk_heap();
    /* MEM2's base heap can have zero free bytes while a child heap serves
     * default allocations. Accept the containing heap only after a known
     * allocation changes its free count. Do this before workers are started. */
