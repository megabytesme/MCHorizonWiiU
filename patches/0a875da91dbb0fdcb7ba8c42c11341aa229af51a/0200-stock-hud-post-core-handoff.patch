+use super::*;
+use std::{
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+        mpsc,
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+const TIMEOUT: Duration = Duration::from_secs(2);
+
+#[derive(Clone, Default)]
+struct Drops(Arc<AtomicUsize>);
+
+impl Drops {
+    fn count(&self) -> usize {
+        self.0.load(Ordering::SeqCst)
+    }
+
+    fn track(&self, id: u32) -> Owner {
+        Owner {
+            id,
+            drops: self.clone(),
+        }
+    }
+}
+
+struct Owner {
+    id: u32,
+    drops: Drops,
+}
+
+impl Drop for Owner {
+    fn drop(&mut self) {
+        self.drops.0.fetch_add(1, Ordering::SeqCst);
+    }
+}
+
+struct CloseOnCheckFailure<'a, T>(&'a PostCoreStockHud<T>);
+
+impl<T> Drop for CloseOnCheckFailure<'_, T> {
+    fn drop(&mut self) {
+        self.0.close();
+    }
+}
+
+fn take<T>(exchange: &PostCoreStockHud<T>) -> (T, WarmHudReply<'_, T>) {
+    let timeout = Instant::now() + TIMEOUT;
+    loop {
+        if let Some(job) = exchange.take() {
+            return job;
+        }
+        assert!(
+            Instant::now() < timeout,
+            "worker did not offer the verified plan"
+        );
+        thread::yield_now();
+    }
+}
+
+#[test]
+fn foreground_acceptance_keeps_original_core_and_publishes_once() {
+    let exchange = PostCoreStockHud::default();
+    let core_drops = Drops::default();
+    thread::scope(|scope| {
+        let _cleanup = CloseOnCheckFailure(&exchange);
+        let core = core_drops.track(5);
+        let (sender, receiver) = mpsc::channel();
+        let exchange = &exchange;
+        scope.spawn(move || {
+            let output = exchange
+                .complete_after_core(core, "generation 1", || -> Result<_, ()> {
+                    panic!("successful warm load must reuse its core")
+                })
+                .unwrap();
+            sender.send(output).unwrap();
+        });
+        let (plan, reply) = take(exchange);
+        assert_eq!(plan, "generation 1");
+        assert!(exchange.take().is_none());
+        assert!(receiver.try_recv().is_err());
+        assert_eq!(core_drops.count(), 0);
+        assert!(reply.rendered());
+        let core = receiver.recv_timeout(TIMEOUT).unwrap().unwrap();
+        assert_eq!(core.id, 5);
+        assert_eq!(core_drops.count(), 0);
+        assert!(exchange.take().is_none());
+    });
+    assert_eq!(core_drops.count(), 1);
+}
+
+#[test]
+fn decline_releases_the_plan_native_candidate_and_core_before_cold() {
+    let exchange = PostCoreStockHud::default();
+    let core_drops = Drops::default();
+    let plan_drops = Drops::default();
+    let native_drops = Drops::default();
+    thread::scope(|scope| {
+        let _cleanup = CloseOnCheckFailure(&exchange);
+        let core = core_drops.track(8);
+        let plan = plan_drops.track(9);
+        let (sender, receiver) = mpsc::channel();
+        let exchange = &exchange;
+        let (core_drops, plan_drops, native_drops) = (&core_drops, &plan_drops, &native_drops);
+        scope.spawn(move || {
+            let outcome = exchange.complete_after_core(core, plan, || -> Result<_, ()> {
+                assert_eq!(core_drops.count(), 1);
+                assert_eq!(plan_drops.count(), 1);
+                assert_eq!(native_drops.count(), 1);
+                Ok(core_drops.track(10))
+            });
+            sender.send(outcome).unwrap();
+        });
+        let (plan, reply) = take(exchange);
+        let native = native_drops.track(11);
+        assert_eq!(plan.id, 9);
+        drop(native);
+        drop(plan);
+        drop(reply);
+        assert_eq!(
+            receiver.recv_timeout(TIMEOUT).unwrap().unwrap().unwrap().id,
+            10
+        );
+    });
+    assert_eq!(core_drops.count(), 2);
+}
+
+#[test]
+fn close_queued_or_in_flight_releases_worker_without_cold_and_rejects_old_reply() {
+    for in_flight in [false, true] {
+        let exchange = PostCoreStockHud::default();
+        let core_drops = Drops::default();
+        let plan_drops = Drops::default();
+        thread::scope(|scope| {
+            let _cleanup = CloseOnCheckFailure(&exchange);
+            let core = core_drops.track(1);
+            let plan = plan_drops.track(2);
+            let (sender, receiver) = mpsc::channel();
+            let exchange = &exchange;
+            scope.spawn(move || {
+                let outcome = exchange.complete_after_core(core, plan, || -> Result<_, ()> {
+                    panic!("cancel must not start the cold rebuild")
+                });
+                sender.send(outcome).unwrap();
+            });
+            let taken = if in_flight {
+                Some(take(exchange))
+            } else {
+                let timeout = Instant::now() + TIMEOUT;
+                while !matches!(*exchange.phase(), Phase::Queued(_)) {
+                    assert!(Instant::now() < timeout);
+                    thread::yield_now();
+                }
+                None
+            };
+            exchange.close();
+            assert!(receiver.recv_timeout(TIMEOUT).unwrap().unwrap().is_none());
+            assert!(exchange.take().is_none());
+            assert_eq!(core_drops.count(), 1);
+            if let Some((plan, reply)) = taken {
+                assert!(!reply.rendered());
+                drop(plan);
+            }
+            assert_eq!(plan_drops.count(), 1);
+        });
+    }
+}
+
+#[test]
+fn closed_generation_never_reuses_a_plan_or_starts_cold() {
+    let exchange = PostCoreStockHud::default();
+    exchange.close();
+    let plans = Drops::default();
+    assert!(
+        exchange
+            .complete_after_core(42, plans.track(1), || -> Result<_, ()> {
+                panic!("a stale worker cannot start another generation")
+            })
+            .unwrap()
+            .is_none()
+    );
+    assert_eq!(plans.count(), 1);
+    assert!(exchange.take().is_none());
+}
