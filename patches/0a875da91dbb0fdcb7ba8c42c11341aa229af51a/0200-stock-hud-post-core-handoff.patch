+//! One deferred stock HUD exchange, owned by the existing Cafe loader generation.
+
+use std::sync::{Condvar, Mutex, MutexGuard, PoisonError};
+
+enum Phase<T> {
+    Idle,
+    Queued(T),
+    Rendering,
+    Rendered,
+    Declined,
+    Consumed,
+    Closed,
+}
+
+impl<T> Phase<T> {
+    fn awaiting_render(&self) -> bool {
+        matches!(self, Self::Queued(_) | Self::Rendering)
+    }
+}
+
+/// A worker can offer one plan after its core workers have joined. Only the
+/// foreground may take the plan, and closing the request wakes the worker.
+pub(super) struct PostCoreStockHud<T> {
+    phase: Mutex<Phase<T>>,
+    changed: Condvar,
+}
+
+impl<T> Default for PostCoreStockHud<T> {
+    fn default() -> Self {
+        Self {
+            phase: Mutex::new(Phase::Idle),
+            changed: Condvar::new(),
+        }
+    }
+}
+
+impl<T> PostCoreStockHud<T> {
+    fn phase(&self) -> MutexGuard<'_, Phase<T>> {
+        self.phase.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+
+    /// Keep the original core on success. A decline releases that core before
+    /// the caller builds cold UI and reloads core. The caller's cold function
+    /// must checkpoint its loader cancellation flag before allocating.
+    pub(super) fn complete_after_core<C, E>(
+        &self,
+        core: C,
+        plan: T,
+        rebuild_cold: impl FnOnce() -> Result<C, E>,
+    ) -> Result<Option<C>, E> {
+        let mut phase = self.phase();
+        if !matches!(*phase, Phase::Idle) {
+            return Ok(None);
+        }
+        *phase = Phase::Queued(plan);
+        let mut phase = self
+            .changed
+            .wait_while(phase, |phase| phase.awaiting_render())
+            .unwrap_or_else(PoisonError::into_inner);
+        match *phase {
+            Phase::Rendered => {
+                *phase = Phase::Consumed;
+                Ok(Some(core))
+            }
+            Phase::Declined => {
+                *phase = Phase::Consumed;
+                drop(phase);
+                drop(core);
+                rebuild_cold().map(Some)
+            }
+            Phase::Closed => Ok(None),
+            _ => unreachable!("wake requires a foreground decision or close"),
+        }
+    }
+
+    /// Taking the plan is a nonblocking foreground poll. Dropping the reply
+    /// declines unless closing the generation already took precedence.
+    pub(super) fn take(&self) -> Option<(T, WarmHudReply<'_, T>)> {
+        let mut phase = self.phase();
+        if !matches!(*phase, Phase::Queued(_)) {
+            return None;
+        }
+        let Phase::Queued(plan) = std::mem::replace(&mut *phase, Phase::Rendering) else {
+            unreachable!("only queued plans can be transferred");
+        };
+        Some((plan, WarmHudReply(self)))
+    }
+
+    pub(super) fn close(&self) {
+        let previous = std::mem::replace(&mut *self.phase(), Phase::Closed);
+        self.changed.notify_all();
+        drop(previous);
+    }
+
+    fn settle(&self, outcome: Phase<T>) -> bool {
+        let mut phase = self.phase();
+        if !matches!(*phase, Phase::Rendering) {
+            return false;
+        }
+        *phase = outcome;
+        self.changed.notify_one();
+        true
+    }
+}
+
+pub(super) struct WarmHudReply<'a, T>(&'a PostCoreStockHud<T>);
+
+impl<T> WarmHudReply<'_, T> {
+    /// Call after complete CPU art and matching renderer ownership are ready
+    /// for publication. A false result means close won. The foreground must
+    /// discard the complete product and release any provisional GPU art.
+    pub(super) fn rendered(self) -> bool {
+        self.0.settle(Phase::Rendered)
+    }
+}
+
+impl<T> Drop for WarmHudReply<'_, T> {
+    fn drop(&mut self) {
+        self.0.settle(Phase::Declined);
+    }
+}
+
