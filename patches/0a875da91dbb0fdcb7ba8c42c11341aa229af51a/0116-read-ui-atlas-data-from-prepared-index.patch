+    #[test]
+    fn the_atlas_discovers_prepared_textures_and_font_sheets() {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path();
+        write_png(root, "gui/container/inventory", 32, 16);
+        write_png(root, "hud/sheet", 16, 8);
+        let definition = root.join("assets/minecraft/font/default.json");
+        fs::create_dir_all(definition.parent().unwrap()).unwrap();
+        fs::write(
+            &definition,
+            r#"{"providers":[{"type":"bitmap","file":"minecraft:hud/sheet.png","ascent":7,"chars":["ab"]}]}"#,
+        )
+        .unwrap();
+        fs::write(root.join("horizon-resources.json"), b"{}").unwrap();
+        horizon_core::prepared_files::write(root).unwrap();
+        fs::remove_file(root.join("assets/minecraft/textures/gui/container/inventory.png"))
+            .unwrap();
+        fs::remove_file(root.join("assets/minecraft/textures/hud/sheet.png")).unwrap();
+        fs::remove_file(definition).unwrap();
+        let source = ResourceSource::directory(root.to_path_buf());
+        let atlas = HudAtlas::build(&source).unwrap();
+        let size = (atlas.width, atlas.height);
+        assert_eq!(
+            atlas.sprites["gui/container/inventory"].texels(size),
+            (32, 16)
+        );
+        assert_eq!(atlas.sprites["hud/sheet"].texels(size), (16, 8));
+    }
+
     /// A content mod's GUI textures join the atlas under its namespace;
