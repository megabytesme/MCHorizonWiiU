index 0000000000000000000000000000000000000000..a7f1bd40d08a0807940269f625f5eee74c49425c
--- /dev/null
+++ b/wiiu/loading_host/world_scale.c
@@ -0,0 +1,234 @@
+#include "world_scale.h"
+
+#include <coreinit/memdefaultheap.h>
+#include <coreinit/memexpheap.h>
+#include <gx2/clear.h>
+#include <gx2/draw.h>
+#include <gx2/mem.h>
+#include <gx2/registers.h>
+#include <gx2/sampler.h>
+#include <gx2/surface.h>
+#include <gx2/texture.h>
+#include <gx2/utils.h>
+#include <gx2r/buffer.h>
+#include <gx2r/draw.h>
+#include <gx2r/surface.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <whb/gfx.h>
+
+extern const uint8_t _binary_world_scale_gsh_start[];
+
+typedef struct {
+   GX2ColorBuffer color;
+   GX2DepthBuffer depth;
+   GX2Texture texture;
+} WorldTarget;
+
+typedef struct {
+   float position[2];
+   float uv[2];
+} CompositeVertex;
+
+struct HorizonGx2WorldScale {
+   WorldTarget outputs[2];
+   WHBGfxShaderGroup shader;
+   GX2RBuffer geometry;
+   GX2Sampler sampler;
+   uint32_t texture_slot;
+};
+
+static const GX2RResourceFlags color_flags = GX2R_RESOURCE_BIND_COLOR_BUFFER |
+   GX2R_RESOURCE_BIND_TEXTURE | GX2R_RESOURCE_USAGE_GPU_WRITE |
+   GX2R_RESOURCE_USAGE_GPU_READ | GX2R_RESOURCE_USAGE_FORCE_MEM2;
+static const GX2RResourceFlags depth_flags = GX2R_RESOURCE_BIND_DEPTH_BUFFER |
+   GX2R_RESOURCE_USAGE_GPU_WRITE | GX2R_RESOURCE_USAGE_FORCE_MEM2;
+
+static GX2Surface world_surface(uint32_t width, uint32_t height, GX2SurfaceFormat format)
+{
+   return (GX2Surface){
+      .dim = GX2_SURFACE_DIM_TEXTURE_2D,
+      .width = width,
+      .height = height,
+      .depth = 1,
+      .mipLevels = 1,
+      .format = format,
+      .aa = GX2_AA_MODE1X,
+      .tileMode = GX2_TILE_MODE_DEFAULT,
+   };
+}
+
+static bool preflight_targets(WorldTarget targets[2], const uint32_t dimensions[4])
+{
+   enum { SURFACE_BUDGET = 24 * 1024 * 1024, HEAP_RESERVE = 32 * 1024 * 1024 };
+   GX2Surface *surfaces[] = {&targets[0].color.surface, &targets[0].depth.surface,
+                            &targets[1].color.surface, &targets[1].depth.surface};
+   uint64_t bytes = 0;
+   for (uint32_t i = 0; i < 2; ++i) {
+      const uint32_t width = dimensions[i * 2], height = dimensions[i * 2 + 1];
+      if (!width || !height || width > 1920 || height > 1080) return false;
+      targets[i].color.surface = world_surface(width, height, GX2_SURFACE_FORMAT_UNORM_R8_G8_B8_A8);
+      targets[i].color.surface.use = GX2_SURFACE_USE_COLOR_BUFFER | GX2_SURFACE_USE_TEXTURE;
+      targets[i].depth.surface = world_surface(width, height, GX2_SURFACE_FORMAT_FLOAT_R32);
+      targets[i].depth.surface.use = GX2_SURFACE_USE_DEPTH_BUFFER;
+   }
+   for (uint32_t i = 0; i < 4; ++i) {
+      GX2Surface *surface = surfaces[i];
+      GX2CalcSurfaceSizeAndAlignment(surface);
+      if (!surface->imageSize || !surface->alignment || surface->alignment > INT32_MAX)
+         return false;
+      bytes += (uint64_t)surface->imageSize + surface->alignment;
+   }
+   if (bytes > SURFACE_BUDGET) return false;
+
+   // WHB's forced MEM2 surfaces use the aligned default allocator. A small
+   // allocation finds the serving heap, which need not be MEM2's base heap.
+   void *probe = MEMAllocFromDefaultHeapEx(64, 64);
+   if (!probe) return false;
+   MEMHeapHandle heap = MEMFindContainHeap(probe);
+   MEMFreeToDefaultHeap(probe);
+   if (heap && heap->tag == MEM_EXPANDED_HEAP_TAG && (heap->flags & MEM_HEAP_FLAG_USE_LOCK)) {
+      const uint32_t free_bytes = MEMGetTotalFreeSizeForExpHeap(heap);
+      // Cemu 2.6 can report zero for this counter even after a successful probe.
+      // The size cap and the allocation results remain in effect in that case.
+      if (free_bytes) {
+         if (free_bytes < bytes + HEAP_RESERVE) return false;
+         for (uint32_t i = 0; i < 4; ++i) {
+            GX2Surface *surface = surfaces[i];
+            uint32_t largest = MEMGetAllocatableSizeForExpHeapEx(heap, (int32_t)surface->alignment);
+            if (largest < surface->imageSize) return false;
+         }
+      }
+   }
+   return true;
+}
+
+static bool create_target(WorldTarget *target)
+{
+   if (!GX2RCreateSurface(&target->color.surface, color_flags)) return false;
+   target->color.viewNumSlices = 1;
+   GX2InitColorBufferRegs(&target->color);
+
+   if (!GX2RCreateSurface(&target->depth.surface, depth_flags)) return false;
+   target->depth.viewNumSlices = 1;
+   target->depth.depthClear = 1.0f;
+   GX2InitDepthBufferRegs(&target->depth);
+
+   // The sampled image is the color surface itself. Only the color view owns it.
+   target->texture.surface = target->color.surface;
+   target->texture.viewNumMips = 1;
+   target->texture.viewNumSlices = 1;
+   target->texture.compMap = GX2_COMP_MAP(GX2_SQ_SEL_R, GX2_SQ_SEL_G, GX2_SQ_SEL_B, GX2_SQ_SEL_A);
+   GX2InitTextureRegs(&target->texture);
+   return true;
+}
+
+void horizon_gx2_world_scale_destroy(HorizonGx2WorldScale *scale)
+{
+   if (!scale) return;
+   for (uint32_t i = 0; i < 2; ++i) {
+      WorldTarget *output = &scale->outputs[i];
+      if (output->depth.surface.image) GX2RDestroySurfaceEx(&output->depth.surface, depth_flags);
+      if (output->color.surface.image) GX2RDestroySurfaceEx(&output->color.surface, color_flags);
+   }
+   if (GX2RBufferExists(&scale->geometry)) GX2RDestroyBufferEx(&scale->geometry, 0);
+   WHBGfxFreeShaderGroup(&scale->shader);
+   free(scale);
+}
+
+HorizonGx2WorldScale *horizon_gx2_world_scale_create(const uint32_t dimensions[4],
+                                                    uint32_t *surface_bytes)
+{
+   HorizonGx2WorldScale *scale = calloc(1, sizeof(*scale));
+   if (!scale) return NULL;
+   *surface_bytes = 0;
+   if (!preflight_targets(scale->outputs, dimensions)) goto failure;
+   // Cafe clip space is Y-up. Texture row zero is at the top of the output.
+   static const CompositeVertex triangle[] = {
+      {{-1.0f,  1.0f}, {0.0f, 0.0f}},
+      {{-1.0f, -3.0f}, {0.0f, 2.0f}},
+      {{ 3.0f,  1.0f}, {2.0f, 0.0f}},
+   };
+   if (!WHBGfxLoadGFDShaderGroup(&scale->shader, 0, _binary_world_scale_gsh_start)) goto failure;
+   const GX2PixelShader *pixel = scale->shader.pixelShader;
+   if (pixel->samplerVarCount != 1 || !pixel->samplerVars || !pixel->samplerVars[0].name ||
+       strcmp(pixel->samplerVars[0].name, "uWorld") != 0 ||
+       pixel->samplerVars[0].type != GX2_SAMPLER_VAR_TYPE_SAMPLER_2D ||
+       pixel->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       scale->shader.vertexShader->mode != GX2_SHADER_MODE_UNIFORM_REGISTER) goto failure;
+   scale->texture_slot = pixel->samplerVars[0].location;
+   if (!WHBGfxInitShaderAttribute(&scale->shader, "aPosition", 0,
+         offsetof(CompositeVertex, position), GX2_ATTRIB_FORMAT_FLOAT_32_32) ||
+       !WHBGfxInitShaderAttribute(&scale->shader, "aUv", 0,
+         offsetof(CompositeVertex, uv), GX2_ATTRIB_FORMAT_FLOAT_32_32) ||
+       !WHBGfxInitFetchShader(&scale->shader)) goto failure;
+   scale->geometry.flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER |
+      GX2R_RESOURCE_USAGE_CPU_WRITE | GX2R_RESOURCE_USAGE_GPU_READ;
+   scale->geometry.elemSize = sizeof(CompositeVertex);
+   scale->geometry.elemCount = 3;
+   if (!GX2RCreateBuffer(&scale->geometry)) goto failure;
+   void *vertices = GX2RLockBufferEx(&scale->geometry, 0);
+   if (!vertices) goto failure;
+   memcpy(vertices, triangle, sizeof(triangle));
+   GX2RUnlockBufferEx(&scale->geometry, 0);
+   GX2InitSampler(&scale->sampler, GX2_TEX_CLAMP_MODE_CLAMP, GX2_TEX_XY_FILTER_MODE_LINEAR);
+
+   for (uint32_t i = 0; i < 2; ++i) {
+      if (!create_target(&scale->outputs[i])) goto failure;
+   }
+   for (uint32_t i = 0; i < 2; ++i) {
+      const WorldTarget *output = &scale->outputs[i];
+      *surface_bytes += output->color.surface.imageSize + output->depth.surface.imageSize;
+   }
+   return scale;
+
+failure:
+   horizon_gx2_world_scale_destroy(scale);
+   return NULL;
+}
+
+void horizon_gx2_world_scale_begin(HorizonGx2WorldScale *scale, uint32_t target,
+                                   const float clear[4])
+{
+   WorldTarget *output = &scale->outputs[target];
+   GX2ClearBuffersEx(&output->color, &output->depth, clear[0], clear[1], clear[2],
+                     clear[3], 1.0f, 0, GX2_CLEAR_FLAGS_DEPTH);
+   GX2SetColorBuffer(&output->color, GX2_RENDER_TARGET_0);
+   GX2SetDepthBuffer(&output->depth);
+   const uint32_t width = output->color.surface.width, height = output->color.surface.height;
+   GX2SetViewport(0, 0, width, height, 0.0f, 1.0f);
+   GX2SetScissor(0, 0, width, height);
+}
+
+void horizon_gx2_world_scale_end(HorizonGx2WorldScale *scale, uint32_t target,
+                                  const uint32_t viewport[4], bool composite)
+{
+   GX2SetContextState(target == 0 ? WHBGfxGetTVContextState() : WHBGfxGetDRCContextState());
+   GX2SetColorBuffer(target == 0 ? WHBGfxGetTVColourBuffer() : WHBGfxGetDRCColourBuffer(),
+                     GX2_RENDER_TARGET_0);
+   GX2SetDepthBuffer(target == 0 ? WHBGfxGetTVDepthBuffer() : WHBGfxGetDRCDepthBuffer());
+   if (!composite) return;
+
+   // Order the render-target writes before sampling the same image.
+   WorldTarget *output = &scale->outputs[target];
+   GX2Invalidate(GX2_INVALIDATE_MODE_COLOR_BUFFER | GX2_INVALIDATE_MODE_TEXTURE,
+                 output->color.surface.image, output->color.surface.imageSize);
+   const uint32_t x = viewport[0], y = viewport[1], width = viewport[2], height = viewport[3];
+   GX2SetViewport(x, y, width, height, 0.0f, 1.0f);
+   GX2SetScissor(x, y, width, height);
+   GX2SetShaderMode(scale->shader.pixelShader->mode);
+   GX2SetVertexShader(scale->shader.vertexShader);
+   GX2SetPixelShader(scale->shader.pixelShader);
+   GX2SetFetchShader(&scale->shader.fetchShader);
+   GX2RSetAttributeBuffer(&scale->geometry, 0, sizeof(CompositeVertex), 0);
+   GX2SetPixelTexture(&output->texture, scale->texture_slot);
+   GX2SetPixelSampler(&scale->sampler, scale->texture_slot);
+   GX2SetDepthOnlyControl(FALSE, FALSE, GX2_COMPARE_FUNC_ALWAYS);
+   GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0.0f);
+   GX2SetCullOnlyControl(GX2_FRONT_FACE_CCW, FALSE, FALSE);
+   GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+   GX2SetColorControl(GX2_LOGIC_OP_COPY, 0, FALSE, TRUE);
+   GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, 0, 0, 0, 0, 0, 0, 0);
+   GX2DrawEx(GX2_PRIMITIVE_MODE_TRIANGLES, 3, 0, 1);
+}
