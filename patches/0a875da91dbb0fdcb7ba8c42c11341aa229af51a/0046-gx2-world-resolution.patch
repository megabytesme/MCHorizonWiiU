diff --git a/wiiu/loading_host/world_scale.h b/wiiu/loading_host/world_scale.h
new file mode 100644
index 0000000000000000000000000000000000000000..b4c469573a4a4778c17c10e9cc4e05b04609ec8e
--- /dev/null
+++ b/wiiu/loading_host/world_scale.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct HorizonGx2WorldScale HorizonGx2WorldScale;
+
+/* All calls belong to the GX2 render thread. Creation and destruction occur
+ * between WHB frames, after WHBGfxFinishRender drained the previous draws. */
+HorizonGx2WorldScale *horizon_gx2_world_scale_create(const uint32_t dimensions[4],
+                                                    uint32_t *surface_bytes);
+void horizon_gx2_world_scale_destroy(HorizonGx2WorldScale *scale);
+
+/* With the selected WHB output active, clear and bind its offscreen target. */
+void horizon_gx2_world_scale_begin(HorizonGx2WorldScale *scale, uint32_t target,
+                                   const float clear[4]);
+
+/* Restore the WHB output. Upscale the world to the viewport on success. */
+void horizon_gx2_world_scale_end(HorizonGx2WorldScale *scale, uint32_t target,
+                                  const uint32_t viewport[4], bool composite);
diff --git a/wiiu/loading_host/world_scale.rs b/wiiu/loading_host/world_scale.rs
new file mode 100644
index 0000000000000000000000000000000000000000..468624a5c83edc949c985c8dd7e9977238712150
--- /dev/null
+++ b/wiiu/loading_host/world_scale.rs
@@ -0,0 +1,142 @@
+use horizon_client::presentation::WorldResolution;
+use std::{ffi::c_void, ptr::NonNull};
+
+unsafe extern "C" {
+    fn horizon_gx2_world_scale_create(
+        dimensions: *const u32,
+        surface_bytes: *mut u32,
+    ) -> *mut c_void;
+    fn horizon_gx2_world_scale_destroy(scale: *mut c_void);
+    fn horizon_gx2_world_scale_begin(scale: *mut c_void, target: u32, clear: *const f32);
+    fn horizon_gx2_world_scale_end(
+        scale: *mut c_void,
+        target: u32,
+        viewport: *const u32,
+        composite: bool,
+    );
+    fn OSReport(format: *const std::ffi::c_char, ...);
+}
+
+/// Owns the TV and GamePad world surfaces on the same thread as WHB.
+#[derive(Default)]
+pub(super) struct WorldScale {
+    native: Option<NonNull<c_void>>,
+    request: Option<(u32, [[u32; 2]; 2])>,
+    resolution: Option<WorldResolution>,
+}
+
+impl WorldScale {
+    pub(super) fn resolution(&self) -> Option<WorldResolution> {
+        self.resolution
+    }
+
+    pub(super) fn prepare(&mut self, requested_scale: u32, viewports: [[u32; 4]; 2]) {
+        let base = viewports.map(|[_, _, w, h]| [w, h]);
+        let request = Some((requested_scale, base));
+        if self.request == request {
+            return;
+        }
+        // The preceding WHB frame ended with GX2DrawDone. Release the old pair
+        // before allocating the replacement to avoid peaking at two live pairs.
+        self.release();
+        self.request = request;
+        let mut resolution = WorldResolution {
+            requested_scale,
+            effective_scale: 100,
+            dimensions: base,
+            surface_bytes: 0,
+        };
+        let percent = requested_scale.clamp(50, 100);
+        if percent < 100 {
+            let dimensions = base.map(|size| size.map(|n| scaled_dimension(n, percent)));
+            let native = unsafe {
+                horizon_gx2_world_scale_create(
+                    dimensions.as_flattened().as_ptr(),
+                    &mut resolution.surface_bytes,
+                )
+            };
+            self.native = NonNull::new(native);
+            if self.native.is_some() {
+                resolution.effective_scale = percent;
+                resolution.dimensions = dimensions;
+            }
+        }
+        self.resolution = Some(resolution);
+        let [[tv_w, tv_h], [drc_w, drc_h]] = resolution.dimensions;
+        unsafe {
+            OSReport(
+                c"Horizon GX2 world resolution requested_scale=%u effective_scale=%u tv=%ux%u drc=%ux%u surface_bytes=%u\n".as_ptr(),
+                resolution.requested_scale,
+                resolution.effective_scale,
+                tv_w, tv_h, drc_w, drc_h,
+                resolution.surface_bytes,
+            );
+        }
+    }
+
+    pub(super) fn release(&mut self) {
+        if let Some(native) = self.native.take() {
+            unsafe { horizon_gx2_world_scale_destroy(native.as_ptr()) };
+        }
+        self.request = None;
+        self.resolution = None;
+    }
+
+    pub(super) fn bind(
+        &self,
+        target: u32,
+        viewport: [u32; 4],
+        clear: &[f32; 4],
+    ) -> Option<WorldTarget<'_>> {
+        let native = self.native?;
+        let size = self.resolution?.dimensions[target as usize];
+        unsafe { horizon_gx2_world_scale_begin(native.as_ptr(), target, clear.as_ptr()) };
+        Some(WorldTarget {
+            native,
+            target,
+            viewport,
+            size,
+            composite: false,
+            _owner: self,
+        })
+    }
+}
+
+fn scaled_dimension(pixels: u32, percent: u32) -> u32 {
+    ((u64::from(pixels) * u64::from(percent) + 50) / 100).max(1) as u32
+}
+
+impl Drop for WorldScale {
+    fn drop(&mut self) {
+        self.release();
+    }
+}
+
+/// Restores the WHB output even if an intervening world pass fails.
+pub(super) struct WorldTarget<'a> {
+    native: NonNull<c_void>,
+    target: u32,
+    viewport: [u32; 4],
+    pub(super) size: [u32; 2],
+    composite: bool,
+    _owner: &'a WorldScale,
+}
+
+impl WorldTarget<'_> {
+    pub(super) fn composite(mut self) {
+        self.composite = true;
+    }
+}
+
+impl Drop for WorldTarget<'_> {
+    fn drop(&mut self) {
+        unsafe {
+            horizon_gx2_world_scale_end(
+                self.native.as_ptr(),
+                self.target,
+                self.viewport.as_ptr(),
+                self.composite,
+            );
+        }
+    }
+}
