+#[cfg(any(target_os = "cafe", test))]
+fn cafe_zlib(bytes: &[u8]) -> io::Result<Vec<u8>> {
+    use zlib_rs::{DeflateConfig, ReturnCode};
+    thread_local! {
+        static OUTPUT: std::cell::RefCell<Vec<u8>> = const { std::cell::RefCell::new(Vec::new()) };
+    }
+    // Smaller deflate tables reduce the demand on the shared Cafe heap. The
+    // public slice API returns MemError from initialization; the flate2
+    // streaming constructor panics on the same failure.
+    let config = DeflateConfig {
+        mem_level: 6,
+        ..DeflateConfig::default()
+    };
+    let capacity = bytes
+        .len()
+        .checked_add(bytes.len() / 16 + 1024)
+        .ok_or(io::ErrorKind::FileTooLarge)?;
+    OUTPUT.with_borrow_mut(|buffer| {
+        if buffer.capacity() < capacity {
+            buffer
+                .try_reserve_exact(capacity - buffer.len())
+                .map_err(|_| io::ErrorKind::OutOfMemory)?;
+        }
+        buffer.resize(capacity, 0);
+        let (compressed, status) = zlib_rs::compress_slice(buffer, bytes, config);
+        match status {
+            ReturnCode::Ok => {
+                let mut output = Vec::new();
+                output
+                    .try_reserve_exact(compressed.len())
+                    .map_err(|_| io::ErrorKind::OutOfMemory)?;
+                output.extend_from_slice(compressed);
+                Ok(output)
+            }
+            ReturnCode::MemError => Err(io::ErrorKind::OutOfMemory.into()),
+            other => Err(io::Error::other(format!("Cafe deflate failed: {other:?}"))),
+        }
+    })
+}
+
+#[cfg(test)]
+#[test]
+fn cafe_zlib_reuses_output_and_preserves_the_region_stream() {
+    let mut state = 0x1234abcdu32;
+    for length in [0, 1, 8192, 1 << 20, 912] {
+        let input: Vec<_> = (0..length)
+            .map(|_| {
+                state ^= state << 13;
+                state ^= state >> 17;
+                state ^= state << 5;
+                state as u8
+            })
+            .collect();
+        let actual = cafe_zlib(&input).unwrap();
+        assert_eq!(
+            Compression::Zlib.decode(&actual, input.len()).unwrap(),
+            input
+        );
+    }
+}
