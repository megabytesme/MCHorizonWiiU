+    /// Files under a prepared archive's asset directory, from the layer root.
+    ///
+    /// This omits sounds and loose files that may be imported after preparation.
+    /// Callers doing a general listing should use [Self::list].
+    pub fn list_prepared_assets(&self, dir: &str) -> Option<Vec<String>> {
+        if !dir.starts_with("assets/") || !stays_inside(dir) {
+            return None;
+        }
+        let Storage::Directory(root) = self.0.as_ref() else {
+            return None;
+        };
+        let names = horizon_core::prepared_files::files_under(&root.join(dir))?;
+        Some(
+            names
+                .into_iter()
+                .filter(|name| stays_inside(name))
+                .map(|name| format!("{dir}/{name}"))
+                .collect(),
+        )
+    }
