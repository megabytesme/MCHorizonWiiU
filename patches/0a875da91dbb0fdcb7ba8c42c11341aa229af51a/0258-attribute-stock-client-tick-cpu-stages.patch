--- /dev/null
+++ b/crates/horizon-client-platform/src/cafe_profile/client_tick.rs
@@ -0,0 +1,66 @@
+//! Fixed-size wall laps for a sampled ordinary local client's tick loop.
+
+const STAGES: usize = 6;
+
+unsafe extern "C" {
+    fn horizon_gx2_profile_client_tick_begin(steps: u32) -> bool;
+    fn horizon_gx2_profile_client_tick_complete(steps: u32, ticks: *const u64);
+}
+
+#[repr(usize)]
+#[derive(Clone, Copy)]
+pub enum ClientTickStage {
+    Pre,
+    Game,
+    Ambience,
+    GuiMusic,
+    Sound,
+    Post,
+}
+
+pub struct ClientTickLaps {
+    last: u64,
+    stages: [u64; STAGES],
+    edges: usize,
+    steps: u32,
+}
+
+impl ClientTickLaps {
+    pub fn begin(steps: u32) -> Option<Self> {
+        if !unsafe { horizon_gx2_profile_client_tick_begin(steps) } {
+            return None;
+        }
+        let last = unsafe { super::horizon_gx2_profile_stamp() };
+        (last != 0).then_some(Self {
+            last,
+            stages: [0; STAGES],
+            edges: 0,
+            steps,
+        })
+    }
+
+    pub fn mark(sample: &mut Option<Self>, stage: ClientTickStage) {
+        let Some(laps) = sample else { return };
+        let stage = stage as usize;
+        if stage != laps.edges % STAGES {
+            *sample = None;
+            return;
+        }
+        let now = unsafe { super::horizon_gx2_profile_stamp() };
+        let Some(ticks) = now.checked_sub(laps.last) else {
+            *sample = None;
+            return;
+        };
+        // Each interval is disjoint on the monotonic wall clock.
+        laps.stages[stage] += ticks;
+        laps.last = now;
+        laps.edges += 1;
+    }
+
+    pub fn complete(self) {
+        if self.edges % STAGES == 0 && self.edges / STAGES == self.steps as usize {
+            // C copies this bounded array before returning on the same thread.
+            unsafe { horizon_gx2_profile_client_tick_complete(self.steps, self.stages.as_ptr()) };
+        }
+    }
+}
