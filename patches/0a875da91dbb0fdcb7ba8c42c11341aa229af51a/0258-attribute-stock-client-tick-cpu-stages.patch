+static bool client_tick_playing(void)
+{
+   return client_tick_marker && recording && history == &process_history &&
+      current.phase == PLAYING_PHASE && ProcUIInForeground();
+}
+
+bool horizon_gx2_profile_client_tick_begin(uint32_t steps)
+{
+   if (!steps || steps > CLIENT_TICK_MAX_STEPS || !client_tick_playing()) return false;
+   // Use the first advancing tick in each frame bucket. A fixed modulo
+   // edge can alias zero-tick frames throughout 60 Hz play at 20 TPS.
+   const uint32_t bucket = history->total / CLIENT_TICK_PERIOD;
+   if (bucket == client_tick_bucket) return false;
+   client_tick_bucket = bucket;
+   client_tick_pending = (ClientTickSample){.start = started - history->epoch,
+      .sequence = history->total, .steps = steps};
+   client_tick_ready = false;
+   return true;
+}
+
+void horizon_gx2_profile_client_tick_complete(uint32_t steps, const uint64_t ticks[CLIENT_TICK_STAGES])
+{
+   if (!client_tick_playing() || !client_tick_pending.steps ||
+       steps != client_tick_pending.steps || history->total != client_tick_pending.sequence ||
+       started - history->epoch != client_tick_pending.start) return;
+   memcpy(client_tick_pending.ticks, ticks, sizeof(client_tick_pending.ticks));
+   client_tick_ready = true;
+}
+
+static void client_tick_finish(void)
+{
+   if (!client_tick_pending.steps) return;
+   const ClientTickSample sample = client_tick_pending;
+   client_tick_pending.steps = 0;
+   if (!client_tick_ready || !client_tick_playing() || sample.sequence != history->total ||
+       sample.start != started - history->epoch || current.stages[SCREENSHOT_STAGE] ||
+       current.counters[GX2_PROFILE_PRESENTED] != 1) return;
+   const uint32_t *extra = current.extra_counters;
+   if (extra[TV_SUBMISSIONS] != 1 || extra[DRC_SUBMISSIONS] != 1 ||
+       !extra[TV_SECTIONS_DRAWN] || !extra[DRC_SECTIONS_DRAWN]) return;
+
+   // The laps run entirely inside Stage::Tick. Reject invalid elapsed
+   // values without overflowing a sum and keep the HZP3 format unchanged.
+   uint64_t remaining = current.stages[CLIENT_TICK_STAGE];
+   for (unsigned i = 0; i < CLIENT_TICK_STAGES; ++i) {
+      if (sample.ticks[i] > remaining) return;
+      remaining -= sample.ticks[i];
+   }
+   if (remaining == current.stages[CLIENT_TICK_STAGE]) return;
+
+   client_tick_rows[client_tick_next] = sample;
+   client_tick_next = (client_tick_next + 1) % CLIENT_TICK_CAPACITY;
+   if (client_tick_count < CLIENT_TICK_CAPACITY) ++client_tick_count;
+}
+
+static void report_client_tick_laps(void)
+{
+   uint32_t index = (client_tick_next + CLIENT_TICK_CAPACITY - client_tick_count) % CLIENT_TICK_CAPACITY;
+   for (uint32_t i = 0; i < client_tick_count; ++i, index = (index + 1) % CLIENT_TICK_CAPACITY) {
+      const ClientTickSample *sample = &client_tick_rows[index];
+      // Long runs can overwrite an earlier sample's HZP3 row.
+      if (sample->sequence >= history->total || history->total - sample->sequence > CAPACITY) continue;
+      const ProfileFrame *frame = &history->ring[sample->sequence % CAPACITY];
+      const uint64_t start = (uint64_t)frame->start_hi << 32 | frame->start_lo;
+      if (frame->sequence != sample->sequence || start != sample->start) continue;
+      const uint64_t *v = sample->ticks;
+      OSReport("Horizon Cafe client tick wall seq=%u start_ticks=%llu clock_hz=%u steps=%u "
+               "stages=%llu/%llu/%llu/%llu/%llu/%llu\n", sample->sequence,
+               (unsigned long long)sample->start, OSTimerClockSpeed, sample->steps,
+               (unsigned long long)v[0], (unsigned long long)v[1], (unsigned long long)v[2],
+               (unsigned long long)v[3], (unsigned long long)v[4], (unsigned long long)v[5]);
+   }
+   client_tick_count = 0;
+}
