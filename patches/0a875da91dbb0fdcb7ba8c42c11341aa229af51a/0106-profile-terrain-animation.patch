+            "writeback_ticks=%llu invalidate_ticks=%llu\n", current.sequence,
+            (unsigned long long)sum->phases[0], (unsigned long long)sum->phases[1],
+            (unsigned long long)sum->phases[2]);
+   memset(&animation_window, 0, sizeof(animation_window));
+   // The serial write happened after the captured loop. Leave its delay out
+   // of the next start-to-start and flip intervals as with file checkpoints.
