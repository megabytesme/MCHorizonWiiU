+static void report_animation_window(uint64_t now)
+{
+   if (current.phase != PLAYING_PHASE || current.stages[SCREENSHOT_STAGE] ||
+       !current.extra_counters[TV_SUBMISSIONS] || !current.extra_counters[DRC_SUBMISSIONS] ||
+       !current.extra_counters[TV_SECTIONS_DRAWN] || !current.extra_counters[DRC_SECTIONS_DRAWN]) {
+      memset(&animation_window, 0, sizeof(animation_window));
+      return;
+   }
+   if (!animation_window.pairs) {
+      animation_window.begin = started;
+      animation_window.first = current.sequence;
+   }
+   ++animation_window.pairs;
+   animation_window.updates += animation_sample.cells != 0;
+   TerrainAnimationSample *sum = &animation_window.sum;
+   for (unsigned phase = 0; phase < 3; ++phase)
+      sum->phases[phase] += animation_sample.phases[phase];
+   sum->cells += animation_sample.cells;
+   sum->bytes += animation_sample.bytes;
+   sum->stores += animation_sample.stores;
