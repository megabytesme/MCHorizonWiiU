+use core::mem::MaybeUninit;
+use horizon_client::{gfx::translucency::quad_indices, mesher::TerrainVertex};
+use horizon_wiiu_gx2_terrain::{IndexedTerrainVertex, TerrainAtlasLayout};
+
+#[derive(Clone, Copy)]
+pub(super) struct ReusePlan {
+    pub(super) resident_vertices: u32,
+    pub(super) logical_quads: u32,
+}
+
+impl ReusePlan {
+    /// Count first, without allocating. The native estimate includes aligned
+    /// resident vertices and the full logical sorted index lane.
+    pub(super) fn estimate(
+        source: &[TerrainVertex],
+        stock_gpu_bytes: usize,
+        estimate_native: impl FnOnce(u32, u32) -> Option<u32>,
+    ) -> Option<(Self, usize)> {
+        let logical_vertices = u32::try_from(source.len()).ok()?;
+        let (quads, tail) = source.as_chunks::<4>();
+        if !tail.is_empty() {
+            return None;
+        }
+        let resident_vertices = scan(quads, |_| {});
+        if resident_vertices == logical_vertices {
+            return None;
+        }
+        let plan = Self {
+            resident_vertices,
+            logical_quads: logical_vertices / 4,
+        };
+        let native = estimate_native(plan.resident_vertices, plan.logical_quads)? as usize;
+        let total = native.checked_add(plan.logical_quads as usize * size_of::<u32>())?;
+        (total < stock_gpu_bytes).then_some((plan, total))
+    }
+
+    /// The upload admission has reserved both native and map bytes. No
+    /// allocation or mutation of the source mesh occurs during estimation.
+    pub(super) fn build(self, source: &[TerrainVertex]) -> Option<ReuseMap> {
+        let (quads, tail) = source.as_chunks::<4>();
+        let count = self.logical_quads as usize;
+        if !tail.is_empty() || quads.len() != count {
+            return None;
+        }
+        let mut entries = Vec::new();
+        entries.try_reserve_exact(count).ok()?;
+        if entries.capacity() != count {
+            return None;
+        }
+        let resident_vertices = scan(quads, |entry| entries.push(entry));
+        if resident_vertices != self.resident_vertices {
+            return None;
+        }
+        // Exact length avoids a second allocation when sealing the map.
+        Some(ReuseMap(entries.into_boxed_slice()))
+    }
+}
+
+pub(super) struct ReuseMap(Box<[u32]>);
+
+impl ReuseMap {
+    pub(super) fn logical_quads(&self) -> usize {
+        self.0.len()
+    }
+
+    pub(super) fn bytes(&self) -> usize {
+        size_of_val(&*self.0)
+    }
+
+    pub(super) fn indices(&self, quad: u32) -> [u32; 6] {
+        let entry = self.0[quad as usize];
+        quad_indices(entry & !1, entry & 1 != 0)
+    }
+
+    pub(super) fn write_vertices(
+        &self,
+        atlas: &TerrainAtlasLayout,
+        source: &[TerrainVertex],
+        output: &mut [MaybeUninit<IndexedTerrainVertex>],
+    ) -> Result<(), &'static str> {
+        let (quads, tail) = source.as_chunks::<4>();
+        if !tail.is_empty() || quads.len() != self.logical_quads() {
+            return Err("GX2 reverse-quad source mismatch");
+        }
+        let expected = self.0.last().map(|entry| (entry & !1) as usize + 4);
+        if expected != Some(output.len()) {
+            return Err("GX2 reverse-quad mapped size mismatch");
+        }
+        let mut mapped = output.chunks_exact_mut(4);
+        for (&entry, quad) in self.0.iter().zip(quads) {
+            if entry & 1 == 0 {
+                let dst = mapped
+                    .next()
+                    .ok_or("GX2 reverse-quad mapping is too short")?;
+                atlas.write_translucent_vertices(quad, dst)?;
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Exact adjacent reverse winding only. Bit zero is free because every
+/// resident quad starts at a four-vertex boundary.
+fn scan(quads: &[[TerrainVertex; 4]], mut logical: impl FnMut(u32)) -> u32 {
+    let mut next = quads.iter().peekable();
+    let mut base = 0;
+    while let Some(front) = next.next() {
+        logical(base);
+        if next.peek().is_some_and(|back| exact_reverse(front, back)) {
+            logical(base | 1);
+            next.next();
+        }
+        base += 4;
+    }
+    base
+}
+
+fn exact_reverse(front: &[TerrainVertex; 4], back: &[TerrainVertex; 4]) -> bool {
+    [0, 3, 2, 1].into_iter().zip(back).all(|(i, rhs)| {
+        let lhs = &front[i];
+        lhs.pos.map(f32::to_bits) == rhs.pos.map(f32::to_bits)
+            && lhs.uv == rhs.uv
+            && lhs.layer == rhs.layer
+            && lhs.light == rhs.light
+            && lhs.color == rhs.color
+    })
+}
