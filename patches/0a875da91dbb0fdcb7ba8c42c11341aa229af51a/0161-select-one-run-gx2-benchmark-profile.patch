+/* The hosted foreground owns history. Worker activities touch only the atomic
+ * process totals; each history records them relative to its own baseline.
+ * The numeric mode values match BenchmarkProfile in the Night launcher. */
+bool horizon_gx2_profile_begin_trial(uint32_t mode)
+{
+   if (history != &process_history || recording || mode > 2) return false;
+   ProfileHistory *trial = calloc(1, sizeof(*trial));
+   if (!trial) return false;
+   for (uint32_t i = 0; i < WORKERS; ++i)
+      for (uint32_t j = 0; j < 2; ++j)
+         trial->worker_base[i][j] = atomic_load_explicit(&workers[i][j], memory_order_relaxed);
+   trial->epoch = (uint64_t)OSGetSystemTime();
+   history = trial;
+   select_mode('4', mode == 1 ? 'q' : mode == 2 ? 'r' : EOF);
+   atomic_store_explicit(&enabled, true, memory_order_release);
+   const char *name = mode == 1 ? "4q" : mode == 2 ? "4r" : "4";
+   OSReport("Horizon GX2 benchmark capture begin: mode=%s clock_hz=%u gpu_cycles=%u\n",
+            name, OSTimerClockSpeed, (unsigned)gpu_cycle_probe);
+   return true;
+}
+
+bool horizon_gx2_profile_end_trial(const char *path)
+{
+   if (history == &process_history) return false;
+   char temporary[FS_MAX_PATH];
+   bool saved = path == NULL && !recording;
+   if (path && !recording) {
+      const int length = snprintf(temporary, sizeof(temporary), "%s.tmp", path);
+      struct stat existing;
+      if (length >= 0 && (size_t)length < sizeof(temporary) &&
+          stat(path, &existing) != 0 && errno == ENOENT) {
+         saved = flush_to(path, temporary);
+      }
+   }
+   for (uint32_t i = 0; i < WORKERS; ++i)
+      for (uint32_t j = 0; j < 2; ++j)
+         process_history.worker_base[i][j] +=
+            atomic_load_explicit(&workers[i][j], memory_order_relaxed) - history->worker_base[i][j];
+   free(history);
+   history = &process_history;
+   recording = false;
+   // Exclude trial time and swaps from the resumed Night capture.
+   history->previous_phase = 0;
+   history->previous_output = (ProfileOutput){0};
+   memset(&animation_window, 0, sizeof(animation_window));
+   select_mode(marker_mode, marker_variant);
+   atomic_store_explicit(&enabled, marker_enabled, memory_order_release);
+   OSReport("Horizon GX2 benchmark capture end: saved=%u marker_enabled=%u\n",
+            (unsigned)(saved && path != NULL), (unsigned)marker_enabled);
+   return saved;
+}
