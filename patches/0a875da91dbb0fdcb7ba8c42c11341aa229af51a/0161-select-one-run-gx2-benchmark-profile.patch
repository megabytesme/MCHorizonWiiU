+// This guard must outlive the job owners, hosted game and GX2 presenter.
+struct BenchmarkCapture {
+    profile: night_menu::BenchmarkProfile,
+    active: bool,
+}
+
+impl BenchmarkCapture {
+    fn begin(profile: night_menu::BenchmarkProfile) -> Option<Self> {
+        unsafe { horizon_gx2_profile_begin_trial(profile as u32) }.then(|| Self {
+            profile,
+            active: true,
+        })
+    }
+
+    fn publish(mut self, reports: &Path, report: &str) -> Option<String> {
+        let stem = Path::new(report).file_stem()?.to_str()?;
+        let id = format!("{stem}-{}.hzp", self.profile.label());
+        let path = reports.join(&id);
+        let path = std::ffi::CString::new(path.as_os_str().as_encoded_bytes()).ok()?;
+        self.active = false;
+        unsafe { horizon_gx2_profile_end_trial(path.as_ptr()) }.then_some(id)
+    }
+}
+
+impl Drop for BenchmarkCapture {
+    fn drop(&mut self) {
+        if self.active {
+            unsafe { horizon_gx2_profile_end_trial(std::ptr::null()) };
+        }
+    }
+}
