+//! Bounded Cafe PCM transport. The decoder owns the producer and the channel
+//! owns cancellation. The mixer never waits for a producer or does file I/O.
+use horizon_assets::resource_source::Resource;
+use std::collections::VecDeque;
+use std::io::Cursor;
+use std::sync::{
+    Arc, Condvar, Mutex,
+    atomic::{AtomicBool, Ordering},
+};
+use std::time::Duration;
+use symphonia::core::{
+    audio::SampleBuffer,
+    codecs::DecoderOptions,
+    formats::FormatOptions,
+    io::{MediaSource, MediaSourceStream},
+    meta::MetadataOptions,
+    probe::Hint,
+};
+
+pub(super) const FRAME_CAPACITY: usize = 16_384;
+const COMPRESSED_ENTRY_LIMIT: u64 = 8 * 1024 * 1024;
+// Vorbis packets cannot exceed this block size per input channel.
+const MAX_PACKET_FRAMES: usize = 8192;
+const MAX_INPUT_CHANNELS: usize = 8;
+
+type StereoFrame = [f32; 2];
+
+struct Queued {
+    format: Option<(u32, u16)>,
+    frames: VecDeque<StereoFrame>,
+    peak_frames: usize,
+}
+
+pub(super) struct Pipe {
+    samples: Mutex<Queued>,
+    room: Condvar,
+    cancelled: AtomicBool,
+    finished: AtomicBool,
+}
+
+impl Pipe {
+    pub(super) fn new() -> Arc<Self> {
+        Arc::new(Self {
+            samples: Mutex::new(Queued {
+                format: None,
+                frames: VecDeque::with_capacity(FRAME_CAPACITY),
+                peak_frames: 0,
+            }),
+            room: Condvar::new(),
+            cancelled: AtomicBool::new(false),
+            finished: AtomicBool::new(false),
+        })
+    }
+
+    fn active(&self, stop: &AtomicBool) -> bool {
+        !stop.load(Ordering::Acquire) && !self.cancelled.load(Ordering::Acquire)
+    }
+
+    fn set_format(&self, rate: u32, channels: u16) -> bool {
+        let Ok(mut samples) = self.samples.lock() else {
+            return false;
+        };
+        *samples.format.get_or_insert((rate, channels)) == (rate, channels)
+    }
+
+    fn push(&self, mut input: &[StereoFrame], stop: &AtomicBool) -> bool {
+        let Ok(mut samples) = self.samples.lock() else {
+            return false;
+        };
+        while !input.is_empty() && self.active(stop) {
+            let write = input.len().min(FRAME_CAPACITY - samples.frames.len());
+            if write == 0 {
+                // The session token is shared by all workers. Keep the wait
+                // bounded even when cancellation races the notification.
+                let Ok((next, _)) = self.room.wait_timeout(samples, Duration::from_millis(8))
+                else {
+                    return false;
+                };
+                samples = next;
+                continue;
+            }
+            samples.frames.extend(&input[..write]);
+            samples.peak_frames = samples.peak_frames.max(samples.frames.len());
+            input = &input[write..];
+        }
+        input.is_empty()
+    }
+
+    pub(super) fn format(&self) -> Option<(u32, u16)> {
+        let samples = self.samples.try_lock().ok()?;
+        // Prime at least two DSP batches at typical source rates. A completed
+        // short clip can be consumed immediately.
+        if samples.frames.len() < 1024 && !self.finished() {
+            return None;
+        }
+        samples.format
+    }
+
+    pub(super) fn finished_without_format(&self) -> bool {
+        self.finished()
+            && self
+                .samples
+                .try_lock()
+                .is_ok_and(|samples| samples.format.is_none())
+    }
+
+    fn finished(&self) -> bool {
+        self.finished.load(Ordering::Acquire)
+    }
+
+    pub(super) fn mix(
+        &self,
+        out: &mut [f32],
+        output_channels: usize,
+        [left, right, gain]: [f32; 3],
+        step: f64,
+        position: &mut f64,
+    ) -> bool {
+        let Ok(mut samples) = self.samples.try_lock() else {
+            return false;
+        };
+        let channel_count = samples.format.map_or(1, |(_, channels)| channels);
+        for frame in out.chunks_mut(output_channels) {
+            let index = *position as usize;
+            let Some(next) = index.checked_add(1).and_then(|i| samples.frames.get(i)) else {
+                break;
+            };
+            let current = samples.frames[index];
+            let fraction = (*position - index as f64) as f32;
+            let l = current[0] + (next[0] - current[0]) * fraction;
+            let r = current[1] + (next[1] - current[1]) * fraction;
+            if output_channels >= 2 {
+                frame[0] += l * left;
+                frame[1] += r * right;
+            } else if channel_count == 1 {
+                frame[0] += l * gain;
+            } else {
+                frame[0] += (l + r) * 0.5 * gain;
+            }
+            *position += step;
+        }
+        let consumed = (*position as usize).min(samples.frames.len().saturating_sub(1));
+        if consumed != 0 {
+            samples.frames.drain(..consumed);
+            *position -= consumed as f64;
+            self.room.notify_one();
+        }
+        self.finished() && (*position as usize).saturating_add(1) >= samples.frames.len()
+    }
+}
+
+pub(super) struct Track(pub(super) Arc<Pipe>);
+
+impl Drop for Track {
+    fn drop(&mut self) {
+        self.0.cancelled.store(true, Ordering::Release);
+        self.0.room.notify_all();
+    }
+}
+
+struct Producer(Arc<Pipe>);
+
+impl Drop for Producer {
+    fn drop(&mut self) {
+        self.0.finished.store(true, Ordering::Release);
+        if let Ok(samples) = self.0.samples.lock() {
+            log::info!(
+                "Horizon Cafe PCM stream finished: peak_bytes={} queued_bytes={} limit_bytes={}",
+                samples.peak_frames * size_of::<StereoFrame>(),
+                samples.frames.len() * size_of::<StereoFrame>(),
+                FRAME_CAPACITY * size_of::<StereoFrame>(),
+            );
+        }
+    }
+}
+
+fn input(resource: &Resource) -> std::io::Result<Box<dyn MediaSource>> {
+    if let Some(file) = resource.open_loose_ogg() {
+        return file.map(|file| Box::new(file) as Box<dyn MediaSource>);
+    }
+    resource
+        .read_limited(COMPRESSED_ENTRY_LIMIT)
+        .map(|bytes| Box::new(Cursor::new(bytes)) as Box<dyn MediaSource>)
+}
+
+fn decode_once(resource: &Resource, output: &Pipe, stop: &AtomicBool) -> Option<bool> {
+    let file = input(resource).ok()?;
+    if !output.active(stop) {
+        return Some(false);
+    }
+    let stream = MediaSourceStream::new(file, Default::default());
+    let mut hint = Hint::new();
+    hint.with_extension("ogg");
+    let mut format = symphonia::default::get_probe()
+        .format(
+            &hint,
+            stream,
+            &FormatOptions::default(),
+            &MetadataOptions::default(),
+        )
+        .ok()?
+        .format;
+    let track = format.default_track()?;
+    let id = track.id;
+    let rate = track.codec_params.sample_rate.filter(|rate| *rate != 0)?;
+    let mut decoder = symphonia::default::get_codecs()
+        .make(&track.codec_params, &DecoderOptions::default())
+        .ok()?;
+    let mut projected = Vec::with_capacity(MAX_PACKET_FRAMES);
+    let mut produced = 0usize;
+    while output.active(stop) {
+        let packet = match format.next_packet() {
+            Ok(packet) => packet,
+            Err(symphonia::core::errors::Error::IoError(error))
+                if error.kind() == std::io::ErrorKind::UnexpectedEof =>
+            {
+                break;
+            }
+            Err(_) => return None,
+        };
+        if packet.track_id() != id {
+            continue;
+        }
+        let decoded = decoder.decode(&packet).ok()?;
+        let spec = *decoded.spec();
+        let channels = spec.channels.count();
+        if !(1..=MAX_INPUT_CHANNELS).contains(&channels) || decoded.capacity() > MAX_PACKET_FRAMES {
+            return None;
+        }
+        if !output.set_format(rate, channels.min(2) as u16) {
+            return None;
+        }
+        let mut interleaved = SampleBuffer::<f32>::new(decoded.capacity() as u64, spec);
+        interleaved.copy_interleaved_ref(decoded);
+        projected.clear();
+        projected.extend(
+            interleaved
+                .samples()
+                .chunks_exact(channels)
+                .map(|frame| match frame {
+                    [mono] => [*mono, *mono],
+                    [left, right] => [*left, *right],
+                    _ => {
+                        let left =
+                            frame.iter().step_by(2).sum::<f32>() / channels.div_ceil(2) as f32;
+                        let right =
+                            frame[1..].iter().step_by(2).sum::<f32>() / (channels / 2) as f32;
+                        [left, right]
+                    }
+                }),
+        );
+        if !output.push(&projected, stop) {
+            return Some(false);
+        }
+        produced = produced.saturating_add(projected.len());
+    }
+    Some(produced > 1 && output.active(stop))
+}
+
+pub(super) fn decode(resource: Resource, output: Arc<Pipe>, stop: Arc<AtomicBool>, looping: bool) {
+    let producer = Producer(output);
+    while producer.0.active(&stop) {
+        match decode_once(&resource, &producer.0, &stop) {
+            Some(true) if looping => {}
+            Some(_) => break,
+            None => {
+                log::warn!("Horizon: Cafe streaming sound decode failed");
+                break;
+            }
+        }
+    }
+}
