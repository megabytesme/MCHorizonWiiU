+#[cfg(test)]
+mod stock_track_tests {
+    use super::*;
+    use horizon_assets::resource_source::ResourceSource;
+    use std::{path::PathBuf, time::Instant};
+
+    #[test]
+    #[ignore = "requires prepared Minecraft 26.3 music"]
+    fn long_loose_ogg_reaches_mixer_with_bounded_pcm() {
+        let root = PathBuf::from(std::env::var_os("HORIZON_TEST_RESOURCES").expect("resources"));
+        let name = std::env::var("HORIZON_TEST_TRACK").expect("relative Ogg path");
+        let resource = Resource::file(ResourceSource::directory(root), name);
+        assert!(resource.open_loose_ogg().expect("loose Ogg").is_ok());
+        let pipe = Pipe::new();
+        let worker_pipe = pipe.clone();
+        let track = Track(pipe.clone());
+        let worker = std::thread::spawn(move || {
+            decode(
+                resource,
+                worker_pipe,
+                Arc::new(AtomicBool::new(false)),
+                false,
+            );
+        });
+        let deadline = Instant::now() + Duration::from_secs(45);
+        let mut position = 0.0;
+        let mut nonzero_samples = 0;
+        let mut iterations = 0;
+        loop {
+            assert!(Instant::now() < deadline);
+            let mut out = [0.0; 2048];
+            let previous_peak = nonzero_samples;
+            let finished = pipe.mix(&mut out, 2, [1.0; 3], 1.0, &mut position);
+            nonzero_samples += out.iter().filter(|sample| sample.abs() > 1e-7).count();
+            iterations += 1;
+            if finished {
+                break;
+            }
+            if nonzero_samples == previous_peak {
+                if iterations % 16 == 0 {
+                    std::thread::sleep(Duration::from_micros(150));
+                } else {
+                    std::thread::yield_now();
+                }
+            }
+        }
+        worker.join().unwrap();
+        let peak = pipe.samples.lock().unwrap().peak_frames * size_of::<StereoFrame>();
+        eprintln!("long Ogg: nonzero_samples={nonzero_samples} peak_queued_pcm_bytes={peak}");
+        assert!(nonzero_samples > 5_000_000);
+        assert!(peak <= FRAME_CAPACITY * size_of::<StereoFrame>());
+        drop(track);
+        assert_eq!(Arc::strong_count(&pipe), 1);
+    }
+}
