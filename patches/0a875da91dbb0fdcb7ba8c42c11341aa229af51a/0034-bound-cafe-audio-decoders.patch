+            assert!(receiver.recv().is_err());
+            idle_done.send(()).unwrap();
+        }));
+        let stop = decoders.stop.clone();
+        let (active_done, active_result) = channel();
+        decoders.streams.push(std::thread::spawn(move || {
+            while !stop.load(Ordering::Acquire) {
+                std::thread::yield_now();
+            }
+            active_done.send(()).unwrap();
+        }));
+        decoders.finish(&mut sender);
+        assert!(sender.is_none());
+        assert!(decoders.streams.is_empty());
+        assert!(decoders.effects.is_none());
+        idle_result.try_recv().unwrap();
+        active_result.try_recv().unwrap();
+    }
+
