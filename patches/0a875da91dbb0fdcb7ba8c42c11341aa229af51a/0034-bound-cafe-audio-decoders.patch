+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn long_stream_backpressure_and_track_cancel_release_worker() {
+        let pipe = Pipe::new();
+        let track = Track(pipe.clone());
+        let stop = Arc::new(AtomicBool::new(false));
+        let producer = pipe.clone();
+        let worker = std::thread::spawn(move || {
+            assert!(producer.set_format(48_000, 2));
+            let packet = [[0.5, -0.5]; 256];
+            for _ in 0..100_000 {
+                if !producer.push(&packet, &stop) {
+                    return;
+                }
+            }
+            panic!("producer should have blocked and then received cancellation");
+        });
+        let deadline = std::time::Instant::now() + Duration::from_secs(2);
+        while pipe.samples.lock().unwrap().frames.len() < FRAME_CAPACITY {
+            assert!(std::time::Instant::now() < deadline);
+            std::thread::yield_now();
+        }
+        let mut out = [0.0; 16];
+        let mut position = 0.0;
+        assert!(!pipe.mix(&mut out, 2, [1.0; 3], 1.0, &mut position));
+        assert_eq!(&out[..2], &[0.5, -0.5]);
+        assert_eq!(pipe.samples.lock().unwrap().peak_frames, FRAME_CAPACITY);
+        drop(track);
+        worker.join().unwrap();
+        assert_eq!(Arc::strong_count(&pipe), 1);
+    }
+
+    #[test]
+    fn underrun_waits_without_advancing_and_end_releases_channel() {
+        let pipe = Pipe::new();
+        let mut out = [0.0; 16];
+        let mut position = 0.0;
+        assert!(!pipe.mix(&mut out, 2, [1.0; 3], 1.0, &mut position));
+        assert_eq!(out, [0.0; 16]);
+        assert_eq!(position, 0.0);
+        let stop = AtomicBool::new(false);
+        assert!(pipe.set_format(32_000, 1));
+        assert!(pipe.push(&[[0.25, 0.25]; 3], &stop));
+        pipe.finished.store(true, Ordering::Release);
+        assert_eq!(pipe.format(), Some((32_000, 1)));
+        assert!(pipe.mix(&mut out, 2, [1.0; 3], 1.0, &mut position));
+        assert_eq!(&out[..4], &[0.25; 4]);
+        assert_eq!(&out[4..], &[0.0; 12]);
+    }
+}
