+// The embedded mixer is reopened for each world. Do not leave the old world's
+// detached decoders filling PCM after the mixer and game have been released.
+#[cfg(any(target_os = "cafe", test))]
+#[derive(Default)]
+struct CafeDecodeWorkers {
+    stop: Arc<std::sync::atomic::AtomicBool>,
+    effects: Option<std::thread::JoinHandle<()>>,
+    streams: Vec<std::thread::JoinHandle<()>>,
+    pipes: Vec<std::sync::Weak<cafe_pcm::Pipe>>,
+}
+
+#[cfg(any(target_os = "cafe", test))]
+impl CafeDecodeWorkers {
+    fn join(thread: std::thread::JoinHandle<()>) {
+        if thread.join().is_err() {
+            log::warn!("Horizon: Cafe sound decoder stopped unexpectedly");
+        }
+    }
+
+    fn reap_finished(&mut self) {
+        let mut index = 0;
+        while index < self.streams.len() {
+            if self.streams[index].is_finished() {
+                Self::join(self.streams.swap_remove(index));
+            } else {
+                index += 1;
+            }
+        }
+    }
+
+    fn open_stream(&mut self) -> Option<Arc<cafe_pcm::Pipe>> {
+        const MAX_STREAMS: usize = 4;
+        self.reap_finished();
+        // A completed producer can still have a tail queued in the mixer.
+        // Charge the ring until both its producer and channel let it go.
+        self.pipes.retain(|pipe| pipe.strong_count() != 0);
+        if self.pipes.len() >= MAX_STREAMS {
+            return None;
+        }
+        let pipe = cafe_pcm::Pipe::new();
+        self.pipes.push(Arc::downgrade(&pipe));
+        Some(pipe)
+    }
+
+    fn finish(&mut self, sender: &mut Option<DecodeSender>) {
+        self.stop.store(true, std::sync::atomic::Ordering::Release);
+        *sender = None;
+        let count = self.streams.len() + usize::from(self.effects.is_some());
+        for thread in self.streams.drain(..).chain(self.effects.take()) {
+            Self::join(thread);
+        }
+        if count > 0 {
+            log::info!("Horizon Cafe sound decoders joined: {count}");
+        }
+    }
+}
