@@ -0,0 +1,121 @@
+use super::{plain, store};
+use serde_json::Value;
+use std::path::Path;
+
+const MAX_REPORT_BYTES: u64 = 2 * 1024 * 1024;
+
+pub(super) fn read(folder: &Path, id: &str) -> Option<Value> {
+    if !store::identifier(id) || !id.ends_with(".json") || !plain(folder, true) {
+        return None;
+    }
+    let path = folder.join(id);
+    if !plain(&path, false) {
+        return None;
+    }
+    let bytes = store::read_limited(&path, MAX_REPORT_BYTES).ok()?;
+    let value: Value = serde_json::from_slice(&bytes).ok()?;
+    (value["format"].as_str()? == "horizon-benchmark-report" && value["version"].as_u64()? == 1)
+        .then_some(value)
+}
+
+/// Keep the standard measurement data and omit local report annotations and attachments.
+pub(super) fn for_agent(mut report: Value) -> Value {
+    if let Some(fields) = report.as_object_mut() {
+        fields.retain(|key, _| {
+            matches!(
+                key.as_str(),
+                "format"
+                    | "version"
+                    | "kind"
+                    | "created"
+                    | "app"
+                    | "hardware"
+                    | "conditions"
+                    | "metrics"
+                    | "frames"
+                    | "ab"
+            )
+        });
+    }
+    report
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    use std::fs;
+    use std::path::PathBuf;
+
+    struct Scratch(PathBuf);
+
+    impl Scratch {
+        fn new() -> Self {
+            use std::time::{SystemTime, UNIX_EPOCH};
+            let stamp = SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap()
+                .as_nanos();
+            let path =
+                std::env::temp_dir().join(format!("wiiu-reports-{}-{stamp}", std::process::id()));
+            fs::create_dir(&path).unwrap();
+            Self(path)
+        }
+    }
+
+    impl Drop for Scratch {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    #[test]
+    fn exports_measurements_without_local_attachments_or_labels() {
+        let scratch = Scratch::new();
+        let filename = "game-20261126-village.json";
+        let report = json!({
+            "format": "horizon-benchmark-report",
+            "version": 1,
+            "conditions": {"scenario": "village"},
+            "metrics": {"paired_fps": {"mean": 20.0}},
+            "frames": [{"phase": "game", "p95_ms": 50.0}],
+            "local": ["trace.json"],
+            "label": "personal label",
+        });
+        fs::write(scratch.0.join(filename), report.to_string()).unwrap();
+        let reply = for_agent(read(&scratch.0, filename).unwrap());
+        assert_eq!(
+            reply,
+            json!({
+                "format": "horizon-benchmark-report",
+                "version": 1,
+                "conditions": {"scenario": "village"},
+                "metrics": {"paired_fps": {"mean": 20.0}},
+                "frames": [{"phase": "game", "p95_ms": 50.0}],
+            })
+        );
+    }
+
+    #[test]
+    fn refuses_paths_non_reports_and_excess_size() {
+        let scratch = Scratch::new();
+        let folder = scratch.0.join("benchmarks");
+        fs::create_dir(&folder).unwrap();
+        let report = br#"{"format":"horizon-benchmark-report","version":1}"#;
+        fs::write(scratch.0.join("outer.json"), report).unwrap();
+        assert!(read(&folder, "../outer.json").is_none());
+        fs::write(folder.join("settings.json"), br#"{"version":1}"#).unwrap();
+        assert!(read(&folder, "settings.json").is_none());
+        fs::File::create(folder.join("oversize.json"))
+            .unwrap()
+            .set_len(MAX_REPORT_BYTES + 1)
+            .unwrap();
+        assert!(read(&folder, "oversize.json").is_none());
+        #[cfg(unix)]
+        {
+            std::os::unix::fs::symlink(scratch.0.join("outer.json"), folder.join("link.json"))
+                .unwrap();
+            assert!(read(&folder, "link.json").is_none());
+        }
+    }
+}
