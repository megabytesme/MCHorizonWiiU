diff --git a/wiiu/loading_app/src/night_test_world.rs b/wiiu/loading_app/src/night_test_world.rs
new file mode 100644
index 0000000000000000000000000000000000000000..915f1483ca2eb4cc1140ad35fd7d39ecd6ff7eef
--- /dev/null
+++ b/wiiu/loading_app/src/night_test_world.rs
@@ -0,0 +1,239 @@
+//! Disposable workspaces for the selected installation and profile.
+use std::fs::{self, OpenOptions};
+use std::io::{ErrorKind, Write};
+use std::path::{Path, PathBuf};
+
+use horizon_wiiu_mcp::oauth;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+
+use super::{
+    entries, plain, store, GameFiles, Launch, LocalService, Page, ResourceStatus, Target,
+    WorldLaunch,
+};
+
+const ROOT: &str = ".night-test-worlds";
+const MARKER: &str = "horizon-night-test-world.json";
+pub(crate) const FOLDER: &str = "Disposable Test World";
+
+enum TestWorldAction {
+    Create(i64),
+    Open,
+}
+
+pub(crate) struct TestWorldRequest {
+    pub(crate) id: String,
+    pub(crate) instance: String,
+    owner: String,
+    action: TestWorldAction,
+}
+
+#[derive(Deserialize, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Marker {
+    schema: u8,
+    id: String,
+    instance: String,
+    owner: String,
+}
+
+impl Marker {
+    fn for_request(request: &TestWorldRequest) -> Self {
+        Self {
+            schema: 1,
+            id: request.id.clone(),
+            instance: request.instance.clone(),
+            owner: request.owner.clone(),
+        }
+    }
+}
+
+fn valid_id(id: &str) -> bool {
+    id.len() == 32
+        && id
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn sandbox_marker(root: &Path, id: &str) -> Option<Marker> {
+    if !valid_id(id) || !plain(root, true) {
+        return None;
+    }
+    let workspace = root.join(id);
+    let path = workspace.join(MARKER);
+    if !plain(&workspace, true) || !plain(&path, false) {
+        return None;
+    }
+    let record: Marker = serde_json::from_slice(&store::read_limited(&path, 512).ok()?).ok()?;
+    (record.schema == 1 && id == record.id).then_some(record)
+}
+
+fn reserve_workspace(root: &Path, request: &TestWorldRequest) -> Result<PathBuf, &'static str> {
+    if !valid_id(&request.id) {
+        return Err("The disposable test-world ID is invalid.");
+    }
+    match fs::create_dir(root) {
+        Ok(()) => {}
+        Err(error) if error.kind() == ErrorKind::AlreadyExists && plain(root, true) => {}
+        Err(_) => return Err("The disposable test-world directory is unavailable."),
+    }
+    let marker = Marker::for_request(request);
+    let payload =
+        serde_json::to_vec(&marker).map_err(|_| "Could not encode the test-world marker.")?;
+    let workspace = root.join(&request.id);
+    // An existing directory might be any save. Only a fresh allocation can be created.
+    fs::create_dir(&workspace).map_err(|_| "Could not reserve a fresh test-world workspace.")?;
+    let marker_path = workspace.join(MARKER);
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&marker_path)
+        .map_err(|_| "Could not create the test-world marker.")?;
+    file.write_all(&payload)
+        .and_then(|()| file.sync_all())
+        .map_err(|_| "Could not persist the test-world marker.")?;
+    Ok(workspace)
+}
+
+impl<G: GameFiles> LocalService<G> {
+    fn test_world_owner(&self) -> Option<String> {
+        if self.online.agent_profile_refreshing() {
+            return None;
+        }
+        if self.online.selected().is_some() {
+            return self
+                .online
+                .active()
+                .map(|identity| format!("online:{:032x}", identity.id.0));
+        }
+        Some(format!(
+            "offline:{}",
+            self.preferences.profiles[self.preferences.profile].identity
+        ))
+    }
+
+    pub(in crate::hosted) fn test_world_request(
+        &self,
+        id: Option<&str>,
+        seed: i64,
+    ) -> Result<TestWorldRequest, &'static str> {
+        if !matches!(self.page, Page::Home) {
+            return Err("Return to the Night home page before opening a test world.");
+        }
+        let launch = self.launch_game_for_target(&Target::Menu).map_err(|_| {
+            "The installation or selected profile is not ready to open a test world."
+        })?;
+        let owner = self
+            .test_world_owner()
+            .ok_or("The selected profile is unavailable.")?;
+        let (id, action) = match id {
+            Some(id) if valid_id(id) => (id.to_owned(), TestWorldAction::Open),
+            Some(_) => return Err("Use a disposable ID from wiiu_test_worlds_list."),
+            None => {
+                let bytes: [u8; 16] = oauth::random_bytes()
+                    .map_err(|_| "Night could not allocate a test-world ID.")?;
+                (
+                    format!("{:032x}", u128::from_be_bytes(bytes)),
+                    TestWorldAction::Create(seed),
+                )
+            }
+        };
+        let request = TestWorldRequest {
+            id,
+            action,
+            owner,
+            instance: self.preferences.instance.clone(),
+        };
+        if matches!(request.action, TestWorldAction::Open) {
+            self.reopen_test_world(&launch.game.join(ROOT), &request)?;
+        }
+        Ok(request)
+    }
+
+    fn reopen_test_world(
+        &self,
+        root: &Path,
+        request: &TestWorldRequest,
+    ) -> Result<PathBuf, &'static str> {
+        if sandbox_marker(root, &request.id) != Some(Marker::for_request(request)) {
+            return Err(
+                "No disposable test world belongs to the selected installation and profile.",
+            );
+        }
+        let workspace = root.join(&request.id);
+        self.check_test_save(&workspace)?;
+        Ok(workspace)
+    }
+
+    fn check_test_save(&self, workspace: &Path) -> Result<(), &'static str> {
+        let saves = workspace.join("saves");
+        if !plain(&saves, true) {
+            return Err("The disposable saves directory is missing or unsafe.");
+        }
+        // Quick Play skips the title-screen access prompt that inspects nested links.
+        if !self.game.world_tree_safe(&saves, FOLDER) {
+            return Err("Night could not validate the disposable world directory for links.");
+        }
+        if !self
+            .world_in(workspace, FOLDER)
+            .is_some_and(|world| world.unavailable.is_none())
+        {
+            return Err("The disposable save is missing, locked, or unavailable to this profile.");
+        }
+        Ok(())
+    }
+
+    pub(in crate::hosted) fn launch_test_world(
+        &self,
+        request: &TestWorldRequest,
+    ) -> Result<Launch, &'static str> {
+        if !matches!(self.page, Page::Home)
+            || self.preferences.instance != request.instance
+            || self.test_world_owner().as_deref() != Some(request.owner.as_str())
+        {
+            return Err(
+                "Return to the same installation and profile before opening the test world.",
+            );
+        }
+        let mut launch = self.launch_game_for_target(&Target::Menu).map_err(|_| {
+            "The installation or selected profile is not ready to open a test world."
+        })?;
+        let root = launch.game.join(ROOT);
+        let (workspace, entry) = match request.action {
+            TestWorldAction::Create(seed) => (
+                reserve_workspace(&root, request)?,
+                WorldLaunch::CreateTest(seed),
+            ),
+            TestWorldAction::Open => (
+                self.reopen_test_world(&root, request)?,
+                WorldLaunch::Existing(FOLDER.to_owned()),
+            ),
+        };
+        launch.game = workspace;
+        launch.world = Some(entry);
+        Ok(launch)
+    }
+
+    pub(super) fn list_test_worlds(&self) -> Result<Value, &'static str> {
+        if self.installed(&self.preferences.instance) != ResourceStatus::Ready {
+            return Err("Select a compatible installation before listing disposable test worlds.");
+        }
+        let owner = self
+            .test_world_owner()
+            .ok_or("The selected profile is unavailable.")?;
+        let instance = self.preferences.instance.as_str();
+        let root = self.game_dir(instance).join(ROOT);
+        let worlds: Vec<_> = entries(&root, true)
+            .into_iter()
+            .filter_map(|id| {
+                let marker = sandbox_marker(&root, &id)?;
+                if marker.instance != instance || marker.owner != owner {
+                    return None;
+                }
+                let available = self.check_test_save(&root.join(&id)).is_ok();
+                Some(json!({"id":id, "available":available}))
+            })
+            .collect();
+        Ok(json!({"instance":instance, "worlds":worlds}))
+    }
+}
