+
+static void check_index_width_boundary(void)
+{
+   const uint32_t vertex_counts[] = {65536, 65540};
+   for (unsigned mode = 0; mode < 2; ++mode) {
+      const uint32_t vertices = vertex_counts[mode];
+      const uint32_t count = vertices / 4 * 6;
+      const uint32_t width = mode == 0 ? 2 : 4;
+      HorizonGx2TerrainSection *section;
+      uint32_t estimated, actual, vertex_bytes;
+      assert(horizon_gx2_terrain_section_estimate(vertices, &vertex_bytes) == 0);
+      assert(horizon_gx2_terrain_section_estimate_sorted(vertices, &estimated) == 0);
+      assert(estimated - vertex_bytes == ((count * width + 63) & ~63u));
+      assert(horizon_gx2_terrain_section_create_sorted(
+         &section, vertices, fill_large, NULL, &actual) == 0);
+      assert(actual == estimated && section->sorted_indices.elemSize == width);
+      uint32_t *indices = malloc(count * sizeof(*indices));
+      assert(indices);
+      for (uint32_t i = 0; i < count; ++i) indices[i] = vertices - 1 - i % vertices;
+      assert(horizon_gx2_terrain_section_update_indices(section, indices, count) == 0);
+      for (uint32_t i = 0; i < count; ++i) {
+         const uint32_t read = mode == 0 ? ((uint16_t *)section->sorted_indices.buffer)[i]
+                                        : ((uint32_t *)section->sorted_indices.buffer)[i];
+         assert(read == indices[i]);
+      }
+      free(indices);
+      draw_count = 0;
+      terrain_draw_sorted(section);
+      assert(draw_count == 1 && draws[0].index_type == (mode == 0 ? GX2_INDEX_TYPE_U16 : GX2_INDEX_TYPE_U32));
+      horizon_gx2_terrain_section_destroy_after_wait(section);
+      assert(!sections && !buffers && !mapped);
+   }
+}
