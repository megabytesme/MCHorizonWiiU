diff --git a/crates/horizon-client-render/src/client_http.rs b/crates/horizon-client-render/src/client_http.rs
new file mode 100644
index 0000000..f1b705d
--- /dev/null
+++ b/crates/horizon-client-render/src/client_http.rs
@@ -0,0 +1,64 @@
+//! HTTP configuration for the desktop and hosted clients.
+use std::io::Read;
+use std::time::Duration;
+
+pub(crate) fn agent_builder() -> ureq::AgentBuilder {
+    let timeout = Duration::from_secs(15);
+    let builder = ureq::AgentBuilder::new();
+    #[cfg(not(target_os = "cafe"))]
+    let builder = builder.timeout(timeout);
+    #[cfg(target_os = "cafe")]
+    // ureq's overall deadline sets a socket send timeout before TLS.
+    // Cafe std supports TCP connect deadlines and emulates receive timeouts.
+    let builder = builder.timeout_connect(timeout).timeout_read(timeout);
+    builder
+}
+
+pub(crate) fn services_agent_builder() -> ureq::AgentBuilder {
+    let builder = agent_builder();
+    #[cfg(target_os = "cafe")]
+    let builder = builder.https_only(true).redirects(0);
+    builder
+}
+
+pub(crate) fn is_success(response: &ureq::Response) -> bool {
+    (200..300).contains(&response.status())
+}
+
+/// Limit JSON responses before allocating memory proportional to their size.
+pub(crate) fn services_body(response: ureq::Response) -> Option<String> {
+    read_services_body(response.into_reader())
+}
+
+fn read_services_body(reader: impl Read) -> Option<String> {
+    const LIMIT: u64 = 1024 * 1024;
+    let mut body = Vec::new();
+    reader.take(LIMIT + 1).read_to_end(&mut body).ok()?;
+    if body.len() as u64 > LIMIT {
+        return None;
+    }
+    String::from_utf8(body).ok()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::Cursor;
+
+    #[test]
+    fn services_json_requires_utf8_and_has_a_hard_size_limit() {
+        let read = |bytes: &[u8]| read_services_body(Cursor::new(bytes));
+        assert_eq!(read(br#"{"ok":true}"#).as_deref(), Some(r#"{"ok":true}"#));
+        assert_eq!(read(&vec![b'a'; 1024 * 1024]).unwrap().len(), 1024 * 1024);
+        assert!(read(&vec![b'a'; 1024 * 1024 + 1]).is_none());
+        assert!(read(&[0xff]).is_none());
+    }
+
+    #[test]
+    fn a_redirect_is_never_a_successful_service_response() {
+        assert!(is_success(
+            &ureq::Response::new(204, "No Content", "").unwrap()
+        ));
+        assert!(!is_success(&ureq::Response::new(302, "Found", "").unwrap()));
+    }
+}
