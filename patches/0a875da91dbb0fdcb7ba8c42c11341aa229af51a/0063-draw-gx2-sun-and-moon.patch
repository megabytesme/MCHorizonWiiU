diff --git a/wiiu/loading_host/sky_bodies.rs b/wiiu/loading_host/sky_bodies.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9918198fe70e4ae17562984436343587f31cd281
--- /dev/null
+++ b/wiiu/loading_host/sky_bodies.rs
@@ -0,0 +1,95 @@
+use crate::TerrainProjection;
+use horizon_client::{gfx::Frame, mesher::Vertex as SharedVertex};
+use horizon_wiiu_platform::hud::horizon::HorizonPresenter;
+use std::{ffi::c_void, ptr::NonNull};
+
+#[path = "sky_bodies_vertices.rs"]
+mod geometry;
+
+unsafe extern "C" {
+    fn horizon_gx2_sky_bodies_create(out: *mut *mut c_void) -> i32;
+    fn horizon_gx2_sky_bodies_destroy(bodies: *mut c_void);
+    fn horizon_gx2_sky_bodies_draw(
+        bodies: *mut c_void,
+        target: u32,
+        rect: *const u32,
+        atlas: *const c_void,
+        vertices: *const geometry::Vertex,
+        count: u32,
+    ) -> i32;
+}
+
+pub(crate) fn stock_bodies(vertices: &[SharedVertex]) -> bool {
+    geometry::valid_shape(vertices.len(), vertices.iter().map(|vertex| vertex.layer))
+}
+
+pub(crate) fn unsupported(frame: &Frame<'_>, has_atlas: bool) -> bool {
+    if frame.title || frame.sky_blocked || frame.celestial.is_empty() {
+        return false;
+    }
+    // The End submits separate flash geometry. Leave its explicit omission
+    // until there is a matching native sky and layered flash pass.
+    frame.end_sky || (frame.skybox && (!has_atlas || !stock_bodies(frame.celestial)))
+}
+
+#[derive(Default)]
+pub(crate) struct SkyBodies(Option<NonNull<c_void>>);
+
+impl SkyBodies {
+    pub(crate) fn draw(
+        &mut self,
+        frame: &Frame<'_>,
+        atlas: &HorizonPresenter<'_>,
+        target: u32,
+        rect: [u32; 4],
+        aspect: f32,
+    ) -> Result<(), &'static str> {
+        let projection = TerrainProjection::new(frame, 0, aspect);
+        let mut vertices = [geometry::Vertex::default(); geometry::MAX_VERTICES];
+        let count = geometry::expand(&mut vertices, frame.celestial.len(), |index| {
+            let vertex = &frame.celestial[index];
+            geometry::Vertex {
+                clip: projection.clip.transform(vertex.pos),
+                uv: vertex.uv,
+                rgba: vertex.color.to_le_bytes(),
+            }
+        });
+        let native = match self.0 {
+            Some(native) => native,
+            None => {
+                let mut native = std::ptr::null_mut();
+                if unsafe { horizon_gx2_sky_bodies_create(&mut native) } != 0 {
+                    return Err("could not create the GX2 celestial pipeline");
+                }
+                let native = NonNull::new(native).ok_or("missing GX2 celestial pipeline")?;
+                self.0 = Some(native);
+                native
+            }
+        };
+        // Each output keeps its own upload storage. WHBGfxFinishRender has
+        // already retired both views from the preceding frame.
+        let result = atlas.with_native_atlas(|texture| unsafe {
+            horizon_gx2_sky_bodies_draw(
+                native.as_ptr(),
+                target,
+                rect.as_ptr(),
+                texture,
+                vertices.as_ptr(),
+                count as u32,
+            )
+        });
+        if result == 0 {
+            Ok(())
+        } else {
+            Err("GX2 celestial draw failed")
+        }
+    }
+}
+
+impl Drop for SkyBodies {
+    fn drop(&mut self) {
+        if let Some(native) = self.0.take() {
+            unsafe { horizon_gx2_sky_bodies_destroy(native.as_ptr()) };
+        }
+    }
+}
