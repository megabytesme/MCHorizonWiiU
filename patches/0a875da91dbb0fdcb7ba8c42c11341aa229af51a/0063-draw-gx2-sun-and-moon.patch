+                           const uint32_t counts[3], const float fog[4], float sky_end,
+                           const float top[4], const float sunrise[4], bool include_dark)
+{
+   if (!valid_target(sky, target, rect, counts, fog) || !vertices || !top || !sunrise)
+      return -1;
+   GX2RBuffer *buffer = &sky->vertices[target];
+   void *mapped = GX2RLockBufferEx(buffer, 0);
+   if (!mapped) return -2;
