diff --git a/wiiu/loading_host/sky_bodies.c b/wiiu/loading_host/sky_bodies.c
new file mode 100644
index 0000000000000000000000000000000000000000..4d62e62e83e8c336d7933a9084ed92a9e7e3c0c2
--- /dev/null
+++ b/wiiu/loading_host/sky_bodies.c
@@ -0,0 +1,127 @@
+#include "sky_bodies.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <gx2/draw.h>
+#include <gx2/event.h>
+#include <gx2/registers.h>
+#include <gx2/sampler.h>
+#include <gx2/shaders.h>
+#include <gx2/texture.h>
+#include <gx2/utils.h>
+#include <gx2r/buffer.h>
+#include <gx2r/draw.h>
+#include <whb/gfx.h>
+
+extern const uint8_t _binary_sky_bodies_gsh_start[];
+
+enum { MAX_VERTICES = 2 * 6 };
+
+_Static_assert(sizeof(HorizonSkyBodyVertex) == 28, "sky body vertex ABI changed");
+_Static_assert(offsetof(HorizonSkyBodyVertex, uv) == 16, "sky body UV offset changed");
+_Static_assert(offsetof(HorizonSkyBodyVertex, rgba) == 24, "sky body color offset changed");
+
+struct HorizonGx2SkyBodies {
+   WHBGfxShaderGroup shader;
+   GX2RBuffer vertices[2];
+   GX2Sampler sampler;
+   uint32_t atlas_slot;
+};
+
+static void release(HorizonGx2SkyBodies *bodies)
+{
+   for (unsigned i = 0; i < 2; ++i)
+      if (GX2RBufferExists(&bodies->vertices[i])) GX2RDestroyBufferEx(&bodies->vertices[i], 0);
+   if (bodies->shader.vertexShader) WHBGfxFreeShaderGroup(&bodies->shader);
+   free(bodies);
+}
+
+int horizon_gx2_sky_bodies_create(HorizonGx2SkyBodies **out)
+{
+   if (!out) return -1;
+   *out = NULL;
+   HorizonGx2SkyBodies *bodies = calloc(1, sizeof(*bodies));
+   if (!bodies) return -2;
+   WHBGfxShaderGroup *shader = &bodies->shader;
+   if (!WHBGfxLoadGFDShaderGroup(shader, 0, _binary_sky_bodies_gsh_start) ||
+       !shader->vertexShader || !shader->pixelShader ||
+       shader->vertexShader->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       shader->pixelShader->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       !WHBGfxInitShaderAttribute(shader, "aClip", 0, offsetof(HorizonSkyBodyVertex, clip),
+                                  GX2_ATTRIB_FORMAT_FLOAT_32_32_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aUv", 0, offsetof(HorizonSkyBodyVertex, uv),
+                                  GX2_ATTRIB_FORMAT_FLOAT_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aColor", 0, offsetof(HorizonSkyBodyVertex, rgba),
+                                  GX2_ATTRIB_FORMAT_UNORM_8_8_8_8) ||
+       !WHBGfxInitFetchShader(shader)) {
+      release(bodies);
+      return -3;
+   }
+   const GX2PixelShader *ps = shader->pixelShader;
+   const GX2SamplerVar *sampler = ps->samplerVars;
+   if (ps->samplerVarCount != 1 || !sampler || !sampler->name ||
+       strcmp(sampler->name, "uAtlas") || sampler->type != GX2_SAMPLER_VAR_TYPE_SAMPLER_2D) {
+      release(bodies);
+      return -3;
+   }
+   bodies->atlas_slot = sampler->location;
+   GX2InitSampler(&bodies->sampler, GX2_TEX_CLAMP_MODE_CLAMP, GX2_TEX_XY_FILTER_MODE_POINT);
+   const GX2RResourceFlags flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER |
+      GX2R_RESOURCE_USAGE_CPU_WRITE | GX2R_RESOURCE_USAGE_GPU_READ;
+   for (unsigned i = 0; i < 2; ++i) {
+      GX2RBuffer *buffer = &bodies->vertices[i];
+      *buffer = (GX2RBuffer){
+         .flags = flags, .elemSize = sizeof(HorizonSkyBodyVertex), .elemCount = MAX_VERTICES,
+      };
+      if (!GX2RCreateBuffer(buffer)) {
+         release(bodies);
+         return -2;
+      }
+   }
+   *out = bodies;
+   return 0;
+}
+
+void horizon_gx2_sky_bodies_destroy(HorizonGx2SkyBodies *bodies)
+{
+   if (!bodies) return;
+   GX2DrawDone();
+   release(bodies);
+}
+
+int horizon_gx2_sky_bodies_draw(HorizonGx2SkyBodies *bodies, uint32_t target, const uint32_t rect[4],
+                                const GX2Texture *atlas, const HorizonSkyBodyVertex *vertices,
+                                uint32_t count)
+{
+   if (!bodies || target > 1 || !rect || !rect[2] || !rect[3] || !atlas ||
+       !atlas->surface.image || !vertices || !count || count % 6 || count > MAX_VERTICES) return -1;
+   GX2RBuffer *buffer = &bodies->vertices[target];
+   void *mapped = GX2RLockBufferEx(buffer, 0);
+   if (!mapped) return -2;
+   memcpy(mapped, vertices, count * sizeof(*vertices));
+   GX2RUnlockBufferEx(buffer, 0);
+
+   WHBGfxShaderGroup *shader = &bodies->shader;
+   GX2SetViewport(rect[0], rect[1], rect[2], rect[3], 0, 1);
+   GX2SetScissor(rect[0], rect[1], rect[2], rect[3]);
+   GX2SetShaderMode(shader->vertexShader->mode);
+   GX2SetFetchShader(&shader->fetchShader);
+   GX2SetVertexShader(shader->vertexShader);
+   GX2SetPixelShader(shader->pixelShader);
+   GX2SetPixelTexture(atlas, bodies->atlas_slot);
+   GX2SetPixelSampler(&bodies->sampler, bodies->atlas_slot);
+   GX2RSetAttributeBuffer(buffer, 0, sizeof(HorizonSkyBodyVertex), 0);
+   GX2SetCullOnlyControl(GX2_FRONT_FACE_CCW, FALSE, FALSE);
+   GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+   GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0.0f);
+   GX2SetDepthOnlyControl(FALSE, FALSE, GX2_COMPARE_FUNC_ALWAYS);
+   GX2SetColorControl(GX2_LOGIC_OP_COPY, 1, FALSE, TRUE);
+   GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, 0, 0, 0, 0, 0, 0, 0);
+   GX2SetBlendControl(GX2_RENDER_TARGET_0, GX2_BLEND_MODE_ONE, GX2_BLEND_MODE_ONE,
+                      GX2_BLEND_COMBINE_MODE_ADD, TRUE, GX2_BLEND_MODE_ZERO,
+                      GX2_BLEND_MODE_ONE, GX2_BLEND_COMBINE_MODE_ADD);
+   GX2DrawEx(GX2_PRIMITIVE_MODE_TRIANGLES, count, 0, 1);
+   return 0;
+}
