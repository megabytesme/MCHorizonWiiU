+/// Prepared rows and registry rows have separate producers. Use the
+/// registry's owned maps only after checking the complete ordered input.
+/// Any other JSON shape keeps the original decoding and error order.
+fn prepared_states_match(raw: &Value, native: &[(BlockStateId, &BlockProperties)]) -> bool {
+    raw.as_array().is_some_and(|raw| {
+        raw.len() == native.len()
+            && raw.iter().zip(native).all(|(raw, (_, props))| {
+                raw.as_object().is_some_and(|row| {
+                    row.len() == props.len()
+                        && props.iter().all(|(key, value)| {
+                            row.get(key).and_then(Value::as_str) == Some(value.as_str())
+                        })
+                })
+            })
+    })
+}
