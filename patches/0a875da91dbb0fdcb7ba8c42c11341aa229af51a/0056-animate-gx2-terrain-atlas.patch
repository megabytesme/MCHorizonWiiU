+int horizon_gx2_terrain_patch_atlas(HorizonGx2Terrain *t, HorizonTerrainFillTexture fill,
+                                    void *context, const uint32_t (*rects)[4], size_t count)
+{
+   if (!t || !fill || (count && !rects)) return -1;
+   if (!count) return 0;
+   const GX2Surface *s = &t->texture.surface;
+   if (!t->atlas_storage || s->image != t->atlas_storage ||
+       s->tileMode != GX2_TILE_MODE_LINEAR_ALIGNED || s->pitch < s->width ||
+       (size_t)s->pitch * s->height * 4 > s->imageSize) return -1;
+   for (size_t i = 0; i < count; ++i) {
+      const uint32_t *rect = rects[i];
+      if (!rect[2] || !rect[3] || rect[0] >= s->width || rect[1] >= s->height ||
+          rect[2] > s->width - rect[0] || rect[3] > s->height - rect[1]) return -1;
+   }
+
+   int result = fill(context, t->atlas_storage, s->pitch);
+   // Flush only cache lines touched by these cells. A barrier makes all
+   // stores visible before issuing the texture-cache invalidation.
+   const uintptr_t cache_mask = 31;
+   for (size_t i = 0; i < count; ++i) {
+      const uint32_t *rect = rects[i];
+      for (uint32_t y = rect[1]; y < rect[1] + rect[3]; ++y) {
+         const uintptr_t start = (uintptr_t)t->atlas_storage +
+            ((size_t)y * s->pitch + rect[0]) * 4;
+         const uintptr_t aligned_start = start & ~cache_mask;
+         const uintptr_t aligned_end = (start + rect[2] * 4 + cache_mask) & ~cache_mask;
+         DCStoreRangeNoSync((void *)aligned_start, (uint32_t)(aligned_end - aligned_start));
+      }
+   }
+   OSMemoryBarrier();
+   GX2Invalidate(GX2_INVALIDATE_MODE_TEXTURE, t->atlas_storage, s->imageSize);
+   return result;
+}
