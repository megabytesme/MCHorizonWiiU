index 0000000000000000000000000000000000000000..1d8026cefe87f9a70b9e9590dfd13873c842d1c9
--- /dev/null
+++ b/wiiu/loading_host/terrain_animation.rs
@@ -0,0 +1,164 @@
+//! Update padded terrain cells in place using Horizon's decoded animation clips.
+
+use horizon_client::sprites::{FrameBlend, SpriteAnimation};
+use horizon_client_platform::cafe_profile::{Span, Stage};
+use horizon_wiiu_gx2_terrain::TerrainAtlasLayout;
+use std::{ffi::c_void, ptr::NonNull};
+
+const ATLAS_BYTES_PER_UPDATE: usize = 1024 * 1024;
+
+unsafe extern "C" {
+    fn horizon_gx2_terrain_patch_atlas(
+        terrain: *mut c_void,
+        fill: unsafe extern "C" fn(*mut c_void, *mut u8, u32) -> i32,
+        context: *mut c_void,
+        rects: *const [u32; 4],
+        count: usize,
+    ) -> i32;
+}
+
+#[derive(Clone, Copy)]
+struct Job {
+    animation: usize,
+    blend: FrameBlend,
+}
+
+#[derive(Default)]
+pub(super) struct TerrainAnimation {
+    shown: Vec<Option<FrameBlend>>,
+    settled_tick: Option<u64>,
+    cursor: usize,
+    jobs: Vec<Job>,
+    rects: Vec<[u32; 4]>,
+    current: Vec<u8>,
+    next: Vec<u8>,
+}
+
+impl TerrainAnimation {
+    pub(super) fn reset(&mut self) {
+        self.shown.clear();
+        self.settled_tick = None;
+        self.cursor = 0;
+    }
+
+    pub(super) fn update(
+        &mut self,
+        terrain: NonNull<c_void>,
+        layout: &TerrainAtlasLayout,
+        animations: &[SpriteAnimation],
+        tick: u64,
+    ) -> horizon_client::Result<()> {
+        if animations.is_empty() || self.settled_tick == Some(tick) {
+            return Ok(());
+        }
+        self.shown.resize(animations.len(), None);
+        self.jobs.clear();
+        self.rects.clear();
+        let cell_bytes = (layout.cell_size as usize).pow(2) * 4;
+        let limit = (ATLAS_BYTES_PER_UPDATE / cell_bytes).max(1);
+        let mut remaining = animations.len();
+        let mut cursor = self.cursor % animations.len();
+        while remaining > 0 && self.jobs.len() < limit {
+            let animation = &animations[cursor];
+            let blend = animation.blend(tick);
+            if self.shown[cursor] != Some(blend) {
+                self.rects.push(layout.layer_rect(animation.layer)?);
+                self.jobs.push(Job {
+                    animation: cursor,
+                    blend,
+                });
+            }
+            cursor = (cursor + 1) % animations.len();
+            remaining -= 1;
+        }
+        if !self.jobs.is_empty() {
+            let _upload = Span::new(Stage::TextureUpload);
+            let mut update = AtlasPatch {
+                layout,
+                animations,
+                jobs: &self.jobs,
+                current: &mut self.current,
+                next: &mut self.next,
+                error: None,
+            };
+            // The previous WHB FinishRender retired both outputs' atlas reads.
+            // Only the padded cells supplied in rects change during this callback.
+            let result = unsafe {
+                horizon_gx2_terrain_patch_atlas(
+                    terrain.as_ptr(),
+                    write_atlas_patch,
+                    std::ptr::from_mut(&mut update).cast(),
+                    self.rects.as_ptr(),
+                    self.rects.len(),
+                )
+            };
+            if result != 0 {
+                return Err(update
+                    .error
+                    .unwrap_or("GX2 animated terrain upload failed")
+                    .into());
+            }
+            for job in &self.jobs {
+                self.shown[job.animation] = Some(job.blend);
+            }
+        }
+        self.cursor = cursor;
+        if remaining == 0 {
+            self.settled_tick = Some(tick);
+        }
+        Ok(())
+    }
+}
+
+struct AtlasPatch<'a> {
+    layout: &'a TerrainAtlasLayout,
+    animations: &'a [SpriteAnimation],
+    jobs: &'a [Job],
+    current: &'a mut Vec<u8>,
+    next: &'a mut Vec<u8>,
+    error: Option<&'static str>,
+}
+
+unsafe extern "C" fn write_atlas_patch(context: *mut c_void, pixels: *mut u8, pitch: u32) -> i32 {
+    let patch = unsafe { &mut *context.cast::<AtlasPatch<'_>>() };
+    let pitch = pitch as usize * 4;
+    // C validated the backing and ensured the linear surface covers these rows.
+    let pixels =
+        unsafe { std::slice::from_raw_parts_mut(pixels, pitch * patch.layout.height as usize) };
+    for job in patch.jobs {
+        let animation = &patch.animations[job.animation];
+        let side = patch.layout.sprite_size;
+        animation.write_frame_at(job.blend.frame, side, patch.current);
+        if job.blend.millis != 0 {
+            animation.write_frame_at(job.blend.next, side, patch.next);
+            interpolate(patch.current, patch.next, job.blend.millis);
+        }
+        if let Err(error) = patch
+            .layout
+            .write_layer(animation.layer, patch.current, pixels, pitch)
+        {
+            patch.error = Some(error);
+            return -1;
+        }
+    }
+    0
+}
+
+/// The same thousandth-step RGBA interpolation as the shared terrain animator.
+fn interpolate(current: &mut [u8], next: &[u8], millis: u32) {
+    for (a, &b) in current.iter_mut().zip(next) {
+        *a = ((u32::from(*a) * (1000 - millis) + u32::from(b) * millis + 500) / 1000) as u8;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::interpolate;
+
+    #[test]
+    fn animation_mix_rounds_every_rgba_channel() {
+        let mut a = [255, 0, 31, 64];
+        interpolate(&mut a, &[0, 255, 32, 191], 500);
+        assert_eq!(a, [128, 128, 32, 128]);
+    }
+}
