diff --git a/crates/horizon-client/src/platform/cafe_frame_laps.rs b/crates/horizon-client/src/platform/cafe_frame_laps.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cbc203ff049554a6320df8dfef5e20838df31ef9
--- /dev/null
+++ b/crates/horizon-client/src/platform/cafe_frame_laps.rs
@@ -0,0 +1,87 @@
+use horizon_client::spans::{self, Span};
+
+const PREPARE_LAPS: [[&str; 6]; 4] = [
+    [
+        "prepare",
+        "renderer",
+        "pr_cleanup",
+        "pr_setup",
+        "pr_camera",
+        "pr_listener",
+    ],
+    [
+        "pr_occlusion",
+        "pr_environment",
+        "pr_debug",
+        "pr_native_visuals",
+        "pr_outline",
+        "pr_projection",
+    ],
+    [
+        "pr_hud",
+        "pr_entity_setup",
+        "pr_entities",
+        "pr_dragon_bolts",
+        "pr_celestial",
+        "pr_hand",
+    ],
+    [
+        "pr_screen_end",
+        "pr_weather_border",
+        "pr_lights",
+        "pr_shader_inputs",
+        "pr_frame",
+        "pr_loading",
+    ],
+];
+
+pub(super) struct FrameLaps {
+    sequence: u32,
+    start_ticks: u64,
+    enabled_here: bool,
+}
+
+impl FrameLaps {
+    pub(super) fn start((sequence, start_ticks): (u32, u64)) -> Self {
+        // Keep other local recordings enabled and let the existing redraw
+        // consumer continue to drain their spans.
+        let enabled_here = !spans::recording_here();
+        if enabled_here {
+            spans::record_here(true);
+        }
+        Self {
+            sequence,
+            start_ticks,
+            enabled_here,
+        }
+    }
+
+    pub(super) fn finish(self, spans: &[Span], rendered: bool) {
+        if !rendered {
+            return;
+        }
+        for (group, names) in PREPARE_LAPS.iter().enumerate() {
+            let wall_us = names.map(|name| {
+                spans
+                    .iter()
+                    .find(|span| span.name == name)
+                    .map_or(u32::MAX, |span| (span.ms * 1_000.0).round() as u32)
+            });
+            log::info!(
+                "Horizon Cafe frame wall us seq={} start_ticks={} group={group} samples={wall_us:?}",
+                self.sequence, self.start_ticks
+            );
+        }
+    }
+}
+
+impl Drop for FrameLaps {
+    fn drop(&mut self) {
+        if self.enabled_here {
+            spans::record_here(false);
+            // Redraw normally consumed these already. Clean up partial
+            // spans if rendering or a callback returned early.
+            drop(spans::take_raw());
+        }
+    }
+}
