+    /// Expand a smaller square texture straight into its padded native cell.
+    pub fn write_upsampled_layer(
+        &self,
+        layer: u32,
+        source: &[u8],
+        source_side: u32,
+        pixels: &mut [u8],
+        pitch: usize,
+    ) -> Result<(), &'static str> {
+        let side = self.sprite_size;
+        if !source_side.is_power_of_two() || !side.is_power_of_two() || source_side >= side {
+            return Err("invalid GX2 atlas layer expansion");
+        }
+        let source_side = source_side as usize;
+        let source_bytes = source_side
+            .checked_pow(2)
+            .and_then(|texels| texels.checked_mul(4));
+        if source_bytes != Some(source.len()) {
+            return Err("Horizon sprite layer mismatch");
+        }
+        if pitch < self.width as usize * 4
+            || pitch.checked_mul(self.height as usize) != Some(pixels.len())
+        {
+            return Err("invalid writable GX2 atlas storage");
+        }
+        let [cx, cy, cell_size, _] = self.layer_rect(layer)?;
+        let factor = side as usize / source_side;
+        let start = cx as usize * 4;
+        let end = start + cell_size as usize * 4;
+        let mut rows = pixels
+            .chunks_exact_mut(pitch)
+            .skip(cy as usize)
+            .take(cell_size as usize)
+            .map(|row| &mut row[start..end]);
+        for (index, source_row) in source.chunks_exact(source_side * 4).enumerate() {
+            let first = rows.next().unwrap();
+            let (left, rest) = first.split_at_mut(4);
+            let (interior, right) = rest.split_at_mut(side as usize * 4);
+            left.copy_from_slice(&source_row[..4]);
+            right.copy_from_slice(&source_row[source_row.len() - 4..]);
+            for (run, &pixel) in interior
+                .as_chunks_mut::<4>()
+                .0
+                .chunks_exact_mut(factor)
+                .zip(source_row.as_chunks::<4>().0)
+            {
+                run.fill(pixel);
+            }
+            let copies =
+                factor - 1 + usize::from(index == 0) + usize::from(index + 1 == source_side);
+            for row in rows.by_ref().take(copies) {
+                row.copy_from_slice(first);
+            }
+        }
+        Ok(())
+    }
