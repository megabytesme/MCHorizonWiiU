+    fn upsampled_layer_repeats_rgba_texels_and_preserves_other_cells() {
+        for (source_side, side) in [(1, 2), (2, 8), (16, 64), (32, 64)] {
+            let layout = TerrainAtlasLayout::for_layers(side, 13).unwrap();
+            let pitch = layout.width as usize * 4 + 32;
+            let mut pixels = alloc::vec![0xbd; pitch * layout.height as usize];
+            let mut expected = pixels.clone();
+            let source: Vec<_> = (0..source_side * source_side * 4)
+                .map(|index| (index * 37 + index / 7 * 17) as u8)
+                .collect();
+
+            for layer in [0, 6, 12] {
+                let [x, y, width, height] = layout.layer_rect(layer).unwrap();
+                for dy in 0..height {
+                    for dx in 0..width {
+                        let sx = (dx.clamp(1, side) - 1) * source_side / side;
+                        let sy = (dy.clamp(1, side) - 1) * source_side / side;
+                        let offset = ((sy * source_side + sx) * 4) as usize;
+                        let dest = (y + dy) as usize * pitch + ((x + dx) * 4) as usize;
+                        expected[dest..dest + 4].copy_from_slice(&source[offset..offset + 4]);
+                    }
+                }
+                layout
+                    .write_upsampled_layer(layer, &source, source_side, &mut pixels, pitch)
+                    .unwrap();
+            }
+            assert_eq!(pixels, expected, "{source_side}px to {side}px");
+        }
+    }
