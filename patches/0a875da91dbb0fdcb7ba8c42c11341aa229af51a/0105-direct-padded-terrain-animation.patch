+    /// Read a smaller square power-of-two animation frame for a native atlas
+    /// that can expand and pad it in one write. Keep interpolation on source
+    /// pixels so all nearest-neighbour copies have identical channel rounding.
+    pub fn blend_smaller_square<'a>(
+        &'a self,
+        blend: FrameBlend,
+        side: u32,
+        scratch: &'a mut Vec<u8>,
+    ) -> Option<(u32, &'a [u8])> {
+        let source = self.pixels(blend.frame);
+        let [w, h] = self.frame_dimensions(source);
+        if w != h || w >= side || !w.is_power_of_two() || !side.is_power_of_two() {
+            return None;
+        }
+        if blend.millis == 0 {
+            return Some((w, source));
+        }
+        scratch.resize(source.len(), 0);
+        mix_pixels(scratch, source, self.pixels(blend.next), blend.millis);
+        Some((w, scratch))
+    }
