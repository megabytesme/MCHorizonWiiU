+    #[test]
+    fn layer_updates_match_clamped_texels_and_leave_other_cells_untouched() {
+        for (side, padding) in [(1, 0), (3, 4), (16, 12), (64, 144)] {
+            let layout = TerrainAtlasLayout::for_layers(side, 13).unwrap();
+            let pitch = layout.width as usize * 4 + padding;
+            let mut pixels = alloc::vec![0xbd; pitch * layout.height as usize];
+            let mut expected = pixels.clone();
+            let layer_bytes = layout.layer_bytes().unwrap();
+            let source: Vec<_> = (0..layer_bytes)
+                .map(|index| (index * 37 + index / 7 * 17) as u8)
+                .collect();
+
+            for layer in [0, 6, 12] {
+                let x = ((layer % layout.columns) * (side + 2)) as usize;
+                let y = ((layer / layout.columns) * (side + 2)) as usize;
+                let side = side as usize;
+                for dy in 0..side + 2 {
+                    for dx in 0..side + 2 {
+                        let sx = dx.clamp(1, side) - 1;
+                        let sy = dy.clamp(1, side) - 1;
+                        let source_offset = (sy * side + sx) * 4;
+                        let target_offset = (y + dy) * pitch + (x + dx) * 4;
+                        expected[target_offset..target_offset + 4]
+                            .copy_from_slice(&source[source_offset..source_offset + 4]);
+                    }
+                }
+                layout.write_layer(layer, &source, &mut pixels, pitch).unwrap();
+                assert_eq!(pixels, expected, "side={side}, pitch={pitch}, layer={layer}");
+            }
+
+            assert!(layout.write_layer(13, &source, &mut pixels, pitch).is_err());
+            assert!(layout.write_layer(0, &source[..layer_bytes - 1], &mut pixels, pitch).is_err());
+            assert!(layout.write_layer(0, &source, &mut pixels, pitch - 1).is_err());
+            assert_eq!(pixels, expected);
+        }
+    }
