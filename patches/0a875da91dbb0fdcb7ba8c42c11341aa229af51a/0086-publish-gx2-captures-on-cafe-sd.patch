+static bool flush_capture_volume(void)
+{
+   const FSAClientHandle client = FSAAddClient(NULL);
+   if (client < 0) {
+      OSReport("Horizon GX2 capture volume client failed: status=%d\n", client);
+      return false;
+   }
+   const int flushed = FSAFlushVolume(client, PROFILE_VOLUME);
+   const int closed = FSADelClient(client);
+   if (flushed || closed) {
+      OSReport("Horizon GX2 capture volume flush failed: status=%d close=%d\n", flushed, closed);
+      return false;
+   }
+   return true;
+}
+
+static bool publish_capture(const char *path, const char *temporary)
+{
+   struct stat info;
+   bool live = stat(path, &info) == 0;
+   if (!live && errno != ENOENT) {
+      OSReport("Horizon GX2 capture target stat failed: errno=%d path=%s\n", errno, path);
+      return false;
+   }
+   if (live && !S_ISREG(info.st_mode)) {
+      OSReport("Horizon GX2 capture target is not a file: path=%s\n", path);
+      return false;
+   }
+   char previous[sizeof(ROOT) + 48];
+   const int length = snprintf(previous, sizeof(previous), "%s.previous", path);
+   if (length < 0 || (size_t)length >= sizeof(previous)) return false;
+
+   // Cafe rename requires a vacant destination. Keep the previous complete
+   // capture until the new capture is durable, including across a failed move.
+   if (live) {
+      if ((unlink(previous) != 0 && errno != ENOENT) || rename(path, previous) != 0) {
+         OSReport("Horizon GX2 capture backup failed: errno=%d path=%s\n", errno, path);
+         return false;
+      }
+      if (!flush_capture_volume()) {
+         if (rename(previous, path) != 0)
+            OSReport("Horizon GX2 capture restore failed: errno=%d path=%s\n", errno, previous);
+         return false;
+      }
+   }
+   if (rename(temporary, path) != 0) {
+      OSReport("Horizon GX2 capture publish failed: errno=%d path=%s\n", errno, path);
+      if (live && rename(previous, path) != 0)
+         OSReport("Horizon GX2 capture restore failed: errno=%d path=%s\n", errno, previous);
+      return false;
+   }
+   return flush_capture_volume();
+}
