diff --git a/crates/horizon-client/src/platform/cafe_terrain_admission.rs b/crates/horizon-client/src/platform/cafe_terrain_admission.rs
new file mode 100644
index 0000000..1b03557
--- /dev/null
+++ b/crates/horizon-client/src/platform/cafe_terrain_admission.rs
@@ -0,0 +1,166 @@
+//! Fixed-size upload accounting for the profiled Village route.
+
+use std::fmt;
+
+#[derive(Clone, Copy)]
+pub enum CafeTerrainUpload {
+    Published,
+    Empty,
+    OverBudget,
+    RankRefused,
+    Backoff,
+    HeapRefused,
+    AllocationDeferred,
+    Invalid,
+}
+
+#[derive(Default)]
+pub struct CafeTerrainAdmission {
+    outcomes: [u32; 8],
+    victim_bytes: u64,
+    victim_without_commit_bytes: u64,
+    released_accounted_bytes: u64,
+    retry_issued: u32,
+    retry_heap_refused: u32,
+    // Current occupancy at the edge of a trace window, rather than a sum.
+    occupied: [usize; 3],
+}
+
+impl CafeTerrainAdmission {
+    pub fn upload(&mut self, outcome: CafeTerrainUpload, victim_bytes: usize) {
+        let count = &mut self.outcomes[outcome as usize];
+        *count = count.saturating_add(1);
+        let victim_bytes = victim_bytes as u64;
+        self.victim_bytes = self.victim_bytes.saturating_add(victim_bytes);
+        if !matches!(outcome, CafeTerrainUpload::Published) {
+            self.victim_without_commit_bytes = self
+                .victim_without_commit_bytes
+                .saturating_add(victim_bytes);
+        }
+    }
+
+    pub fn released(&mut self, accounted_bytes: usize) {
+        self.released_accounted_bytes = self
+            .released_accounted_bytes
+            .saturating_add(accounted_bytes as u64);
+    }
+
+    pub fn retry(&mut self, issued: bool) {
+        let count = if issued {
+            &mut self.retry_issued
+        } else {
+            &mut self.retry_heap_refused
+        };
+        *count = count.saturating_add(1);
+    }
+
+    pub fn set_occupancy(&mut self, resident: usize, retired: usize, deferred: usize) {
+        self.occupied = [resident, retired, deferred];
+    }
+
+    pub fn merge(&mut self, frame: Self) {
+        for (count, observed) in self.outcomes.iter_mut().zip(frame.outcomes) {
+            *count = count.saturating_add(observed);
+        }
+        self.victim_bytes = self.victim_bytes.saturating_add(frame.victim_bytes);
+        self.victim_without_commit_bytes = self
+            .victim_without_commit_bytes
+            .saturating_add(frame.victim_without_commit_bytes);
+        self.released_accounted_bytes = self
+            .released_accounted_bytes
+            .saturating_add(frame.released_accounted_bytes);
+        self.retry_issued = self.retry_issued.saturating_add(frame.retry_issued);
+        self.retry_heap_refused = self
+            .retry_heap_refused
+            .saturating_add(frame.retry_heap_refused);
+        self.occupied = frame.occupied;
+    }
+}
+
+impl fmt::Display for CafeTerrainAdmission {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let [
+            published,
+            empty,
+            over_budget,
+            rank_refused,
+            backoff,
+            heap_refused,
+            allocation_deferred,
+            invalid,
+        ] = self.outcomes;
+        let attempts: u64 = self.outcomes.iter().copied().map(u64::from).sum();
+        let [resident, retired, deferred] = self.occupied;
+        write!(
+            f,
+            "attempts={attempts} published={published} empty={empty} over_budget={over_budget} rank_refused={rank_refused} backoff={backoff} heap_refused={heap_refused} allocation_deferred={allocation_deferred} invalid={invalid} victim_bytes={} victim_without_commit_bytes={} released_accounted_bytes={} retry_issued={} retry_heap_refused={} resident_bytes={resident} retired_bytes={retired} deferred={deferred}",
+            self.victim_bytes,
+            self.victim_without_commit_bytes,
+            self.released_accounted_bytes,
+            self.retry_issued,
+            self.retry_heap_refused,
+        )
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn combines_attempt_dispositions_and_keeps_latest_occupancy() {
+        use CafeTerrainUpload::*;
+        let mut window = CafeTerrainAdmission::default();
+        window.upload(Published, 30);
+        window.upload(Empty, 0);
+        window.upload(HeapRefused, 70);
+        window.released(160);
+        window.retry(true);
+        window.set_occupancy(100, 30, 80);
+
+        let mut next = CafeTerrainAdmission::default();
+        next.upload(AllocationDeferred, 100);
+        next.upload(Invalid, 10);
+        next.upload(RankRefused, 0);
+        next.upload(Backoff, 0);
+        next.upload(OverBudget, 0);
+        next.released(40);
+        next.retry(false);
+        next.set_occupancy(120, 0, 75);
+        window.merge(next);
+
+        assert_eq!(
+            window.to_string(),
+            "attempts=8 published=1 empty=1 over_budget=1 rank_refused=1 backoff=1 heap_refused=1 allocation_deferred=1 invalid=1 victim_bytes=210 victim_without_commit_bytes=180 released_accounted_bytes=200 retry_issued=1 retry_heap_refused=1 resident_bytes=120 retired_bytes=0 deferred=75",
+        );
+    }
+
+    #[test]
+    fn counters_saturate_without_wrap() {
+        let mut full = CafeTerrainAdmission {
+            outcomes: [u32::MAX; 8],
+            victim_bytes: u64::MAX,
+            victim_without_commit_bytes: u64::MAX,
+            released_accounted_bytes: u64::MAX,
+            retry_issued: u32::MAX,
+            retry_heap_refused: u32::MAX,
+            ..Default::default()
+        };
+        let mut next = CafeTerrainAdmission::default();
+        next.upload(CafeTerrainUpload::HeapRefused, 128);
+        next.released(256);
+        next.retry(true);
+        next.retry(false);
+        full.merge(next);
+        full.upload(CafeTerrainUpload::HeapRefused, 1);
+        full.retry(false);
+        full.released(1);
+        assert_eq!(full.outcomes, [u32::MAX; 8]);
+        assert_eq!(full.victim_bytes, u64::MAX);
+        assert_eq!(full.victim_without_commit_bytes, u64::MAX);
+        assert_eq!(full.released_accounted_bytes, u64::MAX);
+        assert_eq!(full.retry_issued, u32::MAX);
+        assert_eq!(full.retry_heap_refused, u32::MAX);
+        assert!(full.to_string().starts_with("attempts=34359738360 "));
+    }
+}
