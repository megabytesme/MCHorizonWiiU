+//! Own the first optional Cafe UI publication until the core generation wins.
+
+pub(super) enum FirstUiPublication<T> {
+    Ordinary,
+    Deferred(Option<T>),
+    Abandoned,
+}
+
+impl<T> FirstUiPublication<T> {
+    pub(super) fn new(defer: bool) -> Self {
+        if defer {
+            Self::Deferred(None)
+        } else {
+            Self::Ordinary
+        }
+    }
+
+    /// A later bundle can replace a provisional one after pack rollback.
+    pub(super) fn receive(&mut self, ui: T) -> Option<T> {
+        match self {
+            Self::Ordinary => Some(ui),
+            Self::Deferred(pending) => {
+                *pending = Some(ui);
+                None
+            }
+            Self::Abandoned => None,
+        }
+    }
+
+    pub(super) fn blocks_frontend(&self) -> bool {
+        !matches!(self, Self::Ordinary)
+    }
+
+    /// Complete a single attempt, including publication, while still gated.
+    /// The callback can publish the regular bundle if preparation declines.
+    pub(super) fn finish_if_ready<R>(
+        &mut self,
+        ready: bool,
+        publish: impl FnOnce(Option<T>) -> R,
+    ) -> Option<R> {
+        if !ready {
+            return None;
+        }
+        let Self::Deferred(pending) = self else {
+            return None;
+        };
+        let result = publish(pending.take());
+        *self = Self::Ordinary;
+        Some(result)
+    }
+
+    pub(super) fn abandon(&mut self) {
+        if let Self::Deferred(_) = self {
+            *self = Self::Abandoned;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::FirstUiPublication;
+    use std::{cell::Cell, rc::Rc};
+
+    #[derive(Debug, PartialEq, Eq)]
+    struct Ui {
+        generation: u32,
+        font: &'static str,
+    }
+
+    struct Fixture {
+        pending: FirstUiPublication<Ui>,
+        ui: Option<Ui>,
+        preparations: u32,
+    }
+
+    impl Fixture {
+        fn new(opt_in: bool) -> Self {
+            Self {
+                pending: FirstUiPublication::new(opt_in),
+                ui: None,
+                preparations: 0,
+            }
+        }
+
+        fn receive(&mut self, generation: u32) {
+            if let Some(ui) = self.pending.receive(Ui {
+                generation,
+                font: "existing",
+            }) {
+                self.ui = Some(ui);
+            }
+        }
+
+        fn draw(&mut self, core_ready: bool, prepare_succeeds: bool) -> &'static str {
+            self.pending.finish_if_ready(core_ready, |ui| {
+                if let Some(mut ui) = ui {
+                    self.preparations += 1;
+                    if prepare_succeeds {
+                        ui.font = "mapped";
+                    }
+                    self.ui = Some(ui);
+                }
+            });
+            self.ui.as_ref().map_or("boot", |ui| ui.font)
+        }
+
+        fn cancel_probe(&mut self) {
+            self.pending.finish_if_ready(true, |ui| self.ui = ui);
+        }
+
+        fn input_generation(&self) -> Option<u32> {
+            if self.pending.blocks_frontend() {
+                return None;
+            }
+            self.ui.as_ref().map(|ui| ui.generation)
+        }
+
+        fn handoff(&mut self, core_ready: bool) -> Option<Ui> {
+            if !core_ready || self.pending.blocks_frontend() {
+                return None;
+            }
+            self.ui.take()
+        }
+    }
+
+    #[test]
+    fn ordinary_host_publishes_immediately_and_never_attempts_preparation() {
+        let mut host = Fixture::new(false);
+        host.receive(1);
+        assert_eq!(host.input_generation(), Some(1));
+        assert_eq!(host.draw(false, true), "existing");
+        assert_eq!(host.handoff(true).unwrap().font, "existing");
+        assert_eq!(host.preparations, 0);
+    }
+
+    #[test]
+    fn only_the_winning_ui_is_prepared_before_input_layout_and_quick_handoff() {
+        let mut host = Fixture::new(true);
+        host.receive(1);
+        assert_eq!(host.input_generation(), None);
+        assert_eq!(host.draw(false, true), "boot");
+        assert_eq!(host.preparations, 0);
+        host.receive(2);
+        assert_eq!(host.handoff(true), None);
+        assert_eq!(host.draw(true, true), "mapped");
+        assert_eq!(host.input_generation(), Some(2));
+        assert_eq!(host.draw(true, true), "mapped");
+        assert_eq!(host.preparations, 1);
+        assert_eq!(
+            host.handoff(true),
+            Some(Ui {
+                generation: 2,
+                font: "mapped"
+            })
+        );
+    }
+
+    #[test]
+    fn failed_preparation_publishes_the_complete_regular_font_once() {
+        let mut host = Fixture::new(true);
+        host.receive(4);
+        assert_eq!(host.draw(true, false), "existing");
+        assert_eq!(host.draw(true, false), "existing");
+        assert_eq!(host.preparations, 1);
+        assert_eq!(host.handoff(true).unwrap().font, "existing");
+    }
+
+    #[test]
+    fn cancel_can_return_to_ordinary_publication_before_or_after_the_ui_arrives() {
+        for staged in [false, true] {
+            let mut host = Fixture::new(true);
+            if staged {
+                host.receive(5)
+            }
+            host.cancel_probe();
+            if !staged {
+                host.receive(5)
+            }
+            assert_eq!(host.draw(true, true), "existing");
+            assert_eq!(host.handoff(true).unwrap().generation, 5);
+            assert_eq!(host.preparations, 0);
+        }
+    }
+
+    #[test]
+    fn draining_drops_staged_ui_and_cannot_publish_late_results() {
+        struct Owned(Rc<Cell<u32>>);
+        impl Drop for Owned {
+            fn drop(&mut self) {
+                self.0.set(self.0.get() + 1);
+            }
+        }
+        let drops = Rc::new(Cell::new(0));
+        let mut pending = FirstUiPublication::new(true);
+        assert!(pending.receive(Owned(drops.clone())).is_none());
+        pending.abandon();
+        assert_eq!(drops.get(), 1);
+        assert!(pending.blocks_frontend());
+        assert!(pending.receive(Owned(drops.clone())).is_none());
+        assert_eq!(drops.get(), 2);
+        assert_eq!(
+            pending.finish_if_ready(true, |_| panic!("late publication")),
+            None::<()>
+        );
+    }
+}
