 impl CafeFrameWork {
+    /// An above-floor request failed to allocate its pair and presented directly.
+    pub(super) fn drs_elevated_allocation_failed(&self, requested: u32, floor: u32) -> bool {
+        self.presented == [true; 2]
+            && (floor < requested && requested < 100)
+            && self.world_resolution.is_some_and(|resolution| {
+                resolution.requested_scale == requested
+                    && resolution.effective_scale == 100
+                    && resolution.surface_bytes == 0
+            })
+    }
