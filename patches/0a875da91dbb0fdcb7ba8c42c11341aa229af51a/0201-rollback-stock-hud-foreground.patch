+/// Keep the channel alive until its worker has stopped. A completed load can
+/// still own a world tail in the channel if no Cafe session received it.
+#[cfg(target_os = "cafe")]
+pub(super) fn drain_cafe_resource_worker(
+    worker: Option<JoinHandle<()>>,
+    receiver: &Receiver<LoaderMsg>,
+    loaded_tail: Option<WorldRestLoader>,
+) -> Result<()> {
+    let resources = worker.map(JoinHandle::join);
+    let mut tail = loaded_tail.map(WorldRestLoader::finish).unwrap_or(Ok(()));
+    for message in receiver.try_iter() {
+        if let LoaderMsg::Done(Ok(mut loaded)) = message
+            && let Some(loader) = loaded.rest_loader.take()
+        {
+            tail = tail.and(loader.finish());
+        }
+    }
+    if matches!(resources, Some(Err(_))) {
+        return Err("Cafe resource worker panicked".into());
+    }
+    tail
+}
