-static void configure_voice(AXVoice *voice, int16_t *samples, uint32_t count,
+static AXResult configure_voice(AXVoice *voice, int16_t *samples, uint32_t count,
                             AXDeviceType device, uint32_t output_channel)
 {
    AXVoiceOffsets offsets = {
@@ -106,9 +112,10 @@ static void configure_voice(AXVoice *voice, int16_t *samples, uint32_t count,
