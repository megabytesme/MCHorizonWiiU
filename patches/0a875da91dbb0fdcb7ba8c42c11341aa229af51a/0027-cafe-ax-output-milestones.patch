@@ -250,16 +268,27 @@ void horizon_wiiu_audio_submit(void *handle, const float *stereo, uint32_t frame
    if (audio == NULL || stereo == NULL || frames != audio->samples_per_frame) {
       return;
    }
+   if (audio->reported_milestones != (AUDIO_CALLBACK_SEEN | AUDIO_PCM_DELIVERED)) {
