+        queue.push(Queued {
+            priority: i64::MIN,
+            at: None,
+            bias: 0,
+            order: 41,
+            job: Job::Save(Vec::new()),
+        });
+
+        assert_eq!(32usize.saturating_sub(meshing.len()), 0);
+        let mut cancelled = release_out_of_view_mesh_jobs(&mut queue, &mut meshing, |x, z| {
+            (x, z) == forced || in_view_distance(moved, 6, x, z)
+        });
+        cancelled.sort_unstable();
+        assert_eq!(cancelled, (1..20).map(rear_section).collect::<Vec<_>>());
+        assert_eq!(32usize.saturating_sub(meshing.len()), 19);
+        assert_eq!(meshing.get(&rear_section(0)), Some(&40));
+        assert_eq!(Arc::strong_count(&snapshot), 13);
+        assert!(matches!(queue.pop().unwrap().job, Job::Save(_)));
+        for sy in 0..11 {
