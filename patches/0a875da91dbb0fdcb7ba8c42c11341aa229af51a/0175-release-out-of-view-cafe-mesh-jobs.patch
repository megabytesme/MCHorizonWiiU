+    fn a_moving_view_reuses_unstarted_mesh_slots_before_the_server_forgets_columns() {
+        let rear = (-60, -1);
+        let centre = (-60, 5);
+        let moved = (-60, 6);
+        let forward = (-60, 12);
+        assert!(in_view_distance(centre, 6, rear.0, rear.1));
+        assert!(!in_view_distance(moved, 6, rear.0, rear.1));
+        assert!(!in_view_distance(centre, 6, forward.0, forward.1));
+        assert!(in_view_distance(moved, 6, forward.0, forward.1));
+        let settings = MeshSettings {
+            nether: false,
+            shader_pack_lighting: false,
+            separate_ao: false,
+            shader_pack: false,
+            looks: false,
+            zoom: BiomeZoom::new(0),
+            blend_radius: 0,
+            smooth_lighting: true,
+            cutout_leaves: false,
+            opaque_ice: false,
+            translucent_layers: Arc::default(),
+            leaf_culling: LeafCullingMode::Off,
+        };
+        let snapshot = Arc::<Region>::default();
+        let mesh = |pos: (i32, i32), sy, sequence| Queued {
+            priority: sequence as i64,
+            at: Some(pos),
+            bias: 0,
+            order: sequence,
+            job: Job::Mesh(
+                pos.0,
+                sy,
+                pos.1,
+                snapshot.clone(),
+                sequence,
+                settings.clone(),
+            ),
+        };
+        let rear_section = |sy| (rear.0, sy, rear.1);
+        let centre_section = |sy| (centre.0, sy, centre.1);
+        let forced = (40, 40);
+        let mut meshing: FxHashMap<_, _> = (0..20)
+            .map(|sy| (rear_section(sy), sy as u64))
+            .chain((0..11).map(|sy| (centre_section(sy), (20 + sy) as u64)))
+            .chain([((forced.0, 0, forced.1), 31)])
+            .collect();
+        let mut queue: BinaryHeap<_> = (0..20)
+            .map(|sy| mesh(rear, sy, sy as u64))
+            .chain((0..11).map(|sy| mesh(centre, sy, (20 + sy) as u64)))
+            .chain([mesh(forced, 0, 31)])
+            .collect();
+        // The worker already took the latest rear job. An obsolete queued
+        // revision for the same key must not release that worker's slot.
+        assert!(matches!(
+            queue.pop().unwrap().job,
+            Job::Mesh(_, 0, _, _, 0, _)
