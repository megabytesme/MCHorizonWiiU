+/// Drop only unstarted mesh jobs outside the current client view. A stale
+/// queued revision cannot release the slot of a newer, running revision.
+fn release_out_of_view_mesh_jobs(
+    queue: &mut BinaryHeap<Queued>,
+    meshing: &mut FxHashMap<(i32, i32, i32), u64>,
+    mut in_view: impl FnMut(i32, i32) -> bool,
+) -> Vec<(i32, i32, i32)> {
+    let mut released = Vec::new();
+    queue.retain(|queued| {
+        let Job::Mesh(x, sy, z, _, sequence, _) = &queued.job else {
+            return true;
+        };
+        if in_view(*x, *z) {
+            return true;
+        }
+        let key = (*x, *sy, *z);
+        if meshing.get(&key) == Some(sequence) {
+            meshing.remove(&key);
+            released.push(key);
+        }
+        false
+    });
+    released
+}
