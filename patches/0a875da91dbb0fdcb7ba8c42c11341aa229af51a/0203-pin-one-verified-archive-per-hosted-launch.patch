+    #[cfg(all(unix, feature = "verified-prepared-assets"))]
+    #[test]
+    fn hosted_readers_share_one_verified_generation_across_atomic_replacement() {
+        use sha2::{Digest, Sha256};
+        use std::sync::atomic::AtomicBool;
+
+        let temp = std::env::temp_dir().join(format!("horizon-verified-{}", crate::process_id()));
+        fs::create_dir(&temp).unwrap();
+        struct Cleanup(PathBuf);
+        impl Drop for Cleanup {
+            fn drop(&mut self) {
+                let _ = fs::remove_dir_all(&self.0);
+            }
+        }
+        let _cleanup = Cleanup(temp.clone());
+        let root = temp.join("origin");
+        let alias = temp.join("alias");
+        fs::create_dir_all(root.join("assets/fixture")).unwrap();
+        std::os::unix::fs::symlink(&root, &alias).unwrap();
+        fs::write(root.join(SOURCE), b"fixture").unwrap();
+        let name = "assets/fixture/source.json";
+        let write_generation = |bytes: &[u8]| -> [u8; 32] {
+            fs::write(root.join(name), bytes).unwrap();
+            write_with_readers(&root, 1).unwrap();
+            Sha256::digest(fs::read(root.join(FILE_NAME)).unwrap()).into()
+        };
+        let canceled = AtomicBool::new(false);
+        let old = write_generation(b"old");
+        let inherited = open(&alias).unwrap();
+        assert!(inherited.pin_verified().is_none());
+        let original = Arc::new(PreparedFiles::reopen_verified(&root, old, &canceled).unwrap().unwrap());
+        let old_lease = original.pin_verified().unwrap();
+        assert!(Arc::ptr_eq(&open(&root).unwrap(), &original));
+        assert!(Arc::ptr_eq(&open(&alias).unwrap(), &original));
+
+        let new = write_generation(b"new");
+        assert!(PreparedFiles::reopen_verified(&root, old, &canceled).is_err());
+        let replacement = Arc::new(PreparedFiles::reopen_verified(&root, new, &canceled).unwrap().unwrap());
+        assert!(replacement.pin_verified().is_none());
+        assert_eq!(open(&alias).unwrap().read(name).unwrap().unwrap(), b"old");
+        assert_eq!(replacement.read(name).unwrap().unwrap(), b"new");
+
+        drop(old_lease);
+        let fresh = open(&alias).unwrap();
+        assert_eq!(fresh.read(name).unwrap().unwrap(), b"new");
+        assert_eq!(inherited.read(name).unwrap().unwrap(), b"old");
+        assert_eq!(original.read(name).unwrap().unwrap(), b"old");
+        let new_lease = replacement.pin_verified().unwrap();
+        assert!(Arc::ptr_eq(&open(&root).unwrap(), &replacement));
+        drop(new_lease);
+
+        canceled.store(true, Ordering::Release);
+        assert!(PreparedFiles::reopen_verified(&root, new, &canceled).unwrap().is_none());
+    }
