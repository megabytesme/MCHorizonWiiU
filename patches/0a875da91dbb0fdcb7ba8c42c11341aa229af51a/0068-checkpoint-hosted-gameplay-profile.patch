+void horizon_gx2_profile_checkpoint_session(void)
+{
+   static uint32_t previous_session_presents;
+   const uint32_t presents = phase_frames[PLAYING_PHASE];
+   if (presents == previous_session_presents) return;
+   previous_session_presents = presents;
+   flush_to(ROOT "gx2-profile-session.hzp", ROOT "gx2-profile-session.tmp");
+   previous_phase = 0;
+   previous_output.phase = 0;
+}
+
