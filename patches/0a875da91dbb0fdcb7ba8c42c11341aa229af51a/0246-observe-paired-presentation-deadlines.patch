+static void deadline_point(DeadlineSample *sample, uint32_t edge, uint32_t swaps, uint32_t flips,
+                           OSTime flip_time, OSTime vsync)
+{
+   if (!ProcUIInForeground()) return;
+   const OSTime submitted = GX2GetLastSubmittedTimeStamp();
+   const OSTime retired = GX2GetRetiredTimeStamp();
+   sample->points[edge] = (DeadlinePoint){
+      .cpu = (uint64_t)OSGetSystemTime() - process_history.epoch,
+      .vblank = (uint64_t)vsync,
+      .flip_time = (uint64_t)flip_time,
+      .submitted = (uint64_t)submitted,
+      .retired = (uint64_t)retired,
+      .swaps = swaps,
+      .flips = flips,
+   };
+   sample->mask |= 1u << edge;
+}
+
+static void deadline_poll(DeadlineSample *sample, uint32_t edge)
+{
+   if (!ProcUIInForeground()) return;
+   uint32_t swaps, flips;
+   OSTime flip_time, vsync;
+   GX2GetSwapStatus(&swaps, &flips, &flip_time, &vsync);
+   deadline_point(sample, edge, swaps, flips, flip_time, vsync);
+}
+
+void horizon_gx2_profile_deadline_sample(uint32_t edge)
+{
+   if (!deadline_current || !recording || current.phase != PLAYING_PHASE) return;
+   // A retry and fallback in the same HZP3 frame must not share a timeline.
+   if (deadline_current->mask & (1u << edge)) {
+      deadline_current = NULL;
+      return;
+   }
+   deadline_poll(deadline_current, edge);
+}
+
+void horizon_gx2_profile_deadline_ready(bool grouped)
+{
+   if (!deadline_current) return;
+   deadline_current->grouped = grouped;
+   horizon_gx2_profile_deadline_sample(GX2_DEADLINE_READY);
+}
+
+static void deadline_begin(void)
+{
+   // The hosted loop starts each row as Loading before the game selects
+   // its phase. Retain a sample only if finish confirms ordinary playing.
+   const bool after_playing = history->previous_phase == PLAYING_PHASE;
+   if (deadline_follow && after_playing && deadline_follow->sequence + 1 == history->total)
+      deadline_poll(deadline_follow, GX2_DEADLINE_NEXT_START);
+   deadline_follow = NULL;
+   if (!after_playing || history->total % DEADLINE_PERIOD != 0 ||
+       deadline_count == DEADLINE_CAPACITY) return;
+   deadline_current = &deadlines[deadline_count];
+   *deadline_current = (DeadlineSample){.start = started - process_history.epoch,
+                                        .sequence = history->total};
+   deadline_poll(deadline_current, GX2_DEADLINE_START);
+}
+
+static void deadline_finish(void)
+{
+   if (!deadline_current) return;
+   const uint32_t required = (1u << GX2_DEADLINE_START) | (1u << GX2_DEADLINE_AFTER_FLIP_WAIT) |
+                             (1u << GX2_DEADLINE_READY) | (1u << GX2_DEADLINE_FINISHED);
+   if (current.phase == PLAYING_PHASE && current.counters[GX2_PROFILE_PRESENTED] == 1 &&
+       !current.stages[SCREENSHOT_STAGE] && (deadline_current->mask & required) == required) {
+      ++deadline_count;
+      deadline_follow = deadline_current;
+   }
+   deadline_current = NULL;
+}
+
+static void report_deadlines(void)
+{
+   static const char *const names[GX2_DEADLINE_EDGES] = {
+      "start", "waited", "ready", "posted", "finished", "next",
+   };
+   for (uint32_t i = 0; i < deadline_count; ++i) {
+      const DeadlineSample *sample = &deadlines[i];
+      for (uint32_t edge = 0; edge < GX2_DEADLINE_EDGES; ++edge) {
+         if (!(sample->mask & (1u << edge))) continue;
+         const DeadlinePoint *point = &sample->points[edge];
+         OSReport("Horizon GX2 deadline seq=%u start=%llx mode=%u edge=%s cpu=%llx "
+                  "s=%x f=%x v=%llx l=%llx q=%llx r=%llx\n",
+                  sample->sequence, (unsigned long long)sample->start, (unsigned)sample->grouped,
+                  names[edge], (unsigned long long)point->cpu, point->swaps, point->flips,
+                  (unsigned long long)point->vblank, (unsigned long long)point->flip_time,
+                  (unsigned long long)point->submitted, (unsigned long long)point->retired);
+      }
+   }
+   deadline_follow = NULL;
+   deadline_count = 0;
+}
