diff --git a/crates/horizon-world/src/level/behaviour_inputs.rs b/crates/horizon-world/src/level/behaviour_inputs.rs
new file mode 100644
index 0000000..fca11ab
--- /dev/null
+++ b/crates/horizon-world/src/level/behaviour_inputs.rs
@@ -0,0 +1,114 @@
+//! Validated block facts already decoded by the current resource load.
+use super::{Behaviours, data::GameplayProjection};
+use crate::registry::BlockRegistry;
+use std::{
+    cell::RefCell,
+    io,
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+
+pub struct BlockBehaviourInputs {
+    definition: serde_json::Value,
+    gameplay: Vec<GameplayProjection>,
+}
+
+struct Preload {
+    root: PathBuf,
+    registry: &'static BlockRegistry,
+    inputs: Arc<BlockBehaviourInputs>,
+}
+
+thread_local! {
+    static PRELOAD: RefCell<Option<Preload>> = const { RefCell::new(None) };
+}
+
+impl BlockBehaviourInputs {
+    pub fn new(definition: serde_json::Value, gameplay: Vec<GameplayProjection>) -> Self {
+        Self {
+            definition,
+            gameplay,
+        }
+    }
+
+    /// Each consumer builds its own mutable world behaviour state.
+    pub fn load(&self, registry: &BlockRegistry, root: &Path) -> io::Result<Behaviours> {
+        Behaviours::load_with_gameplay(registry, root, &self.definition, &self.gameplay)
+    }
+
+    /// Make these inputs available to the named-world preload without
+    /// changing the worldgen loader's replaceable entry point or cache keys.
+    pub fn with_worldgen<T>(
+        self: &Arc<Self>,
+        root: &Path,
+        registry: &'static BlockRegistry,
+        load: impl FnOnce() -> T,
+    ) -> T {
+        struct Restore(Option<Preload>);
+        impl Drop for Restore {
+            fn drop(&mut self) {
+                PRELOAD.with(|current| current.replace(self.0.take()));
+            }
+        }
+        let _scope = Restore(PRELOAD.with(|current| {
+            current.replace(Some(Preload {
+                root: root.to_owned(),
+                registry,
+                inputs: self.clone(),
+            }))
+        }));
+        load()
+    }
+}
+
+/// The generator calls this on the preloader thread before spawning work.
+pub(crate) fn for_worldgen(
+    root: &Path,
+    registry: &BlockRegistry,
+) -> Option<Arc<BlockBehaviourInputs>> {
+    PRELOAD.with(|current| {
+        let current = current.borrow();
+        let selected = current.as_ref()?;
+        (selected.root == root && std::ptr::eq(selected.registry, registry))
+            .then(|| selected.inputs.clone())
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn named_world_preload_inputs_are_scoped_to_the_root_and_registry() {
+        let facts = br#"{"states":[["minecraft:air",true,false,"x","minecraft:air"]],
+            "defaults":{"minecraft:air":0}}"#;
+        let registry = || {
+            Box::leak(Box::new(
+                BlockRegistry::from_facts_json_bytes(facts).unwrap().0,
+            ))
+        };
+        let first: &'static BlockRegistry = registry();
+        let second: &'static BlockRegistry = registry();
+        let inputs = Arc::new(BlockBehaviourInputs::new(
+            serde_json::Value::Null,
+            Vec::new(),
+        ));
+        let root = Path::new("preparation");
+        assert!(for_worldgen(root, first).is_none());
+        inputs.with_worldgen(root, first, || {
+            assert!(Arc::ptr_eq(&inputs, &for_worldgen(root, first).unwrap()));
+            assert!(for_worldgen(root, second).is_none());
+            assert!(for_worldgen(Path::new("other preparation"), first).is_none());
+            let nested = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                inputs.with_worldgen(root, second, || {
+                    assert!(for_worldgen(root, first).is_none());
+                    panic!("unwind the nested preload");
+                })
+            }));
+            assert!(nested.is_err());
+            assert!(Arc::ptr_eq(&inputs, &for_worldgen(root, first).unwrap()));
+        });
+        assert!(for_worldgen(root, first).is_none());
+        assert_eq!(Arc::strong_count(&inputs), 1);
+    }
+}
