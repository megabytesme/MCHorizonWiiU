index 0000000000000000000000000000000000000000..0c4647d19206df32f1af6a6308c88b1a8a2f05ce
--- /dev/null
+++ b/wiiu/platform/src/keyboard.rs
@@ -0,0 +1,431 @@
+//! Cafe `nsyskbd` events normalized to Horizon's shared keyboard contract.
+
+use horizon_client_platform::{
+    ClientWindowEvent, KeyCode, KeyLocation, KeyState, KeyboardEvent, LogicalKey, Modifiers,
+};
+
+const CHANNELS: usize = 256;
+const USAGES_PER_CHANNEL: usize = 256;
+const WORDS_PER_CHANNEL: usize = USAGES_PER_CHANNEL / u64::BITS as usize;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+struct RawKeyboardEvent {
+    kind: u8,
+    channel: u8,
+    hid_code: u8,
+    is_pressed_down: u8,
+    utf16_character: u16,
+    reserved: u16,
+}
+
+const _: () = {
+    assert!(core::mem::size_of::<RawKeyboardEvent>() == 8);
+    assert!(core::mem::offset_of!(RawKeyboardEvent, utf16_character) == 4);
+    assert!(core::mem::offset_of!(RawKeyboardEvent, reserved) == 6);
+};
+
+const ATTACHED: u8 = 1;
+const DETACHED: u8 = 2;
+const KEY: u8 = 3;
+
+unsafe extern "C" {
+    fn horizon_wiiu_keyboard_init() -> i32;
+    fn horizon_wiiu_keyboard_teardown() -> i32;
+    fn horizon_wiiu_keyboard_pop(event: *mut RawKeyboardEvent) -> i32;
+    fn horizon_wiiu_keyboard_dropped() -> u32;
+}
+
+/// Initialize `nsyskbd` and register the event-copying callbacks.
+pub fn initialize() -> Result<(), i32> {
+    match unsafe { horizon_wiiu_keyboard_init() } {
+        0 => Ok(()),
+        error => Err(error),
+    }
+}
+
+/// Stop `nsyskbd` and unregister the event-copying callbacks.
+pub fn shutdown() -> i32 {
+    unsafe { horizon_wiiu_keyboard_teardown() }
+}
+
+/// Converts queued USB keyboard records and tracks held keys by device channel.
+pub struct KeyboardAdapter {
+    pressed: [[u64; WORDS_PER_CHANNEL]; CHANNELS],
+    held_characters: [u16; USAGES_PER_CHANNEL],
+    observed_drops: u32,
+    modifiers: Modifiers,
+}
+
+impl Default for KeyboardAdapter {
+    fn default() -> Self {
+        Self {
+            pressed: [[0; WORDS_PER_CHANNEL]; CHANNELS],
+            held_characters: [0; USAGES_PER_CHANNEL],
+            observed_drops: 0,
+            modifiers: Modifiers::empty(),
+        }
+    }
+}
+
+impl KeyboardAdapter {
+    /// Emit synthetic releases for all currently held USB keys.
+    pub fn release_all_into(&mut self, output: &mut Vec<ClientWindowEvent>) {
+        self.release_all(output);
+    }
+
+    /// Drain queued events into the caller's reusable output vector.
+    pub fn drain_into(&mut self, output: &mut Vec<ClientWindowEvent>) {
+        let dropped = unsafe { horizon_wiiu_keyboard_dropped() };
+        if dropped != self.observed_drops {
+            self.observed_drops = dropped;
+            self.release_all(output);
+            // Discard records queued before recovery. Their transitions may no
+            // longer describe the current held state after an overflow.
+            let mut ignored = RawKeyboardEvent::default();
+            while unsafe { horizon_wiiu_keyboard_pop(&mut ignored) } != 0 {}
+            return;
+        }
+
+        loop {
+            let mut raw = RawKeyboardEvent::default();
+            if unsafe { horizon_wiiu_keyboard_pop(&mut raw) } == 0 {
+                break;
+            }
+            match raw.kind {
+                ATTACHED => {}
+                DETACHED => self.release_channel(raw.channel, output),
+                KEY => self.key_event(raw, output),
+                _ => {}
+            }
+        }
+    }
+
+    fn key_event(&mut self, raw: RawKeyboardEvent, output: &mut Vec<ClientWindowEvent>) {
+        let usage = raw.hid_code as usize;
+        let channel = raw.channel as usize;
+        let was_pressed = self.is_pressed(channel, usage);
+        let was_visible = self.is_visible(usage);
+        let pressed = raw.is_pressed_down != 0;
+        if !pressed && !was_pressed {
+            return;
+        }
+        if pressed {
+            self.set_pressed(channel, usage, true);
+            if !was_visible {
+                self.held_characters[usage] = raw.utf16_character;
+            }
+        } else {
+            self.set_pressed(channel, usage, false);
+        }
+
+        if pressed && was_pressed {
+            output.push(keyboard_event(
+                raw.hid_code,
+                KeyState::Pressed,
+                self.held_characters[usage],
+                true,
+                false,
+            ));
+            return;
+        }
+
+        let is_visible = self.is_visible(usage);
+        if was_visible == is_visible {
+            self.update_modifiers(output);
+            return;
+        }
+
+        let character = if pressed {
+            raw.utf16_character
+        } else {
+            self.held_characters[usage]
+        };
+        output.push(keyboard_event(
+            raw.hid_code,
+            if pressed {
+                KeyState::Pressed
+            } else {
+                KeyState::Released
+            },
+            character,
+            pressed && was_pressed,
+            false,
+        ));
+        self.update_modifiers(output);
+    }
+
+    fn release_channel(&mut self, channel: u8, output: &mut Vec<ClientWindowEvent>) {
+        let channel = channel as usize;
+        for usage in 0..USAGES_PER_CHANNEL {
+            if self.is_pressed(channel, usage) {
+                self.set_pressed(channel, usage, false);
+                let usage = usage as u8;
+                if !self.is_visible(usage as usize) {
+                    output.push(keyboard_event(
+                        usage,
+                        KeyState::Released,
+                        self.held_characters[usage as usize],
+                        false,
+                        true,
+                    ));
+                }
+            }
+        }
+        self.update_modifiers(output);
+    }
+
+    fn release_all(&mut self, output: &mut Vec<ClientWindowEvent>) {
+        for channel in 0..CHANNELS {
+            for usage in 0..USAGES_PER_CHANNEL {
+                if self.is_pressed(channel, usage) {
+                    self.set_pressed(channel, usage, false);
+                    if !self.is_visible(usage) {
+                        output.push(keyboard_event(
+                            usage as u8,
+                            KeyState::Released,
+                            self.held_characters[usage],
+                            false,
+                            true,
+                        ));
+                    }
+                }
+            }
+        }
+        self.update_modifiers(output);
+    }
+
+    fn is_pressed(&self, channel: usize, usage: usize) -> bool {
+        self.pressed[channel][usage / 64] & (1u64 << (usage % 64)) != 0
+    }
+
+    fn is_visible(&self, usage: usize) -> bool {
+        (0..CHANNELS).any(|channel| self.is_pressed(channel, usage))
+    }
+
+    fn set_pressed(&mut self, channel: usize, usage: usize, pressed: bool) {
+        let bit = 1u64 << (usage % 64);
+        let word = &mut self.pressed[channel][usage / 64];
+        if pressed {
+            *word |= bit;
+        } else {
+            *word &= !bit;
+        }
+    }
+
+    fn update_modifiers(&mut self, output: &mut Vec<ClientWindowEvent>) {
+        let mut next = Modifiers::empty();
+        for channel in 0..CHANNELS {
+            for (usage, modifier) in [
+                (0xE0, Modifiers::CONTROL),
+                (0xE1, Modifiers::SHIFT),
+                (0xE2, Modifiers::ALT),
+                (0xE3, Modifiers::SUPER),
+                (0xE4, Modifiers::CONTROL),
+                (0xE5, Modifiers::SHIFT),
+                (0xE6, Modifiers::ALT),
+                (0xE7, Modifiers::SUPER),
+            ] {
+                if self.is_pressed(channel, usage) {
+                    next.set(modifier, true);
+                }
+            }
+        }
+        if next != self.modifiers {
+            self.modifiers = next;
+            output.push(ClientWindowEvent::ModifiersChanged(next));
+        }
+    }
+}
+
+fn keyboard_event(
+    usage: u8,
+    state: KeyState,
+    utf16_character: u16,
+    repeat: bool,
+    is_synthetic: bool,
+) -> ClientWindowEvent {
+    let key = key_code(usage);
+    let text = if state == KeyState::Pressed {
+        char::from_u32(utf16_character as u32).map(|c| c.to_string())
+    } else {
+        None
+    };
+    let logical_key = char::from_u32(utf16_character as u32)
+        .map(|c| LogicalKey::Character(c.to_string()))
+        .unwrap_or_else(|| logical_key(key));
+    ClientWindowEvent::KeyboardInput {
+        event: KeyboardEvent {
+            physical_key: Some(key),
+            logical_key,
+            location: key_location(usage),
+            state,
+            logical_text: char::from_u32(utf16_character as u32).map(|c| c.to_string()),
+            text,
+            unmodified_text: None,
+            repeat,
+        },
+        is_synthetic,
+    }
+}
+
+fn key_location(usage: u8) -> KeyLocation {
+    match usage {
+        0xE0 | 0xE2 | 0xE4 | 0xE6 => KeyLocation::Left,
+        0xE1 | 0xE3 | 0xE5 | 0xE7 => KeyLocation::Right,
+        0x53..=0x63 => KeyLocation::Numpad,
+        _ => KeyLocation::Standard,
+    }
+}
+
+fn logical_key(key: KeyCode) -> LogicalKey {
+    let name = match key {
+        KeyCode::Enter => "Enter",
+        KeyCode::Escape => "Escape",
+        KeyCode::Backspace => "Backspace",
+        KeyCode::Tab => "Tab",
+        KeyCode::Space => " ",
+        KeyCode::ArrowDown => "ArrowDown",
+        KeyCode::ArrowLeft => "ArrowLeft",
+        KeyCode::ArrowRight => "ArrowRight",
+        KeyCode::ArrowUp => "ArrowUp",
+        KeyCode::Delete => "Delete",
+        KeyCode::Insert => "Insert",
+        KeyCode::Home => "Home",
+        KeyCode::End => "End",
+        KeyCode::PageUp => "PageUp",
+        KeyCode::PageDown => "PageDown",
+        KeyCode::ShiftLeft => "Shift",
+        KeyCode::ShiftRight => "Shift",
+        KeyCode::ControlLeft | KeyCode::ControlRight => "Control",
+        KeyCode::AltLeft | KeyCode::AltRight => "Alt",
+        KeyCode::SuperLeft | KeyCode::SuperRight => "Super",
+        KeyCode::CapsLock => "CapsLock",
+        KeyCode::F1 => "F1",
+        KeyCode::F2 => "F2",
+        KeyCode::F3 => "F3",
+        KeyCode::F4 => "F4",
+        KeyCode::F5 => "F5",
+        KeyCode::F6 => "F6",
+        KeyCode::F7 => "F7",
+        KeyCode::F8 => "F8",
+        KeyCode::F9 => "F9",
+        KeyCode::F10 => "F10",
+        KeyCode::F11 => "F11",
+        KeyCode::F12 => "F12",
+        _ => return LogicalKey::Unidentified,
+    };
+    LogicalKey::Named(name.to_owned())
+}
+
+fn key_code(usage: u8) -> KeyCode {
+    use KeyCode::*;
+    match usage {
+        0x04 => KeyA,
+        0x05 => KeyB,
+        0x06 => KeyC,
+        0x07 => KeyD,
+        0x08 => KeyE,
+        0x09 => KeyF,
+        0x0A => KeyG,
+        0x0B => KeyH,
+        0x0C => KeyI,
+        0x0D => KeyJ,
+        0x0E => KeyK,
+        0x0F => KeyL,
+        0x10 => KeyM,
+        0x11 => KeyN,
+        0x12 => KeyO,
+        0x13 => KeyP,
+        0x14 => KeyQ,
+        0x15 => KeyR,
+        0x16 => KeyS,
+        0x17 => KeyT,
+        0x18 => KeyU,
+        0x19 => KeyV,
+        0x1A => KeyW,
+        0x1B => KeyX,
+        0x1C => KeyY,
+        0x1D => KeyZ,
+        0x1E => Digit1,
+        0x1F => Digit2,
+        0x20 => Digit3,
+        0x21 => Digit4,
+        0x22 => Digit5,
+        0x23 => Digit6,
+        0x24 => Digit7,
+        0x25 => Digit8,
+        0x26 => Digit9,
+        0x27 => Digit0,
+        0x28 => Enter,
+        0x29 => Escape,
+        0x2A => Backspace,
+        0x2B => Tab,
+        0x2C => Space,
+        0x2D => Minus,
+        0x2E => Equal,
+        0x2F => BracketLeft,
+        0x30 => BracketRight,
+        0x31 => Backslash,
+        0x32 | 0x64 => IntlBackslash,
+        0x33 => Semicolon,
+        0x34 => Quote,
+        0x35 => Backquote,
+        0x36 => Comma,
+        0x37 => Period,
+        0x38 => Slash,
+        0x39 => CapsLock,
+        0x3A => F1,
+        0x3B => F2,
+        0x3C => F3,
+        0x3D => F4,
+        0x3E => F5,
+        0x3F => F6,
+        0x40 => F7,
+        0x41 => F8,
+        0x42 => F9,
+        0x43 => F10,
+        0x44 => F11,
+        0x45 => F12,
+        0x46 => PrintScreen,
+        0x47 => ScrollLock,
+        0x48 => Pause,
+        0x49 => Insert,
+        0x4A => Home,
+        0x4B => PageUp,
+        0x4C => Delete,
+        0x4D => End,
+        0x4E => PageDown,
+        0x4F => ArrowRight,
+        0x50 => ArrowLeft,
+        0x51 => ArrowDown,
+        0x52 => ArrowUp,
+        0x53 => NumLock,
+        0x54 => NumpadDivide,
+        0x55 => NumpadMultiply,
+        0x56 => NumpadSubtract,
+        0x57 => NumpadAdd,
+        0x58 => NumpadEnter,
+        0x59 => Numpad1,
+        0x5A => Numpad2,
+        0x5B => Numpad3,
+        0x5C => Numpad4,
+        0x5D => Numpad5,
+        0x5E => Numpad6,
+        0x5F => Numpad7,
+        0x60 => Numpad8,
+        0x61 => Numpad9,
+        0x62 => Numpad0,
+        0x63 => NumpadDecimal,
+        0x65 => ContextMenu,
+        0xE0 => ControlLeft,
+        0xE1 => ShiftLeft,
+        0xE2 => AltLeft,
+        0xE3 => SuperLeft,
+        0xE4 => ControlRight,
+        0xE5 => ShiftRight,
+        0xE6 => AltRight,
+        0xE7 => SuperRight,
+        _ => Other,
+    }
+}
diff --git a/wiiu/platform/src/keyboard_bridge.c b/wiiu/platform/src/keyboard_bridge.c
new file mode 100644
index 0000000000000000000000000000000000000000..7d80eb4c0ec2c62868ad47f7ad3207313f9b18cf
--- /dev/null
+++ b/wiiu/platform/src/keyboard_bridge.c
@@ -0,0 +1,193 @@
+#include "keyboard_bridge.h"
+
+#include <nsyskbd/nsyskbd.h>
+#include <stdatomic.h>
+#include <stddef.h>
+
+/*
+ * Bounded MPMC queue: nsyskbd does not document which Cafe thread invokes its
+ * callbacks, so callback records are copied here and consumed on the host loop.
+ * Callback code performs no allocation, logging, or game/UI dispatch.
+ */
+#define KEYBOARD_QUEUE_CAPACITY 128u
+#define KEYBOARD_QUEUE_MASK (KEYBOARD_QUEUE_CAPACITY - 1u)
+
+_Static_assert((KEYBOARD_QUEUE_CAPACITY & KEYBOARD_QUEUE_MASK) == 0,
+               "keyboard queue capacity must be a power of two");
+
+typedef struct KeyboardQueueSlot {
+   _Atomic uint32_t sequence;
+   HorizonKeyboardEvent event;
+} KeyboardQueueSlot;
+
+static KeyboardQueueSlot queue[KEYBOARD_QUEUE_CAPACITY];
+static _Atomic uint32_t enqueue_position;
+static _Atomic uint32_t dequeue_position;
+static _Atomic uint32_t dropped_events;
+static _Atomic int callbacks_enabled;
+/* 0 = uninitialized, 1 = initializing, 2 = ready. */
+static _Atomic int queue_state;
+
+static void
+initialize_queue(void)
+{
+   int state = atomic_load_explicit(&queue_state, memory_order_acquire);
+   if (state == 2) {
+      return;
+   }
+
+   int uninitialized = 0;
+   if (!atomic_compare_exchange_strong_explicit(&queue_state, &uninitialized, 1,
+                                               memory_order_acq_rel,
+                                               memory_order_acquire)) {
+      while (atomic_load_explicit(&queue_state, memory_order_acquire) != 2) {
+      }
+      return;
+   }
+
+   for (uint32_t i = 0; i < KEYBOARD_QUEUE_CAPACITY; ++i) {
+      atomic_init(&queue[i].sequence, i);
+   }
+   atomic_store_explicit(&enqueue_position, 0, memory_order_relaxed);
+   atomic_store_explicit(&dequeue_position, 0, memory_order_relaxed);
+   atomic_store_explicit(&dropped_events, 0, memory_order_relaxed);
+   atomic_store_explicit(&queue_state, 2, memory_order_release);
+}
+
+static void
+enqueue_event(HorizonKeyboardEvent event)
+{
+   uint32_t position = atomic_load_explicit(&enqueue_position, memory_order_relaxed);
+   KeyboardQueueSlot *slot;
+
+   for (;;) {
+      slot = &queue[position & KEYBOARD_QUEUE_MASK];
+      uint32_t sequence = atomic_load_explicit(&slot->sequence, memory_order_acquire);
+      int32_t difference = (int32_t)(sequence - position);
+
+      if (difference == 0) {
+         if (atomic_compare_exchange_weak_explicit(&enqueue_position, &position,
+                                                   position + 1u,
+                                                   memory_order_relaxed,
+                                                   memory_order_relaxed)) {
+            break;
+         }
+      } else if (difference < 0) {
+         atomic_fetch_add_explicit(&dropped_events, 1, memory_order_relaxed);
+         return;
+      } else {
+         position = atomic_load_explicit(&enqueue_position, memory_order_relaxed);
+      }
+   }
+
+   slot->event = event;
+   atomic_store_explicit(&slot->sequence, position + 1u, memory_order_release);
+}
+
+static int
+dequeue_event(HorizonKeyboardEvent *event)
+{
+   uint32_t position = atomic_load_explicit(&dequeue_position, memory_order_relaxed);
+   KeyboardQueueSlot *slot;
+
+   for (;;) {
+      slot = &queue[position & KEYBOARD_QUEUE_MASK];
+      uint32_t sequence = atomic_load_explicit(&slot->sequence, memory_order_acquire);
+      int32_t difference = (int32_t)(sequence - (position + 1u));
+
+      if (difference == 0) {
+         if (atomic_compare_exchange_weak_explicit(&dequeue_position, &position,
+                                                   position + 1u,
+                                                   memory_order_relaxed,
+                                                   memory_order_relaxed)) {
+            break;
+         }
+      } else if (difference < 0) {
+         return 0;
+      } else {
+         position = atomic_load_explicit(&dequeue_position, memory_order_relaxed);
+      }
+   }
+
+   *event = slot->event;
+   atomic_store_explicit(&slot->sequence,
+                         position + KEYBOARD_QUEUE_CAPACITY,
+                         memory_order_release);
+   return 1;
+}
+
+static void
+keyboard_attached(KBDAttachEvent *event)
+{
+   if (event == NULL || !atomic_load_explicit(&callbacks_enabled, memory_order_relaxed)) {
+      return;
+   }
+
+   HorizonKeyboardEvent record = {0};
+   record.kind = HORIZON_KEYBOARD_ATTACHED;
+   record.channel = event->channel;
+   enqueue_event(record);
+}
+
+static void
+keyboard_detached(KBDAttachEvent *event)
+{
+   if (event == NULL || !atomic_load_explicit(&callbacks_enabled, memory_order_relaxed)) {
+      return;
+   }
+
+   HorizonKeyboardEvent record = {0};
+   record.kind = HORIZON_KEYBOARD_DETACHED;
+   record.channel = event->channel;
+   enqueue_event(record);
+}
+
+static void
+keyboard_key(KBDKeyEvent *event)
+{
+   if (event == NULL || !atomic_load_explicit(&callbacks_enabled, memory_order_relaxed)) {
+      return;
+   }
+
+   HorizonKeyboardEvent record = {0};
+   record.kind = HORIZON_KEYBOARD_KEY;
+   record.channel = event->channel;
+   record.hid_code = event->hidCode;
+   record.is_pressed_down = event->isPressedDown != 0;
+   record.utf16_character = event->asUTF16Character;
+   enqueue_event(record);
+}
+
+int32_t
+horizon_wiiu_keyboard_init(void)
+{
+   initialize_queue();
+   atomic_store_explicit(&callbacks_enabled, 1, memory_order_release);
+   KDBError result = KBDSetup(keyboard_attached, keyboard_detached, keyboard_key);
+   if (result != KDB_ERROR_NONE) {
+      atomic_store_explicit(&callbacks_enabled, 0, memory_order_release);
+   }
+   return (int32_t)result;
+}
+
+int32_t
+horizon_wiiu_keyboard_teardown(void)
+{
+   atomic_store_explicit(&callbacks_enabled, 0, memory_order_release);
+   return (int32_t)KBDTeardown();
+}
+
+int32_t
+horizon_wiiu_keyboard_pop(HorizonKeyboardEvent *event)
+{
+   if (event == NULL || atomic_load_explicit(&queue_state, memory_order_acquire) != 2) {
+      return 0;
+   }
+   return dequeue_event(event);
+}
+
+uint32_t
+horizon_wiiu_keyboard_dropped(void)
+{
+   return atomic_load_explicit(&dropped_events, memory_order_relaxed);
+}
diff --git a/wiiu/platform/src/keyboard_bridge.h b/wiiu/platform/src/keyboard_bridge.h
new file mode 100644
index 0000000000000000000000000000000000000000..1ac680689843ef9dbc13266c737bb33e4679a1f3
--- /dev/null
+++ b/wiiu/platform/src/keyboard_bridge.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#include <stdint.h>
+#include <stddef.h>
+
+/* Raw nsyskbd events copied by its callbacks and drained by the Cafe main loop. */
+typedef struct HorizonKeyboardEvent {
+   uint8_t kind;
+   uint8_t channel;
+   uint8_t hid_code;
+   uint8_t is_pressed_down;
+   uint16_t utf16_character;
+   uint16_t reserved;
+} HorizonKeyboardEvent;
+
+_Static_assert(sizeof(HorizonKeyboardEvent) == 8,
+               "unexpected keyboard event ABI size");
+_Static_assert(offsetof(HorizonKeyboardEvent, utf16_character) == 4,
+               "unexpected keyboard event UTF-16 offset");
+_Static_assert(offsetof(HorizonKeyboardEvent, reserved) == 6,
+               "unexpected keyboard event reserved offset");
+
+enum HorizonKeyboardEventKind {
+   HORIZON_KEYBOARD_ATTACHED = 1,
+   HORIZON_KEYBOARD_DETACHED = 2,
+   HORIZON_KEYBOARD_KEY = 3,
+};
+
+/* Initialize/tear down nsyskbd. Return the KDBError value from WUT. */
+int32_t horizon_wiiu_keyboard_init(void);
+int32_t horizon_wiiu_keyboard_teardown(void);
+
+/* Return 1 and copy one queued record, or 0 when the queue is empty. */
+int32_t horizon_wiiu_keyboard_pop(HorizonKeyboardEvent *event);
+
+/* Number of callback records dropped because the bounded queue was full. */
+uint32_t horizon_wiiu_keyboard_dropped(void);
diff --git a/wiiu/platform/src/lib.rs b/wiiu/platform/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9347b7f54756eb1f07d8ab51c2a75f075cbf7ba3
--- /dev/null
+++ b/wiiu/platform/src/lib.rs
@@ -0,0 +1,609 @@
+//! CafeOS input adapter for Horizon's existing controller processing.
+//!
+//! The host feeds the returned `PadState` to Horizon; bindings, button edges,
+//! deadzones, menu navigation and Nintendo letter swapping remain in Horizon.
+
+use horizon_client_input::gamepad::{Button, PadState};
+use std::collections::VecDeque;
+
+#[cfg(all(feature = "cafe", target_arch = "powerpc"))]
+pub mod audio;
+pub mod hud;
+pub mod keyboard;
+pub mod mouse;
+pub mod touch;
+
+/// The scalar subset read from WUT's `VPADStatus` by `vpad_bridge.c`.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+pub struct VpadSample {
+    pub buttons: u32,
+    pub left_x: f32,
+    pub left_y: f32,
+    pub right_x: f32,
+    pub right_y: f32,
+    /// Calibrated 1920×1080 GamePad screen coordinates.
+    pub touch_x: u16,
+    pub touch_y: u16,
+    /// Physical touch contact, independent of coordinate validity.
+    pub touch_active: u32,
+    /// Nonzero only when calibrated coordinates are valid and in range.
+    pub touch_valid: u32,
+}
+
+pub const VPAD_SAMPLE_CAPACITY: usize = 16;
+pub const VPAD_HISTORY_CAPACITY: usize = VPAD_SAMPLE_CAPACITY * 3;
+pub const BUTTON_HISTORY_QUEUE_CAPACITY: usize = 128;
+
+/// Bounded replay queue for physical controller button-state transitions.
+/// History carries no sample freshness or touch evidence.
+pub struct ButtonHistory {
+    masks: VecDeque<u32>,
+}
+
+impl Default for ButtonHistory {
+    fn default() -> Self {
+        Self {
+            masks: VecDeque::with_capacity(BUTTON_HISTORY_QUEUE_CAPACITY),
+        }
+    }
+}
+
+impl ButtonHistory {
+    /// Queue one poll's ordered masks, or clear history while input is gated.
+    /// Returns false on overflow; that path clears pending masks fail-closed.
+    pub fn push_poll(&mut self, masks: &[u32], keyboard_owned: bool, focused: bool) -> bool {
+        if keyboard_owned || !focused {
+            self.clear();
+            return true;
+        }
+        if self.masks.len().saturating_add(masks.len()) > BUTTON_HISTORY_QUEUE_CAPACITY {
+            self.clear();
+            return false;
+        }
+        self.masks.extend(masks.iter().copied());
+        true
+    }
+
+    pub fn pop_front(&mut self) -> Option<u32> {
+        self.masks.pop_front()
+    }
+
+    pub fn clear(&mut self) {
+        self.masks.clear();
+    }
+
+    #[cfg(test)]
+    fn len(&self) -> usize {
+        self.masks.len()
+    }
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+struct VpadBatch {
+    latest: VpadSample,
+    transition_count: u32,
+    transitions: [u32; VPAD_HISTORY_CAPACITY],
+}
+
+impl Default for VpadBatch {
+    fn default() -> Self {
+        Self {
+            latest: VpadSample::default(),
+            transition_count: 0,
+            transitions: [0; VPAD_HISTORY_CAPACITY],
+        }
+    }
+}
+
+#[derive(Debug)]
+pub struct VpadPoll {
+    pub pad: PadState,
+    pub fresh_sample: Option<FreshVpadSample>,
+    pub fresh_touch_release: Option<FreshTouchRelease>,
+    /// Ordered button masks from physical VPAD samples in this poll batch.
+    /// These are historical controller states, not fresh poll evidence.
+    pub button_history: [u32; VPAD_HISTORY_CAPACITY],
+    pub button_history_len: usize,
+}
+
+// This type is passed to the WUT bridge compiled from vpad_bridge.h.
+const _: () = {
+    assert!(std::mem::size_of::<VpadBatch>() == 228);
+    assert!(std::mem::size_of::<VpadSample>() == 32);
+    assert!(std::mem::offset_of!(VpadSample, touch_x) == 20);
+    assert!(std::mem::offset_of!(VpadSample, touch_active) == 24);
+    assert!(std::mem::offset_of!(VpadSample, touch_valid) == 28);
+};
+
+/// A calibrated contact on the Wii U GamePad's 1920×1080 touch surface.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct VpadTouch {
+    pub x: u16,
+    pub y: u16,
+}
+
+/// Non-cloneable evidence that one successful VPAD sample reported no contact.
+/// Default state, reset, no-sample and busy polling cannot produce this marker.
+///
+/// Treat it as paired with the exact `VpadState` updated by that poll: pass it
+/// immediately to `TouchMapper::events_with_freshness` with that same state,
+/// before resetting the state or polling it again. Do not retain or reuse it.
+#[derive(Debug)]
+pub struct FreshTouchRelease(());
+
+/// Non-cloneable evidence that one VPAD update received a successful hardware
+/// sample. Unlike [`FreshTouchRelease`], this evidence says nothing about
+/// touchscreen contact; controller rearming may use a fresh neutral pad sample
+/// even while touch remains active.
+///
+/// Pair it with the exact `VpadState` updated by the same call and consume it
+/// immediately. A reset, cached/default state, no-sample result, busy poll, or
+/// terminal poll error cannot produce this marker.
+#[derive(Debug)]
+pub struct FreshVpadSample(());
+
+/// Convert WUT VPAD button positions and stick axes to Horizon's pad state.
+pub fn pad_state(sample: VpadSample) -> PadState {
+    let mut state = PadState {
+        left: [sample.left_x, sample.left_y],
+        right: [sample.right_x, sample.right_y],
+        triggers: [
+            if sample.buttons & 0x0080 != 0 {
+                1.0
+            } else {
+                0.0
+            },
+            if sample.buttons & 0x0040 != 0 {
+                1.0
+            } else {
+                0.0
+            },
+        ],
+        ..PadState::default()
+    };
+    // WUT's VPAD_BUTTON_* values; Horizon identifies face buttons by position.
+    for (mask, button) in [
+        (0x4000, Button::South), // B
+        (0x8000, Button::East),  // A
+        (0x1000, Button::West),  // Y
+        (0x2000, Button::North), // X
+        (0x0020, Button::LeftBumper),
+        (0x0010, Button::RightBumper),
+        (0x0004, Button::Select),
+        (0x0008, Button::Start),
+        (0x0004_0000, Button::LeftStick),
+        (0x0002_0000, Button::RightStick),
+        (0x0200, Button::DPadUp),
+        (0x0100, Button::DPadDown),
+        (0x0800, Button::DPadLeft),
+        (0x0400, Button::DPadRight),
+    ] {
+        state.set(button, sample.buttons & mask != 0);
+    }
+    state
+}
+
+/// Rebuild a queued button state while retaining the newest real poll's axes.
+pub fn pad_state_with_button_mask(latest: PadState, buttons: u32) -> PadState {
+    pad_state(VpadSample {
+        buttons,
+        left_x: latest.left[0],
+        left_y: latest.left[1],
+        right_x: latest.right[0],
+        right_y: latest.right[1],
+        ..Default::default()
+    })
+}
+
+/// Rearm a blocked controller only on a real neutral sample.
+pub fn rearm_on_fresh_neutral(blocked: &mut bool, fresh_sample: bool, pad: PadState) -> bool {
+    let neutral = pad.buttons == 0 && pad.triggers.iter().all(|value| *value == 0.0);
+    if *blocked && fresh_sample && neutral {
+        *blocked = false;
+        true
+    } else {
+        false
+    }
+}
+
+/// Retains the last state when VPAD has no new sample in a frame.
+///
+/// A missing or busy sample is not a release event: the last valid touch is
+/// retained until VPAD reports a new sample, the host resets state, or polling
+/// reports a terminal error. While contact remains active, invalid coordinates
+/// preserve the last valid point; a point is `None` until one has been observed.
+#[derive(Default)]
+pub struct VpadState {
+    pad: PadState,
+    touch_active: bool,
+    touch: Option<VpadTouch>,
+}
+
+impl VpadState {
+    pub fn update(&mut self, sample: Option<VpadSample>) -> PadState {
+        self.update_with_freshness(sample).0
+    }
+
+    /// Update state and return one-shot evidence when this call received a
+    /// fresh successful sample that reports physical release.
+    ///
+    /// Consume the returned marker immediately with this same state in
+    /// `TouchMapper::events_with_freshness`. Do not carry it across another
+    /// update, a reset, or a replacement `VpadState`.
+    pub fn update_with_freshness(
+        &mut self,
+        sample: Option<VpadSample>,
+    ) -> (PadState, Option<FreshTouchRelease>) {
+        let (pad, _fresh_sample, release) = self.update_with_evidence(sample);
+        (pad, release)
+    }
+
+    /// Update the cached VPAD state and return separate evidence for a real
+    /// successful hardware sample and for a fresh touchscreen release.
+    ///
+    /// The sample marker is present for every `Some(VpadSample)`, including
+    /// when the controller is neutral but the touchscreen is held. The touch
+    /// marker remains present only when that sample reports no touch contact.
+    pub fn update_with_evidence(
+        &mut self,
+        sample: Option<VpadSample>,
+    ) -> (PadState, Option<FreshVpadSample>, Option<FreshTouchRelease>) {
+        let mut release = None;
+        let fresh_sample = sample.map(|_| FreshVpadSample(()));
+        if let Some(sample) = sample {
+            self.pad = pad_state(sample);
+            self.touch_active = sample.touch_active != 0;
+            if !self.touch_active {
+                release = Some(FreshTouchRelease(()));
+                self.touch = None;
+            } else if sample.touch_valid != 0 && sample.touch_x < 1920 && sample.touch_y < 1080 {
+                self.touch = Some(VpadTouch {
+                    x: sample.touch_x,
+                    y: sample.touch_y,
+                });
+            }
+        }
+        (self.pad, fresh_sample, release)
+    }
+
+    /// Whether the latest VPAD sample reports physical contact.
+    ///
+    /// Retained when VPAD has no sample or is busy; cleared on a real release/reset.
+    pub fn touch_active(&self) -> bool {
+        self.touch_active
+    }
+
+    /// Last valid calibrated point; it can be stale while coordinates are invalid.
+    /// it is cleared only on physical release/reset. `None` means no point is known.
+    pub fn touch(&self) -> Option<VpadTouch> {
+        self.touch
+    }
+
+    /// Clear held controls when the host loses the controller.
+    pub fn reset(&mut self) -> PadState {
+        self.pad = PadState::default();
+        self.touch_active = false;
+        self.touch = None;
+        self.pad
+    }
+
+    /// Read VPAD channel 0. On a non-busy error the host must feed a neutral
+    /// state to Horizon; the cached state is cleared before returning the error.
+    #[cfg(all(feature = "cafe", target_arch = "powerpc"))]
+    pub fn poll(&mut self) -> Result<PadState, i32> {
+        self.poll_with_freshness().map(|(pad, _release)| pad)
+    }
+
+    /// Read VPAD once and return one-shot release evidence with the updated pad.
+    /// No-sample retains state and returns no marker; busy and terminal errors
+    /// retain the existing error API, and terminal errors still reset state.
+    ///
+    /// Consume a returned marker immediately with this same `VpadState` and
+    /// poll, before calling this method or `reset` again. `Err(-4)` (busy) and
+    /// any terminal error provide no release marker.
+    #[cfg(all(feature = "cafe", target_arch = "powerpc"))]
+    pub fn poll_with_freshness(&mut self) -> Result<(PadState, Option<FreshTouchRelease>), i32> {
+        self.poll_with_evidence()
+            .map(|poll| (poll.pad, poll.fresh_touch_release))
+    }
+
+    /// Read VPAD and return one-shot evidence for any newly read hardware
+    /// sample, independently of the touchscreen release marker. `Ok` with
+    /// `None` sample evidence means VPAD supplied no new sample; busy and
+    /// terminal errors return `Err` and also provide no evidence.
+    #[cfg(all(feature = "cafe", target_arch = "powerpc"))]
+    pub fn poll_with_evidence(&mut self) -> Result<VpadPoll, i32> {
+        extern "C" {
+            fn horizon_wiiu_vpad_read(batch: *mut VpadBatch) -> i32;
+        }
+        let mut batch = VpadBatch::default();
+        // The C bridge writes the sample only on success and owns VPADStatus's ABI.
+        match unsafe { horizon_wiiu_vpad_read(&mut batch) } {
+            1 => {
+                let (pad, fresh_sample, fresh_touch_release) =
+                    self.update_with_evidence(Some(batch.latest));
+                let button_history_len =
+                    (batch.transition_count as usize).min(VPAD_HISTORY_CAPACITY);
+                Ok(VpadPoll {
+                    pad,
+                    fresh_sample,
+                    fresh_touch_release,
+                    button_history: batch.transitions,
+                    button_history_len,
+                })
+            }
+            -1 => {
+                let (pad, fresh_sample, fresh_touch_release) = self.update_with_evidence(None);
+                Ok(VpadPoll {
+                    pad,
+                    fresh_sample,
+                    fresh_touch_release,
+                    button_history: [0; VPAD_HISTORY_CAPACITY],
+                    button_history_len: 0,
+                })
+            }
+            // A busy channel can be retried without releasing held controls or touch.
+            -4 => Err(-4),
+            error => {
+                self.reset();
+                Err(error)
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn maps_wii_u_controls_to_horizons_positional_pad() {
+        let state = pad_state(VpadSample {
+            buttons: 0x4000 | 0x8000 | 0x0020 | 0x0040 | 0x0200 | 0x0002_0000,
+            left_x: -0.5,
+            left_y: 0.75,
+            right_x: 0.25,
+            right_y: -1.0,
+            ..Default::default()
+        });
+        assert!(state.held(Button::South));
+        assert!(state.held(Button::East));
+        assert!(state.held(Button::LeftBumper));
+        assert!(state.held(Button::DPadUp));
+        assert!(state.held(Button::RightStick));
+        assert!(!state.held(Button::North));
+        assert_eq!(state.triggers, [0.0, 1.0]);
+        assert_eq!(state.left, [-0.5, 0.75]);
+        assert_eq!(state.right, [0.25, -1.0]);
+    }
+
+    #[test]
+    fn button_history_preserves_order_and_uses_latest_axes() {
+        let mut history = ButtonHistory::default();
+        assert!(history.push_poll(&[0x4000, 0, 0x4000, 0], false, true));
+        assert_eq!(history.pop_front(), Some(0x4000));
+        assert_eq!(history.pop_front(), Some(0));
+        assert_eq!(history.pop_front(), Some(0x4000));
+        assert_eq!(history.pop_front(), Some(0));
+        assert_eq!(history.pop_front(), None);
+
+        let latest = pad_state(VpadSample {
+            left_x: 0.5,
+            left_y: -0.25,
+            ..Default::default()
+        });
+        let replayed = pad_state_with_button_mask(latest, 0x4000);
+        assert!(replayed.held(Button::South));
+        assert_eq!(replayed.left, [0.5, -0.25]);
+    }
+
+    #[test]
+    fn button_history_fails_closed_on_overflow_and_clears_at_keyboard_or_focus_gates() {
+        let mut history = ButtonHistory::default();
+        assert!(history.push_poll(&[0x4000, 0], false, true));
+        let overflow = vec![0; BUTTON_HISTORY_QUEUE_CAPACITY];
+        assert!(!history.push_poll(&overflow, false, true));
+        assert_eq!(history.len(), 0);
+
+        assert!(history.push_poll(&[0x4000], false, true));
+        assert!(history.push_poll(&[0], true, true));
+        assert_eq!(history.len(), 0);
+        assert!(history.push_poll(&[0x4000], false, true));
+        assert!(history.push_poll(&[0], false, false));
+        assert_eq!(history.len(), 0);
+        assert!(history.push_poll(&[0], false, true));
+        assert_eq!(history.pop_front(), Some(0));
+    }
+
+    #[test]
+    fn replaying_button_history_does_not_create_fresh_sample_evidence() {
+        let mut history = ButtonHistory::default();
+        assert!(history.push_poll(&[0x4000, 0], false, true));
+        assert_eq!(history.pop_front(), Some(0x4000));
+        assert_eq!(history.pop_front(), Some(0));
+
+        let mut state = VpadState::default();
+        let (_, fresh_sample, fresh_release) = state.update_with_evidence(None);
+        assert!(fresh_sample.is_none());
+        assert!(fresh_release.is_none());
+    }
+
+    #[test]
+    fn overflow_neutralizes_immediately_and_rearms_only_on_fresh_neutral() {
+        let mut history = ButtonHistory::default();
+        assert!(history.push_poll(&[0x4000], false, true));
+        let overflow = vec![0; BUTTON_HISTORY_QUEUE_CAPACITY];
+        assert!(!history.push_poll(&overflow, false, true));
+        assert_eq!(history.pop_front(), None);
+
+        let mut blocked = true;
+        let held = pad_state(VpadSample {
+            buttons: 0x4000,
+            ..Default::default()
+        });
+        let neutral = PadState::default();
+
+        // The overflow caller dispatches PadState::default immediately; the
+        // gate remains blocked while this latest physical sample is held.
+        assert!(!rearm_on_fresh_neutral(&mut blocked, true, held));
+        assert!(blocked);
+        assert!(!rearm_on_fresh_neutral(&mut blocked, false, neutral));
+        assert!(blocked);
+        assert!(rearm_on_fresh_neutral(&mut blocked, true, neutral));
+        assert!(!blocked);
+    }
+
+    #[test]
+    fn no_new_sample_keeps_buttons_held_until_a_release_sample() {
+        let mut reader = VpadState::default();
+        assert!(reader
+            .update(Some(VpadSample {
+                buttons: 0x4000,
+                ..Default::default()
+            }))
+            .held(Button::South));
+        assert!(reader.update(None).held(Button::South));
+        assert!(!reader
+            .update(Some(VpadSample::default()))
+            .held(Button::South));
+    }
+
+    #[test]
+    fn reset_releases_a_previously_held_button() {
+        let mut reader = VpadState::default();
+        reader.update(Some(VpadSample {
+            buttons: 0x4000,
+            ..Default::default()
+        }));
+        assert!(!reader.reset().held(Button::South));
+        assert!(!reader.update(None).held(Button::South));
+    }
+
+    #[test]
+    fn calibrated_touch_is_retained_without_a_sample_and_cleared_on_release_or_reset() {
+        let mut reader = VpadState::default();
+        let contact = VpadSample {
+            touch_x: 1919,
+            touch_y: 1079,
+            touch_active: 1,
+            touch_valid: 1,
+            ..Default::default()
+        };
+        reader.update(Some(contact));
+        assert!(reader.touch_active());
+        assert_eq!(reader.touch(), Some(VpadTouch { x: 1919, y: 1079 }));
+        reader.update(None);
+        assert!(reader.touch_active());
+        assert_eq!(reader.touch(), Some(VpadTouch { x: 1919, y: 1079 }));
+        reader.update(Some(VpadSample::default()));
+        assert!(!reader.touch_active());
+        assert_eq!(reader.touch(), None);
+
+        reader.update(Some(contact));
+        reader.reset();
+        assert_eq!(reader.touch(), None);
+    }
+
+    #[test]
+    fn fresh_sample_evidence_is_independent_of_touch_release() {
+        let mut state = VpadState::default();
+        let contact = VpadSample {
+            buttons: 0,
+            touch_active: 1,
+            touch_valid: 0,
+            ..Default::default()
+        };
+        let (pad, fresh_sample, fresh_touch_release) = state.update_with_evidence(Some(contact));
+        assert_eq!(pad, PadState::default());
+        assert!(fresh_sample.is_some());
+        assert!(fresh_touch_release.is_none());
+
+        let (cached, no_sample, no_release) = state.update_with_evidence(None);
+        assert_eq!(cached, PadState::default());
+        assert!(no_sample.is_none());
+        assert!(no_release.is_none());
+        assert_eq!(state.reset(), PadState::default());
+        let (reset_state, no_reset_evidence, _) = state.update_with_evidence(None);
+        assert_eq!(reset_state, PadState::default());
+        assert!(no_reset_evidence.is_none());
+    }
+
+    #[test]
+    fn invalid_touch_coordinates_are_never_exposed() {
+        let mut reader = VpadState::default();
+        reader.update(Some(VpadSample {
+            touch_x: 500,
+            touch_y: 400,
+            touch_active: 1,
+            touch_valid: 0,
+            ..Default::default()
+        }));
+        assert!(reader.touch_active());
+        assert_eq!(reader.touch(), None);
+    }
+
+    #[test]
+    fn touch_coordinates_must_be_inside_the_calibrated_screen() {
+        let mut reader = VpadState::default();
+        for (x, y) in [(1920, 1079), (1919, 1080)] {
+            reader.update(Some(VpadSample {
+                touch_x: x,
+                touch_y: y,
+                touch_active: 1,
+                touch_valid: 1,
+                ..Default::default()
+            }));
+            assert!(reader.touch_active());
+            assert_eq!(
+                reader.touch(),
+                None,
+                "accepted out-of-range point ({x}, {y})"
+            );
+        }
+
+        reader.update(Some(VpadSample {
+            touch_x: 1919,
+            touch_y: 1079,
+            touch_active: 1,
+            touch_valid: 1,
+            ..Default::default()
+        }));
+        assert!(reader.touch_active());
+        assert_eq!(reader.touch(), Some(VpadTouch { x: 1919, y: 1079 }));
+    }
+
+    #[test]
+    fn invalid_coordinates_do_not_synthesize_release_between_valid_points() {
+        let mut reader = VpadState::default();
+        reader.update(Some(VpadSample {
+            touch_x: 100,
+            touch_y: 200,
+            touch_active: 1,
+            touch_valid: 1,
+            ..Default::default()
+        }));
+        reader.update(Some(VpadSample {
+            touch_active: 1,
+            touch_valid: 0,
+            ..Default::default()
+        }));
+        assert!(reader.touch_active());
+        assert_eq!(reader.touch(), Some(VpadTouch { x: 100, y: 200 }));
+
+        reader.update(Some(VpadSample {
+            touch_x: 300,
+            touch_y: 400,
+            touch_active: 1,
+            touch_valid: 1,
+            ..Default::default()
+        }));
+        assert!(reader.touch_active());
+        assert_eq!(reader.touch(), Some(VpadTouch { x: 300, y: 400 }));
+
+        reader.update(Some(VpadSample::default()));
+        assert!(!reader.touch_active());
+        assert_eq!(reader.touch(), None);
+    }
+}
