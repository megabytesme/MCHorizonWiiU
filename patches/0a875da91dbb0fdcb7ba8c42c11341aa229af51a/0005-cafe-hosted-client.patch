+//! Small path operations with platform-specific implementations where needed.
+use std::path::{Path, PathBuf};
+
+/// Returns a path's parent directory.
+///
+/// Cafe's `std::path::Components::next_back` currently stalls for the client options path, so
+/// derive its Unix-style parent from the UTF-8 path there. Other targets keep the standard
+/// library implementation.
+pub fn parent_dir(path: &Path) -> Option<PathBuf> {
+    #[cfg(target_os = "cafe")]
+    {
+        let path = path.to_str()?;
+        let end = parent_end(path.as_bytes())?;
+        Some(PathBuf::from(&path[..end]))
+    }
+    #[cfg(not(target_os = "cafe"))]
+    {
+        path.parent().map(Path::to_path_buf)
+    }
+}
+
+/// Returns a walked resource PNG's name relative to its root, without the `.png` suffix.
+///
+/// Cafe's `Path::strip_prefix` and `Path::with_extension` currently stall while
+/// decoding the walked asset tree. Those paths are constructed by joining entries
+/// below the same root, so Cafe can use their encoded bytes and enforce the root
+/// component boundary directly. Other targets keep the standard path operations.
+#[cfg(target_os = "cafe")]
+pub fn resource_png_name(path: &Path, root: &Path) -> Option<String> {
+    resource_png_name_bytes(
+        path.as_os_str().as_encoded_bytes(),
+        root.as_os_str().as_encoded_bytes(),
+    )
+}
+
+/// Appends `.mcmeta` to a walked lowercase `.png` resource path on Cafe.
+#[cfg(target_os = "cafe")]
+pub fn resource_png_mcmeta_path(path: &Path) -> Option<PathBuf> {
+    append_png_mcmeta(path)
+}
+
+#[cfg(any(target_os = "cafe", all(test, unix)))]
+fn append_png_mcmeta(path: &Path) -> Option<PathBuf> {
+    if !path.as_os_str().as_encoded_bytes().ends_with(b".png") {
+        return None;
+    }
+    let mut path = path.to_path_buf();
+    path.as_mut_os_string().push(".mcmeta");
+    Some(path)
+}
+
+#[cfg(any(target_os = "cafe", all(test, unix)))]
+fn resource_png_name_bytes(path: &[u8], root: &[u8]) -> Option<String> {
+    let mut root_len = root.len();
+    let absolute_root = root.starts_with(b"/");
+    let minimum_root_len = usize::from(absolute_root);
+    while root_len > minimum_root_len && root[root_len - 1] == b'/' {
+        root_len -= 1;
+    }
+    let root = &root[..root_len];
+    if root.is_empty() {
+        return None;
+    }
+    let mut relative = path.strip_prefix(root)?;
+    if root != b"/" && !relative.starts_with(b"/") {
+        return None;
+    }
+    while relative.starts_with(b"/") {
+        relative = &relative[1..];
+    }
+    let relative = relative.strip_suffix(b".png")?;
+    Some(String::from_utf8_lossy(relative).replace('\\', "/"))
+}
+
+#[cfg(any(target_os = "cafe", all(test, unix)))]
+fn parent_end(path: &[u8]) -> Option<usize> {
+    let root_len = usize::from(path.starts_with(b"/"));
+    let mut end = path.len();
+    while end > root_len && path[end - 1] == b'/' {
+        end -= 1;
+    }
+    if end == root_len {
+        return None;
+    }
+    let body = &path[root_len..end];
+    let mut parent_end = body
+        .iter()
+        .rposition(|byte| *byte == b'/')
+        .map_or(root_len, |separator| root_len + separator);
+    while parent_end > root_len && path[parent_end - 1] == b'/' {
+        parent_end -= 1;
+    }
+    Some(parent_end)
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::{append_png_mcmeta, parent_end, resource_png_name_bytes};
+    use std::{os::unix::ffi::OsStrExt, path::Path};
+
+    #[test]
+    fn unix_parent_bytes_match_standard_path_parents() {
+        let cases = [
+            "",
+            "/",
+            "///",
+            "/options.txt",
+            "/vol/external01/wiiu/apps/HorizonWiiU/options.txt",
+            "/vol/external01/wiiu/apps/HorizonWiiU/options.txt/",
+            "options.txt",
+            "./options.txt",
+            "../options.txt",
+            "dir//options.txt",
+            "dir/options.txt/",
+        ];
+
+        for path in cases {
+            let bytes = path.as_bytes();
+            let actual = parent_end(bytes).map(|end| &bytes[..end]);
+            let expected = Path::new(path)
+                .parent()
+                .map(|parent| parent.as_os_str().as_bytes());
+            assert_eq!(actual, expected, "parent for {path:?}");
+        }
+    }
+
+    #[test]
+    fn resource_png_name_matches_root_and_component_boundary() {
+        let root = b".local/horizon-client/26.3/assets/minecraft/textures";
+        assert_eq!(
+            resource_png_name_bytes(
+                b".local/horizon-client/26.3/assets/minecraft/textures/gui/panorama/panorama_0.png",
+                root,
+            ),
+            Some("gui/panorama/panorama_0".into())
+        );
+        assert_eq!(
+            resource_png_name_bytes(
+                b".local/horizon-client/26.3/assets/minecraft/textures-extra/a.png",
+                root
+            ),
+            None
+        );
+        assert_eq!(resource_png_name_bytes(root, root), None);
+        assert_eq!(
+            resource_png_name_bytes(b"root/ns/textures/gui/\xff.png", b"root"),
+            Some("ns/textures/gui/�".into())
+        );
+        assert_eq!(
+            resource_png_name_bytes(b"root/gui/foo.bar.png", b"root/"),
+            Some("gui/foo.bar".into())
+        );
+        let dotted = Path::new("root/gui/foo.bar.png");
+        let expected = dotted
+            .strip_prefix(Path::new("root/"))
+            .unwrap()
+            .with_extension("")
+            .to_string_lossy()
+            .replace('\\', "/");
+        assert_eq!(
+            resource_png_name_bytes(dotted.as_os_str().as_bytes(), b"root/"),
+            Some(expected)
+        );
+    }
+
+    #[test]
+    fn cafe_mcmeta_suffix_matches_with_extension_for_png_paths() {
+        for path in [
+            Path::new("root/foo.png"),
+            Path::new("root/foo.bar.png"),
+            Path::new("root/.hidden.png"),
+        ] {
+            let expected = path.with_extension("png.mcmeta");
+            assert_eq!(append_png_mcmeta(path), Some(expected));
+        }
+        assert_eq!(append_png_mcmeta(Path::new("root/foo.PNG")), None);
+
+        let path = Path::new(std::ffi::OsStr::from_bytes(b"root/\xff.png"));
+        let expected = path.with_extension("png.mcmeta");
+        let actual = append_png_mcmeta(path).unwrap();
+        assert_eq!(
+            actual.as_os_str().as_bytes(),
+            expected.as_os_str().as_bytes()
+        );
+    }
+}
diff --git a/crates/horizon-client-platform/src/resource_directory.rs b/crates/horizon-client-platform/src/resource_directory.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e1e23995d9408b366ed935b1b38a7ba69c94a6e1
--- /dev/null
+++ b/crates/horizon-client-platform/src/resource_directory.rs
@@ -0,0 +1,119 @@
+//! Short-lived, conservative directory snapshots for Cafe resource loading.
+
+use std::{
+    collections::{HashMap, HashSet},
+    path::{Path, PathBuf},
+};
+
+const MAX_DIRECTORIES: usize = 32;
+const MAX_DIRECTORY_NAMES: usize = 4096;
+const MAX_DIRECTORY_NAME_BYTES: usize = 256 * 1024;
+
+/// Avoid repeated filesystem lookups for names absent from a directory.
+///
+/// Create a new cache for each resource-loading pass. A `true` result means
+/// the caller must still check the file itself. Any directory read error,
+/// non-ASCII name, or oversized listing disables the shortcut for that
+/// directory. ASCII names are compared case-insensitively so that case
+/// differences can only cause an extra lookup, never a missed file.
+#[derive(Default)]
+pub struct DirectoryMissCache {
+    directories: HashMap<PathBuf, Option<HashSet<String>>>,
+}
+
+impl DirectoryMissCache {
+    /// Returns false only when this pass's directory snapshot lacks `path`.
+    pub fn may_exist(&mut self, path: &Path) -> bool {
+        let (Some(parent), Some(name)) = (path.parent(), path.file_name().and_then(|n| n.to_str()))
+        else {
+            return true;
+        };
+        if !name.is_ascii() {
+            return true;
+        }
+        if !self.directories.contains_key(parent) && self.directories.len() >= MAX_DIRECTORIES {
+            return true;
+        }
+        let names = self
+            .directories
+            .entry(parent.to_owned())
+            .or_insert_with(|| {
+                let entries = std::fs::read_dir(parent).ok()?;
+                let mut names = HashSet::new();
+                let mut bytes = 0usize;
+                for entry in entries {
+                    let name = entry.ok()?.file_name().into_string().ok()?;
+                    if !name.is_ascii() {
+                        return None;
+                    }
+                    bytes = bytes.checked_add(name.len())?;
+                    if bytes > MAX_DIRECTORY_NAME_BYTES || names.len() >= MAX_DIRECTORY_NAMES {
+                        return None;
+                    }
+                    names.insert(name.to_ascii_lowercase());
+                }
+                Some(names)
+            });
+        names
+            .as_ref()
+            .is_none_or(|names| names.contains(&name.to_ascii_lowercase()))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn missing_names_are_shortcut_only_with_a_safe_directory_snapshot() {
+        let root =
+            std::env::temp_dir().join(format!("horizon-resource-directory-{}", std::process::id()));
+        std::fs::create_dir(&root).unwrap();
+        std::fs::write(root.join("Stone_E.PNG"), b"overlay").unwrap();
+        let mut cache = DirectoryMissCache::default();
+        assert!(cache.may_exist(&root.join("Stone_E.PNG")));
+        assert!(cache.may_exist(&root.join("stone_e.png")));
+        assert!(!cache.may_exist(&root.join("missing_e.png")));
+        assert!(cache.may_exist(&root.join("missing-dir/overlay.png")));
+        assert!(cache.may_exist(&root.join("nonascii-\u{e9}.png")));
+
+        // A resource reload takes a fresh snapshot, so newly added pack files
+        // are considered on the next pass.
+        std::fs::write(root.join("added_e.png"), b"new overlay").unwrap();
+        assert!(DirectoryMissCache::default().may_exist(&root.join("added_e.png")));
+
+        let nonascii = root.join("nonascii");
+        std::fs::create_dir(&nonascii).unwrap();
+        std::fs::write(nonascii.join("\u{e9}.png"), b"pack").unwrap();
+        assert!(cache.may_exist(&nonascii.join("absent.png")));
+
+        std::fs::remove_file(root.join("Stone_E.PNG")).unwrap();
+        std::fs::remove_file(root.join("added_e.png")).unwrap();
+        std::fs::remove_file(nonascii.join("\u{e9}.png")).unwrap();
+        std::fs::remove_dir(nonascii).unwrap();
+        std::fs::remove_dir(root).unwrap();
+    }
+
+    #[test]
+    fn additional_directories_fall_back_when_the_cache_is_full() {
+        let root = std::env::temp_dir().join(format!(
+            "horizon-resource-directory-limit-{}",
+            std::process::id()
+        ));
+        std::fs::create_dir(&root).unwrap();
+        let mut cache = DirectoryMissCache::default();
+        for index in 0..MAX_DIRECTORIES {
+            let dir = root.join(index.to_string());
+            std::fs::create_dir(&dir).unwrap();
+            assert!(!cache.may_exist(&dir.join("absent.png")));
+        }
+        let overflow = root.join("overflow");
+        std::fs::create_dir(&overflow).unwrap();
+        assert!(cache.may_exist(&overflow.join("absent.png")));
+        std::fs::remove_dir(overflow).unwrap();
+        for index in 0..MAX_DIRECTORIES {
+            std::fs::remove_dir(root.join(index.to_string())).unwrap();
+        }
+        std::fs::remove_dir(root).unwrap();
+    }
+}
