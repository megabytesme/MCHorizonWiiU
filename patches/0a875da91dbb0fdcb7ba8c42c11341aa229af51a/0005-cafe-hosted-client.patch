diff --git a/wiiu/diagnostics/ppc_carry/README.md b/wiiu/diagnostics/ppc_carry/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..f8f76e2cb1d46a6a7b9dbf5513f6108a095e79d6
--- /dev/null
+++ b/wiiu/diagnostics/ppc_carry/README.md
@@ -0,0 +1,21 @@
+# PowerPC carry diagnostic
+
+This development probe compares a PowerPC carry-dependent ordering sequence with
+an independent branch-based control over one million calls and eight unsigned
+input pairs. It needs no game resources or SD card. A passing run reports
+`chain_first_bad=0` and `branch_first_bad=0` to OSReport and exits with code 0.
+Nonzero fields give the first failing call; `value` is the first chain result.
+
+With devkitPro, devkitPPC, WUT, and elf2rpl installed, build into a disposable
+directory with `DEVKITPRO=/opt/devkitpro DEVKITPPC=/opt/devkitpro/devkitPPC
+bash wiiu/diagnostics/ppc_carry/build.sh /tmp/horizon-ppc-carry`. The script
+refuses to overwrite either output file; choose a fresh directory for each build.
+Run the RPX in Cemu and inspect its log. Check the active CPU mode and whether the recompiler
+initialized; use the same RPX for each comparison.
+
+On the tested stock Cemu 2.6 build, the interpreter (profile CPU mode 0) passed;
+recompiler profile modes 1 and 3 returned an incorrect chain result after
+warmup while the branch control passed. The failing call count varies. These
+are observations for that emulator build, not a claim about every Cemu release
+or physical Wii U hardware. This diagnostic does not fix the emulator or prove
+that the game is otherwise compatible.
diff --git a/wiiu/diagnostics/ppc_carry/build.sh b/wiiu/diagnostics/ppc_carry/build.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5e8da09f5a47fb4757761a8d234e969656f6f27b
--- /dev/null
+++ b/wiiu/diagnostics/ppc_carry/build.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [ "$#" -ne 1 ]; then
+   echo "Usage: $0 OUTPUT_DIRECTORY" >&2
+   exit 2
+fi
+: "${DEVKITPRO:?Set DEVKITPRO to your devkitPro installation}"
+: "${DEVKITPPC:?Set DEVKITPPC to your devkitPPC installation}"
+src=$(cd "$(dirname "$0")" && pwd)
+mkdir -p "$1"
+out=$(cd "$1" && pwd)
+if [ -e "$out/ppc_carry.elf" ] || [ -L "$out/ppc_carry.elf" ] ||
+   [ -e "$out/ppc_carry.rpx" ] || [ -L "$out/ppc_carry.rpx" ]; then
+   echo "Output already exists in $out; choose a fresh directory" >&2
+   exit 1
+fi
+"$DEVKITPPC/bin/powerpc-eabi-gcc" -O2 -mcpu=750 -meabi -mhard-float \
+   -I"$DEVKITPRO/wut/include" -specs="$DEVKITPRO/wut/share/wut.specs" \
+   "$src/main.c" -L"$DEVKITPRO/wut/lib" -lwut -o "$out/ppc_carry.elf"
+"$DEVKITPRO/tools/bin/elf2rpl" "$out/ppc_carry.elf" "$out/ppc_carry.rpx"
diff --git a/wiiu/diagnostics/ppc_carry/main.c b/wiiu/diagnostics/ppc_carry/main.c
new file mode 100644
index 0000000000000000000000000000000000000000..3f85f820c17c8f82004cc93d8dbdd990325d624d
--- /dev/null
+++ b/wiiu/diagnostics/ppc_carry/main.c
@@ -0,0 +1,56 @@
+#include <coreinit/debug.h>
+#include <stdint.h>
+#include <whb/proc.h>
+
+// This is the sequence emitted by the Cafe toolchain for an unsigned ordering.
+__attribute__((noinline)) static int32_t carry_order(uint32_t a, uint32_t b) {
+   uint32_t x, y;
+   __asm__ volatile("subfc %0,%2,%3\n\t"
+                    "subf %1,%3,%2\n\t"
+                    "subfe %0,%3,%2\n\t"
+                    "subfe %0,%0,%1"
+                    : "=&r"(x), "=&r"(y) : "r"(a), "r"(b) : "xer");
+   return (int32_t)x;
+}
+
+// Independent control with no carry dependency.
+__attribute__((noinline)) static int32_t branch_order(uint32_t a, uint32_t b) {
+   int32_t result;
+   __asm__ volatile("cmplw %1,%2\n\t"
+                    "blt 1f\n\t"
+                    "bgt 2f\n\t"
+                    "li %0,0\n\t"
+                    "b 3f\n"
+                    "1: li %0,-1\n\t"
+                    "b 3f\n"
+                    "2: li %0,1\n"
+                    "3:"
+                    : "=&r"(result) : "r"(a), "r"(b) : "cr0");
+   return result;
+}
+
+int main(void) {
+   static const uint32_t pairs[][2] = {
+      {105, 112}, {112, 105}, {105, 105}, {0, 1},
+      {1, 0}, {0, UINT32_MAX}, {UINT32_MAX, 0}, {UINT32_MAX, UINT32_MAX},
+   };
+   static const int32_t expected[] = {-1, 1, 0, -1, 1, -1, 1, 0};
+   uint32_t first_carry = 0, first_branch = 0;
+   int32_t first_value = 0;
+
+   WHBProcInit();
+   for (uint32_t i = 1; i <= 1000000; ++i) {
+      unsigned j = i % 8;
+      int32_t carry = carry_order(pairs[j][0], pairs[j][1]);
+      int32_t branch = branch_order(pairs[j][0], pairs[j][1]);
+      if (carry != expected[j] && !first_carry) {
+         first_carry = i;
+         first_value = carry;
+      }
+      if (branch != expected[j] && !first_branch) first_branch = i;
+   }
+   OSReport("CARRY_MINIMAL calls=1000000 chain_first_bad=%u value=%d branch_first_bad=%u\n",
+            first_carry, first_value, first_branch);
+   WHBProcShutdown();
+   return first_carry || first_branch ? 1 : 0;
+}
