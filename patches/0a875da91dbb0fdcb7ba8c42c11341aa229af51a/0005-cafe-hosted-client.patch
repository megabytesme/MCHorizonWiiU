diff --git a/wiiu/security/src/format.rs b/wiiu/security/src/format.rs
new file mode 100644
index 0000000000000000000000000000000000000000..76d944e872ab270c7cf2a166c4730bb3060b908a
--- /dev/null
+++ b/wiiu/security/src/format.rs
@@ -0,0 +1,253 @@
+use std::collections::BTreeMap;
+
+use argon2::{Algorithm, Argon2, Block, Params, Version};
+use chacha20poly1305::{aead::AeadInPlace, KeyInit, XChaCha20Poly1305};
+use sha2::{Digest, Sha256};
+use zeroize::Zeroizing;
+
+use crate::{Secret, StorageMode, VaultError};
+
+const MAGIC: &[u8; 8] = b"HWVAULT\0";
+const VERSION: u8 = 1;
+const HEADER_LEN: usize = 70;
+const DIGEST_LEN: usize = 32;
+const TAG_LEN: usize = 16;
+pub(crate) const MAX_PAYLOAD: usize = 128 * 1024;
+pub(crate) const MAX_FILE: usize = HEADER_LEN + MAX_PAYLOAD + TAG_LEN + DIGEST_LEN;
+const MAX_SECRET: usize = 64 * 1024;
+pub(crate) const MEMORY_KIB: u32 = 19 * 1024;
+const PASSES: u32 = 2;
+const LANES: u32 = 1;
+
+pub(crate) type Key = Zeroizing<[u8; 32]>;
+pub(crate) type Entries = BTreeMap<String, Secret>;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) struct Policy {
+    pub(crate) mode: StorageMode,
+    pub(crate) salt: [u8; 16],
+}
+
+impl Policy {
+    pub(crate) fn new(mode: StorageMode) -> Result<Self, VaultError> {
+        let mut salt = [0; 16];
+        if mode == StorageMode::PinProtected {
+            random(&mut salt)?;
+        }
+        Ok(Self { mode, salt })
+    }
+
+    pub(crate) fn key(self, pin: &[u8]) -> Result<Key, VaultError> {
+        let mut key = Zeroizing::new([0; 32]);
+        let mut blocks = Zeroizing::new(Vec::new());
+        blocks
+            .try_reserve_exact(MEMORY_KIB as usize)
+            .map_err(|_| VaultError::StorageUnavailable)?;
+        blocks.resize(MEMORY_KIB as usize, Block::default());
+        let params = Params::new(MEMORY_KIB, PASSES, LANES, Some(key.len()))
+            .map_err(|_| VaultError::UnsupportedFormat)?;
+        Argon2::new(Algorithm::Argon2id, Version::V0x13, params)
+            .hash_password_into_with_memory(pin, &self.salt, &mut *key, &mut *blocks)
+            .map_err(|_| VaultError::AuthenticationFailed)?;
+        Ok(key)
+    }
+}
+
+fn random(output: &mut [u8]) -> Result<(), VaultError> {
+    getrandom::fill(output).map_err(|_| VaultError::EntropyUnavailable)
+}
+
+pub(crate) struct Record {
+    pub(crate) generation: u64,
+    pub(crate) policy: Policy,
+    bytes: Zeroizing<Vec<u8>>,
+}
+
+impl Record {
+    pub(crate) fn parse(bytes: Zeroizing<Vec<u8>>, domain: &str) -> Result<Self, VaultError> {
+        if bytes.len() < HEADER_LEN + DIGEST_LEN + 2
+            || bytes.len() > MAX_FILE
+            || &bytes[..8] != MAGIC
+        {
+            return Err(VaultError::Corrupt);
+        }
+        let end = bytes.len() - DIGEST_LEN;
+        if checksum(domain, &bytes[..end]).as_slice() != &bytes[end..] {
+            return Err(VaultError::Corrupt);
+        }
+        if bytes[8] != VERSION {
+            return Err(VaultError::UnsupportedFormat);
+        }
+        let mode = match bytes[9] {
+            0 => StorageMode::PinProtected,
+            1 => StorageMode::Unprotected,
+            2 => StorageMode::SessionOnly,
+            _ => return Err(VaultError::UnsupportedFormat),
+        };
+        let generation = u64::from_be_bytes(bytes[10..18].try_into().unwrap());
+        if generation == 0 {
+            return Err(VaultError::Corrupt);
+        }
+        let salt = bytes[30..46].try_into().unwrap();
+        if mode == StorageMode::PinProtected {
+            if bytes[18..22] != MEMORY_KIB.to_be_bytes()
+                || bytes[22..26] != PASSES.to_be_bytes()
+                || bytes[26..30] != LANES.to_be_bytes()
+            {
+                return Err(VaultError::UnsupportedFormat);
+            }
+            if end < HEADER_LEN + TAG_LEN + 2 {
+                return Err(VaultError::Corrupt);
+            }
+        } else if bytes[18..HEADER_LEN].iter().any(|&byte| byte != 0) {
+            return Err(VaultError::Corrupt);
+        }
+        Ok(Self {
+            generation,
+            policy: Policy { mode, salt },
+            bytes,
+        })
+    }
+
+    pub(crate) fn decode(&self, domain: &str, key: Option<&Key>) -> Result<Entries, VaultError> {
+        let end = self.bytes.len() - DIGEST_LEN;
+        let mut payload = Zeroizing::new(self.bytes[HEADER_LEN..end].to_vec());
+        if self.policy.mode == StorageMode::PinProtected {
+            let key = key.ok_or(VaultError::Locked)?;
+            let tag = end - HEADER_LEN - TAG_LEN;
+            let (body, auth_tag) = payload.split_at_mut(tag);
+            XChaCha20Poly1305::new((&**key).into())
+                .decrypt_in_place_detached(
+                    self.bytes[46..HEADER_LEN].into(),
+                    &associated(domain, &self.bytes[..HEADER_LEN]),
+                    body,
+                    (&*auth_tag).into(),
+                )
+                .map_err(|_| VaultError::AuthenticationFailed)?;
+            payload.truncate(tag);
+        }
+        let entries = decode_entries(&payload)?;
+        if self.policy.mode == StorageMode::SessionOnly && !entries.is_empty() {
+            return Err(VaultError::Corrupt);
+        }
+        Ok(entries)
+    }
+}
+
+pub(crate) fn encode(
+    domain: &str,
+    generation: u64,
+    policy: Policy,
+    key: Option<&Key>,
+    entries: &Entries,
+) -> Result<Zeroizing<Vec<u8>>, VaultError> {
+    let mut payload = encode_entries(entries)?;
+    let mut bytes = Zeroizing::new(Vec::with_capacity(
+        HEADER_LEN + payload.len() + TAG_LEN + DIGEST_LEN,
+    ));
+    bytes.extend_from_slice(MAGIC);
+    bytes.push(VERSION);
+    bytes.push(match policy.mode {
+        StorageMode::PinProtected => 0,
+        StorageMode::Unprotected => 1,
+        StorageMode::SessionOnly => 2,
+    });
+    bytes.extend_from_slice(&generation.to_be_bytes());
+    if policy.mode == StorageMode::PinProtected {
+        let mut nonce = [0; 24];
+        random(&mut nonce)?;
+        bytes.extend_from_slice(&MEMORY_KIB.to_be_bytes());
+        bytes.extend_from_slice(&PASSES.to_be_bytes());
+        bytes.extend_from_slice(&LANES.to_be_bytes());
+        bytes.extend_from_slice(&policy.salt);
+        bytes.extend_from_slice(&nonce);
+        let key = key.ok_or(VaultError::Locked)?;
+        let tag = XChaCha20Poly1305::new((&**key).into())
+            .encrypt_in_place_detached((&nonce).into(), &associated(domain, &bytes), &mut payload)
+            .map_err(|_| VaultError::TooLarge)?;
+        bytes.extend_from_slice(&payload);
+        bytes.extend_from_slice(&tag);
+    } else {
+        bytes.resize(HEADER_LEN, 0);
+        bytes.extend_from_slice(&payload);
+    }
+    let digest = checksum(domain, &bytes);
+    bytes.extend_from_slice(&digest);
+    Ok(bytes)
+}
+
+fn associated(domain: &str, header: &[u8]) -> Vec<u8> {
+    [domain.as_bytes(), &[0], header].concat()
+}
+
+fn checksum(domain: &str, bytes: &[u8]) -> [u8; DIGEST_LEN] {
+    let mut digest = Sha256::new();
+    digest.update(domain.as_bytes());
+    digest.update([0]);
+    digest.update(bytes);
+    digest.finalize().into()
+}
+
+pub(crate) fn valid_name(name: &str) -> bool {
+    (1..=64).contains(&name.len())
+        && name
+            .bytes()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == b'_')
+}
+
+fn encode_entries(entries: &Entries) -> Result<Zeroizing<Vec<u8>>, VaultError> {
+    let mut len = 2;
+    for (name, value) in entries {
+        let size = value.expose().len();
+        if size > MAX_SECRET {
+            return Err(VaultError::TooLarge);
+        }
+        len += 1 + name.len() + 4 + size;
+        if len > MAX_PAYLOAD {
+            return Err(VaultError::TooLarge);
+        }
+    }
+    let count = u16::try_from(entries.len()).map_err(|_| VaultError::TooLarge)?;
+    let mut bytes = Zeroizing::new(Vec::with_capacity(len));
+    bytes.extend_from_slice(&count.to_be_bytes());
+    for (name, value) in entries {
+        bytes.push(name.len() as u8);
+        bytes.extend_from_slice(name.as_bytes());
+        bytes.extend_from_slice(&(value.expose().len() as u32).to_be_bytes());
+        bytes.extend_from_slice(value.expose());
+    }
+    Ok(bytes)
+}
+
+fn decode_entries(mut payload: &[u8]) -> Result<Entries, VaultError> {
+    fn take<'a>(bytes: &mut &'a [u8], len: usize) -> Result<&'a [u8], VaultError> {
+        let (head, tail) = bytes.split_at_checked(len).ok_or(VaultError::Corrupt)?;
+        *bytes = tail;
+        Ok(head)
+    }
+
+    if payload.len() > MAX_PAYLOAD {
+        return Err(VaultError::Corrupt);
+    }
+    let count = u16::from_be_bytes(take(&mut payload, 2)?.try_into().unwrap());
+    let mut entries = Entries::new();
+    for _ in 0..count {
+        let len = take(&mut payload, 1)?[0] as usize;
+        let name = std::str::from_utf8(take(&mut payload, len)?)
+            .ok()
+            .filter(|name| valid_name(name))
+            .ok_or(VaultError::Corrupt)?;
+        let len = u32::from_be_bytes(take(&mut payload, 4)?.try_into().unwrap()) as usize;
+        if len > MAX_SECRET || entries.contains_key(name) {
+            return Err(VaultError::Corrupt);
+        }
+        entries.insert(
+            name.to_owned(),
+            Secret::new(take(&mut payload, len)?.to_vec()),
+        );
+    }
+    if !payload.is_empty() {
+        return Err(VaultError::Corrupt);
+    }
+    Ok(entries)
+}
diff --git a/wiiu/security/src/lib.rs b/wiiu/security/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6374d68bbad5679bfadc7e0c7fbe4f6bff7cfbbe
--- /dev/null
+++ b/wiiu/security/src/lib.rs
@@ -0,0 +1,105 @@
+//! Local and application-owned credential storage for Horizon Night.
+
+use std::fmt;
+
+use zeroize::Zeroizing;
+
+mod format;
+mod vault;
+
+pub use vault::Vault;
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub enum StorageMode {
+    #[default]
+    PinProtected,
+    Unprotected,
+    SessionOnly,
+}
+
+/// The UI must obtain explicit consent before constructing this variant for
+/// either first-time setup or a change from PIN protection.
+pub enum Protection<'a> {
+    PinProtected { new_pin: &'a [u8] },
+    ConfirmedUnprotected,
+    SessionOnly,
+}
+
+/// Owned opaque bytes. The Debug representation is safe to report.
+pub struct Secret(Zeroizing<Vec<u8>>);
+
+impl Secret {
+    pub fn new(bytes: Vec<u8>) -> Self {
+        Self(Zeroizing::new(bytes))
+    }
+
+    pub fn expose(&self) -> &[u8] {
+        &self.0
+    }
+}
+
+impl fmt::Debug for Secret {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("Secret([redacted])")
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct StorageStatus {
+    pub mode: StorageMode,
+    pub initialized: bool,
+    pub locked: bool,
+    /// The current generation is usable. An older or interrupted write
+    /// could not be cleaned up and may still be present on the SD card.
+    pub cleanup_pending: bool,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum VaultError {
+    SetupRequired,
+    Locked,
+    InvalidPinLength,
+    /// Wrong PIN, or authenticated data that could not be verified.
+    AuthenticationFailed,
+    Corrupt,
+    UnsupportedFormat,
+    InvalidName,
+    TooLarge,
+    EntropyUnavailable,
+    StorageUnavailable,
+}
+
+impl fmt::Display for VaultError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(match self {
+            Self::SetupRequired => "Choose how to store credentials first.",
+            Self::Locked => "Unlock this vault locally first.",
+            Self::InvalidPinLength => "Use a PIN or passphrase of 6 to 128 bytes.",
+            Self::AuthenticationFailed => "The PIN or protected vault could not be verified.",
+            Self::Corrupt => "The stored vault is damaged.",
+            Self::UnsupportedFormat => {
+                "This vault format requires a different application version."
+            }
+            Self::InvalidName => "Invalid vault or credential identifier.",
+            Self::TooLarge => "This credential exceeds the vault size limit.",
+            Self::EntropyUnavailable => "Secure randomness is unavailable.",
+            Self::StorageUnavailable => "The vault could not access application storage.",
+        })
+    }
+}
+
+impl std::error::Error for VaultError {}
+
+/// One store controls one PIN domain. The app prompts locally upon Locked.
+/// Services never receive the PIN or a handle for another service's domain.
+pub trait SecretStore {
+    fn status(&self) -> StorageStatus;
+    fn unlock(&mut self, pin: &[u8]) -> Result<(), VaultError>;
+    fn lock(&mut self);
+    fn get(&mut self, name: &str) -> Result<Option<Secret>, VaultError>;
+    fn put(&mut self, name: &str, secret: Secret) -> Result<(), VaultError>;
+    fn remove(&mut self, name: &str) -> Result<(), VaultError>;
+    /// Initialize a new vault or migrate an unlocked vault. To change the
+    /// PIN, unlock first and pass the replacement PIN as the new protection.
+    fn set_protection(&mut self, protection: Protection<'_>) -> Result<(), VaultError>;
+}
diff --git a/wiiu/security/src/vault.rs b/wiiu/security/src/vault.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3fa799e776e29124eaa4d071617c7ced68790a8b
--- /dev/null
+++ b/wiiu/security/src/vault.rs
@@ -0,0 +1,362 @@
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, Read, Write};
+use std::path::{Path, PathBuf};
+
+use zeroize::Zeroizing;
+
+use crate::format::{self, Entries, Key, Policy, Record};
+use crate::{Protection, Secret, SecretStore, StorageMode, StorageStatus, VaultError};
+
+const SLOTS: [&str; 2] = ["vault.0", "vault.1"];
+const STAGED: &str = "vault.pending";
+
+pub struct Vault {
+    domain: String,
+    directory: PathBuf,
+    policy: Option<Policy>,
+    active: Option<(usize, u64)>,
+    key: Option<Key>,
+    entries: Option<Entries>,
+    cleanup_pending: bool,
+}
+
+impl Vault {
+    /// Open a single domain relative to the application's private directory.
+    /// Components are lowercase ASCII identifiers, for example "mcp" or
+    /// "microsoft/0123456789abcdef0123456789abcdef". All components also bind
+    /// the protected record to the caller's domain cryptographically.
+    pub fn open(private_directory: &Path, domain: &str) -> Result<Self, VaultError> {
+        if domain.len() > 192 || !domain.split('/').all(format::valid_name) {
+            return Err(VaultError::InvalidName);
+        }
+        let directory = private_directory.join(domain);
+        let active = read_active(&directory, domain)?;
+        let (active, policy, entries) = if let Some((slot, record)) = active {
+            let policy = record.policy;
+            let entries = if policy.mode == StorageMode::PinProtected {
+                None
+            } else {
+                Some(record.decode(domain, None)?)
+            };
+            (Some((slot, record.generation)), Some(policy), entries)
+        } else {
+            (None, None, None)
+        };
+        let mut vault = Self {
+            domain: domain.to_owned(),
+            directory,
+            policy,
+            active,
+            key: None,
+            entries,
+            cleanup_pending: false,
+        };
+        // Do not retire a protected predecessor until the selected record
+        // has authenticated successfully in this process.
+        if vault.status().locked {
+            vault.cleanup_pending = vault.has_pending();
+        } else {
+            vault.retire();
+        }
+        Ok(vault)
+    }
+
+    fn has_pending(&self) -> bool {
+        let stale = self.active.map(|(slot, _)| SLOTS[slot ^ 1]);
+        [Some(STAGED), stale].into_iter().flatten().any(|name| {
+            match fs::metadata(self.directory.join(name)) {
+                Ok(_) => true,
+                Err(err) => err.kind() != io::ErrorKind::NotFound,
+            }
+        })
+    }
+
+    fn retire(&mut self) {
+        self.cleanup_pending = self.has_pending();
+        if !self.cleanup_pending || !sync_directory(&self.directory) {
+            return;
+        }
+        let staged = remove_if_present(&self.directory.join(STAGED));
+        let stale = self
+            .active
+            .map(|(slot, _)| remove_if_present(&self.directory.join(SLOTS[slot ^ 1])));
+        self.cleanup_pending = !sync_directory(&self.directory)
+            || staged.is_err()
+            || stale.is_some_and(|result| result.is_err());
+    }
+
+    fn on_disk(&self) -> Result<Option<Record>, VaultError> {
+        let disk = read_active(&self.directory, &self.domain)?;
+        if disk.as_ref().map(|(slot, r)| (*slot, r.generation)) != self.active
+            || disk
+                .as_ref()
+                .is_some_and(|(_, r)| self.policy != Some(r.policy))
+        {
+            return Err(VaultError::StorageUnavailable);
+        }
+        Ok(disk.map(|(_, record)| record))
+    }
+
+    fn ready(&mut self) -> Result<(), VaultError> {
+        match self.policy.ok_or(VaultError::SetupRequired)?.mode {
+            StorageMode::PinProtected if self.key.is_none() => Err(VaultError::Locked),
+            StorageMode::Unprotected if self.entries.is_none() => {
+                let record = self.on_disk()?.ok_or(VaultError::StorageUnavailable)?;
+                self.entries = Some(record.decode(&self.domain, None)?);
+                Ok(())
+            }
+            _ => Ok(()),
+        }
+    }
+
+    fn commit(&mut self, policy: Policy, replacement_key: Option<&Key>) -> Result<(), VaultError> {
+        // Validate the committed source before taking a step that changes it.
+        if let Some(record) = self.on_disk()? {
+            record.decode(&self.domain, self.key.as_ref())?;
+        }
+        self.write_generation(policy, replacement_key)
+    }
+
+    /// Forget every credential in this domain after explicit local consent.
+    /// This also works on a locked domain. It never reads back its contents.
+    /// Consumers sharing a domain should remove their individual entries instead.
+    pub fn erase_domain(&mut self) -> Result<(), VaultError> {
+        self.on_disk()?;
+        let empty = Policy::new(StorageMode::SessionOnly)?;
+        self.write_generation(empty, None)?;
+        self.policy = Some(empty);
+        self.lock();
+        Ok(())
+    }
+
+    fn write_generation(
+        &mut self,
+        policy: Policy,
+        replacement_key: Option<&Key>,
+    ) -> Result<(), VaultError> {
+        if policy.mode == StorageMode::SessionOnly && self.active.is_none() {
+            return Ok(());
+        }
+
+        let (next_slot, generation) = match self.active {
+            Some((slot, generation)) => (
+                slot ^ 1,
+                generation.checked_add(1).ok_or(VaultError::TooLarge)?,
+            ),
+            None => (0, 1),
+        };
+        let empty = Entries::new();
+        let entries = if policy.mode == StorageMode::SessionOnly {
+            &empty
+        } else {
+            self.entries.as_ref().unwrap_or(&empty)
+        };
+        let key = replacement_key.or(self.key.as_ref());
+        let bytes = format::encode(&self.domain, generation, policy, key, entries)?;
+        let dest = self.directory.join(SLOTS[next_slot]);
+        let staged = self.directory.join(STAGED);
+
+        let stage_and_commit = || -> Result<(), VaultError> {
+            fs::create_dir_all(&self.directory).map_err(storage_error)?;
+            remove_if_present(&staged).map_err(storage_error)?;
+            // Free the inactive slot while the active generation still exists.
+            // Cafe FS refuses renaming over an existing destination.
+            remove_if_present(&dest).map_err(storage_error)?;
+            let mut file = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&staged)
+                .map_err(storage_error)?;
+            file.write_all(&bytes).map_err(storage_error)?;
+            file.sync_all().map_err(storage_error)?;
+            drop(file);
+            let staged_record =
+                read_slot(&staged, &self.domain)?.ok_or(VaultError::StorageUnavailable)?;
+            if staged_record.generation != generation || staged_record.policy != policy {
+                return Err(VaultError::Corrupt);
+            }
+            let verified = staged_record.decode(&self.domain, key)?;
+            if verified.len() != entries.len()
+                || verified.iter().any(|(name, value)| {
+                    entries.get(name).map(Secret::expose) != Some(value.expose())
+                })
+            {
+                return Err(VaultError::Corrupt);
+            }
+            fs::rename(&staged, &dest).map_err(storage_error)
+        };
+
+        if let Err(err) = stage_and_commit() {
+            self.retire();
+            return Err(err);
+        }
+        self.active = Some((next_slot, generation));
+        if !sync_directory(&self.directory) {
+            self.cleanup_pending = true;
+            return Ok(());
+        }
+        self.retire();
+        Ok(())
+    }
+
+    fn update(&mut self, name: &str, value: Option<Secret>) -> Result<(), VaultError> {
+        if !format::valid_name(name) {
+            return Err(VaultError::InvalidName);
+        }
+        self.ready()?;
+        let entries = self.entries.get_or_insert_with(Entries::new);
+        let old = match value {
+            Some(value) => entries.insert(name.to_owned(), value),
+            None => {
+                let Some(old) = entries.remove(name) else {
+                    self.retire();
+                    return Ok(());
+                };
+                Some(old)
+            }
+        };
+        let policy = self.policy.ok_or(VaultError::SetupRequired)?;
+        if policy.mode != StorageMode::SessionOnly {
+            if let Err(err) = self.commit(policy, None) {
+                let entries = self.entries.as_mut().unwrap();
+                match old {
+                    Some(value) => entries.insert(name.to_owned(), value),
+                    None => entries.remove(name),
+                };
+                return Err(err);
+            }
+        }
+        Ok(())
+    }
+}
+
+impl SecretStore for Vault {
+    fn status(&self) -> StorageStatus {
+        StorageStatus {
+            mode: self.policy.map_or(StorageMode::PinProtected, |p| p.mode),
+            initialized: self.policy.is_some(),
+            locked: self
+                .policy
+                .is_some_and(|p| p.mode == StorageMode::PinProtected)
+                && self.key.is_none(),
+            cleanup_pending: self.cleanup_pending,
+        }
+    }
+
+    fn unlock(&mut self, pin: &[u8]) -> Result<(), VaultError> {
+        let policy = self.policy.ok_or(VaultError::SetupRequired)?;
+        if policy.mode != StorageMode::PinProtected || self.key.is_some() {
+            return Ok(());
+        }
+        if !(6..=128).contains(&pin.len()) {
+            return Err(VaultError::AuthenticationFailed);
+        }
+        let record = self.on_disk()?.ok_or(VaultError::StorageUnavailable)?;
+        let key = policy.key(pin)?;
+        let entries = record.decode(&self.domain, Some(&key))?;
+        self.entries = Some(entries);
+        self.key = Some(key);
+        self.retire();
+        Ok(())
+    }
+
+    fn lock(&mut self) {
+        self.key = None;
+        self.entries = None;
+    }
+
+    fn get(&mut self, name: &str) -> Result<Option<Secret>, VaultError> {
+        if !format::valid_name(name) {
+            return Err(VaultError::InvalidName);
+        }
+        self.ready()?;
+        Ok(self
+            .entries
+            .as_ref()
+            .and_then(|entries| entries.get(name))
+            .map(|value| Secret::new(value.expose().to_vec())))
+    }
+
+    fn put(&mut self, name: &str, secret: Secret) -> Result<(), VaultError> {
+        self.update(name, Some(secret))
+    }
+
+    fn remove(&mut self, name: &str) -> Result<(), VaultError> {
+        self.update(name, None)
+    }
+
+    fn set_protection(&mut self, protection: Protection<'_>) -> Result<(), VaultError> {
+        if self.policy.is_some() {
+            self.ready()?;
+        }
+        let (policy, key) = match protection {
+            Protection::PinProtected { new_pin } => {
+                if !(6..=128).contains(&new_pin.len()) {
+                    return Err(VaultError::InvalidPinLength);
+                }
+                let policy = Policy::new(StorageMode::PinProtected)?;
+                (policy, Some(policy.key(new_pin)?))
+            }
+            Protection::ConfirmedUnprotected => (Policy::new(StorageMode::Unprotected)?, None),
+            Protection::SessionOnly => (Policy::new(StorageMode::SessionOnly)?, None),
+        };
+        self.commit(policy, key.as_ref())?;
+        self.policy = Some(policy);
+        self.key = key;
+        Ok(())
+    }
+}
+
+fn read_active(directory: &Path, domain: &str) -> Result<Option<(usize, Record)>, VaultError> {
+    let a = read_slot(&directory.join(SLOTS[0]), domain)?;
+    let b = read_slot(&directory.join(SLOTS[1]), domain)?;
+    match (a, b) {
+        (None, None) => Ok(None),
+        (Some(a), None) => Ok(Some((0, a))),
+        (None, Some(b)) => Ok(Some((1, b))),
+        (Some(a), Some(b)) if a.generation.checked_add(1) == Some(b.generation) => Ok(Some((1, b))),
+        (Some(a), Some(b)) if b.generation.checked_add(1) == Some(a.generation) => Ok(Some((0, a))),
+        _ => Err(VaultError::Corrupt),
+    }
+}
+
+fn read_slot(path: &Path, domain: &str) -> Result<Option<Record>, VaultError> {
+    let file = match File::open(path) {
+        Ok(file) => file,
+        Err(err) if err.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(err) => return Err(storage_error(err)),
+    };
+    // Allocate once so plaintext read from unprotected slots is not left
+    // behind in buffers freed during growth.
+    let mut bytes = Zeroizing::new(Vec::with_capacity(format::MAX_FILE + 1));
+    file.take((format::MAX_FILE + 1) as u64)
+        .read_to_end(&mut bytes)
+        .map_err(storage_error)?;
+    Record::parse(bytes, domain).map(Some)
+}
+
+fn storage_error(_: io::Error) -> VaultError {
+    VaultError::StorageUnavailable
+}
+
+fn remove_if_present(path: &Path) -> io::Result<()> {
+    match fs::remove_file(path) {
+        Err(err) if err.kind() == io::ErrorKind::NotFound => Ok(()),
+        other => other,
+    }
+}
+
+#[cfg(unix)]
+fn sync_directory(path: &Path) -> bool {
+    File::open(path).and_then(|file| file.sync_all()).is_ok()
+}
+
+// Cafe provides FSFlushFile for file data. It has no directory descriptor
+// for fsync. Its synchronous rename/remove calls are the metadata boundary.
+#[cfg(not(unix))]
+fn sync_directory(_: &Path) -> bool {
+    true
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/wiiu/security/src/vault/tests.rs b/wiiu/security/src/vault/tests.rs
