+use std::fs;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::{Duration, Instant};
+
+use horizon_wiiu_security::{Protection, Secret, StorageMode};
+
+use crate::fixture::Fixture;
+use crate::protocol::{self, Payload, Poll, Transport};
+use crate::{Accounts, Error, Event, ProfileId, ProfileState, Provider, Verified, Work};
+
+const CLIENT: &str = "fake-registered-app";
+const PIN: &[u8] = b"a test PIN passphrase";
+
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new() -> Self {
+        static NEXT: AtomicUsize = AtomicUsize::new(0);
+        let path = std::env::temp_dir().join(format!(
+            "night-microsoft-test-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::create_dir(&path).unwrap();
+        Self(path)
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        fs::remove_dir_all(&self.0).unwrap();
+    }
+}
+
+fn ms(transport: &dyn Transport) -> protocol::MicrosoftTokens {
+    let code = protocol::begin(transport, CLIENT).unwrap();
+    match protocol::poll(transport, CLIENT, &code).unwrap() {
+        Poll::Completed(tokens) => tokens,
+        _ => panic!("the synthetic device code did not authorize"),
+    }
+}
+
+fn verified(transport: &dyn Transport) -> Verified {
+    Verified(protocol::authorize(transport, ms(transport), || false).unwrap())
+}
+
+fn result(work: Work) -> Result<Verified, Error> {
+    let limit = Instant::now() + Duration::from_secs(4);
+    loop {
+        match work.poll() {
+            Some(Event::Verified(verified)) => return Ok(verified),
+            Some(Event::Failed(error)) => return Err(error),
+            _ => {}
+        }
+        assert!(Instant::now() < limit, "the account worker did not finish");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+
+#[test]
+fn refresh_replaces_token_and_reopens_each_protection_mode() {
+    let storage = Scratch::new();
+    let fixture = Fixture::default();
+    let mut accounts = Accounts::open(&storage.0).unwrap();
+    accounts
+        .accept(
+            verified(&fixture),
+            None,
+            Some(Protection::PinProtected { new_pin: PIN }),
+        )
+        .unwrap();
+    accounts
+        .accept(
+            verified(&fixture),
+            None,
+            Some(Protection::ConfirmedUnprotected),
+        )
+        .unwrap();
+    assert_eq!(accounts.selected(), Some(ProfileId(2)));
+    drop(accounts);
+
+    let mut accounts = Accounts::open(&storage.0).unwrap();
+    assert_eq!(accounts.profiles().count(), 2);
+    assert_eq!(accounts.state(ProfileId(1)), ProfileState::Locked);
+    assert_eq!(
+        accounts.state(ProfileId(2)),
+        ProfileState::Saved(StorageMode::Unprotected)
+    );
+    assert!(accounts.active().is_none());
+    assert_eq!(accounts.selected(), Some(ProfileId(2)));
+    let provider = Provider::mocked(MapFixture::new(Behavior::Rotate));
+    let renewed = result(accounts.refresh(ProfileId(2), &provider).unwrap()).unwrap();
+    accounts.accept(renewed, Some(ProfileId(2)), None).unwrap();
+    assert_eq!(
+        accounts.active().unwrap().access_token(),
+        "fake-minecraft-2"
+    );
+    let observing = Provider::mocked(MapFixture::new(Behavior::RequireRotated));
+    assert!(result(accounts.refresh(ProfileId(2), &observing).unwrap()).is_ok());
+
+    accounts.unlock(ProfileId(1), PIN).unwrap();
+    let provider = Provider::mocked(Fixture::default());
+    let renewed = result(accounts.refresh(ProfileId(1), &provider).unwrap()).unwrap();
+    accounts.accept(renewed, Some(ProfileId(1)), None).unwrap();
+    assert_eq!(accounts.active().unwrap().name, "TestPlayer1");
+    accounts.sign_out(ProfileId(2)).unwrap();
+    assert!(accounts.profile(ProfileId(2)).is_none());
+    let mut accounts = Accounts::open(&storage.0).unwrap();
+    assert_eq!(accounts.selected(), Some(ProfileId(1)));
+    assert_eq!(accounts.profiles().count(), 1);
+    assert_eq!(
+        accounts.refresh(ProfileId(2), &provider).err(),
+        Some(Error::Reauthenticate)
+    );
+}
+
+#[test]
+fn revoked_refresh_and_denied_ownership_cannot_produce_an_identity() {
+    let storage = Scratch::new();
+    let mut accounts = Accounts::open(&storage.0).unwrap();
+    let fixture = Fixture::default();
+    accounts
+        .accept(verified(&fixture), None, Some(Protection::SessionOnly))
+        .unwrap();
+    let revoked = Provider::mocked(MapFixture::new(Behavior::Revoke));
+    let error = result(accounts.refresh(ProfileId(1), &revoked).unwrap())
+        .err()
+        .unwrap();
+    assert_eq!(error, Error::Reauthenticate);
+    accounts.record_failure(ProfileId(1), error);
+    assert!(accounts.active().is_none());
+    assert_eq!(accounts.state(ProfileId(1)), ProfileState::Reauthenticate);
+    assert_eq!(fs::read_dir(&storage.0).unwrap().count(), 0);
+    assert_eq!(Accounts::open(&storage.0).unwrap().profiles().count(), 0);
+
+    let denial = MapFixture::new(Behavior::NoOwnership);
+    assert_eq!(
+        protocol::authorize(&denial, ms(&denial), || false).err(),
+        Some(Error::OwnershipMissing)
+    );
+}
+
+#[test]
+fn expired_sessions_are_rejected_and_expired_device_codes_terminate() {
+    let old = MapFixture::new(Behavior::ExpiringAccess);
+    let authorized = verified(&old);
+    assert!(!authorized
+        .identity()
+        .is_current_at(Instant::now() + Duration::from_secs(2)));
+    let device = Provider::mocked(MapFixture::new(Behavior::ExpiredCode));
+    assert_eq!(
+        result(device.start().unwrap()).err(),
+        Some(Error::CodeExpired)
+    );
+}
+
+#[derive(Clone, Copy)]
+enum Behavior {
+    Rotate,
+    RequireRotated,
+    Revoke,
+    NoOwnership,
+    ExpiringAccess,
+    ExpiredCode,
+}
+
+struct MapFixture {
+    behavior: Behavior,
+    transport: Fixture,
+}
+
+impl MapFixture {
+    fn new(behavior: Behavior) -> Self {
+        Self {
+            behavior,
+            transport: Fixture::default(),
+        }
+    }
+}
+
+fn body(status: u16, response: &str) -> Result<(u16, Secret), Error> {
+    Ok((status, Secret::new(response.as_bytes().to_vec())))
+}
+
+impl Transport for MapFixture {
+    fn send(&self, url: &str, payload: Payload<'_>) -> Result<(u16, Secret), Error> {
+        match self.behavior {
+            Behavior::Rotate if url.ends_with("/token") => {
+                let Payload::Form(form) = payload else {
+                    panic!("expected OAuth form")
+                };
+                assert!(form.contains(&("grant_type", "refresh_token")));
+                assert!(form.contains(&("refresh_token", "fake-refresh-2")));
+                return body(
+                    200,
+                    r#"{"refresh_token":"fake-rotated-2","access_token":"fake-microsoft-2"}"#,
+                );
+            }
+            Behavior::RequireRotated if url.ends_with("/token") => {
+                let Payload::Form(form) = payload else {
+                    panic!("expected OAuth form")
+                };
+                assert!(form.contains(&("refresh_token", "fake-rotated-2")));
+                return body(200, r#"{"access_token":"fake-microsoft-2"}"#);
+            }
+            Behavior::Revoke if url.ends_with("/token") => {
+                return body(
+                    400,
+                    r#"{"error":"invalid_grant","error_description":"contains a credential placeholder"}"#,
+                );
+            }
+            Behavior::NoOwnership if url.ends_with("/entitlements/mcstore") => {
+                return body(200, r#"{"items":[{"name":"game_minecraft_bedrock"}]}"#);
+            }
+            Behavior::ExpiringAccess if url.ends_with("/login_with_xbox") => {
+                return body(
+                    200,
+                    r#"{"access_token":"fake-minecraft-1","expires_in":61}"#,
+                );
+            }
+            Behavior::ExpiredCode if url.ends_with("/token") => {
+                return body(400, r#"{"error":"expired_token"}"#);
+            }
+            _ => {}
+        }
+        self.transport.send(url, payload)
+    }
+}
diff --git a/wiiu/microsoft/src/worker.rs b/wiiu/microsoft/src/worker.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bc6bdb3de65ad22c341b6551229ad5ae39906ca8
--- /dev/null
+++ b/wiiu/microsoft/src/worker.rs
@@ -0,0 +1,196 @@
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    mpsc, Arc,
+};
+use std::time::{Duration, Instant};
+
+use horizon_wiiu_security::Secret;
+
+use crate::protocol::{self, Authorized, Error, Https, Poll, Transport};
+
+pub struct DevicePrompt {
+    verification_uri: String,
+    code: Secret,
+    expires: Instant,
+}
+
+impl DevicePrompt {
+    pub fn instructions(&self) -> Option<(&str, &str)> {
+        let code = std::str::from_utf8(self.code.expose()).ok()?;
+        (Instant::now() < self.expires).then_some((&self.verification_uri, code))
+    }
+}
+
+pub struct Verified(pub(crate) Authorized);
+
+impl Verified {
+    pub fn identity(&self) -> &crate::Identity {
+        &self.0.identity
+    }
+}
+
+pub enum Event {
+    Prompt(DevicePrompt),
+    Verifying,
+    Verified(Verified),
+    Failed(Error),
+}
+
+#[derive(Clone)]
+pub struct Provider {
+    client: Option<&'static str>,
+    transport: Arc<dyn Transport>,
+}
+
+impl Provider {
+    pub fn new(client: Option<&'static str>) -> Self {
+        Self {
+            client: client.filter(|client| !client.is_empty()),
+            transport: Arc::new(Https::new()),
+        }
+    }
+
+    pub fn configured(&self) -> bool {
+        self.client.is_some()
+    }
+
+    pub fn for_night(client: Option<&'static str>, fixture: bool) -> Self {
+        if fixture {
+            #[cfg(feature = "fixture")]
+            return Self::mocked(crate::fixture::Fixture::default());
+            #[cfg(not(feature = "fixture"))]
+            return Self::new(None);
+        }
+        Self::new(client)
+    }
+
+    #[cfg(any(test, feature = "fixture"))]
+    pub(crate) fn mocked(transport: impl Transport + 'static) -> Self {
+        Self {
+            client: Some("test-only-public-application"),
+            transport: Arc::new(transport),
+        }
+    }
+
+    pub fn start(&self) -> Result<Work, Error> {
+        let client = self.client.ok_or(Error::Unconfigured)?;
+        let transport = self.transport.clone();
+        Work::spawn(move |events, stop| {
+            let device = protocol::begin(&*transport, client)?;
+            let mut interval = device.interval;
+            if !events.post(Event::Prompt(DevicePrompt {
+                verification_uri: device.verification_uri.clone(),
+                code: Secret::new(device.user_code.expose().to_vec()),
+                expires: device.expires,
+            })) {
+                return Err(Error::Denied);
+            }
+            loop {
+                let remaining = device.expires.saturating_duration_since(Instant::now());
+                if stop.recv_timeout(interval.min(remaining))
+                    != Err(mpsc::RecvTimeoutError::Timeout)
+                {
+                    return Err(Error::Denied);
+                }
+                if Instant::now() >= device.expires || events.cancelled() {
+                    return Err(Error::CodeExpired);
+                }
+                match protocol::poll(&*transport, client, &device) {
+                    Ok(Poll::Pending) => {}
+                    Ok(Poll::SlowDown) => interval += Duration::from_secs(5),
+                    Ok(Poll::Completed(tokens)) => {
+                        if !events.post(Event::Verifying) {
+                            return Err(Error::Denied);
+                        }
+                        drop(device);
+                        return protocol::authorize(&*transport, tokens, || events.cancelled());
+                    }
+                    Err(Error::Network) => {
+                        interval = (interval * 2).min(Duration::from_secs(120));
+                    }
+                    Err(error) => return Err(error),
+                }
+            }
+        })
+    }
+
+    pub fn renew(&self, credential: Secret) -> Result<Work, Error> {
+        let client = self.client.ok_or(Error::Unconfigured)?;
+        let transport = self.transport.clone();
+        Work::spawn(move |events, _| {
+            if events.cancelled() {
+                return Err(Error::Denied);
+            }
+            let tokens = protocol::refresh(&*transport, client, credential)?;
+            protocol::authorize(&*transport, tokens, || events.cancelled())
+        })
+    }
+}
+
+struct Events {
+    sender: mpsc::Sender<Event>,
+    cancelled: Arc<AtomicBool>,
+}
+
+impl Events {
+    fn post(&self, event: Event) -> bool {
+        !self.cancelled() && self.sender.send(event).is_ok()
+    }
+
+    fn cancelled(&self) -> bool {
+        self.cancelled.load(Ordering::Acquire)
+    }
+}
+
+/// Dropping work cancels further polling and discards any queued result.
+/// In-progress HTTPS calls drain under their timeout without blocking Night.
+pub struct Work {
+    events: mpsc::Receiver<Event>,
+    stop: mpsc::Sender<()>,
+    cancelled: Arc<AtomicBool>,
+}
+
+impl Work {
+    fn spawn(
+        task: impl FnOnce(&Events, mpsc::Receiver<()>) -> Result<Authorized, Error> + Send + 'static,
+    ) -> Result<Self, Error> {
+        let (event_sender, events) = mpsc::channel();
+        let (stop, stop_receiver) = mpsc::channel();
+        let cancelled = Arc::new(AtomicBool::new(false));
+        let outgoing = Events {
+            sender: event_sender,
+            cancelled: cancelled.clone(),
+        };
+        std::thread::Builder::new()
+            .name("Night accounts".into())
+            .stack_size(512 * 1024)
+            .spawn(move || {
+                let result = task(&outgoing, stop_receiver);
+                outgoing.post(match result {
+                    Ok(result) => Event::Verified(Verified(result)),
+                    Err(error) => Event::Failed(error),
+                });
+            })
+            .map_err(|_| Error::Network)?;
+        Ok(Self {
+            events,
+            stop,
+            cancelled,
+        })
+    }
+
+    pub fn poll(&self) -> Option<Event> {
+        match self.events.try_recv() {
+            Ok(event) => Some(event),
+            Err(mpsc::TryRecvError::Empty) => None,
+            Err(mpsc::TryRecvError::Disconnected) => Some(Event::Failed(Error::Network)),
+        }
+    }
+}
+
+impl Drop for Work {
+    fn drop(&mut self) {
+        self.cancelled.store(true, Ordering::Release);
+        let _ = self.stop.send(());
+    }
+}
diff --git a/wiiu/package_rpx.cmake b/wiiu/package_rpx.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..24c0b1978128d4d393bf88009ec84f060961d7b4
--- /dev/null
+++ b/wiiu/package_rpx.cmake
@@ -0,0 +1,37 @@
+foreach(required CARGO PACKAGE_ELF READRPL RPX)
+   if(NOT DEFINED ${required})
+      message(FATAL_ERROR "${required} is required")
+   endif()
+endforeach()
+
+# Do not replace the last successful RPX until its replacement is validated.
+string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef suffix)
+set(temporary "${RPX}.${suffix}.tmp.rpx")
+if(EXISTS "${temporary}")
+   message(FATAL_ERROR "Temporary RPX already exists: ${temporary}")
+endif()
+execute_process(COMMAND "${CARGO}" wiiu rpx "${PACKAGE_ELF}" "${temporary}"
+   RESULT_VARIABLE result ERROR_VARIABLE error)
+if(NOT result STREQUAL "0")
+   file(REMOVE "${temporary}")
+   message(FATAL_ERROR "RPX conversion failed: ${error}")
+endif()
+execute_process(COMMAND "${READRPL}" -i "${temporary}"
+   RESULT_VARIABLE result OUTPUT_VARIABLE imports ERROR_VARIABLE error)
+string(REGEX MATCH "Section [0-9]+: SHT_RPL_IMPORTS, \\.fimport_coreinit,[^\n]*\n(  [^\n]*\n)*"
+   coreinit "${imports}")
+if(NOT result STREQUAL "0" OR NOT coreinit MATCHES "\n    exit[\r\n]")
+   file(REMOVE "${temporary}")
+   message(FATAL_ERROR "RPX is missing the coreinit exit import: ${error}")
+endif()
+if(imports MATCHES "__rplwrap_[A-Za-z0-9_]*")
+   set(wrapper "${CMAKE_MATCH_0}")
+   file(REMOVE "${temporary}")
+   message(FATAL_ERROR "RPX contains unsupported WUT wrapper import: ${wrapper}")
+endif()
+execute_process(COMMAND "${CMAKE_COMMAND}" -E rename "${temporary}" "${RPX}"
+   RESULT_VARIABLE result ERROR_VARIABLE error)
+if(NOT result STREQUAL "0")
+   file(REMOVE "${temporary}")
+   message(FATAL_ERROR "Cannot install validated RPX: ${error}")
+endif()
