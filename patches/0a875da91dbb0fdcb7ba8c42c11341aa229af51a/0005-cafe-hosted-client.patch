diff --git a/wiiu/loading_host/CMakeLists.txt b/wiiu/loading_host/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..ca30893ea60a60242541a3503a67e0c420fa7a77
--- /dev/null
+++ b/wiiu/loading_host/CMakeLists.txt
@@ -0,0 +1,58 @@
+cmake_minimum_required(VERSION 3.13)
+project(horizon_wiiu_loading_host C CXX)
+find_program(POWERPC_OBJCOPY_EXECUTABLE powerpc-eabi-objcopy REQUIRED)
+
+# Keep all generated files under the caller's binary tree. These are the
+# existing HUD and panorama implementations; this target adds only the WHB
+# target-switching callback needed to drive both displays from one batch.
+add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../gx2_hud"
+                 "${CMAKE_CURRENT_BINARY_DIR}/gx2_hud")
+add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../gx2_panorama"
+                 "${CMAKE_CURRENT_BINARY_DIR}/gx2_panorama")
+add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../gx2_terrain"
+                 "${CMAKE_CURRENT_BINARY_DIR}/gx2_terrain")
+
+set(HUD_GFD_OBJECT "${CMAKE_CURRENT_BINARY_DIR}/hud_gfd.o")
+set(PANORAMA_GFD_OBJECT "${CMAKE_CURRENT_BINARY_DIR}/panorama_gfd.o")
+set(TERRAIN_GFD_OBJECT "${CMAKE_CURRENT_BINARY_DIR}/terrain_gfd.o")
+add_custom_command(
+   OUTPUT "${HUD_GFD_OBJECT}"
+   COMMAND "${CMAKE_COMMAND}" -E copy_if_different
+      "${CMAKE_CURRENT_BINARY_DIR}/gx2_hud/hud.gsh" hud.gsh
+   COMMAND "${POWERPC_OBJCOPY_EXECUTABLE}"
+      -I binary -O elf32-powerpc -B powerpc:common hud.gsh hud_gfd.o
+   DEPENDS horizon_gx2_hud_shader "${CMAKE_CURRENT_BINARY_DIR}/gx2_hud/hud.gsh"
+   WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
+   VERBATIM)
+add_custom_command(
+   OUTPUT "${TERRAIN_GFD_OBJECT}"
+   COMMAND "${CMAKE_COMMAND}" -E copy_if_different
+      "${CMAKE_CURRENT_BINARY_DIR}/gx2_terrain/terrain.gsh" terrain.gsh
+   COMMAND "${POWERPC_OBJCOPY_EXECUTABLE}"
+      -I binary -O elf32-powerpc -B powerpc:common terrain.gsh terrain_gfd.o
+   DEPENDS horizon_gx2_terrain_shader "${CMAKE_CURRENT_BINARY_DIR}/gx2_terrain/terrain.gsh"
+   WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
+   VERBATIM)
+set_source_files_properties("${HUD_GFD_OBJECT}" "${PANORAMA_GFD_OBJECT}" "${TERRAIN_GFD_OBJECT}"
+   PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE)
+
+add_custom_command(
+   OUTPUT "${PANORAMA_GFD_OBJECT}"
+   COMMAND "${CMAKE_COMMAND}" -E copy_if_different
+      "${CMAKE_CURRENT_BINARY_DIR}/gx2_panorama/panorama.gsh" panorama.gsh
+   COMMAND "${POWERPC_OBJCOPY_EXECUTABLE}"
+      -I binary -O elf32-powerpc -B powerpc:common panorama.gsh panorama_gfd.o
+   DEPENDS horizon_gx2_panorama_shader "${CMAKE_CURRENT_BINARY_DIR}/gx2_panorama/panorama.gsh"
+   WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
+   VERBATIM)
+set_source_files_properties("${HUD_GFD_OBJECT}" "${PANORAMA_GFD_OBJECT}"
+   PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE)
+
+add_library(horizon_wiiu_loading_host STATIC
+   loading_host.c gx2_profile.c swkbd_bridge.cpp "${HUD_GFD_OBJECT}" "${PANORAMA_GFD_OBJECT}" "${TERRAIN_GFD_OBJECT}")
+set_target_properties(horizon_wiiu_loading_host PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED ON)
+target_include_directories(horizon_wiiu_loading_host PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}")
+target_compile_options(horizon_wiiu_loading_host PRIVATE -Wall -Wextra -Werror)
+target_link_libraries(horizon_wiiu_loading_host
+   PUBLIC horizon_gx2_hud horizon_gx2_panorama horizon_gx2_terrain
+   PRIVATE wut m)
