diff --git a/wiiu/loading_app/src/hosted.rs b/wiiu/loading_app/src/hosted.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0d68af39ad9ea3dc753933bde89bb73a86b6b77a
--- /dev/null
+++ b/wiiu/loading_app/src/hosted.rs
@@ -0,0 +1,250 @@
+//! Game side of the launcher-owned Cafe session.
+use std::path::Path;
+use std::sync::{Mutex, OnceLock};
+
+use super::{CafeLoadingStatus, CafeRunOutcome, Gx2LoadingPresenter, LoadingHost, CAFE_APP_ROOT};
+
+#[path = "night_mcp.rs"]
+pub(super) mod mcp;
+
+#[path = "local_wire.rs"]
+mod local_wire;
+#[path = "night_menu.rs"]
+mod night_menu;
+#[path = "night_online.rs"]
+mod night_online;
+#[path = "night_store.rs"]
+mod night_store;
+
+// C/Pregame consume these statuses only after the native game and renderer drop.
+const RETURNED: i32 = 0;
+const SAVED: i32 = 1;
+const RESOURCES: i32 = 2;
+const FAILED: i32 = 3;
+const OS_SAVE_FAILED: i32 = 4;
+
+struct NativeFiles;
+
+impl night_menu::GameFiles for NativeFiles {
+    fn world(
+        &self,
+        path: &Path,
+        identity: &str,
+        online_uuid: Option<u128>,
+    ) -> Option<night_menu::World> {
+        use horizon_client::save::{self, Level, SessionLock};
+        let Some(level) = Level::read_summary(path) else {
+            return Some(night_menu::World {
+                name: path.file_name()?.to_str()?.to_owned(),
+                detail: "Unreadable world metadata".into(),
+                unavailable: Some("Open recovery in the game menu"),
+            });
+        };
+        let unavailable = if SessionLock::is_locked(path) {
+            Some("World is locked or inaccessible")
+        } else if save::incompatible_version(path).is_some() {
+            Some("Incompatible save version")
+        } else if save::needs_file_fixes(path) || save::downgraded_from(path).is_some() {
+            Some("Open in the game menu for upgrade or backup")
+        } else if !horizon_client::game::hosted_world_profile_matches(
+            level.player_uuid,
+            identity,
+            online_uuid,
+        ) {
+            Some("Select the world's owner profile")
+        } else {
+            None
+        };
+        let mode = if level.hardcore {
+            "Hardcore"
+        } else {
+            match level.mode() {
+                1 => "Creative",
+                2 => "Adventure",
+                3 => "Spectator",
+                _ => "Survival",
+            }
+        };
+        let version = horizon_client::game::hosted_world_version(path)
+            .unwrap_or_else(|| "Version unknown".into());
+        Some(night_menu::World {
+            name: level.name,
+            detail: format!("{mode} / {version}"),
+            unavailable,
+        })
+    }
+}
+
+fn local_service() -> &'static Mutex<night_menu::LocalService<NativeFiles>> {
+    static LOCAL: OnceLock<Mutex<night_menu::LocalService<NativeFiles>>> = OnceLock::new();
+    LOCAL.get_or_init(|| {
+        Mutex::new(night_menu::LocalService::new(
+            Path::new(CAFE_APP_ROOT).to_owned(),
+            night_menu::ResourcePin {
+                version: env!("HORIZON_NIGHT_MINECRAFT"),
+                schema: env!("HORIZON_NIGHT_PREP_SCHEMA")
+                    .parse()
+                    .expect("verified resource schema"),
+                client: env!("HORIZON_NIGHT_CLIENT_JAR"),
+                server: env!("HORIZON_NIGHT_SERVER_JAR"),
+                exporter: env!("HORIZON_NIGHT_EXPORTER"),
+            },
+            NativeFiles,
+            &[
+                ("Horizon source", env!("HORIZON_NIGHT_UPSTREAM")),
+                ("Wii U client", env!("HORIZON_NIGHT_CLIENT")),
+                ("Wii U patch series", env!("HORIZON_NIGHT_PATCH")),
+                ("Builder", env!("HORIZON_NIGHT_BUILDER")),
+                ("Prepared Minecraft", env!("HORIZON_NIGHT_MINECRAFT")),
+                ("Application", "Horizon Night / Wii U"),
+                ("Build input SHA-256", env!("HORIZON_NIGHT_BUILD_ID")),
+            ],
+        ))
+    })
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn horizon_night_local(
+    output: *mut local_wire::LocalMenu,
+    command: u8,
+    index: u8,
+    input: *const u8,
+    len: usize,
+) {
+    if output.is_null() || input.is_null() || len > 1024 {
+        return;
+    }
+    let Ok(input) = std::str::from_utf8(unsafe { std::slice::from_raw_parts(input, len) }) else {
+        return;
+    };
+    if command == local_wire::SHUTDOWN {
+        local_service()
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .shutdown();
+        mcp::horizon_night_mcp_shutdown();
+        return;
+    }
+    let agent_menu = command == local_wire::OPEN_AGENT || mcp::menu_open();
+    let mut service = local_service().lock().unwrap_or_else(|e| e.into_inner());
+    if command == local_wire::TICK {
+        if !service.tick() && !agent_menu {
+            let mut unchanged = local_wire::LocalMenu::default();
+            unchanged.mode = local_wire::NO_UPDATE;
+            unsafe { output.write(unchanged) };
+            return;
+        }
+    } else if command != 0 && !agent_menu {
+        let time = std::time::Instant::now();
+        service.command(command, index, input);
+        if option_env!("HORIZON_NIGHT_ACCOUNT_FIXTURE").is_some()
+            && command == local_wire::TEXT_ACCEPTED
+        {
+            let ms = time.elapsed().as_millis().min(u32::MAX as u128) as u32;
+            unsafe {
+                super::OSReport(
+                    c"Horizon Night fixture keyboard operation: %u ms\n".as_ptr(),
+                    ms,
+                );
+            }
+        }
+    }
+    let model = service.model();
+    drop(service);
+    let model = if agent_menu {
+        mcp::local_menu(command, index, model).unwrap_or(model)
+    } else {
+        model
+    };
+    unsafe { output.write(model) };
+}
+
+/// The RPX calls this synchronously on the foreground thread. The caller has
+/// released the Night HUD and lends the same ProcUI pump and WHB context.
+#[no_mangle]
+pub extern "C" fn horizon_hosted_game_run() -> i32 {
+    let launch = match mcp::take_launch() {
+        Ok(Some(launch)) => launch,
+        Ok(None) => match local_service()
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .launch()
+        {
+            Ok(launch) => launch,
+            Err(code) => return i32::from(code),
+        },
+        Err(()) => return FAILED,
+    };
+    let _registration = mcp::prepare_game();
+    if std::env::set_current_dir(&launch.game).is_err() {
+        return RESOURCES;
+    }
+    horizon_client::spans::startup::enable_log_sink();
+    horizon_client_platform::cafe_memory::report("hosted.before_game");
+    let result = run(launch);
+    mcp::withdraw();
+    if let Err(error) = std::env::set_current_dir(CAFE_APP_ROOT) {
+        log::error!("Cafe did not restore the launcher working directory: {error}");
+    }
+    horizon_client_platform::cafe_memory::report("hosted.after_game_drop");
+    result
+}
+
+fn run(launch: night_menu::Launch) -> i32 {
+    let mut presenter = match unsafe { Gx2LoadingPresenter::new_embedded(16_384) } {
+        Ok(presenter) => presenter,
+        Err(error) => {
+            log::error!("Cafe hosted presenter initialization: {error}");
+            return FAILED;
+        }
+    };
+    let mut host = LoadingHost::new(&mut presenter);
+    host.hosted = true;
+    host.hosted_swap_ab = launch.swap_ab;
+    host.pad_blocked_until_neutral = true;
+    unsafe { super::OSReport(c"Horizon Wii U startup: hosted game entry\n".as_ptr()) };
+    let mut options = vec![
+        "--home".to_owned(),
+        CAFE_APP_ROOT.to_owned(),
+        "--resources".to_owned(),
+        launch.resources.to_string_lossy().into_owned(),
+        "--name".to_owned(),
+        launch.player,
+    ];
+    if let Some(world) = launch.world {
+        options.extend(["--quickPlaySingleplayer".into(), world]);
+    }
+    if let Some(server) = launch.server {
+        options.extend(["--quickPlayMultiplayer".into(), server]);
+    }
+    let outcome = horizon_client::entry::run_hosted_cafe(
+        &mut host,
+        options,
+        [!launch.swap_ab, !launch.swap_xy],
+        launch.identity.as_ref().map(|identity| {
+            horizon_client::auth::AuthSession::new(
+                &identity.name,
+                identity.id.0,
+                identity.access_token(),
+            )
+        }),
+    );
+    if host.hosted_exit_save_failed {
+        return OS_SAVE_FAILED;
+    }
+    if let Err(error) = &outcome {
+        log::error!("Cafe hosted game error: {error}");
+        return FAILED;
+    }
+    if host.failure.is_some()
+        || matches!(&outcome, Ok(CafeRunOutcome::Loading(session))
+            if session.status() == CafeLoadingStatus::Failed)
+    {
+        return FAILED;
+    }
+    if host.hosted_saved {
+        SAVED
+    } else {
+        RETURNED
+    }
+}
diff --git a/wiiu/loading_app/src/lib.rs b/wiiu/loading_app/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6fdd616443b77b9692d7d216128e10cc889534e6
--- /dev/null
+++ b/wiiu/loading_app/src/lib.rs
@@ -0,0 +1,1812 @@
+//! Cafe executable driver for Horizon's original Loading session.
+//!
+//! WUT owns the RPX entry, WHB process and GX2 lifetime in `main.c`; this
+//! library only runs on that initialized GX2 thread.
+
+use horizon_client::game::{
+    CafeGameEntryKind, CafeGameSession, CafeLoadingHost, CafeLoadingPresenter, CafeLoadingSession,
+    CafeLoadingStatus, CafeRunOutcome,
+};
+use horizon_client_platform::{
+    ClientDeviceEvent, ClientWindowEvent, EventLoopControl, EventLoopCtl, ImeEvent,
+    PhysicalPosition,
+};
+use horizon_wiiu_loading_host::Gx2LoadingPresenter;
+use horizon_wiiu_platform::{
+    ButtonHistory, VpadState,
+    keyboard::KeyboardAdapter,
+    mouse::{MouseAdapter, MouseOutput},
+    touch::TouchMapper,
+};
+use std::cell::Cell;
+use std::ffi::CString;
+use std::net::{TcpStream, ToSocketAddrs};
+use std::time::{Duration, Instant};
+
+unsafe extern "C" {
+    fn OSReport(format: *const std::ffi::c_char, ...);
+    fn OSGetCoreCount() -> u32;
+    fn OSGetCoreId() -> u32;
+    fn OSGetCurrentThread() -> *mut std::ffi::c_void;
+    fn OSGetThreadAffinity(thread: *mut std::ffi::c_void) -> u32;
+    fn horizon_wiiu_app_is_running() -> i32;
+    fn horizon_wiiu_app_is_focused() -> i32;
+    fn horizon_wiiu_hosted_ack_release();
+    fn horizon_wiiu_swkbd_input_occupied() -> i32;
+    fn horizon_swkbd_request(initial_text: *const u16, max_utf16_units: i32) -> i32;
+    fn horizon_swkbd_is_open() -> i32;
+    fn horizon_swkbd_take_result(
+        utf8: *mut std::ffi::c_char,
+        capacity: usize,
+        length: *mut usize,
+    ) -> i32;
+    fn horizon_swkbd_close();
+    fn horizon_loading_host_dimensions(dimensions: *mut u32) -> i32;
+    fn horizon_loading_host_completed_presents() -> u32;
+    fn horizon_gx2_profile_legacy_pacing() -> bool;
+}
+
+/// Status returned to the WUT entry point: 0 finished, 1 title is ready but
+/// cannot yet hand off to Game, 2 loading/presentation failed, 3 setup failed.
+const FINISHED: i32 = 0;
+const READY_WITHOUT_GAME_HANDOFF: i32 = 1;
+const LOADING_FAILED: i32 = 2;
+const PRESENTER_FAILED: i32 = 3;
+const APP_ROOT_FAILED: i32 = 4;
+const LOCAL_WORLD_START_FAILED: i32 = 5;
+const REMOTE_SERVER_START_FAILED: i32 = 6;
+
+#[cfg(target_os = "cafe")]
+#[global_allocator]
+static CAFE_ALLOCATOR: horizon_client_platform::cafe_memory::MeasuredSystem =
+    horizon_client_platform::cafe_memory::MeasuredSystem;
+
+const CAFE_APP_ROOT: &str = "/vol/external01/wiiu/apps/HorizonWiiU";
+// Set at compile time only for diagnosing host-loop stalls or input delays.
+const VERBOSE_HOST_TRACE: bool = match option_env!("HORIZON_WIIU_VERBOSE_HOST_TRACE") {
+    Some(value) => {
+        let bytes = value.as_bytes();
+        bytes.len() == 1 && bytes[0] == b'1'
+    }
+    None => false,
+};
+// Set at compile time only to log a one-shot CPU topology snapshot.
+const PROFILE_CORES: bool = match option_env!("HORIZON_WIIU_PROFILE_CORES") {
+    Some(value) => {
+        let bytes = value.as_bytes();
+        bytes.len() == 1 && bytes[0] == b'1'
+    }
+    None => false,
+};
+
+fn game_start_failure_status(entry_kind: CafeGameEntryKind) -> CafeLoadingStatus {
+    match entry_kind {
+        CafeGameEntryKind::LocalWorld => CafeLoadingStatus::LocalWorldStartFailed,
+        CafeGameEntryKind::RemoteServer => CafeLoadingStatus::RemoteServerStartFailed,
+        CafeGameEntryKind::TitleScreen => CafeLoadingStatus::Failed,
+    }
+}
+
+macro_rules! startup_report {
+    ($stage:literal) => {{
+        // Fixed static format strings keep these early startup markers free of
+        // allocator and logger initialization dependencies.
+        unsafe {
+            OSReport(
+                concat!("Horizon Wii U startup: ", $stage, "\n\0")
+                    .as_ptr()
+                    .cast(),
+            );
+        }
+    }};
+}
+
+/// Log the system and Rust parallelism view once, without changing scheduling
+/// or thread affinity. The core ID and affinity are for this calling thread.
+fn report_core_topology_once() {
+    if !PROFILE_CORES {
+        return;
+    }
+
+    let core_count = unsafe { OSGetCoreCount() };
+    let current_core = unsafe { OSGetCoreId() };
+    let current_thread = unsafe { OSGetCurrentThread() };
+    let available_parallelism = std::thread::available_parallelism()
+        .map(|available| available.get().min(u32::MAX as usize) as u32);
+    if current_thread.is_null() {
+        match available_parallelism {
+            Ok(available) => unsafe {
+                OSReport(
+                    "Horizon Wii U core profile: system_core_count=%u calling_thread_current_core=%u calling_thread_affinity=unavailable rust_available_parallelism=%u\n\0"
+                        .as_ptr()
+                        .cast(),
+                    core_count,
+                    current_core,
+                    available,
+                );
+            },
+            Err(_) => unsafe {
+                OSReport(
+                    "Horizon Wii U core profile: system_core_count=%u calling_thread_current_core=%u calling_thread_affinity=unavailable rust_available_parallelism=error\n\0"
+                        .as_ptr()
+                        .cast(),
+                    core_count,
+                    current_core,
+                );
+            },
+        }
+    } else {
+        let affinity = unsafe { OSGetThreadAffinity(current_thread) };
+        match available_parallelism {
+            Ok(available) => unsafe {
+                OSReport(
+                    "Horizon Wii U core profile: system_core_count=%u calling_thread_current_core=%u calling_thread_affinity_mask=0x%08x rust_available_parallelism=%u\n\0"
+                        .as_ptr()
+                        .cast(),
+                    core_count,
+                    current_core,
+                    affinity,
+                    available,
+                );
+            },
+            Err(_) => unsafe {
+                OSReport(
+                    "Horizon Wii U core profile: system_core_count=%u calling_thread_current_core=%u calling_thread_affinity_mask=0x%08x rust_available_parallelism=error\n\0"
+                        .as_ptr()
+                        .cast(),
+                    core_count,
+                    current_core,
+                    affinity,
+                );
+            },
+        }
+    }
+}
+
+mod hosted;
+
+/// Called by C before WHB/GX2 initialization so all getrandom versions are
+/// anchored and the Cafe system RNG is checked before platform startup.
+#[no_mangle]
+pub extern "C" fn horizon_wiiu_app_entropy_first() {
+    horizon_wiiu_entropy::link();
+}
+
+/// Called by the WUT driver after WHB and GX2 initialization.
+#[no_mangle]
+pub extern "C" fn horizon_wiiu_app_run() -> i32 {
+    startup_report!("Rust app entry reached");
+    report_core_topology_once();
+    cafe_socket_setup_trace();
+    // Cafe std's FS backend mounts the SD card at /vol/external01 when its
+    // first filesystem operation initializes the FS client. Set a known app
+    // working directory so Options' existing relative .local fallback and
+    // game data paths resolve inside this app's isolated SD folder.
+    startup_report!("set_current_dir begin");
+    if std::env::set_current_dir(CAFE_APP_ROOT).is_err() {
+        return APP_ROOT_FAILED;
+    }
+    startup_report!("set_current_dir complete");
+
+    // Detailed startup spans identify UI and core resource stages. Cafe std
+    // cannot create the optional trace file, so send them to OSConsole/serial.
+    horizon_client::spans::startup::enable_log_sink();
+
+    // SAFETY: C calls this only after WHBGfxInit and keeps GX2 alive until it
+    // returns. The presenter is dropped on this same thread before C shuts GX2
+    // down.
+    startup_report!("GX2 presenter creation begin");
+    let mut presenter = match unsafe { Gx2LoadingPresenter::new_embedded(16_384) } {
+        Ok(presenter) => presenter,
+        Err(_) => return PRESENTER_FAILED,
+    };
+    startup_report!("GX2 presenter creation complete");
+    let mut host = LoadingHost::new(&mut presenter);
+    startup_report!("Horizon entry call begin");
+    let outcome = horizon_client::entry::main_with_cafe_host(Default::default(), &mut host);
+    startup_report!("Horizon entry call returned");
+    if let CafeRunOutcome::Loading(session) = &outcome {
+        if session.status() == CafeLoadingStatus::Failed {
+            log::error!(
+                "Horizon Cafe original Loading failed: {}",
+                session
+                    .failure_message()
+                    .as_deref()
+                    .unwrap_or("no failure message")
+            );
+        }
+    }
+    if host.local_world_start_failed {
+        return LOCAL_WORLD_START_FAILED;
+    }
+    if host.remote_server_start_failed {
+        return REMOTE_SERVER_START_FAILED;
+    }
+    if host.failure.is_some() {
+        return LOADING_FAILED;
+    }
+    if host.exited {
+        return match &outcome {
+            CafeRunOutcome::Loading(session) if session.status() == CafeLoadingStatus::Failed => {
+                LOADING_FAILED
+            }
+            _ => FINISHED,
+        };
+    }
+    match outcome {
+        CafeRunOutcome::Finished => FINISHED,
+        CafeRunOutcome::Loading(session) => match session.status() {
+            CafeLoadingStatus::Loading => LOADING_FAILED,
+            CafeLoadingStatus::ReadyForHandoff => READY_WITHOUT_GAME_HANDOFF,
+            CafeLoadingStatus::LocalWorldStartFailed => LOCAL_WORLD_START_FAILED,
+            CafeLoadingStatus::RemoteServerStartFailed => REMOTE_SERVER_START_FAILED,
+            CafeLoadingStatus::Failed => LOADING_FAILED,
+        },
+    }
+}
+
+/// Opt-in, one-shot probe for the socket setup calls ureq makes before TLS.
+/// Enable only for a diagnostic build with HORIZON_CAFE_SOCKET_TRACE=1.
+fn cafe_socket_setup_trace() {
+    if option_env!("HORIZON_CAFE_SOCKET_TRACE") != Some("1") {
+        return;
+    }
+
+    unsafe {
+        OSReport("Horizon Cafe socket probe: DNS begin\n\0".as_ptr().cast());
+    }
+    let mut addresses = match ("telemetry.playhorizon.dev", 443).to_socket_addrs() {
+        Ok(addresses) => addresses,
+        Err(error) => {
+            unsafe {
+                OSReport(
+                    "Horizon Cafe socket probe: DNS failed raw=%d\n\0"
+                        .as_ptr()
+                        .cast(),
+                    error.raw_os_error().unwrap_or(-1),
+                );
+            }
+            return;
+        }
+    };
+    let Some(address) = addresses.next() else {
+        unsafe {
+            OSReport(
+                "Horizon Cafe socket probe: DNS returned no addresses\n\0"
+                    .as_ptr()
+                    .cast(),
+            );
+        }
+        return;
+    };
+    unsafe {
+        OSReport(
+            "Horizon Cafe socket probe: DNS complete\n\0"
+                .as_ptr()
+                .cast(),
+        );
+        OSReport(
+            "Horizon Cafe socket probe: connect begin\n\0"
+                .as_ptr()
+                .cast(),
+        );
+    }
+    let stream = match TcpStream::connect_timeout(&address, Duration::from_secs(5)) {
+        Ok(stream) => stream,
+        Err(error) => {
+            unsafe {
+                OSReport(
+                    "Horizon Cafe socket probe: connect failed raw=%d\n\0"
+                        .as_ptr()
+                        .cast(),
+                    error.raw_os_error().unwrap_or(-1),
+                );
+            }
+            return;
+        }
+    };
+    unsafe {
+        OSReport(
+            "Horizon Cafe socket probe: connect complete\n\0"
+                .as_ptr()
+                .cast(),
+        );
+    }
+
+    if let Err(error) = stream.set_nodelay(true) {
+        unsafe {
+            OSReport(
+                "Horizon Cafe socket probe: TCP_NODELAY failed raw=%d\n\0"
+                    .as_ptr()
+                    .cast(),
+                error.raw_os_error().unwrap_or(-1),
+            );
+        }
+        return;
+    }
+    unsafe {
+        OSReport(
+            "Horizon Cafe socket probe: TCP_NODELAY complete\n\0"
+                .as_ptr()
+                .cast(),
+        );
+    }
+
+    if let Err(error) = stream.set_read_timeout(Some(Duration::from_secs(5))) {
+        unsafe {
+            OSReport(
+                "Horizon Cafe socket probe: read timeout failed raw=%d\n\0"
+                    .as_ptr()
+                    .cast(),
+                error.raw_os_error().unwrap_or(-1),
+            );
+        }
+        return;
+    }
+    unsafe {
+        OSReport(
+            "Horizon Cafe socket probe: read timeout complete\n\0"
+                .as_ptr()
+                .cast(),
+        );
+    }
+
+    if let Err(error) = stream.set_write_timeout(None) {
+        unsafe {
+            OSReport(
+                "Horizon Cafe socket probe: clear write timeout failed raw=%d\n\0"
+                    .as_ptr()
+                    .cast(),
+                error.raw_os_error().unwrap_or(-1),
+            );
+        }
+        return;
+    }
+    unsafe {
+        OSReport(
+            "Horizon Cafe socket probe: pre-TLS socket setup complete\n\0"
+                .as_ptr()
+                .cast(),
+        );
+    }
+    drop(stream);
+
+    for (index, endpoint) in [
+        horizon_telemetry::DEFAULT_ENDPOINT,
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let endpoint = endpoint.to_owned();
+        let spawn = std::thread::Builder::new()
+            .name("Cafe HTTPS probe".into())
+            .spawn(move || match horizon_telemetry::live::fetch(&endpoint) {
+                Ok(count) => unsafe {
+                    OSReport(
+                        "Horizon Cafe HTTPS GET endpoint=%d succeeded playing=%u lan=%u\n\0"
+                            .as_ptr()
+                            .cast(),
+                        index as i32,
+                        count.playing as u32,
+                        count.lan as u32,
+                    );
+                },
+                Err(error) => {
+                    let error = CString::new(error).unwrap_or_default();
+                    unsafe {
+                        OSReport(
+                            "Horizon Cafe HTTPS GET endpoint=%d failed: %s\n\0"
+                                .as_ptr()
+                                .cast(),
+                            index as i32,
+                            error.as_ptr(),
+                        );
+                    }
+                }
+            });
+        if let Err(error) = spawn {
+            unsafe {
+                OSReport(
+                    "Horizon Cafe HTTPS probe thread=%d failed raw=%d\n\0"
+                        .as_ptr()
+                        .cast(),
+                    index as i32,
+                    error.raw_os_error().unwrap_or(-1),
+                );
+            }
+        }
+    }
+}
