+//! Native Cafe session driver for Horizon Night.
+use super::*;
+use horizon_client_platform::{ClientDeviceEvent, ClientWindowEvent};
+
+pub struct CafeLoadingArtwork<'a> {
+    pub atlas: &'a HudAtlas,
+    pub panorama: Option<&'a horizon_client::gfx::panorama::Faces>,
+    /// Changes when Loading switches from its boot atlas to loaded UI resources.
+    pub generation: u64,
+}
+
+/// Original Game artwork needed before laying out a Cafe frame. Resource data
+/// remains owned by Horizon; the backend copies native textures synchronously.
+pub struct CafeGameArtwork<'a> {
+    pub gamma: f32,
+    pub atlas: &'a HudAtlas,
+    pub cit_glints: Option<&'a horizon_client::hud::cit_glint::GlintTextures>,
+    pub panorama: &'a horizon_client::gfx::panorama::Faces,
+    pub terrain_pixels: &'a horizon_client::assets::SpritePixels,
+    pub terrain_sprite_size: u32,
+    pub terrain_layers: u32,
+    pub hud_generation: u64,
+    pub terrain_generation: u64,
+}
+
+/// Cafe presenter contract for the original title frame. `frame.hud` is laid
+/// out once using `layout_viewport`; both targets may draw that same batch.
+pub trait CafeLoadingPresenter {
+    /// Native GamePad size used for original GUI layout and input coordinates.
+    fn layout_viewport(&self) -> [u32; 2];
+    /// `[x, y, width, height]` rectangles on the active TV and GamePad targets.
+    /// The presenter must validate that they are nonempty, in target bounds,
+    /// and preserve the layout aspect within the GX2 HUD backend's tolerance;
+    /// use an in-bounds letterbox rectangle for a mismatched display.
+    fn target_viewports(&self) -> [[u32; 4]; 2];
+    /// Prepare or recreate native resources for this artwork before Horizon
+    /// lays out the first batch that uses it. This runs every frame; reuse GPU
+    /// resources when `generation` is unchanged. The artwork is borrowed only
+    /// for this callback; copy any native texture data synchronously.
+    fn prepare_loading(&mut self, artwork: CafeLoadingArtwork<'_>) -> Result<()>;
+    /// Draw both target views synchronously. `Ok(true)` means both were accepted.
+    fn present_loading(
+        &mut self,
+        artwork: CafeLoadingArtwork<'_>,
+        frame: &Frame<'_>,
+        layout_viewport: [u32; 2],
+        target_viewports: [[u32; 4]; 2],
+        tick: u64,
+        animated_textures: bool,
+    ) -> Result<bool>;
+}
+
+/// A Cafe output to capture after its frame is drawn.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CafeScreenshotOutput {
+    Tv,
+    GamePad,
+}
+
+/// A tightly packed RGBA image read from a Cafe output.
+pub struct CafeScreenshot {
+    pub width: u32,
+    pub height: u32,
+    pub rgba: Vec<u8>,
+}
+
+/// Native presentation and terrain upload boundary for original Game frames.
+/// `prepare_game_artwork` runs before Horizon builds the frame; it borrows the
+/// resource data only for this call, so implementations must copy any native
+/// texture data synchronously and may reuse it while both generations match.
+pub trait CafeGameBackend:
+    horizon_client::presentation::PresentationBackend + horizon_client::presentation::TerrainBackend
+{
+    fn prepare_game_artwork(&mut self, artwork: CafeGameArtwork<'_>) -> Result<()>;
+
+    /// Storage retained by the native terrain presenter.
+    fn terrain_buffer_census(&self) -> Option<CafeTerrainBuffers> {
+        None
+    }
+
+    fn request_screenshot(&mut self, _output: CafeScreenshotOutput) {}
+
+    fn take_screenshot(&mut self) -> Option<std::result::Result<CafeScreenshot, String>> {
+        None
+    }
+
+    /// Whether the last submitted frame reached the targets with only named,
+    /// unsupported passes omitted. This distinguishes an intentional partial
+    /// diagnostic frame from a rejected submission for atlas-cache recovery.
+    fn last_game_frame_was_partial(&self) -> bool {
+        false
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+pub struct CafeTerrainBuffers {
+    pub sections: usize,
+    pub quads: usize,
+    pub vertices: usize,
+    pub vertex_payload_bytes: usize,
+    pub vertex_allocation_bytes: usize,
+    pub shared_index_allocation_bytes: usize,
+    pub rust_upload_scratch_bytes: usize,
+}
+
+fn encode_cafe_screenshot(
+    image: CafeScreenshot,
+) -> std::result::Result<(u32, u32, Vec<u8>), String> {
+    let size = (image.width as usize)
+        .checked_mul(image.height as usize)
+        .and_then(|n| n.checked_mul(4));
+    if image.width == 0
+        || image.height == 0
+        || size != Some(image.rgba.len())
+        || image.rgba.len() > 1920 * 1080 * 4
+    {
+        return Err("unsupported Cafe screenshot dimensions".into());
+    }
+    let mut png = Vec::new();
+    {
+        let mut encoder = png::Encoder::new(&mut png, image.width, image.height);
+        encoder.set_color(png::ColorType::Rgba);
+        encoder.set_depth(png::BitDepth::Eight);
+        let mut writer = encoder.write_header().map_err(|e| e.to_string())?;
+        writer
+            .write_image_data(&image.rgba)
+            .map_err(|e| e.to_string())?;
+    }
+    if png.len() > 12 * 1024 * 1024 - 1024 {
+        return Err("Cafe screenshot exceeds control response limit".into());
+    }
+    Ok((image.width, image.height, png))
+}
+
+/// Loading-owned session for an external Cafe event/render loop. It deliberately
+/// exposes readiness without consuming Loaded or claiming a Game handoff.
+pub struct CafeLoadingSession<'resources> {
+    loading: Loading,
+    resources: &'resources std::cell::OnceCell<Arc<Resources>>,
+    pad_edges: horizon_client::gamepad::Edges,
+    local_failure: Option<String>,
+    remote_failure: Option<String>,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CafeLoadingStatus {
+    Loading,
+    ReadyForHandoff,
+    LocalWorldStartFailed,
+    RemoteServerStartFailed,
+    Failed,
+}
+
+/// The kind of pending title entry carried by a Cafe Game session.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum CafeGameEntryKind {
+    LocalWorld,
+    RemoteServer,
+    TitleScreen,
+}
+
+fn cafe_control_title_requested(settings: &Settings, cemu_control: bool) -> bool {
+    cemu_control && settings.extras.agent_control && !settings.extras.no_ai
+}
+
+fn cafe_starting_entry_kind(
+    pending: Option<&PendingWorldEntry>,
+    integrated_starting: bool,
+) -> Option<CafeGameEntryKind> {
+    match pending {
+        Some(PendingWorldEntry::Local { .. }) => Some(CafeGameEntryKind::LocalWorld),
+        Some(PendingWorldEntry::Server { .. }) => Some(CafeGameEntryKind::RemoteServer),
+        None if integrated_starting => Some(CafeGameEntryKind::LocalWorld),
+        Some(PendingWorldEntry::StudioReplay(_)) | None => None,
+    }
+}
+
+impl<'resources> CafeLoadingSession<'resources> {
+    /// The initial splash can be cancelled before the game title is usable.
+    #[cfg(target_os = "cafe")]
+    pub fn hosted_can_cancel(&self) -> bool {
+        self.loading.loaded.is_none() && self.loading.options.is_some()
+            && self.loading.menu.pending.is_none()
+    }
+
+    /// Join the top-level resource worker before draining its final message.
+    /// The optional world-resource tail can still be in that queued message.
+    #[cfg(target_os = "cafe")]
+    pub fn drain_hosted(&mut self) -> Result<()> {
+        let resources = self.loading.handle.take().map(std::thread::JoinHandle::join);
+        let mut tail = self.loading.loaded.as_mut()
+            .and_then(|loaded| loaded.as_mut().ok())
+            .and_then(|loaded| loaded.rest_loader.take())
+            .map(WorldRestLoader::finish)
+            .unwrap_or(Ok(()));
+        for message in self.loading.receiver.try_iter() {
+            if let LoaderMsg::Done(Ok(mut loaded)) = message {
+                if let Some(loader) = loaded.rest_loader.take() {
+                    tail = tail.and(loader.finish());
+                }
+            }
+        }
+        if matches!(resources, Some(Err(_))) {
+            return Err("Cafe resource worker panicked".into());
+        }
+        tail
+    }
+
+    pub fn poll(&mut self, event_loop: &dyn horizon_client_platform::EventLoopCtl) -> bool {
+        if let Err(error) = self.loading.poll_menu_resources() {
+            self.loading.error = Some(error);
+            return false;
+        }
+        self.loading.poll_menu_realms(&Loop(event_loop));
+        self.failure_message().is_none()
+    }
+
+    pub fn dispatch_event(
+        &mut self,
+        event_loop: &dyn horizon_client_platform::EventLoopCtl,
+        event: ClientWindowEvent,
+    ) {
+        if let Err(error) = self.loading.menu_event(&Loop(event_loop), input::window_event(event)) {
+            self.loading.error = Some(error);
+            event_loop.exit();
+        }
+    }
+
+    pub fn dispatch_pad_state(
+        &mut self,
+        event_loop: &dyn horizon_client_platform::EventLoopCtl,
+        state: horizon_client::gamepad::PadState,
+    ) {
+        use horizon_client::gamepad::{Button, GlyphStyle};
+        if !self.loading.settings.controller.enabled {
+            self.pad_edges.cancel();
+            return;
+        }
+        let settings = &self.loading.settings.controller;
+        let state = settings.map_cafe_face_buttons(state, GlyphStyle::Nintendo);
+        for (button, down) in self.pad_edges.update(&state, settings.trigger_threshold) {
+            let key = match button {
+                Button::DPadUp => KeyCode::ArrowUp,
+                Button::DPadDown => KeyCode::ArrowDown,
+                Button::DPadLeft => KeyCode::ArrowLeft,
+                Button::DPadRight => KeyCode::ArrowRight,
+                Button::South => KeyCode::Enter,
+                Button::East | Button::Start => KeyCode::Escape,
+                _ => continue,
+            };
+            if let Err(error) = self.loading.menu_event(&Loop(event_loop), input::key(key, down)) {
+                self.loading.error = Some(error);
+                event_loop.exit();
+                break;
+            }
+        }
+    }
+
+    /// Draw one original menu batch at the DRC layout size and lend it, with
+    /// current artwork, to a host that presents both Cafe displays.
+    pub fn draw(&mut self, presenter: &mut dyn CafeLoadingPresenter) -> Result<bool> {
+        self.draw_traced(presenter, None)
+    }
+
+    /// Draw one frame with bounded phase markers when the Cafe host is tracing
+    /// a specific event-loop iteration.
+    pub fn draw_traced(
+        &mut self,
+        presenter: &mut dyn CafeLoadingPresenter,
+        trace_iteration: Option<u32>,
+    ) -> Result<bool> {
+        let size = presenter.layout_viewport();
+        let targets = presenter.target_viewports();
+        if size.contains(&0) || targets.iter().any(|r| r[2] == 0 || r[3] == 0) {
+            return Err("Cafe loading presenter returned an empty viewport".into());
+        }
+        if let Some(iteration) = trace_iteration {
+            log::info!("Horizon Cafe loading draw host_iteration={iteration}");
+        }
+        self.loading.cafe_viewport = size;
+        presenter.prepare_loading(self.loading_artwork())?;
+        let mut batch = HudBatch::new(size, self.loading.settings.gui_scale_inputs());
+        self.loading.draw_menu(&mut batch);
+        self.loading.menu.frame_drawn((batch.width, batch.height));
+        let mut frame = loading_frame(&batch);
+        frame.yaw = self.loading.panorama_rotation.update(
+            self.loading.started.elapsed().as_secs_f32(),
+            self.loading.settings.file.double("panoramaScrollSpeed") as f32,
+        );
+        let presented = presenter.present_loading(
+            self.loading_artwork(),
+            &frame,
+            size,
+            targets,
+            frame.ticks,
+            self.loading.settings.horizon.animated_textures,
+        )?;
+        if presented && self.loading.gui.is_some() && self.loading.menu.pending.is_none() {
+            self.loading.title_drawn = true;
+        }
+        Ok(presented)
+    }
+
+    fn loading_artwork(&self) -> CafeLoadingArtwork<'_> {
+        match &self.loading.gui {
+            Some(gui) => CafeLoadingArtwork {
+                atlas: &gui.atlas,
+                panorama: Some(&gui.panorama),
+                generation: gui.atlas.revision,
+            },
+            None => CafeLoadingArtwork {
+                atlas: &self.loading.boot,
+                panorama: None,
+                generation: self.loading.boot.revision,
+            },
+        }
+    }
+
+    /// Transfer a selected local world into Horizon's original Game path.
+    pub fn start_local_game(&mut self) -> Result<Option<CafeGameSession<'resources>>> {
+        if !matches!(
+            self.loading.menu.pending,
+            Some(PendingWorldEntry::Local { .. })
+        ) {
+            return Ok(None);
+        }
+        self.start_pending_game()
+    }
+
+    /// Transfer a queued world or server into Game once resources are ready.
+    /// In an opted-in Cemu control session, transfer the title as well so
+    /// Horizon's existing Game control and UI paths own it.
+    pub fn start_pending_game(&mut self) -> Result<Option<CafeGameSession<'resources>>> {
+        let entry_kind = match self.loading.menu.pending.as_ref() {
+            Some(PendingWorldEntry::Local { .. }) => CafeGameEntryKind::LocalWorld,
+            Some(PendingWorldEntry::Server { .. }) => CafeGameEntryKind::RemoteServer,
+            None if cafe_control_title_requested(
+                &self.loading.settings,
+                cfg!(target_os = "cafe"),
+            ) =>
+            {
+                CafeGameEntryKind::TitleScreen
+            }
+            Some(PendingWorldEntry::StudioReplay(_)) => {
+                return Err("Horizon Studio replay is unavailable on Cafe".into());
+            }
+            None => return Ok(None),
+        };
+        if self.status() != CafeLoadingStatus::ReadyForHandoff {
+            return Err(match entry_kind {
+                CafeGameEntryKind::RemoteServer => {
+                    "Cafe remote server requested before Loading was ready"
+                }
+                CafeGameEntryKind::LocalWorld => {
+                    "local Cafe world requested before Loading was ready"
+                }
+                CafeGameEntryKind::TitleScreen => {
+                    "Cafe control title requested before Loading was ready"
+                }
+            }
+            .into());
+        }
+        let result = self.start_pending_game_inner(entry_kind);
+        if let Err(error) = &result {
+            match entry_kind {
+                CafeGameEntryKind::LocalWorld => {
+                    self.local_failure = Some(error.to_string());
+                }
+                CafeGameEntryKind::RemoteServer => {
+                    self.remote_failure = Some(error.to_string());
+                }
+                CafeGameEntryKind::TitleScreen => {
+                    self.loading.error = Some(error.to_string().into());
+                }
+            }
+        }
+        result
+    }
+
+    fn start_pending_game_inner(
+        &mut self,
+        entry_kind: CafeGameEntryKind,
+    ) -> Result<Option<CafeGameSession<'resources>>> {
+        let loaded = self
+            .loading
+            .loaded
+            .take()
+            .ok_or("Cafe Loading has no completed resources")??;
+        let Loaded {
+            game_cpu,
+            root,
+            pack_error,
+            resources,
+            rest_loader,
+            pack,
+            gui: loaded_gui,
+            client_applies,
+            entity_models,
+            ..
+        } = loaded;
+        let mut options = self
+            .loading
+            .options
+            .take()
+            .ok_or("Cafe Loading options were already consumed")?;
+        options.resources = root;
+        options.world = None;
+        options.server = None;
+        let gui = self
+            .loading
+            .gui
+            .take()
+            .or(loaded_gui)
+            .ok_or("Cafe Loading has no menu bundle")?;
+        let audio = Audio::with_device(&pack.source, &self.loading.settings.sound_device);
+        horizon_client::lang::set(horizon_client::lang::Language::load(
+            &[&pack.source], &horizon_client::lang::code(),
+        ));
+        self.resources.set(resources).map_err(|_| "Cafe session already received resources")?;
+        let res = self.resources.get().expect("Cafe session resources assigned");
+        let Some(mut game) = start_game(
+            res,
+            pack,
+            gui,
+            options,
+            pack_error.or_else(|| self.loading.pack_error.take()),
+            audio,
+            self.loading.vanilla_root.clone(),
+            self.loading.started,
+            rest_loader,
+            Some(self.loading.settings.clone()),
+            game_cpu,
+            client_applies,
+            entity_models,
+        )?
+        else {
+            return Err("Cafe game handoff did not create Game".into());
+        };
+        let shell_pending = self.loading.menu.pending.clone();
+        self.loading.menu.handoff(&mut game);
+        self.loading.menu.pending = shell_pending;
+        game.world_renderer_ready = true;
+        game.apply_settings();
+        game.panorama_rotation = self.loading.panorama_rotation;
+        game.previous = Instant::now();
+        game.settings.file.set(
+            "startedCleanly",
+            horizon_client::options_file::V::Bool(true),
+        );
+        game.settings.save(&Game::options_path());
+        Ok(Some(CafeGameSession {
+            game,
+            entry_kind,
+            screenshot_worker: None,
+            #[cfg(target_os = "cafe")]
+            next_memory_sample: None,
+        }))
+    }
+
+    /// Report whether Loading is still running, ready for a handoff, or failed.
+    pub fn status(&self) -> CafeLoadingStatus {
+        if self.local_failure.is_some() {
+            CafeLoadingStatus::LocalWorldStartFailed
+        } else if self.remote_failure.is_some() {
+            CafeLoadingStatus::RemoteServerStartFailed
+        } else if self.failure_message().is_some() {
+            CafeLoadingStatus::Failed
+        } else if self.loading.loaded.is_some() && self.loading.ready_for_handoff() {
+            CafeLoadingStatus::ReadyForHandoff
+        } else {
+            CafeLoadingStatus::Loading
+        }
+    }
+
+    /// The loader's concrete failure message, if it has failed.
+    pub fn failure_message(&self) -> Option<String> {
+        if let Some(error) = &self.local_failure {
+            Some(error.clone())
+        } else if let Some(error) = &self.remote_failure {
+            Some(error.clone())
+        } else if let Some(error) = &self.loading.error {
+            Some(error.to_string())
+        } else {
+            match self.loading.loaded.as_ref() {
+                Some(Err(error)) => Some(error.clone()),
+                _ => None,
+            }
+        }
+    }
+}
+
+/// Cafe-owned driver for Horizon's original Game after a local title
+/// selection. It deliberately has no Winit window or WGPU renderer.
+pub struct CafeGameSession<'resources> {
+    game: Game<'resources>,
+    entry_kind: CafeGameEntryKind,
+    screenshot_worker: Option<std::thread::JoinHandle<()>>,
+    #[cfg(target_os = "cafe")]
+    next_memory_sample: Option<Instant>,
+}
+
+impl CafeGameSession<'_> {
+    #[cfg(target_os = "cafe")]
+    pub fn enable_hosted_return(&mut self) {
+        self.game.cafe_hosted = true;
+    }
+
+    #[cfg(target_os = "cafe")]
+    pub fn hosted_save_pending(&self) -> bool {
+        self.game.pending_save.as_ref().is_some_and(|save| save.quit)
+    }
+
+    #[cfg(target_os = "cafe")]
+    pub fn begin_hosted_save(&mut self) -> Result<()> {
+        self.game.begin_closing_save(true)
+    }
+
+    #[cfg(target_os = "cafe")]
+    pub fn hosted_needs_close(&self) -> bool {
+        !self.game.saved_for_exit && (self.game.session_lock.is_some()
+            || self.game.integrated.is_some() || self.game.remote.is_some())
+    }
+
+    /// False means the save barrier is still pending. Errors preserve it.
+    #[cfg(target_os = "cafe")]
+    pub fn poll_hosted_save(&mut self) -> Result<bool> {
+        self.game.poll_closing_save()
+    }
+
+    #[cfg(target_os = "cafe")]
+    pub fn draw_hosted_save(&mut self, presenter: &mut dyn CafeLoadingPresenter, failed: bool) -> Result<()> {
+        self.present_loading_frame(presenter, Some(failed)).map(|_| ())
+    }
+
+    #[cfg(target_os = "cafe")]
+    pub fn shutdown_hosted(&mut self) -> Result<()> {
+        self.game.pad_close_output();
+        let saved = self.game.save_for_exit();
+        self.game.finish_perf();
+        self.game.native_client_stopping();
+        self.game.native_client_stopped();
+        self.game.native_game_shutting_down();
+        saved
+    }
+
+    #[cfg(target_os = "cafe")]
+    pub fn drain_hosted_workers(&mut self) -> Result<()> {
+        self.game.rest_loader.take().map_or(Ok(()), WorldRestLoader::finish)
+    }
+
+    /// Keep Game's input and logical framebuffer calculations aligned with
+    /// the active GamePad layout. Invalid dimensions leave the last valid
+    /// Cafe size intact.
+    pub fn sync_framebuffer_size(&mut self, size: [u32; 2]) {
+        if !size.contains(&0) {
+            self.game.cafe_viewport = size;
+        }
+    }
+
+    /// Return the title entry this session was handed, even after Game has
+    /// consumed its pending entry while starting the connection or world.
+    pub fn entry_kind(&self) -> CafeGameEntryKind {
+        self.entry_kind
+    }
+
+    /// Snapshot before a frame: an async start may clear its state on failure.
+    pub fn starting_entry_kind(&self) -> Option<CafeGameEntryKind> {
+        cafe_starting_entry_kind(
+            self.game.pending_entry.as_ref(),
+            self.game.integrated_starting.is_some(),
+        )
+    }
+
+    /// Feed the host's canonical Cafe controller sample into the normal game
+    /// pad poll. `step` consumes it through `Game::poll_pads`, preserving the
+    /// game's bindings, edge detection, and controller settings.
+    pub fn feed_pad_state(&mut self, state: horizon_client::gamepad::PadState) {
+        self.game.pad.feed = Some(state);
+    }
+
+    /// Route a host window event through the game's normal input handling.
+    pub fn dispatch_event(
+        &mut self,
+        event_loop: &dyn horizon_client_platform::EventLoopCtl,
+        event: ClientWindowEvent,
+    ) {
+        self.game.handle_window_event(
+            &Loop(event_loop),
+            WindowId::dummy(),
+            input::window_event(event),
+            input_trace::InputOrigin::User,
+        );
+    }
+
+    pub fn dispatch_device_event(
+        &mut self,
+        event_loop: &dyn horizon_client_platform::EventLoopCtl,
+        event: ClientDeviceEvent,
+    ) {
+        let ClientDeviceEvent::MouseMotion { delta } = event;
+        self.game.handle_device_motion(&Loop(event_loop), delta);
+    }
+
+    /// Advance world-entry services and one normal game frame. The Cafe host
+    /// continues to own VPAD/touch polling and GX2 title/loading presentation.
+    pub fn step(&mut self, event_loop: &dyn horizon_client_platform::EventLoopCtl) -> Result<()> {
+        self.game.idle(&Loop(event_loop));
+        if let Some(error) = &self.game.error {
+            return Err(error.to_string().into());
+        }
+        Ok(())
+    }
+
+    /// Run one original Game redraw through the Cafe host. This follows the
+    /// same redraw event path as desktop: world updates, player spawn, fixed
+    /// ticks, and then the original CPU Frame are produced in their normal
+    /// order. The host remains responsible for polling Cafe devices.
+    pub fn frame(
+        &mut self,
+        event_loop: &dyn horizon_client_platform::EventLoopCtl,
+        backend: &mut dyn CafeGameBackend,
+    ) -> Result<bool> {
+        if let Some(result) = self.game.cafe_screenshot_result.as_ref() {
+            match result.try_recv() {
+                Ok(value) => {
+                    self.game.cafe_screenshot_result = None;
+                    if let Some(reply) = self.game.pending_screenshot.take() {
+                        let _ = reply.send(value);
+                    }
+                }
+                Err(std::sync::mpsc::TryRecvError::Disconnected) => {
+                    self.game.cafe_screenshot_result = None;
+                    if let Some(reply) = self.game.pending_screenshot.take() {
+                        let _ = reply.send(
+                            serde_json::json!({"error": "screenshot encoder stopped"}).to_string(),
+                        );
+                    }
+                }
+                Err(std::sync::mpsc::TryRecvError::Empty) => {}
+            }
+        }
+        #[cfg(target_os = "cafe")]
+        {
+            use horizon_client_platform::cafe_profile::{Phase, phase};
+            phase(if !self.world_loading_complete() {
+                Phase::WorldEntry
+            } else if self.game.title.is_some() {
+                Phase::Title
+            } else if self.game.screen == Screen::Playing {
+                Phase::Playing
+            } else {
+                Phase::Menu
+            });
+        }
+        {
+            horizon_client_platform::cafe_span!(Idle);
+            self.game.idle(&Loop(event_loop));
+        }
+        if let Some(error) = &self.game.error {
+            return Err(error.to_string().into());
+        }
+        if self.game.pending_save.is_some() {
+            return Ok(false);
+        }
+
+        horizon_client_platform::cafe_span!(artwork, StageArtwork);
+        backend.prepare_game_artwork(CafeGameArtwork {
+            gamma: self.game.settings.gamma,
+            atlas: &self.game.gui.atlas,
+            cit_glints: self
+                .game
+                .pack
+                .item_renderer
+                .cit
+                .as_ref()
+                .map(|cit| &cit.glint_textures),
+            panorama: &self.game.gui.panorama,
+            terrain_pixels: &self.game.pack.render.pixels,
+            terrain_sprite_size: self.game.pack.render.sprite_size,
+            terrain_layers: self.game.pack.render.texture_layers,
+            hud_generation: self.game.gui.atlas.revision,
+            terrain_generation: self.game.pack.render.generation,
+        })?;
+        #[cfg(target_os = "cafe")]
+        drop(artwork);
+        let capture = std::mem::take(&mut self.game.cafe_screenshot_requested);
+        if let Some(output) = capture {
+            backend.request_screenshot(output);
+        }
+        self.game.frame_drawn = false;
+        self.game.handle_window_event_with_cafe(
+            &Loop(event_loop),
+            WindowEvent::RedrawRequested,
+            Some(backend),
+        );
+        let frame_drawn = self.game.frame_drawn;
+        #[cfg(target_os = "cafe")]
+        self.sample_terrain_memory(
+            backend,
+            frame_drawn || backend.last_game_frame_was_partial(),
+        );
+        if capture.is_some() {
+            let image = backend
+                .take_screenshot()
+                .unwrap_or_else(|| Err("Cafe frame was not captured".into()));
+            let (sender, receiver) = std::sync::mpsc::channel();
+            match std::thread::Builder::new().name("Cafe screenshot encoder".into()).spawn(move || {
+                let response = match image.and_then(encode_cafe_screenshot) {
+                    Ok((width, height, png)) => serde_json::json!({"ok": true, "width": width, "height": height, "png_base64": horizon_client::lan::base64(&png)}),
+                    Err(error) => serde_json::json!({"error": error}),
+                };
+                let _ = sender.send(response.to_string());
+            }) {
+                Ok(worker) => {
+                    if let Some(previous) = self.screenshot_worker.replace(worker) {
+                        let _ = previous.join();
+                    }
+                    self.game.cafe_screenshot_result = Some(receiver);
+                },
+                Err(error) => {
+                    if let Some(reply) = self.game.pending_screenshot.take() {
+                        let _ = reply.send(serde_json::json!({"error": format!("cannot start screenshot encoder: {error}")}).to_string());
+                    }
+                }
+            }
+        }
+        if !frame_drawn && !backend.last_game_frame_was_partial() {
+            // The batch for a rejected Cafe frame may contain glyphs that the
+            // native atlas did not receive. Rebuild them from Horizon state
+            // before the next layout, matching renderer-recreation recovery.
+            self.game.gui.atlas.font.reset_cache();
+            horizon_client::ui_theme::reset_atlas();
+        }
+        if let Some(error) = &self.game.error {
+            return Err(error.to_string().into());
+        }
+        Ok(frame_drawn)
+    }
+
+    #[cfg(target_os = "cafe")]
+    fn sample_terrain_memory(&mut self, backend: &dyn CafeGameBackend, presented: bool) {
+        if self.game.title.is_some() || self.game.player.is_none() {
+            if !self.game.cafe_terrain_clear_pending && self.next_memory_sample.take().is_some() {
+                horizon_client_platform::cafe_memory::report("terrain.left_world");
+            }
+            return;
+        }
+        let now = Instant::now();
+        let first = self.next_memory_sample.is_none();
+        if !presented
+            || !self.world_loading_complete()
+            || self.game.pack_reload.is_some()
+            || self
+                .game
+                .remote
+                .as_ref()
+                .is_some_and(|r| r.level_load.is_active())
+            || (first && self.game.screen != Screen::Playing)
+            || self.next_memory_sample.is_some_and(|next| now < next)
+        {
+            return;
+        }
+        self.next_memory_sample = Some(now + Duration::from_secs(5));
+        let sample = now.duration_since(self.game.started).as_millis();
+        let label = if first {
+            "terrain.first_frame"
+        } else {
+            "terrain.streaming"
+        };
+        horizon_client_platform::cafe_memory::report(label);
+        self.game
+            .cafe_terrain_census(sample, backend.terrain_buffer_census());
+        if let Some(server) = &self.game.integrated {
+            server.post(move |game| game.cafe_terrain_census(sample, None));
+        }
+    }
+
+    /// Whether Horizon's original world-entry loading overlays have ended.
+    /// This is independent of whether the platform accepted the latest frame.
+    pub fn world_loading_complete(&self) -> bool {
+        self.game.integrated_starting.is_none() && self.game.pending_entry.is_none()
+    }
+
+    /// Present a supported world-entry loading frame through the Cafe host.
+    /// Returns `None` after the original loading screen has ended.
+    pub fn draw_loading(
+        &mut self,
+        presenter: &mut dyn CafeLoadingPresenter,
+    ) -> Result<Option<bool>> {
+        self.present_loading_frame(presenter, None)
+    }
+
+    /// Reuse the original Game loading HUD while its integrated server opens
+    /// the selected world. Cafe has no world renderer yet; once this screen is
+    /// gone, the host keeps the last presented shell until a Cafe renderer is
+    /// available in a later slice.
+    fn present_loading_frame(
+        &mut self,
+        presenter: &mut dyn CafeLoadingPresenter,
+        saving_failed: Option<bool>,
+    ) -> Result<Option<bool>> {
+        let game = &mut self.game;
+        let size = presenter.layout_viewport();
+        if size.contains(&0) {
+            return Err("Cafe loading presenter returned an empty viewport".into());
+        }
+
+        game.gui.atlas.pack_pixels();
+        game.pack.render.pixels.pack();
+        game.gui.atlas.font.begin_frame();
+        if game.clock.still() {
+            game.gui.atlas.font.reseed(game.visual_ticks() as i64);
+        }
+        let mut hud = HudBatch::new(size, game.settings.gui_scale_inputs());
+        if let Some(failed) = saving_failed {
+            let message = if failed {
+                "Save failed. A retries. Use HOME for system exit."
+            } else {
+                "Saving world..."
+            };
+            horizon_client::level_loading::draw_progress(&mut hud, &game.gui.atlas, message, 0.0);
+        } else if let Some(starting) = &game.integrated_starting {
+            let upgrade = starting.handle.upgrade();
+            if upgrade.is_file_fixing() {
+                horizon_client::widgets::begin_screen(|| {
+                    horizon_client::widgets::ScreenInfo::new(
+                        "file_fixer",
+                        screen_info::tr("upgradeWorld.title", &[]),
+                    )
+                });
+                horizon_client::level_loading::draw_file_fixer(
+                    &mut hud,
+                    &game.gui.atlas,
+                    upgrade,
+                    game.cursor,
+                );
+            } else {
+                let progress = Some(starting.handle.load_view())
+                    .filter(|view| view.has_progress())
+                    .map(|view| view.server_progress());
+                horizon_client::widgets::begin_screen(|| {
+                    screen_info::level_loading(progress, &screen_info::tr)
+                });
+                let (width, height) = (hud.width, hud.height);
+                horizon_client::ui::menu_background(
+                    &mut hud,
+                    &game.gui.atlas,
+                    0.0,
+                    0.0,
+                    width,
+                    height,
+                    false,
+                );
+                let view = game
+                    .integrated_starting
+                    .as_ref()
+                    .map(|starting| starting.handle.load_view().clone());
+                let status = |x: i32, z: i32| view.as_ref().and_then(|view| view.status(x, z));
+                let progress = view
+                    .as_ref()
+                    .is_some_and(|view| view.has_progress())
+                    .then_some(game.loading_progress);
+                horizon_client::level_loading::draw(
+                    &mut hud,
+                    &game.gui.atlas,
+                    Some(&status),
+                    progress,
+                );
+            }
+        } else if game.pending_entry.is_some() {
+            let Some(loader) = game.rest_loader.as_ref() else {
+                return Ok(None);
+            };
+            horizon_client::widgets::begin_screen(|| {
+                screen_info::level_loading(Some(loader.progress.fraction()), &screen_info::tr)
+            });
+            horizon_client::level_loading::draw_progress(
+                &mut hud,
+                &game.gui.atlas,
+                loader.progress.line(),
+                loader.progress.fraction(),
+            );
+        } else {
+            return Ok(None);
+        }
+
+        let artwork = CafeLoadingArtwork {
+            atlas: &game.gui.atlas,
+            panorama: Some(&game.gui.panorama),
+            generation: game.gui.atlas.revision,
+        };
+        presenter.prepare_loading(CafeLoadingArtwork {
+            atlas: artwork.atlas,
+            panorama: artwork.panorama,
+            generation: artwork.generation,
+        })?;
+        let targets = presenter.target_viewports();
+        if targets.iter().any(|rect| rect[2] == 0 || rect[3] == 0) {
+            return Err("Cafe loading presenter returned an empty viewport".into());
+        }
+        let frame = loading_frame(&hud);
+        let presented = presenter.present_loading(
+            artwork,
+            &frame,
+            size,
+            targets,
+            game.visual_ticks(),
+            game.settings.horizon.animated_textures,
+        )?;
+        Ok(Some(presented))
+    }
+
+    pub fn shutdown(&mut self) {
+        self.game.shut_down();
+        self.game.native_client_stopped();
+        self.game.native_game_shutting_down();
+    }
+}
+
+impl Drop for CafeGameSession<'_> {
+    fn drop(&mut self) {
+        if let Some(worker) = self.screenshot_worker.take() {
+            let _ = worker.join();
+        }
+    }
+}
+
+/// Cafe loop driver; the returned session remains owned by the caller.
+pub trait CafeLoadingHost: horizon_client_platform::EventLoopCtl {
+    fn drive_loading(&mut self, session: &mut CafeLoadingSession<'_>) -> Result<()>;
+}
+
+pub enum CafeRunOutcome {
+    Finished,
+    Loading(CafeLoadingResult),
+}
+
+/// The public outcome owns only status and failure information. The game and its
+/// borrowed collision and motion resources have already left the native loop.
+pub struct CafeLoadingResult {
+    status: CafeLoadingStatus,
+    failure: Option<String>,
+}
+
+impl CafeLoadingResult {
+    pub fn status(&self) -> CafeLoadingStatus { self.status }
+    pub fn failure_message(&self) -> Option<String> { self.failure.clone() }
+}
+
+pub(crate) fn run_hosted_cafe(options: Options, host: &mut dyn CafeLoadingHost) -> Result<CafeRunOutcome> {
+    let mut outcome = CafeRunOutcome::Finished;
+    let result = run_with_loading(options, Default::default(), true, |options, settings, root, pack_error, started| {
+        let resources = std::cell::OnceCell::new();
+        let mut session = CafeLoadingSession {
+            loading: resource_loader::create_loading(options, settings, root, pack_error, started)?,
+            resources: &resources,
+            pad_edges: Default::default(),
+            local_failure: None,
+            remote_failure: None,
+        };
+        let driven = host.drive_loading(&mut session);
+        let drained = session.drain_hosted();
+        outcome = CafeRunOutcome::Loading(CafeLoadingResult {
+            status: session.status(),
+            failure: session.failure_message(),
+        });
+        driven.and(drained)
+    });
+    narrator::stop();
+    result.map(|()| outcome)
+}
+
+struct Loop<'a>(&'a dyn horizon_client_platform::EventLoopCtl);
+
+impl EventLoopCtl for Loop<'_> {
+    fn exit(&self) { self.0.exit(); }
+
+    fn set_control_flow(&self, flow: ControlFlow) {
+        use horizon_client_platform::EventLoopControl;
+        self.0.set_control_flow(match flow {
+            ControlFlow::Poll => EventLoopControl::Poll,
+            ControlFlow::Wait => EventLoopControl::WaitUntil(Instant::now() + Duration::from_millis(16)),
+            ControlFlow::WaitUntil(when) => EventLoopControl::WaitUntil(when),
+        });
+    }
+}
+
+#[path = "cafe/input.rs"]
+mod input;
+
+pub fn hosted_world_profile_matches(
+    saved: Option<[i32; 4]>,
+    name: &str,
+    online_uuid: Option<u128>,
+) -> bool {
+    let uuid = online_uuid
+        .unwrap_or_else(|| horizon_protocol::crypto::offline_uuid(name))
+        .to_be_bytes();
+    saved.is_some_and(|saved| saved.into_iter().zip(uuid.chunks_exact(4))
+        .all(|(word, bytes)| word.to_be_bytes() == bytes))
+}
+
+pub fn hosted_world_version(path: &std::path::Path) -> Option<String> {
+    let root = horizon_client::save::read_dat(&path.join("level.dat"))?;
+    match root.get("Data")?.get("Version")?.get("Name")? {
+        horizon_core::nbt::Tag::String(text) => Some(text.to_string_lossy()),
+        _ => None,
+    }
+}
