+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct HorizonTerrainVertex {
+   float position[4];
+   float color[3];
+   float uv[2];
+   float cutout;
+} HorizonTerrainVertex;
+typedef struct HorizonGx2Terrain HorizonGx2Terrain;
+typedef struct HorizonGx2TerrainSection HorizonGx2TerrainSection;
+/* The callback fills the mapped vertices synchronously and does not retain
+ * the pointer. A nonzero result discards the new section. */
+typedef int (*HorizonTerrainFillVertices)(void *context, HorizonTerrainVertex *vertices,
+                                          uint32_t count);
+
+/* The callback is synchronous and receives the surface pitch in pixels. */
+typedef int (*HorizonTerrainFillTexture)(void *context, uint8_t *pixels, uint32_t pitch);
+int horizon_gx2_terrain_create_mapped(HorizonGx2Terrain **out, const void *gfd,
+                                     uint32_t width, uint32_t height,
+                                     HorizonTerrainFillTexture fill, void *context);
+int horizon_gx2_terrain_create(HorizonGx2Terrain **out, const void *gfd,
+                               uint32_t width, uint32_t height,
+                               const uint8_t *rgba, size_t length);
+void horizon_gx2_terrain_destroy(HorizonGx2Terrain *terrain);
+uint32_t horizon_gx2_terrain_index_allocation_bytes(const HorizonGx2Terrain *terrain);
+/* Count is the canonical four vertices per quad. On error the output handle
+ * and allocation size remain zero. Empty sections do not call fill. */
+int horizon_gx2_terrain_section_create(HorizonGx2TerrainSection **out,
+                                      uint32_t count, HorizonTerrainFillVertices fill,
+                                      void *context, uint32_t *allocation_bytes);
+/* Upload before drawing a new frame, after the preceding WHB finish. */
+int horizon_gx2_terrain_lightmap(HorizonGx2Terrain *terrain, const uint8_t rgba[16 * 16 * 4]);
+void horizon_gx2_terrain_wait_idle(void);
+void horizon_gx2_terrain_section_destroy(HorizonGx2TerrainSection *section);
+int horizon_gx2_terrain_draw(HorizonGx2Terrain *terrain,
+                            HorizonGx2TerrainSection *section,
+                            uint32_t target_width, uint32_t target_height,
+                            uint32_t x, uint32_t y, uint32_t width, uint32_t height,
+                            const float clip_rows[16], const float section_origin[4],
+                            const float fog_color[4], const float fog_ranges[4]);
diff --git a/wiiu/gx2_terrain/terrain.vert b/wiiu/gx2_terrain/terrain.vert
new file mode 100644
index 0000000000000000000000000000000000000000..9a272f1f0c5bdd9059dab17fae5bf130d08a007d
--- /dev/null
+++ b/wiiu/gx2_terrain/terrain.vert
@@ -0,0 +1,30 @@
+#version 330
+layout(location = 0) in vec4 aPosition;
+layout(location = 1) in vec3 aColor;
+layout(location = 2) in vec2 aUv;
+layout(location = 3) in float aCutout;
+uniform sampler2D uLightmap;
+uniform vec4 uClipX;
+uniform vec4 uClipY;
+uniform vec4 uClipZ;
+uniform vec4 uClipW;
+uniform vec4 uSectionOrigin;
+out vec3 vColor;
+out vec2 vUv;
+out float vCutout;
+out vec2 vFogDistance;
+void main() {
+    vec3 local = aPosition.xyz;
+    gl_Position = vec4(dot(uClipX.xyz, local) + uClipX.w,
+                       dot(uClipY.xyz, local) + uClipY.w,
+                       dot(uClipZ.xyz, local) + uClipZ.w,
+                       dot(uClipW.xyz, local) + uClipW.w);
+    float packedLight = aPosition.w;
+    vec2 levels = min(vec2(floor(packedLight / 256.0), mod(packedLight, 256.0)), vec2(240.0));
+    vec2 lightUv = levels / 256.0 + vec2(0.5 / 16.0);
+    vColor = aColor * textureLod(uLightmap, lightUv, 0.0).rgb;
+    vUv = aUv;
+    vCutout = aCutout;
+    vec3 relative = local + uSectionOrigin.xyz;
+    vFogDistance = vec2(length(relative), max(length(relative.xz), abs(relative.y)));
+}
diff --git a/wiiu/gx2_terrain/terrain_buffers.h b/wiiu/gx2_terrain/terrain_buffers.h
new file mode 100644
index 0000000000000000000000000000000000000000..b8764c56eacf6a470d73b5517037a5886136ceb6
--- /dev/null
+++ b/wiiu/gx2_terrain/terrain_buffers.h
@@ -0,0 +1,108 @@
+#pragma once
+
+/* Private GX2 buffer lifecycle, shared with the host test's SDK stubs. */
+enum { TERRAIN_INDEX_QUADS = (UINT16_MAX + 1) / 4 };
+
+struct HorizonGx2TerrainSection {
+   GX2RBuffer buffer;
+   uint32_t vertex_count;
+};
+
+static void terrain_buffer_release(GX2RBuffer *buffer)
+{
+   if (GX2RBufferExists(buffer)) GX2RDestroyBufferEx(buffer, 0);
+   *buffer = (GX2RBuffer){0};
+}
+
+static int terrain_buffer_create(GX2RBuffer *buffer, GX2RResourceFlags binding,
+                                 uint32_t element_size, uint32_t element_count,
+                                 uint32_t *allocation_bytes)
+{
+   const GX2RResourceFlags flags = binding | GX2R_RESOURCE_USAGE_CPU_WRITE |
+      GX2R_RESOURCE_USAGE_GPU_READ;
+   uint32_t alignment = GX2RGetBufferAlignment(flags);
+   uint64_t payload = (uint64_t)element_size * element_count;
+   if (!alignment || payload > UINT32_MAX - (alignment - 1)) return -1;
+   *buffer = (GX2RBuffer){ .flags = flags, .elemSize = element_size, .elemCount = element_count };
+   uint32_t bytes = GX2RGetBufferAllocationSize(buffer);
+   if (bytes < payload) return -1;
+   if (!GX2RCreateBuffer(buffer)) return -2;
+   *allocation_bytes = bytes;
+   return 0;
+}
+
+static int terrain_index_buffer_create(GX2RBuffer *buffer, uint32_t *allocation_bytes)
+{
+   int result = terrain_buffer_create(buffer, GX2R_RESOURCE_BIND_INDEX_BUFFER,
+                                      sizeof(uint16_t), TERRAIN_INDEX_QUADS * 6,
+                                      allocation_bytes);
+   if (result) return result;
+   uint16_t *indices = GX2RLockBufferEx(buffer, 0);
+   if (!indices) return -3;
+   /* Cafe writes big-endian uint16_t, selected by GX2_INDEX_TYPE_U16. */
+   const uint16_t corners[] = { 0, 1, 2, 0, 2, 3 };
+   for (uint32_t q = 0; q < TERRAIN_INDEX_QUADS; ++q) {
+      for (uint32_t i = 0; i < 6; ++i) indices[q * 6 + i] = (uint16_t)(q * 4 + corners[i]);
+   }
+   GX2RUnlockBufferEx(buffer, 0);
+   return 0;
+}
+
+int horizon_gx2_terrain_section_create(HorizonGx2TerrainSection **out,
+                                      uint32_t count, HorizonTerrainFillVertices fill,
+                                      void *context, uint32_t *allocation_bytes)
+{
+   if (!out || !allocation_bytes) return -1;
+   *out = NULL;
+   *allocation_bytes = 0;
+   if (count % 4 || (count && !fill)) return -1;
+   /* The fill callback also borrows the mapped bytes as a Rust slice. */
+#if PTRDIFF_MAX < UINT32_MAX
+   if (count > PTRDIFF_MAX / sizeof(HorizonTerrainVertex))
+      return -1;
+#endif
+   HorizonGx2TerrainSection *section = calloc(1, sizeof(*section));
+   if (!section) return -2;
+   section->vertex_count = count;
+   uint32_t bytes = 0;
+   int result = 0;
+   if (count) {
+      result = terrain_buffer_create(&section->buffer, GX2R_RESOURCE_BIND_VERTEX_BUFFER,
+                                     sizeof(HorizonTerrainVertex), count, &bytes);
+      if (result) goto fail;
+      HorizonTerrainVertex *vertices = GX2RLockBufferEx(&section->buffer, 0);
+      if (!vertices) { result = -3; goto fail; }
+      result = fill(context, vertices, count);
+      GX2RUnlockBufferEx(&section->buffer, 0);
+      if (result) { result = -4; goto fail; }
+   }
+   *out = section;
+   *allocation_bytes = bytes;
+   return 0;
+fail:
+   /* The buffer was never submitted, so it does not have to wait for GX2. */
+   terrain_buffer_release(&section->buffer);
+   free(section);
+   return result;
+}
+
+void horizon_gx2_terrain_section_destroy(HorizonGx2TerrainSection *section)
+{
+   if (!section) return;
+   if (GX2RBufferExists(&section->buffer)) GX2DrawDone();
+   terrain_buffer_release(&section->buffer);
+   free(section);
+}
+
+static void terrain_draw_indexed(GX2RBuffer *quad_indices, uint32_t vertex_count)
+{
+   uint32_t remaining = vertex_count / 4;
+   uint32_t base_vertex = 0;
+   while (remaining) {
+      uint32_t quads = remaining < TERRAIN_INDEX_QUADS ? remaining : TERRAIN_INDEX_QUADS;
+      GX2RDrawIndexed(GX2_PRIMITIVE_MODE_TRIANGLES, quad_indices, GX2_INDEX_TYPE_U16,
+                      quads * 6, 0, base_vertex, 1);
+      remaining -= quads;
+      base_vertex += quads * 4;
+   }
+}
diff --git a/wiiu/gx2_terrain/tests/buffers.c b/wiiu/gx2_terrain/tests/buffers.c
new file mode 100644
index 0000000000000000000000000000000000000000..f76f4ff14ccf35c7d65707f54dbae6268c37e8dd
--- /dev/null
+++ b/wiiu/gx2_terrain/tests/buffers.c
@@ -0,0 +1,205 @@
+/* Host regression: cc -std=c11 -Wall -Wextra -Werror buffers.c -o buffers && ./buffers */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "../terrain.h"
+
+/* Stub only the SDK operations used by the production buffer code. */
+typedef uint32_t GX2RResourceFlags;
+typedef struct {
+   GX2RResourceFlags flags;
+   uint32_t elemSize, elemCount;
+   void *buffer;
+} GX2RBuffer;
+enum {
+   GX2R_RESOURCE_USAGE_CPU_WRITE = 1,
+   GX2R_RESOURCE_USAGE_GPU_READ = 2,
+   GX2R_RESOURCE_BIND_VERTEX_BUFFER = 4,
+   GX2R_RESOURCE_BIND_INDEX_BUFFER = 8,
+   GX2_PRIMITIVE_MODE_TRIANGLES = 4,
+   GX2_INDEX_TYPE_U16 = 4,
+};
+
+static bool fail_calloc, fail_create, fail_map, reject_fill;
+static unsigned sections, buffers, mapped, waits, fills;
+static unsigned draw_count;
+static struct { uint32_t index_count, base_vertex; } draws[3];
+
+static void *section_calloc(size_t count, size_t bytes)
+{
+   if (fail_calloc) return NULL;
+   void *p = calloc(count, bytes);
+   assert(p);
+   ++sections;
+   return p;
+}
+
+static void section_free(void *p)
+{
+   assert(p && sections);
+   free(p);
+   --sections;
+}
+
+static bool GX2RBufferExists(GX2RBuffer *buffer)
+{
+   return buffer->buffer != NULL;
+}
+
+static uint32_t GX2RGetBufferAlignment(GX2RResourceFlags flags)
+{
+   assert(flags & GX2R_RESOURCE_USAGE_CPU_WRITE);
+   assert(flags & GX2R_RESOURCE_USAGE_GPU_READ);
+   return 64;
+}
+
+static uint32_t GX2RGetBufferAllocationSize(GX2RBuffer *buffer)
+{
+   uint32_t bytes = buffer->elemSize * buffer->elemCount;
+   return (bytes + 63) & ~63u;
+}
+
+static bool GX2RCreateBuffer(GX2RBuffer *buffer)
+{
+   if (fail_create) return false;
+   buffer->buffer = malloc(GX2RGetBufferAllocationSize(buffer));
+   assert(buffer->buffer);
+   ++buffers;
+   return true;
+}
+
+static void GX2RDestroyBufferEx(GX2RBuffer *buffer, unsigned flags)
+{
+   assert(GX2RBufferExists(buffer) && flags == 0 && !mapped && buffers);
+   free(buffer->buffer);
+   --buffers;
+}
+
+static void *GX2RLockBufferEx(GX2RBuffer *buffer, unsigned flags)
+{
+   assert(GX2RBufferExists(buffer) && flags == 0 && !mapped);
+   if (fail_map) return NULL;
+   ++mapped;
+   return buffer->buffer;
+}
+
+static void GX2RUnlockBufferEx(GX2RBuffer *buffer, unsigned flags)
+{
+   assert(GX2RBufferExists(buffer) && flags == 0 && mapped == 1);
+   --mapped;
+}
+
+static void GX2DrawDone(void) { ++waits; }
+
+static void GX2RDrawIndexed(unsigned mode, GX2RBuffer *buffer, unsigned type,
+                           uint32_t count, uint32_t offset, uint32_t base, unsigned instances)
+{
+   assert(mode == GX2_PRIMITIVE_MODE_TRIANGLES && type == GX2_INDEX_TYPE_U16);
+   assert(buffer->flags & GX2R_RESOURCE_BIND_INDEX_BUFFER);
+   assert(!mapped && instances == 1 && offset == 0);
+   assert(count <= buffer->elemCount && draw_count < 3);
+   draws[draw_count].index_count = count;
+   draws[draw_count++].base_vertex = base;
+}
+
+#define calloc section_calloc
+#define free section_free
+#include "../terrain_buffers.h"
+#undef calloc
+#undef free
+
+static int fill(void *context, HorizonTerrainVertex *dest, uint32_t count)
+{
+   assert(mapped && count == 4);
+   ++fills;
+   for (unsigned i = 0; i < count; ++i) {
+      dest[i] = (HorizonTerrainVertex){ .position = { *(const float *)context, i, 0, 1 } };
+   }
+   return reject_fill ? -1 : 0;
+}
+
+static void check_index_groups(void)
+{
+   GX2RBuffer indices = {0};
+   uint32_t bytes = 0;
+   assert(terrain_index_buffer_create(&indices, &bytes) == 0);
+   assert(bytes == 196608 && buffers == 1 && !mapped);
+   const uint16_t *entries = indices.buffer;
+   for (unsigned q = 0; q < TERRAIN_INDEX_QUADS; ++q) {
+      const unsigned expected[] = { 0, 1, 2, 0, 2, 3 };
+      for (unsigned i = 0; i < 6; ++i) assert(entries[q * 6 + i] == q * 4 + expected[i]);
+   }
+   assert(entries[indices.elemCount - 1] == UINT16_MAX);
+   terrain_draw_indexed(&indices, 0);
+   assert(draw_count == 0);
+   terrain_draw_indexed(&indices, TERRAIN_INDEX_QUADS * 4);
+   assert(draw_count == 1 && draws[0].index_count == 98304 && draws[0].base_vertex == 0);
+   draw_count = 0;
+   terrain_draw_indexed(&indices, (TERRAIN_INDEX_QUADS + 1) * 4);
+   assert(draw_count == 2 && draws[1].index_count == 6 && draws[1].base_vertex == 65536);
+   draw_count = 0;
+   terrain_draw_indexed(&indices, (TERRAIN_INDEX_QUADS * 2 + 3) * 4);
+   assert(draw_count == 3 && draws[2].index_count == 18 && draws[2].base_vertex == 131072);
+   terrain_buffer_release(&indices);
+   assert(!buffers);
+
+   fail_map = true;
+   assert(terrain_index_buffer_create(&indices, &bytes) == -3);
+   terrain_buffer_release(&indices);
+   assert(!buffers && !mapped);
+   fail_map = false;
+}
+
+static void check_upload_lifetimes(void)
+{
+   HorizonGx2TerrainSection *empty;
+   uint32_t bytes = UINT32_MAX;
+   assert(horizon_gx2_terrain_section_create(&empty, 0, NULL, NULL, &bytes) == 0);
+   assert(sections == 1 && !bytes && !buffers && !fills);
+   horizon_gx2_terrain_section_destroy(empty);
+   assert(!sections && !waits);
+
+   float old_x = -1.5f, new_x = 4.5f;
+   HorizonGx2TerrainSection *original;
+   assert(horizon_gx2_terrain_section_create(&original, 4, fill, &old_x, &bytes) == 0);
+   assert(sections == 1 && buffers == 1 && fills == 1 && bytes == 192 && !mapped);
+
+   HorizonGx2TerrainSection *replacement = original;
+   assert(horizon_gx2_terrain_section_create(&replacement, 5, fill, &new_x, &bytes) == -1);
+   assert(!replacement && !bytes);
+   assert(horizon_gx2_terrain_section_create(&replacement, UINT32_MAX & ~3u, fill, &new_x, &bytes) == -1);
+   assert(!replacement && !bytes && sections == 1 && buffers == 1);
+   assert(horizon_gx2_terrain_section_create(&replacement, 4, NULL, &new_x, &bytes) == -1);
+   fail_calloc = true;
+   assert(horizon_gx2_terrain_section_create(&replacement, 4, fill, &new_x, &bytes) == -2);
+   fail_calloc = false;
+   fail_create = true;
+   assert(horizon_gx2_terrain_section_create(&replacement, 4, fill, &new_x, &bytes) == -2);
+   fail_create = false;
+   fail_map = true;
+   assert(horizon_gx2_terrain_section_create(&replacement, 4, fill, &new_x, &bytes) == -3);
+   fail_map = false;
+   reject_fill = true;
+   assert(horizon_gx2_terrain_section_create(&replacement, 4, fill, &new_x, &bytes) == -4);
+   reject_fill = false;
+   assert(!replacement && !bytes && sections == 1 && buffers == 1 && !mapped && !waits);
+   assert(((HorizonTerrainVertex *)original->buffer.buffer)[0].position[0] == old_x);
+
+   assert(horizon_gx2_terrain_section_create(&replacement, 4, fill, &new_x, &bytes) == 0);
+   assert(bytes == 192 && sections == 2 && buffers == 2 && !mapped);
+   horizon_gx2_terrain_section_destroy(original);
+   assert(sections == 1 && buffers == 1 && waits == 1);
+   assert(((HorizonTerrainVertex *)replacement->buffer.buffer)[0].position[0] == new_x);
+   horizon_gx2_terrain_section_destroy(replacement);
+   assert(!sections && !buffers && waits == 2);
+}
+
+int main(void)
+{
+   check_index_groups();
+   check_upload_lifetimes();
+   puts("Indexed terrain buffer tests passed");
+   return 0;
+}
