diff --git a/wiiu/platform/src/cemu_global_session_lock.c b/wiiu/platform/src/cemu_global_session_lock.c
new file mode 100644
index 0000000000000000000000000000000000000000..cc042895e11e53f18c3289ee7b97047380e3251d
--- /dev/null
+++ b/wiiu/platform/src/cemu_global_session_lock.c
@@ -0,0 +1,86 @@
+/*
+ * Scratch Cemu diagnostic only. This process-global TCP endpoint serializes
+ * all worlds; it is not a per-world lock and is not verified on Wii U hardware.
+ * The source is linked only when HORIZON_WIIU_CEMU_GLOBAL_SESSION_LOCK=ON.
+ */
+#include <arpa/inet.h>
+#include <coreinit/thread.h>
+#include <errno.h>
+#include <netinet/in.h>
+#include <nsysnet/_socket.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#define HORIZON_CEMU_GLOBAL_SESSION_LOCK_PORT 48263u
+
+/* socket_lib_init has no result value. Initialize it once and leave it alive
+ * for the process; closing one SessionLock must not tear down other sockets. */
+static atomic_int s_socket_library_state;
+
+static void ensure_socket_library(void)
+{
+   int state = atomic_load_explicit(&s_socket_library_state, memory_order_acquire);
+   if (state == 2) {
+      return;
+   }
+
+   int uninitialized = 0;
+   if (atomic_compare_exchange_strong_explicit(&s_socket_library_state,
+                                               &uninitialized, 1,
+                                               memory_order_acq_rel,
+                                               memory_order_acquire)) {
+      socket_lib_init();
+      atomic_store_explicit(&s_socket_library_state, 2, memory_order_release);
+      return;
+   }
+
+   while (atomic_load_explicit(&s_socket_library_state, memory_order_acquire) != 2) {
+      OSSleepTicks(1);
+   }
+}
+
+static int32_t close_with_error(int fd)
+{
+   int error = errno;
+   (void)__rplwrap_socketclose(fd);
+   return -(error > 0 ? error : EIO);
+}
+
+int32_t horizon_wiiu_cemu_global_lock_open(void)
+{
+   ensure_socket_library();
+
+   const int fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+   if (fd < 0) {
+      return -(errno > 0 ? errno : EIO);
+   }
+
+   /* Reuse must stay disabled so another process cannot share this endpoint. */
+   const int reuse_address = 0;
+   if (setsockopt(fd, SOL_SOCKET, SO_REUSEADDR,
+                  &reuse_address, sizeof(reuse_address)) != 0) {
+      return close_with_error(fd);
+   }
+
+   struct sockaddr_in address = {0};
+   address.sin_family = AF_INET;
+   address.sin_port = htons((uint16_t)HORIZON_CEMU_GLOBAL_SESSION_LOCK_PORT);
+   address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+   if (bind(fd, (struct sockaddr *)&address, sizeof(address)) != 0) {
+      return close_with_error(fd);
+   }
+   if (listen(fd, 1) != 0) {
+      return close_with_error(fd);
+   }
+
+   return fd;
+}
+
+void horizon_wiiu_cemu_global_lock_close(int32_t fd)
+{
+   if (fd >= 0) {
+      (void)__rplwrap_socketclose(fd);
+   }
+}
diff --git a/wiiu/platform/src/hud.rs b/wiiu/platform/src/hud.rs
new file mode 100644
index 0000000000000000000000000000000000000000..02b54ce46c02320e7a37435b40563f987e57e193
--- /dev/null
+++ b/wiiu/platform/src/hud.rs
@@ -0,0 +1,615 @@
+//! Bridge for Horizon's HUD geometry and the native GX2 presenter.
+//!
+//! The caller still creates Horizon's batches and owns the GX2 render target.
+//! The C presenter copies the atlas at creation and reads frame data only
+//! during `draw`; the shader must outlive the presenter.
+
+use horizon_hud_data::{Blend, HudVertex, Patch};
+use std::ops::Range;
+
+#[cfg(feature = "horizon-hud")]
+pub mod horizon;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Error {
+    Invalid,
+    Unsupported,
+    AllocationFailed,
+    /// An unexpected result from the C presenter.
+    Backend(i32),
+}
+
+/// Rule data copied alongside one standalone CIT texture.
+#[cfg(feature = "horizon-hud")]
+#[repr(C)]
+pub struct CitSlot {
+    pub rgba: [f32; 4],
+    pub factors: [u32; 4],
+    pub blur: u32,
+    pub blend: u32,
+}
+
+/// Data from Horizon's HUD batch, kept borrowed through the draw call.
+pub struct Frame<'a> {
+    pub vertices: &'a [HudVertex],
+    pub runs: &'a [(Range<u32>, Blend)],
+    pub patches: &'a [Patch],
+    pub viewport: [u32; 2],
+    pub scale: f32,
+    pub pack_text_shader: bool,
+}
+
+#[cfg(any(test, all(feature = "cafe", target_arch = "powerpc")))]
+#[repr(C)]
+struct RawPatch {
+    x: u32,
+    y: u32,
+    width: u32,
+    height: u32,
+    rgba: *const u8,
+    length: usize,
+}
+
+#[cfg(any(test, all(feature = "cafe", target_arch = "powerpc")))]
+#[repr(C)]
+struct RawRun {
+    start: u32,
+    end: u32,
+    blend: u32,
+    clip: [u32; 4],
+}
+
+#[cfg(any(test, all(feature = "cafe", target_arch = "powerpc")))]
+#[repr(C)]
+struct RawFrame {
+    vertices: *const HudVertex,
+    vertex_count: u32,
+    runs: *const RawRun,
+    run_count: u32,
+    patches: *const RawPatch,
+    patch_count: u32,
+    viewport_width: u32,
+    viewport_height: u32,
+    scale: f32,
+    pack_text_shader: u32,
+}
+
+// Paired with the C presenter's assertions: Cafe uses 32-bit pointers and
+// size_t. These are ABI checks, independent of the host used for tests.
+#[cfg(all(feature = "cafe", target_arch = "powerpc"))]
+const _: () = {
+    use std::mem::{align_of, offset_of, size_of};
+    assert!(size_of::<RawRun>() == 28 && align_of::<RawRun>() == 4);
+    assert!(offset_of!(RawRun, start) == 0);
+    assert!(offset_of!(RawRun, end) == 4);
+    assert!(offset_of!(RawRun, blend) == 8);
+    assert!(offset_of!(RawRun, clip) == 12);
+    assert!(size_of::<RawPatch>() == 24 && align_of::<RawPatch>() == 4);
+    assert!(offset_of!(RawPatch, x) == 0);
+    assert!(offset_of!(RawPatch, y) == 4);
+    assert!(offset_of!(RawPatch, width) == 8);
+    assert!(offset_of!(RawPatch, height) == 12);
+    assert!(offset_of!(RawPatch, rgba) == 16);
+    assert!(offset_of!(RawPatch, length) == 20);
+    assert!(size_of::<RawFrame>() == 40 && align_of::<RawFrame>() == 4);
+    assert!(offset_of!(RawFrame, vertices) == 0);
+    assert!(offset_of!(RawFrame, vertex_count) == 4);
+    assert!(offset_of!(RawFrame, runs) == 8);
+    assert!(offset_of!(RawFrame, run_count) == 12);
+    assert!(offset_of!(RawFrame, patches) == 16);
+    assert!(offset_of!(RawFrame, patch_count) == 20);
+    assert!(offset_of!(RawFrame, viewport_width) == 24);
+    assert!(offset_of!(RawFrame, viewport_height) == 28);
+    assert!(offset_of!(RawFrame, scale) == 32);
+    assert!(offset_of!(RawFrame, pack_text_shader) == 36);
+    #[cfg(feature = "horizon-hud")]
+    {
+        assert!(size_of::<CitSlot>() == 40 && align_of::<CitSlot>() == 4);
+        assert!(offset_of!(CitSlot, factors) == 16);
+        assert!(offset_of!(CitSlot, blur) == 32);
+        assert!(offset_of!(CitSlot, blend) == 36);
+    }
+};
+
+// Own the C descriptors for exactly as long as the borrowed frame is in use.
+#[cfg(any(test, all(feature = "cafe", target_arch = "powerpc")))]
+struct Prepared<'a> {
+    frame: &'a Frame<'a>,
+    _extra_patches: &'a [Patch],
+    runs: Vec<RawRun>,
+    patches: Vec<RawPatch>,
+}
+
+#[cfg(any(test, all(feature = "cafe", target_arch = "powerpc")))]
+impl<'a> Prepared<'a> {
+    fn new(frame: &'a Frame<'a>) -> Result<Self, Error> {
+        Self::with_extra_patches(frame, &[])
+    }
+
+    fn with_extra_patches(frame: &'a Frame<'a>, extra: &'a [Patch]) -> Result<Self, Error> {
+        u32::try_from(frame.vertices.len()).map_err(|_| Error::Invalid)?;
+        u32::try_from(frame.runs.len()).map_err(|_| Error::Invalid)?;
+        let patch_count = extra
+            .len()
+            .checked_add(frame.patches.len())
+            .ok_or(Error::Invalid)?;
+        u32::try_from(patch_count).map_err(|_| Error::Invalid)?;
+        if frame.pack_text_shader {
+            return Err(Error::Unsupported);
+        }
+        let mut runs = Vec::with_capacity(frame.runs.len());
+        for (range, blend) in frame.runs {
+            let (blend, clip) = match blend {
+                Blend::Alpha => (0, [0; 4]),
+                Blend::Invert => (1, [0; 4]),
+                Blend::Additive => (2, [0; 4]),
+                Blend::Depth(clip) => (3, *clip),
+                Blend::Vignette => (4, [0; 4]),
+                Blend::EndPortal => (5, [0; 4]),
+                Blend::CitGlint(blend) => (6, [u32::from(*blend), 0, 0, 0]),
+                Blend::Omit => (7, [0; 4]),
+            };
+            runs.push(RawRun {
+                start: range.start,
+                end: range.end,
+                blend,
+                clip,
+            });
+        }
+        // Desktop updates animated sprites before uploading the frame's
+        // glyph patches. Preserve that order without cloning pixel buffers.
+        let patches = extra
+            .iter()
+            .chain(frame.patches)
+            .map(|p| RawPatch {
+                x: p.x,
+                y: p.y,
+                width: p.width,
+                height: p.height,
+                rgba: p.rgba.as_ptr(),
+                length: p.rgba.len(),
+            })
+            .collect();
+        Ok(Self {
+            frame,
+            _extra_patches: extra,
+            runs,
+            patches,
+        })
+    }
+
+    fn raw(&self) -> RawFrame {
+        RawFrame {
+            vertices: self.frame.vertices.as_ptr(),
+            vertex_count: self.frame.vertices.len() as u32,
+            runs: self.runs.as_ptr(),
+            run_count: self.runs.len() as u32,
+            patches: self.patches.as_ptr(),
+            patch_count: self.patches.len() as u32,
+            viewport_width: self.frame.viewport[0],
+            viewport_height: self.frame.viewport[1],
+            scale: self.frame.scale,
+            pack_text_shader: u32::from(self.frame.pack_text_shader),
+        }
+    }
+}
+
+fn validate_target_viewport(source: [u32; 2], target: [u32; 4]) -> Result<(), Error> {
+    let [source_width, source_height] = source;
+    let [x, y, width, height] = target;
+    if source_width == 0
+        || source_height == 0
+        || width == 0
+        || height == 0
+        || x.checked_add(width).is_none()
+        || y.checked_add(height).is_none()
+    {
+        return Err(Error::Invalid);
+    }
+
+    let target_scaled = u64::from(width) * u64::from(source_height);
+    let source_scaled = u64::from(height) * u64::from(source_width);
+    let difference = target_scaled.abs_diff(source_scaled);
+    let largest = target_scaled.max(source_scaled);
+    if difference > largest / 200 {
+        return Err(Error::Unsupported);
+    }
+    Ok(())
+}
+
+#[cfg(all(feature = "cafe", target_arch = "powerpc"))]
+mod cafe {
+    use super::*;
+    use std::{ffi::c_void, marker::PhantomData, ptr::NonNull};
+
+    extern "C" {
+        fn horizon_gx2_hud_create(
+            out: *mut *mut c_void,
+            gfd: *const c_void,
+            width: u32,
+            height: u32,
+            rgba: *const u8,
+            length: usize,
+            capacity: u32,
+        ) -> i32;
+        fn horizon_gx2_hud_draw(hud: *mut c_void, frame: *const RawFrame) -> i32;
+        fn horizon_gx2_hud_draw_to(
+            hud: *mut c_void,
+            frame: *const RawFrame,
+            x: u32,
+            y: u32,
+            width: u32,
+            height: u32,
+        ) -> i32;
+        fn horizon_gx2_hud_draw_to_output(
+            hud: *mut c_void,
+            frame: *const RawFrame,
+            x: u32,
+            y: u32,
+            width: u32,
+            height: u32,
+            output: u32,
+        ) -> i32;
+        fn horizon_gx2_hud_destroy(hud: *mut c_void);
+        #[cfg(feature = "horizon-hud")]
+        fn horizon_gx2_hud_set_glint_texture(
+            hud: *mut c_void,
+            width: u32,
+            height: u32,
+            rgba: *const u8,
+            length: usize,
+        ) -> i32;
+        #[cfg(feature = "horizon-hud")]
+        fn horizon_gx2_hud_set_glint_style(hud: *mut c_void, strength: f32, tint: *const f32);
+        #[cfg(feature = "horizon-hud")]
+        fn horizon_gx2_hud_set_end_portal(hud: *mut c_void, sprites: *const [f32; 4], time: f32);
+        #[cfg(feature = "horizon-hud")]
+        fn horizon_gx2_hud_set_cit_glints(
+            hud: *mut c_void,
+            width: u32,
+            height: u32,
+            pixels: *const u8,
+            length: usize,
+            slots: *const CitSlot,
+            count: u32,
+        ) -> i32;
+    }
+
+    fn result(code: i32) -> Result<(), Error> {
+        match code {
+            0 => Ok(()),
+            -1 => Err(Error::Invalid),
+            -2 => Err(Error::Unsupported),
+            -3 => Err(Error::AllocationFailed),
+            n => Err(Error::Backend(n)),
+        }
+    }
+
+    /// A render-thread-bound presenter. The compiled GFD stays borrowed until drop.
+    pub struct Presenter<'shader> {
+        hud: NonNull<c_void>,
+        _shader: PhantomData<&'shader [u8]>,
+        _thread: PhantomData<*mut ()>,
+    }
+
+    impl<'shader> Presenter<'shader> {
+        #[cfg(feature = "horizon-hud")]
+        pub(super) unsafe fn set_glint_texture(
+            &mut self,
+            width: u32,
+            height: u32,
+            rgba: &[u8],
+        ) -> Result<(), Error> {
+            result(horizon_gx2_hud_set_glint_texture(
+                self.hud.as_ptr(),
+                width,
+                height,
+                rgba.as_ptr(),
+                rgba.len(),
+            ))
+        }
+
+        #[cfg(feature = "horizon-hud")]
+        pub(super) fn set_glint_style(&mut self, strength: f32, color: u32) {
+            let [r, g, b, _] = color.to_le_bytes();
+            let tint = [r, g, b].map(|channel| f32::from(channel) / 255.0);
+            let tint = if color == 0 {
+                std::ptr::null()
+            } else {
+                tint.as_ptr()
+            };
+            unsafe { horizon_gx2_hud_set_glint_style(self.hud.as_ptr(), strength, tint) };
+        }
+
+        #[cfg(feature = "horizon-hud")]
+        pub(super) fn set_end_portal(&mut self, fill: horizon_hud_data::EndPortalFill) {
+            unsafe {
+                horizon_gx2_hud_set_end_portal(
+                    self.hud.as_ptr(),
+                    fill.sprites.as_ptr(),
+                    fill.game_time,
+                )
+            };
+        }
+
+        #[cfg(feature = "horizon-hud")]
+        pub(super) unsafe fn set_cit_glints(
+            &mut self,
+            size: [u32; 2],
+            pixels: &[u8],
+            slots: &[CitSlot],
+        ) -> Result<(), Error> {
+            let [width, height] = size;
+            let count = u32::try_from(slots.len()).map_err(|_| Error::Invalid)?;
+            result(horizon_gx2_hud_set_cit_glints(
+                self.hud.as_ptr(),
+                width,
+                height,
+                pixels.as_ptr(),
+                pixels.len(),
+                slots.as_ptr(),
+                count,
+            ))
+        }
+
+        /// # Safety
+        /// GX2 must be initialized and remain valid on this thread until drop.
+        /// `gfd` must be an aligned, complete, valid GFD compiled from the
+        /// presenter's shaders; the WUT GFD loader has no length argument.
+        pub unsafe fn new(
+            gfd: &'shader [u8],
+            width: u32,
+            height: u32,
+            rgba: &[u8],
+            capacity: u32,
+        ) -> Result<Self, Error> {
+            let mut hud = std::ptr::null_mut();
+            result(horizon_gx2_hud_create(
+                &mut hud,
+                gfd.as_ptr().cast(),
+                width,
+                height,
+                rgba.as_ptr(),
+                rgba.len(),
+                capacity,
+            ))?;
+            let hud = NonNull::new(hud).ok_or(Error::Invalid)?;
+            Ok(Self {
+                hud,
+                _shader: PhantomData,
+                _thread: PhantomData,
+            })
+        }
+
+        /// # Safety
+        /// The calling render thread must have a valid GX2 color target bound.
+        /// This changes GX2 render state.
+        pub unsafe fn draw(&mut self, frame: &Frame<'_>) -> Result<(), Error> {
+            let prepared = Prepared::new(frame)?;
+            result(horizon_gx2_hud_draw(self.hud.as_ptr(), &prepared.raw()))
+        }
+
+        /// Draw source-layout vertices into a target rectangle without changing
+        /// their normalization. The target must preserve the source aspect
+        /// ratio (within 0.5%); hosts can letterbox mismatched screens.
+        ///
+        /// # Safety
+        /// The calling render thread must have a valid GX2 color target bound.
+        /// `target` is `[x, y, width, height]` in that target and must fit its
+        /// bounds. This changes GX2 render state.
+        pub unsafe fn draw_to(&mut self, frame: &Frame<'_>, target: [u32; 4]) -> Result<(), Error> {
+            let prepared = Prepared::new(frame)?;
+            validate_target_viewport(frame.viewport, target)?;
+            result(horizon_gx2_hud_draw_to(
+                self.hud.as_ptr(),
+                &prepared.raw(),
+                target[0],
+                target[1],
+                target[2],
+                target[3],
+            ))
+        }
+
+        /// Draw on the specified WHB output, including depth-tested HUD runs.
+        ///
+        /// # Safety
+        /// The specified output must be the active GX2 target, and the HUD must
+        /// follow all world passes because its depth runs clear that output's depth.
+        pub unsafe fn draw_to_output(
+            &mut self,
+            frame: &Frame<'_>,
+            target: [u32; 4],
+            output: u32,
+        ) -> Result<(), Error> {
+            let prepared = Prepared::new(frame)?;
+            validate_target_viewport(frame.viewport, target)?;
+            result(horizon_gx2_hud_draw_to_output(
+                self.hud.as_ptr(),
+                &prepared.raw(),
+                target[0],
+                target[1],
+                target[2],
+                target[3],
+                output,
+            ))
+        }
+
+        #[cfg(feature = "horizon-hud")]
+        pub(super) unsafe fn draw_with_patches(
+            &mut self,
+            frame: &Frame<'_>,
+            extra: &[Patch],
+        ) -> Result<(), Error> {
+            let prepared = Prepared::with_extra_patches(frame, extra)?;
+            result(horizon_gx2_hud_draw(self.hud.as_ptr(), &prepared.raw()))
+        }
+
+        #[cfg(feature = "horizon-hud")]
+        pub(super) unsafe fn draw_with_patches_to_output(
+            &mut self,
+            frame: &Frame<'_>,
+            extra: &[Patch],
+            target: [u32; 4],
+            output: u32,
+        ) -> Result<(), Error> {
+            let prepared = Prepared::with_extra_patches(frame, extra)?;
+            validate_target_viewport(frame.viewport, target)?;
+            result(horizon_gx2_hud_draw_to_output(
+                self.hud.as_ptr(),
+                &prepared.raw(),
+                target[0],
+                target[1],
+                target[2],
+                target[3],
+                output,
+            ))
+        }
+    }
+
+    impl Drop for Presenter<'_> {
+        fn drop(&mut self) {
+            unsafe { horizon_gx2_hud_destroy(self.hud.as_ptr()) }
+        }
+    }
+}
+
+#[cfg(all(feature = "cafe", target_arch = "powerpc"))]
+pub use cafe::Presenter;
