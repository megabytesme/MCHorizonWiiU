+/// Cafe physical keyboard usages, using the game's existing USB key table
+/// for keys identified by the input bridge.
+#[cfg(target_os = "cafe")]
+pub fn raw_key_code(physical: winit::keyboard::PhysicalKey) -> u32 {
+    use winit::keyboard::{NativeKeyCode, PhysicalKey};
+
+    match physical {
+        PhysicalKey::Unidentified(NativeKeyCode::UsbHid(usage)) => u32::from(usage),
+        PhysicalKey::Unidentified(NativeKeyCode::Unidentified) => 0,
+        PhysicalKey::Code(code) => key_name(code)
+            .and_then(|name| {
+                crate::key_names::KEYBOARD
+                    .iter()
+                    .find(|(_, key)| *key == name)
+            })
+            .map_or(0, |(usage, _)| u32::try_from(*usage).unwrap_or(0)),
+    }
