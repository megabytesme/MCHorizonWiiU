+/// Run one launcher-owned game using the caller's native event and display loop.
+#[cfg(target_os = "cafe")]
+pub fn run_hosted_cafe(
+    host: &mut dyn game::CafeLoadingHost,
+    arguments: Vec<String>,
+    face_swap: [bool; 2],
+    session: Option<horizon_client::auth::AuthSession>,
+) -> crate::Result<game::CafeRunOutcome> {
+    let cwd = std::env::current_dir()?;
+    let launch = LaunchArguments::parse(
+        arguments.into_iter(),
+        &cwd,
+        &logging::game_home(),
+        std::env::var_os("HORIZON_HOME").as_deref(),
+    )?;
+    let options = game::Options::from_hosted_launch(launch.clone(), face_swap)?;
+    static INIT: std::sync::OnceLock<std::result::Result<(), String>> = std::sync::OnceLock::new();
+    INIT.get_or_init(|| {
+        install_cafe_mod_platform().map_err(|error| error.to_string())?;
+        initialize_engine(&launch);
+        let home = launch.context.home.clone();
+        logging::set_game_home(home.clone());
+        logging::init(&home, "Render thread");
+        log::info!("Horizon {}", crash::version());
+        game::startup_progress::install(false);
+        crash::install(home, "client");
+        install_engine_hooks();
+        Ok(())
+    }).as_ref().map_err(String::clone)?;
+    let _session = horizon_client::auth::HostedSession::enter(session);
+    let result = game::run_hosted_cafe(options, host);
+    logging::flush();
+    result
+}
+
+#[cfg(target_os = "cafe")]
+fn install_cafe_mod_platform() -> crate::Result<()> {
+    use horizon_mod_api_host::__private as api;
+    horizon_engine_slots::install_seal(mod_points::__private::seal)?;
+    api::initialize()?;
+    horizon_engine_slots::install_platform(horizon_engine_slots::Platform {
+        install_packages: api::install_packages,
+        install_registration_data: api::install_registration_data,
+        install_parts: api::install_parts,
+        profiler_is_enabled: api::profiler::is_enabled,
+        profiler_start: api::profiler::start,
+        profiler_stop: api::profiler::stop,
+        profiler_summary: api::profiler::summary,
+        profiler_firefox_profile: api::profiler::firefox_profile,
+    })?;
+    api::install(Default::default());
+    Ok(())
+}
+
+#[cfg(target_os = "cafe")]
+pub fn main_with_cafe_host(
+    _: (),
+    host: &mut dyn game::CafeLoadingHost,
+) -> game::CafeRunOutcome {
+    match run_hosted_cafe(host, std::env::args().skip(1).collect(), [false; 2], None) {
+        Ok(outcome) => outcome,
+        Err(error) => {
+            log::error!("Horizon Cafe startup: {error}");
+            game::CafeRunOutcome::Finished
+        }
+    }
+}
