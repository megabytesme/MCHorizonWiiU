diff --git a/wiiu/fs/available_space.c b/wiiu/fs/available_space.c
new file mode 100644
index 0000000000000000000000000000000000000000..f19f93ceb6d47fdadb6d180019d20d0f65769842
--- /dev/null
+++ b/wiiu/fs/available_space.c
@@ -0,0 +1,26 @@
+#include <coreinit/filesystem.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+/* Rust std has initialized FS before this is called. Each call has its own
+   client and command block, so concurrent callers do not share mutable state. */
+int32_t horizon_wiiu_available_space(const char *path, uint64_t *out)
+{
+   struct Query { FSClient client; FSCmdBlock cmd; };
+   struct Query *query = calloc(1, sizeof(*query));
+   if (!query) return FS_STATUS_FATAL_ERROR;
+   FSStatus status = FSAddClient(&query->client, FS_ERROR_FLAG_ALL);
+   if (status == FS_STATUS_OK) {
+      FSInitCmdBlock(&query->cmd);
+      uint64_t size = 0;
+      status = FSGetFreeSpaceSize(&query->client, &query->cmd, path, &size, FS_ERROR_FLAG_ALL);
+      FSStatus del_status = FSDelClient(&query->client, FS_ERROR_FLAG_ALL);
+      if (del_status != FS_STATUS_OK) {
+         /* The OS may still hold this client: retain its backing storage. */
+         return status == FS_STATUS_OK ? del_status : status;
+      }
+      if (status == FS_STATUS_OK) *out = size;
+   }
+   free(query);
+   return status;
+}
diff --git a/wiiu/fs/build.rs b/wiiu/fs/build.rs
new file mode 100644
index 0000000000000000000000000000000000000000..14abc2c6ce529369e6fd33882a458d70cac1716f
--- /dev/null
+++ b/wiiu/fs/build.rs
@@ -0,0 +1,27 @@
+use std::path::PathBuf;
+
+fn main() {
+    println!("cargo:rerun-if-changed=available_space.c");
+    println!("cargo:rerun-if-env-changed=DEVKITPRO");
+    println!("cargo:rerun-if-env-changed=DEVKITPPC");
+    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("cafe") {
+        return;
+    }
+    let devkitpro =
+        PathBuf::from(std::env::var_os("DEVKITPRO").expect("DEVKITPRO must point to devkitPro"));
+    let devkitppc = std::env::var_os("DEVKITPPC")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| devkitpro.join("devkitPPC"));
+    cc::Build::new()
+        .compiler(devkitppc.join("bin/powerpc-eabi-gcc"))
+        .archiver(devkitppc.join("bin/powerpc-eabi-ar"))
+        .pic(false)
+        .include(devkitpro.join("wut/include"))
+        .flag("-mcpu=750")
+        .flag("-meabi")
+        .flag("-mhard-float")
+        .define("__WIIU__", None)
+        .define("__WUT__", None)
+        .file("available_space.c")
+        .compile("horizon_wiiu_fs");
+}
diff --git a/wiiu/fs/src/lib.rs b/wiiu/fs/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bdfbf3104398869601538fbd65572823d2974c6e
--- /dev/null
+++ b/wiiu/fs/src/lib.rs
@@ -0,0 +1,34 @@
+//! Cafe filesystem queries used by the original Horizon save code.
+
+#[cfg(target_os = "cafe")]
+pub fn available_space(path: &std::path::Path) -> std::io::Result<u64> {
+    use std::ffi::CString;
+    use std::io::{Error, ErrorKind};
+    use std::os::raw::{c_char, c_int};
+
+    unsafe extern "C" {
+        fn horizon_wiiu_available_space(path: *const c_char, out: *mut u64) -> c_int;
+    }
+    // A fresh WUT client has its own current directory. Resolve relative
+    // paths against Rust std's client before passing them to that client.
+    let absolute = if path.is_absolute() {
+        path.to_path_buf()
+    } else {
+        std::env::current_dir()?.join(path)
+    };
+    let path_string = CString::new(absolute.as_os_str().as_encoded_bytes())
+        .map_err(|_| Error::new(ErrorKind::InvalidInput, "path contains NUL"))?;
+    // Besides preserving missing-path errors, this initializes Cafe std's FS
+    // client and SD mount before the independent WUT query registers its client.
+    std::fs::metadata(&absolute)?;
+    let mut size = 0;
+    // The C function borrows both pointers for the duration of the call only.
+    let status = unsafe { horizon_wiiu_available_space(path_string.as_ptr(), &mut size) };
+    if status == 0 {
+        Ok(size)
+    } else {
+        Err(Error::other(format!(
+            "Cafe free-space query failed: {status}"
+        )))
+    }
+}
