index 0000000000000000000000000000000000000000..aac93c4d4323c310e46d198ac2d762b15eb30247
--- /dev/null
+++ b/wiiu/platform/src/mouse.rs
@@ -0,0 +1,124 @@
+//! Cafe `nsyshid` boot-protocol mouse reports translated to Horizon events.
+
+use horizon_client_platform::{
+    ClientDeviceEvent, ClientWindowEvent, KeyState, MouseButton, MouseScrollDelta,
+    TouchPhase,
+};
+
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+struct RawMouseEvent {
+    kind: u8,
+    buttons: u8,
+    x: i8,
+    y: i8,
+    wheel: i8,
+    reserved: [u8; 3],
+}
+
+const _: () = assert!(core::mem::size_of::<RawMouseEvent>() == 8);
+
+const REPORT: u8 = 1;
+const DETACHED: u8 = 2;
+
+unsafe extern "C" {
+    fn horizon_wiiu_mouse_init() -> i32;
+    fn horizon_wiiu_mouse_teardown() -> i32;
+    fn horizon_wiiu_mouse_pop(event: *mut RawMouseEvent) -> i32;
+    fn horizon_wiiu_mouse_dropped() -> u32;
+}
+
+/// Initialize `nsyshid` and register the boot-mouse event callbacks.
+pub fn initialize() -> Result<(), i32> {
+    match unsafe { horizon_wiiu_mouse_init() } {
+        0 => Ok(()),
+        error => Err(error),
+    }
+}
+
+/// Stop `nsyshid` and unregister the HID client.
+pub fn shutdown() -> i32 {
+    unsafe { horizon_wiiu_mouse_teardown() }
+}
+
+/// One translated event in the original report order.
+pub enum MouseOutput {
+    Device(ClientDeviceEvent),
+    Window(ClientWindowEvent),
+}
+
+/// Drains reports into a reusable ordered event vector, releasing held buttons
+/// on detach or queue overflow.
+#[derive(Default)]
+pub struct MouseAdapter {
+    buttons: u8,
+    observed_drops: u32,
+}
+
+impl MouseAdapter {
+    pub fn release_all_into(&mut self, output: &mut Vec<MouseOutput>) {
+        self.release_buttons(output);
+    }
+
+    pub fn drain_into(&mut self, output: &mut Vec<MouseOutput>) {
+        let dropped = unsafe { horizon_wiiu_mouse_dropped() };
+        if dropped != self.observed_drops {
+            self.observed_drops = dropped;
+            self.release_buttons(output);
+            let mut ignored = RawMouseEvent::default();
+            while unsafe { horizon_wiiu_mouse_pop(&mut ignored) } != 0 {}
+            return;
+        }
+
+        loop {
+            let mut raw = RawMouseEvent::default();
+            if unsafe { horizon_wiiu_mouse_pop(&mut raw) } == 0 {
+                break;
+            }
+            match raw.kind {
+                REPORT => self.report(raw, output),
+                DETACHED => self.release_buttons(output),
+                _ => {}
+            }
+        }
+    }
+
+    fn report(&mut self, raw: RawMouseEvent, output: &mut Vec<MouseOutput>) {
+        let delta = (f64::from(raw.x), f64::from(raw.y));
+        if delta != (0.0, 0.0) {
+            output.push(MouseOutput::Device(ClientDeviceEvent::MouseMotion { delta }));
+        }
+        self.set_buttons(raw.buttons & 0x07, output);
+        if raw.wheel != 0 {
+            output.push(MouseOutput::Window(ClientWindowEvent::MouseWheel {
+                delta: MouseScrollDelta::LineDelta(0.0, f32::from(raw.wheel)),
+                phase: TouchPhase::Moved,
+            }));
+        }
+    }
+
+    fn set_buttons(&mut self, next: u8, output: &mut Vec<MouseOutput>) {
+        for (bit, button) in [
+            (0, MouseButton::Left),
+            (1, MouseButton::Right),
+            (2, MouseButton::Middle),
+        ] {
+            let mask = 1 << bit;
+            if (self.buttons & mask) != (next & mask) {
+                output.push(MouseOutput::Window(ClientWindowEvent::MouseInput {
+                    state: if next & mask != 0 {
+                        KeyState::Pressed
+                    } else {
+                        KeyState::Released
+                    },
+                    button,
+                }));
+            }
+        }
+        self.buttons = next;
+    }
+
+    fn release_buttons(&mut self, output: &mut Vec<MouseOutput>) {
+        self.set_buttons(0, output);
+    }
+}
diff --git a/wiiu/platform/src/mouse_bridge.c b/wiiu/platform/src/mouse_bridge.c
new file mode 100644
index 0000000000000000000000000000000000000000..10d1b96b403e44c172aae1a2568a8e657a800bf8
--- /dev/null
+++ b/wiiu/platform/src/mouse_bridge.c
@@ -0,0 +1,285 @@
+#include "mouse_bridge.h"
+
+#include <nsyshid/hid.h>
+#include <stdatomic.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define MOUSE_QUEUE_CAPACITY 64u
+#define MOUSE_QUEUE_MASK (MOUSE_QUEUE_CAPACITY - 1u)
+
+_Static_assert((MOUSE_QUEUE_CAPACITY & MOUSE_QUEUE_MASK) == 0,
+               "mouse queue capacity must be a power of two");
+
+typedef struct MouseQueueSlot {
+   _Atomic uint32_t sequence;
+   HorizonMouseEvent event;
+} MouseQueueSlot;
+
+static MouseQueueSlot queue[MOUSE_QUEUE_CAPACITY];
+static _Atomic uint32_t enqueue_position;
+static _Atomic uint32_t dequeue_position;
+static _Atomic uint32_t dropped_events;
+static _Atomic int queue_state;
+static _Atomic int callbacks_enabled;
+static _Atomic int device_active;
+static _Atomic uint32_t device_handle;
+static _Atomic uint32_t device_generation;
+static uint8_t report_buffer[8];
+static HIDClient hid_client;
+static int client_registered;
+
+static void
+initialize_queue(void)
+{
+   int state = atomic_load_explicit(&queue_state, memory_order_acquire);
+   if (state == 2) {
+      return;
+   }
+
+   int uninitialized = 0;
+   if (!atomic_compare_exchange_strong_explicit(&queue_state, &uninitialized, 1,
+                                               memory_order_acq_rel,
+                                               memory_order_acquire)) {
+      while (atomic_load_explicit(&queue_state, memory_order_acquire) != 2) {
+      }
+      return;
+   }
+
+   for (uint32_t i = 0; i < MOUSE_QUEUE_CAPACITY; ++i) {
+      atomic_init(&queue[i].sequence, i);
+   }
+   atomic_store_explicit(&enqueue_position, 0, memory_order_relaxed);
+   atomic_store_explicit(&dequeue_position, 0, memory_order_relaxed);
+   atomic_store_explicit(&dropped_events, 0, memory_order_relaxed);
+   atomic_store_explicit(&queue_state, 2, memory_order_release);
+}
+
+static void
+enqueue_event(HorizonMouseEvent event)
+{
+   uint32_t position = atomic_load_explicit(&enqueue_position, memory_order_relaxed);
+   MouseQueueSlot *slot;
+   for (;;) {
+      slot = &queue[position & MOUSE_QUEUE_MASK];
+      uint32_t sequence = atomic_load_explicit(&slot->sequence, memory_order_acquire);
+      int32_t difference = (int32_t)(sequence - position);
+      if (difference == 0) {
+         if (atomic_compare_exchange_weak_explicit(&enqueue_position, &position,
+                                                   position + 1u,
+                                                   memory_order_relaxed,
+                                                   memory_order_relaxed)) {
+            break;
+         }
+      } else if (difference < 0) {
+         atomic_fetch_add_explicit(&dropped_events, 1, memory_order_relaxed);
+         return;
+      } else {
+         position = atomic_load_explicit(&enqueue_position, memory_order_relaxed);
+      }
+   }
+
+   slot->event = event;
+   atomic_store_explicit(&slot->sequence, position + 1u, memory_order_release);
+}
+
+static int
+dequeue_event(HorizonMouseEvent *event)
+{
+   uint32_t position = atomic_load_explicit(&dequeue_position, memory_order_relaxed);
+   MouseQueueSlot *slot;
+   for (;;) {
+      slot = &queue[position & MOUSE_QUEUE_MASK];
+      uint32_t sequence = atomic_load_explicit(&slot->sequence, memory_order_acquire);
+      int32_t difference = (int32_t)(sequence - (position + 1u));
+      if (difference == 0) {
+         if (atomic_compare_exchange_weak_explicit(&dequeue_position, &position,
+                                                   position + 1u,
+                                                   memory_order_relaxed,
+                                                   memory_order_relaxed)) {
+            break;
+         }
+      } else if (difference < 0) {
+         return 0;
+      } else {
+         position = atomic_load_explicit(&dequeue_position, memory_order_relaxed);
+      }
+   }
+
+   *event = slot->event;
+   atomic_store_explicit(&slot->sequence,
+                         position + MOUSE_QUEUE_CAPACITY,
+                         memory_order_release);
+   return 1;
+}
+
+static void
+queue_detached(void)
+{
+   HorizonMouseEvent event = {0};
+   event.kind = HORIZON_MOUSE_DETACHED;
+   enqueue_event(event);
+}
+
+static void
+read_report(uint32_t handle, int32_t error, uint8_t *buffer,
+            uint32_t bytes_transferred, void *user_context)
+{
+   uint32_t generation = (uint32_t)(uintptr_t)user_context;
+   if (!atomic_load_explicit(&callbacks_enabled, memory_order_acquire) ||
+       !atomic_load_explicit(&device_active, memory_order_acquire) ||
+       atomic_load_explicit(&device_handle, memory_order_relaxed) != handle ||
+       atomic_load_explicit(&device_generation, memory_order_relaxed) != generation) {
+      return;
+   }
+
+   if (error != 0) {
+      atomic_store_explicit(&device_active, 0, memory_order_release);
+      queue_detached();
+      return;
+   }
+
+   if (buffer != NULL && bytes_transferred >= 3) {
+      HorizonMouseEvent event = {0};
+      event.kind = HORIZON_MOUSE_REPORT;
+      event.buttons = buffer[0] & 0x07;
+      event.x = (int8_t)buffer[1];
+      event.y = (int8_t)buffer[2];
+      event.wheel = bytes_transferred >= 4 ? (int8_t)buffer[3] : 0;
+      enqueue_event(event);
+   }
+
+   if (atomic_load_explicit(&callbacks_enabled, memory_order_acquire) &&
+       atomic_load_explicit(&device_active, memory_order_acquire) &&
+       atomic_load_explicit(&device_generation, memory_order_relaxed) == generation) {
+      int32_t result = HIDRead(handle, report_buffer, sizeof(report_buffer),
+                               read_report, user_context);
+      if (result != 0) {
+         atomic_store_explicit(&device_active, 0, memory_order_release);
+         queue_detached();
+      }
+   }
+}
+
+static void
+protocol_set(uint32_t handle, int32_t error, uint8_t *buffer,
+             uint32_t bytes_transferred, void *user_context)
+{
+   (void)buffer;
+   (void)bytes_transferred;
+   uint32_t generation = (uint32_t)(uintptr_t)user_context;
+   if (!atomic_load_explicit(&callbacks_enabled, memory_order_acquire) ||
+       !atomic_load_explicit(&device_active, memory_order_acquire) ||
+       atomic_load_explicit(&device_handle, memory_order_relaxed) != handle ||
+       atomic_load_explicit(&device_generation, memory_order_relaxed) != generation) {
+      return;
+   }
+   if (error != 0) {
+      atomic_store_explicit(&device_active, 0, memory_order_release);
+      queue_detached();
+      return;
+   }
+
+   int32_t result = HIDRead(handle, report_buffer, sizeof(report_buffer),
+                            read_report, user_context);
+   if (result != 0) {
+      atomic_store_explicit(&device_active, 0, memory_order_release);
+      queue_detached();
+   }
+}
+
+static int32_t
+device_attached(HIDClient *client, HIDDevice *device, HIDAttachEvent attach)
+{
+   (void)client;
+   if (device == NULL ||
+       !atomic_load_explicit(&callbacks_enabled, memory_order_acquire)) {
+      return 0;
+   }
+
+   if (attach == HID_DEVICE_DETACH) {
+      if (atomic_load_explicit(&device_active, memory_order_acquire) &&
+          atomic_load_explicit(&device_handle, memory_order_relaxed) == device->handle) {
+         atomic_store_explicit(&device_active, 0, memory_order_release);
+         atomic_fetch_add_explicit(&device_generation, 1, memory_order_relaxed);
+         queue_detached();
+      }
+      return 0;
+   }
+
+   /* HID boot subclass and mouse protocol; ignore report-protocol devices. */
+   if (device->subClass != 1 || device->protocol != 2 ||
+       atomic_load_explicit(&device_active, memory_order_acquire)) {
+      return 0;
+   }
+
+   uint32_t generation = atomic_fetch_add_explicit(&device_generation, 1,
+                                                    memory_order_relaxed) + 1u;
+   atomic_store_explicit(&device_handle, device->handle, memory_order_relaxed);
+   atomic_store_explicit(&device_active, 1, memory_order_release);
+   int32_t result = HIDSetProtocol(device->handle, device->interfaceIndex, 0,
+                                   protocol_set, (void *)(uintptr_t)generation);
+   if (result != 0) {
+      atomic_store_explicit(&device_active, 0, memory_order_release);
+      queue_detached();
+   }
+   return 0;
+}
+
+int32_t
+horizon_wiiu_mouse_init(void)
+{
+   initialize_queue();
+   if (client_registered) {
+      return 0;
+   }
+   atomic_store_explicit(&callbacks_enabled, 1, memory_order_release);
+   int32_t result = HIDSetup();
+   if (result != 0) {
+      atomic_store_explicit(&callbacks_enabled, 0, memory_order_release);
+      return result;
+   }
+   result = HIDAddClient(&hid_client, device_attached);
+   if (result != 0) {
+      atomic_store_explicit(&callbacks_enabled, 0, memory_order_release);
+      HIDTeardown();
+      return result;
+   }
+   client_registered = 1;
+   return 0;
+}
+
+int32_t
+horizon_wiiu_mouse_teardown(void)
+{
+   atomic_store_explicit(&callbacks_enabled, 0, memory_order_release);
+   if (atomic_exchange_explicit(&device_active, 0, memory_order_acq_rel)) {
+      atomic_fetch_add_explicit(&device_generation, 1, memory_order_relaxed);
+      queue_detached();
+   }
+   int32_t result = 0;
+   if (client_registered) {
+      result = HIDDelClient(&hid_client);
+      client_registered = 0;
+      int32_t teardown_result = HIDTeardown();
+      if (result == 0) {
+         result = teardown_result;
+      }
+   }
+   return result;
+}
+
+int32_t
+horizon_wiiu_mouse_pop(HorizonMouseEvent *event)
+{
+   if (event == NULL || atomic_load_explicit(&queue_state, memory_order_acquire) != 2) {
+      return 0;
+   }
+   return dequeue_event(event);
+}
+
+uint32_t
+horizon_wiiu_mouse_dropped(void)
+{
+   return atomic_load_explicit(&dropped_events, memory_order_relaxed);
+}
diff --git a/wiiu/platform/src/mouse_bridge.h b/wiiu/platform/src/mouse_bridge.h
new file mode 100644
index 0000000000000000000000000000000000000000..37df67b9c6bbc793e80c6e02689130320db68b6a
--- /dev/null
+++ b/wiiu/platform/src/mouse_bridge.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <stdint.h>
+
+/* Boot-protocol mouse reports copied from asynchronous nsyshid callbacks. */
+typedef struct HorizonMouseEvent {
+   uint8_t kind;
+   uint8_t buttons;
+   int8_t x;
+   int8_t y;
+   int8_t wheel;
+   uint8_t reserved[3];
+} HorizonMouseEvent;
+
+_Static_assert(sizeof(HorizonMouseEvent) == 8,
+               "unexpected mouse event ABI size");
+
+enum HorizonMouseEventKind {
+   HORIZON_MOUSE_REPORT = 1,
+   HORIZON_MOUSE_DETACHED = 2,
+};
+
+/* Initialize/tear down nsyshid. Return the HID API result. */
+int32_t horizon_wiiu_mouse_init(void);
+int32_t horizon_wiiu_mouse_teardown(void);
+
+/* Return 1 and copy one queued record, or 0 when the queue is empty. */
+int32_t horizon_wiiu_mouse_pop(HorizonMouseEvent *event);
+
+/* Number of callback records dropped because the bounded queue was full. */
+uint32_t horizon_wiiu_mouse_dropped(void);
diff --git a/wiiu/platform/src/touch.rs b/wiiu/platform/src/touch.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f8c9d0171eb62662d51a3cbcf9a8e7ba2cc522a7
--- /dev/null
+++ b/wiiu/platform/src/touch.rs
@@ -0,0 +1,630 @@
+//! Map GamePad touch contacts onto Horizon's existing pointer event path.
+//!
+//! Pass the current [`VpadState`] each host frame. Cached state makes repeated
+//! calls safe when VPAD has no new sample; identical positions produce no
+//! duplicate events. Coordinates are calibrated at 1920×1080 and scaled to the
+//! actual physical DRC output viewport before Horizon applies GUI scaling.
+
+use horizon_client_platform::{
+    ClientWindowEvent, KeyState, MouseButton, MouseScrollDelta, PhysicalPosition, TouchPhase,
+};
+
+use crate::{FreshTouchRelease, VpadState, VpadTouch};
+
+const CALIBRATED_WIDTH: f64 = 1920.0;
+const CALIBRATED_HEIGHT: f64 = 1080.0;
+const GESTURE_THRESHOLD: f64 = 12.0;
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+enum Gesture {
+    #[default]
+    Idle,
+    Pending,
+    Scrolling,
+    Moved,
+}
+
+/// Converts one physical GamePad contact into Horizon mouse events.
+pub struct TouchMapper {
+    gesture: Gesture,
+    focused: bool,
+    suppress_until_release: bool,
+    contact_seen: bool,
+    start_position: Option<PhysicalPosition<f64>>,
+    last_position: Option<PhysicalPosition<f64>>,
+}
+
+impl Default for TouchMapper {
+    fn default() -> Self {
+        Self {
+            gesture: Gesture::Idle,
+            focused: true,
+            suppress_until_release: false,
+            contact_seen: false,
+            start_position: None,
+            last_position: None,
+        }
+    }
+}
+
+impl TouchMapper {
+    /// Emit pointer events for the current cached VPAD state.
+    ///
+    /// `viewport` is the physical pixel size of the DRC render target (normally
+    /// 854×480). A contact with no valid point does not start a gesture. Short
+    /// contacts become taps on release; vertical gestures become wheel events.
+    /// Cached no-sample/busy state retains the last pointer position until a
+    /// real release or reset. After reset/focus loss, a held contact must be
+    /// physically released before it can start another gesture. This
+    /// freshness-free helper never re-arms suppression; hardware hosts should
+    /// use [`Self::events_with_freshness`] and pass each poll's marker once.
+    pub fn events(&mut self, state: &VpadState, viewport: [u32; 2]) -> Vec<ClientWindowEvent> {
+        self.events_with_freshness(state, viewport, None)
+    }
+
+    /// Process the current state and optional one-shot evidence from this VPAD
+    /// poll. Only a fresh sampled release can clear focus/reset suppression.
+    ///
+    /// Pass the marker returned by `state.update_with_freshness` or
+    /// `state.poll_with_freshness` immediately, with that exact `state`, once
+    /// per poll and before another poll or reset. Do not retain a marker or pair
+    /// it with a replacement state. Pass `None` for no-sample, busy, and reset.
+    pub fn events_with_freshness(
+        &mut self,
+        state: &VpadState,
+        viewport: [u32; 2],
+        fresh_release: Option<FreshTouchRelease>,
+    ) -> Vec<ClientWindowEvent> {
+        if fresh_release.is_some() {
+            if state.touch_active() {
+                // A later contact arrived before this update was consumed.
+                self.suppress_until_release = true;
+                self.contact_seen = true;
+            } else {
+                self.suppress_until_release = false;
+                self.contact_seen = false;
+            }
+        }
+
+        if !self.focused {
+            self.observe_unfocused(state);
+            return Vec::new();
+        }
+
+        if self.suppress_until_release {
+            return Vec::new();
+        }
+
+        if !state.touch_active() {
+            if self.contact_seen {
+                // An inactive cache/reset is not evidence of a physical release.
+                self.suppress_until_release = true;
+            }
+            return self.finish_contact();
+        }
+        self.contact_seen = true;
+
+        let Some(point) = state.touch() else {
+            return Vec::new();
+        };
+        let Some(position) = scale_to_viewport(point, viewport) else {
+            return Vec::new();
+        };
+
+        if self.gesture == Gesture::Idle {
+            self.gesture = Gesture::Pending;
+            self.start_position = Some(position);
+            self.last_position = Some(position);
+            return vec![cursor_event(position)];
+        }
+
+        let previous = self.last_position.unwrap_or(position);
+        if previous == position {
+            return Vec::new();
+        }
+        self.last_position = Some(position);
+
+        let mut events = Vec::with_capacity(3);
+        match self.gesture {
+            Gesture::Idle => unreachable!("a valid contact starts pending above"),
+            Gesture::Pending => {
+                let start = self.start_position.unwrap_or(previous);
+                let dx = position.x - start.x;
+                let dy = position.y - start.y;
+                if dy.abs() >= GESTURE_THRESHOLD && dy.abs() > dx.abs() {
+                    self.gesture = Gesture::Scrolling;
+                    // Emit the full displacement accumulated while the gesture
+                    // was undecided, so slow first movements are not lost.
+                    events.push(cursor_event(position));
+                    events.push(wheel_event(dy));
+                } else if dx.abs().max(dy.abs()) >= GESTURE_THRESHOLD {
+                    // Horizontal and diagonal movement is not a tap, but it is
+                    // not scrolling either. Keep it click-free so a swipe over
+                    // an actionable button cannot activate it.
+                    self.gesture = Gesture::Moved;
+                    events.push(cursor_event(position));
+                } else {
+                    events.push(cursor_event(position));
+                }
+            }
+            Gesture::Scrolling => {
+                events.push(cursor_event(position));
+                events.push(wheel_event(position.y - previous.y));
+            }
+            Gesture::Moved => events.push(cursor_event(position)),
+        }
+        events
+    }
+
+    /// Cancel a pending tap on controller loss or host reset.
+    ///
+    /// Re-arming requires observing a physical release, preventing a held touch
+    /// from becoming a fresh click after a reset.
+    pub fn reset(&mut self, state: &VpadState) -> Vec<ClientWindowEvent> {
+        let events = self.cancel_contact();
+        if self.contact_seen || state.touch_active() {
+            self.suppress_until_release = true;
+        }
+        self.last_position = None;
+        self.start_position = None;
+        events
+    }
+
+    /// Lose focus and release any held click. No pointer events are emitted
+    /// until focus returns, and a contact held across the transition is ignored
+    /// until it is physically released.
+    pub fn focus_lost(&mut self, state: &VpadState) -> Vec<ClientWindowEvent> {
+        let events = self.cancel_contact();
+        self.focused = false;
+        if state.touch_active() || self.contact_seen {
+            self.suppress_until_release = true;
+            self.contact_seen = true;
+        }
+        self.last_position = None;
+        self.start_position = None;
+        events
+    }
+
+    /// Restore focus. If the GamePad is still being touched, wait for release
+    /// before accepting a new contact.
+    pub fn focus_gained(&mut self, state: &VpadState) {
+        self.focused = true;
+        if state.touch_active() || self.contact_seen {
+            self.suppress_until_release = true;
+            self.contact_seen = true;
+        }
+        self.last_position = None;
+        self.start_position = None;
+    }
+
+    fn observe_unfocused(&mut self, state: &VpadState) {
+        if state.touch_active() {
+            self.suppress_until_release = true;
+            self.contact_seen = true;
+        }
+    }
+
+    fn finish_contact(&mut self) -> Vec<ClientWindowEvent> {
+        let events = match self.gesture {
+            Gesture::Pending => vec![
+                button_event(KeyState::Pressed),
+                button_event(KeyState::Released),
+            ],
+            Gesture::Scrolling | Gesture::Moved | Gesture::Idle => Vec::new(),
+        };
+        self.clear_gesture();
+        events
+    }
+
+    fn cancel_contact(&mut self) -> Vec<ClientWindowEvent> {
+        self.clear_gesture();
+        Vec::new()
+    }
+
+    fn clear_gesture(&mut self) {
+        self.gesture = Gesture::Idle;
+        self.start_position = None;
+        self.last_position = None;
+    }
+}
+
+fn scale_to_viewport(point: VpadTouch, viewport: [u32; 2]) -> Option<PhysicalPosition<f64>> {
+    let [width, height] = viewport;
+    if width == 0 || height == 0 || point.x >= 1920 || point.y >= 1080 {
+        return None;
+    }
+    Some(PhysicalPosition::new(
+        (f64::from(point.x) * f64::from(width) / CALIBRATED_WIDTH).min(f64::from(width - 1)),
+        (f64::from(point.y) * f64::from(height) / CALIBRATED_HEIGHT).min(f64::from(height - 1)),
+    ))
+}
+
+fn cursor_event(position: PhysicalPosition<f64>) -> ClientWindowEvent {
+    ClientWindowEvent::CursorMoved { position }
+}
+
+fn button_event(state: KeyState) -> ClientWindowEvent {
+    ClientWindowEvent::MouseInput {
+        state,
+        button: MouseButton::Left,
+    }
+}
+
+fn wheel_event(delta_y: f64) -> ClientWindowEvent {
+    ClientWindowEvent::MouseWheel {
+        delta: MouseScrollDelta::PixelDelta(PhysicalPosition::new(0.0, delta_y)),
+        phase: TouchPhase::Moved,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::VpadSample;
+
+    fn state(active: u32, valid: u32, x: u16, y: u16) -> VpadState {
+        let mut state = VpadState::default();
+        state.update(Some(VpadSample {
+            touch_active: active,
+            touch_valid: valid,
+            touch_x: x,
+            touch_y: y,
+            ..Default::default()
+        }));
+        state
+    }
+
+    fn sampled_state(
+        active: u32,
+        valid: u32,
+        x: u16,
+        y: u16,
+    ) -> (VpadState, Option<FreshTouchRelease>) {
+        let mut state = VpadState::default();
+        let (_, release) = state.update_with_freshness(Some(VpadSample {
+            touch_active: active,
+            touch_valid: valid,
+            touch_x: x,
+            touch_y: y,
+            ..Default::default()
+        }));
+        (state, release)
+    }
+
+    #[test]
+    fn start_scales_to_drc_without_activating_until_release() {
+        let state = state(1, 1, 960, 540);
+        let mut mapper = TouchMapper::default();
+        assert_eq!(
+            mapper.events(&state, [854, 480]),
+            vec![cursor_event(PhysicalPosition::new(427.0, 240.0))]
+        );
+    }
+
+    #[test]
+    fn short_contact_becomes_one_click_on_release() {
+        let mut mapper = TouchMapper::default();
+        let start = state(1, 1, 200, 300);
+        assert_eq!(mapper.events(&start, [854, 480]).len(), 1);
+        assert!(mapper.events(&start, [854, 480]).is_empty());
+
+        let moved = state(1, 1, 208, 308);
+        assert_eq!(
+            mapper.events(&moved, [854, 480]),
+            vec![cursor_event(PhysicalPosition::new(
+                208.0 * 854.0 / 1920.0,
+                308.0 * 480.0 / 1080.0,
+            ))]
+        );
+
+        let released = state(0, 0, 0, 0);
+        assert_eq!(
+            mapper.events(&released, [854, 480]),
+            vec![
+                button_event(KeyState::Pressed),
+                button_event(KeyState::Released),
+            ]
+        );
+        assert!(mapper.events(&released, [854, 480]).is_empty());
+    }
+
+    #[test]
+    fn vertical_swipe_emits_accumulated_wheel_delta_without_clicking() {
+        let mut mapper = TouchMapper::default();
+        let start = state(1, 1, 500, 500);
+        let _ = mapper.events(&start, [854, 480]);
+
+        let first = state(1, 1, 500, 520);
+        assert_eq!(mapper.events(&first, [854, 480]).len(), 1);
+
+        let threshold = state(1, 1, 500, 530);
+        let y0 = 500.0 * 480.0 / 1080.0;
+        let y1 = 530.0 * 480.0 / 1080.0;
+        assert_eq!(
+            mapper.events(&threshold, [854, 480]),
+            vec![
+                cursor_event(PhysicalPosition::new(500.0 * 854.0 / 1920.0, y1)),
+                wheel_event(y1 - y0),
+            ]
+        );
+
+        let continued = state(1, 1, 500, 550);
+        let y2 = 550.0 * 480.0 / 1080.0;
+        assert_eq!(
+            mapper.events(&continued, [854, 480]),
+            vec![
+                cursor_event(PhysicalPosition::new(500.0 * 854.0 / 1920.0, y2)),
+                wheel_event(y2 - y1),
+            ]
+        );
+        assert!(mapper.events(&state(0, 0, 0, 0), [854, 480]).is_empty());
+    }
+
+    #[test]
+    fn horizontal_swipe_cancels_tap_without_pressing_its_origin() {
+        let mut mapper = TouchMapper::default();
+        let start = state(1, 1, 500, 500);
+        let _ = mapper.events(&start, [854, 480]);
+        let moved = state(1, 1, 560, 500);
+        assert_eq!(
+            mapper.events(&moved, [854, 480]),
+            vec![cursor_event(PhysicalPosition::new(
+                560.0 * 854.0 / 1920.0,
+                500.0 * 480.0 / 1080.0,
+            ))]
+        );
+        assert!(mapper.events(&state(0, 0, 0, 0), [854, 480]).is_empty());
+    }
+
+    #[test]
+    fn invalid_contact_does_not_start_until_coordinates_are_valid() {
+        let mut mapper = TouchMapper::default();
+        let mut invalid_start = state(1, 0, 0, 0);
+        assert!(mapper.events(&invalid_start, [854, 480]).is_empty());
+
+        invalid_start.update(Some(VpadSample {
+            touch_active: 1,
+            touch_valid: 1,
+            touch_x: 100,
+            touch_y: 200,
+            ..Default::default()
+        }));
+        assert_eq!(mapper.events(&invalid_start, [854, 480]).len(), 1);
+
+        // The VpadState retains the last valid point through invalid coordinates.
+        invalid_start.update(Some(VpadSample {
+            touch_active: 1,
+            touch_valid: 0,
+            ..Default::default()
+        }));
+        assert!(mapper.events(&invalid_start, [854, 480]).is_empty());
+
+        // Cached state models no-sample/busy: identical repeated calls do not
+        // synthesize early taps or extra moves.
+        assert!(mapper.events(&invalid_start, [854, 480]).is_empty());
+        assert_eq!(
+            mapper.events(&state(0, 0, 0, 0), [854, 480]),
+            vec![
+                button_event(KeyState::Pressed),
+                button_event(KeyState::Released),
+            ]
+        );
+    }
+
+    #[test]
+    fn zero_sized_viewport_defers_gesture_and_reset_cancels_pending_tap() {
+        let mut mapper = TouchMapper::default();
+        let contact = state(1, 1, 1919, 1079);
+        assert!(mapper.events(&contact, [0, 480]).is_empty());
+        assert!(mapper.events(&contact, [854, 0]).is_empty());
+        assert_eq!(mapper.events(&contact, [854, 480]).len(), 1);
+        assert!(mapper.reset(&contact).is_empty());
+        assert!(mapper.reset(&contact).is_empty());
+    }
+
+    #[test]
+    fn resize_repositions_an_active_contact_and_edges_clamp_inside_drc() {
+        let mut mapper = TouchMapper::default();
+        let contact = state(1, 1, 1919, 1079);
+        assert_eq!(mapper.events(&contact, [854, 480]).len(), 1);
+        assert_eq!(
+            mapper.events(&contact, [1280, 720]),
+            vec![cursor_event(PhysicalPosition::new(1279.0, 719.0))]
+        );
+    }
+
+    #[test]
+    fn held_contact_across_focus_loss_does_not_click_again_until_released() {
+        let mut mapper = TouchMapper::default();
+        let contact = state(1, 1, 250, 350);
+        assert_eq!(mapper.events(&contact, [854, 480]).len(), 1);
+        assert!(mapper.focus_lost(&contact).is_empty());
+
+        mapper.focus_gained(&contact);
+        assert!(mapper.events(&contact, [854, 480]).is_empty());
+        assert!(mapper.events(&contact, [854, 480]).is_empty());
+
+        let (released, release) = sampled_state(0, 0, 0, 0);
+        assert!(mapper
+            .events_with_freshness(&released, [854, 480], release)
+            .is_empty());
+        let next_contact = state(1, 1, 600, 700);
+        assert_eq!(mapper.events(&next_contact, [854, 480]).len(), 1);
+    }
+
+    #[test]
+    fn release_while_unfocused_rearms_for_a_new_contact_after_regain() {
+        let mut mapper = TouchMapper::default();
+        let contact = state(1, 1, 250, 350);
+        let _ = mapper.events(&contact, [854, 480]);
+        let _ = mapper.focus_lost(&contact);
+
+        let (released, release) = sampled_state(0, 0, 0, 0);
+        assert!(mapper
+            .events_with_freshness(&released, [854, 480], release)
+            .is_empty());
+        mapper.focus_gained(&released);
+
+        let next_contact = state(1, 1, 600, 700);
+        assert_eq!(mapper.events(&next_contact, [854, 480]).len(), 1);
+    }
+
+    #[test]
+    fn contacts_started_while_unfocused_are_not_replayed_on_regain() {
+        let mut mapper = TouchMapper::default();
+        let held = state(1, 1, 250, 350);
+        let _ = mapper.events(&held, [854, 480]);
+        let _ = mapper.focus_lost(&held);
+
+        let (released, release) = sampled_state(0, 0, 0, 0);
+        assert!(mapper
+            .events_with_freshness(&released, [854, 480], release)
+            .is_empty());
+        let contact_while_unfocused = state(1, 1, 600, 700);
+        assert!(mapper
+            .events(&contact_while_unfocused, [854, 480])
+            .is_empty());
+        mapper.focus_gained(&contact_while_unfocused);
+        assert!(mapper
+            .events(&contact_while_unfocused, [854, 480])
+            .is_empty());
+
+        let (released_again, release_again) = sampled_state(0, 0, 0, 0);
+        assert!(mapper
+            .events_with_freshness(&released_again, [854, 480], release_again)
+            .is_empty());
+        assert_eq!(mapper.events(&held, [854, 480]).len(), 1);
+    }
+
+    #[test]
+    fn reset_cached_as_no_contact_does_not_clear_focus_loss_suppression() {
+        let mut mapper = TouchMapper::default();
+        let mut vpad = VpadState::default();
+        let (_, release) = vpad.update_with_freshness(Some(VpadSample::default()));
+        assert!(release.is_some());
+        vpad.update(Some(VpadSample {
+            touch_active: 1,
+            touch_valid: 1,
+            touch_x: 250,
+            touch_y: 350,
+            ..Default::default()
+        }));
+        assert_eq!(mapper.events(&vpad, [854, 480]).len(), 1);
+        assert!(mapper.focus_lost(&vpad).is_empty());
+
+        // A controller reset clears the cached held bit but is not a physical
+        // release sample, so it must not re-arm the mapper.
+        vpad.reset();
+        // No-sample and busy results likewise provide no physical release.
+        let (_, no_sample_release) = vpad.update_with_freshness(None);
+        assert!(no_sample_release.is_none());
+        mapper.focus_gained(&vpad);
+        assert!(mapper.events(&vpad, [854, 480]).is_empty());
+        assert!(mapper.suppress_until_release);
+
+        // Only a fresh VPAD sample that reports no contact clears suppression.
+        let (_, fresh_release) = vpad.update_with_freshness(Some(VpadSample::default()));
+        assert!(fresh_release.is_some());
+        assert!(mapper
+            .events_with_freshness(&vpad, [854, 480], fresh_release)
+            .is_empty());
+        vpad.update(Some(VpadSample {
+            touch_active: 1,
+            touch_valid: 1,
+            touch_x: 500,
+            touch_y: 400,
+            ..Default::default()
+        }));
+        assert_eq!(mapper.events(&vpad, [854, 480]).len(), 1);
+    }
+
+    #[test]
+    fn replacement_default_state_is_not_a_fresh_release() {
+        let mut mapper = TouchMapper::default();
+        let mut previous = VpadState::default();
+        let _ = previous.update_with_freshness(Some(VpadSample::default()));
+        previous.update(Some(VpadSample {
+            touch_active: 1,
+            touch_valid: 1,
+            touch_x: 200,
+            touch_y: 300,
+            ..Default::default()
+        }));
+        assert_eq!(mapper.events(&previous, [854, 480]).len(), 1);
+        assert!(mapper.focus_lost(&previous).is_empty());
+
+        // A new default state carries no one-shot release evidence.
+        let mut replacement = VpadState::default();
+        mapper.focus_gained(&replacement);
+        assert!(mapper.events(&replacement, [854, 480]).is_empty());
+        let (_, no_sample) = replacement.update_with_freshness(None);
+        assert!(no_sample.is_none());
+        assert!(mapper.events(&replacement, [854, 480]).is_empty());
+
+        let (_, release) = replacement.update_with_freshness(Some(VpadSample::default()));
+        assert!(mapper
+            .events_with_freshness(&replacement, [854, 480], release)
+            .is_empty());
+        replacement.update(Some(VpadSample {
+            touch_active: 1,
+            touch_valid: 1,
+            touch_x: 400,
+            touch_y: 500,
+            ..Default::default()
+        }));
+        assert_eq!(mapper.events(&replacement, [854, 480]).len(), 1);
+    }
+
+    #[test]
+    fn reset_after_vpad_reset_keeps_tap_suppressed_until_fresh_release() {
+        let mut mapper = TouchMapper::default();
+        let contact = state(1, 1, 250, 350);
+        assert_eq!(mapper.events(&contact, [854, 480]).len(), 1);
+
+        let mut reset_vpad = contact;
+        reset_vpad.reset();
+        assert!(mapper.reset(&reset_vpad).is_empty());
+        mapper.focus_gained(&reset_vpad);
+        assert!(mapper.events(&reset_vpad, [854, 480]).is_empty());
+
+        let (_, release) = reset_vpad.update_with_freshness(Some(VpadSample::default()));
+        assert!(mapper
+            .events_with_freshness(&reset_vpad, [854, 480], release)
+            .is_empty());
+        reset_vpad.update(Some(VpadSample {
+            touch_active: 1,
+            touch_valid: 1,
+            touch_x: 500,
+            touch_y: 400,
+            ..Default::default()
+        }));
+        assert_eq!(mapper.events(&reset_vpad, [854, 480]).len(), 1);
+    }
+
+    #[test]
+    fn invalid_contact_seen_before_reset_also_requires_a_fresh_release() {
+        let mut mapper = TouchMapper::default();
+        let invalid_contact = state(1, 0, 0, 0);
+        assert!(mapper.events(&invalid_contact, [854, 480]).is_empty());
+
+        let mut reset_vpad = invalid_contact;
+        reset_vpad.reset();
+        assert!(mapper.reset(&reset_vpad).is_empty());
+        let _ = mapper.focus_lost(&reset_vpad);
+        mapper.focus_gained(&reset_vpad);
+        assert!(mapper.events(&reset_vpad, [854, 480]).is_empty());
+
+        let (_, release) = reset_vpad.update_with_freshness(Some(VpadSample::default()));
+        assert!(mapper
+            .events_with_freshness(&reset_vpad, [854, 480], release)
+            .is_empty());
+        reset_vpad.update(Some(VpadSample {
+            touch_active: 1,
+            touch_valid: 1,
+            touch_x: 500,
+            touch_y: 400,
+            ..Default::default()
+        }));
+        assert_eq!(mapper.events(&reset_vpad, [854, 480]).len(), 1);
+    }
+}
diff --git a/wiiu/platform/src/vpad_bridge.c b/wiiu/platform/src/vpad_bridge.c
new file mode 100644
index 0000000000000000000000000000000000000000..8159a35369ebdf195fa327444191050d2e515079
--- /dev/null
+++ b/wiiu/platform/src/vpad_bridge.c
@@ -0,0 +1,164 @@
+#include "vpad_bridge.h"
+#include <stddef.h>
+#include <coreinit/debug.h>
+#include <vpad/input.h>
+#include "swkbd_bridge.h"
+
+static int32_t swkbd_input_occupied;
+static int32_t trace_first_poll = 1;
+static int32_t have_button_baseline;
+static uint32_t last_button_hold;
+static int32_t button_proc_mode_initialized;
+static int32_t button_proc_mode_tight;
+#ifdef HORIZON_WIIU_TRACE_VPAD_INPUT
+static int32_t trace_have_last_input;
+static uint32_t trace_last_hold;
+static int32_t trace_last_touched;
+static uint16_t trace_last_touch_validity;
+#endif
+#ifdef HORIZON_WIIU_TRACE_SWKBD
+static uint32_t trace_swkbd_vpad_calls;
+#endif
+
+static void
+update_swkbd(const VPADStatus *status, int32_t trace)
+{
+   if (status == NULL) {
+      if (trace) OSReport("Horizon Cafe input trace: swkbd IsOpen begin\n");
+      int32_t open = horizon_swkbd_is_open();
+      if (trace) OSReport("Horizon Cafe input trace: swkbd IsOpen complete\n");
+      swkbd_input_occupied = open != 0;
+      return;
+   }
+
+   if (trace) OSReport("Horizon Cafe input trace: swkbd Calc begin\n");
+   int32_t result = horizon_swkbd_calc(status);
+   if (trace) OSReport("Horizon Cafe input trace: swkbd Calc complete\n");
+   if (result != 0) {
+      swkbd_input_occupied = 1;
+      return;
+   }
+   if (trace) OSReport("Horizon Cafe input trace: swkbd IsOpen begin\n");
+   int32_t open = horizon_swkbd_is_open();
+   if (trace) OSReport("Horizon Cafe input trace: swkbd IsOpen complete\n");
+   swkbd_input_occupied = open != 0;
+}
+
+int32_t
+horizon_wiiu_swkbd_input_occupied(void)
+{
+   return swkbd_input_occupied;
+}
+
+int32_t
+horizon_wiiu_vpad_read(HorizonVpadBatch *batch)
+{
+   int32_t trace = trace_first_poll;
+   trace_first_poll = 0;
+
+#ifdef HORIZON_WIIU_TRACE_SWKBD
+   uint32_t swkbd_vpad_call = 0;
+   int32_t trace_swkbd_vpad = 0;
+   if (horizon_swkbd_is_open() != 0) {
+      swkbd_vpad_call = ++trace_swkbd_vpad_calls;
+      trace_swkbd_vpad = swkbd_vpad_call <= 96;
+      if (trace_swkbd_vpad) {
+         OSReport("Horizon Cafe SWKBD vpad=%u stage=VPADRead.begin\n",
+                  (unsigned)swkbd_vpad_call);
+      }
+   }
+#endif
+   VPADStatus statuses[HORIZON_VPAD_SAMPLE_CAPACITY];
+   VPADReadError error = VPAD_READ_SUCCESS;
+   const int32_t swkbd_open = horizon_swkbd_is_open() != 0;
+   const int32_t use_tight_mode = horizon_vpad_uses_tight_button_mode(
+      swkbd_open, swkbd_input_occupied);
+   if (!button_proc_mode_initialized || use_tight_mode != button_proc_mode_tight) {
+      VPADSetButtonProcMode(VPAD_CHAN_0, use_tight_mode
+         ? VPAD_BUTTON_PROC_MODE_TIGHT : VPAD_BUTTON_PROC_MODE_LOOSE);
+      button_proc_mode_initialized = 1;
+      button_proc_mode_tight = use_tight_mode;
+   }
+   if (trace) OSReport("Horizon Cafe input trace: VPADRead begin\n");
+   int32_t count = VPADRead(VPAD_CHAN_0, statuses,
+                            HORIZON_VPAD_SAMPLE_CAPACITY, &error);
+   if (trace) {
+      OSReport("Horizon Cafe input trace: VPADRead complete count=%d error=%d\n",
+               count, (int32_t)error);
+   }
+#ifdef HORIZON_WIIU_TRACE_SWKBD
+   if (trace_swkbd_vpad) {
+      OSReport("Horizon Cafe SWKBD vpad=%u stage=VPADRead.returned count=%d error=%d\n",
+               (unsigned)swkbd_vpad_call, count, (int32_t)error);
+   }
+#endif
+   if (error != VPAD_READ_SUCCESS) {
+      update_swkbd(NULL, trace);
+      return (int32_t)error;
+   }
+   if (count <= 0) {
+      update_swkbd(NULL, trace);
+      return VPAD_READ_NO_SAMPLES;
+   }
+   /* WUT returns newest first; the shared history helper restores event order. */
+   const VPADStatus *status = &statuses[0];
+#ifdef HORIZON_WIIU_TRACE_VPAD_INPUT
+   const int32_t touched = status->tpNormal.touched != 0;
+   const int32_t input_changed = !trace_have_last_input ||
+      status->hold != trace_last_hold || status->trigger != 0 || status->release != 0 ||
+      touched != trace_last_touched ||
+      (touched && status->tpNormal.validity != trace_last_touch_validity);
+   if (input_changed) {
+      OSReport("Horizon Cafe VPAD input: hold=%08x trigger=%08x release=%08x "
+               "raw_touch=%u validity=%u x=%u y=%u\n",
+               (unsigned)status->hold, (unsigned)status->trigger,
+               (unsigned)status->release,
+               (unsigned)status->tpNormal.touched,
+               (unsigned)status->tpNormal.validity,
+               (unsigned)status->tpNormal.x, (unsigned)status->tpNormal.y);
+   }
+   trace_last_hold = status->hold;
+   trace_last_touched = touched;
+   trace_last_touch_validity = status->tpNormal.validity;
+   trace_have_last_input = 1;
+#endif
+   update_swkbd(status, trace);
+   batch->transition_count = 0;
+   HorizonVpadButtonSample button_samples[HORIZON_VPAD_SAMPLE_CAPACITY];
+   for (int32_t i = 0; i < count; ++i) {
+      button_samples[i].hold = statuses[i].hold;
+      button_samples[i].trigger = statuses[i].trigger;
+      button_samples[i].release = statuses[i].release;
+   }
+   batch->transition_count = horizon_vpad_collect_button_history(
+      button_samples, (uint32_t)count, have_button_baseline ? last_button_hold : 0,
+      batch->transitions, HORIZON_VPAD_HISTORY_CAPACITY);
+   if (count > 0) {
+      last_button_hold = statuses[0].hold;
+      have_button_baseline = 1;
+   }
+   batch->latest.buttons = status->hold;
+   batch->latest.left_x = status->leftStick.x;
+   batch->latest.left_y = status->leftStick.y;
+   batch->latest.right_x = status->rightStick.x;
+   batch->latest.right_y = status->rightStick.y;
+   batch->latest.touch_x = 0;
+   batch->latest.touch_y = 0;
+   batch->latest.touch_active = status->tpNormal.touched != 0;
+   batch->latest.touch_valid = 0;
+   if (status->tpNormal.touched != 0) {
+      VPADTouchData calibrated;
+      if (trace) OSReport("Horizon Cafe input trace: touch calibration begin\n");
+      VPADGetTPCalibratedPointEx(VPAD_CHAN_0, VPAD_TP_1920X1080,
+                                 &calibrated, &status->tpNormal);
+      if (trace) OSReport("Horizon Cafe input trace: touch calibration complete\n");
+      if (calibrated.validity == VPAD_VALID && calibrated.touched != 0 &&
+          calibrated.x < 1920 && calibrated.y < 1080) {
+         batch->latest.touch_x = calibrated.x;
+         batch->latest.touch_y = calibrated.y;
+         batch->latest.touch_valid = 1;
+      }
+   }
+   if (trace) OSReport("Horizon Cafe input trace: VPAD sample conversion complete\n");
+   return 1;
+}
diff --git a/wiiu/platform/src/vpad_bridge.h b/wiiu/platform/src/vpad_bridge.h
new file mode 100644
index 0000000000000000000000000000000000000000..1f80b75ee319434aeaf5232494d2d00c3515dd64
--- /dev/null
+++ b/wiiu/platform/src/vpad_bridge.h
@@ -0,0 +1,64 @@
+#pragma once
+#include <stdint.h>
+
+typedef struct HorizonVpadSample {
+   uint32_t buttons;
+   float left_x, left_y, right_x, right_y;
+   /* Calibrated coordinates are valid only when touch_valid is nonzero. */
+   uint16_t touch_x, touch_y;
+   /* Physical contact and calibrated-point validity are independent. */
+   uint32_t touch_active, touch_valid;
+} HorizonVpadSample;
+
+/* Ordered button states observed in one VPADRead batch. */
+#define HORIZON_VPAD_SAMPLE_CAPACITY 16
+#define HORIZON_VPAD_HISTORY_CAPACITY (HORIZON_VPAD_SAMPLE_CAPACITY * 3)
+
+static inline int32_t
+horizon_vpad_uses_tight_button_mode(int32_t swkbd_open, int32_t swkbd_occupied)
+{
+   return swkbd_open == 0 && swkbd_occupied == 0;
+}
+
+typedef struct HorizonVpadButtonSample {
+   uint32_t hold;
+   uint32_t trigger;
+   uint32_t release;
+} HorizonVpadButtonSample;
+
+/* Convert WUT's newest-first samples into chronological button states. */
+static inline uint32_t
+horizon_vpad_collect_button_history(const HorizonVpadButtonSample *newest_first,
+                                    uint32_t count,
+                                    uint32_t previous, uint32_t *out,
+                                    uint32_t capacity)
+{
+   uint32_t written = 0;
+   while (count > 0) {
+      const HorizonVpadButtonSample *sample = &newest_first[--count];
+      uint32_t pressed = previous | sample->trigger;
+      if (pressed != previous && written < capacity) out[written++] = pressed;
+      uint32_t released = pressed & ~sample->release;
+      if (released != pressed && written < capacity) out[written++] = released;
+      if (sample->hold != released && written < capacity) out[written++] = sample->hold;
+      previous = sample->hold;
+   }
+   return written;
+}
+
+typedef struct HorizonVpadBatch {
+   HorizonVpadSample latest;
+   uint32_t transition_count;
+   uint32_t transitions[HORIZON_VPAD_HISTORY_CAPACITY];
+} HorizonVpadBatch;
+
+/* The caller retains its last sample when no new VPAD sample is available. */
+_Static_assert(sizeof(HorizonVpadSample) == 32, "unexpected VPAD bridge layout");
+_Static_assert(sizeof(HorizonVpadBatch) == 228, "unexpected VPAD batch layout");
+
+/* Returns 1 for a sample, VPAD_READ_NO_SAMPLES for no sample, or a VPAD error. */
+int32_t horizon_wiiu_vpad_read(HorizonVpadBatch *batch);
+
+/* True while CafeOS swkbd owns the current VPAD sample, including the frame
+   on which the user accepts or cancels it. */
+int32_t horizon_wiiu_swkbd_input_occupied(void);
