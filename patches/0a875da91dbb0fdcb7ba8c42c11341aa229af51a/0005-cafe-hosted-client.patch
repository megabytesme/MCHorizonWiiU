+//! Native Cafe's FS API provides no advisory file lock. Reserve the world in
+//! this process, then open its vanilla marker. The marker can outlive the
+//! process and does not carry lock state.
+use std::{
+    fs, io,
+    path::{Path, PathBuf},
+    sync::{Arc, Mutex},
+};
+
+static ACTIVE_WORLDS: Mutex<Vec<Arc<str>>> = Mutex::new(Vec::new());
+
+pub(super) struct WorldGuard(Arc<str>);
+
+impl WorldGuard {
+    pub(super) fn acquire(world: &Path) -> io::Result<(fs::File, Self)> {
+        let path = absolute(world)?;
+        let key = world_key(&path)?;
+        let mut active = ACTIVE_WORLDS.lock().unwrap_or_else(|e| e.into_inner());
+        if active.iter().any(|other| **other == key) {
+            return Err(io::Error::new(
+                io::ErrorKind::WouldBlock,
+                format!("{} is already open in this Horizon process", path.display()),
+            ));
+        }
+        let guard = Self(Arc::from(key));
+        active.push(guard.0.clone());
+        drop(active);
+
+        // On error the local guard drops, leaving the world available to retry.
+        let mut file = super::open_session_marker(&path)
+            .map_err(|error| marker_error(&path, "open", error))?;
+        super::write_session_marker(&mut file)
+            .map_err(|error| marker_error(&path, "write", error))?;
+        Ok((file, guard))
+    }
+
+    pub(super) fn is_locked(world: &Path) -> io::Result<bool> {
+        let path = absolute(world)?;
+        let key = world_key(&path)?;
+        let active = ACTIVE_WORLDS.lock().unwrap_or_else(|e| e.into_inner());
+        if active.iter().any(|other| **other == key) {
+            return Ok(true);
+        }
+        drop(active);
+        match fs::OpenOptions::new()
+            .write(true)
+            .open(path.join("session.lock"))
+        {
+            Ok(_) => Ok(false),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+            Err(error) => Err(marker_error(&path, "check", error)),
+        }
+    }
+}
+
+impl Drop for WorldGuard {
+    fn drop(&mut self) {
+        let mut active = ACTIVE_WORLDS.lock().unwrap_or_else(|e| e.into_inner());
+        active.retain(|other| !Arc::ptr_eq(other, &self.0));
+    }
+}
+
+fn absolute(world: &Path) -> io::Result<PathBuf> {
+    if world.is_absolute() {
+        Ok(world.to_owned())
+    } else {
+        Ok(std::env::current_dir()?.join(world))
+    }
+}
+
+fn world_key(path: &Path) -> io::Result<String> {
+    let path = path
+        .to_str()
+        .filter(|s| !s.contains('\0'))
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "invalid Cafe world path"))?;
+    #[cfg(windows)]
+    let path = path.replace('\\', "/");
+    let mut parts = Vec::new();
+    // Cafe world paths are slash-separated. Avoid canonicalize, which Cafe
+    // std does not implement, and fold case for the console SD card's FAT.
+    for part in path.split('/') {
+        match part {
+            "" | "." => {}
+            ".." => {
+                parts.pop();
+            }
+            part => parts.push(part),
+        }
+    }
+    Ok(parts.join("/").to_lowercase())
+}
+
+fn marker_error(world: &Path, operation: &str, error: io::Error) -> io::Error {
+    io::Error::new(
+        error.kind(),
+        format!(
+            "cannot {operation} {}: {error}",
+            world.join("session.lock").display()
+        ),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{
+        Barrier,
+        atomic::{AtomicUsize, Ordering},
+    };
+
+    struct Scratch(PathBuf);
+
+    impl Scratch {
+        fn new() -> Self {
+            static NEXT: AtomicUsize = AtomicUsize::new(0);
+            let nonce = std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos();
+            let dir = std::env::temp_dir().join(format!(
+                "horizon-cafe-world-lock-{}-{nonce}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed),
+            ));
+            fs::create_dir(&dir).unwrap();
+            Self(dir)
+        }
+    }
+
+    impl Drop for Scratch {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    #[test]
+    fn stale_marker_is_rewritten_and_independent_worlds_can_open() {
+        let scratch = Scratch::new();
+        let world = scratch.0.join("World One");
+        let other = scratch.0.join("World Two");
+        let marker = world.join("session.lock");
+        fs::create_dir(&world).unwrap();
+        fs::write(&marker, b"left after a crash").unwrap();
+        assert!(!WorldGuard::is_locked(&world).unwrap());
+        assert_eq!(fs::read(&marker).unwrap(), b"left after a crash");
+        let held = WorldGuard::acquire(&world).unwrap();
+        assert!(WorldGuard::is_locked(&world).unwrap());
+        let alias = scratch.0.join("./World One/../WORLD ONE");
+        assert!(WorldGuard::is_locked(&alias).unwrap());
+        assert!(
+            matches!(WorldGuard::acquire(&alias), Err(e) if e.kind() == io::ErrorKind::WouldBlock)
+        );
+        let independent = WorldGuard::acquire(&other).unwrap();
+        drop(held);
+        assert!(!WorldGuard::is_locked(&world).unwrap());
+        assert_eq!(fs::read(&marker).unwrap(), [0x26, 0x03]);
+        assert!(WorldGuard::is_locked(&other).unwrap());
+        assert!(WorldGuard::acquire(&world).is_ok());
+        drop(independent);
+    }
+
+    #[test]
+    fn separate_threads_cannot_both_hold_the_same_world() {
+        let scratch = Scratch::new();
+        let world = scratch.0.join("Contended World");
+        let start = Barrier::new(2);
+        let attempted = Barrier::new(2);
+        let try_open = || {
+            start.wait();
+            let held = WorldGuard::acquire(&world);
+            // Keep any success alive until both threads have attempted their
+            // open, so success on a later, uncontended open cannot mask a race.
+            attempted.wait();
+            held.map(drop).map_err(|error| error.kind())
+        };
+        let outcomes = std::thread::scope(|scope| {
+            let first = scope.spawn(try_open);
+            let second = scope.spawn(try_open);
+            [first.join().unwrap(), second.join().unwrap()]
+        });
+        assert!(outcomes.contains(&Ok(())));
+        assert!(outcomes.contains(&Err(io::ErrorKind::WouldBlock)));
+        assert!(WorldGuard::acquire(&world).is_ok());
+    }
+
+    #[test]
+    fn real_io_errors_are_reported_and_release_the_reservation() {
+        let scratch = Scratch::new();
+        let world = scratch.0.join("Blocked marker");
+        let marker = world.join("session.lock");
+        fs::create_dir_all(&marker).unwrap();
+        let Err(error) = WorldGuard::acquire(&world) else {
+            panic!("opened a directory as a file")
+        };
+        assert_ne!(error.kind(), io::ErrorKind::WouldBlock);
+        assert!(error.to_string().contains("session.lock"));
+        assert!(WorldGuard::is_locked(&world).is_err());
+        fs::remove_dir(&marker).unwrap();
+        assert!(!WorldGuard::is_locked(&world).unwrap());
+        assert!(WorldGuard::acquire(&world).is_ok());
+        let invalid = scratch.0.join("invalid\0name");
+        assert!(
+            matches!(WorldGuard::acquire(&invalid), Err(e) if e.kind() == io::ErrorKind::InvalidInput)
+        );
+    }
+
+    #[test]
+    #[ignore = "requires HORIZON_TEST_RESOURCES pointing to prepared resources"]
+    fn cafe_lock_round_trips_world_metadata_and_a_modified_chunk() {
+        use super::super::{Level, LevelShape, SaveDir};
+        use crate::{assets::Assets, biome::Biomes, chunk::Chunk};
+
+        let scratch = Scratch::new();
+        let world = scratch.0.join("Survival");
+        let resources = PathBuf::from(std::env::var_os("HORIZON_TEST_RESOURCES").unwrap());
+        let assets = Assets::load(&resources).unwrap();
