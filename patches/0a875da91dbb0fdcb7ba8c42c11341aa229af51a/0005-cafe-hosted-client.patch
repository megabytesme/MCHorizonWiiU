+        req
+    }
+
+    fn answer(req: &Request, status: u16) -> Value {
+        let response = dispatch(req, &TestTools);
+        assert_eq!(response.status, status);
+        serde_json::from_slice(&response.body).unwrap()
+    }
+
+    #[test]
+    fn lists_and_calls_without_modern_initialization_or_connection_state() {
+        let result = answer(&request("tools/list", json!({}), Some(MODERN)), 200);
+        assert_eq!(result["result"]["ttlMs"], 0);
+        assert_eq!(result["result"]["cacheScope"], "private");
+        let result = answer(
+            &request("tools/call", json!({"name": "game_state"}), Some(MODERN)),
+            200,
+        );
+        assert_eq!(result["result"]["structuredContent"]["screen"], "playing");
+        assert_eq!(result["result"]["resultType"], "complete");
+        assert_eq!(
+            result["result"]["_meta"][SERVER_INFO]["name"],
+            "horizon-wiiu"
+        );
+        let result = answer(&request("server/discover", json!({}), Some(MODERN)), 200);
+        assert_eq!(result["result"]["supportedVersions"], json!(VERSIONS));
+        assert_eq!(
+            answer(&request("initialize", json!({}), Some(MODERN)), 404)["error"]["code"],
+            -32601
+        );
+    }
+
+    #[test]
+    fn validates_modern_header_mirrors_and_version() {
+        let mut req = request("tools/call", json!({"name": "game_state"}), Some(MODERN));
+        req.headers.remove("mcp-name");
+        assert_eq!(answer(&req, 400)["error"]["code"], -32020);
+        req.headers
+            .insert("mcp-name".into(), "=?base64?Z2FtZV9zdGF0ZQ==?=".into());
+        assert_eq!(answer(&req, 200)["result"]["isError"], false);
+        assert_eq!(
+            answer(
+                &request("server/discover", json!({}), Some("1900-01-01")),
+                400
+            )["error"]["code"],
+            -32022
+        );
+    }
+
+    #[test]
+    fn legacy_handshake_and_notifications_have_no_modern_metadata() {
+        let response = answer(
+            &request(
+                "initialize",
+                json!({
+                    "protocolVersion": "2025-11-25", "capabilities": {}, "clientInfo": {"name": "client", "version": "1"}
+                }),
+                None,
+            ),
+            200,
+        );
+        assert_eq!(response["result"]["protocolVersion"], LEGACY);
+        assert!(response["result"]["resultType"].is_null());
+        let mut req = request("notifications/initialized", json!({}), None);
+        req.body = br#"{"jsonrpc":"2.0","method":"notifications/initialized"}"#.to_vec();
+        let response = dispatch(&req, &TestTools);
+        assert_eq!(response.status, 202);
+        assert!(response.body.is_empty());
+        req.method = "GET".into();
+        assert_eq!(dispatch(&req, &TestTools).status, 405);
+    }
+}
diff --git a/wiiu/mcp/src/router.rs b/wiiu/mcp/src/router.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1e21014be458b83783c650d8d7c61d0ce69227ef
--- /dev/null
+++ b/wiiu/mcp/src/router.rs
@@ -0,0 +1,486 @@
+use crate::http::{Request, Response};
+use crate::oauth::{
+    self, Authorization, AuthorizeRequest, Error, OAuth, Persistence, Principal, Scopes,
+};
+use crate::protocol::{self, Fault, Tools};
+use base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine as _};
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+const PROTECTED: &str = "/.well-known/oauth-protected-resource/mcp";
+const AUTH_METADATA: &str = "/.well-known/oauth-authorization-server";
+
+pub trait Backend {
+    fn list(&self, principal: &Principal) -> Vec<Value>;
+    fn required(&self, name: &str) -> Option<Scopes>;
+    fn call(
+        &self,
+        principal: &Principal,
+        name: &str,
+        args: &Value,
+        disconnected: &dyn Fn() -> bool,
+    ) -> Result<Value, Fault>;
+}
+
+struct AuthorizedTools<'a, T> {
+    backend: &'a T,
+    principal: Principal,
+    metadata: &'a str,
+    missing: Mutex<Option<Scopes>>,
+    disconnected: &'a dyn Fn() -> bool,
+}
+
+impl<T: Backend> Tools for AuthorizedTools<'_, T> {
+    fn list(&self) -> Vec<Value> {
+        self.backend.list(&self.principal)
+    }
+
+    fn call(&self, name: &str, args: &Value) -> Result<Value, Fault> {
+        let scopes = self
+            .backend
+            .required(name)
+            .ok_or_else(|| Fault::new(200, -32602, "Unknown tool"))?;
+        if !self.principal.scopes.contains(scopes) {
+            *self.missing.lock().unwrap() = Some(scopes);
+            return Err(Fault::new(403, -32000, "Insufficient scope"));
+        }
+        self.backend
+            .call(&self.principal, name, args, self.disconnected)
+    }
+}
+
+struct BrowserConfirmation {
+    expires: u64,
+    request: Authorization,
+}
+
+struct Inner<P> {
+    oauth: OAuth<P>,
+    browser: BTreeMap<String, BrowserConfirmation>,
+}
+
+/// Owns a single OAuth authority and restricts requests to the configured
+/// certificate origin. Policy and consent methods are only exposed in-process.
+pub struct Router<P, T> {
+    issuer: String,
+    authority: String,
+    metadata: String,
+    inner: Mutex<Inner<P>>,
+    backend: T,
+}
+
+impl<P: Persistence, T: Backend> Router<P, T> {
+    pub fn new(issuer: String, oauth: OAuth<P>, backend: T) -> Result<Self, Error> {
+        let authority = issuer
+            .strip_prefix("https://")
+            .ok_or(Error::InvalidTarget)?
+            .to_owned();
+        if authority.contains(['/', '\\', '?', '#', '@'])
+            || url::Url::parse(&issuer).is_err()
+            || oauth.resource() != format!("{issuer}/mcp")
+        {
+            return Err(Error::InvalidTarget);
+        }
+        let metadata = format!("{issuer}{PROTECTED}");
+        Ok(Self {
+            issuer,
+            authority,
+            metadata,
+            backend,
+            inner: Mutex::new(Inner {
+                oauth,
+                browser: BTreeMap::new(),
+            }),
+        })
+    }
+
+    pub fn local<R>(&self, local: impl FnOnce(&mut OAuth<P>, u64) -> R) -> R {
+        let mut inner = self.inner.lock().unwrap_or_else(|error| error.into_inner());
+        local(&mut inner.oauth, now())
+    }
+
+    pub fn issuer(&self) -> &str {
+        &self.issuer
+    }
+
+    pub fn handle(&self, request: Request, disconnected: &dyn Fn() -> bool) -> Response {
+        if !request
+            .header("host")
+            .is_some_and(|host| host.eq_ignore_ascii_case(&self.authority))
+        {
+            return Response::empty(400);
+        }
+        if request
+            .header("origin")
+            .is_some_and(|origin| origin != self.issuer)
+        {
+            return Response::empty(403);
+        }
+        let (path, query) = request
+            .target
+            .split_once('?')
+            .unwrap_or((&request.target, ""));
+        let now = now();
+        match (request.method.as_str(), path) {
+            ("GET", PROTECTED | "/.well-known/oauth-protected-resource") if query.is_empty() => {
+                Response::json(
+                    200,
+                    json!({
+                        "resource": format!("{}/mcp", self.issuer),
+                        "authorization_servers": [&self.issuer],
+                        "scopes_supported": Scopes::names().collect::<Vec<_>>(),
+                        "bearer_methods_supported": ["header"],
+                    }),
+                )
+            }
+            ("GET", AUTH_METADATA) if query.is_empty() => Response::json(
+                200,
+                json!({
+                    "issuer": self.issuer,
+                    "authorization_endpoint": format!("{}/oauth/authorize", self.issuer),
+                    "registration_endpoint": format!("{}/oauth/register", self.issuer),
+                    "token_endpoint": format!("{}/oauth/token", self.issuer),
+                    "revocation_endpoint": format!("{}/oauth/revoke", self.issuer),
+                    "response_types_supported": ["code"],
+                    "grant_types_supported": ["authorization_code", "refresh_token"],
+                    "code_challenge_methods_supported": ["S256"],
+                    "token_endpoint_auth_methods_supported": ["none"],
+                    "revocation_endpoint_auth_methods_supported": ["none"],
+                    "authorization_response_iss_parameter_supported": true,
+                    "scopes_supported": Scopes::names().collect::<Vec<_>>(),
+                }),
+            ),
+            ("POST", "/oauth/register") if query.is_empty() => self.register(&request, now),
+            ("POST", "/oauth/token") if query.is_empty() => self.token(&request, now, false),
+            ("POST", "/oauth/revoke") if query.is_empty() => self.token(&request, now, true),
+            ("GET", "/oauth/authorize") => self.authorize(query, now),
+            ("POST", "/oauth/authorize") if query.is_empty() => self.browser_consent(&request, now),
+            ("GET", "/oauth/wait") => self.poll(query, now),
+            (_, "/mcp") if query.is_empty() => self.mcp(&request, now, disconnected),
+            _ => Response::empty(404),
+        }
+    }
+
+    fn register(&self, request: &Request, now: u64) -> Response {
+        if request.media_type() != Some("application/json") {
+            return Response::empty(415);
+        }
+        let result = (|| {
+            let body: Value =
+                serde_json::from_slice(&request.body).map_err(|_| Error::InvalidRequest)?;
+            let name = body["client_name"].as_str().unwrap_or("MCP client");
+            let redirect = body["redirect_uris"]
+                .as_array()
+                .ok_or(Error::InvalidRequest)?;
+            let redirect: Vec<String> = redirect
+                .iter()
+                .map(|uri| uri.as_str().map(str::to_owned).ok_or(Error::InvalidRequest))
+                .collect::<Result<_, _>>()?;
+            let grants = body["grant_types"].as_array();
+            let refresh = grants.is_none_or(|grants| grants.iter().any(|x| x == "refresh_token"));
+            if grants.is_some_and(|g| {
+                !g.iter().any(|x| x == "authorization_code")
+                    || g.iter().any(|x| {
+                        !matches!(x.as_str(), Some("authorization_code" | "refresh_token"))
+                    })
+            }) || body
+                .get("token_endpoint_auth_method")
+                .is_some_and(|v| v != "none")
+                || body
+                    .get("response_types")
+                    .is_some_and(|v| v != &json!(["code"]))
+            {
+                return Err(Error::InvalidRequest);
+            }
+            let id = self.lock().oauth.register(now, name, &redirect, refresh)?;
+            Ok(json!({
+                "client_id": id, "client_id_issued_at": now, "client_name": name,
+                "redirect_uris": redirect, "token_endpoint_auth_method": "none",
+                "grant_types": if refresh { vec!["authorization_code", "refresh_token"] } else { vec!["authorization_code"] },
+                "response_types": ["code"],
+            }))
+        })();
+        match result {
+            Ok(json) => Response::json(201, json),
+            Err(error) => oauth_error(error),
+        }
+    }
+
+    fn authorize(&self, query: &str, now: u64) -> Response {
+        let result = (|| {
+            let fields = Fields::parse(query)?;
+            if fields.required("response_type")? != "code"
+                || fields.required("code_challenge_method")? != "S256"
+            {
+                return Err(Error::InvalidRequest);
+            }
+            let mut inner = self.lock();
+            let request = inner.oauth.authorization(
+                now,
+                AuthorizeRequest {
+                    client_id: fields.required("client_id")?,
+                    redirect_uri: fields.required("redirect_uri")?,
+                    scope: fields.get("scope"),
+                    challenge: fields.required("code_challenge")?,
+                    state: fields.required("state")?,
+                    resource: fields.get("resource"),
+                },
+            )?;
+            inner.browser.retain(|_, item| item.expires > now);
+            if inner.browser.len() >= 8 {
+                return Err(Error::Busy);
+            }
+            let nonce = URL_SAFE_NO_PAD.encode(oauth::random::<32>()?);
+            inner.browser.insert(
+                nonce.clone(),
+                BrowserConfirmation {
+                    expires: now.saturating_add(120),
+                    request,
+                },
+            );
+            Ok(html(
+                "Connect to Horizon Wii U",
+                &format!(
+                    r#"<p>Send this request to the Wii U. Review the client and its requested access on the GamePad.</p><form action="/oauth/authorize" method="post"><input type="hidden" name="csrf" value="{nonce}"><button>Request approval</button></form>"#
+                ),
+            ))
+        })();
+        result.unwrap_or_else(oauth_error)
+    }
+
+    fn browser_consent(&self, request: &Request, now: u64) -> Response {
+        if request.header("origin") != Some(&self.issuer)
+            || request
+                .header("sec-fetch-site")
+                .is_some_and(|s| s != "same-origin")
+        {
+            return Response::empty(403);
+        }
+        let result = (|| {
+            let fields = form(request)?;
+            let mut inner = self.lock();
+            let nonce = fields.required("csrf")?;
+            let request = inner
+                .browser
+                .remove(nonce)
+                .filter(|p| p.expires > now)
+                .ok_or(Error::InvalidRequest)?;
+            let id = inner.oauth.begin_consent(now, request.request)?;
+            Ok(Response::empty(303).header("Location", format!("/oauth/wait?id={id}")))
+        })();
+        result.unwrap_or_else(oauth_error)
+    }
+
+    fn poll(&self, query: &str, now: u64) -> Response {
+        let result = (|| {
+            let fields = Fields::parse(query)?;
+            let id = fields.required("id")?;
+            let response = match self.lock().oauth.finish(now, id, &self.issuer)? {
+                Some(redirect) => Response::empty(303).header("Location", redirect.to_string()),
+                None => html(
+                    "Awaiting GamePad approval",
+                    &format!(
+                        r#"<p>Compare pairing ID <b>{}</b> with the one on your GamePad, then approve or deny the request there.</p><meta http-equiv="refresh" content="2">"#,
+                        &id[..8]
+                    ),
+                ),
+            };
+            Ok(response)
+        })();
+        result.unwrap_or_else(oauth_error)
+    }
+
+    fn token(&self, request: &Request, now: u64, revoke: bool) -> Response {
+        let result = (|| {
+            let fields = form(request)?;
+            if request.header("authorization").is_some() || fields.get("client_secret").is_some() {
+                return Err(Error::InvalidClient);
+            }
+            let id = fields.required("client_id")?;
+            let mut inner = self.lock();
+            if revoke {
+                inner.oauth.revoke_token(id, fields.required("token")?)?;
+                return Ok(Response::empty(200));
+            }
+            let resource = fields.get("resource");
+            let tokens = match fields.required("grant_type")? {
+                "authorization_code" => inner.oauth.exchange(
+                    now,
+                    id,
+                    fields.required("redirect_uri")?,
+                    fields.required("code")?,
+                    fields.required("code_verifier")?,
+                    resource,
+                )?,
+                "refresh_token" => inner.oauth.refresh(
+                    now,
+                    id,
+                    fields.required("refresh_token")?,
+                    resource,
+                    fields.get("scope"),
+                )?,
+                _ => {
+                    return Ok(Response::json(
+                        400,
+                        json!({"error":"unsupported_grant_type"}),
+                    ))
+                }
+            };
+            Ok(Response::json(
+                200,
+                serde_json::to_value(tokens).map_err(|_| Error::Storage)?,
+            ))
+        })();
+        result.unwrap_or_else(oauth_error)
+    }
+
+    fn mcp(&self, request: &Request, now: u64, disconnected: &dyn Fn() -> bool) -> Response {
+        let auth = request.header("authorization").and_then(|value| {
+            let (scheme, token) = value.split_once(' ')?;
+            scheme.eq_ignore_ascii_case("bearer").then_some(token)
+        });
+        let principal = auth.and_then(|token| self.lock().oauth.authenticate(now, token));
+        let Some(principal) = principal else {
+            let comment = if request.header("authorization").is_some() {
+                r#"error="invalid_token", "#
+            } else {
+                ""
+            };
+            return Response::empty(401).header(
+                "WWW-Authenticate",
+                format!(
+                    r#"Bearer {comment}resource_metadata="{}", scope="launcher.read""#,
+                    self.metadata
+                ),
+            );
+        };
+        let toolbox = AuthorizedTools {
+            backend: &self.backend,
+            principal,
+            metadata: &self.metadata,
+            missing: Mutex::new(None),
+            disconnected,
+        };
+        let response = protocol::dispatch(request, &toolbox);
+        let scope = *toolbox.missing.lock().unwrap();
+        match scope {
+            Some(scope) => response.header(
+                "WWW-Authenticate",
+                format!(
+                    r#"Bearer error="insufficient_scope", resource_metadata="{}", scope="{}""#,
+                    toolbox.metadata,
+                    scope.as_text()
+                ),
+            ),
+            None => response,
+        }
+    }
+
+    fn lock(&self) -> std::sync::MutexGuard<'_, Inner<P>> {
+        self.inner.lock().unwrap_or_else(|error| error.into_inner())
+    }
+}
+
+fn now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |time| time.as_secs())
+}
+
+fn html(title: &str, body: &str) -> Response {
+    Response::bytes(
+        200, "text/html; charset=utf-8",
+        format!(r#"<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>{title}</title><main><h1>{title}</h1>{body}</main></html>"#).into_bytes(),
+    ).header("Content-Security-Policy", "default-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'")
+        .header("Referrer-Policy", "no-referrer")
+        .header("X-Frame-Options", "DENY")
+}
+
+fn oauth_error(error: Error) -> Response {
+    let (status, error, description) = match error {
+        Error::InvalidRequest => (
+            400,
+            "invalid_request",
+            "The request is malformed or expired.",
+        ),
+        Error::InvalidClient => (
+            401,
+            "invalid_client",
+            "Register the public client before pairing.",
+        ),
+        Error::InvalidScope => (
+            400,
+            "invalid_scope",
+            "Request a supported Agent Control scope.",
+        ),
+        Error::InvalidGrant => (
+            400,
+            "invalid_grant",
+            "The credential is invalid or expired.",
+        ),
+        Error::InvalidTarget => (
+            400,
+            "invalid_target",
+            "Use the console's configured MCP URL.",
+        ),
+        Error::Closed => (
+            403,
+            "access_denied",
+            "Enable Agent Control and open pairing on the Wii U.",
+        ),
+        Error::Busy => (
+            429,
+            "temporarily_unavailable",
+            "The Wii U has reached its client or pairing limit.",
+        ),
+        Error::Storage | Error::Random => (
+            503,
+            "temporarily_unavailable",
+            "The Wii U could not complete the security operation.",
+        ),
+    };
+    Response::json(
+        status,
+        json!({"error": error, "error_description": description}),
+    )
+}
+
+struct Fields(BTreeMap<String, String>);
+
+impl Fields {
+    fn parse(query: &str) -> Result<Self, Error> {
+        if query.len() > 8192 {
+            return Err(Error::InvalidRequest);
+        }
+        let mut fields = BTreeMap::new();
+        for (name, value) in url::form_urlencoded::parse(query.as_bytes()) {
+            if fields.len() >= 24
+                || fields
+                    .insert(name.into_owned(), value.into_owned())
+                    .is_some()
+            {
+                return Err(Error::InvalidRequest);
+            }
+        }
+        Ok(Self(fields))
+    }
+
+    fn get(&self, name: &str) -> Option<&str> {
+        self.0.get(name).map(String::as_str)
+    }
+
+    fn required(&self, name: &str) -> Result<&str, Error> {
+        self.get(name)
+            .filter(|v| !v.is_empty())
+            .ok_or(Error::InvalidRequest)
+    }
+}
+
+fn form(request: &Request) -> Result<Fields, Error> {
+    if request.media_type() != Some("application/x-www-form-urlencoded") {
+        return Err(Error::InvalidRequest);
+    }
+    Fields::parse(std::str::from_utf8(&request.body).map_err(|_| Error::InvalidRequest)?)
+}
diff --git a/wiiu/mcp/src/service.rs b/wiiu/mcp/src/service.rs
new file mode 100644
index 0000000000000000000000000000000000000000..607a00de09a7ab9d60bc12b44f69f956a2a6976a
--- /dev/null
+++ b/wiiu/mcp/src/service.rs
@@ -0,0 +1,352 @@
+use crate::oauth::{self, OAuth, Persistence};
+use crate::router::{Backend, Router};
+use crate::tls::{Identity, Listener};
+use horizon_wiiu_security::{
+    Protection, Secret, SecretStore, StorageMode, StorageStatus, Vault, VaultError,
+};
+use serde::{Deserialize, Serialize};
+use std::io;
+use std::net::{Ipv4Addr, SocketAddrV4};
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+use zeroize::Zeroizing;
+
+const IDENTITY: &str = "https_identity";
+const AUTHORIZATION: &str = "oauth_trust";
+const POLICY: &str = "agent_policy";
+
+#[derive(Clone)]
+pub struct SharedVault(Arc<Mutex<Vault>>);
+
+impl SharedVault {
+    fn with<R>(&self, use_vault: impl FnOnce(&mut Vault) -> R) -> R {
+        let mut vault = self.0.lock().unwrap_or_else(|error| error.into_inner());
+        use_vault(&mut vault)
+    }
+}
+
+impl Persistence for SharedVault {
+    fn load(&self) -> io::Result<Option<Zeroizing<Vec<u8>>>> {
+        self.with(|vault| vault.get(AUTHORIZATION))
+            .map(|value| value.map(|secret| Zeroizing::new(secret.expose().to_vec())))
+            .map_err(io::Error::other)
+    }
+
+    fn save(&mut self, data: &[u8]) -> io::Result<()> {
+        self.with(|vault| vault.put(AUTHORIZATION, Secret::new(data.to_vec())))
+            .map_err(io::Error::other)
+    }
+}
+
+#[derive(Clone, Copy, Default, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Policy {
+    pub enabled: bool,
+    pub allow_launch: bool,
+    #[serde(default)]
+    pub allow_game: bool,
+    pub no_ai: bool,
+}
+
+struct Running<T> {
+    listener: Listener,
+    router: Arc<Router<SharedVault, T>>,
+    fingerprint: String,
+}
+
+pub struct Service<T> {
+    root: PathBuf,
+    vault: SharedVault,
+    backend: T,
+    running: Option<Running<T>>,
+}
+
+impl<T: Backend + Clone + Send + Sync + 'static> Service<T> {
+    pub fn open(root: &Path, backend: T) -> Result<Self, VaultError> {
+        let vault = Vault::open(&root.join("private"), "mcp")?;
+        Ok(Self {
+            root: root.to_owned(),
+            vault: SharedVault(Arc::new(Mutex::new(vault))),
+            backend,
+            running: None,
+        })
+    }
+
+    pub fn status(&self) -> StorageStatus {
+        self.vault.with(|vault| vault.status())
+    }
+
+    pub fn unlock(&mut self, pin: &[u8]) -> Result<(), VaultError> {
+        self.vault.with(|vault| vault.unlock(pin))
+    }
+
+    pub fn protect(&mut self, protection: Protection<'_>) -> Result<(), VaultError> {
+        self.vault.with(|vault| vault.set_protection(protection))
+    }
+
+    pub fn policy(&self) -> Result<Policy, VaultError> {
+        match self.vault.with(|vault| vault.get(POLICY))? {
+            Some(value) => serde_json::from_slice(value.expose()).map_err(|_| VaultError::Corrupt),
+            None => Ok(Policy::default()),
+        }
+    }
+
+    pub fn set_policy(&mut self, policy: Policy) -> Result<(), VaultError> {
+        // Enforce disabling immediately even if the SD write fails.
+        let revoked = if policy.no_ai || !policy.enabled {
+            self.running.as_ref().map_or(Ok(()), |running| {
+                running.router.local(|oauth, _| {
+                    oauth.set_disabled(true);
+                    oauth.revoke_access_tokens()
+                })
+            })
+        } else {
+            Ok(())
+        };
+        let bytes = serde_json::to_vec(&policy).map_err(|_| VaultError::Corrupt)?;
+        self.vault
+            .with(|vault| vault.put(POLICY, Secret::new(bytes)))?;
+        revoked.map_err(|_| VaultError::StorageUnavailable)?;
+        if let Some(running) = &self.running {
+            running
+                .router
+                .local(|oauth, _| oauth.set_disabled(policy.no_ai || !policy.enabled));
+        }
+        Ok(())
+    }
+
+    pub fn connect(
+        &mut self,
+        address: Ipv4Addr,
+        port: u16,
+        hostname: Option<&str>,
+        fixture: bool,
+    ) -> io::Result<()> {
+        if self.connection().is_some() {
+            return Ok(());
+        }
+        self.shutdown();
+        let status = self.status();
+        if !status.initialized || status.locked || status.mode == StorageMode::SessionOnly {
+            return Ok(());
+        }
+        let policy = self.policy().map_err(io::Error::other)?;
+        if !policy.enabled || policy.no_ai {
+            return Ok(());
+        }
+        if port == 0 || !crate::tls::allowed_bind(address, fixture) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "Agent Control needs a private IPv4 address and a fixed port",
+            ));
+        }
+        if hostname.is_some_and(|host| !safe_hostname(host)) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "Use an ASCII LAN DNS name under .home.arpa or .local",
+            ));
+        }
+        let host = hostname
+            .map(str::to_owned)
+            .unwrap_or_else(|| address.to_string());
+        let issuer = if port == 443 {
+            format!("https://{host}")
+        } else {
+            format!("https://{host}:{port}")
+        };
+        let identity = self.identity(address, hostname, &host)?;
+        let auth = OAuth::open(self.vault.clone(), format!("{issuer}/mcp")).map_err(|error| {
+            let message = match error {
+                oauth::Error::Storage => {
+                    "The OAuth records belong to a different endpoint or could not be read"
+                }
+                _ => "OAuth initialization failed",
+            };
+            io::Error::other(message)
+        })?;
+        let router = Arc::new(
+            Router::new(issuer, auth, self.backend.clone())
+                .map_err(|_| io::Error::other("Invalid OAuth endpoint"))?,
+        );
+        let net = router.clone();
+        let pem = identity.public_root_pem();
+        let directory = self.root.join("launcher");
+        std::fs::create_dir_all(&directory)?;
+        std::fs::write(directory.join("agent-control-ca.pem"), pem)?;
+        let listener = Listener::start(
+            SocketAddrV4::new(address, port),
+            fixture,
+            identity.server_config().map_err(io::Error::other)?,
+            move |request, _peer, disconnected| net.handle(request, disconnected),
+        )?;
+        self.running = Some(Running {
+            listener,
+            router,
+            fingerprint: identity.fingerprint(),
+        });
+        Ok(())
+    }
+
+    fn identity(
+        &self,
+        address: Ipv4Addr,
+        hostname: Option<&str>,
+        requested: &str,
+    ) -> io::Result<Identity> {
+        match self
+            .vault
+            .with(|vault| vault.get(IDENTITY))
+            .map_err(io::Error::other)?
+        {
+            Some(secret) => {
+                let identity: Identity =
+                    serde_json::from_slice(secret.expose()).map_err(io::Error::other)?;
+                if !identity.supports_name(requested) {
+                    return Err(io::Error::other("The address changed. Rotate the HTTPS identity locally, or restore the original address."));
+                }
+                Ok(identity)
+            }
+            None => {
+                let identity = Identity::generate(address, hostname).map_err(io::Error::other)?;
+                let bytes = serde_json::to_vec(&identity).map_err(io::Error::other)?;
+                self.vault
+                    .with(|vault| vault.put(IDENTITY, Secret::new(bytes)))
+                    .map_err(io::Error::other)?;
+                Ok(identity)
+            }
+        }
+    }
+
+    pub fn shutdown(&mut self) {
+        if let Some(running) = self.running.take() {
+            running.router.local(|oauth, _| oauth.set_disabled(true));
+            drop(running);
+        }
+    }
+
+    pub fn rotate(&mut self) -> Result<(), VaultError> {
+        self.shutdown();
+        self.vault.with(|vault| {
+            vault.remove(AUTHORIZATION)?;
+            vault.remove(IDENTITY)
+        })
+    }
+
+    pub fn connection(&self) -> Option<(&str, &str)> {
+        let running = self
+            .running
+            .as_ref()
+            .filter(|running| running.listener.is_running())?;
+        Some((running.router.issuer(), &running.fingerprint))
+    }
+
+    pub fn local<R>(&self, action: impl FnOnce(&mut OAuth<SharedVault>, u64) -> R) -> Option<R> {
+        self.running
+            .as_ref()
+            .map(|running| running.router.local(action))
+    }
+}
+
+fn safe_hostname(host: &str) -> bool {
+    if host.len() > 253 || !(host.ends_with(".home.arpa") || host.ends_with(".local")) {
+        return false;
+    }
+    host.split('.').all(|label| {
+        !label.is_empty()
+            && label.len() <= 63
+            && !label.starts_with('-')
+            && !label.ends_with('-')
+            && label
+                .bytes()
+                .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::oauth::{Principal, Scopes};
+    use crate::protocol::{text_result, Fault};
+    use serde_json::Value;
+    use std::net::TcpListener;
+
+    #[derive(Clone)]
+    struct TestBackend;
+
+    impl Backend for TestBackend {
+        fn list(&self, _: &Principal) -> Vec<Value> {
+            Vec::new()
+        }
+        fn required(&self, _: &str) -> Option<Scopes> {
+            None
+        }
+        fn call(
+            &self,
+            _: &Principal,
+            _: &str,
+            _: &Value,
+            _: &dyn Fn() -> bool,
+        ) -> Result<Value, Fault> {
+            Ok(text_result("test", false))
+        }
+    }
+
+    #[test]
+    fn cold_restart_requires_pin_or_automatically_restores_https_identity() {
+        let root = std::env::temp_dir().join(format!(
+            "horizon-mcp-storage-{}",
+            u64::from_be_bytes(crate::oauth::random::<8>().unwrap())
+        ));
+        std::fs::create_dir(&root).unwrap();
+        let port = TcpListener::bind((Ipv4Addr::LOCALHOST, 0))
+            .unwrap()
+            .local_addr()
+            .unwrap()
+            .port();
+        let mut service = Service::open(&root, TestBackend).unwrap();
+        service
+            .connect(Ipv4Addr::LOCALHOST, port, None, true)
+            .unwrap();
+        assert!(service.connection().is_none());
+        service.protect(Protection::ConfirmedUnprotected).unwrap();
+        service
+            .set_policy(Policy {
+                enabled: true,
+                ..Policy::default()
+            })
+            .unwrap();
+        service
+            .connect(Ipv4Addr::LOCALHOST, port, None, true)
+            .unwrap();
+        let first = service.connection().unwrap().1.to_owned();
+        drop(service);
+
+        let mut service = Service::open(&root, TestBackend).unwrap();
+        assert_eq!(service.status().mode, StorageMode::Unprotected);
+        service
+            .connect(Ipv4Addr::LOCALHOST, port, None, true)
+            .unwrap();
+        assert_eq!(service.connection().unwrap().1, first);
+        service
+            .protect(Protection::PinProtected {
+                new_pin: b"fixture-246810",
+            })
+            .unwrap();
+        drop(service);
+
+        let mut service = Service::open(&root, TestBackend).unwrap();
+        assert!(service.status().locked);
+        service
+            .connect(Ipv4Addr::LOCALHOST, port, None, true)
+            .unwrap();
+        assert!(service.connection().is_none());
+        assert!(service.unlock(b"fixture-invalid").is_err());
+        service.unlock(b"fixture-246810").unwrap();
+        service
+            .connect(Ipv4Addr::LOCALHOST, port, None, true)
+            .unwrap();
+        assert_eq!(service.connection().unwrap().1, first);
+        drop(service);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
diff --git a/wiiu/mcp/src/session.rs b/wiiu/mcp/src/session.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5919f11701dae757668207d6f1038717442774df
--- /dev/null
+++ b/wiiu/mcp/src/session.rs
@@ -0,0 +1,232 @@
+use crate::oauth::Principal;
+use std::collections::VecDeque;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{mpsc, Arc, Mutex};
+use std::time::{Duration, Instant};
+
+const MAX_PENDING: usize = 4;
+const DEADLINE: Duration = Duration::from_secs(12);
+const DISCONNECT_POLL: Duration = Duration::from_millis(30);
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Error {
+    NoGame,
+    Busy,
+    Cancelled,
+    Disabled,
+}
+
+#[derive(Clone, Default)]
+pub struct Session(Arc<Mutex<State>>);
+
+#[derive(Default)]
+struct State {
+    generation: u64,
+    live: bool,
+    controllable: bool,
+    requests: VecDeque<Queued>,
+    active: Option<Guard>,
+}
+
+#[derive(Clone)]
+struct Guard {
+    principal: Principal,
+    cancelled: Arc<AtomicBool>,
+    finished: Arc<AtomicBool>,
+    deadline: Instant,
+}
+
+impl Guard {
+    fn alive(&self) -> bool {
+        !self.cancelled.load(Ordering::Acquire)
+            && self.deadline > Instant::now()
+            && self.principal.is_active()
+    }
+}
+
+struct Queued {
+    generation: u64,
+    guard: Guard,
+    request: Request,
+}
+
+pub struct Request {
+    pub line: String,
+    pub reply: mpsc::Sender<String>,
+}
+
+/// Scoped to one application-owned launch, including loading and save.
+pub struct Registration {
+    session: Session,
+    generation: u64,
+}
+
+impl Session {
+    pub fn prepare(&self, controllable: bool) -> Registration {
+        let mut state = self.lock();
+        state.generation = state.generation.wrapping_add(1);
+        state.live = false;
+        state.controllable = controllable;
+        state.requests.clear();
+        state.active = None;
+        Registration {
+            session: self.clone(),
+            generation: state.generation,
+        }
+    }
+
+    /// Called by the game thread. A cancelled deferred request is withdrawn
+    /// before another action starts, so it cannot outlive its client.
+    pub fn poll(&self, ready: bool) -> (Option<Request>, bool) {
+        let mut state = self.lock();
+        let was_live = state.live;
+        state.live = ready && state.controllable;
+        if !state.live {
+            state.requests.clear();
+            return (None, state.active.take().is_some() || was_live);
+        }
+        let mut cancelled = false;
+        if let Some(active) = state.active.as_ref() {
+            if active.finished.load(Ordering::Acquire) {
+                state.active = None;
+            } else if !active.alive() {
+                state.active = None;
+                cancelled = true;
+            } else {
+                return (None, false);
+            }
+        }
+        while let Some(item) = state.requests.pop_front() {
+            if item.generation == state.generation && item.guard.alive() {
+                state.active = Some(item.guard);
+                return (Some(item.request), cancelled);
+            }
+        }
+        (None, cancelled)
+    }
+
+    pub fn live(&self) -> bool {
+        self.lock().live
+    }
+
+    pub fn withdraw(&self) {
+        let mut state = self.lock();
+        state.live = false;
+        state.requests.clear();
+        if let Some(active) = state.active.take() {
+            active.cancelled.store(true, Ordering::Release);
+        }
+    }
+
+    pub fn call(
+        &self,
+        principal: &Principal,
+        line: String,
+        disconnected: &dyn Fn() -> bool,
+    ) -> Result<String, Error> {
+        if disconnected() {
+            return Err(Error::Cancelled);
+        }
+        let (reply, result) = mpsc::channel();
+        let guard = Guard {
+            principal: principal.clone(),
+            finished: Arc::default(),
+            cancelled: Arc::default(),
+            deadline: Instant::now() + DEADLINE,
+        };
+        {
+            let mut state = self.lock();
+            if !state.live {
+                return Err(Error::NoGame);
+            }
+            if !principal.is_active() {
+                return Err(Error::Disabled);
+            }
+            if state.requests.len() >= MAX_PENDING {
+                return Err(Error::Busy);
+            }
+            let generation = state.generation;
+            state.requests.push_back(Queued {
+                generation,
+                guard: guard.clone(),
+                request: Request { line, reply },
+            });
+        }
+        while guard.alive() && !disconnected() {
+            match result.recv_timeout(DISCONNECT_POLL) {
+                Ok(value) => {
+                    guard.finished.store(true, Ordering::Release);
+                    return Ok(value);
+                }
+                Err(mpsc::RecvTimeoutError::Disconnected) => {
+                    guard.finished.store(true, Ordering::Release);
+                    return Err(Error::NoGame);
+                }
+                Err(mpsc::RecvTimeoutError::Timeout) => {}
+            }
+        }
+        guard.cancelled.store(true, Ordering::Release);
+        Err(Error::Cancelled)
+    }
+
+    fn lock(&self) -> std::sync::MutexGuard<'_, State> {
+        self.0.lock().unwrap_or_else(|error| error.into_inner())
+    }
+}
+
+impl Drop for Registration {
+    fn drop(&mut self) {
+        let mut state = self.session.lock();
+        if state.generation == self.generation {
+            state.requests.clear();
+            state.live = false;
+            state.controllable = false;
+            if let Some(active) = state.active.take() {
+                active.cancelled.store(true, Ordering::Release);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cancelled_requests_and_old_generations_are_withdrawn() {
+        let game = Session::default();
+        let principal = Principal::fixture();
+        assert_eq!(
+            game.call(&principal, "status".into(), &|| false),
+            Err(Error::NoGame)
+        );
+        let old = game.prepare(true);
+        assert!(game.poll(false).0.is_none());
+        game.poll(true);
+        let client = game.clone();
+        let connected = Arc::new(AtomicBool::new(true));
+        let peer = connected.clone();
+        let controller = std::thread::spawn(move || {
+            client.call(&principal, "move forward 8".into(), &|| {
+                !peer.load(Ordering::Acquire)
+            })
+        });
+        let limit = Instant::now() + Duration::from_secs(2);
+        let request = loop {
+            if let Some(req) = game.poll(true).0 {
+                break req;
+            }
+            assert!(Instant::now() < limit);
+            std::thread::yield_now();
+        };
+        assert_eq!(request.line, "move forward 8");
+        connected.store(false, Ordering::Release);
+        assert_eq!(controller.join().unwrap(), Err(Error::Cancelled));
+        assert!(game.poll(true).1);
+        let new = game.prepare(false);
+        drop(old);
+        assert!(game.poll(true).0.is_none());
+        assert!(!game.live());
+        drop(new);
+    }
+}
diff --git a/wiiu/mcp/src/tls.rs b/wiiu/mcp/src/tls.rs
