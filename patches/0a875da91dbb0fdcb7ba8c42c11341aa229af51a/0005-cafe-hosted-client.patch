+                        Err(error) => {
+                            hosted_save_failed = true;
+                            log::error!("Cafe hosted save remains incomplete: {error}");
+                            startup_report!("hosted save barrier failed");
+                        }
+                    }
+                }
+                if let Err(error) = game.draw_hosted_save(self.presenter, hosted_save_failed) {
+                    log::error!("Cafe hosted save screen: {error}");
+                }
+                let _sleep = Span::new(Stage::Sleep);
+                std::thread::sleep(Duration::from_millis(16));
+                continue;
+            }
+            if trace_draw {
+                startup_report!("loading first draw begin");
+            }
+            let draw_started = Instant::now();
+            if trace_this_iteration {
+                log::info!(
+                    "Horizon Cafe host loop trace iteration={} phase=draw.begin",
+                    host_loop_iteration
+                );
+            }
+            let mut world_start_failure = None;
+            let previous_present = unsafe { horizon_loading_host_completed_presents() };
+            let draw_result = if let Some(game) = &mut game_session {
+                self.sync_game_viewport(game);
+                // Game can consume the pending entry while reporting an error.
+                let starting_entry = game.starting_entry_kind();
+                let event_loop = LoadingFrameEventLoop {
+                    control: &self.control,
+                };
+                if !first_game_frame_started {
+                    first_game_frame_started = true;
+                    startup_report!("first original Game frame begin");
+                    log::info!(
+                        "Horizon Cafe first original Game frame begin elapsed_ms={}",
+                        host_loop_started.elapsed().as_millis()
+                    );
+                }
+                match game.frame(&event_loop, self.presenter) {
+                    Ok(_frame_drawn) => {
+                        let world_ready = game.world_loading_complete();
+                        if !first_game_frame_returned {
+                            first_game_frame_returned = true;
+                            startup_report!("first original Game frame returned");
+                            log::info!(
+                                "Horizon Cafe first original Game frame returned elapsed_ms={} world_ready={}",
+                                host_loop_started.elapsed().as_millis(),
+                                world_ready
+                            );
+                        }
+                        if world_ready && !world_loading_complete {
+                            startup_report!("Game world-entry pending state cleared");
+                            log::info!(
+                                "Horizon Cafe Game world-entry pending state cleared elapsed_ms={}",
+                                host_loop_started.elapsed().as_millis()
+                            );
+                        }
+                        world_loading_complete |= world_ready;
+                        Ok(())
+                    }
+                    Err(error) => {
+                        if !first_game_frame_returned {
+                            first_game_frame_returned = true;
+                            startup_report!("first original Game frame failed");
+                            log::error!(
+                                "Horizon Cafe first original Game frame failed elapsed_ms={}",
+                                host_loop_started.elapsed().as_millis()
+                            );
+                        }
+                        world_start_failure = starting_entry.or_else(|| {
+                            (!world_loading_complete
+                                && game.entry_kind() != CafeGameEntryKind::TitleScreen)
+                                .then_some(game.entry_kind())
+                        });
+                        Err(error)
+                    }
+                }
+            } else {
+                if trace_this_iteration {
+                    self.presenter.trace_next_loading_frame();
+                    log::info!(
+                        "Horizon Cafe host loop trace iteration={} phase=loading_session.draw.begin",
+                        host_loop_iteration
+                    );
+                }
+                let result = session
+                    .draw_traced(
+                        self.presenter,
+                        trace_this_iteration.then_some(host_loop_iteration),
+                    )
+                    .map(|_| ());
+                if trace_this_iteration {
+                    log::info!(
+                        "Horizon Cafe host loop trace iteration={} phase=loading_session.draw.end",
+                        host_loop_iteration
+                    );
+                }
+                result
+            };
+            if trace_this_iteration {
+                log::info!(
+                    "Horizon Cafe host loop trace iteration={} phase=draw.end",
+                    host_loop_iteration
+                );
+            }
+            if trace_draw {
+                startup_report!("loading first draw returned");
+                trace_draw = false;
+            }
+            if self.trace_touch_draw_this_frame {
+                self.trace_touch_draw_this_frame = false;
+                log::info!(
+                    "Horizon Cafe touch: current frame draw returned elapsed_ms={}",
+                    draw_started.elapsed().as_millis()
+                );
+            }
+            if let Err(error) = draw_result {
+                if let Some(entry_kind) = world_start_failure {
+                    match game_start_failure_status(entry_kind) {
+                        CafeLoadingStatus::LocalWorldStartFailed => {
+                            self.local_world_start_failed = true;
+                            log::error!("Horizon Cafe local world start failed: {error}");
+                            startup_report!("original local world startup failed");
+                        }
+                        CafeLoadingStatus::RemoteServerStartFailed => {
+                            self.remote_server_start_failed = true;
+                            log::error!("Horizon Cafe remote server start failed: {error}");
+                            startup_report!("original remote server startup failed");
+                        }
+                        CafeLoadingStatus::Failed => {
+                            log::error!("Horizon Cafe title session failed: {error}");
+                        }
+                        _ => unreachable!("entry startup maps to a start-failure status"),
+                    }
+                } else if game_session.is_some() {
+                    log::error!("Horizon Cafe world loading presentation failed: {error}");
+                    startup_report!("Cafe world loading frame failed");
+                } else {
+                    log::error!("Horizon Cafe Loading draw failed: {error}");
+                    startup_report!("Cafe Loading draw failed");
+                }
+                self.failure = Some(error.to_string());
+                if self.hosted && game_session.as_ref().is_some_and(CafeGameSession::hosted_needs_close) {
+                    // Preserve the active world on a late rendering failure.
+                    // Even this path must go through the durable close barrier.
+                    hosted_fault_close = true;
+                    continue;
+                }
+                break;
+            }
+            frames_since_progress_report = frames_since_progress_report.saturating_add(1);
+            if progress_report_at.elapsed() >= Duration::from_secs(5) {
+                log::info!(
+                    "Horizon Cafe loop heartbeat: frames={} status={:?} failure={}",
+                    frames_since_progress_report,
+                    session.status(),
+                    self.failure.is_some()
+                );
+                progress_report_at = Instant::now();
+                frames_since_progress_report = 0;
+            }
+
+            // A successful WHB present already paces the next frame at
+            // the display. Yield when no output was accepted, including
+            // suspended or temporarily unrenderable frames.
+            let presented = unsafe { horizon_loading_host_completed_presents() } != previous_present;
+            let delay = match self.control.get() {
+                EventLoopControl::Exit => Duration::ZERO,
+                EventLoopControl::Poll if presented && !legacy_pacing => Duration::ZERO,
+                EventLoopControl::Poll => Duration::from_millis(16),
+                EventLoopControl::WaitUntil(deadline) => {
+                    deadline.saturating_duration_since(Instant::now())
+                }
+            };
+            if !delay.is_zero() {
+                if trace_this_iteration {
+                    log::info!(
+                        "Horizon Cafe host loop trace iteration={} phase=sleep.begin",
+                        host_loop_iteration
+                    );
+                }
+                let _sleep = Span::new(Stage::Sleep);
+                std::thread::sleep(delay.min(Duration::from_millis(16)));
+                if trace_this_iteration {
+                    log::info!(
+                        "Horizon Cafe host loop trace iteration={} phase=sleep.end",
+                        host_loop_iteration
+                    );
+                }
+            }
+        }
+        log::info!(
+            "Horizon Cafe host loop exited iteration={} failure={}",
+            host_loop_iteration,
+            self.failure.is_some()
+        );
+        // Every way out of the host loop releases touch and controller edges
+        // while the Loading session and its event loop are still alive.
+        if self.hosted {
+            self.release_on_exit(session, game_session.as_mut());
+            if let Some(game) = &mut game_session {
+                if let Err(error) = game.shutdown_hosted() {
+                    log::error!("Cafe hosted shutdown save failed: {error}");
+                    self.hosted_exit_save_failed = true;
+                }
+                if let Err(error) = game.drain_hosted_workers() {
+                    self.failure.get_or_insert_with(|| error.to_string());
+                }
+            }
+            drop(game_session);
+            session.drain_hosted()?;
+            startup_report!("hosted game and loading workers released");
+        } else {
+            if let Some(game) = &mut game_session {
+                game.shutdown();
+            }
+            self.release_on_exit(session, game_session.as_mut());
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn initial_game_frame_failure_preserves_pending_entry_kind() {
+        assert_eq!(
+            game_start_failure_status(CafeGameEntryKind::LocalWorld),
+            CafeLoadingStatus::LocalWorldStartFailed
+        );
+        assert_eq!(
+            game_start_failure_status(CafeGameEntryKind::RemoteServer),
+            CafeLoadingStatus::RemoteServerStartFailed
+        );
+        assert_eq!(
+            game_start_failure_status(CafeGameEntryKind::TitleScreen),
+            CafeLoadingStatus::Failed
+        );
+    }
+}
diff --git a/wiiu/loading_app/src/local_wire.rs b/wiiu/loading_app/src/local_wire.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1377283affeca5dba3f7572f78387cbb21b08423
--- /dev/null
+++ b/wiiu/loading_app/src/local_wire.rs
@@ -0,0 +1,91 @@
+//! Fixed-size exchange between Night's renderer and its hosted local services.
+
+pub const ROWS: usize = 6;
+pub const ACTIVE: u8 = 0;
+pub const SELECTED: u8 = 1;
+pub const DISABLED: u8 = 2;
+pub const EDITOR: u8 = 1;
+pub const PRIVATE_INPUT: u8 = 2;
+pub const NO_UPDATE: u8 = 4;
+pub const SWAP_AB: u8 = 1;
+pub const SWAP_XY: u8 = 2;
+pub const TOUCH: u8 = 4;
+
+pub const OPEN_PROFILES: u8 = 1;
+pub const OPEN_LIBRARY: u8 = 2;
+pub const OPEN_VERSIONS: u8 = 3;
+pub const OPEN_SETTINGS: u8 = 4;
+pub const BACK: u8 = 5;
+pub const LEFT: u8 = 6;
+pub const RIGHT: u8 = 7;
+pub const ACTIVATE: u8 = 8;
+pub const TEXT_ACCEPTED: u8 = 9;
+pub const TEXT_CANCELLED: u8 = 10;
+pub const TEXT_UNAVAILABLE: u8 = 11;
+pub const TICK: u8 = 12;
+pub const SHUTDOWN: u8 = 13;
+pub const OPEN_AGENT: u8 = 14;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(transparent)]
+pub struct Text<const N: usize>([u8; N]);
+
+impl<const N: usize> Default for Text<N> {
+    fn default() -> Self {
+        Self([0; N])
+    }
+}
+
+impl<const N: usize> Text<N> {
+    pub fn new(value: &str) -> Self {
+        let mut bytes = [0; N];
+        let mut length = value.len().min(N);
+        while !value.is_char_boundary(length) {
+            length -= 1;
+        }
+        bytes[..length].copy_from_slice(&value.as_bytes()[..length]);
+        Self(bytes)
+    }
+
+    pub fn as_str(&self) -> &str {
+        let length = self.0.iter().position(|&byte| byte == 0).unwrap_or(N);
+        // These bytes originate in Text::new or the zeroed default, including
+        // the values built by the Rust side of the host ABI. Both the capacity
+        // cut and a NUL cut fall on UTF-8 boundaries.
+        unsafe { core::str::from_utf8_unchecked(self.0.get(..length).unwrap_or(&[])) }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+#[repr(C)]
+pub struct LocalRow {
+    pub label: Text<46>,
+    pub detail: Text<64>,
+    pub state: u8,
+}
+
+#[derive(Clone, Copy, Default, PartialEq, Eq)]
+#[repr(C)]
+pub struct LocalMenu {
+    pub title: Text<30>,
+    pub description: Text<100>,
+    pub profile: Text<28>,
+    pub play_detail: Text<52>,
+    pub rows: [LocalRow; ROWS],
+    pub count: u8,
+    pub mode: u8,
+    pub ready: u8,
+    pub settings: u8,
+    pub input: Text<253>,
+    pub input_limit: u16,
+}
+
+impl core::fmt::Debug for LocalMenu {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("LocalMenu")
+            .field("rows", &self.count)
+            .field("mode", &self.mode)
+            .field("ready", &self.ready)
+            .finish_non_exhaustive()
+    }
+}
diff --git a/wiiu/loading_app/src/night_mcp.rs b/wiiu/loading_app/src/night_mcp.rs
new file mode 100644
index 0000000000000000000000000000000000000000..378109809add3569a1675de85d10703269fb9246
--- /dev/null
+++ b/wiiu/loading_app/src/night_mcp.rs
@@ -0,0 +1,427 @@
+//! Hosted Cafe wiring. The HTTP workers never hold or access Game.
+use super::{local_service, local_wire as wire, night_menu::Launch, CAFE_APP_ROOT};
+use horizon_wiiu_mcp::{
+    oauth::{Principal, Scopes},
+    protocol::{text_result, Fault},
+    router::Backend,
+    service::{Policy, Service},
+    session::{self, Session},
+};
+use serde_json::{json, Value};
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+#[allow(dead_code)]
+#[path = "../../../crates/horizon-client/src/bin/horizon-ctl/commands.rs"]
+mod commands;
+#[path = "night_mcp_menu.rs"]
+mod menu;
+
+static HOME: AtomicBool = AtomicBool::new(false);
+static GAME_ALLOWED: AtomicBool = AtomicBool::new(false);
+static REMOTE_LAUNCH: AtomicBool = AtomicBool::new(false);
+static NO_AI: AtomicBool = AtomicBool::new(false);
+static GAME_NO_AI: AtomicBool = AtomicBool::new(false);
+static LAUNCH: Mutex<Option<(Principal, Value)>> = Mutex::new(None);
+
+fn session() -> &'static Session {
+    static SESSION: OnceLock<Session> = OnceLock::new();
+    SESSION.get_or_init(Session::default)
+}
+
+fn menu() -> &'static Mutex<menu::Menu> {
+    static MENU: OnceLock<Mutex<menu::Menu>> = OnceLock::new();
+    MENU.get_or_init(|| {
+        let menu = menu::Menu::open(Path::new(CAFE_APP_ROOT));
+        horizon_client::control::install_hosted_mcp(poll_game, || NO_AI.load(Ordering::Acquire));
+        Mutex::new(menu)
+    })
+}
+
+pub(super) fn change_policy(service: &mut Service<NightTools>, policy: Policy) -> bool {
+    let written = service.set_policy(policy).is_ok();
+    let disabled = policy.no_ai || !policy.enabled;
+    if written || disabled {
+        load_policy(policy);
+    }
+    written
+}
+
+fn load_policy(policy: Policy) {
+    GAME_ALLOWED.store(
+        policy.enabled && policy.allow_game && !policy.no_ai,
+        Ordering::Release,
+    );
+    REMOTE_LAUNCH.store(
+        policy.enabled && policy.allow_game && policy.allow_launch && !policy.no_ai,
+        Ordering::Release,
+    );
+    NO_AI.store(policy.no_ai, Ordering::Release);
+    if policy.no_ai || !policy.enabled {
+        session().withdraw();
+        LAUNCH.lock().unwrap().take();
+    }
+}
+
+pub(super) fn menu_open() -> bool {
+    menu().lock().unwrap().is_open()
+}
+
+pub(super) fn local_menu(command: u8, index: u8, base: wire::LocalMenu) -> Option<wire::LocalMenu> {
+    menu().lock().unwrap().update(command, index, base)
+}
+
+#[no_mangle]
+pub extern "C" fn horizon_night_mcp_tick(on_home: bool) -> bool {
+    let changed = HOME.swap(on_home, Ordering::AcqRel) != on_home;
+    if on_home {
+        return LAUNCH.lock().unwrap().is_some();
+    }
+    if changed {
+        LAUNCH.lock().unwrap().take();
+    }
+    false
+}
+
+#[no_mangle]
+pub extern "C" fn horizon_night_mcp_shutdown() {
+    HOME.store(false, Ordering::Release);
+    LAUNCH.lock().unwrap().take();
+    session().withdraw();
+    if let Some(mut menu) = menu().lock().ok() {
+        menu.shutdown();
+    }
+}
+
+pub(super) fn take_launch() -> Result<Option<Launch>, ()> {
+    HOME.store(false, Ordering::Release);
+    let request = LAUNCH.lock().unwrap().take();
+    match request {
+        Some((principal, args))
+            if principal.is_active() && REMOTE_LAUNCH.load(Ordering::Acquire) =>
+        {
+            local_service()
+                .lock()
+                .unwrap()
+                .tool_launch(&args)
+                .map(Some)
+                .map_err(|_| ())
+        }
+        Some(_) => Err(()),
+        None => Ok(None),
+    }
+}
+
+pub(super) fn prepare_game() -> session::Registration {
+    GAME_NO_AI.store(false, Ordering::Release);
+    session().prepare(GAME_ALLOWED.load(Ordering::Acquire) && !NO_AI.load(Ordering::Acquire))
+}
+
+pub(crate) fn withdraw() {
+    session().withdraw();
+}
+
+fn poll_game(no_ai: bool, ready: bool) -> (Option<horizon_client::control::Request>, bool) {
+    let old = GAME_NO_AI.swap(no_ai, Ordering::AcqRel);
+    if old != no_ai {
+        if let Some(service) = menu().lock().unwrap().service.as_mut() {
+            if let Ok(mut policy) = service.policy() {
+                policy.no_ai = no_ai;
+                change_policy(service, policy);
+            }
+        }
+    }
+    let before = session().live();
+    let (request, cancelled) =
+        session().poll(ready && !no_ai && GAME_ALLOWED.load(Ordering::Acquire));
+    (
+        request.map(|r| horizon_client::control::Request {
+            line: r.line,
+            reply: r.reply,
+        }),
+        cancelled || (before && !session().live()) || (!old && no_ai),
+    )
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct NightTools;
+
+const READ: &[&str] = &[
+    "versions",
+    "settings",
+    "instance_list",
+    "worlds_list",
+    "multiplayer_list",
+];
+const MANAGE: &[&str] = &["instance_select", "multiplayer_add"];
+const OBSERVE: &[&str] = &[
+    "game_hello",
+    "game_state",
+    "game_status",
+    "game_screen",
+    "game_inventory",
+    "game_looking_at",
+    "game_entities",
+    "game_block",
+    "game_light",
+    "game_blocks",
+    "game_find_block",
+    "game_ui",
+    "game_messages",
+    "game_narration",
+    "game_wait_ready",
+    "game_screenshot",
+];
+const CONTROL: &[&str] = &[
+    "game_move",
+    "game_jump",
+    "game_look",
+    "game_turn",
+    "game_look_at",
+    "game_look_at_block",
+    "game_look_at_entity",
+    "game_goto",
+    "game_break",
+    "game_place",
+    "game_interact",
+    "game_attack",
+    "game_select",
+    "game_click_slot",
+    "game_close",
+    "game_open_inventory",
+    "game_pause",
+    "game_resume",
+    "game_save",
+    "game_quit",
+];
+
+fn catalog() -> &'static [Value] {
+    static CATALOG: OnceLock<Vec<Value>> = OnceLock::new();
+    CATALOG.get_or_init(|| {
+        let inventory: Value = serde_json::from_str(include_str!("pinned_tools.json"))
+            .expect("verified pinned MCP tool inventory");
+        inventory["tools"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .flat_map(|row| row.get("tool").cloned())
+            .filter(|tool| {
+                NightTools
+                    .required(tool["name"].as_str().unwrap_or_default())
+                    .is_some()
+            })
+            .collect()
+    })
+}
+
+impl Backend for NightTools {
+    fn list(&self, principal: &Principal) -> Vec<Value> {
+        let live = session().live();
+        catalog()
+            .iter()
+            .filter(|tool| {
+                let name = tool["name"].as_str().unwrap_or_default();
+                (!name.starts_with("game_") || live)
+                    && (name != "play" || REMOTE_LAUNCH.load(Ordering::Acquire))
+                    && self
+                        .required(name)
+                        .is_some_and(|scope| principal.scopes.contains(scope))
+            })
+            .cloned()
+            .collect()
+    }
+
+    fn required(&self, name: &str) -> Option<Scopes> {
+        if READ.contains(&name) {
+            return Some(Scopes::LAUNCHER_READ);
+        }
+        if MANAGE.contains(&name) {
+            return Some(Scopes::LAUNCHER_MANAGE);
+        }
+        if name == "play" {
+            return Some(Scopes::LAUNCHER_MANAGE.union(Scopes::GAME_CONTROL));
+        }
+        if OBSERVE.contains(&name) {
+            return Some(Scopes::GAME_OBSERVE);
+        }
+        if CONTROL.contains(&name) {
+            return Some(Scopes::GAME_CONTROL);
+        }
+        None
+    }
+
+    fn call(
+        &self,
+        principal: &Principal,
+        name: &str,
+        args: &Value,
+        disconnected: &dyn Fn() -> bool,
+    ) -> Result<Value, Fault> {
+        if disconnected() {
+            return Err(Fault::new(400, -32000, "Client disconnected"));
+        }
+        if !principal.is_active() || NO_AI.load(Ordering::Acquire) {
+            return Err(Fault::new(
+                403,
+                -32000,
+                "AI features are off: turn off No AI in the launcher's settings",
+            ));
+        }
+        if name == "play" {
+            if !REMOTE_LAUNCH.load(Ordering::Acquire) {
+                return Ok(text_result(
+                    "The player has disabled remote game launches.",
+                    true,
+                ));
+            }
+            if !HOME.load(Ordering::Acquire) {
+                return Ok(text_result(
+                    "Return to the Night home page before starting a game.",
+                    true,
+                ));
+            }
+            let mut request = LAUNCH.lock().unwrap();
+            if !HOME.load(Ordering::Acquire) {
+                return Ok(text_result(
+                    "Return to the Night home page before starting a game.",
+                    true,
+                ));
+            }
+            if request.is_some() {
+                return Ok(text_result("The game is already starting.", true));
+            }
+            let start = local_service().lock().unwrap().tool_launch(args);
+            return Ok(match start {
+                Ok(_) => {
+                    *request = Some((principal.clone(), args.clone()));
+                    text_result(
+                        "Horizon is starting. Use game_wait_ready once the game tools appear.",
+                        false,
+                    )
+                }
+                Err(err) => text_result(err, true),
+            });
+        }
+        if name.starts_with("game_") {
+            return Ok(game_call(principal, name, args, disconnected));
+        }
+        let result = local_service().lock().unwrap().tool(name, args);
+        Ok(match result {
+            Ok(output) => text_result(&output.to_string(), false),
+            Err(error) => text_result(error, true),
+        })
+    }
+}
+
+fn game_call(
+    principal: &Principal,
+    full_name: &str,
+    args: &Value,
+    disconnected: &dyn Fn() -> bool,
+) -> Value {
+    let no_game = || {
+        text_result(
+        "No Horizon game is running under Agent Control. Start one with play, or enable game control locally.",
+        true,
+    )
+    };
+    if !session().live() {
+        return no_game();
+    }
+    let name = full_name.trim_start_matches("game_");
+    let Some(cmd) = commands::COMMANDS
+        .iter()
+        .find(|cmd| cmd.mcp && commands::tool_name(cmd) == name)
+    else {
+        return text_result("This game tool is unavailable on Wii U.", true);
+    };
+    let mut words = match commands::line_for(cmd, args) {
+        Ok(words) => words,
+        Err(error) => return text_result(&error, true),
+    };
+    if words
+        .iter()
+        .any(|word| word.len() > 240 || word.chars().any(char::is_control))
+        || words
+            .iter()
+            .skip(1)
+            .any(|word| word.chars().any(char::is_whitespace))
+    {
+        return text_result("Use one value per game argument.", true);
+    }
+    if name == "screenshot" {
+        words.push("capture.png".into());
+    }
+    if let Some(wire) = cmd.wire {
+        words.splice(0..1, wire.split(' ').map(str::to_owned));
+    }
+    let wire = words.join(" ");
+    let seconds = args
+        .get("seconds")
+        .and_then(Value::as_f64)
+        .unwrap_or(10.0)
+        .clamp(0.0, 10.0);
+    let deadline = Instant::now() + Duration::from_secs_f64(seconds);
+    let mut reply = loop {
+        let result = session().call(
+            principal,
+            if name == "wait_ready" {
+                "status".into()
+            } else {
+                wire.clone()
+            },
+            disconnected,
+        );
+        let result = match result {
+            Ok(result) => result,
+            Err(session::Error::NoGame) => return no_game(),
+            Err(_) => return text_result("The game did not accept the request in time.", true),
+        };
+        let Ok(value) = serde_json::from_str::<Value>(&result) else {
+            return text_result("The game returned an invalid control reply.", true);
+        };
+        if name != "wait_ready"
+            || value.get("error").is_some()
+            || (!value["player"].is_null()
+                && value["pending_chunks"] == 0
+                && value["server"]["loaded"] != false)
+        {
+            break value;
+        }
+        if Instant::now() >= deadline {
+            return text_result(
+                "The world is still loading. Call game_wait_ready again.",
+                true,
+            );
+        }
+        std::thread::sleep(Duration::from_millis(250));
+    };
+    if let Some(error) = reply.get("error") {
+        return text_result(&json!({"error": error}).to_string(), true);
+    }
+    if name == "screenshot" {
+        let image = reply
+            .as_object_mut()
+            .and_then(|map| map.remove("png_base64"));
+        if let Some(image) =
+            image.filter(|v| v.as_str().is_some_and(|s| s.len() <= 7 * 1024 * 1024))
+        {
+            return json!({
+                "content": [{"type": "image", "data": image, "mimeType": "image/png"},
+                    {"type": "text", "text": reply.to_string()}],
+                "isError": false
+            });
+        }
+        return text_result(
+            "The frame was unavailable or exceeded the response limit.",
+            true,
+        );
+    }
+    let mut result = text_result(&reply.to_string(), false);
+    if commands::reply_schema(cmd).is_some() && reply.is_object() {
+        result["structuredContent"] = reply;
+    }
+    result
+}
diff --git a/wiiu/loading_app/src/night_mcp_menu.rs b/wiiu/loading_app/src/night_mcp_menu.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4b7156bee3728e58931f3366f95af3673b245404
--- /dev/null
+++ b/wiiu/loading_app/src/night_mcp_menu.rs
@@ -0,0 +1,647 @@
+use super::{change_policy, load_policy, wire, NightTools};
+use horizon_wiiu_mcp::service::Service;
+use horizon_wiiu_security::{Protection, StorageMode};
+use std::path::Path;
+use std::time::{Duration, Instant};
+use zeroize::Zeroizing;
+
+const PORT: u16 = 8443;
+
+#[derive(Clone)]
+enum Page {
+    Main,
+    Settings,
+    Pin(PinMode),
+    NoPin,
+    Rotate,
+    Requests(usize),
+    Clients(usize),
+    Client(String, usize),
+    Consent(String, usize),
+    Identity,
+}
+
+#[derive(Clone, Copy)]
+enum PinMode {
+    Set,
+    Unlock,
+}
+
+#[derive(Clone)]
+enum Action {
+    Screen(Page),
+    Back,
+    Pair,
+    AllowPlay,
+    AllowGame,
+    ToggleService,
+    ToggleNoAi,
+    Restart,
+    Approve(String, bool),
+    Revoke(String),
+    ConfirmNoPin,
+    ConfirmRotation,
+    AddDigit,
+    EraseDigit,
+    SubmitPin(PinMode),
+}
+
+pub(super) struct Menu {
+    pub(super) service: Option<Service<NightTools>>,
+    page: Option<Page>,
+    actions: Vec<Option<Action>>,
+    rows: Vec<wire::LocalRow>,
+    message: Option<String>,
+    pin: Zeroizing<Vec<u8>>,
+    digit: u8,
+    next_unlock: Option<Instant>,
+}
+
+impl Menu {
+    pub(super) fn open(root: &Path) -> Self {
+        let (service, message) = match Service::open(root, NightTools) {
+            Ok(service) => (Some(service), None),
+            Err(error) => (None, Some(error.to_string())),
+        };
+        let mut menu = Self {
+            service,
+            page: None,
+            actions: Vec::new(),
+            rows: Vec::new(),
+            message,
+            pin: Zeroizing::new(Vec::with_capacity(16)),
+            digit: 0,
+            next_unlock: None,
+        };
+        if let Some(service) = &menu.service {
+            if let Ok(policy) = service.policy() {
+                load_policy(policy);
+                if policy.enabled && !policy.no_ai {
+                    menu.connect();
+                }
+            }
+        }
+        menu
+    }
+
+    pub(super) fn shutdown(&mut self) {
+        if let Some(service) = self.service.as_mut() {
+            service.shutdown();
+        }
+        self.erase_pin();
+    }
+
+    fn connect(&mut self) {
+        let Some(service) = self.service.as_mut() else {
+            return;
+        };
+        let result = (|| {
+            let address = horizon_client_platform::cafe_net::assigned_ipv4()?;
+            let hostname = optional_hostname()?;
+            service.connect(address, PORT, hostname.as_deref(), false)
+        })();
+        self.message = result.err().map(|error| error.to_string());
+    }
+
+    fn erase_pin(&mut self) {
+        self.pin.fill(0);
+        self.pin.clear();
+        self.digit = 0;
+    }
+
+    pub(super) fn is_open(&self) -> bool {
+        self.page.is_some()
+    }
+
+    pub(super) fn update(
+        &mut self,
+        command: u8,
+        row: u8,
+        mut base: wire::LocalMenu,
+    ) -> Option<wire::LocalMenu> {
+        if command == wire::OPEN_AGENT {
+            self.page = Some(Page::Main);
+        } else {
+            let page = self.page.clone()?;
+            match command {
+                wire::BACK => {
+                    self.erase_pin();
+                    self.page = match page {
+                        Page::Main => None,
+                        Page::Pin(_) | Page::NoPin | Page::Rotate => Some(Page::Settings),
+                        Page::Client(_, p) => Some(Page::Clients(p)),
+                        Page::Consent(_, p) => Some(Page::Requests(p)),
+                        _ => Some(Page::Main),
+                    };
+                    if self.page.is_none() {
+                        base.title = wire::Text::default();
+                        return Some(base);
+                    }
+                }
+                wire::LEFT | wire::RIGHT if matches!(page, Page::Pin(_)) => {
+                    self.digit = (self.digit + if command == wire::RIGHT { 1 } else { 9 }) % 10;
+                }
+                wire::ACTIVATE => {
+                    if let Some(Some(action)) = self.actions.get(row as usize).cloned() {
+                        self.apply(action);
+                    }
+                }
+                _ => {}
+            }
+        }
+        let Some(page) = self.page.clone() else {
+            base.title = wire::Text::default();
+            return Some(base);
+        };
+        self.rows.clear();
+        self.actions.clear();
+        let (title, description) = self.render(page);
+        base.title = wire::Text::new(title);
+        base.description = wire::Text::new(self.message.as_deref().unwrap_or(description));
+        base.rows.fill(wire::LocalRow::default());
+        for (row, item) in base.rows.iter_mut().zip(self.rows.iter()) {
+            *row = *item;
+        }
+        base.count = self.rows.len() as u8;
+        base.mode = if matches!(self.page, Some(Page::Pin(_))) {
+            wire::EDITOR
+        } else {
+            0
+        };
+        base.input = wire::Text::default();
+        base.input_limit = 0;
+        Some(base)
+    }
+
+    fn row(&mut self, label: &str, detail: &str, action: Option<Action>) {
+        if self.rows.len() < wire::ROWS {
+            self.rows.push(wire::LocalRow {
+                label: wire::Text::new(label),
+                detail: wire::Text::new(detail),
+                state: if action.is_some() {
+                    wire::ACTIVE
+                } else {
+                    wire::DISABLED
+                },
+            });
+            self.actions.push(action);
+        }
+    }
+
+    fn page_row(&mut self, label: &str, detail: &str, page: Page) {
+        self.row(label, detail, Some(Action::Screen(page)));
+    }
+
+    fn render(&mut self, page: Page) -> (&'static str, &'static str) {
+        if self.service.is_none() {
+            self.row("Back", "", Some(Action::Back));
+            return ("Agent Control", "The credential vault is unavailable.");
+        }
+        let service = self.service.as_ref().unwrap();
+        let storage = service.status();
+        let policy = service.policy().unwrap_or_default();
+        let connection = service
+            .connection()
+            .map(|(url, hash)| (url.to_owned(), hash.to_owned()));
+        match page {
+            Page::Main => {
+                let status = if storage.cleanup_pending {
+                    "SD cleanup pending"
+                } else if !storage.initialized {
+                    "Choose how to store secrets"
+                } else if storage.locked {
+                    "PIN protected / locked"
+                } else if storage.mode == StorageMode::Unprotected {
+                    "Automatic unlock"
+                } else {
+                    "PIN protected / unlocked"
+                };
+                if let Some((endpoint, _)) = connection {
+                    self.page_row(
+                        "HTTPS connection",
+                        &format!("{endpoint}/mcp"),
+                        Page::Identity,
+                    );
+                    self.row(
+                        "Pair a PC",
+                        "Open a three-minute pairing window",
+                        Some(Action::Pair),
+                    );
+                    let pending = self
+                        .service
+                        .as_ref()
+                        .unwrap()
+                        .local(|auth, now| auth.pending(now).count())
+                        .unwrap_or_default();
+                    self.page_row(
+                        "Authorization requests",
+                        &format!("{pending} waiting"),
+                        Page::Requests(0),
+                    );
+                    self.page_row(
+                        "Trusted clients",
+                        "Review grants and revoke access",
+                        Page::Clients(0),
+                    );
+                } else if storage.locked {
+                    self.page_row(
+                        "Unlock Agent Control",
+                        "Use the local PIN",
+                        Page::Pin(PinMode::Unlock),
+                    );
+                } else if policy.enabled && !policy.no_ai {
+                    self.row(
+                        "Try HTTPS again",
+                        "Use the console LAN address",
+                        Some(Action::Restart),
+                    );
+                }
+                self.page_row("Agent Control settings", status, Page::Settings);
+                self.row("Back", "", Some(Action::Back));
+                (
+                    "Agent Control",
+                    if policy.no_ai {
+                        "No AI is on."
+                    } else {
+                        "Connect a trusted MCP client over HTTPS."
+                    },
+                )
+            }
+            Page::Settings => {
+                if !storage.initialized {
+                    self.page_row(
+                        "Set a PIN",
+                        "Unlock locally after each cold start",
+                        Page::Pin(PinMode::Set),
+                    );
+                    self.page_row(
+                        "Use no PIN",
+                        "Starts automatically after a restart",
+                        Page::NoPin,
+                    );
+                } else if storage.locked {
+                    self.page_row("Unlock", "Local PIN required", Page::Pin(PinMode::Unlock));
+                } else {
+                    self.row(
+                        "Agent Control",
+                        on_off(policy.enabled),
+                        Some(Action::ToggleService),
+                    );
+                    self.row(
+                        "Allow game control",
+                        on_off(policy.allow_game),
+                        Some(Action::AllowGame),
+                    );
+                    self.row(
+                        "Allow agent game launch",
+                        on_off(policy.allow_launch),
+                        Some(Action::AllowPlay),
+                    );
+                    self.row(
+                        "No AI / Emergency disable",
+                        on_off(policy.no_ai),
+                        Some(Action::ToggleNoAi),
+                    );
+                    self.page_row(
+                        "HTTPS identity and storage",
+                        "Trust, PIN and rotation",
+                        Page::Identity,
+                    );
+                }
+                self.row("Back", "", Some(Action::Back));
+                (
+                    "Agent Control settings",
+                    "These permissions are controlled on the Wii U.",
+                )
+            }
+            Page::Identity => {
+                if let Some((_, digest)) = connection {
+                    let (a, b) = digest.split_at(48);
+                    self.row("CA SHA-256 1/2", a, None);
+                    self.row("CA SHA-256 2/2", b, None);
+                }
+                self.page_row(
+                    "Set or change PIN",
+                    "Restart requires a local unlock",
+                    Page::Pin(PinMode::Set),
+                );
+                self.page_row(
+                    "Use no PIN",
+                    "Confirm SD exposure before switching",
+                    Page::NoPin,
+                );
+                self.page_row(
+                    "Rotate HTTPS and revoke all",
+                    "Requires installing the new CA",
+                    Page::Rotate,
+                );
+                self.row("Back", "", Some(Action::Back));
+                (
+                    "HTTPS identity",
+                    "Copy launcher/agent-control-ca.pem and verify its SHA-256.",
+                )
+            }
+            Page::Pin(mode) => {
+                self.row("PIN", &"*".repeat(self.pin.len()), None);
+                self.row(
+                    "Add digit",
+                    &format!("< {} >", self.digit),
+                    Some(Action::AddDigit),
+                );
+                self.row("Erase last digit", "", Some(Action::EraseDigit));
+                self.row("Confirm PIN", "", Some(Action::SubmitPin(mode)));
+                self.row("Cancel", "", Some(Action::Back));
+                (
+                    "Local PIN",
+                    "Left and right choose a digit. Use at least six digits.",
+                )
+            }
+            Page::NoPin => {
+                self.row(
+                    "Confirm automatic unlock",
+                    "Secrets are unencrypted on the SD card",
+                    Some(Action::ConfirmNoPin),
+                );
+                self.row("Cancel", "", Some(Action::Back));
+                ("Use no PIN", "A copy of the SD card can expose keys and let someone impersonate this console.")
+            }
+            Page::Rotate => {
+                self.row(
+                    "Rotate and revoke all",
+                    "PCs must install the new CA and pair again",
+                    Some(Action::ConfirmRotation),
+                );
+                self.row("Cancel", "", Some(Action::Back));
+                (
+                    "Rotate HTTPS identity",
+                    "Replace this console's HTTPS identity and revoke its trusted clients.",
+                )
+            }
+            Page::Requests(skip) => {
+                let pending = service
+                    .local(|auth, now| auth.pending(now).collect::<Vec<_>>())
+                    .unwrap_or_default();
+                let count = pending.len();
+                for consent in pending.into_iter().skip(skip).take(4) {
+                    self.page_row(
+                        &consent.client_name,
+                        &format!("Pairing {}", prefix(&consent.id)),
+                        Page::Consent(consent.id, skip),
+                    );
+                }
+                if count == 0 {
+                    self.row("No pending requests", "", None);
+                }
+                self.row("Back", "", Some(Action::Back));
+                (
+                    "Authorization requests",
+                    "Only approve a matching browser request you started.",
+                )
+            }
+            Page::Clients(skip) => {
+                let clients = service
+                    .local(|auth, _| auth.trusted().collect::<Vec<_>>())
+                    .unwrap_or_default();
+                let count = clients.len();
+                for client in clients.into_iter().skip(skip).take(3) {
+                    self.page_row(
+                        &client.name,
+                        &client.scopes.as_text(),
+                        Page::Client(client.client_id, skip),
+                    );
+                }
+                if count == 0 {
+                    self.row("No trusted clients", "", None);
+                }
+                if skip > 0 {
+                    self.page_row("Previous clients", "", Page::Clients(skip - 3));
+                }
+                if count > skip + 3 {
+                    self.page_row("More clients", "", Page::Clients(skip + 3));
+                }
+                self.row("Back", "", Some(Action::Back));
+                (
+                    "Trusted clients",
+                    "Select a PC to inspect or revoke its authorization.",
+                )
+            }
+            Page::Consent(id, _) => {
+                let pending = service
+                    .local(|auth, now| auth.pending(now).find(|p| p.id == id))
+                    .flatten();
+                if let Some(pending) = pending {
+                    self.row(
+                        &pending.client_name,
+                        &format!("Pairing {}", prefix(&id)),
+                        None,
+                    );
+                    self.row("Redirect URI", &pending.redirect_uri, None);
+                    self.row("Requested scopes", &pending.scopes.as_text(), None);
+                    self.row(
+                        "Approve on this Wii U",
+                        "",
+                        Some(Action::Approve(id.clone(), true)),
+                    );
+                    self.row("Deny", "", Some(Action::Approve(id, false)));
+                }
+                self.row("Back", "", Some(Action::Back));
+                (
+                    "Review authorization",
+                    "Compare the pairing ID with the one shown in your browser.",
+                )
+            }
+            Page::Client(id, _) => {
+                let client = service
+                    .local(|auth, now| {
+                        auth.trusted()
+                            .find(|p| p.client_id == id)
+                            .map(|client| (client, now))
+                    })
+                    .flatten();
+                if let Some((client, now)) = client {
+                    self.row(&client.name, &client.scopes.as_text(), None);
+                    self.row(
+                        "Last authenticated activity",
+                        &format!("{} seconds ago", now.saturating_sub(client.last_activity)),
+                        None,
+                    );
+                    self.row(
+                        "Revoke this client's access",
+                        "Access and refresh tokens stop working",
+                        Some(Action::Revoke(id)),
+                    );
+                }
+                self.row("Back", "", Some(Action::Back));
+                ("Trusted client", "Revocation takes effect immediately.")
+            }
+        }
+    }
+
+    fn apply(&mut self, action: Action) {
+        self.message = None;
+        match action {
+            Action::Screen(page) => {
+                self.erase_pin();
+                self.page = Some(page);
+            }
+            Action::Back => {
+                let _ = self.update(wire::BACK, 0, wire::LocalMenu::default());
+            }
+            Action::AddDigit if self.pin.len() < 16 => self.pin.push(b'0' + self.digit),
+            Action::EraseDigit => {
+                if let Some(last) = self.pin.last_mut() {
+                    *last = 0;
+                }
+                self.pin.pop();
+            }
+            Action::AddDigit => {}
+            Action::SubmitPin(mode) => self.submit_pin(mode),
+            Action::Restart => self.connect(),
+            other => self.apply_policy_action(other),
+        }
+    }
+
+    fn submit_pin(&mut self, mode: PinMode) {
+        if self.pin.len() < 6 {
+            self.message = Some("Enter at least six digits.".into());
+            return;
+        }
+        if matches!(mode, PinMode::Unlock)
+            && self.next_unlock.is_some_and(|time| time > Instant::now())
+        {
+            self.message = Some("Wait briefly before trying another PIN.".into());
+            return;
+        }
+        let Some(service) = self.service.as_mut() else {
+            return;
+        };
+        let new = !service.status().initialized;
+        let result = match mode {
+            PinMode::Set => service.protect(Protection::PinProtected { new_pin: &self.pin }),
+            PinMode::Unlock => service.unlock(&self.pin),
+        };
+        self.erase_pin();
+        match result {
+            Ok(()) => self.after_unlock(new),
+            Err(error) => {
+                self.next_unlock = Some(Instant::now() + Duration::from_secs(3));
+                self.message = Some(error.to_string());
+            }
+        }
+    }
+
+    fn after_unlock(&mut self, newly_initialized: bool) {
+        if let Some(service) = self.service.as_mut() {
+            match service.policy() {
+                Ok(mut policy) => {
+                    if newly_initialized {
+                        policy.enabled = true;
+                    }
+                    if newly_initialized && !change_policy(service, policy) {
+                        self.message = Some("Could not save Agent Control settings.".into());
+                        return;
+                    }
+                    load_policy(policy);
+                    self.page = Some(Page::Main);
+                    if policy.enabled && !policy.no_ai {
+                        self.connect();
+                    }
+                }
+                Err(error) => self.message = Some(error.to_string()),
+            }
+        }
+    }
+
+    fn apply_policy_action(&mut self, action: Action) {
+        let Some(service) = self.service.as_mut() else {
+            return;
+        };
+        match action {
+            Action::Pair => {
+                service.local(|auth, now| auth.open_pairing(now));
+                self.message = Some("Pairing is open. Continue in your browser.".into());
+            }
+            Action::Approve(id, yes) => {
+                let result = service.local(|auth, now| auth.decide(now, &id, yes));
+                self.message = Some(
+                    if result == Some(Ok(())) {
+                        "Decision sent to your browser."
+                    } else {
+                        "The request expired."
+                    }
+                    .into(),
+                );
+                self.page = Some(Page::Requests(0));
+            }
+            Action::Revoke(id) => {
+                let revoked = service.local(|auth, _| auth.revoke_client(&id)) == Some(Ok(()));
+                self.page = Some(Page::Clients(0));
+                self.message = Some(
+                    if revoked {
+                        "Client access revoked."
+                    } else {
+                        "Could not save revocation. Agent Control is blocked."
+                    }
+                    .into(),
+                );
+            }
+            Action::ConfirmNoPin => {
+                let new = !service.status().initialized;
+                match service.protect(Protection::ConfirmedUnprotected) {
+                    Ok(()) => self.after_unlock(new),
+                    Err(error) => self.message = Some(error.to_string()),
+                }
+            }
+            Action::ConfirmRotation => match service.rotate() {
+                Ok(()) => {
+                    self.page = Some(Page::Main);
+                    self.connect();
+                }
+                Err(error) => self.message = Some(error.to_string()),
+            },
+            Action::AllowPlay | Action::AllowGame | Action::ToggleService | Action::ToggleNoAi => {
+                let Ok(mut policy) = service.policy() else {
+                    return;
+                };
+                match action {
+                    Action::AllowPlay => policy.allow_launch = !policy.allow_launch,
+                    Action::AllowGame => policy.allow_game = !policy.allow_game,
+                    Action::ToggleService => policy.enabled = !policy.enabled,
+                    Action::ToggleNoAi => policy.no_ai = !policy.no_ai,
+                    _ => unreachable!(),
+                }
+                if !change_policy(service, policy) {
+                    self.message = Some("Could not save Agent Control settings.".into());
+                } else if policy.enabled && !policy.no_ai {
+                    self.connect();
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+fn optional_hostname() -> std::io::Result<Option<String>> {
+    use std::io::Read;
+    let path = Path::new(super::CAFE_APP_ROOT).join("launcher/agent-control-hostname.txt");
+    let file = match std::fs::File::open(path) {
+        Ok(file) => file,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(e) => return Err(e),
+    };
+    let mut name = String::new();
+    file.take(255).read_to_string(&mut name)?;
+    Ok(Some(name.trim().to_owned()))
+}
+
+fn on_off(value: bool) -> &'static str {
+    if value {
+        "On"
+    } else {
+        "Off"
+    }
+}
+
+fn prefix(id: &str) -> &str {
+    id.get(..8).unwrap_or(id)
+}
diff --git a/wiiu/loading_app/src/night_menu.rs b/wiiu/loading_app/src/night_menu.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a33e2433cfb0ab79a7ca9078334fef62f606c9c9
--- /dev/null
+++ b/wiiu/loading_app/src/night_menu.rs
@@ -0,0 +1,1266 @@
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use super::local_wire::*;
+use super::night_online::{self, Online};
+use super::night_store::{self as store, Preferences, Profile, Server, Store};
+use horizon_wiiu_microsoft::{Identity, Provider};
+
+const MANIFEST: &str = "horizon-resources.json";
+const ALPHABET: &[u8] = b"abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_- .:[]";
+const LIST_ROWS: usize = 3;
+// Public client ID verified by the existing UWP port.
+const MICROSOFT_CLIENT_ID: &str = "331e08f8-172d-43b9-835a-3108c2fcdbf3";
+const ACCOUNT_FIXTURE: bool = option_env!("HORIZON_NIGHT_ACCOUNT_FIXTURE").is_some();
+
+pub struct ResourcePin<'a> {
+    pub version: &'a str,
+    pub schema: u64,
+    pub client: &'a str,
+    pub server: &'a str,
+    pub exporter: &'a str,
+}
+
+#[derive(serde::Deserialize)]
+struct PreparedManifest<'a> {
+    schema: u64,
+    minecraft: &'a str,
+    client_sha256: &'a str,
+    server_sha256: &'a str,
+    exporter_sha256: &'a str,
+}
+
+#[derive(Clone)]
+pub struct World {
+    pub name: String,
+    pub detail: String,
+    pub unavailable: Option<&'static str>,
+}
+
+pub trait GameFiles {
+    fn world(&self, path: &Path, identity: &str, online_uuid: Option<u128>) -> Option<World>;
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum ResourceStatus {
+    Ready,
+    Missing,
+    Corrupt,
+    Incompatible,
+}
+
+impl ResourceStatus {
+    fn text(self) -> &'static str {
+        match self {
+            Self::Ready => "Prepared files ready",
+            Self::Missing => "Prepared files missing",
+            Self::Corrupt => "Prepared manifest or files invalid",
+            Self::Incompatible => "Preparation differs from the client pin",
+        }
+    }
+}
+
+fn plain(path: &Path, directory: bool) -> bool {
+    fs::symlink_metadata(path).is_ok_and(|metadata| {
+        if directory {
+            metadata.is_dir()
+        } else {
+            metadata.is_file() && metadata.len() > 0
+        }
+    })
+}
+
+pub fn resources(path: &Path, pin: &ResourcePin<'_>) -> ResourceStatus {
+    let manifest = path.join(MANIFEST);
+    if !manifest.exists() {
+        return ResourceStatus::Missing;
+    }
+    if !plain(&manifest, false) {
+        return ResourceStatus::Corrupt;
+    }
+    let Ok(data) = store::read_limited(&manifest, 64 * 1024) else {
+        return ResourceStatus::Corrupt;
+    };
+    let Ok(value) = serde_json::from_slice::<PreparedManifest<'_>>(&data) else {
+        return ResourceStatus::Corrupt;
+    };
+    let PreparedManifest {
+        schema,
+        minecraft: version,
+        client_sha256: client,
+        server_sha256: server,
+        exporter_sha256: exporter,
+    } = value;
+    if [client, server, exporter].iter().any(|value| {
+        value.len() != 64
+            || !value
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+    }) {
+        return ResourceStatus::Corrupt;
+    }
+    if (schema, version, client, server, exporter)
+        != (
+            pin.schema,
+            pin.version,
+            pin.client,
+            pin.server,
+            pin.exporter,
+        )
+    {
+        return ResourceStatus::Incompatible;
+    }
+    if ["facts.json", "registries.json", "asset-index.json"]
+        .iter()
+        .any(|relative| !plain(&path.join(relative), false))
+        || !plain(&path.join("assets"), true)
+        || !plain(&path.join("data"), true)
+    {
+        return ResourceStatus::Corrupt;
+    }
+    ResourceStatus::Ready
+}
+
+#[derive(Clone)]
+enum Target {
+    Menu,
+    World(String),
+    Server(String),
+}
+
+pub struct Launch {
+    pub game: PathBuf,
+    pub resources: PathBuf,
+    pub player: String,
+    pub world: Option<String>,
+    pub server: Option<String>,
+    pub swap_ab: bool,
+    pub swap_xy: bool,
+    pub identity: Option<Identity>,
+}
+
+#[derive(Clone, Copy)]
+enum List {
+    Profiles,
+    Instances,
+    Worlds,
+    Servers,
+    Reports,
+}
+
+#[derive(Clone)]
+enum Edit {
+    NewProfile,
+    Profile(usize),
+    NewServerName,
+    ServerName(usize),
+    Address { index: Option<usize>, name: String },
+}
+
+impl Edit {
+    fn caption(&self) -> &'static str {
+        match self {
+            Self::NewProfile => "New offline identity",
+            Self::Profile(_) => "Edit profile label",
+            Self::NewServerName | Self::ServerName(_) => "Server name",
+            Self::Address { .. } => "Server address",
+        }
+    }
+    fn limit(&self) -> u16 {
+        match self {
+            Self::NewProfile => 16,
+            Self::Address { .. } => 253,
+            _ => 24,
+        }
+    }
+    fn list(&self) -> List {
+        match self {
+            Self::NewProfile | Self::Profile(_) => List::Profiles,
+            _ => List::Servers,
+        }
+    }
+}
+
+#[derive(Clone)]
+enum Page {
+    Home,
+    Online,
+    Library,
+    Settings,
+    Versions,
+    About(usize),
+    Items(List, usize),
+    Profile(usize),
+    Server(usize),
+    Confirm { profile: bool, index: usize },
+    Edit(Edit),
+    Report(usize, usize),
+}
+
+struct Item {
+    key: String,
+    label: String,
+    detail: String,
+    state: u8,
+}
+
+impl Item {
+    fn plain(key: &str, label: &str, detail: &str, state: u8) -> Self {
+        Self {
+            key: key.into(),
+            label: label.into(),
+            detail: detail.into(),
+            state,
+        }
+    }
+}
+
+enum Command {
+    Back,
+    Online,
+    Show(Page),
+    Profile(usize),
+    Server(usize),
+    Instance(String),
+    World(String),
+    Remove { profile: bool, index: usize },
+    Toggle(u8),
+    Edit(Edit, String),
+    Keyboard,
+    AddCharacter,
+    EraseCharacter,
+    FinishEdit,
+    ClearTarget,
+}
+
+pub struct LocalService<G> {
+    base: PathBuf,
+    pin: ResourcePin<'static>,
+    pub preferences: Preferences,
+    store: Store,
+    game: G,
+    about: &'static [(&'static str, &'static str)],
+    page: Page,
+    target: Target,
+    commands: Vec<Command>,
+    items: Vec<Item>,
+    message: &'static str,
+    edited: String,
+    character: usize,
+    keyboard: bool,
+    online: Online,
+}
+
+impl<G: GameFiles> LocalService<G> {
+    pub fn new(
+        base: PathBuf,
+        pin: ResourcePin<'static>,
+        game: G,
+        about: &'static [(&'static str, &'static str)],
+    ) -> Self {
+        let (store, preferences) = Store::open(base.join("launcher"));
+        let message = store.notice;
+        let target = preferences
+            .server
+            .map(|i| Target::Server(preferences.servers[i].address.clone()))
+            .unwrap_or(Target::Menu);
+        let online = Online::new(
+            &base.join("private"),
+            Provider::for_night(Some(MICROSOFT_CLIENT_ID), ACCOUNT_FIXTURE),
+        );
+        Self {
+            base,
+            pin,
+            game,
+            about,
+            store,
+            preferences,
+            page: Page::Home,
+            target,
+            commands: Vec::new(),
+            items: Vec::new(),
+            message,
+            edited: String::new(),
+            character: 0,
+            keyboard: false,
+            online,
+        }
+    }
+
+    fn game_dir(&self, instance: &str) -> PathBuf {
+        if instance == "default" {
+            self.base.clone()
+        } else {
+            self.base.join("instances").join(instance)
+        }
+    }
+
+    fn resource_dir(&self, game: &Path) -> PathBuf {
+        game.join(".local")
+            .join("horizon-client")
+            .join(self.pin.version)
+    }
+
+    fn installed(&self, name: &str) -> ResourceStatus {
+        if !store::identifier(name) {
+            return ResourceStatus::Missing;
+        }
+        let game = self.game_dir(name);
+        if (name != "default"
+            && (!plain(&self.base.join("instances"), true) || !plain(&game, true)))
+            || !plain(&game.join(".local"), true)
+            || !plain(&game.join(".local/horizon-client"), true)
+            || !plain(&self.resource_dir(&game), true)
+        {
+            return ResourceStatus::Missing;
+        }
+        resources(&self.resource_dir(&game), &self.pin)
+    }
+
+    fn world(&self, id: &str) -> Option<World> {
+        let saves = self.game_dir(&self.preferences.instance).join("saves");
+        let path = saves.join(id);
+        if !store::identifier(id) || !plain(&saves, true) || !plain(&path, true) {
+            return None;
+        }
+        let saved = path.join("level.dat");
+        if !plain(&saved, false) {
+            return plain(&path.join("level.dat_old"), false).then(|| World {
+                name: id.into(),
+                detail: "Recovery required".into(),
+                unavailable: Some("Open recovery in the game menu"),
+            });
+        }
+        if self.online.selected().is_some() {
+            let account = self.online.active()?;
+            self.game.world(&path, &account.name, Some(account.id.0))
+        } else {
+            self.game.world(
+                &path,
+                &self.preferences.profiles[self.preferences.profile].identity,
+                None,
+            )
+        }
+    }
+
+    pub fn launch(&self) -> Result<Launch, u8> {
+        if self.installed(&self.preferences.instance) != ResourceStatus::Ready {
+            return Err(2);
+        }
+        let identity = self.online.active();
+        if self.online.selected().is_some() && (identity.is_none() || ACCOUNT_FIXTURE) {
+            return Err(5);
+        }
+        let game = self.game_dir(&self.preferences.instance);
+        let (world, server) = match &self.target {
+            Target::Menu => (None, None),
+            Target::World(id) if self.world(id).is_some_and(|w| w.unavailable.is_none()) => {
+                (Some(id.clone()), None)
+            }
+            Target::World(_) => return Err(5),
+            Target::Server(address) if store::endpoint(address).as_ref() == Some(address) => {
+                (None, Some(address.clone()))
+            }
+            Target::Server(_) => return Err(5),
+        };
+        Ok(Launch {
+            resources: self.resource_dir(&game),
+            game,
+            player: identity.map_or_else(
+                || {
+                    self.preferences.profiles[self.preferences.profile]
+                        .identity
+                        .clone()
+                },
+                |a| a.name.clone(),
+            ),
+            world,
+            server,
+            swap_ab: self.preferences.settings.swap_ab,
+            swap_xy: self.preferences.settings.swap_xy,
+            identity: identity.map(Identity::duplicate),
+        })
+    }
+
+    fn save(&mut self, next: Preferences) -> bool {
+        if self.store.commit(&next).is_err() {
+            self.message =
+                "Could not save launcher settings. The previous settings are still active.";
+            return false;
+        }
+        self.preferences = next;
+        true
+    }
+
+    fn report(&self, key: &str) -> Option<Vec<(String, String)>> {
+        if !store::identifier(key) || !key.ends_with(".json") {
+            return None;
+        }
+        let folder = self.game_dir(&self.preferences.instance).join("benchmarks");
+        let path = folder.join(key);
+        if !plain(&folder, true) || !plain(&path, false) {
+            return None;
+        }
+        let content = store::read_limited(&path, 2 * 1024 * 1024).ok()?;
+        let value: serde_json::Value = serde_json::from_slice(&content).ok()?;
+        let object = value.as_object()?;
+        if value["format"].as_str()? != "horizon-benchmark-report"
+            || value["version"].as_u64()? != 1
+        {
+            return None;
+        }
+        let mut rows = Vec::new();
+        for (key, segment) in object {
+            if !matches!(
+                key.as_str(),
+                "version" | "kind" | "created" | "app" | "conditions" | "metrics" | "label"
+            ) {
+                continue;
+            }
+            if let Some(fields) = segment.as_object() {
+                for (name, value) in fields {
+                    if let Some(text) = scalar(value) {
+                        rows.push((format!("{key} / {name}"), text));
+                    } else if key == "metrics" {
+                        for statistic in ["median", "p95", "mean", "min", "max", "n"] {
+                            if let Some(text) = scalar(&value[statistic]) {
+                                rows.push((format!("{name} / {statistic}"), text));
+                            }
+                        }
+                    }
+                }
+            } else if let Some(text) = scalar(segment) {
+                rows.push((key.clone(), text));
+            }
+        }
+        Some(rows)
+    }
+
+    fn listing(&self, kind: List) -> Vec<Item> {
+        let game = self.game_dir(&self.preferences.instance);
+        match kind {
+            List::Profiles => self
+                .preferences
+                .profiles
+                .iter()
+                .enumerate()
+                .map(|(i, p)| {
+                    Item::plain(
+                        "",
+                        &p.name,
+                        &format!("Identity: {}", p.identity),
+                        if i == self.preferences.profile {
+                            SELECTED
+                        } else {
+                            ACTIVE
+                        },
+                    )
+                })
+                .collect(),
+            List::Servers => self
+                .preferences
+                .servers
+                .iter()
+                .enumerate()
+                .map(|(i, s)| {
+                    Item::plain(
+                        "",
+                        &s.name,
+                        &s.address,
+                        if Some(i) == self.preferences.server {
+                            SELECTED
+                        } else {
+                            ACTIVE
+                        },
+                    )
+                })
+                .collect(),
+            List::Instances => core::iter::once("default".into())
+                .chain(
+                    directories(&self.base.join("instances"))
+                        .into_iter()
+                        .filter(|name| !name.eq_ignore_ascii_case("default")),
+                )
+                .map(|name| {
+                    let status = self.installed(&name);
+                    Item::plain(
+                        &name,
+                        &name,
+                        status.text(),
+                        if status != ResourceStatus::Ready {
+                            DISABLED
+                        } else if self.preferences.instance == name {
+                            SELECTED
+                        } else {
+                            ACTIVE
+                        },
+                    )
+                })
+                .collect(),
+            List::Worlds => directories(&game.join("saves"))
+                .into_iter()
+                .filter_map(|name| {
+                    let w = self.world(&name)?;
+                    Some(Item::plain(
+                        &name,
+                        &w.name,
+                        w.unavailable.unwrap_or(&w.detail),
+                        if w.unavailable.is_some() {
+                            DISABLED
+                        } else if matches!(&self.target, Target::World(id) if id == &name) {
+                            SELECTED
+                        } else {
+                            ACTIVE
+                        },
+                    ))
+                })
+                .collect(),
+            List::Reports => entries(&game.join("benchmarks"), false)
+                .into_iter()
+                .filter(|key| key.ends_with(".json"))
+                .map(|key| Item::plain(&key, &key, "Local benchmark report", ACTIVE))
+                .collect(),
+        }
+    }
+
+    fn show(&mut self, page: Page) {
+        if let Page::Items(kind, 0) = page {
+            self.items = self.listing(kind);
+        }
+        self.page = page;
+    }
+
+    pub fn command(&mut self, action: u8, argument: u8, input: &str) {
+        self.message = "";
+        if matches!(self.page, Page::Online) {
+            let selected = self.online.selected();
+            if self.online.command(action, argument, input) {
+                self.show(Page::Items(List::Profiles, 0));
+            }
+            self.account_changed(selected);
+            return;
+        }
+        match action {
+            OPEN_PROFILES => self.show(Page::Items(List::Profiles, 0)),
+            OPEN_LIBRARY => self.show(Page::Library),
+            OPEN_VERSIONS => self.show(Page::Versions),
+            OPEN_SETTINGS => self.show(Page::Settings),
+            BACK => self.back(),
+            LEFT | RIGHT if matches!(self.page, Page::Edit(_)) => {
+                let offset = if action == LEFT {
+                    ALPHABET.len() - 1
+                } else {
+                    1
+                };
+                self.character = (self.character + offset) % ALPHABET.len();
+            }
+            TEXT_ACCEPTED if matches!(self.page, Page::Edit(_)) => {
+                self.edited = input.into();
+                self.finish_edit();
+            }
+            TEXT_CANCELLED => {}
+            TEXT_UNAVAILABLE => {
+                self.message = "System keyboard unavailable. Use the character picker below."
+            }
+            ACTIVATE if usize::from(argument) < self.commands.len() => {
+                let command = self.commands.remove(usize::from(argument));
+                self.execute(command);
+            }
+            _ => {}
+        }
+    }
+
+    pub fn tick(&mut self) -> bool {
+        let selected = self.online.selected();
+        let changed = self.online.tick();
+        self.account_changed(selected);
+        changed
+    }
+
+    pub fn shutdown(&mut self) {
+        self.online.shutdown();
+    }
+
+    fn account_changed(&mut self, previous: Option<horizon_wiiu_microsoft::ProfileId>) {
+        if self.online.selected() != previous && matches!(self.target, Target::World(_)) {
+            self.target = Target::Menu;
+        }
+    }
+
+    fn back(&mut self) {
+        let page = match &self.page {
+            Page::Items(List::Worlds | List::Servers, _) => Page::Library,
+            Page::Items(List::Instances, _) | Page::About(_) => Page::Versions,
+            Page::Items(List::Reports, _) => Page::Settings,
+            Page::Profile(_) => Page::Items(List::Profiles, 0),
+            Page::Server(_) => Page::Items(List::Servers, 0),
+            Page::Confirm { profile, index } => {
+                if *profile {
+                    Page::Profile(*index)
+                } else {
+                    Page::Server(*index)
+                }
+            }
+            Page::Edit(edit) => Page::Items(edit.list(), 0),
+            Page::Report(_, _) => Page::Items(List::Reports, 0),
+            _ => Page::Home,
+        };
+        self.show(page);
+    }
+
+    fn execute(&mut self, command: Command) {
+        let mut next = self.preferences.clone();
+        match command {
+            Command::Back => self.back(),
+            Command::Online => {
+                self.online.open();
+                self.show(Page::Online);
+            }
+            Command::Show(page) => self.show(page),
+            Command::Profile(index) => {
+                let selected = self.online.selected();
+                if let Err(error) = self.online.offline() {
+                    self.message = night_online::error_label(error);
+                    return;
+                }
+                self.account_changed(selected);
+                next.profile = index;
+                if self.save(next) {
+                    self.show(Page::Items(List::Profiles, 0));
+                }
+            }
+            Command::Server(index) => {
+                next.server = Some(index);
+                let address = next.servers[index].address.clone();
+                if self.save(next) {
+                    self.target = Target::Server(address);
+                    self.show(Page::Home);
+                }
+            }
+            Command::Instance(id) => {
+                if self.installed(&id) != ResourceStatus::Ready {
+                    self.message = "The selected installation is no longer available.";
+                    return;
+                }
+                next.instance = id;
+                next.server = None;
+                if self.save(next) {
+                    self.target = Target::Menu;
+                    self.show(Page::Home);
+                }
+            }
+            Command::World(id) => {
+                if self
+                    .world(&id)
+                    .is_some_and(|world| world.unavailable.is_none())
+                {
+                    if next.server.take().is_some() && !self.save(next) {
+                        return;
+                    }
+                    self.target = Target::World(id);
+                    self.show(Page::Home);
+                } else {
+                    self.message = "The selected world is no longer available.";
+                }
+            }
+            Command::ClearTarget => {
+                next.server = None;
+                if self.save(next) {
+                    self.target = Target::Menu;
+                    self.show(Page::Home);
+                }
+            }
+            Command::Remove {
+                profile: true,
+                index,
+            } => {
+                if next.profiles.len() <= 1 {
+                    return;
+                }
+                next.profiles.remove(index);
+                if next.profile == index {
+                    next.profile = 0;
+                } else if next.profile > index {
+                    next.profile -= 1;
+                }
+                if self.save(next) {
+                    self.show(Page::Items(List::Profiles, 0));
+                }
+            }
+            Command::Remove {
+                profile: false,
+                index,
+            } => {
+                next.servers.remove(index);
+                let selected = next.server == Some(index);
+                next.server =
+                    next.server
+                        .filter(|&i| i != index)
+                        .map(|i| if i > index { i - 1 } else { i });
+                if self.save(next) {
+                    if selected && matches!(self.target, Target::Server(_)) {
+                        self.target = Target::Menu;
+                    }
+                    self.show(Page::Items(List::Servers, 0));
+                }
+            }
+            Command::Toggle(flag) => {
+                match flag {
+                    SWAP_AB => next.settings.swap_ab = !next.settings.swap_ab,
+                    SWAP_XY => next.settings.swap_xy = !next.settings.swap_xy,
+                    _ => next.settings.touch = !next.settings.touch,
+                }
+                self.save(next);
+            }
+            Command::Edit(edit, text) => {
+                self.edited = text;
+                self.character = 0;
+                self.show(Page::Edit(edit));
+            }
+            Command::Keyboard => self.keyboard = true,
+            Command::AddCharacter => {
+                if let Page::Edit(edit) = &self.page {
+                    if self.edited.len() < usize::from(edit.limit()) {
+                        self.edited.push(char::from(ALPHABET[self.character]));
+                    }
+                }
+            }
+            Command::EraseCharacter => {
+                self.edited.pop();
+            }
+            Command::FinishEdit => self.finish_edit(),
+        }
+    }
+
+    fn finish_edit(&mut self) {
+        let Page::Edit(edit) = self.page.clone() else {
+            return;
+        };
+        let text = self.edited.trim();
+        let mut next = self.preferences.clone();
+        match &edit {
+            Edit::NewProfile => {
+                if !store::identity(text)
+                    || next.profiles.len() >= store::ENTRIES
+                    || next
+                        .profiles
+                        .iter()
+                        .any(|p| p.identity.eq_ignore_ascii_case(text))
+                {
+                    self.message =
+                        "Use a unique identity with 1-16 letters, digits or underscores.";
+                    return;
+                }
+                next.profiles.push(Profile {
+                    name: text.into(),
+                    identity: text.into(),
+                });
+                next.profile = next.profiles.len() - 1;
+            }
+            Edit::Profile(index) if store::label(text, 24) => {
+                next.profiles[*index].name = text.into()
+            }
+            Edit::NewServerName | Edit::ServerName(_) if store::label(text, 24) => {
+                let (index, initial) = match edit {
+                    Edit::ServerName(index) => (Some(index), next.servers[index].address.clone()),
+                    _ => (None, String::new()),
+                };
+                self.page = Page::Edit(Edit::Address {
+                    index,
+                    name: text.into(),
+                });
+                self.edited = initial;
+                return;
+            }
+            Edit::Address { index, name } => {
+                let Some(address) = store::endpoint(text) else {
+                    self.message = "Enter a hostname or IP and an optional port (1-65535).";
+                    return;
+                };
+                let server = Server {
+                    name: name.clone(),
+                    address,
+                };
+                match index {
+                    Some(index) => next.servers[*index] = server,
+                    None if next.servers.len() < store::ENTRIES => next.servers.push(server),
+                    None => {
+                        self.message = "The saved server list is full.";
+                        return;
+                    }
+                }
+            }
+            _ => {
+                self.message = "Enter a label with 1-24 bytes and no control characters.";
+                return;
+            }
+        }
+        let server_changed = next
+            .server
+            .and_then(|index| next.servers.get(index))
+            .map(|entry| entry.address.clone());
+        if self.save(next) {
+            if let (Target::Server(_), Some(address)) = (&self.target, server_changed) {
+                self.target = Target::Server(address);
+            }
+            self.show(Page::Items(edit.list(), 0));
+        }
+    }
+
+    pub fn model(&mut self) -> LocalMenu {
+        self.commands.clear();
+        let status = self.installed(&self.preferences.instance);
+        let online = self.online.selected_label();
+        let requires_account = online.is_some() && self.online.active().is_none();
+        let report = match self.page {
+            Page::Report(index, _) => self
+                .items
+                .get(index)
+                .and_then(|item| self.report(&item.key)),
+            _ => None,
+        };
+        let mut menu = LocalMenu {
+            profile: Text::new(online.map_or(
+                &self.preferences.profiles[self.preferences.profile].name,
+                |(name, _)| name,
+            )),
+            play_detail: Text::new(if status != ResourceStatus::Ready {
+                status.text()
+            } else if requires_account {
+                online.map_or("", |(_, status)| status)
+            } else {
+                match &self.target {
+                    Target::Menu => "Native game menu",
+                    Target::World(id) => id,
+                    Target::Server(address) => address,
+                }
+            }),
+            ready: u8::from(
+                status == ResourceStatus::Ready
+                    && !requires_account
+                    && (!ACCOUNT_FIXTURE || online.is_none()),
+            ),
+            settings: (if self.preferences.settings.swap_ab {
+                SWAP_AB
+            } else {
+                0
+            }) | (if self.preferences.settings.swap_xy {
+                SWAP_XY
+            } else {
+                0
+            }) | (if self.preferences.settings.touch {
+                TOUCH
+            } else {
+                0
+            }),
+            ..LocalMenu::default()
+        };
+        if matches!(self.page, Page::Online) {
+            self.online.model(&mut menu);
+            return menu;
+        }
+        let mut row = |label: &str, detail: &str, state, command| {
+            if let Some(dest) = menu.rows.get_mut(self.commands.len()) {
+                *dest = LocalRow {
+                    label: Text::new(label),
+                    detail: Text::new(detail),
+                    state,
+                };
+                self.commands.push(command);
+            }
+        };
+        let (title, description) = match self.page.clone() {
+            Page::Home => (
+                "",
+                if requires_account {
+                    self.online.status_message()
+                } else {
+                    ""
+                },
+            ),
+            Page::Online => unreachable!(),
+            Page::Library => {
+                row(
+                    "Local worlds",
+                    "From this installation",
+                    ACTIVE,
+                    Command::Show(Page::Items(List::Worlds, 0)),
+                );
+                row(
+                    "Saved servers",
+                    "Offline identity",
+                    ACTIVE,
+                    Command::Show(Page::Items(List::Servers, 0)),
+                );
+                row(
+                    "Use game menu",
+                    "Clear the direct target",
+                    if matches!(self.target, Target::Menu) {
+                        SELECTED
+                    } else {
+                        ACTIVE
+                    },
+                    Command::ClearTarget,
+                );
+                row("Back", "", ACTIVE, Command::Back);
+                (
+                    "Worlds & servers",
+                    "Choose a target, then select Start Game on Play.",
+                )
+            }
+            Page::Settings => {
+                for (title, flag, on) in [
+                    ("Swap A and B", SWAP_AB, self.preferences.settings.swap_ab),
+                    ("Swap X and Y", SWAP_XY, self.preferences.settings.swap_xy),
+                    ("GamePad touch", TOUCH, self.preferences.settings.touch),
+                ] {
+                    row(
+                        title,
+                        if on { "On" } else { "Off" },
+                        ACTIVE,
+                        Command::Toggle(flag),
+                    );
+                }
+                row(
+                    "Reports",
+                    "Existing benchmark results",
+                    ACTIVE,
+                    Command::Show(Page::Items(List::Reports, 0)),
+                );
+                row("Back", "", ACTIVE, Command::Back);
+                (
+                    "Settings",
+                    "Button swaps apply to the game. Touch controls Night navigation.",
+                )
+            }
+            Page::Versions => {
+                row(
+                    "Installed resources",
+                    status.text(),
+                    ACTIVE,
+                    Command::Show(Page::Items(List::Instances, 0)),
+                );
+                row(
+                    "About this build",
+                    "Verified build identity",
+                    ACTIVE,
+                    Command::Show(Page::About(0)),
+                );
+                row("Back", "", ACTIVE, Command::Back);
+                (
+                    "Version & resources",
+                    "Select an existing compatible Horizon preparation.",
+                )
+            }
+            Page::About(page) => {
+                for (label, value) in self.about.iter().skip(page * 4).take(4) {
+                    row(label, value, DISABLED, Command::Back);
+                }
+                if (page + 1) * 4 < self.about.len() {
+                    row(
+                        "More build information",
+                        "",
+                        ACTIVE,
+                        Command::Show(Page::About(page + 1)),
+                    );
+                }
+                if page > 0 {
+                    row(
+                        "Previous build information",
+                        "",
+                        ACTIVE,
+                        Command::Show(Page::About(page - 1)),
+                    );
+                }
+                row("Back", "", ACTIVE, Command::Back);
+                ("About Horizon Wii U", "CafeOS / PowerPC")
+            }
+            Page::Items(kind, page) => {
+                let limit = if matches!(kind, List::Profiles) {
+                    2
+                } else {
+                    LIST_ROWS
+                };
+                let start = page * limit;
+                if matches!(kind, List::Profiles) && page == 0 {
+                    row(night_online::tr("accounts"), "", ACTIVE, Command::Online);
+                }
+                for (index, item) in self.items.iter().enumerate().skip(start).take(limit) {
+                    let action = match kind {
+                        List::Profiles => Command::Show(Page::Profile(index)),
+                        List::Servers => Command::Show(Page::Server(index)),
+                        List::Instances => Command::Instance(item.key.clone()),
+                        List::Worlds => Command::World(item.key.clone()),
+                        List::Reports => Command::Show(Page::Report(index, 0)),
+                    };
+                    row(&item.label, &item.detail, item.state, action);
+                }
+                let add = match kind {
+                    List::Profiles if self.preferences.profiles.len() < store::ENTRIES => {
+                        Some(("Create offline profile", Edit::NewProfile))
+                    }
+                    List::Servers if self.preferences.servers.len() < store::ENTRIES => {
+                        Some(("Add server", Edit::NewServerName))
+                    }
+                    _ => None,
+                };
+                // Keep six rows on both displays. A later page can go back
+                // through the preceding page before reaching the parent.
+                if let Some((label, edit)) = add {
+                    row(label, "", ACTIVE, Command::Edit(edit, String::new()));
+                }
+                if self.items.len() > start + limit {
+                    row(
+                        "Next page",
+                        "",
+                        ACTIVE,
+                        Command::Show(Page::Items(kind, page + 1)),
+                    );
+                }
+                if page > 0 {
+                    row(
+                        "Previous page",
+                        "",
+                        ACTIVE,
+                        Command::Show(Page::Items(kind, page - 1)),
+                    );
+                } else {
+                    row("Back", "", ACTIVE, Command::Back);
+                }
+                match kind {
+                    List::Profiles => (
+                        "Offline profiles",
+                        "Choose an offline identity or manage Microsoft accounts.",
+                    ),
+                    List::Instances => (
+                        "Installed resources",
+                        "Only compatible preparations can be selected.",
+                    ),
+                    List::Worlds => (
+                        "Local worlds",
+                        if self.items.is_empty() {
+                            "No saved worlds in this installation."
+                        } else {
+                            "Only compatible worlds for the selected identity can start here."
+                        },
+                    ),
+                    List::Servers => (
+                        "Saved servers",
+                        if self.items.is_empty() {
+                            "Add a hostname or IP address to get started."
+                        } else {
+                            "Select an endpoint to use on Play."
+                        },
+                    ),
+                    List::Reports => (
+                        "Diagnostic reports",
+                        if self.items.is_empty() {
+                            "No benchmark JSON reports in this installation."
+                        } else {
+                            "Read existing local reports. Nothing is uploaded."
+                        },
+                    ),
+                }
+            }
+            Page::Profile(index) => {
+                let profile = &self.preferences.profiles[index];
+                row(
+                    "Use this profile",
+                    &profile.identity,
+                    if index == self.preferences.profile {
+                        SELECTED
+                    } else {
+                        ACTIVE
+                    },
+                    Command::Profile(index),
+                );
+                row(
+                    "Rename label",
+                    &profile.name,
+                    ACTIVE,
+                    Command::Edit(Edit::Profile(index), profile.name.clone()),
+                );
+                row(
+                    "Remove profile",
+                    if self.preferences.profiles.len() > 1 {
+                        "Confirm removal"
+                    } else {
+                        "Keep at least one profile"
+                    },
+                    if self.preferences.profiles.len() > 1 {
+                        ACTIVE
+                    } else {
+                        DISABLED
+                    },
+                    Command::Show(Page::Confirm {
+                        profile: true,
+                        index,
+                    }),
+                );
+                row("Back", "", ACTIVE, Command::Back);
+                (
+                    "Offline profile",
+                    "The login identity stays fixed when the launcher label changes.",
+                )
+            }
+            Page::Server(index) => {
+                let server = &self.preferences.servers[index];
+                row(
+                    "Use this server",
+                    &server.address,
+                    ACTIVE,
+                    Command::Server(index),
+                );
+                row(
+                    "Edit server",
+                    &server.name,
+                    ACTIVE,
+                    Command::Edit(Edit::ServerName(index), server.name.clone()),
+                );
+                row(
+                    "Remove server",
+                    "Confirm removal",
+                    ACTIVE,
+                    Command::Show(Page::Confirm {
+                        profile: false,
+                        index,
+                    }),
+                );
+                row("Back", "", ACTIVE, Command::Back);
+                ("Saved server", "Connections use the selected profile.")
+            }
+            Page::Confirm { profile, index } => {
+                row("Cancel", "Keep this entry", ACTIVE, Command::Back);
+                row(
+                    "Confirm removal",
+                    "Remove from Night",
+                    ACTIVE,
+                    Command::Remove { profile, index },
+                );
+                (
+                    "Confirm removal",
+                    if profile {
+                        "This removes the local profile entry. World data and UUIDs are preserved."
+                    } else {
+                        "This removes the endpoint from Night's saved list."
+                    },
+                )
+            }
+            Page::Edit(edit) => {
+                menu.mode = EDITOR;
+                let initial = self
+                    .edited
+                    .chars()
+                    .rev()
+                    .take(56)
+                    .collect::<Vec<_>>()
+                    .into_iter()
+                    .rev()
+                    .collect::<String>();
+                row(
+                    "Open system keyboard",
+                    "Type text. Press Minus to close.",
+                    ACTIVE,
+                    Command::Keyboard,
+                );
+                row(
+                    "Append character",
+                    &char::from(ALPHABET[self.character]).to_string(),
+                    ACTIVE,
+                    Command::AddCharacter,
+                );
+                row("Delete last character", "", ACTIVE, Command::EraseCharacter);
+                row("Continue", &initial, ACTIVE, Command::FinishEdit);
+                row("Cancel", "", ACTIVE, Command::Back);
+                if std::mem::take(&mut self.keyboard) {
+                    menu.input = Text::new(&self.edited);
+                    menu.input_limit = edit.limit();
+                }
+                (
+                    edit.caption(),
+                    "Use the keyboard or choose a character with Left/Right.",
+                )
+            }
+            Page::Report(index, page) => {
+                if let Some(fields) = &report {
+                    for (label, value) in fields.iter().skip(page * 3).take(3) {
+                        row(label, value, DISABLED, Command::Back);
+                    }
+                    if (page + 1) * 3 < fields.len() {
+                        row(
+                            "More",
+                            "",
+                            ACTIVE,
+                            Command::Show(Page::Report(index, page + 1)),
+                        );
+                    }
+                    if page > 0 {
+                        row(
+                            "Previous",
+                            "",
+                            ACTIVE,
+                            Command::Show(Page::Report(index, page - 1)),
+                        );
+                    }
+                }
+                row("Back", "", ACTIVE, Command::Back);
+                (
+                    "Benchmark report",
+                    if report.is_some() {
+                        "Recorded measurements from the local report."
+                    } else {
+                        "This file is missing, invalid, or uses an unsupported format."
+                    },
+                )
+            }
+        };
+        menu.title = Text::new(title);
+        menu.description = Text::new(if self.message.is_empty() {
+            description
+        } else {
+            self.message
+        });
+        menu.count = self.commands.len() as u8;
+        menu
+    }
+}
+
+fn scalar(value: &serde_json::Value) -> Option<String> {
+    match value {
+        serde_json::Value::String(value) => Some(value.clone()),
+        serde_json::Value::Bool(_) | serde_json::Value::Number(_) => Some(value.to_string()),
+        _ => None,
+    }
+}
+
+fn entries(directory: &Path, directory_entries: bool) -> Vec<String> {
+    if !plain(directory, true) {
+        return Vec::new();
+    }
+    let mut names = fs::read_dir(directory)
+        .into_iter()
+        .flatten()
+        .filter_map(Result::ok)
+        .filter(|entry| {
+            entry.file_type().is_ok_and(|kind| {
+                if directory_entries {
+                    kind.is_dir()
+                } else {
+                    kind.is_file()
+                }
+            })
+        })
+        .filter_map(|entry| entry.file_name().into_string().ok())
+        .filter(|name| store::identifier(name))
+        .take(256)
+        .collect::<Vec<_>>();
+    names.sort_by_key(|name| name.to_ascii_lowercase());
+    names
+}
+
+fn directories(path: &Path) -> Vec<String> {
+    entries(path, true)
+}
