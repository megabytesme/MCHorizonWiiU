diff --git a/crates/horizon-client-platform/src/cafe_audio.rs b/crates/horizon-client-platform/src/cafe_audio.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b4571be9c6f8c7d364679bc56ce5e62ed47f3934
--- /dev/null
+++ b/crates/horizon-client-platform/src/cafe_audio.rs
@@ -0,0 +1,90 @@
+//! Safe owner for the native Cafe AX audio bridge.
+//!
+//! AX owns its callback and DSP buffers until `horizon_wiiu_audio_close` returns.
+//! The Rust renderer uses this wrapper to submit blocks from its mixer worker;
+//! the AX callback itself only drains the bridge's fixed SPSC queue.
+
+use std::ptr::NonNull;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+unsafe extern "C" {
+    fn horizon_wiiu_audio_open(frames: *mut u32, rate: *mut u32) -> *mut std::ffi::c_void;
+    fn horizon_wiiu_audio_submit(handle: *mut std::ffi::c_void, stereo: *const f32, frames: u32);
+    fn horizon_wiiu_audio_close(handle: *mut std::ffi::c_void);
+}
+
+/// An initialized AX stream with a bounded native SPSC queue.
+pub struct CafeAudio {
+    handle: NonNull<std::ffi::c_void>,
+    frames: u32,
+    rate: u32,
+    submit_active: AtomicBool,
+}
+
+// SAFETY: the native handle is owned here and Drop closes it after all Arc
+// owners have released it.
+unsafe impl Send for CafeAudio {}
+// SAFETY: `submit_active` serializes safe calls into the native SPSC producer;
+// `frames` and `rate` are immutable after construction.
+unsafe impl Sync for CafeAudio {}
+
+impl CafeAudio {
+    /// Initialize AX and acquire the bounded native output bridge.
+    pub fn open() -> Result<Self, &'static str> {
+        let mut frames = 0;
+        let mut rate = 0;
+        // SAFETY: the bridge initializes AX and returns an owned handle, or null.
+        let Some(handle) = NonNull::new(unsafe { horizon_wiiu_audio_open(&mut frames, &mut rate) })
+        else {
+            return Err("Wii U AX audio initialization failed");
+        };
+        if frames == 0 || frames > 256 || rate == 0 {
+            // SAFETY: the returned handle is owned and has no producer yet.
+            unsafe { horizon_wiiu_audio_close(handle.as_ptr()) };
+            return Err("Wii U AX reported an unsupported audio frame format");
+        }
+        Ok(Self {
+            handle,
+            frames,
+            rate,
+            submit_active: AtomicBool::new(false),
+        })
+    }
+
+    pub fn frames(&self) -> u32 {
+        self.frames
+    }
+
+    pub fn rate(&self) -> u32 {
+        self.rate
+    }
+
+    /// Submit one interleaved stereo f32 block. The native bridge copies it
+    /// synchronously into its fixed queue, so the caller retains the slice.
+    pub fn submit(&self, stereo: &[f32]) {
+        if stereo.len() != self.frames as usize * 2 {
+            return;
+        }
+        if self
+            .submit_active
+            .compare_exchange(false, true, Ordering::Acquire, Ordering::Relaxed)
+            .is_err()
+        {
+            return;
+        }
+        // SAFETY: the handle remains open for this borrow; C copies exactly one
+        // frame before returning and does not retain the sample pointer.
+        unsafe {
+            horizon_wiiu_audio_submit(self.handle.as_ptr(), stereo.as_ptr(), self.frames);
+        }
+        self.submit_active.store(false, Ordering::Release);
+    }
+}
+
+impl Drop for CafeAudio {
+    fn drop(&mut self) {
+        // SAFETY: NonNull came from a successful open; Arc keeps this owner alive
+        // until the mixer worker has stopped using it.
+        unsafe { horizon_wiiu_audio_close(self.handle.as_ptr()) };
+    }
+}
diff --git a/crates/horizon-client-platform/src/cafe_memory.rs b/crates/horizon-client-platform/src/cafe_memory.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d80a5a202ee551a9ef7150872e9654dd4f5e6b95
--- /dev/null
+++ b/crates/horizon-client-platform/src/cafe_memory.rs
@@ -0,0 +1,97 @@
+//! Startup checkpoints for the native app's System allocator. The counters
+//! add no allocation headers and report requested bytes, excluding GX2 and
+//! other allocations made on the C side.
+use std::{
+    alloc::{GlobalAlloc, Layout, System},
+    sync::atomic::{AtomicUsize, Ordering::Relaxed},
+};
+
+static LIVE: AtomicUsize = AtomicUsize::new(0);
+static BLOCKS: AtomicUsize = AtomicUsize::new(0);
+static PEAK: AtomicUsize = AtomicUsize::new(0);
+static FAILURES: AtomicUsize = AtomicUsize::new(0);
+
+unsafe extern "C" {
+    fn horizon_wiiu_memory_report(
+        label: *const u8,
+        len: usize,
+        live: usize,
+        peak: usize,
+        blocks: usize,
+    );
+    fn horizon_wiiu_memory_alloc_failure(
+        bytes: usize,
+        align: usize,
+        live: usize,
+        peak: usize,
+        blocks: usize,
+    );
+}
+
+/// Report both Rust allocation counters and the native backing heap snapshot.
+pub fn report(label: &str) {
+    // SAFETY: the native logger reads exactly the provided label bytes.
+    unsafe {
+        horizon_wiiu_memory_report(
+            label.as_ptr(),
+            label.len(),
+            LIVE.load(Relaxed),
+            PEAK.load(Relaxed),
+            BLOCKS.load(Relaxed),
+        );
+    }
+}
+
+pub(crate) fn profile_snapshot() {
+    use crate::cafe_profile::{Counter, count};
+    count(Counter::RustLive, LIVE.load(Relaxed));
+    count(Counter::RustPeak, PEAK.load(Relaxed));
+    count(Counter::RustBlocks, BLOCKS.load(Relaxed));
+}
+
+pub struct MeasuredSystem;
+
+impl MeasuredSystem {
+    fn record(block: *mut u8, layout: Layout) -> *mut u8 {
+        if block.is_null() {
+            if FAILURES.fetch_add(1, Relaxed) < 4 {
+                // SAFETY: System has returned and released its heap lock.
+                // The native logger takes scalars and makes no Rust allocations.
+                unsafe {
+                    horizon_wiiu_memory_alloc_failure(
+                        layout.size(),
+                        layout.align(),
+                        LIVE.load(Relaxed),
+                        PEAK.load(Relaxed),
+                        BLOCKS.load(Relaxed),
+                    );
+                }
+            }
+        } else {
+            BLOCKS.fetch_add(1, Relaxed);
+            let live = LIVE.fetch_add(layout.size(), Relaxed) + layout.size();
+            PEAK.fetch_max(live, Relaxed);
+        }
+        block
+    }
+}
+
+// SAFETY: blocks and their layouts pass through unchanged to System. The
+// default realloc allocates, copies, then frees, as Cafe System does. Count
+// both blocks during the copy so this transient contributes to the peak.
+unsafe impl GlobalAlloc for MeasuredSystem {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        Self::record(unsafe { System.alloc(layout) }, layout)
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        Self::record(unsafe { System.alloc_zeroed(layout) }, layout)
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        LIVE.fetch_sub(layout.size(), Relaxed);
+        BLOCKS.fetch_sub(1, Relaxed);
+        // SAFETY: ptr and layout are unchanged from allocation by System.
+        unsafe { System.dealloc(ptr, layout) };
+    }
+}
diff --git a/crates/horizon-client-platform/src/cafe_net.rs b/crates/horizon-client-platform/src/cafe_net.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c3907734e9ec28fc5301067931ba5047b3a5012f
--- /dev/null
+++ b/crates/horizon-client-platform/src/cafe_net.rs
@@ -0,0 +1,24 @@
+//! Cafe's assigned IPv4 address without an external traffic probe.
+use std::{
+    io,
+    net::{Ipv4Addr, UdpSocket},
+};
+
+unsafe extern "C" {
+    fn horizon_wiiu_assigned_ipv4(out: *mut u32) -> i32;
+}
+
+pub fn assigned_ipv4() -> io::Result<Ipv4Addr> {
+    // Opening a standard socket initializes nsysnet and the configured
+    // connection. This ephemeral UDP socket sends no packets.
+    drop(UdpSocket::bind((Ipv4Addr::UNSPECIFIED, 0))?);
+    let mut address = 0;
+    // SAFETY: the native query writes one numerical 32-bit IPv4 address.
+    if unsafe { horizon_wiiu_assigned_ipv4(&mut address) } != 0 || address == 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::AddrNotAvailable,
+            "the Wii U has no assigned IPv4 address",
+        ));
+    }
+    Ok(Ipv4Addr::from(address))
+}
diff --git a/crates/horizon-client-platform/src/cafe_profile.rs b/crates/horizon-client-platform/src/cafe_profile.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5c810e5a94d5589949e015d41e42a56858b03e9c
--- /dev/null
+++ b/crates/horizon-client-platform/src/cafe_profile.rs
@@ -0,0 +1,142 @@
+//! Cafe capture spans. Frame spans are owned by the main host thread.
+//! Thread-independent workload totals are recorded by Worker scopes.
+use std::marker::PhantomData;
+
+#[repr(u32)]
+#[derive(Clone, Copy)]
+pub enum Stage {
+    Input,
+    Idle,
+    WorldUpdate,
+    Streaming,
+    Tick,
+    Entities,
+    Particles,
+    Hud,
+    StageArtwork,
+    TerrainUpload,
+    TextureUpload,
+    SubmitTv,
+    SubmitDrc,
+    WaitFlip,
+    Finish,
+    TerrainWait,
+    Screenshot,
+    SavePoll,
+    Sleep,
+}
+
+#[repr(u32)]
+#[derive(Clone, Copy)]
+pub enum Worker {
+    Streaming,
+    Mesh,
+    Integrated,
+    Save,
+}
+
+#[repr(u32)]
+pub enum Phase {
+    Loading = 2,
+    Title,
+    WorldEntry,
+    Playing,
+    Menu,
+    Closing,
+}
+
+#[repr(u32)]
+pub enum Counter {
+    Presented,
+    Partial,
+    SectionDraws,
+    Indices,
+    UploadBytes,
+    HudVertices,
+    RustLive,
+    RustPeak,
+    RustBlocks,
+}
+
+unsafe extern "C" {
+    fn horizon_gx2_profile_begin(phase: u32) -> bool;
+    fn horizon_gx2_profile_finish();
+    fn horizon_gx2_profile_phase(phase: u32);
+    fn horizon_gx2_profile_stamp() -> u64;
+    fn horizon_gx2_profile_end(stage: u32, begin: u64);
+    fn horizon_gx2_profile_worker_end(worker: u32, begin: u64);
+    fn horizon_gx2_profile_count(counter: u32, value: u32);
+}
+
+pub struct Frame(bool, PhantomData<*mut ()>);
+impl Frame {
+    pub fn begin() -> Self {
+        Self(unsafe { horizon_gx2_profile_begin(Phase::Loading as u32) }, PhantomData)
+    }
+}
+impl Drop for Frame {
+    fn drop(&mut self) {
+        if !self.0 {
+            return;
+        }
+        super::cafe_memory::profile_snapshot();
+        unsafe { horizon_gx2_profile_finish() };
+    }
+}
+
+pub fn phase(phase: Phase) {
+    unsafe { horizon_gx2_profile_phase(phase as u32) }
+}
+
+pub fn count(counter: Counter, value: usize) {
+    unsafe { horizon_gx2_profile_count(counter as u32, value as u32) }
+}
+
+pub struct Span {
+    stage: Stage,
+    started: u64,
+    host_thread: PhantomData<*mut ()>,
+}
+impl Span {
+    pub fn new(stage: Stage) -> Self {
+        Self {
+            stage,
+            started: unsafe { horizon_gx2_profile_stamp() },
+            host_thread: PhantomData,
+        }
+    }
+}
+impl Drop for Span {
+    fn drop(&mut self) {
+        if self.started != 0 {
+            unsafe { horizon_gx2_profile_end(self.stage as u32, self.started) };
+        }
+    }
+}
+
+pub struct Work(Worker, u64);
+impl Work {
+    pub fn new(worker: Worker) -> Self {
+        Self(worker, unsafe { horizon_gx2_profile_stamp() })
+    }
+}
+impl Drop for Work {
+    fn drop(&mut self) {
+        if self.1 != 0 {
+            unsafe { horizon_gx2_profile_worker_end(self.0 as u32, self.1) };
+        }
+    }
+}
+
+/// The portable game sources use this macro to keep the Cafe hooks target-only.
+#[macro_export]
+macro_rules! cafe_span {
+    ($stage:ident) => {
+        #[cfg(target_os = "cafe")]
+        let _cafe_span = $crate::cafe_profile::Span::new($crate::cafe_profile::Stage::$stage);
+    };
+    ($binding:ident, $stage:ident) => {
+        #[cfg(target_os = "cafe")]
+        let $binding = $crate::cafe_profile::Span::new($crate::cafe_profile::Stage::$stage);
+    };
+}
diff --git a/crates/horizon-client-platform/src/cemu_session_lock.rs b/crates/horizon-client-platform/src/cemu_session_lock.rs
new file mode 100644
index 0000000000000000000000000000000000000000..909eba25571350989eaa985889ecc2f77f831002
--- /dev/null
+++ b/crates/horizon-client-platform/src/cemu_session_lock.rs
@@ -0,0 +1,47 @@
+//! Opt-in Cemu diagnostic guard for process-wide local-world exclusion.
+//!
+//! This intentionally uses one global port, so it treats every world as the
+//! same lock: opening any world conflicts with any other holder. It is a Cemu
+//! diagnostic only and has not been validated on Wii U hardware. The caller
+//! must opt in with `horizon_wiiu_cemu_global_lock`; failures are returned and
+//! must not be treated as permission to continue without a lock.
+
+use std::io;
+
+unsafe extern "C" {
+    /// Opens the C bridge's process-wide loopback listener lock.
+    ///
+    /// Negative results report failure; nonnegative results are owned fds.
+    fn horizon_wiiu_cemu_global_lock_open() -> i32;
+    /// Closes a listener fd returned by `horizon_wiiu_cemu_global_lock_open`.
+    fn horizon_wiiu_cemu_global_lock_close(fd: i32);
+}
+
+/// Holds the opt-in Cemu-only global session lock until dropped.
+///
+/// The lock is global across worlds rather than keyed by world path.
+pub struct CemuGlobalSessionLock {
+    fd: i32,
+}
+
+impl CemuGlobalSessionLock {
+    /// Acquires the global lock or returns the bridge's negative failure code.
+    pub fn try_acquire() -> io::Result<Self> {
+        // SAFETY: The C bridge owns nsysnet initialization and returns an fd
+        // whose ownership transfers to this guard on success.
+        let fd = unsafe { horizon_wiiu_cemu_global_lock_open() };
+        if fd < 0 {
+            return Err(io::Error::other(format!(
+                "Cafe Cemu global session lock failed ({fd})"
+            )));
+        }
+        Ok(Self { fd })
+    }
+}
+
+impl Drop for CemuGlobalSessionLock {
+    fn drop(&mut self) {
+        // SAFETY: This guard uniquely owns the fd returned by the bridge.
+        unsafe { horizon_wiiu_cemu_global_lock_close(self.fd) };
+    }
+}
