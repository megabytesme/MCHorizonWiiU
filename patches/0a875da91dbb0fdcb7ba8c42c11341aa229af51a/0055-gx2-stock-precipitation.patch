diff --git a/wiiu/loading_host/precipitation.c b/wiiu/loading_host/precipitation.c
new file mode 100644
index 0000000000000000000000000000000000000000..6f55f98b5f6dcb7a0a473ea01721768e3fa87f59
--- /dev/null
+++ b/wiiu/loading_host/precipitation.c
@@ -0,0 +1,162 @@
+#include "precipitation.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <gx2/event.h>
+#include <gx2/registers.h>
+#include <gx2/sampler.h>
+#include <gx2/shaders.h>
+#include <gx2/texture.h>
+#include <gx2/utils.h>
+#include <gx2r/buffer.h>
+#include <gx2r/draw.h>
+#include <whb/gfx.h>
+
+extern const uint8_t _binary_precipitation_gsh_start[];
+
+/* The upstream 15-block radius emits at most 31 x 31 columns. */
+enum { MAX_VERTICES = 31 * 31 * 4 };
+_Static_assert(sizeof(HorizonPrecipitationVertex) == 44, "precipitation vertex ABI changed");
+_Static_assert(offsetof(HorizonPrecipitationVertex, rect) == 24, "precipitation rect offset changed");
+_Static_assert(offsetof(HorizonPrecipitationVertex, rgba) == 40, "precipitation color offset changed");
+
+struct HorizonGx2Precipitation {
+   WHBGfxShaderGroup shader;
+   GX2RBuffer vertices;
+   GX2Sampler sampler;
+   uint32_t vertex_uniforms[4], pixel_uniforms[3];
+   uint32_t lightmap_slot, atlas_slot;
+   uint32_t count;
+};
+
+static bool uniform_offset(const GX2UniformVar *uniform, uint32_t *offset)
+{
+   if (!uniform || uniform->type != GX2_SHADER_VAR_TYPE_FLOAT4 || uniform->count != 1 ||
+       uniform->block >= 0) return false;
+   *offset = uniform->offset;
+   return true;
+}
+
+static bool sampler_slot(const GX2SamplerVar *vars, unsigned count, const char *name, uint32_t *out)
+{
+   for (unsigned i = 0; vars && i < count; ++i) {
+      if (vars[i].type == GX2_SAMPLER_VAR_TYPE_SAMPLER_2D && vars[i].name &&
+          !strcmp(vars[i].name, name)) {
+         *out = vars[i].location;
+         return true;
+      }
+   }
+   return false;
+}
+
+int horizon_gx2_precipitation_create(HorizonGx2Precipitation **out)
+{
+   if (!out) return -1;
+   *out = NULL;
+   HorizonGx2Precipitation *weather = calloc(1, sizeof(*weather));
+   if (!weather) return -2;
+   WHBGfxShaderGroup *shader = &weather->shader;
+   if (!WHBGfxLoadGFDShaderGroup(shader, 0, _binary_precipitation_gsh_start)) {
+      free(weather);
+      return -3;
+   }
+   const GX2VertexShader *vs = shader->vertexShader;
+   const GX2PixelShader *ps = shader->pixelShader;
+   const char *vertex_names[] = {"uClipX", "uClipY", "uClipZ", "uClipW"};
+   const char *pixel_names[] = {"uAtlasSize", "uFogColor", "uFogRanges"};
+   if (!vs || !ps || vs->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       ps->mode != GX2_SHADER_MODE_UNIFORM_REGISTER) goto fail;
+   for (unsigned i = 0; i < 4; ++i)
+      if (!uniform_offset(GX2GetVertexUniformVar(vs, vertex_names[i]), &weather->vertex_uniforms[i]))
+         goto fail;
+   for (unsigned i = 0; i < 3; ++i)
+      if (!uniform_offset(GX2GetPixelUniformVar(ps, pixel_names[i]), &weather->pixel_uniforms[i]))
+         goto fail;
+   if (!sampler_slot(vs->samplerVars, vs->samplerVarCount, "uLightmap", &weather->lightmap_slot) ||
+       !sampler_slot(ps->samplerVars, ps->samplerVarCount, "uAtlas", &weather->atlas_slot) ||
+       !WHBGfxInitShaderAttribute(shader, "aPositionLight", 0,
+                                  offsetof(HorizonPrecipitationVertex, position_light),
+                                  GX2_ATTRIB_FORMAT_FLOAT_32_32_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aUv", 0, offsetof(HorizonPrecipitationVertex, uv),
+                                  GX2_ATTRIB_FORMAT_FLOAT_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aRect", 0, offsetof(HorizonPrecipitationVertex, rect),
+                                  GX2_ATTRIB_FORMAT_FLOAT_32_32_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aColor", 0, offsetof(HorizonPrecipitationVertex, rgba),
+                                  GX2_ATTRIB_FORMAT_UNORM_8_8_8_8) ||
+       !WHBGfxInitFetchShader(shader)) goto fail;
+   weather->vertices = (GX2RBuffer){
+      .flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER | GX2R_RESOURCE_USAGE_CPU_WRITE |
+               GX2R_RESOURCE_USAGE_GPU_READ,
+      .elemSize = sizeof(HorizonPrecipitationVertex), .elemCount = MAX_VERTICES,
+   };
+   if (!GX2RCreateBuffer(&weather->vertices)) goto fail;
+   GX2InitSampler(&weather->sampler, GX2_TEX_CLAMP_MODE_CLAMP, GX2_TEX_XY_FILTER_MODE_POINT);
+   *out = weather;
+   return 0;
+
+fail:
+   WHBGfxFreeShaderGroup(shader);
+   free(weather);
+   return -3;
+}
+
+void horizon_gx2_precipitation_destroy(HorizonGx2Precipitation *weather)
+{
+   if (!weather) return;
+   GX2DrawDone();
+   GX2RDestroyBufferEx(&weather->vertices, 0);
+   WHBGfxFreeShaderGroup(&weather->shader);
+   free(weather);
+}
+
+int horizon_gx2_precipitation_upload(HorizonGx2Precipitation *weather,
+                                    const HorizonPrecipitationVertex *vertices, uint32_t count)
+{
+   if (!weather || !vertices || !count || count % 4 || count > MAX_VERTICES) return -1;
+   void *mapped = GX2RLockBufferEx(&weather->vertices, 0);
+   if (!mapped) return -2;
+   memcpy(mapped, vertices, count * sizeof(*vertices));
+   GX2RUnlockBufferEx(&weather->vertices, 0);
+   weather->count = count;
+   return 0;
+}
+
+int horizon_gx2_precipitation_draw(HorizonGx2Precipitation *weather, const uint32_t rect[4],
+                                  const GX2Texture *atlas, HorizonGx2Terrain *terrain,
+                                  const float clip_rows[16], const float fog_color[4],
+                                  const float fog_ranges[4])
+{
+   if (!weather || !rect || !rect[2] || !rect[3] || !atlas || !atlas->surface.image ||
+       !terrain || !clip_rows || !fog_color || !fog_ranges) return -1;
+   if (!weather->count) return 0;
+   WHBGfxShaderGroup *shader = &weather->shader;
+   GX2SetViewport(rect[0], rect[1], rect[2], rect[3], 0, 1);
+   GX2SetScissor(rect[0], rect[1], rect[2], rect[3]);
+   GX2SetShaderMode(shader->vertexShader->mode);
+   GX2SetFetchShader(&shader->fetchShader);
+   GX2SetVertexShader(shader->vertexShader);
+   GX2SetPixelShader(shader->pixelShader);
+   for (unsigned row = 0; row < 4; ++row)
+      GX2SetVertexUniformReg(weather->vertex_uniforms[row], 4, clip_rows + 4 * row);
+   const float atlas_size[4] = {(float)atlas->surface.width, (float)atlas->surface.height, 0, 0};
+   GX2SetPixelUniformReg(weather->pixel_uniforms[0], 4, atlas_size);
+   GX2SetPixelUniformReg(weather->pixel_uniforms[1], 4, fog_color);
+   GX2SetPixelUniformReg(weather->pixel_uniforms[2], 4, fog_ranges);
+   horizon_gx2_terrain_bind_lightmap(terrain, weather->lightmap_slot);
+   GX2SetPixelTexture(atlas, weather->atlas_slot);
+   GX2SetPixelSampler(&weather->sampler, weather->atlas_slot);
+   GX2RSetAttributeBuffer(&weather->vertices, 0, sizeof(HorizonPrecipitationVertex), 0);
+   GX2SetCullOnlyControl(GX2_FRONT_FACE_CCW, FALSE, FALSE);
+   GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+   GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0.0f);
+   GX2SetDepthOnlyControl(TRUE, FALSE, GX2_COMPARE_FUNC_LEQUAL);
+   GX2SetColorControl(GX2_LOGIC_OP_COPY, 1, FALSE, TRUE);
+   GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, 0, 0, 0, 0, 0, 0, 0);
+   GX2SetBlendControl(GX2_RENDER_TARGET_0, GX2_BLEND_MODE_SRC_ALPHA, GX2_BLEND_MODE_INV_SRC_ALPHA,
+                      GX2_BLEND_COMBINE_MODE_ADD, TRUE, GX2_BLEND_MODE_ONE,
+                      GX2_BLEND_MODE_INV_SRC_ALPHA, GX2_BLEND_COMBINE_MODE_ADD);
+   horizon_gx2_terrain_draw_quads(terrain, weather->count);
+   return 0;
+}
diff --git a/wiiu/loading_host/precipitation.frag b/wiiu/loading_host/precipitation.frag
new file mode 100644
index 0000000000000000000000000000000000000000..892e34d1ee244f4bddc44953268d21b3ed65a08a
--- /dev/null
+++ b/wiiu/loading_host/precipitation.frag
@@ -0,0 +1,32 @@
+#version 330
+
+uniform sampler2D uAtlas;
+uniform vec4 uAtlasSize;
+uniform vec4 uFogColor;
+uniform vec4 uFogRanges;
+in vec2 vUv;
+flat in vec4 vRect;
+in vec4 vColor;
+in vec4 vLight;
+in vec2 vFogDistance;
+out vec4 fragColor;
+
+float linearFog(float distance, float start, float end) {
+    if (distance <= start) return 0.0;
+    if (distance >= end) return 1.0;
+    return (distance - start) / (end - start);
+}
+
+void main() {
+    vec2 size = uAtlasSize.xy;
+    vec2 origin = floor(vRect.xy * size + 0.5);
+    vec2 extent = max(floor(vRect.zw * size + 0.5), vec2(1.0));
+    vec2 local = min(floor(fract(vUv) * extent), extent - vec2(1.0));
+    vec2 atlasUv = (origin + local + 0.5) / size;
+    vec4 color = texture(uAtlas, atlasUv) * vColor;
+    if (color.a < 0.1) discard;
+    color *= vLight;
+    float fog = max(linearFog(vFogDistance.x, uFogRanges.x, uFogRanges.y),
+                    linearFog(vFogDistance.y, uFogRanges.z, uFogRanges.w));
+    fragColor = vec4(mix(color.rgb, uFogColor.rgb, fog * uFogColor.a), color.a);
+}
