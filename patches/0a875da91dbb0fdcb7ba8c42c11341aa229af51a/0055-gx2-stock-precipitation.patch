--- /dev/null
+++ b/wiiu/loading_host/precipitation.vert
@@ -0,0 +1,30 @@
+#version 330
+
+in vec4 aPositionLight;
+in vec2 aUv;
+in vec4 aRect;
+in vec4 aColor;
+uniform vec4 uClipX;
+uniform vec4 uClipY;
+uniform vec4 uClipZ;
+uniform vec4 uClipW;
+uniform sampler2D uLightmap;
+out vec2 vUv;
+flat out vec4 vRect;
+out vec4 vColor;
+out vec4 vLight;
+out vec2 vFogDistance;
+
+void main() {
+    vec3 position = aPositionLight.xyz;
+    vec4 pos = vec4(position, 1.0);
+    gl_Position = vec4(dot(uClipX, pos), dot(uClipY, pos),
+                       dot(uClipZ, pos), dot(uClipW, pos));
+    float packedLight = aPositionLight.w;
+    vec2 levels = min(vec2(floor(packedLight / 256.0), mod(packedLight, 256.0)), vec2(240.0));
+    vLight = textureLod(uLightmap, levels / 256.0 + vec2(0.5 / 16.0), 0.0);
+    vColor = aColor;
+    vUv = aUv;
+    vRect = aRect;
+    vFogDistance = vec2(length(position), max(length(position.xz), abs(position.y)));
+}
