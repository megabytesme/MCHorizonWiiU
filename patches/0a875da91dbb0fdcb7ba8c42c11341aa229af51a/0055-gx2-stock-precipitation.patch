+/// The weather shader's phase from the packed column attributes. Cafe can
+/// calculate it once per quad using the CPU's native double precision.
+pub fn phase(vertex: &Vertex, time: Time) -> [f32; 2] {
+    let [rain_speed, rain_tick_offset, dx, dy] = vertex.animation;
+    let [u_low, u_high, v_low, v_high] = vertex.bases.map(u64::from);
+    Parameters {
+        rain_speed,
+        rain_tick_offset,
+        snow_base: [
+            f64::from_bits(u_low | (u_high << 32)),
+            f64::from_bits(v_low | (v_high << 32)),
+        ],
+        snow_drift: [dx, dy],
+    }
+    .uv_phase(vertex.snow != 0, time)
+}
