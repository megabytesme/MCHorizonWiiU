+
+#endif
diff --git a/wiiu/loading_host/precipitation.rs b/wiiu/loading_host/precipitation.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a0190657e01feb2a942e6fdb502eb5366388a262
--- /dev/null
+++ b/wiiu/loading_host/precipitation.rs
@@ -0,0 +1,143 @@
+use crate::TerrainProjection;
+use horizon_client::{
+    gfx::{Frame, fog_uniform},
+    weather::{Time, Vertex as WeatherVertex, phase},
+};
+use horizon_wiiu_platform::hud::horizon::HorizonPresenter;
+use std::{ffi::c_void, ptr::NonNull};
+
+const MAX_COLUMNS: usize = 31 * 31;
+
+#[repr(C)]
+struct Vertex {
+    position_light: [f32; 4],
+    uv: [f32; 2],
+    rect: [f32; 4],
+    rgba: [u8; 4],
+}
+
+const _: () = {
+    assert!(std::mem::size_of::<Vertex>() == 44);
+    assert!(std::mem::offset_of!(Vertex, rect) == 24);
+    assert!(std::mem::offset_of!(Vertex, rgba) == 40);
+};
+
+unsafe extern "C" {
+    fn horizon_gx2_precipitation_create(out: *mut *mut c_void) -> i32;
+    fn horizon_gx2_precipitation_destroy(weather: *mut c_void);
+    fn horizon_gx2_precipitation_upload(
+        weather: *mut c_void,
+        vertices: *const Vertex,
+        count: u32,
+    ) -> i32;
+    fn horizon_gx2_precipitation_draw(
+        weather: *mut c_void,
+        rect: *const u32,
+        atlas: *const c_void,
+        terrain: *mut c_void,
+        clip_rows: *const f32,
+        fog_color: *const f32,
+        fog_ranges: *const f32,
+    ) -> i32;
+}
+
+#[derive(Default)]
+pub(crate) struct Precipitation {
+    vertices: Vec<Vertex>,
+    native: Option<NonNull<c_void>>,
+}
+
+impl Precipitation {
+    pub(crate) fn is_empty(&self) -> bool {
+        self.vertices.is_empty()
+    }
+
+    pub(crate) fn prepare(
+        &mut self,
+        weather: &[WeatherVertex],
+        time: Time,
+    ) -> Result<bool, &'static str> {
+        self.vertices.clear();
+        let quads = weather.chunks_exact(4);
+        let partial = !quads.remainder().is_empty() || quads.len() > MAX_COLUMNS;
+        if quads.len() == 0 {
+            return Ok(partial);
+        }
+        // The shared geometry has rain first, then snow. Each column shares
+        // its clock and random parameters, so evaluate the animation once.
+        self.vertices.reserve_exact(quads.len().min(MAX_COLUMNS) * 4);
+        for quad in quads.take(MAX_COLUMNS) {
+            let [du, dv] = phase(&quad[0], time);
+            self.vertices.extend(quad.iter().map(|vertex| {
+                let [x, y, z] = vertex.pos;
+                Vertex {
+                    position_light: [x, y, z, (vertex.light & 0xffff) as f32],
+                    uv: [vertex.uv[0] + du, vertex.uv[1] + dv],
+                    rect: vertex.rect,
+                    rgba: vertex.color.to_le_bytes(),
+                }
+            }));
+        }
+        let native = match self.native {
+            Some(native) => native,
+            None => {
+                let mut native = std::ptr::null_mut();
+                if unsafe { horizon_gx2_precipitation_create(&mut native) } != 0 {
+                    return Err("could not create the GX2 precipitation pipeline");
+                }
+                let native = NonNull::new(native).ok_or("missing GX2 precipitation pipeline")?;
+                self.native = Some(native);
+                native
+            }
+        };
+        // WHBGfxFinishRender retired the preceding frame. Both outputs use
+        // these shared camera-relative vertices without remapping the buffer.
+        if unsafe {
+            horizon_gx2_precipitation_upload(
+                native.as_ptr(), self.vertices.as_ptr(), self.vertices.len() as u32,
+            )
+        } != 0 {
+            return Err("GX2 precipitation upload failed");
+        }
+        Ok(partial)
+    }
+
+    pub(crate) fn draw(
+        &self,
+        frame: &Frame<'_>,
+        projection: &TerrainProjection,
+        rect: [u32; 4],
+        atlas: &HorizonPresenter<'_>,
+        terrain: NonNull<c_void>,
+    ) -> Result<(), &'static str> {
+        if self.is_empty() {
+            return Ok(());
+        }
+        let native = self.native.ok_or("missing GX2 precipitation pipeline")?;
+        let (fog_color, fog_ranges) = fog_uniform(frame);
+        let result = atlas.with_native_atlas(|texture| unsafe {
+            horizon_gx2_precipitation_draw(
+                native.as_ptr(),
+                rect.as_ptr(),
+                texture,
+                terrain.as_ptr(),
+                projection.clip.rows.as_ptr().cast(),
+                fog_color.as_ptr(),
+                fog_ranges.as_ptr(),
+            )
+        });
+        if result == 0 {
+            Ok(())
+        } else {
+            Err("GX2 precipitation draw failed")
+        }
+    }
+}
+
+impl Drop for Precipitation {
+    fn drop(&mut self) {
+        if let Some(native) = self.native.take() {
+            unsafe { horizon_gx2_precipitation_destroy(native.as_ptr()) };
+        }
+    }
+}
