new file mode 100644
index 0000000000000000000000000000000000000000..c0ce00c8249e0a3c6ea9fc750bd03c8bac9fb6cb
--- /dev/null
+++ b/wiiu/loading_host/terrain_translucency.rs
@@ -0,0 +1,302 @@
+use super::*;
+use horizon_client::gfx::translucency::{SortState, Sorter, quad_center};
+use horizon_wiiu_gx2_terrain::TerrainBounds;
+
+pub(super) struct TerrainBuffer {
+    pub(super) native: NonNull<c_void>,
+    pub(super) vertex_count: u32,
+    pub(super) vertex_bytes: u32,
+    pub(super) gpu_bytes: u32,
+    pub(super) bounds: Option<TerrainBounds>,
+}
+
+impl TerrainBuffer {
+    fn estimate(count: u32, translucent: bool) -> Option<u32> {
+        let mut bytes = 0;
+        let result = unsafe {
+            if translucent {
+                horizon_gx2_terrain_section_estimate_sorted(count, &mut bytes)
+            } else {
+                horizon_gx2_terrain_section_estimate(count, &mut bytes)
+            }
+        };
+        (result == 0).then_some(bytes)
+    }
+
+    fn upload(
+        atlas: &TerrainAtlasLayout,
+        source: &[TerrainVertex],
+        translucent: bool,
+        bounds: Option<TerrainBounds>,
+    ) -> horizon_client::Result<Option<Self>> {
+        if source.is_empty() {
+            return Ok(None);
+        }
+        let vertex_count = u32::try_from(source.len())?;
+        let vertex_bytes =
+            Self::estimate(vertex_count, false).ok_or("GX2 vertex allocation estimate overflow")?;
+        let mut upload = TerrainUpload {
+            atlas,
+            source,
+            translucent,
+            error: None,
+        };
+        let mut native = std::ptr::null_mut();
+        let mut gpu_bytes = 0;
+        let create = if translucent {
+            horizon_gx2_terrain_section_create_sorted
+        } else {
+            horizon_gx2_terrain_section_create
+        };
+        // C borrows the upload during the synchronous callback and unmaps it
+        // before returning. This resource is not yet in the retirement queue.
+        let code = unsafe {
+            create(
+                &mut native,
+                vertex_count,
+                fill_terrain_vertices,
+                std::ptr::from_mut(&mut upload).cast(),
+                &mut gpu_bytes,
+            )
+        };
+        if let Some(error) = upload.error {
+            return Err(error.into());
+        }
+        if code == -2 {
+            return Err(horizon_client::presentation::TerrainUploadDeferred.into());
+        }
+        if code != 0 {
+            return Err(format!("GX2 indexed section upload failed ({code})").into());
+        }
+        Ok(Some(Self {
+            native: NonNull::new(native).ok_or("GX2 section returned a null resource")?,
+            vertex_count,
+            vertex_bytes,
+            gpu_bytes,
+            bounds,
+        }))
+    }
+
+    fn destroy_after_wait(self) {
+        let section = std::mem::ManuallyDrop::new(self);
+        unsafe { horizon_gx2_terrain_section_destroy_after_wait(section.native.as_ptr()) }
+    }
+}
+
+impl Drop for TerrainBuffer {
+    fn drop(&mut self) {
+        unsafe { horizon_gx2_terrain_section_destroy(self.native.as_ptr()) }
+    }
+}
+
+struct SortedSection {
+    buffer: TerrainBuffer,
+    sort: SortState,
+}
+
+pub(super) struct TerrainSection {
+    pub(super) solid: Option<TerrainBuffer>,
+    translucent: Option<SortedSection>,
+    pub(super) bounds: Option<TerrainBounds>,
+    pub(super) budget_bytes: usize,
+}
+
+impl TerrainSection {
+    pub(super) fn estimate(
+        mesh: &SectionMesh,
+    ) -> Option<(DeferredTerrain, [Option<TerrainBounds>; 2])> {
+        let solid_count = u32::try_from(mesh.solid.len()).ok()?;
+        let translucent_count = u32::try_from(mesh.translucent.len()).ok()?;
+        let solid_bytes = TerrainBuffer::estimate(solid_count, false)? as usize;
+        let sorted_bytes = TerrainBuffer::estimate(translucent_count, true)? as usize;
+        let center_bytes =
+            (translucent_count as usize / 4).checked_mul(std::mem::size_of::<[f32; 3]>())?;
+        let bytes = solid_bytes
+            .checked_add(sorted_bytes)?
+            .checked_add(center_bytes)?;
+        let solid_bounds = TerrainBounds::from_vertices(&mesh.solid);
+        let translucent_bounds = TerrainBounds::from_vertices(&mesh.translucent);
+        let bounds = match (solid_count != 0, translucent_count != 0) {
+            (true, true) => solid_bounds
+                .zip(translucent_bounds)
+                .map(|(a, b)| a.union(b)),
+            (true, false) => solid_bounds,
+            (false, true) => translucent_bounds,
+            (false, false) => None,
+        };
+        Some((
+            DeferredTerrain { bytes, bounds },
+            [solid_bounds, translucent_bounds],
+        ))
+    }
+
+    pub(super) fn upload(
+        atlas: &TerrainAtlasLayout,
+        mesh: &SectionMesh,
+        info: DeferredTerrain,
+        [solid_bounds, translucent_bounds]: [Option<TerrainBounds>; 2],
+    ) -> horizon_client::Result<Self> {
+        let solid = TerrainBuffer::upload(atlas, &mesh.solid, false, solid_bounds)?;
+        let translucent =
+            match TerrainBuffer::upload(atlas, &mesh.translucent, true, translucent_bounds) {
+                Ok(buffer) => buffer.map(|buffer| {
+                    let centers = mesh
+                        .translucent
+                        .chunks_exact(4)
+                        .map(|quad| quad_center(quad[0].pos, quad[2].pos))
+                        .collect();
+                    SortedSection {
+                        buffer,
+                        sort: SortState::new(centers),
+                    }
+                }),
+                Err(error) => {
+                    // The opaque side of this pair has never been submitted.
+                    if let Some(solid) = solid {
+                        solid.destroy_after_wait();
+                    }
+                    return Err(error);
+                }
+            };
+        let section = Self {
+            solid,
+            translucent,
+            bounds: info.bounds,
+            budget_bytes: info.bytes,
+        };
+        if section.gpu_bytes() + section.center_bytes() != info.bytes {
+            section.destroy_after_wait();
+            return Err(
+                "GX2 reported a different allocation size from the checked estimate".into(),
+            );
+        }
+        Ok(section)
+    }
+
+    pub(super) fn gpu_bytes(&self) -> usize {
+        self.buffers().map(|buffer| buffer.gpu_bytes as usize).sum()
+    }
+
+    pub(super) fn center_bytes(&self) -> usize {
+        self.translucent.as_ref().map_or(0, |section| {
+            section.buffer.vertex_count as usize / 4 * std::mem::size_of::<[f32; 3]>()
+        })
+    }
+
+    pub(super) fn buffers(&self) -> impl Iterator<Item = &TerrainBuffer> {
+        self.solid
+            .iter()
+            .chain(self.translucent.iter().map(|section| &section.buffer))
+    }
+
+    pub(super) fn destroy_after_wait(self) {
+        if let Some(buffer) = self.solid {
+            buffer.destroy_after_wait();
+        }
+        if let Some(section) = self.translucent {
+            section.buffer.destroy_after_wait();
+        }
+    }
+}
+
+/// Both outputs share terrain and sorted indices. A display culls against its
+/// own frustum, but the upstream quad sort depends only on the common camera.
+#[derive(Default)]
+pub(super) struct TranslucentTerrain {
+    visible: Vec<(f64, SectionKey)>,
+    sorter: Sorter,
+}
+
+impl TranslucentTerrain {
+    pub(super) fn draw(
+        &mut self,
+        sections: &mut HashMap<SectionKey, TerrainSection>,
+        terrain: NonNull<c_void>,
+        projection: &TerrainProjection,
+        size: [u32; 2],
+        rect: [u32; 4],
+        fog_color: &[f32; 4],
+        fog_ranges: &[f32; 4],
+    ) -> Result<[usize; 2], &'static str> {
+        self.visible.clear();
+        let mut additional_tested = 0;
+        let mut additional_drawn = 0;
+        self.visible
+            .extend(sections.iter().filter_map(|(&key, entry)| {
+                let section = entry.translucent.as_ref()?;
+                additional_tested += usize::from(entry.solid.is_none());
+                let origin = projection.section_origin(key);
+                let clip = projection.clip_rows(origin);
+                if section
+                    .buffer
+                    .bounds
+                    .is_some_and(|bound| !clip.may_intersect(bound))
+                {
+                    return None;
+                }
+                additional_drawn += usize::from(entry.solid.as_ref().is_none_or(|solid| {
+                    solid.bounds.is_some_and(|bound| !clip.may_intersect(bound))
+                }));
+                let distance = origin.into_iter().map(|v| (v + 8.0).powi(2)).sum::<f64>();
+                Some((distance, key))
+            }));
+        self.visible
+            .sort_unstable_by(|a, b| b.0.total_cmp(&a.0).then_with(|| b.1.cmp(&a.1)));
+
+        let mut indices_drawn = 0usize;
+        for &(_, key) in &self.visible {
+            let section = sections
+                .get_mut(&key)
+                .unwrap()
+                .translucent
+                .as_mut()
+                .unwrap();
+            let world_origin = [key.0 * 16, projection.min_y + key.1 * 16, key.2 * 16];
+            if let Some(indices) =
+                section
+                    .sort
+                    .update(projection.camera, world_origin, &mut self.sorter)
+            {
+                // The existing terrain wait retired earlier consumers. The
+                // other display uses the same order and does not remap it.
+                let status = unsafe {
+                    horizon_gx2_terrain_section_update_indices(
+                        section.buffer.native.as_ptr(),
+                        indices.as_ptr(),
+                        indices.len() as u32,
+                    )
+                };
+                if status != 0 {
+                    section.sort.retry_upload();
+                    return Err("GX2 translucent terrain index upload failed");
+                }
+            }
+            let origin = projection.section_origin(key);
+            let rows = projection.clip_rows(origin);
+            let [x, y, z] = origin.map(|v| v as f32);
+            if unsafe {
+                horizon_gx2_terrain_draw(
+                    terrain.as_ptr(),
+                    section.buffer.native.as_ptr(),
+                    size[0],
+                    size[1],
+                    rect[0],
+                    rect[1],
+                    rect[2],
+                    rect[3],
+                    rows.rows.as_ptr().cast(),
+                    [x, y, z, 0.0].as_ptr(),
+                    fog_color.as_ptr(),
+                    fog_ranges.as_ptr(),
+                )
+            } != 0
+            {
+                return Err("GX2 translucent terrain draw failed");
+            }
+            indices_drawn += section.buffer.vertex_count as usize / 4 * 6;
+        }
+        cafe_profile::count(Counter::Indices, indices_drawn);
+        cafe_profile::count(Counter::SectionDraws, self.visible.len());
+        Ok([additional_tested, additional_drawn])
+    }
+}
