+bool horizon_loading_host_guarded_hud_available(void)
+{
+   return ProcUIInForeground() && !horizon_swkbd_is_open();
+}
+
+bool horizon_loading_host_guarded_hud_reuse(uint64_t retired_pair)
+{
+   if (!retired_pair || !horizon_loading_host_guarded_hud_available()) return false;
+   const OSTime submitted = GX2GetLastSubmittedTimeStamp();
+   return submitted > 0 && (uint64_t)submitted == retired_pair &&
+      GX2GetRetiredTimeStamp() >= submitted;
+}
+
+/* WHB's void begin call may have stopped on its ten-Vsync timeout. Require
+ * agreement of the counters before this trial writes either scan buffer. */
+static bool guarded_scan_buffers_ready(void)
+{
+   uint32_t swaps, flips;
+   OSTime last_flip, last_vsync;
+   GX2GetSwapStatus(&swaps, &flips, &last_flip, &last_vsync);
+   return swaps == flips;
+}
+
+/* Keep ownership in the foreground if the device has not retired our commands.
+ * In particular, returning here could let Rust destroy an in-flight buffer. */
+static OSTime drain_guarded_commands(void)
+{
+   const OSTime start = OSGetTime();
+   const uint64_t stamp = horizon_gx2_profile_stamp();
+   GX2Flush();
+   const OSTime queued = GX2GetLastSubmittedTimeStamp();
+   bool reported = false;
+   for (;;) {
+      const bool done = GX2DrawDone();
+      const OSTime submitted = GX2GetLastSubmittedTimeStamp();
+      if (done && submitted >= 0 && submitted >= queued && GX2GetRetiredTimeStamp() >= submitted) {
+         horizon_gx2_profile_end(GX2_PROFILE_FINISH, stamp);
+         return OSGetTime() - start;
+      }
+      if (!reported) {
+         OSReport("Horizon GX2 guarded HUD waiting for recovery retirement\n");
+         reported = true;
+      }
+      OSSleepTicks(OSMillisecondsToTicks(16));
+   }
+}
+
+static int discard_guarded_pair(OSTime flip_wait, bool gpu_sample, const uint32_t dimensions[4])
+{
+   static bool reported;
+   if (!reported) {
+      OSReport("Horizon GX2 guarded HUD skipped publication with a pending scan flip\n");
+      reported = true;
+   }
+   last_wait_ns = OSTicksToNanoseconds(flip_wait + drain_guarded_commands());
+   last_outputs = 0;
+   horizon_gx2_profile_outputs(0, dimensions);
+   if (gpu_sample) horizon_gx2_profile_gpu_finish(0);
+   return HORIZON_LOADING_RETRY_FLIP;
+}
