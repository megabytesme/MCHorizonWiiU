diff --git a/wiiu/loading_host/crumbling.rs b/wiiu/loading_host/crumbling.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a68fdad74537f050d432fef63d81b9632e0a6b68
--- /dev/null
+++ b/wiiu/loading_host/crumbling.rs
@@ -0,0 +1,189 @@
+//! Native draw preparation for Horizon's pre- and post-translucent crack quads.
+
+use crate::TerrainProjection;
+use horizon_client::{
+    breaking::{SOLID_OVERLAY, TRANSLUCENT_OVERLAY},
+    gfx::{fog_uniform, Frame},
+    mesher::Vertex as SharedVertex,
+};
+use horizon_wiiu_platform::hud::horizon::HorizonPresenter;
+use std::{ffi::c_void, ptr::NonNull};
+
+const MAX_QUADS: usize = 2048;
+const CORNERS: [usize; 6] = [0, 1, 2, 0, 2, 3];
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct Vertex {
+    position: [f32; 3],
+    uv: [f32; 2],
+    sprite: [f32; 4],
+}
+
+const _: () = {
+    assert!(std::mem::size_of::<Vertex>() == 36);
+    assert!(std::mem::offset_of!(Vertex, uv) == 12);
+    assert!(std::mem::offset_of!(Vertex, sprite) == 20);
+};
+
+impl From<SharedVertex> for Vertex {
+    fn from(vertex: SharedVertex) -> Self {
+        let origin = [vertex.light as u16, (vertex.light >> 16) as u16]
+            .map(|cell| f32::from(cell) / 65535.0);
+        Self {
+            position: vertex.pos,
+            uv: vertex.uv,
+            sprite: [origin[0], origin[1], vertex.glint_uv[0], vertex.glint_uv[1]],
+        }
+    }
+}
+
+unsafe extern "C" {
+    fn horizon_gx2_crumbling_create(out: *mut *mut c_void) -> i32;
+    fn horizon_gx2_crumbling_destroy(crumbling: *mut c_void);
+    fn horizon_gx2_crumbling_upload(
+        crumbling: *mut c_void,
+        target: u32,
+        first: *const Vertex,
+        first_count: u32,
+        second: *const Vertex,
+        second_count: u32,
+    ) -> i32;
+    fn horizon_gx2_crumbling_draw(
+        crumbling: *mut c_void,
+        target: u32,
+        rect: *const u32,
+        atlas: *const c_void,
+        clip_rows: *const f32,
+        fog_color: *const f32,
+        fog_ranges: *const f32,
+        start: u32,
+        count: u32,
+    ) -> i32;
+}
+
+#[derive(Default)]
+pub(crate) struct Crumbling {
+    native: Option<NonNull<c_void>>,
+    opaque: Vec<Vertex>,
+    translucent: Vec<Vertex>,
+}
+
+pub(crate) fn is_crack(layer: u32) -> bool {
+    matches!(layer & 0xffff, SOLID_OVERLAY | TRANSLUCENT_OVERLAY)
+}
+
+impl Crumbling {
+    pub(crate) fn is_empty(&self) -> bool {
+        self.opaque.is_empty() && self.translucent.is_empty()
+    }
+
+    /// Reuse the two scratch batches across frames. Return true on a budget
+    /// overflow so presentation accounting can mark the frame partial.
+    pub(crate) fn prepare(&mut self, entities: &[SharedVertex]) -> bool {
+        self.opaque.clear();
+        self.translucent.clear();
+        let mut quads = 0;
+        for quad in entities.chunks_exact(4) {
+            let output = match quad[0].layer & 0xffff {
+                SOLID_OVERLAY => &mut self.opaque,
+                TRANSLUCENT_OVERLAY => &mut self.translucent,
+                _ => continue,
+            };
+            if quads == MAX_QUADS {
+                return true;
+            }
+            quads += 1;
+            let vertices = [quad[0], quad[1], quad[2], quad[3]].map(Vertex::from);
+            output.extend(CORNERS.map(|corner| vertices[corner]));
+        }
+        false
+    }
+
+    /// Stage both phases in one upload for each output. Called after the
+    /// existing pre-terrain completion wait for this output.
+    pub(crate) fn upload(&mut self, target: u32) -> Result<(), &'static str> {
+        if self.is_empty() {
+            return Ok(());
+        }
+        let native = match self.native {
+            Some(native) => native,
+            None => {
+                let mut resource = std::ptr::null_mut();
+                if unsafe { horizon_gx2_crumbling_create(&mut resource) } != 0 {
+                    return Err("could not create the GX2 crumbling pipeline");
+                }
+                let native = NonNull::new(resource).ok_or("missing GX2 crumbling pipeline")?;
+                self.native = Some(native);
+                native
+            }
+        };
+        // The buffers are bounded by prepare. Neither borrowed slice is
+        // retained beyond this upload.
+        if unsafe {
+            horizon_gx2_crumbling_upload(
+                native.as_ptr(),
+                target,
+                self.opaque.as_ptr(),
+                self.opaque.len() as u32,
+                self.translucent.as_ptr(),
+                self.translucent.len() as u32,
+            )
+        } != 0
+        {
+            return Err("could not stage GX2 crumbling geometry");
+        }
+        Ok(())
+    }
+
+    pub(crate) fn draw(
+        &self,
+        frame: &Frame<'_>,
+        projection: &TerrainProjection,
+        target: u32,
+        rect: [u32; 4],
+        hud: &HorizonPresenter<'_>,
+        translucent: bool,
+    ) -> Result<(), &'static str> {
+        let (start, count) = if translucent {
+            (self.opaque.len(), self.translucent.len())
+        } else {
+            (0, self.opaque.len())
+        };
+        if count == 0 {
+            return Ok(());
+        }
+        let native = self.native.ok_or("GX2 crumbling geometry is not staged")?;
+        let (fog_color, fog_ranges) = fog_uniform(frame);
+        let result = hud.with_native_atlas(|atlas| {
+            // The atlas belongs to the current presenter. Binding copies its
+            // registers into the draw stream and does not hold the pointer.
+            unsafe {
+                horizon_gx2_crumbling_draw(
+                    native.as_ptr(),
+                    target,
+                    rect.as_ptr(),
+                    atlas,
+                    projection.clip.rows.as_ptr().cast(),
+                    fog_color.as_ptr(),
+                    fog_ranges.as_ptr(),
+                    start as u32,
+                    count as u32,
+                )
+            }
+        });
+        if result == 0 {
+            Ok(())
+        } else {
+            Err("GX2 crumbling draw failed")
+        }
+    }
+}
+
+impl Drop for Crumbling {
+    fn drop(&mut self) {
+        if let Some(native) = self.native.take() {
+            unsafe { horizon_gx2_crumbling_destroy(native.as_ptr()) };
+        }
+    }
+}
