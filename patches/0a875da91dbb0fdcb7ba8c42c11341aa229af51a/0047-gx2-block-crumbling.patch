diff --git a/wiiu/loading_host/crumbling.frag b/wiiu/loading_host/crumbling.frag
new file mode 100644
index 0000000000000000000000000000000000000000..4f9f93746ee16316c2698b163b58a5ce1d562938
--- /dev/null
+++ b/wiiu/loading_host/crumbling.frag
@@ -0,0 +1,25 @@
+#version 330
+uniform sampler2D uAtlas;
+uniform vec4 uAtlasTexel;
+uniform vec4 uFogColor;
+uniform vec4 uFogRanges;
+in vec2 vUv;
+in vec4 vSprite;
+in vec2 vFogDistance;
+out vec4 fragColor;
+
+float linearFog(float distance, float start, float end) {
+    if (distance <= start) return 0.0;
+    if (distance >= end) return 1.0;
+    return (distance - start) / (end - start);
+}
+
+void main() {
+    vec2 local = min(floor(fract(vUv) * vSprite.zw), vSprite.zw - vec2(1.0));
+    vec2 uv = (vSprite.xy + local + vec2(0.5)) * uAtlasTexel.xy;
+    vec4 texel = texture(uAtlas, uv);
+    if (texel.a < 0.1) discard;
+    float fog = max(linearFog(vFogDistance.x, uFogRanges.x, uFogRanges.y),
+                    linearFog(vFogDistance.y, uFogRanges.z, uFogRanges.w));
+    fragColor = vec4(mix(texel.rgb, uFogColor.rgb, fog * uFogColor.a), texel.a);
+}
