diff --git a/wiiu/loading_host/crumbling.c b/wiiu/loading_host/crumbling.c
new file mode 100644
index 0000000000000000000000000000000000000000..0c619862431870de6764e8ba5d092728013429d8
--- /dev/null
+++ b/wiiu/loading_host/crumbling.c
@@ -0,0 +1,186 @@
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <gx2/draw.h>
+#include <gx2/event.h>
+#include <gx2/registers.h>
+#include <gx2/sampler.h>
+#include <gx2/shaders.h>
+#include <gx2/texture.h>
+#include <gx2/utils.h>
+#include <gx2r/buffer.h>
+#include <gx2r/draw.h>
+#include <whb/gfx.h>
+
+extern const uint8_t _binary_crumbling_gsh_start[];
+
+typedef struct CrumblingVertex {
+   float position[3], uv[2], sprite[4];
+} CrumblingVertex;
+
+_Static_assert(sizeof(CrumblingVertex) == 36, "crumbling vertex ABI changed");
+_Static_assert(offsetof(CrumblingVertex, uv) == 12, "crumbling UV offset changed");
+_Static_assert(offsetof(CrumblingVertex, sprite) == 20, "crumbling sprite offset changed");
+
+enum { CRUMBLING_MAX_VERTICES = 2048 * 6 };
+
+typedef struct HorizonGx2Crumbling {
+   WHBGfxShaderGroup shader;
+   GX2RBuffer vertices[2];
+   uint32_t uploaded[2];
+   GX2Sampler sampler;
+   uint32_t vertex_uniforms[5];
+   uint32_t pixel_uniforms[3];
+   uint32_t atlas_slot;
+} HorizonGx2Crumbling;
+
+static bool uniform_offset(const GX2UniformVar *var, uint32_t *offset)
+{
+   if (!var || var->type != GX2_SHADER_VAR_TYPE_FLOAT4 || var->count != 1 || var->block >= 0)
+      return false;
+   *offset = var->offset;
+   return true;
+}
+
+int horizon_gx2_crumbling_create(HorizonGx2Crumbling **out)
+{
+   if (!out) return -1;
+   *out = NULL;
+   HorizonGx2Crumbling *crumbling = calloc(1, sizeof(*crumbling));
+   if (!crumbling) return -2;
+   WHBGfxShaderGroup *shader = &crumbling->shader;
+   if (!WHBGfxLoadGFDShaderGroup(shader, 0, _binary_crumbling_gsh_start)) {
+      free(crumbling);
+      return -3;
+   }
+   GX2VertexShader *vs = shader->vertexShader;
+   GX2PixelShader *ps = shader->pixelShader;
+   if (!vs || !ps || vs->mode != GX2_SHADER_MODE_UNIFORM_REGISTER ||
+       ps->mode != GX2_SHADER_MODE_UNIFORM_REGISTER) goto fail;
+   const char *vertex_names[] = {"uClipX", "uClipY", "uClipZ", "uClipW", "uAtlasSize"};
+   const char *pixel_names[] = {"uAtlasTexel", "uFogColor", "uFogRanges"};
+   for (unsigned i = 0; i < 5; ++i)
+      if (!uniform_offset(GX2GetVertexUniformVar(vs, vertex_names[i]), &crumbling->vertex_uniforms[i]))
+         goto fail;
+   for (unsigned i = 0; i < 3; ++i)
+      if (!uniform_offset(GX2GetPixelUniformVar(ps, pixel_names[i]), &crumbling->pixel_uniforms[i]))
+         goto fail;
+   const GX2SamplerVar *atlas = NULL;
+   for (unsigned i = 0; ps->samplerVars && i < ps->samplerVarCount; ++i) {
+      const GX2SamplerVar *candidate = &ps->samplerVars[i];
+      if (candidate->type == GX2_SAMPLER_VAR_TYPE_SAMPLER_2D &&
+          candidate->name && !strcmp(candidate->name, "uAtlas")) {
+         atlas = candidate;
+         break;
+      }
+   }
+   if (!atlas) goto fail;
+   crumbling->atlas_slot = atlas->location;
+   if (!WHBGfxInitShaderAttribute(shader, "aPosition", 0, offsetof(CrumblingVertex, position), GX2_ATTRIB_FORMAT_FLOAT_32_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aUv", 0, offsetof(CrumblingVertex, uv), GX2_ATTRIB_FORMAT_FLOAT_32_32) ||
+       !WHBGfxInitShaderAttribute(shader, "aSprite", 0, offsetof(CrumblingVertex, sprite), GX2_ATTRIB_FORMAT_FLOAT_32_32_32_32) ||
+       !WHBGfxInitFetchShader(shader)) goto fail;
+   GX2InitSampler(&crumbling->sampler, GX2_TEX_CLAMP_MODE_CLAMP, GX2_TEX_XY_FILTER_MODE_POINT);
+   *out = crumbling;
+   return 0;
+
+fail:
+   WHBGfxFreeShaderGroup(shader);
+   free(crumbling);
+   return -3;
+}
+
+void horizon_gx2_crumbling_destroy(HorizonGx2Crumbling *crumbling)
+{
+   if (!crumbling) return;
+   GX2DrawDone();
+   for (unsigned i = 0; i < 2; ++i) {
+      GX2RBuffer *buffer = &crumbling->vertices[i];
+      if (GX2RBufferExists(buffer)) GX2RDestroyBufferEx(buffer, 0);
+   }
+   WHBGfxFreeShaderGroup(&crumbling->shader);
+   free(crumbling);
+}
+
+int horizon_gx2_crumbling_upload(HorizonGx2Crumbling *crumbling, uint32_t target,
+                                 const CrumblingVertex *first, uint32_t first_count,
+                                 const CrumblingVertex *second, uint32_t second_count)
+{
+   if (!crumbling || target > 1 || (first_count && !first) || (second_count && !second) ||
+       first_count % 6 || second_count % 6 || first_count > CRUMBLING_MAX_VERTICES ||
+       second_count > CRUMBLING_MAX_VERTICES - first_count) return -1;
+   const uint32_t count = first_count + second_count;
+   crumbling->uploaded[target] = 0;
+   if (!count) return 0;
+   GX2RBuffer *buffer = &crumbling->vertices[target];
+   if (count > buffer->elemCount) {
+      uint32_t capacity = buffer->elemCount ? buffer->elemCount : 64;
+      while (capacity < count) capacity *= 2;
+      if (capacity > CRUMBLING_MAX_VERTICES) capacity = CRUMBLING_MAX_VERTICES;
+      GX2RBuffer replacement = {
+         .flags = GX2R_RESOURCE_BIND_VERTEX_BUFFER | GX2R_RESOURCE_USAGE_CPU_WRITE |
+                  GX2R_RESOURCE_USAGE_GPU_READ,
+         .elemSize = sizeof(CrumblingVertex), .elemCount = capacity,
+      };
+      if (!GX2RCreateBuffer(&replacement)) return -2;
+      if (GX2RBufferExists(buffer)) GX2RDestroyBufferEx(buffer, 0);
+      *buffer = replacement;
+   }
+   CrumblingVertex *mapped = GX2RLockBufferEx(buffer, 0);
+   if (!mapped) return -2;
+   if (first_count) memcpy(mapped, first, first_count * sizeof(*mapped));
+   if (second_count) memcpy(mapped + first_count, second, second_count * sizeof(*mapped));
+   GX2RUnlockBufferEx(buffer, 0);
+   crumbling->uploaded[target] = count;
+   return 0;
+}
+
+int horizon_gx2_crumbling_draw(HorizonGx2Crumbling *crumbling, uint32_t target,
+                               const uint32_t rect[4], const GX2Texture *atlas,
+                               const float clip_rows[16], const float fog_color[4],
+                               const float fog_ranges[4], uint32_t start, uint32_t count)
+{
+   if (!crumbling || target > 1 || !rect || !rect[2] || !rect[3] || !atlas ||
+       !atlas->surface.image || !atlas->surface.width || !atlas->surface.height ||
+       !clip_rows || !fog_color || !fog_ranges || !count || start % 6 || count % 6 ||
+       start > crumbling->uploaded[target] || count > crumbling->uploaded[target] - start)
+      return -1;
+   const float width = atlas->surface.width, height = atlas->surface.height;
+   const float size[4] = {width, height, 0.0f, 0.0f};
+   const float texel[4] = {1.0f / width, 1.0f / height, 0.0f, 0.0f};
+   WHBGfxShaderGroup *shader = &crumbling->shader;
+   GX2SetViewport(rect[0], rect[1], rect[2], rect[3], 0, 1);
+   GX2SetScissor(rect[0], rect[1], rect[2], rect[3]);
+   GX2SetShaderMode(shader->vertexShader->mode);
+   GX2SetFetchShader(&shader->fetchShader);
+   GX2SetVertexShader(shader->vertexShader);
+   GX2SetPixelShader(shader->pixelShader);
+   for (unsigned row = 0; row < 4; ++row)
+      GX2SetVertexUniformReg(crumbling->vertex_uniforms[row], 4, clip_rows + 4 * row);
+   GX2SetVertexUniformReg(crumbling->vertex_uniforms[4], 4, size);
+   GX2SetPixelUniformReg(crumbling->pixel_uniforms[0], 4, texel);
+   GX2SetPixelUniformReg(crumbling->pixel_uniforms[1], 4, fog_color);
+   GX2SetPixelUniformReg(crumbling->pixel_uniforms[2], 4, fog_ranges);
+   GX2SetPixelTexture(atlas, crumbling->atlas_slot);
+   GX2SetPixelSampler(&crumbling->sampler, crumbling->atlas_slot);
+   GX2RSetAttributeBuffer(&crumbling->vertices[target], 0, sizeof(CrumblingVertex), 0);
+
+   GX2SetDepthOnlyControl(TRUE, FALSE, GX2_COMPARE_FUNC_LEQUAL);
+   /* The stock reversed-depth bias moves toward the camera. GX2 uses forward depth. */
+   GX2SetPolygonOffset(-10.0f, -1.0f, -10.0f, -1.0f, 0.0f);
+   GX2SetPolygonControl(GX2_FRONT_FACE_CCW, FALSE, TRUE, FALSE, GX2_POLYGON_MODE_TRIANGLE,
+                        GX2_POLYGON_MODE_TRIANGLE, TRUE, TRUE, FALSE);
+   GX2SetRasterizerClipControlEx(TRUE, TRUE, TRUE);
+   GX2SetAlphaTest(FALSE, GX2_COMPARE_FUNC_ALWAYS, 0.0f);
+   GX2SetColorControl(GX2_LOGIC_OP_COPY, 1, FALSE, TRUE);
+   GX2SetTargetChannelMasks(GX2_CHANNEL_MASK_RGBA, (GX2ChannelMask)0, (GX2ChannelMask)0,
+                            (GX2ChannelMask)0, (GX2ChannelMask)0, (GX2ChannelMask)0,
+                            (GX2ChannelMask)0, (GX2ChannelMask)0);
+   GX2SetBlendControl(GX2_RENDER_TARGET_0, GX2_BLEND_MODE_DST_COLOR, GX2_BLEND_MODE_SRC_COLOR,
+                      GX2_BLEND_COMBINE_MODE_ADD, TRUE, GX2_BLEND_MODE_ONE,
+                      GX2_BLEND_MODE_ZERO, GX2_BLEND_COMBINE_MODE_ADD);
+   GX2DrawEx(GX2_PRIMITIVE_MODE_TRIANGLES, count, start, 1);
+   return 0;
+}
