+uint64_t horizon_gx2_hud_last_draw_wait_ns(const HorizonGx2Hud *hud)
+{
+   return hud ? hud->last_draw_wait_ns : 0;
+}
+
 static HorizonHudResult draw_to(HorizonGx2Hud *hud, const HorizonHudFrame *f,
                                 uint32_t x, uint32_t y, uint32_t width, uint32_t height,
                                 const HudOutput *output)
 {
+   if (hud) hud->last_draw_wait_ns = 0;
    HorizonHudResult result = validate_frame(hud, f);
    if (result != HORIZON_HUD_OK) return result;
    result = validate_draw_target(f, x, y, width, height, output);
    if (result != HORIZON_HUD_OK) return result;
+   const OSTime wait_start = OSGetTime();
    GX2DrawDone();
+   hud->last_draw_wait_ns = OSTicksToNanoseconds(OSGetTime() - wait_start);
    result = upload_frame(hud, f);
    return result == HORIZON_HUD_OK ? draw_uploaded(hud, f, x, y, width, height, output) : result;
 }
