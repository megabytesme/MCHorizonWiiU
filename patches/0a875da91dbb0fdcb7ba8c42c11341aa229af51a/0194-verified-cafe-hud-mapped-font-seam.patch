+    use crate::{cafe_pixels::PackedPixels, font::Font, resource_source::ResourceSource};
+    use sha2::{Digest, Sha256};
+    use std::{fs, path::PathBuf};
+
+    fn restore(font: &Font) -> (u32, u32, u32, u32, u32, u32) {
+        let g = font.glyph('A');
+        let r = g.rect.unwrap();
+        (
+            g.advance.to_bits(),
+            g.top.to_bits(),
+            r.u0.to_bits(),
+            r.v0.to_bits(),
+            r.u1.to_bits(),
+            r.v1.to_bits(),
+        )
+    }
+
+    #[test]
+    fn commits_only_after_success_and_preserves_options() -> crate::Result<()> {
+        let temp = tempfile::tempdir()?;
+        let root = temp.path();
+        fs::create_dir_all(root.join("assets/minecraft/font"))?;
+        fs::create_dir_all(root.join("assets/minecraft/textures/font"))?;
+        fs::write(root.join("horizon-resources.json"), b"{}")?;
+        fs::write(root.join("assets/minecraft/font/default.json"), br#"{"providers":[{"type":"bitmap","file":"minecraft:font/fixture.png","height":2,"ascent":2,"chars":["A"]}]}"#)?;
+        let mut encoder = png::Encoder::new(
+            fs::File::create(root.join("assets/minecraft/textures/font/fixture.png"))?,
+            4,
+            2,
+        );
+        encoder.set_color(png::ColorType::Rgba);
+        encoder.set_depth(png::BitDepth::Eight);
+        encoder.write_header()?.write_image_data(&[255; 32])?;
+        horizon_core::prepared_files::write(root)?;
+        let expected = Sha256::digest(fs::read(
+            root.join(horizon_core::prepared_files::FILE_NAME),
+        )?)
+        .into();
+        let cancel = AtomicBool::new(false);
+        let source = ResourceSource::reopen_verified_assets(root, expected, &cancel)?
+            .ok_or("snapshot missing")?;
+        let mut atlas = HudAtlas::build(&source)?;
+        atlas.font.uniform = true;
+        atlas.font.japanese = true;
+        let expected_glyph = restore(&atlas.font);
+        let epoch = atlas.font.epoch();
+        let row_bytes = atlas.width as usize * 4;
+        let pitch = row_bytes + 16;
+        let height = atlas.height as usize;
+        let mut mapped = vec![0xa5; pitch * height];
+        for (target, source) in mapped
+            .chunks_exact_mut(pitch)
+            .zip(atlas.pixels.chunks_exact(row_bytes))
+        {
+            target[..row_bytes].copy_from_slice(source);
+        }
+        let source_live = source.liveness();
+        drop(source);
+        drop(std::mem::take(&mut atlas.pixels));
+        assert!(source_live());
+
+        let failed = atlas.upload_with_verified_mapped_font(&cancel, |_, inspect| {
+            inspect(&mapped, pitch);
+            Err::<(), _>("upload failed after fill")
+        });
+        assert!(matches!(failed, Err("upload failed after fill")));
+        assert_eq!(atlas.font.epoch(), epoch);
+        let ((), receipt) = atlas.upload_with_verified_mapped_font(&cancel, |_, inspect| {
+            inspect(&mapped, pitch);
+            cancel.store(true, Ordering::Release);
+            Ok::<_, std::io::Error>(())
+        })?;
+        assert!(receipt.is_none());
+        assert_eq!(atlas.font.epoch(), epoch);
+        cancel.store(false, Ordering::Release);
+        let ((), receipt) = atlas.upload_with_verified_mapped_font(&cancel, |_, inspect| {
+            inspect(&mapped[..mapped.len() - 1], pitch);
+            Ok::<_, std::io::Error>(())
+        })?;
+        assert!(receipt.is_none());
+        assert_eq!(atlas.font.epoch(), epoch);
+        let ((), receipt) = atlas.upload_with_verified_mapped_font(&cancel, |atlas, inspect| {
+            inspect(&mapped, pitch);
+            atlas.font.reset_cache();
+            Ok::<_, std::io::Error>(())
+        })?;
+        assert!(receipt.is_none());
+        let epoch = atlas.font.epoch();
+        let (reply, receipt) =
+            atlas.upload_with_verified_mapped_font(&cancel, |atlas, inspect| {
+                inspect(&mapped, pitch);
+                assert_eq!(atlas.font.epoch(), epoch);
+                Ok::<_, std::io::Error>("presenter")
+            })?;
+        let receipt = receipt.ok_or("valid mapped font not published")?;
+        assert_eq!(reply, "presenter");
+        assert_eq!(receipt.mapped_span_bytes, mapped.len());
+        assert_eq!(receipt.tight_rgba_bytes, row_bytes * height);
+        assert_eq!(receipt.cpu_source_capacity_bytes, 0);
+        drop(mapped);
+        assert_ne!(atlas.font.epoch(), epoch);
+        assert!(atlas.font.uniform && atlas.font.japanese);
+        assert_eq!(restore(&atlas.font), expected_glyph);
+        assert!(source_live());
+        drop(atlas);
+        assert!(!source_live());
+        Ok(())
+    }
+
+    #[test]
+    fn loose_atlas_keeps_its_original_font() -> crate::Result<()> {
+        let temp = tempfile::tempdir()?;
+        let source = ResourceSource::directory(temp.path().to_owned());
+        let mut atlas = HudAtlas::build(&source)?;
+        let epoch = atlas.font.epoch();
+        let cancel = AtomicBool::new(false);
+        let ((), receipt) = atlas.upload_with_verified_mapped_font(&cancel, |atlas, inspect| {
+            inspect(&atlas.pixels, atlas.width as usize * 4);
+            Ok::<_, std::io::Error>(())
+        })?;
+        assert!(receipt.is_none());
+        assert_eq!(atlas.font.epoch(), epoch);
+        Ok(())
+    }
+
+    #[test]
+    #[ignore = "requires a host-bound stock archive and independent receipt"]
+    fn prepared_stock_publication_matches_the_exact_pixels_and_glyph() -> crate::Result<()> {
+        let root = PathBuf::from(
+            std::env::var_os("HORIZON_VERIFIED_HUD_ROOT").ok_or("stock root missing")?,
+        );
+        let receipt = PathBuf::from(
+            std::env::var_os("HORIZON_VERIFIED_HUD_RECEIPT").ok_or("stock receipt missing")?,
+        );
+        let hash = fs::read_to_string(receipt)?;
+        let hash = hash.trim();
+        assert!(hash.len() == 64 && hash.bytes().all(|byte| byte.is_ascii_hexdigit()));
+        let mut expected = [0; 32];
+        for (i, byte) in expected.iter_mut().enumerate() {
+            *byte = u8::from_str_radix(&hash[i * 2..i * 2 + 2], 16)?;
+        }
+        let cancel = AtomicBool::new(false);
+        let verified_started = Instant::now();
+        let source = ResourceSource::reopen_verified_assets(&root, expected, &cancel)?
+            .ok_or("stock snapshot missing")?;
+        let verification = verified_started.elapsed();
+        let mut atlas = HudAtlas::build(&source)?;
+        let expected_glyph = restore(&atlas.font);
+        let packed =
+            PackedPixels::compress(&atlas.pixels).ok_or("stock atlas compression failed")?;
+        assert_eq!(atlas.pixels.len(), 117_440_512);
+        drop(std::mem::take(&mut atlas.pixels));
+        let row_bytes = atlas.width as usize * 4;
+        let height = atlas.height as usize;
+        let pitch = row_bytes + 128;
+        let (map, receipt) = atlas.upload_with_verified_mapped_font(&cancel, |_, inspect| {
+            let mut map = vec![0xa5; pitch * height];
+            packed
+                .write_pitched(&mut map, row_bytes, pitch, height)
+                .ok_or("mapping failed")?;
+            inspect(&map, pitch);
+            Ok::<_, &str>(map)
+        })?;
+        let mut digest = Sha256::new();
+        for row in map.chunks_exact(pitch) {
+            digest.update(&row[..row_bytes]);
+            assert!(row[row_bytes..].iter().all(|&byte| byte == 0xa5));
+        }
+        let pixel_hash = format!("{:x}", digest.finalize());
+        drop(map);
+        let receipt = receipt.ok_or("stock font not published")?;
+        assert_eq!(
+            pixel_hash,
+            "a4f3e9e48e982b03a68ac752ab4f52d81665feba7259b1ff628d8ced1e96155b"
+        );
+        assert_eq!(restore(&atlas.font), expected_glyph);
+        assert_eq!(receipt.cpu_source_capacity_bytes, 0);
+        assert_eq!(receipt.tight_rgba_bytes, 117_440_512);
+        assert_eq!(receipt.mapped_span_bytes, 118_358_016);
+        println!("stock mapped font verify={verification:?} {receipt:?}");
+        Ok(())
+    }
+}
