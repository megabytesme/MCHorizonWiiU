+#[test]
+#[ignore = "requires the locally prepared stock assets in HORIZON_STOCK_HUD_FIXTURE"]
+fn prepared_stock_font_matches_after_unmapping_padded_atlas() {
+    let root = std::env::var_os("HORIZON_STOCK_HUD_FIXTURE").unwrap();
+    let source = ResourceSource::directory(PathBuf::from(root));
+    let mut atlas = HudAtlas::build(&source).unwrap();
+    let dimensions = (atlas.width, atlas.height);
+    assert_eq!(dimensions, (4096, 7168));
+    let row_bytes = atlas.width as usize * 4;
+    let height = atlas.height as usize;
+    let pitch = row_bytes + 128;
+    assert_eq!(atlas.pixels.len(), 117_440_512);
+    let packed = PackedPixels::compress(&atlas.pixels).unwrap();
+    drop(std::mem::take(&mut atlas.pixels));
+    let start = Instant::now();
+    let font = {
+        let mut mapped = vec![0xa5; pitch * height];
+        packed
+            .write_pitched(&mut mapped, row_bytes, pitch, height)
+            .unwrap();
+        let filled = start.elapsed();
+        let mut hash = Sha256::new();
+        for row in mapped.chunks_exact(pitch) {
+            hash.update(&row[..row_bytes]);
+            assert!(row[row_bytes..].iter().all(|&byte| byte == 0xa5));
+        }
+        assert_eq!(
