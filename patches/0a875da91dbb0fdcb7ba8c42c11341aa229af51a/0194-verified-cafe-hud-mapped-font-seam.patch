+use super::HudAtlas;
+use std::{
+    sync::atomic::{AtomicBool, Ordering},
+    time::{Duration, Instant},
+};
+
+/// Storage and elapsed time that this probe measures directly. The mapped
+/// span excludes SDK alignment outside the rows and is not a heap census.
+#[derive(Debug)]
+pub struct MappedFontReceipt {
+    pub mapped_span_bytes: usize,
+    pub tight_rgba_bytes: usize,
+    pub cpu_source_capacity_bytes: usize,
+    pub font_prepare: Duration,
+    pub fill_and_upload: Duration,
+}
+
+impl HudAtlas {
+    /// Rebuild an owned font inside the uploader's mapping. The uploader must
+    /// pass the completed atlas rows synchronously, after fill and before
+    /// unmapping. Commit only after the uploader successfully completes all
+    /// texture setup. Call before laying out batches for the new texture.
+    /// The current font remains usable when the probe declines or is canceled.
+    pub fn upload_with_verified_mapped_font<T, E>(
+        &mut self,
+        cancel: &AtomicBool,
+        upload: impl FnOnce(&Self, &mut dyn FnMut(&[u8], usize)) -> Result<T, E>,
+    ) -> Result<(T, Option<MappedFontReceipt>), E> {
+        let eligible = self.font.verified_assets_generation().is_some()
+            && self.material_maps.iter().all(Option::is_none)
+            && !self.sprites.contains_key("horizon/modimage");
+        let revision = self.revision;
+        let epoch = self.font.epoch();
+        let start = Instant::now();
+        let mut candidate = None;
+        let value = upload(self, &mut |rgba, pitch| {
+            if !eligible || cancel.load(Ordering::Acquire) || candidate.is_some() {
+                return;
+            }
+            let font_started = Instant::now();
+            if let Some(font) = self.font.rebuild_verified_mapped(
+                &self.sprites,
+                rgba,
+                pitch,
+                (self.width, self.height),
+            ) {
+                // The constructor checked row width, height and pitch against
+                // this slice, so the logical byte count also fits usize.
+                candidate = Some((
+                    font,
+                    MappedFontReceipt {
+                        mapped_span_bytes: rgba.len(),
+                        tight_rgba_bytes: self.width as usize * 4 * self.height as usize,
+                        cpu_source_capacity_bytes: self.pixels.capacity(),
+                        font_prepare: font_started.elapsed(),
+                        fill_and_upload: Duration::ZERO,
+                    },
+                ));
+            }
+        })?;
+        let Some((font, mut receipt)) = candidate else {
+            return Ok((value, None));
+        };
+        if cancel.load(Ordering::Acquire) || self.revision != revision || self.font.epoch() != epoch
+        {
+            return Ok((value, None));
+        }
+        receipt.fill_and_upload = start.elapsed();
+        self.font = font;
+        Ok((value, Some(receipt)))
+    }
+}
